# Standalone filesystem walker; run with a single directory argument.
def main() -> i64
	let args = arguments()
	if len(args) != 2
		return 2
	let root = args[!1]
	let names = list_dir(root) else return 2
	for name in names
		print(name)
	var pending = Array[string]()
	pending = pending.append(root)
	var i = 0
	while i < len(pending)
		let directory = pending[!i]
		i += 1
		let children = list_dir(directory) else return 2
		for name in children
			let path = directory + "/" + name
			if is_dir(path)
				pending = pending.append(path)
			else
				print("file: " + path)
	return 0
