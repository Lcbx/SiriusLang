# A checked sieve returns success or a recoverable error as a tagged union.
rec Primes(values: Array[i64])
rec InvalidLimit(message: string)
let SieveResult = Primes | InvalidLimit

def primes_up_to(limit: i64) -> SieveResult
	if limit < 2
		return InvalidLimit("limit must be at least 2")
	var composite = Array[bool]()
	for _ in 0..(limit + 1)
		composite = composite.append(false)
	var prime = 2
	while prime * prime <= limit
		if not composite[!prime]
			var multiple = prime * prime
			while multiple <= limit
				composite[!multiple] = true
				multiple += prime
		prime += 1
	var primes = Array[i64]()
	for value in 2..(limit + 1)
		if not composite[!value]
			primes = primes.append(value)
	return Primes(primes)

def describe(result: SieveResult) -> string
	match result
		Primes(values)
			var line = "Primes:"
			for prime in values
				line += " " + str(prime)
			return line
		InvalidLimit(message)
			return "Error: " + message

def main() -> i64
	print(describe(primes_up_to(50)))
	print(describe(primes_up_to(1)))
	return 0
