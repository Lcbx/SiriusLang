# Exercise direct MIR->C code generation, including runtime checks and escaped
# panic text, without passing through source/HIR lowering.
def main() -> i64
	let args = arguments()
	if len(args) != 4
		return 2
	var instructions = Array[MirInstruction]()
	instructions = instructions.append(mir_op(MIR_CONST_I64, 0, -1, -1, 42))
	instructions = instructions.append(mir_op(MIR_PRINT, -1, 0, -1, 0))
	instructions = instructions.append(mir_op(MIR_CONST_BOOL, 1, -1, -1, 1))
	instructions = instructions.append(mir_op(MIR_PRINT, -1, 1, -1, 0))
	instructions = instructions.append(mir_op(MIR_CONST_I64, 2, -1, -1, 0))
	let done = MirBlock(instructions, mir_return(2))
	let print_function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_I64, TYPE_TAG_BOOL, TYPE_TAG_I64], [done], 0)
	let output = MirProgram([print_function])
	let printed = mir_emit_c(output, 0)
	if printed.error != "" or not write_text(args[!1], printed.code)
		return 3
	let panic_term = mir_panic("quoted \"panic\" and backslash \\ end")
	let panic_block = MirBlock(Array[MirInstruction](), panic_term)
	let panic_function = MirFunction(0, TYPE_TAG_I64, Array[i64](), [panic_block], 0)
	let panic_program = MirProgram([panic_function])
	let panicked = mir_emit_c(panic_program, 0)
	if panicked.error != "" or not write_text(args[!2], panicked.code)
		return 4
	let missing_block = MirBlock(Array[MirInstruction](), mir_return(0))
	let missing_fn = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_I64], [missing_block], 0)
	let missing_program = MirProgram([missing_fn])
	let uninitialized = mir_emit_c(missing_program, 0)
	if uninitialized.error != "" or not write_text(args[!3], uninitialized.code)
		return 5
	return 0
