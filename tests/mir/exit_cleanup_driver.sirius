# Path-sensitive cleanup: outgoing CFG edges, returns, calls and loop backedges.

def cleanup_branch_program(take: i64) -> MirProgram
	var first = Array[MirInstruction]()
	first = first.append(mir_string(0, "abc"))
	first = first.append(mir_op(MIR_CONST_BOOL, 1, -1, -1, take))
	let yes = Array[MirInstruction]().append(mir_op(MIR_STRING_LENGTH, 2, 0, -1, 0))
	let no = Array[MirInstruction]().append(mir_op(MIR_CONST_I64, 3, -1, -1, 9))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_BOOL, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(first, mir_branch(1, 1, 2)), MirBlock(yes, mir_return(2)), MirBlock(no, mir_return(3))], 0)
	return MirProgram([function])

def cleanup_arguments_program() -> MirProgram
	var main = Array[MirInstruction]()
	main = main.append(mir_string(0, "unused"))
	main = main.append(mir_string(1, "keep"))
	main = main.append(mir_call(2, 1, [0, 1]))
	main = main.append(mir_op(MIR_STRING_LENGTH, 3, 2, -1, 0))
	let callee = Array[MirInstruction]()
	let function0 = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64], [MirBlock(main, mir_return(3))], 0)
	let function1 = MirFunction(2, TYPE_TAG_STRING, [TYPE_TAG_STRING, TYPE_TAG_STRING], [MirBlock(callee, mir_return(1))], 0)
	return MirProgram([function0, function1])

def cleanup_loop_program() -> MirProgram
	var entry = Array[MirInstruction]()
	entry = entry.append(mir_string(0, "persist"))
	entry = entry.append(mir_op(MIR_CONST_I64, 1, -1, -1, 0))
	entry = entry.append(mir_op(MIR_CONST_I64, 2, -1, -1, 3))
	entry = entry.append(mir_op(MIR_CONST_I64, 4, -1, -1, 1))
	let check = Array[MirInstruction]().append(mir_op(MIR_LT_I64, 3, 1, 2, 0))
	var body = Array[MirInstruction]()
	body = body.append(mir_op(MIR_STRING_LENGTH, 5, 0, -1, 0))
	body = body.append(mir_op(MIR_ADD_I64, 1, 1, 4, 0))
	let done = Array[MirInstruction]().append(mir_op(MIR_CONST_I64, 6, -1, -1, 7))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_BOOL, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(entry, mir_jump(1)), MirBlock(check, mir_branch(3, 2, 3)), MirBlock(body, mir_jump(1)), MirBlock(done, mir_return(6))], 0)
	return MirProgram([function])

def cleanup_panic_program() -> MirProgram
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING], [MirBlock([mir_string(0, "panic")], mir_panic("expected"))], 0)
	return MirProgram([function])

def cleanup_has_release(block: MirBlock, register: i64) -> bool
	for instruction in block.instructions
		if instruction.op == MIR_RELEASE and instruction.dst == register
			return true
	return false

def main() -> i64
	let args = arguments()
	if len(args) != 5
		return 1
	var programs = Array[MirProgram]()
	programs = programs.append(cleanup_branch_program(1))
	programs = programs.append(cleanup_branch_program(0))
	programs = programs.append(cleanup_arguments_program())
	programs = programs.append(cleanup_loop_program())
	var expected = [3, 9, 4, 7]
	for i in 0..len(programs)
		let lifetime = mir_insert_lifetimes(programs[!i])
		if lifetime.error != ""
			print(lifetime.error)
			return 2
		let cleaned = mir_insert_exit_cleanup(lifetime.program)
		if cleaned.error != "" or cleaned.releases == 0
			print(cleaned.error)
			return 3
		let again = mir_insert_exit_cleanup(cleaned.program)
		if again.error != "" or again.releases != 0
			return 4
		let outcome = mir_execute(cleaned.program, 0, Array[MirValue](), 1000, 10)
		if outcome.error != "" or outcome.value.bits != expected[!i]
			print(outcome.error)
			return 5
		for cell in outcome.heap
			if cell.refs != 0
				return 6
		let emitted = mir_emit_c(cleaned.program, 0)
		if emitted.error != "" or not write_text(args[!i + 1], emitted.code)
			print(emitted.error)
			return 7
		if i < 2
			let first = cleaned.program.functions[!0].blocks[!0]
			if first.terminator.alternative == 2
				return 8
			if not cleanup_has_release(cleaned.program.functions[!0].blocks[!first.terminator.alternative], 0)
				return 9
		if i == 2
			if not cleanup_has_release(cleaned.program.functions[!1].blocks[!0], 0)
				return 10
	let panic = mir_insert_exit_cleanup(cleanup_panic_program())
	if panic.error != "" or not cleanup_has_release(panic.program.functions[!0].blocks[!0], 0)
		return 11
	print("PASS MIR path-sensitive exit cleanup")
	return 0
