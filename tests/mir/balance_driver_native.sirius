import mir_cfg alias MirCfg
import mir_cleanup alias MirCleanup
import mir_ownership alias MirOwnership
import mir alias Mir
import mir_emit_c alias MirEmitC
import mir_interpreter alias MirInterpreter
import types alias Types
# Verify may-ownership tracking and conditional cleanup at CFG joins.

def balance_partial(condition: i64) -> Mir.MirProgram
	let entry = Array[Mir.MirInstruction]().append(Mir.mir_op(Mir.MIR_CONST_BOOL, 0, -1, -1, condition))
	let yes = Array[Mir.MirInstruction]().append(Mir.mir_string(1, "payload"))
	let done = Array[Mir.MirInstruction]().append(Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, 7))
	let function = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_BOOL, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], [Mir.MirBlock(entry, Mir.mir_branch(0, 1, 2)), Mir.MirBlock(yes, Mir.mir_jump(2)), Mir.MirBlock(done, Mir.mir_return(2))], 0)
	return Mir.new_mir_program([function])

def balance_nested(condition: i64) -> Mir.MirProgram
	let entry = Array[Mir.MirInstruction]().append(Mir.mir_op(Mir.MIR_CONST_BOOL, 0, -1, -1, condition))
	let yes = Array[Mir.MirInstruction]().append(Mir.mir_string(1, "nested"))
	let packed = Array[Mir.MirInstruction]().append(Mir.mir_array_new(2, [1]))
	let done = Array[Mir.MirInstruction]().append(Mir.mir_op(Mir.MIR_CONST_I64, 3, -1, -1, 11))
	var program = Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_BOOL, Types.TYPE_TAG_STRING, -1, Types.TYPE_TAG_I64], [Mir.MirBlock(entry, Mir.mir_branch(0, 1, 3)), Mir.MirBlock(yes, Mir.mir_jump(2)), Mir.MirBlock(packed, Mir.mir_jump(3)), Mir.MirBlock(done, Mir.mir_return(3))], 0)])
	let created = Types.intern_array_type(program.types, Types.TYPE_TAG_STRING)
	program.types = created.table
	let f = program.functions[!0]
	var types = f.register_types
	types[!2] = created.id
	program.functions[!0] = Mir.MirFunction(f.argument_count, f.return_type, types, f.blocks, f.entry)
	return program

# The cleanup primitive must be safe when a join receives either a value or no value.
def balance_guarded(condition: i64) -> Mir.MirProgram
	let entry = Array[Mir.MirInstruction]().append(Mir.mir_op(Mir.MIR_CONST_BOOL, 0, -1, -1, condition))
	let yes = Array[Mir.MirInstruction]().append(Mir.mir_string(1, "guarded"))
	var done = Array[Mir.MirInstruction]()
	done = done.append(Mir.mir_op(Mir.MIR_RELEASE_IF_INIT, 1, 1, -1, 0))
	done = done.append(Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, 13))
	return Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_BOOL, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], [Mir.MirBlock(entry, Mir.mir_branch(0, 1, 2)), Mir.MirBlock(yes, Mir.mir_jump(2)), Mir.MirBlock(done, Mir.mir_return(2))], 0)])

def balance_contains(block: Mir.MirBlock, op: i64, register: i64) -> bool
	for instruction in block.instructions
		if instruction.op == op and instruction.dst == register
			return true
	return false

# Balance verification must still reject invalid reads before checking leaks.
def balance_invalid_read() -> Mir.MirProgram
	let entry = Array[Mir.MirInstruction]().append(Mir.mir_op(Mir.MIR_CONST_BOOL, 0, -1, -1, 1))
	let yes = Array[Mir.MirInstruction]().append(Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, 7))
	let function = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_BOOL, Types.TYPE_TAG_I64], [Mir.MirBlock(entry, Mir.mir_branch(0, 1, 2)), Mir.MirBlock(yes, Mir.mir_jump(2)), Mir.MirBlock(Array[Mir.MirInstruction](), Mir.mir_return(1))], 0)
	return Mir.new_mir_program([function])

def main() -> i64
	let args = arguments()
	if len(args) != 7
		return 1
	for i in 0..6
		var program = balance_partial(i % 2)
		if i >= 2 and i < 4
			program = balance_nested(i % 2)
		if i >= 4
			program = balance_guarded(i % 2)
		if i < 4 and MirOwnership.mir_check_balance(program) == ""
			return 2
		if i >= 4 and MirOwnership.mir_check_balance(program) != ""
			return 12
		let cleaned = MirCleanup.mir_insert_exit_cleanup(program)
		if cleaned.error != "" or (i < 4 and cleaned.releases == 0)
			print(cleaned.error)
			return 3
		if MirOwnership.mir_check_balance(cleaned.program) != ""
			return 4
		if i < 2
			let cfg = MirCfg.mir_cfg_facts(program.functions[!0])
			let must = MirOwnership.mir_ownership_dataflow_cfg(program.functions[!0], false, cfg.reached, cfg.predecessors)
			let maybe = MirOwnership.mir_ownership_dataflow_cfg(program.functions[!0], true, cfg.reached, cfg.predecessors)
			if MirOwnership.mir_ownership_get(must[!2].outgoing, 1) != 0 or MirOwnership.mir_ownership_get(maybe[!2].outgoing, 1) == 0
				return 5
		let again = MirCleanup.mir_insert_exit_cleanup(cleaned.program)
		if again.error != "" or again.releases != 0
			return 6
		let result = MirInterpreter.mir_execute(cleaned.program, 0, Array[Mir.MirValue](), 1000, 10)
		if result.error != "" or (result.value.bits != 7 and result.value.bits != 11 and result.value.bits != 13)
			print(result.error)
			return 7
		for cell in result.heap
			if cell.refs != 0
				return 8
		let generated = MirEmitC.mir_emit_c(cleaned.program, 0)
		if generated.error != "" or not write_text(args[!i + 1], generated.code)
			print(generated.error)
			return 9
	let invalid = balance_invalid_read()
	let ownership_error = MirOwnership.mir_check_ownership(invalid)
	if ownership_error == "" or MirOwnership.mir_check_balance(invalid) != ownership_error
		return 14
	print("PASS MIR CFG ownership balance")
	return 0
