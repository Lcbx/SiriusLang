rec Success(value: i64)
rec Failure(code: i64)
let Result = Success | Failure

def make(ok: bool) -> Result
	if ok
		return Success(42)
	return Failure(5)

def unwrap(result: Result) -> i64
	match result
		Success(value)
			return value
		Failure(code)
			return -code

def main() -> i64
	return unwrap(make(true)) + unwrap(Failure(5))
