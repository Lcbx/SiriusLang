import mir_guard alias MirGuard
import mir_verify alias MirVerify
import mir_cleanup alias MirCleanup
import mir_ownership alias MirOwnership
import mir alias Mir
import mir_emit_c alias MirEmitC
import mir_interpreter alias MirInterpreter
import mir_lifetime alias MirLifetime
import types alias Types
# Guard implicit runtime traps with explicit CFG branches and panic cleanup.
def guard_division_program(dividend: i64, divisor: i64, remainder: bool) -> Mir.MirProgram
	var code = Array[Mir.MirInstruction]()
	code = code.append(Mir.mir_string(0, "owned"))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, dividend))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, divisor))
	if remainder
		code = code.append(Mir.mir_op(Mir.MIR_REM_I64, 3, 1, 2, 0))
	else
		code = code.append(Mir.mir_op(Mir.MIR_DIV_I64, 3, 1, 2, 0))
	code = code.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 4, 0, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_ADD_I64, 5, 3, 4, 0))
	return Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(5))], 0)])

def guard_array_program(index: i64) -> Mir.MirProgram
	let array = Types.intern_array_type(Types.new_type_table(), Types.TYPE_TAG_I64)
	var code = Array[Mir.MirInstruction]()
	code = code.append(Mir.mir_string(0, "owned"))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, 7))
	code = code.append(Mir.mir_array_new(2, [1]))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 3, -1, -1, index))
	code = code.append(Mir.mir_array_get(4, 2, 3))
	code = code.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 5, 0, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_ADD_I64, 6, 4, 5, 0))
	var program = Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64, array.id, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(6))], 0)])
	program.types = array.table
	return program

def guard_array_set_program(index: i64) -> Mir.MirProgram
	let array = Types.intern_array_type(Types.new_type_table(), Types.TYPE_TAG_I64)
	var code = Array[Mir.MirInstruction]()
	code = code.append(Mir.mir_string(0, "owned"))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, 7))
	code = code.append(Mir.mir_array_new(2, [1]))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 3, -1, -1, index))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 4, -1, -1, 10))
	code = code.append(Mir.mir_array_set(2, 2, 3, 4))
	code = code.append(Mir.mir_array_get(5, 2, 3))
	code = code.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 6, 0, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_ADD_I64, 7, 5, 6, 0))
	var program = Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64, array.id, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(7))], 0)])
	program.types = array.table
	return program

def guard_optional_program(present: bool) -> Mir.MirProgram
	let optional = Types.intern_optional_type(Types.new_type_table(), Types.TYPE_TAG_I64)
	var code = Array[Mir.MirInstruction]()
	code = code.append(Mir.mir_string(0, "owned"))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, 12))
	if present
		code = code.append(Mir.mir_optional_some(2, 1))
	else
		code = code.append(Mir.mir_optional_none(2))
	code = code.append(Mir.mir_optional_unwrap(3, 2))
	code = code.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 4, 0, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_ADD_I64, 5, 3, 4, 0))
	var program = Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64, optional.id, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(5))], 0)])
	program.types = optional.table
	return program

def guard_shift_program(count: i64, left: bool) -> Mir.MirProgram
	var code = Array[Mir.MirInstruction]()
	code = code.append(Mir.mir_string(0, "owned"))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, 16))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, count))
	if left
		code = code.append(Mir.mir_op(Mir.MIR_SHL_I64, 3, 1, 2, 0))
	else
		code = code.append(Mir.mir_op(Mir.MIR_SHR_I64, 3, 1, 2, 0))
	code = code.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 4, 0, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_ADD_I64, 5, 3, 4, 0))
	return Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(5))], 0)])

def main() -> i64
	let paths = arguments()
	if len(paths) != 17
		return 1
	var programs = Array[Mir.MirProgram]()
	programs = programs.append(guard_division_program(42, 2, false))
	programs = programs.append(guard_division_program(42, 0, false))
	programs = programs.append(guard_division_program((-9223372036854775807 - 1), -1, false))
	programs = programs.append(guard_division_program(42, 4, true))
	programs = programs.append(guard_array_program(0))
	programs = programs.append(guard_array_program(-1))
	programs = programs.append(guard_array_set_program(0))
	programs = programs.append(guard_array_set_program(3))
	programs = programs.append(guard_optional_program(true))
	programs = programs.append(guard_optional_program(false))
	programs = programs.append(guard_shift_program(2, true))
	programs = programs.append(guard_shift_program(2, false))
	programs = programs.append(guard_shift_program(-1, true))
	programs = programs.append(guard_shift_program(64, true))
	programs = programs.append(guard_shift_program(-1, false))
	programs = programs.append(guard_shift_program(64, false))
	let values = [26, 0, 0, 7, 12, 0, 15, 0, 17, 0, 69, 9, 0, 0, 0, 0]
	let failures = ["", "division by zero", "integer overflow", "", "", "array index out of bounds", "", "array index out of bounds", "", "missing optional value", "", "", "shift count out of range", "shift count out of range", "shift count out of range", "shift count out of range"]
	for i in 0..len(programs)
		let guarded = MirGuard.mir_insert_guards(programs[!i])
		if guarded.error != "" or guarded.guards == 0
			print(guarded.error)
			return 2
		let repeat = MirGuard.mir_insert_guards(guarded.program)
		if repeat.error != "" or repeat.guards != 0
			return 3
		let lifetime = MirLifetime.mir_insert_lifetimes(guarded.program)
		if lifetime.error != ""
			print(lifetime.error)
			return 4
		let cleanup = MirCleanup.mir_insert_exit_cleanup(lifetime.program)
		if cleanup.error != "" or cleanup.releases == 0
			print(cleanup.error)
			return 5
		let result = MirInterpreter.mir_execute(cleanup.program, 0, Array[Mir.MirValue](), 500, 10)
		if result.error != failures[!i]
			print(result.error)
			return 6
		if failures[!i] == ""
			if result.value.bits != values[!i]
				return 7
			for entry in result.heap
				if entry.refs != 0
					return 8
		let native = MirEmitC.mir_emit_c(cleanup.program, 0)
		if native.error != "" or not write_text(paths[!i + 1], native.code)
			print(native.error)
			return 9
	print("PASS MIR explicit runtime guards")
	return 0
