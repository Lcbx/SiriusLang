import mir alias Mir
import mir_emit_c alias MirEmitC
import mir_interpreter alias MirInterpreter
import mir_ownership alias MirOwnership
import mir_verify alias MirVerify
import types alias Types
# MIR record update must preserve snapshots and release nested strings.
def main() -> i64
	let layout = Types.intern_record_type(Types.new_type_table(), [Types.RecordField("count", Types.TYPE_TAG_I64), Types.RecordField("name", Types.TYPE_TAG_STRING)])
	var instructions = Array[Mir.MirInstruction]()
	instructions = instructions.append(Mir.mir_op(Mir.MIR_CONST_I64, 0, -1, -1, 1))
	instructions = instructions.append(Mir.mir_string(1, "old"))
	instructions = instructions.append(Mir.mir_record_new(2, [0, 1]))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_COPY, 3, 2, -1, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_CONST_I64, 4, -1, -1, 3))
	instructions = instructions.append(Mir.mir_record_set(2, 2, 0, 4))
	instructions = instructions.append(Mir.mir_record_get(5, 3, 0))
	instructions = instructions.append(Mir.mir_record_get(6, 2, 0))
	instructions = instructions.append(Mir.mir_string(7, "new"))
	instructions = instructions.append(Mir.mir_record_set(2, 2, 1, 7))
	instructions = instructions.append(Mir.mir_record_get(8, 3, 1))
	instructions = instructions.append(Mir.mir_record_get(9, 2, 1))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 10, 8, -1, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 11, 9, -1, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_ADD_I64, 12, 5, 6, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_ADD_I64, 12, 12, 10, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_ADD_I64, 12, 12, 11, 0))
	for register in [1, 2, 3, 7, 8, 9]
		instructions = instructions.append(Mir.mir_op(Mir.MIR_RELEASE, register, register, -1, 0))
	let function = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_I64, Types.TYPE_TAG_STRING, layout.id, layout.id, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [Mir.MirBlock(instructions, Mir.mir_return(12))], 0)
	let program = Mir.mir_program_with_types([function], layout.table)
	let error = MirOwnership.mir_check_balance(program)
	if error != ""
		print(error)
		return 1
	let result = MirInterpreter.mir_execute(program, 0, Array[Mir.MirValue](), 100, 10)
	if result.error != "" or result.value.bits != 10
		print(result.error)
		return 2
	for record in result.heap
		if record.refs != 0
			return 3
	let broken = Mir.mir_program_with_types([Mir.MirFunction(0, Types.TYPE_TAG_I64, function.register_types, [Mir.MirBlock([Mir.mir_record_set(2, 2, 5, 4)], Mir.mir_return(0))], 0)], layout.table)
	if MirVerify.mir_verify(broken) != "invalid record update field"
		return 4
	let wrong_type = Mir.mir_program_with_types([Mir.MirFunction(0, Types.TYPE_TAG_I64, function.register_types, [Mir.MirBlock([Mir.mir_record_set(2, 2, 1, 4)], Mir.mir_return(0))], 0)], layout.table)
	if MirVerify.mir_verify(wrong_type) != "record update field type mismatch"
		return 5
	let args = arguments()
	if len(args) != 2
		return 6
	let native = MirEmitC.mir_emit_c(program, 0)
	if native.error != "" or not write_text(args[!1], native.code)
		return 7
	print("PASS MIR record update")
	return 0
