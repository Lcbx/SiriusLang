# Shared managed-value MIR program: run interpreted and emit native C.
def main() -> i64
	let args = arguments()
	if len(args) != 3
		return 2
	var suffix_instructions = Array[MirInstruction]()
	suffix_instructions = suffix_instructions.append(mir_string(1, "!"))
	suffix_instructions = suffix_instructions.append(mir_op(MIR_STRING_CONCAT, 2, 0, 1, 0))
	let suffix = MirBlock(suffix_instructions, mir_return(2))
	let helper = MirFunction(1, TYPE_TAG_STRING, [TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_STRING], [suffix], 0)
	var statements = Array[MirInstruction]()
	statements = statements.append(mir_string(0, "hello"))
	statements = statements.append(mir_op(MIR_COPY, 1, 0, -1, 0))
	statements = statements.append(mir_op(MIR_MOVE, 2, 1, -1, 0))
	statements = statements.append(mir_op(MIR_RETAIN, 3, 2, -1, 0))
	statements = statements.append(mir_call(4, 1, [3]))
	statements = statements.append(mir_op(MIR_RELEASE, 2, 2, -1, 0))
	statements = statements.append(mir_op(MIR_PRINT, -1, 4, -1, 0))
	statements = statements.append(mir_op(MIR_STRING_LENGTH, 5, 4, -1, 0))
	statements = statements.append(mir_op(MIR_RELEASE, 4, 4, -1, 0))
	let runner = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64], [MirBlock(statements, mir_return(5))], 0)
	let program = MirProgram([runner, helper])
	if mir_verify(program) != ""
		return 3
	let interpreted = mir_execute(program, 0, Array[MirValue](), 500, 10)
	if interpreted.error != "" or interpreted.value.bits != 6
		return 4
	let native = mir_emit_c(program, 0)
	if native.error != "" or not write_text(args[!1], native.code)
		return 5
	var bad_instructions = Array[MirInstruction]()
	bad_instructions = bad_instructions.append(mir_string(0, "drop"))
	bad_instructions = bad_instructions.append(mir_op(MIR_MOVE, 1, 0, -1, 0))
	bad_instructions = bad_instructions.append(mir_op(MIR_PRINT, -1, 0, -1, 0))
	bad_instructions = bad_instructions.append(mir_op(MIR_CONST_I64, 2, -1, -1, 0))
	let invalid = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64], [MirBlock(bad_instructions, mir_return(2))], 0)
	let bad = MirProgram([invalid])
	let stopped = mir_execute(bad, 0, Array[MirValue](), 50, 5)
	if stopped.error != "uninitialized register"
		return 6
	let bad_c = mir_emit_c(bad, 0)
	if bad_c.error != "" or not write_text(args[!2], bad_c.code)
		return 7
	print("PASS managed MIR")
	return 0
