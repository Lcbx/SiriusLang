# Fused record-field append must preserve a shared record and its nested array.
def main() -> i64
	let array = intern_array_type(new_type_table(), TYPE_TAG_I64)
	let layout = intern_record_type(array.table, [RecordField("items", array.id)])
	var instructions = Array[MirInstruction]()
	instructions = instructions.append(mir_array_new(0, Array[i64]()))
	instructions = instructions.append(mir_record_new(1, [0]))
	instructions = instructions.append(mir_op(MIR_COPY, 2, 1, -1, 0))
	instructions = instructions.append(mir_op(MIR_CONST_I64, 3, -1, -1, 7))
	instructions = instructions.append(mir_record_array_append(1, 1, 0, 3))
	instructions = instructions.append(mir_record_get(4, 2, 0))
	instructions = instructions.append(mir_record_get(5, 1, 0))
	instructions = instructions.append(mir_op(MIR_ARRAY_LENGTH, 6, 4, -1, 0))
	instructions = instructions.append(mir_op(MIR_ARRAY_LENGTH, 7, 5, -1, 0))
	instructions = instructions.append(mir_op(MIR_ADD_I64, 8, 6, 7, 0))
	for register in [0, 1, 2, 4, 5]
		instructions = instructions.append(mir_op(MIR_RELEASE, register, register, -1, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [array.id, layout.id, layout.id, TYPE_TAG_I64, array.id, array.id, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(instructions, mir_return(8))], 0)
	let program = mir_program_with_types([function], layout.table)
	let error = mir_check_balance(program)
	if error != ""
		print(error)
		return 1
	let result = mir_execute(program, 0, Array[MirValue](), 100, 10)
	if result.error != "" or result.value.bits != 1
		print(result.error)
		return 2
	for item in result.heap
		if item.refs != 0
			return 3
	let invalid = mir_program_with_types([MirFunction(0, TYPE_TAG_I64, function.register_types, [MirBlock([mir_record_array_append(1, 1, 0, 2)], mir_return(3))], 0)], layout.table)
	if mir_verify(invalid) != "record array append type mismatch"
		return 4
	let args = arguments()
	if len(args) != 2
		return 5
	let native = mir_emit_c(program, 0)
	if native.error != "" or not write_text(args[!1], native.code)
		return 6
	print("PASS MIR fused record array append")
	return 0
