# MIR record update must preserve snapshots and release nested strings.
def main() -> i64
	let layout = intern_record_type(new_type_table(), [RecordField("count", TYPE_TAG_I64), RecordField("name", TYPE_TAG_STRING)])
	var instructions = Array[MirInstruction]()
	instructions = instructions.append(mir_op(MIR_CONST_I64, 0, -1, -1, 1))
	instructions = instructions.append(mir_string(1, "old"))
	instructions = instructions.append(mir_record_new(2, [0, 1]))
	instructions = instructions.append(mir_op(MIR_COPY, 3, 2, -1, 0))
	instructions = instructions.append(mir_op(MIR_CONST_I64, 4, -1, -1, 3))
	instructions = instructions.append(mir_record_set(2, 2, 0, 4))
	instructions = instructions.append(mir_record_get(5, 3, 0))
	instructions = instructions.append(mir_record_get(6, 2, 0))
	instructions = instructions.append(mir_string(7, "new"))
	instructions = instructions.append(mir_record_set(2, 2, 1, 7))
	instructions = instructions.append(mir_record_get(8, 3, 1))
	instructions = instructions.append(mir_record_get(9, 2, 1))
	instructions = instructions.append(mir_op(MIR_STRING_LENGTH, 10, 8, -1, 0))
	instructions = instructions.append(mir_op(MIR_STRING_LENGTH, 11, 9, -1, 0))
	instructions = instructions.append(mir_op(MIR_ADD_I64, 12, 5, 6, 0))
	instructions = instructions.append(mir_op(MIR_ADD_I64, 12, 12, 10, 0))
	instructions = instructions.append(mir_op(MIR_ADD_I64, 12, 12, 11, 0))
	for register in [1, 2, 3, 7, 8, 9]
		instructions = instructions.append(mir_op(MIR_RELEASE, register, register, -1, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_I64, TYPE_TAG_STRING, layout.id, layout.id, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(instructions, mir_return(12))], 0)
	let program = mir_program_with_types([function], layout.table)
	let error = mir_check_balance(program)
	if error != ""
		print(error)
		return 1
	let result = mir_execute(program, 0, Array[MirValue](), 100, 10)
	if result.error != "" or result.value.bits != 10
		print(result.error)
		return 2
	for record in result.heap
		if record.refs != 0
			return 3
	let broken = mir_program_with_types([MirFunction(0, TYPE_TAG_I64, function.register_types, [MirBlock([mir_record_set(2, 2, 5, 4)], mir_return(0))], 0)], layout.table)
	if mir_verify(broken) != "invalid record update field"
		return 4
	let wrong_type = mir_program_with_types([MirFunction(0, TYPE_TAG_I64, function.register_types, [MirBlock([mir_record_set(2, 2, 1, 4)], mir_return(0))], 0)], layout.table)
	if mir_verify(wrong_type) != "record update field type mismatch"
		return 5
	let args = arguments()
	if len(args) != 2
		return 6
	let native = mir_emit_c(program, 0)
	if native.error != "" or not write_text(args[!1], native.code)
		return 7
	print("PASS MIR record update")
	return 0
