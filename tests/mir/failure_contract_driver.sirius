# Verify the explicit / non-unwinding MIR failure contract.
def checked_division_program() -> MirProgram
	var code = Array[MirInstruction]()
	code = code.append(mir_op(MIR_CONST_I64, 0, -1, -1, 42))
	code = code.append(mir_op(MIR_CONST_I64, 1, -1, -1, 2))
	code = code.append(mir_op(MIR_DIV_I64, 2, 0, 1, 0))
	return MirProgram([MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(code, mir_return(2))], 0)])

def safe_program() -> MirProgram
	var code = Array[MirInstruction]()
	code = code.append(mir_op(MIR_CONST_I64, 0, -1, -1, 40))
	code = code.append(mir_op(MIR_CONST_I64, 1, -1, -1, 2))
	code = code.append(mir_op(MIR_ADD_I64, 2, 0, 1, 0))
	return MirProgram([MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(code, mir_return(2))], 0)])

def abort_program() -> MirProgram
	var code = Array[MirInstruction]()
	code = code.append(mir_string(0, "owned"))
	code = code.append(mir_op(MIR_STRING_LENGTH, 1, 0, -1, 0))
	return MirProgram([MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_I64], [MirBlock(code, mir_return(1))], 0)])

def main() -> i64
	if not mir_failure_info(MIR_ARRAY_SET).guarded or not mir_failure_info(MIR_ARRAY_SET).abort
		return 1
	if not mir_failure_info(MIR_CALL).abort or not mir_failure_info(MIR_PRINT).abort
		return 2
	if mir_failure_info(MIR_ADD_I64).guarded or mir_failure_info(MIR_ADD_I64).abort
		return 3
	let raw = checked_division_program()
	if mir_audit_failures(raw).error != "unguarded MIR runtime failure"
		return 4
	let guarded = mir_insert_guards(raw)
	if guarded.error != "" or guarded.guards != 2
		return 5
	let audit = mir_audit_failures(guarded.program)
	if audit.error != "" or audit.guarded != 1 or audit.aborts != 0
		return 6
	let repeated = mir_insert_guards(guarded.program)
	if repeated.error != "" or repeated.guards != 0
		return 7
	let safe = mir_audit_failures(safe_program())
	if safe.error != "" or safe.guarded != 0 or safe.aborts != 0
		return 8
	let aborts = mir_audit_failures(abort_program())
	if aborts.error != "" or aborts.aborts != 1
		return 9
	let forged = MirInstruction(MIR_CONST_I64, 0, -1, -1, 40, Array[i64](), "__mir_guarded")
	var code = Array[MirInstruction]()
	code = code.append(forged)
	code = code.append(mir_op(MIR_CONST_I64, 1, -1, -1, 2))
	code = code.append(mir_op(MIR_ADD_I64, 2, 0, 1, 0))
	let bad = MirProgram([MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(code, mir_return(2))], 0)])
	if mir_audit_failures(bad).error != "guard marker on non-fallible MIR instruction"
		return 10
	print("PASS MIR failure contract")
	return 0
