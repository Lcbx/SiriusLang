# Verify may-ownership tracking and conditional cleanup at CFG joins.

def balance_partial(condition: i64) -> MirProgram
	let entry = Array[MirInstruction]().append(mir_op(MIR_CONST_BOOL, 0, -1, -1, condition))
	let yes = Array[MirInstruction]().append(mir_string(1, "payload"))
	let done = Array[MirInstruction]().append(mir_op(MIR_CONST_I64, 2, -1, -1, 7))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_BOOL, TYPE_TAG_STRING, TYPE_TAG_I64], [MirBlock(entry, mir_branch(0, 1, 2)), MirBlock(yes, mir_jump(2)), MirBlock(done, mir_return(2))], 0)
	return MirProgram([function])

def balance_nested(condition: i64) -> MirProgram
	let entry = Array[MirInstruction]().append(mir_op(MIR_CONST_BOOL, 0, -1, -1, condition))
	let yes = Array[MirInstruction]().append(mir_string(1, "nested"))
	let packed = Array[MirInstruction]().append(mir_array_new(2, [1]))
	let done = Array[MirInstruction]().append(mir_op(MIR_CONST_I64, 3, -1, -1, 11))
	var program = MirProgram([MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_BOOL, TYPE_TAG_STRING, -1, TYPE_TAG_I64], [MirBlock(entry, mir_branch(0, 1, 3)), MirBlock(yes, mir_jump(2)), MirBlock(packed, mir_jump(3)), MirBlock(done, mir_return(3))], 0)])
	let created = intern_array_type(program.types, TYPE_TAG_STRING)
	program.types = created.table
	let f = program.functions[!0]
	var types = f.register_types
	types[!2] = created.id
	program.functions[!0] = MirFunction(f.argument_count, f.return_type, types, f.blocks, f.entry)
	return program

# The cleanup primitive must be safe when a join receives either a value or no value.
def balance_guarded(condition: i64) -> MirProgram
	let entry = Array[MirInstruction]().append(mir_op(MIR_CONST_BOOL, 0, -1, -1, condition))
	let yes = Array[MirInstruction]().append(mir_string(1, "guarded"))
	var done = Array[MirInstruction]()
	done = done.append(mir_op(MIR_RELEASE_IF_INIT, 1, 1, -1, 0))
	done = done.append(mir_op(MIR_CONST_I64, 2, -1, -1, 13))
	return MirProgram([MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_BOOL, TYPE_TAG_STRING, TYPE_TAG_I64], [MirBlock(entry, mir_branch(0, 1, 2)), MirBlock(yes, mir_jump(2)), MirBlock(done, mir_return(2))], 0)])

def balance_contains(block: MirBlock, op: i64, register: i64) -> bool
	for instruction in block.instructions
		if instruction.op == op and instruction.dst == register
			return true
	return false

# Balance verification must still reject invalid reads before checking leaks.
def balance_invalid_read() -> MirProgram
	let entry = Array[MirInstruction]().append(mir_op(MIR_CONST_BOOL, 0, -1, -1, 1))
	let yes = Array[MirInstruction]().append(mir_op(MIR_CONST_I64, 1, -1, -1, 7))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_BOOL, TYPE_TAG_I64], [MirBlock(entry, mir_branch(0, 1, 2)), MirBlock(yes, mir_jump(2)), MirBlock(Array[MirInstruction](), mir_return(1))], 0)
	return MirProgram([function])

def main() -> i64
	let args = arguments()
	if len(args) != 7
		return 1
	for i in 0..6
		var program = balance_partial(i % 2)
		if i >= 2 and i < 4
			program = balance_nested(i % 2)
		if i >= 4
			program = balance_guarded(i % 2)
		if i < 4 and mir_check_balance(program) == ""
			return 2
		if i >= 4 and mir_check_balance(program) != ""
			return 12
		let cleaned = mir_insert_exit_cleanup(program)
		if cleaned.error != "" or (i < 4 and cleaned.releases == 0)
			print(cleaned.error)
			return 3
		if mir_check_balance(cleaned.program) != ""
			return 4
		if i < 2
			let must = mir_ownership_states(program.functions[!0])
			let maybe = mir_ownership_maybe_states(program.functions[!0])
			if mir_ownership_get(must[!2].outgoing, 1) != 0 or mir_ownership_get(maybe[!2].outgoing, 1) == 0
				return 5
		let again = mir_insert_exit_cleanup(cleaned.program)
		if again.error != "" or again.releases != 0
			return 6
		let result = mir_execute(cleaned.program, 0, Array[MirValue](), 1000, 10)
		if result.error != "" or (result.value.bits != 7 and result.value.bits != 11 and result.value.bits != 13)
			print(result.error)
			return 7
		for cell in result.heap
			if cell.refs != 0
				return 8
		let generated = mir_emit_c(cleaned.program, 0)
		if generated.error != "" or not write_text(args[!i + 1], generated.code)
			print(generated.error)
			return 9
	let invalid = balance_invalid_read()
	let ownership_error = mir_check_ownership(invalid)
	if ownership_error == "" or mir_check_balance(invalid) != ownership_error
		return 14
	print("PASS MIR CFG ownership balance")
	return 0
