def main() -> i64
	let original = [10, 20, 30]
	if original[!-1] != 30 or original[!-3] != 10
		return 1
	if (original[?-2] or 0) != 20
		return 2
	if (original[?-4] or 91) != 91
		return 3
	if (original[?3] or 92) != 92
		return 4
	if (Array[i64]()[?-1] or 93) != 93
		return 5
	let minimum = -9223372036854775807 - 1
	if (original[?minimum] or 94) != 94
		return 6
	var changed = original
	changed[!-1] = 99
	changed[!-3] = 11
	if changed[!2] != 99 or changed[!0] != 11 or original[!0] != 10 or original[!2] != 30
		return 7
	var strings = ["a", "b", "c"]
	let snapshot = strings
	strings[!-2] = "replaced"
	if strings[!-2] != "replaced" or snapshot[!-2] != "b"
		return 8
	if (snapshot[?-1] or "") != "c" or (snapshot[?-4] or "missing") != "missing"
		return 10
	var nested = [[1, 2], [3, 4]]
	let before = nested
	nested[!-1][!-1] = 5
	if nested[!-1][!-1] != 5 or before[!-1][!-1] != 4
		return 9
	print("PASS negative indexing")
	return 0
