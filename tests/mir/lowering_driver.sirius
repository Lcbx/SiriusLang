# Source -> typed HIR -> scalar MIR -> interpreter, without generating C.
def check(source: string, arguments: Array[MirValue], expected: i64) -> bool
	let parsed = parse_module(source)
	if parsed.state.error != ""
		print(parsed.state.error)
		return false
	let declarations = hir_module_declarations(parsed.state, parsed.node)
	if declarations.error != ""
		print(declarations.error)
		return false
	let typed = hir_analyze_module_body(parsed.state, declarations.functions[!0], declarations.functions, Array[string]())
	if typed.error != ""
		print(typed.error)
		return false
	var types = Array[i64]()
	for value in arguments
		types = types.append(value.type_id)
	let lowered = mir_lower_function(parsed.state, declarations.functions[!0], typed.nodes, types, TYPE_TAG_I64)
	if lowered.error != ""
		print(lowered.error)
		return false
	let program = MirProgram([lowered.function])
	let outcome = mir_execute(program, 0, arguments, 10000, 10)
	if outcome.error != "" or outcome.value.bits != expected
		print(outcome.error)
		return false
	return true

# Assignment roots and record spreads must use the lexical symbols resolved by HIR.
def check_target_symbols() -> bool
	let source = "def main() -> i64\n\tvar x = {a = 1}\n\tx.a = 2\n\tif true\n\t\tvar x = {a = 3}\n\t\tx.a = 4\n\t\tlet y = {x.*}\n\t\tprint(y.a)\n\treturn x.a\n"
	let parsed = parse_module(source)
	if parsed.state.error != ""
		return false
	let declarations = hir_module_declarations(parsed.state, parsed.node)
	if declarations.error != ""
		return false
	let typed = hir_analyze_module_body(parsed.state, declarations.functions[!0], declarations.functions, Array[string]())
	if typed.error != ""
		print(typed.error)
		return false
	let index = hir_annotation_index(typed.nodes, len(parsed.state.nodes))
	var roots = Array[i64]()
	var spreads = Array[i64]()
	for i in 0..len(parsed.state.nodes)
		let node = parsed.state.nodes[!i]
		if node.kind == NODE_ASSIGN
			let target = hir_ast_child(parsed.state, i, 0)
			if parsed.state.nodes[!target].kind == NODE_ATTR
				let root = hir_ast_child(parsed.state, target, 0)
				let at = hir_annotation_find(typed.nodes, index, root, HIR_NAME)
				if at < 0
					return false
				roots = roots.append(typed.nodes[!at].field_index)
		if node.kind == NODE_SPREAD
			let at = hir_annotation_find(typed.nodes, index, i, HIR_NAME)
			if at < 0
				return false
			spreads = spreads.append(typed.nodes[!at].field_index)
	return len(roots) == 2 and roots[!0] == 0 and roots[!1] == 1 and len(spreads) == 1 and spreads[!0] == 1

def main() -> i64
	if not check_target_symbols()
		return 6
	let loop_case = "def main() -> i64\n\tvar n = 0\n\tvar total = 0\n\twhile n < 5\n\t\tif n == 3\n\t\t\ttotal = total + 10\n\t\telse\n\t\t\ttotal = total + n\n\t\tn = n + 1\n\treturn total\n"
	if not check(loop_case, Array[MirValue](), 17)
		return 1
	let shortcut = "def main() -> i64\n\tif false and (1 / 0 > 0)\n\t\treturn 1\n\tif true or (1 / 0 > 0)\n\t\treturn 42\n\treturn 0\n"
	if not check(shortcut, Array[MirValue](), 42)
		return 2
	let branching = "def main() -> i64\n\tlet n = 2\n\tif n == 1\n\t\treturn 3\n\telif n == 2\n\t\treturn 5\n\telse\n\t\treturn 7\n"
	if not check(branching, Array[MirValue](), 5)
		return 3
	let arguments = "def add(a: i64, b: i64) -> i64\n\treturn a + b\n"
	if not check(arguments, [MirValue(TYPE_TAG_I64, 3, ""), MirValue(TYPE_TAG_I64, 6, "")], 9)
		return 4
	let shadow = "def main() -> i64\n\tvar x = 7\n\tif true\n\t\tlet x = 1\n\treturn x\n"
	if not check(shadow, Array[MirValue](), 7)
		return 5
	print("PASS typed HIR scalar CFG lowering")
	return 0
