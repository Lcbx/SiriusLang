# Liveness must preserve ownership across branches and loop backedges.
def lifetime_branch_program(condition: i64) -> MirProgram
	var first = Array[MirInstruction]()
	first = first.append(mir_string(0, "four"))
	first = first.append(mir_op(MIR_CONST_BOOL, 1, -1, -1, condition))
	var yes = Array[MirInstruction]()
	yes = yes.append(mir_op(MIR_COPY, 2, 0, -1, 0))
	yes = yes.append(mir_op(MIR_STRING_LENGTH, 3, 2, -1, 0))
	let no = Array[MirInstruction]().append(mir_op(MIR_STRING_LENGTH, 4, 0, -1, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_BOOL, TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(first, mir_branch(1, 1, 2)), MirBlock(yes, mir_return(3)), MirBlock(no, mir_return(4))], 0)
	return MirProgram([function])

def lifetime_loop_program() -> MirProgram
	var start = Array[MirInstruction]()
	start = start.append(mir_string(0, "x"))
	start = start.append(mir_op(MIR_CONST_I64, 1, -1, -1, 0))
	start = start.append(mir_op(MIR_CONST_I64, 3, -1, -1, 3))
	start = start.append(mir_op(MIR_CONST_I64, 5, -1, -1, 1))
	let check = Array[MirInstruction]().append(mir_op(MIR_LT_I64, 2, 1, 3, 0))
	var body = Array[MirInstruction]()
	body = body.append(mir_string(4, "q"))
	body = body.append(mir_op(MIR_STRING_CONCAT, 0, 0, 4, 0))
	body = body.append(mir_op(MIR_ADD_I64, 1, 1, 5, 0))
	let done = Array[MirInstruction]().append(mir_op(MIR_STRING_LENGTH, 6, 0, -1, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_BOOL, TYPE_TAG_I64, TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(start, mir_jump(1)), MirBlock(check, mir_branch(2, 2, 3)), MirBlock(body, mir_jump(1)), MirBlock(done, mir_return(6))], 0)
	return MirProgram([function])

def lifetime_nested_program() -> MirProgram
	let array = intern_array_type(new_type_table(), TYPE_TAG_STRING)
	var code = Array[MirInstruction]()
	code = code.append(mir_string(0, "abc"))
	code = code.append(mir_array_new(1, [0]))
	code = code.append(mir_op(MIR_COPY, 2, 1, -1, 0))
	code = code.append(mir_op(MIR_ARRAY_LENGTH, 3, 2, -1, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, array.id, array.id, TYPE_TAG_I64], [MirBlock(code, mir_return(3))], 0)
	var program = MirProgram([function])
	program.types = array.table
	return program

def lifetime_cow_program() -> MirProgram
	let array = intern_array_type(new_type_table(), TYPE_TAG_I64)
	var code = Array[MirInstruction]()
	code = code.append(mir_op(MIR_CONST_I64, 1, -1, -1, 2))
	code = code.append(mir_array_new(0, [1]))
	code = code.append(mir_op(MIR_COPY, 4, 0, -1, 0))
	code = code.append(mir_op(MIR_CONST_I64, 2, -1, -1, 0))
	code = code.append(mir_op(MIR_CONST_I64, 3, -1, -1, 5))
	code = code.append(mir_array_set(0, 0, 2, 3))
	code = code.append(mir_array_get(5, 4, 2))
	code = code.append(mir_array_get(6, 0, 2))
	code = code.append(mir_op(MIR_ADD_I64, 7, 5, 6, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [array.id, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64, array.id, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(code, mir_return(7))], 0)
	var program = MirProgram([function])
	program.types = array.table
	return program

def main() -> i64
	let args = arguments()
	if len(args) != 6
		return 1
	var programs = Array[MirProgram]()
	programs = programs.append(lifetime_branch_program(0))
	programs = programs.append(lifetime_branch_program(1))
	programs = programs.append(lifetime_loop_program())
	programs = programs.append(lifetime_nested_program())
	programs = programs.append(lifetime_cow_program())
	for i in 0..len(programs)
		let owned = mir_insert_lifetimes(programs[!i])
		if owned.error != "" or owned.releases < 2
			print(owned.error)
			return 2
		let repeated = mir_insert_lifetimes(owned.program)
		if repeated.error != "" or repeated.releases != 0
			return 3
		let result = mir_execute(owned.program, 0, Array[MirValue](), 500, 10)
		var expected = 4
		if i == 3
			expected = 1
		if i == 4
			expected = 7
		if result.error != "" or result.value.bits != expected
			print(result.error)
			return 4
		for item in result.heap
			if item.refs != 0
				return 5
		let generated = mir_emit_c(owned.program, 0)
		if generated.error != "" or not write_text(args[!i + 1], generated.code)
			return 6
	print("PASS MIR CFG lifetimes")
	return 0
