import mir alias Mir
import mir_emit_c alias MirEmitC
import mir_interpreter alias MirInterpreter
import mir_verify alias MirVerify
import types alias Types
# Canonical nested-record MIR: interpreted execution and C emission.
def record_test_program(invalidate: bool) -> Mir.MirProgram
	let inner = Types.intern_record_type(Types.new_type_table(), [Types.RecordField("name", Types.TYPE_TAG_STRING), Types.RecordField("count", Types.TYPE_TAG_I64)])
	let outer = Types.intern_record_type(inner.table, [Types.RecordField("title", Types.TYPE_TAG_STRING), Types.RecordField("inner", inner.id)])
	let get_name = Mir.MirFunction(1, Types.TYPE_TAG_STRING, [inner.id, Types.TYPE_TAG_STRING], [Mir.MirBlock([Mir.mir_record_get(1, 0, 1)], Mir.mir_return(1))], 0)
	var instructions = Array[Mir.MirInstruction]()
	instructions = instructions.append(Mir.mir_op(Mir.MIR_CONST_I64, 0, -1, -1, 7))
	instructions = instructions.append(Mir.mir_string(1, "Ada"))
	instructions = instructions.append(Mir.mir_record_new(2, [0, 1]))
	instructions = instructions.append(Mir.mir_string(3, "outer"))
	instructions = instructions.append(Mir.mir_record_new(4, [2, 3]))
	# Self-copy must retain the incoming owner before releasing the old slot.
	instructions = instructions.append(Mir.mir_op(Mir.MIR_COPY, 4, 4, -1, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_COPY, 5, 4, -1, 0))
	if invalidate
		instructions = instructions.append(Mir.mir_op(Mir.MIR_RELEASE, 5, 5, -1, 0))
	instructions = instructions.append(Mir.mir_record_get(6, 5, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_MOVE, 7, 6, -1, 0))
	instructions = instructions.append(Mir.mir_call(8, 1, [7]))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_PRINT, -1, 8, -1, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 9, 8, -1, 0))
	instructions = instructions.append(Mir.mir_record_get(10, 4, 1))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 11, 10, -1, 0))
	instructions = instructions.append(Mir.mir_op(Mir.MIR_ADD_I64, 12, 9, 11, 0))
	if not invalidate
		instructions = instructions.append(Mir.mir_op(Mir.MIR_RELEASE, 5, 5, -1, 0))
		instructions = instructions.append(Mir.mir_op(Mir.MIR_RELEASE, 7, 7, -1, 0))
	let runner = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_I64, Types.TYPE_TAG_STRING, inner.id, Types.TYPE_TAG_STRING, outer.id, outer.id, inner.id, inner.id, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [Mir.MirBlock(instructions, Mir.mir_return(12))], 0)
	var program = Mir.new_mir_program([runner, get_name])
	program.types = outer.table
	return program

def record_return_program() -> Mir.MirProgram
	let typed = Types.intern_record_type(Types.new_type_table(), [Types.RecordField("name", Types.TYPE_TAG_STRING), Types.RecordField("count", Types.TYPE_TAG_I64)])
	var making = Array[Mir.MirInstruction]()
	making = making.append(Mir.mir_op(Mir.MIR_CONST_I64, 0, -1, -1, 9))
	making = making.append(Mir.mir_string(1, "held"))
	making = making.append(Mir.mir_record_new(2, [0, 1]))
	let maker = Mir.MirFunction(0, typed.id, [Types.TYPE_TAG_I64, Types.TYPE_TAG_STRING, typed.id], [Mir.MirBlock(making, Mir.mir_return(2))], 0)
	var reading = Array[Mir.MirInstruction]()
	reading = reading.append(Mir.mir_call(0, 1, Array[i64]()))
	reading = reading.append(Mir.mir_record_get(1, 0, 1))
	reading = reading.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 2, 1, -1, 0))
	let caller = Mir.MirFunction(0, Types.TYPE_TAG_I64, [typed.id, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], [Mir.MirBlock(reading, Mir.mir_return(2))], 0)
	var program = Mir.new_mir_program([caller, maker])
	program.types = typed.table
	return program

def main() -> i64
	let args = arguments()
	if len(args) != 4
		return 1
	let program = record_test_program(false)
	if MirVerify.mir_verify(program) != ""
		print(MirVerify.mir_verify(program))
		return 2
	let result = MirInterpreter.mir_execute(program, 0, Array[Mir.MirValue](), 200, 10)
	if result.error != "" or result.value.bits != 8
		print(result.error)
		return 3
	for record in result.heap
		if record.refs != 0
			return 4
	let native = MirEmitC.mir_emit_c(program, 0)
	if native.error != "" or not write_text(args[!1], native.code)
		print(native.error)
		return 5
	var wrong_layout = record_test_program(false)
	var broken = wrong_layout.functions[!0]
	var first = broken.blocks[!0]
	first.instructions[!2] = Mir.mir_record_new(2, [1, 0])
	broken.blocks[!0] = first
	wrong_layout.functions[!0] = broken
	if MirVerify.mir_verify(wrong_layout) != "record constructor field type mismatch"
		return 9
	let return_test = record_return_program()
	let returned = MirInterpreter.mir_execute(return_test, 0, Array[Mir.MirValue](), 200, 10)
	if returned.error != "" or returned.value.bits != 4
		return 10
	for record in returned.heap
		if record.refs != 0
			return 11
	let c_return = MirEmitC.mir_emit_c(return_test, 0)
	if c_return.error != "" or not write_text(args[!3], c_return.code)
		return 12
	let invalid = record_test_program(true)
	let stopped = MirInterpreter.mir_execute(invalid, 0, Array[Mir.MirValue](), 200, 10)
	if stopped.error != "uninitialized record"
		print(stopped.error)
		return 6
	let native_bad = MirEmitC.mir_emit_c(invalid, 0)
	if native_bad.error != "" or not write_text(args[!2], native_bad.code)
		return 7
	print("PASS record MIR")
	return 0
