import mir_emit_c alias MirEmitC
import mir alias Mir
import mir_interpreter alias MirInterpreter
import mir_opt alias MirOpt
import mir_ownership alias MirOwnership
import types alias Types
# Verify that the peephole consumes only an immediately released owned copy.
def mir_opt_fixture(retain: bool, adjacent: bool) -> Mir.MirProgram
	var code = Array[Mir.MirInstruction]()
	code = code.append(Mir.mir_string(0, "abc"))
	var op = Mir.MIR_COPY
	if retain
		op = Mir.MIR_RETAIN
	code = code.append(Mir.mir_op(op, 1, 0, -1, 0))
	if not adjacent
		code = code.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 2, 0, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_RELEASE, 0, 0, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 2, 1, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_RELEASE, 1, 1, -1, 0))
	let function = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(2))], 0)
	return Mir.new_mir_program([function])

# Two identical exit-edge cleanups, one unreachable self-loop, and a
# forwarding block. Compaction must preserve the owned-string cleanup.
def mir_cfg_fixture() -> Mir.MirProgram
	let start = [Mir.mir_op(Mir.MIR_CONST_BOOL, 0, -1, -1, 1), Mir.mir_string(1, "temporary"), Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, 42)]
	let release = [Mir.mir_op(Mir.MIR_RELEASE_IF_INIT, 1, 1, -1, 0)]
	let blocks = [Mir.MirBlock(start, Mir.mir_branch(0, 1, 2)), Mir.MirBlock(release, Mir.mir_jump(3)), Mir.MirBlock(release, Mir.mir_jump(3)), Mir.MirBlock(Array[Mir.MirInstruction](), Mir.mir_return(2)), Mir.MirBlock(Array[Mir.MirInstruction](), Mir.mir_jump(4)), Mir.MirBlock(Array[Mir.MirInstruction](), Mir.mir_jump(3))]
	return Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_BOOL, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], blocks, 0)])

# A conditional release can execute on a path where the register never
# received an owned value; the verified NULL-safe release must handle it.
def mir_uninitialized_cleanup_fixture() -> Mir.MirProgram
	let entry = [Mir.mir_op(Mir.MIR_CONST_BOOL, 0, -1, -1, 0), Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, 43)]
	let blocks = [Mir.MirBlock(entry, Mir.mir_branch(0, 1, 2)), Mir.MirBlock([Mir.mir_string(1, "unused")], Mir.mir_jump(3)), Mir.MirBlock(Array[Mir.MirInstruction](), Mir.mir_jump(3)), Mir.MirBlock([Mir.mir_op(Mir.MIR_RELEASE_IF_INIT, 1, 1, -1, 0)], Mir.mir_return(2))]
	return Mir.new_mir_program([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_BOOL, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], blocks, 0)])

def main() -> i64
	let args = arguments()
	if len(args) != 6
		return 1
	for i in 0..3
		let program = mir_opt_fixture(i == 1, i != 2)
		if MirOwnership.mir_check_balance(program) != ""
			return 2
		let result = MirOpt.mir_optimize_unchecked(program)
		var expected = 1
		if i == 2
			expected = 0
		if result.moves != expected or MirOwnership.mir_check_balance(result.program) != ""
			return 3
		let instructions = result.program.functions[!0].blocks[!0].instructions
		if (instructions[!1].op == Mir.MIR_MOVE) != (expected == 1)
			return 4
		let repeated = MirOpt.mir_optimize_unchecked(result.program)
		if repeated.moves != 0
			return 5
		let executed = MirInterpreter.mir_execute(result.program, 0, Array[Mir.MirValue](), 100, 10)
		if executed.error != "" or executed.value.bits != 3
			return 6
		for item in executed.heap
			if item.refs != 0
				return 7
		let c = MirEmitC.mir_emit_c(result.program, 0)
		if c.error != "" or not write_text(args[!i + 1], c.code)
			return 8
		if (c.code.find("exit: ;") or (-1)) == -1 or (c.code.find("return returned;") or (-1)) == -1
			return 9
		# The verified backend replaces managed slots through one shared
		# helper, without repeated inline retain/release code.
		if (c.code.find("if (init0) s_string_release(r0);") or (-1)) == -1
			return 10
	let compacted = MirOpt.mir_optimize_unchecked(mir_cfg_fixture())
	if len(compacted.program.functions[!0].blocks) != 3 or MirOwnership.mir_check_balance(compacted.program) != ""
		return 11
	if len(MirOpt.mir_optimize_unchecked(compacted.program).program.functions[!0].blocks) != 3
		return 12
	let interpreted = MirInterpreter.mir_execute(compacted.program, 0, Array[Mir.MirValue](), 100, 10)
	if interpreted.error != "" or interpreted.value.bits != 42
		return 13
	for item in interpreted.heap
		if item.refs != 0
			return 14
	let verified = MirEmitC.mir_emit_c_reachable_verified(compacted.program, 0)
	let defensive = MirEmitC.mir_emit_c(compacted.program, 0)
	if verified.error != "" or defensive.error != "" or not write_text(args[!4], verified.code)
		return 15
	if (verified.code.find("if (r1)") or (-1)) != -1 or (verified.code.find("s_string_release(r1); r1 = NULL;") or (-1)) == -1
		return 16
	if (defensive.code.find("if (init1)") or (-1)) == -1
		return 17
	let conditional = MirOpt.mir_optimize_unchecked(mir_uninitialized_cleanup_fixture())
	if MirOwnership.mir_check_balance(conditional.program) != ""
		return 18
	let absent = MirInterpreter.mir_execute(conditional.program, 0, Array[Mir.MirValue](), 100, 10)
	if absent.error != "" or absent.value.bits != 43
		return 19
	let c_conditional = MirEmitC.mir_emit_c_reachable_verified(conditional.program, 0)
	if c_conditional.error != "" or not write_text(args[!5], c_conditional.code)
		return 20
	print("PASS MIR owned-copy elimination")
	return 0
