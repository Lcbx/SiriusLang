import mir alias Mir
import mir_cleanup alias Cleanup
import mir_emit_c alias Emit
import mir_interpreter alias Interpreter
import mir_ownership alias Ownership
import types alias Types

# Returned nested collections have one root credit and one credit per field,
# even when the same managed child occurs twice.
def nested_return() -> Mir.MirProgram
	var types = Types.new_type_table()
	let array = Types.intern_array_type(types, Types.TYPE_TAG_STRING)
	types = array.table
	let record = Types.intern_record_type(types, [Types.RecordField("a", array.id), Types.RecordField("b", Types.TYPE_TAG_STRING)])
	types = record.table
	let nested = Types.intern_array_type(types, record.id)
	types = nested.table
	var code = [Mir.mir_string(0, "a"), Mir.mir_string(1, "b"), Mir.mir_array_new(2, [0, 0])]
	code = code.append(Mir.mir_record_new(3, [2, 1])).append(Mir.mir_array_new(4, [3, 3]))
	for r in 0..4
		code = code.append(Mir.mir_op(Mir.MIR_RELEASE, r, r, -1, 0))
	let function = Mir.MirFunction(0, nested.id, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, array.id, record.id, nested.id], [Mir.MirBlock(code, Mir.mir_return(4))], 0)
	return Mir.mir_program_with_types([function], types)

# The loop consumes and replaces an array in its own register. Its end block
# must drop both the array and the element string, on the actual exit path.
def loop_result() -> Mir.MirProgram
	var types = Types.new_type_table()
	let array = Types.intern_array_type(types, Types.TYPE_TAG_STRING)
	types = array.table
	let setup = [Mir.mir_op(Mir.MIR_CONST_I64, 0, -1, -1, 3), Mir.mir_string(1, "x"), Mir.mir_array_new(2, Array[i64]())]
	let condition = [Mir.mir_op(Mir.MIR_CONST_I64, 3, -1, -1, 0), Mir.mir_op(Mir.MIR_LT_I64, 4, 3, 0, 0)]
	let update = [Mir.mir_array_append(2, 2, 1), Mir.mir_op(Mir.MIR_CONST_I64, 5, -1, -1, 1), Mir.mir_op(Mir.MIR_SUB_I64, 0, 0, 5, 0)]
	let done = [Mir.mir_op(Mir.MIR_ARRAY_LENGTH, 6, 2, -1, 0)]
	let blocks = [Mir.MirBlock(setup, Mir.mir_jump(1)), Mir.MirBlock(condition, Mir.mir_branch(4, 2, 3)), Mir.MirBlock(update, Mir.mir_jump(1)), Mir.MirBlock(done, Mir.mir_return(6))]
	let function = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_I64, Types.TYPE_TAG_STRING, array.id, Types.TYPE_TAG_I64, Types.TYPE_TAG_BOOL, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], blocks, 0)
	return Mir.mir_program_with_types([function], types)

# A branch leaves a managed value owned on only one incoming path.
def conditional_result(mode: i64) -> Mir.MirProgram
	let entry = [Mir.mir_op(Mir.MIR_CONST_BOOL, 0, -1, -1, mode)]
	let yes = [Mir.mir_string(1, "conditional")]
	let done = [Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, 19)]
	let function = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_BOOL, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], [Mir.MirBlock(entry, Mir.mir_branch(0, 1, 2)), Mir.MirBlock(yes, Mir.mir_jump(2)), Mir.MirBlock(done, Mir.mir_return(2))], 0)
	return Mir.new_mir_program([function])

# A caller borrows the returned collection credit, then releases it after use.
def nested_call() -> Mir.MirProgram
	let nested = nested_return()
	let callee = nested.functions[!0]
	let code = [Mir.mir_call(0, 0, Array[i64]()), Mir.mir_op(Mir.MIR_ARRAY_LENGTH, 1, 0, -1, 0), Mir.mir_op(Mir.MIR_RELEASE, 0, 0, -1, 0)]
	let caller = Mir.MirFunction(0, Types.TYPE_TAG_I64, [callee.return_type, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(1))], 0)
	return Mir.mir_program_with_types([callee, caller], nested.types)

# Retaining a record and then replacing a nested array field forces CoW in
# both the array and record while preserving the old branch of the graph.
def cow_return() -> Mir.MirProgram
	var types = Types.new_type_table()
	let array = Types.intern_array_type(types, Types.TYPE_TAG_STRING)
	types = array.table
	let record = Types.intern_record_type(types, [Types.RecordField("items", array.id)])
	types = record.table
	let nested = Types.intern_array_type(types, record.id)
	types = nested.table
	var code = [Mir.mir_string(0, "x"), Mir.mir_array_new(1, [0]), Mir.mir_record_new(2, [1])]
	code = code.append(Mir.mir_op(Mir.MIR_COPY, 3, 2, -1, 0)).append(Mir.mir_string(4, "y"))
	code = code.append(Mir.mir_array_append(1, 1, 4)).append(Mir.mir_record_set(2, 2, 0, 1))
	code = code.append(Mir.mir_array_new(5, [2, 3]))
	for r in 0..5
		code = code.append(Mir.mir_op(Mir.MIR_RELEASE, r, r, -1, 0))
	let function = Mir.MirFunction(0, nested.id, [Types.TYPE_TAG_STRING, array.id, record.id, record.id, Types.TYPE_TAG_STRING, nested.id], [Mir.MirBlock(code, Mir.mir_return(5))], 0)
	return Mir.mir_program_with_types([function], types)

def cow_call() -> Mir.MirProgram
	let nested = cow_return()
	let callee = nested.functions[!0]
	let code = [Mir.mir_call(0, 0, Array[i64]()), Mir.mir_op(Mir.MIR_ARRAY_LENGTH, 1, 0, -1, 0), Mir.mir_op(Mir.MIR_RELEASE, 0, 0, -1, 0)]
	let caller = Mir.MirFunction(0, Types.TYPE_TAG_I64, [callee.return_type, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(1))], 0)
	return Mir.mir_program_with_types([callee, caller], nested.types)

# The same slot can own a heap value on just one predecessor, and a new
# constructor at the join must replace that owner without leaking it.
def conditional_replacement(mode: i64) -> Mir.MirProgram
	let array = Types.intern_array_type(Types.new_type_table(), Types.TYPE_TAG_I64)
	let entry = [Mir.mir_op(Mir.MIR_CONST_BOOL, 0, -1, -1, mode)]
	let yes = [Mir.mir_array_new(1, Array[i64]())]
	var done = [Mir.mir_array_new(1, Array[i64]())]
	done = done.append(Mir.mir_op(Mir.MIR_RELEASE, 1, 1, -1, 0))
	done = done.append(Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, 23))
	let blocks = [Mir.MirBlock(entry, Mir.mir_branch(0, 1, 2)), Mir.MirBlock(yes, Mir.mir_jump(2)), Mir.MirBlock(done, Mir.mir_return(2))]
	return Mir.mir_program_with_types([Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_BOOL, array.id, Types.TYPE_TAG_I64], blocks, 0)], array.table)

# Both slots initially own one credit. Moving into the occupied destination
# drops its old credit and transfers the source's credit without retaining.
def move_replacement() -> Mir.MirProgram
	let array = Types.intern_array_type(Types.new_type_table(), Types.TYPE_TAG_I64)
	var code = [Mir.mir_array_new(0, Array[i64]()), Mir.mir_array_new(1, Array[i64]())]
	code = code.append(Mir.mir_op(Mir.MIR_MOVE, 1, 0, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_RELEASE, 1, 1, -1, 0))
	code = code.append(Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, 23))
	return Mir.mir_program_with_types([Mir.MirFunction(0, Types.TYPE_TAG_I64, [array.id, array.id, Types.TYPE_TAG_I64], [Mir.MirBlock(code, Mir.mir_return(2))], 0)], array.table)

export def main() -> i64
	let args = arguments()
	if len(args) != 9
		return 1
	let nested = nested_return()
	if Ownership.mir_check_balance(nested) != ""
		return 2
	let result = Interpreter.mir_execute(nested, 0, Array[Mir.MirValue](), 200, 10)
	if result.error != "" or Interpreter.mir_audit_return_credits(nested.types, result) != ""
		return 3
	if result.heap[!result.value.bits].refs != 1
		return 4
	var broken = result
	var heap = broken.heap
	var cell = heap[!result.value.bits]
	cell.refs += 1
	heap[!result.value.bits] = cell
	broken.heap = heap
	if Interpreter.mir_audit_return_credits(nested.types, broken) == ""
		return 5
	broken = result
	broken.value = Mir.new_mir_value(result.value.type_id, len(result.heap), "")
	if Interpreter.mir_audit_return_credits(nested.types, broken) == ""
		return 6
	broken = result
	heap = broken.heap
	let leaked = Mir.MirHeapRecord(result.value.type_id, Array[Mir.MirValue](), 1)
	heap = heap.append(leaked)
	broken.heap = heap
	if Interpreter.mir_audit_return_credits(nested.types, broken) == ""
		return 10
	let cow = cow_return()
	if Ownership.mir_check_balance(cow) != ""
		return 11
	let cow_result = Interpreter.mir_execute(cow, 0, Array[Mir.MirValue](), 300, 10)
	if cow_result.error != "" or Interpreter.mir_audit_return_credits(cow.types, cow_result) != ""
		print(cow_result.error)
		return 12
	for mode in 0..5
		var program = conditional_result(mode % 2)
		if mode == 2
			program = loop_result()
		elif mode == 3
			program = nested_call()
		elif mode == 4
			program = cow_call()
		let cleaned = Cleanup.mir_insert_exit_cleanup(program)
		if cleaned.error != "" or Ownership.mir_check_balance(cleaned.program) != ""
			print(cleaned.error)
			return 7
		var entry = 0
		if mode >= 3
			entry = 1
		let ran = Interpreter.mir_execute(cleaned.program, entry, Array[Mir.MirValue](), 1000, 10)
		var expected = 19
		if mode == 2
			expected = 3
		elif mode >= 3
			expected = 2
		if ran.error != "" or ran.value.bits != expected or Interpreter.mir_audit_return_credits(cleaned.program.types, ran) != ""
			print(ran.error)
			return 8
		let emitted = Emit.mir_emit_c_reachable_verified(cleaned.program, entry)
		if emitted.error != "" or not write_text(args[!mode + 1], emitted.code)
			print(emitted.error)
			return 9
	for i in 0..3
		var replacement = conditional_replacement(i % 2)
		if i == 2
			replacement = move_replacement()
		let credit_check = Ownership.mir_check_balance(replacement)
		if credit_check != ""
			print(credit_check)
			return 13
		let outcome = Interpreter.mir_execute(replacement, 0, Array[Mir.MirValue](), 100, 10)
		if outcome.error != "" or outcome.value.bits != 23 or Interpreter.mir_audit_return_credits(replacement.types, outcome) != ""
			print(outcome.error)
			return 14
		let emitted = Emit.mir_emit_c_reachable_verified(replacement, 0)
		if emitted.error != "" or not write_text(args[!i + 6], emitted.code)
			print(emitted.error)
			return 15
	print("PASS MIR return heap credits")
	return 0
