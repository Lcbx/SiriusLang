import types alias Types
import mir alias Mir
import mir_verify alias Verify
import mir_interpreter alias Interpreter
import mir_emit_c alias Emit
import mir_wire alias Wire
import mir_link alias Link
import mir_library alias Library

# Call a named target through a typed, noncapturing function value.
def main() -> i64
	let args = arguments()
	if len(args) != 2
		return 2
	let signature = Types.intern_function_type(Types.new_type_table(), [Types.TYPE_TAG_I64], Types.TYPE_TAG_I64, Types.FUNCTION_EFFECT_UNCHECKED)
	if signature.id == Types.TYPE_TAG_INVALID
		return 3
	let target_block = Mir.MirBlock([Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, 2), Mir.mir_op(Mir.MIR_MUL_I64, 2, 0, 1, 0)], Mir.mir_return(2))
	let target = Mir.MirFunction(1, Types.TYPE_TAG_I64, [Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [target_block], 0)
	let unrelated_block = Mir.MirBlock([Mir.mir_op(Mir.MIR_CONST_I64, 0, -1, -1, 7)], Mir.mir_return(0))
	let unrelated = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_I64], [unrelated_block], 0)
	let main_block = Mir.MirBlock([Mir.mir_function_ref(0, 2), Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, 21), Mir.mir_call_indirect(2, 0, [1])], Mir.mir_return(2))
	let entry = Mir.MirFunction(0, Types.TYPE_TAG_I64, [signature.id, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [main_block], 0)
	let program = Mir.mir_program_with_types([entry, unrelated, target], signature.table)
	if Verify.mir_verify(program) != ""
		return 4
	let execution = Interpreter.mir_execute(program, 0, Array[Mir.MirValue](), 100, 10)
	if execution.error != "" or execution.value.bits != 42
		return 5
	let saved = Wire.mir_serialize_program(program, 0)
	if saved.error != ""
		return 6
	let loaded = Wire.mir_deserialize_program(saved.text)
	if loaded.error != ""
		return 7
	let replay = Interpreter.mir_execute(loaded.program, loaded.entry, Array[Mir.MirValue](), 100, 10)
	if replay.error != "" or replay.value.bits != 42
		return 8
	# A preceding library shifts every function ID, including the referenced
	# target. The linker and reachable emitter must both relocate the reference.
	let prefix = Mir.mir_program_with_types([unrelated], Types.new_type_table())
	let first_library = Library.MirLibraryLoad(prefix, [Mir.MirNamedExport("unused", 0)], "", Array[Mir.MirNamedImport]())
	let second_library = Library.MirLibraryLoad(program, [Mir.MirNamedExport("main", 0)], "", Array[Mir.MirNamedImport]())
	let linked = Link.mir_link_libraries([first_library, second_library])
	if linked.error != "" or len(linked.exports) != 2 or linked.exports[!1].function_id != 1
		return 9
	let linked_result = Interpreter.mir_execute(linked.program, 1, Array[Mir.MirValue](), 100, 10)
	if linked_result.error != "" or linked_result.value.bits != 42
		return 11
	let native = Emit.mir_emit_c_reachable(linked.program, 1)
	if native.error != "" or not write_text(args[!1], native.code)
		return 12
	let wrong = Mir.MirBlock([Mir.mir_function_ref(0, 1), Mir.mir_op(Mir.MIR_CONST_I64, 1, -1, -1, 21), Mir.mir_call_indirect(2, 0, [1])], Mir.mir_return(2))
	let invalid_entry = Mir.MirFunction(0, Types.TYPE_TAG_I64, [signature.id, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64], [wrong], 0)
	let bad = Mir.mir_program_with_types([invalid_entry, unrelated, target], signature.table)
	if Verify.mir_verify(bad) == ""
		return 10
	print("PASS MIR function references, indirect calls and serialization")
	return 0
