import mir alias Mir
import mir_cfg alias Cfg

def check(op: i64, first: i64, second: i64, immediate: i64, inputs: Array[i64], expected: Array[i64]) -> bool
	let instruction = Mir.MirInstruction(op, 0, first, second, immediate, inputs, "")
	let reads = Cfg.mir_instruction_reads(instruction)
	if len(reads) != len(expected)
		return false
	for i in 0..len(expected)
		if reads[!i] != expected[!i]
			return false
	return true

def main() -> i64
	if not check(Mir.MIR_CONST_I64, -1, -1, 9, Array[i64](), Array[i64]())
		return 1
	# Unused operand metadata does not turn a constant into a read.
	if not check(Mir.MIR_CONST_I64, -1, -1, 9, [3], Array[i64]())
		return 2
	if not check(Mir.MIR_RELEASE_IF_INIT, 5, -1, 0, Array[i64](), Array[i64]())
		return 3
	if not check(Mir.MIR_CALL, 0, 0, 0, [2, 4], [2, 4])
		return 4
	if not check(Mir.MIR_ARRAY_NEW, 0, 0, 0, [3, 4], [3, 4])
		return 5
	if not check(Mir.MIR_WRITE_TEXT, 7, 8, 0, Array[i64](), [7, 8])
		return 6
	if not check(Mir.MIR_ADD_I64, 7, 8, 0, Array[i64](), [7, 8])
		return 7
	if not check(Mir.MIR_ADD_I64, 7, 7, 0, Array[i64](), [7])
		return 8
	if not check(Mir.MIR_ARRAY_SET, 2, 3, 4, Array[i64](), [2, 4, 3])
		return 9
	if not check(Mir.MIR_DICT_INSERT, 2, 3, 4, [5, 6], [2, 5, 6])
		return 10
	print("PASS MIR instruction reads")
	return 0
