import mir alias Mir
import mir_emit_c alias MirEmitC
import mir_interpreter alias MirInterpreter
import mir_verify alias MirVerify
import types alias Types
# Shared managed-value MIR program: run interpreted and emit native C.
def main() -> i64
	let args = arguments()
	if len(args) != 3
		return 2
	var suffix_instructions = Array[Mir.MirInstruction]()
	suffix_instructions = suffix_instructions.append(Mir.mir_string(1, "!"))
	suffix_instructions = suffix_instructions.append(Mir.mir_op(Mir.MIR_STRING_CONCAT, 2, 0, 1, 0))
	let suffix = Mir.MirBlock(suffix_instructions, Mir.mir_return(2))
	let helper = Mir.MirFunction(1, Types.TYPE_TAG_STRING, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING], [suffix], 0)
	var statements = Array[Mir.MirInstruction]()
	statements = statements.append(Mir.mir_string(0, "hello"))
	statements = statements.append(Mir.mir_op(Mir.MIR_COPY, 1, 0, -1, 0))
	statements = statements.append(Mir.mir_op(Mir.MIR_MOVE, 2, 1, -1, 0))
	statements = statements.append(Mir.mir_op(Mir.MIR_RETAIN, 3, 2, -1, 0))
	statements = statements.append(Mir.mir_call(4, 1, [3]))
	statements = statements.append(Mir.mir_op(Mir.MIR_RELEASE, 2, 2, -1, 0))
	statements = statements.append(Mir.mir_op(Mir.MIR_PRINT, -1, 4, -1, 0))
	statements = statements.append(Mir.mir_op(Mir.MIR_STRING_LENGTH, 5, 4, -1, 0))
	statements = statements.append(Mir.mir_op(Mir.MIR_RELEASE, 4, 4, -1, 0))
	let runner = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], [Mir.MirBlock(statements, Mir.mir_return(5))], 0)
	let program = Mir.new_mir_program([runner, helper])
	if MirVerify.mir_verify(program) != ""
		return 3
	let interpreted = MirInterpreter.mir_execute(program, 0, Array[Mir.MirValue](), 500, 10)
	if interpreted.error != "" or interpreted.value.bits != 6
		return 4
	let native = MirEmitC.mir_emit_c(program, 0)
	if native.error != "" or not write_text(args[!1], native.code)
		return 5
	var bad_instructions = Array[Mir.MirInstruction]()
	bad_instructions = bad_instructions.append(Mir.mir_string(0, "drop"))
	bad_instructions = bad_instructions.append(Mir.mir_op(Mir.MIR_MOVE, 1, 0, -1, 0))
	bad_instructions = bad_instructions.append(Mir.mir_op(Mir.MIR_PRINT, -1, 0, -1, 0))
	bad_instructions = bad_instructions.append(Mir.mir_op(Mir.MIR_CONST_I64, 2, -1, -1, 0))
	let invalid = Mir.MirFunction(0, Types.TYPE_TAG_I64, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64], [Mir.MirBlock(bad_instructions, Mir.mir_return(2))], 0)
	let bad = Mir.new_mir_program([invalid])
	let stopped = MirInterpreter.mir_execute(bad, 0, Array[Mir.MirValue](), 50, 5)
	if stopped.error != "uninitialized register"
		return 6
	let bad_c = MirEmitC.mir_emit_c(bad, 0)
	if bad_c.error != "" or not write_text(args[!2], bad_c.code)
		return 7
	print("PASS managed MIR")
	return 0
