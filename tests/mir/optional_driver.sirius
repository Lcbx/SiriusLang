# Hand-built MIR optionals: present/missing values, managed payloads and panic.
def optional_string_program() -> MirProgram
	let array = intern_array_type(new_type_table(), TYPE_TAG_STRING)
	let optional = intern_optional_type(array.table, TYPE_TAG_STRING)
	var code = Array[MirInstruction]()
	code = code.append(mir_string(0, "hello"))
	code = code.append(mir_array_new(1, [0]))
	code = code.append(mir_op(MIR_CONST_I64, 2, -1, -1, 0))
	code = code.append(mir_array_get_optional(3, 1, 2))
	code = code.append(mir_optional_has(4, 3))
	code = code.append(mir_optional_unwrap(5, 3))
	code = code.append(mir_op(MIR_STRING_LENGTH, 6, 5, -1, 0))
	code = code.append(mir_optional_none(7))
	code = code.append(mir_optional_has(8, 7))
	code = code.append(mir_optional_some(9, 0))
	code = code.append(mir_optional_unwrap(10, 9))
	code = code.append(mir_op(MIR_STRING_LENGTH, 11, 10, -1, 0))
	code = code.append(mir_op(MIR_ADD_I64, 12, 6, 11, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, array.id, TYPE_TAG_I64, optional.id, TYPE_TAG_BOOL, TYPE_TAG_STRING, TYPE_TAG_I64, optional.id, TYPE_TAG_BOOL, optional.id, TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock(code, mir_return(12))], 0)
	var program = MirProgram([function])
	program.types = optional.table
	return program

def optional_missing_program() -> MirProgram
	let optional = intern_optional_type(new_type_table(), TYPE_TAG_I64)
	var instructions = Array[MirInstruction]()
	instructions = instructions.append(mir_optional_none(0))
	instructions = instructions.append(mir_optional_unwrap(1, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [optional.id, TYPE_TAG_I64], [MirBlock(instructions, mir_return(1))], 0)
	var program = MirProgram([function])
	program.types = optional.table
	return program

def optional_dict_program() -> MirProgram
	let array = intern_array_type(new_type_table(), TYPE_TAG_STRING)
	let dict = intern_dict_type(array.table, TYPE_TAG_I64, array.id)
	let optional = intern_optional_type(dict.table, array.id)
	var code = Array[MirInstruction]()
	code = code.append(mir_dict_new(0))
	code = code.append(mir_op(MIR_CONST_I64, 1, -1, -1, 7))
	code = code.append(mir_string(2, "hello"))
	code = code.append(mir_array_new(3, [2]))
	code = code.append(mir_dict_insert(0, 0, 1, 3))
	code = code.append(mir_dict_get_optional(4, 0, 1))
	code = code.append(mir_optional_unwrap(5, 4))
	code = code.append(mir_op(MIR_ARRAY_LENGTH, 6, 5, -1, 0))
	let function = MirFunction(0, TYPE_TAG_I64, [dict.id, TYPE_TAG_I64, TYPE_TAG_STRING, array.id, optional.id, array.id, TYPE_TAG_I64], [MirBlock(code, mir_return(6))], 0)
	var program = MirProgram([function])
	program.types = optional.table
	return program

def main() -> i64
	let args = arguments()
	if len(args) != 4
		return 1
	let present = optional_string_program()
	let outcome = mir_execute(present, 0, Array[MirValue](), 100, 10)
	if outcome.error != "" or outcome.value.bits != 10
		print(outcome.error)
		return 2
	for record in outcome.heap
		if record.refs != 0
			return 3
	let generated = mir_emit_c(present, 0)
	if generated.error != "" or not write_text(args[!1], generated.code)
		return 4
	let missing = optional_missing_program()
	let missing_outcome = mir_execute(missing, 0, Array[MirValue](), 100, 10)
	if missing_outcome.error != "missing optional value"
		return 5
	let missing_c = mir_emit_c(missing, 0)
	if missing_c.error != "" or not write_text(args[!2], missing_c.code)
		return 6
	let nested = optional_dict_program()
	let nested_outcome = mir_execute(nested, 0, Array[MirValue](), 100, 10)
	if nested_outcome.error != "" or nested_outcome.value.bits != 1
		print(nested_outcome.error)
		return 7
	for record in nested_outcome.heap
		if record.refs != 0
			return 8
	let nested_c = mir_emit_c(nested, 0)
	if nested_c.error != "" or not write_text(args[!3], nested_c.code)
		return 9
	print("PASS optional MIR")
	return 0
