# Call ownership transfer must preserve both native and interpreter semantics.
def mir_call_move_fixture(mode: i64) -> MirProgram
	var caller = Array[MirInstruction]()
	caller = caller.append(mir_string(0, "abc"))
	var register_types = [TYPE_TAG_STRING, TYPE_TAG_I64]
	var result = 3
	if mode == 1 or mode == 2
		register_types = [TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64]
		caller = caller.append(mir_op(MIR_RETAIN, 1, 0, -1, 0))
		var inputs = [0, 1]
		if mode == 2
			inputs = [0, 0]
		caller = caller.append(mir_call(2, 1, inputs))
		caller = caller.append(mir_op(MIR_RELEASE, 1, 1, -1, 0))
		caller = caller.append(mir_op(MIR_RELEASE, 0, 0, -1, 0))
		result = 6
	else
		caller = caller.append(mir_call(1, 1, [0]))
		if mode == 3
			# A later use prevents transfer across this instruction.
			register_types = [TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64]
			caller = caller.append(mir_op(MIR_STRING_LENGTH, 2, 0, -1, 0))
			caller = caller.append(mir_op(MIR_ADD_I64, 3, 1, 2, 0))
		caller = caller.append(mir_op(MIR_RELEASE, 0, 0, -1, 0))
		if mode == 3
			result = 6
	var return_reg = 1
	if mode == 1 or mode == 2
		return_reg = 2
	if mode == 3
		return_reg = 3
	let first = MirFunction(0, TYPE_TAG_I64, register_types, [MirBlock(caller, mir_return(return_reg))], 0)
	var inner = Array[MirInstruction]()
	inner = inner.append(mir_op(MIR_STRING_LENGTH, 1, 0, -1, 0))
	var inner_types = [TYPE_TAG_STRING, TYPE_TAG_I64]
	var inner_return = 1
	if mode == 1 or mode == 2
		inner_types = [TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64]
		inner = Array[MirInstruction]()
		inner = inner.append(mir_op(MIR_STRING_LENGTH, 2, 0, -1, 0))
		inner = inner.append(mir_op(MIR_STRING_LENGTH, 3, 1, -1, 0))
		inner = inner.append(mir_op(MIR_ADD_I64, 4, 2, 3, 0))
		inner_return = 4
	inner = inner.append(mir_op(MIR_RELEASE, 0, 0, -1, 0))
	if mode == 1 or mode == 2
		inner = inner.append(mir_op(MIR_RELEASE, 1, 1, -1, 0))
	# Explicit argument count: the unary and binary callees both own their arguments.
	var callee = MirFunction(1, TYPE_TAG_I64, inner_types, [MirBlock(inner, mir_return(inner_return))], 0)
	if mode == 1 or mode == 2
		callee = MirFunction(2, TYPE_TAG_I64, inner_types, [MirBlock(inner, mir_return(inner_return))], 0)
	return MirProgram([first, callee])

def main() -> i64
	let paths = arguments()
	if len(paths) != 6
		return 1
	for mode in 0..4
		let program = mir_call_move_fixture(mode)
		if mir_check_balance(program) != ""
			return 2
		let optimized = mir_optimize_unchecked(program)
		if mir_check_balance(optimized.program) != ""
			return 3
		let instructions = optimized.program.functions[!0].blocks[!0].instructions
		var moves = 0
		for ins in instructions
			if ins.op == MIR_CALL_MOVE
				moves += 1
				if mode == 1 and (not mir_call_move_at(ins, 0) or not mir_call_move_at(ins, 1))
					return 12
		if moves != 1 and (mode == 0 or mode == 1)
			return 4
		if moves != 0 and (mode == 2 or mode == 3)
			return 5
		let again = mir_optimize_unchecked(optimized.program)
		if again.moves != 0
			return 6
		let executed = mir_execute(optimized.program, 0, Array[MirValue](), 100, 10)
		if executed.error != ""
			return 7
		if (mode == 0 and executed.value.bits != 3) or (mode != 0 and executed.value.bits != 6)
			return 7
		for item in executed.heap
			if item.refs != 0
				return 8
		let emitted = mir_emit_c_verified(optimized.program, 0)
		if emitted.error != "" or not write_text(paths[!mode + 1], emitted.code)
			return 9
	# Three distinct managed arguments, interleaved with a borrowed scalar.
	let caller = MirFunction(0, TYPE_TAG_I64,
		[TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64],
		[MirBlock([mir_string(0, "ab"), mir_string(1, "abc"), mir_string(2, "d"), mir_op(MIR_CONST_I64, 3, -1, -1, 5),
			mir_call(4, 1, [0, 3, 1, 2]), mir_op(MIR_RELEASE, 2, 2, -1, 0),
			mir_op(MIR_RELEASE, 0, 0, -1, 0), mir_op(MIR_RELEASE, 1, 1, -1, 0)], mir_return(4))], 0)
	let multi_callee = MirFunction(4, TYPE_TAG_I64,
		[TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64, TYPE_TAG_I64],
		[MirBlock([mir_op(MIR_STRING_LENGTH, 4, 0, -1, 0), mir_op(MIR_STRING_LENGTH, 5, 2, -1, 0),
			mir_op(MIR_STRING_LENGTH, 6, 3, -1, 0), mir_op(MIR_ADD_I64, 7, 4, 5, 0),
			mir_op(MIR_ADD_I64, 8, 7, 6, 0), mir_op(MIR_RELEASE, 0, 0, -1, 0),
			mir_op(MIR_RELEASE, 2, 2, -1, 0), mir_op(MIR_RELEASE, 3, 3, -1, 0)], mir_return(8))], 0)
	let triplet = MirProgram([caller, multi_callee])
	if mir_check_balance(triplet) != ""
		return 13
	let optimized_triplet = mir_optimize_unchecked(triplet)
	if optimized_triplet.moves != 3 or mir_check_balance(optimized_triplet.program) != ""
		return 14
	var triplet_moves = 0
	for ins in optimized_triplet.program.functions[!0].blocks[!0].instructions
		if ins.op == MIR_CALL_MOVE
			triplet_moves += 1
			if not mir_call_move_at(ins, 0) or mir_call_move_at(ins, 1) or not mir_call_move_at(ins, 2) or not mir_call_move_at(ins, 3)
				return 15
	if triplet_moves != 1
		return 15
	let scalar_transfer = mir_call_moves(4, 1, [0, 3, 1, 2], [0, 3])
	if mir_verify_instruction(triplet, caller, scalar_transfer) == ""
		return 20
	let duplicate_transfer = mir_call_moves(4, 1, [0, 3, 1, 1], [0, 1])
	if mir_verify_instruction(triplet, caller, duplicate_transfer) == ""
		return 21
	let invalid_mask = MirInstruction(MIR_CALL_MOVE, 4, 0, -1, 1, [0, 3, 1, 2], "")
	if mir_verify_instruction(triplet, caller, invalid_mask) == ""
		return 22
	let outcome = mir_execute(optimized_triplet.program, 0, Array[MirValue](), 100, 10)
	if outcome.error != "" or outcome.value.bits != 6
		return 16
	for item in outcome.heap
		if item.refs != 0
			return 17
	let emitted_triplet = mir_emit_c_verified(optimized_triplet.program, 0)
	if emitted_triplet.error != "" or not write_text(paths[!5], emitted_triplet.code)
		return 18
	# A transferred argument cannot be used afterwards.
	let invalid_multi = MirFunction(0, TYPE_TAG_I64,
		[TYPE_TAG_STRING, TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64],
		[MirBlock([mir_string(0, "abc"), mir_string(1, "def"),
			mir_call_moves(2, 1, [0, 1], [0, 1]), mir_op(MIR_STRING_LENGTH, 3, 1, -1, 0)], mir_return(3))], 0)
	if mir_check_ownership(MirProgram([invalid_multi, mir_call_move_fixture(1).functions[!1]])) == ""
		return 19
	let bad = mir_call_move(1, 1, [0, 0], 0)
	if mir_verify_instruction(mir_call_move_fixture(2), mir_call_move_fixture(2).functions[!0], bad) == ""
		return 10
	let callee = mir_call_move_fixture(0).functions[!1]
	let invalid = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_STRING, TYPE_TAG_I64, TYPE_TAG_I64], [MirBlock([mir_string(0, "abc"), mir_call_move(1, 1, [0], 0), mir_op(MIR_STRING_LENGTH, 2, 0, -1, 0)], mir_return(2))], 0)
	if mir_check_ownership(MirProgram([invalid, callee])) == ""
		return 11
	print("PASS MIR call ownership transfers")
	return 0
