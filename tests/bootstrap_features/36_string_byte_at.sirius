def peek(text: string, i: i64) -> i64
	return text.byte_at(i) or -1

def main() -> i64
	let text = "Aé"
	print(len(text))
	print(peek(text, 0))
	print(peek(text, 1))
	print(peek(text, 2))
	print(peek(text, 3))
	print(peek(text, -1))
	print("\n".byte_at(0) or -1)
	let embedded = "A\0Z"
	print(len(embedded))
	print(embedded.byte_at(1) or -1)
	print(embedded.byte_at(2) or -1)
	return 0
