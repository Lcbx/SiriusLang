def tick(x: i64) -> i64
	print(x)
	return x

def add(a: i64, b: i64) -> i64
	return a + b

def condition(n: i64) -> bool
	print(n)
	return n < 2

def main() -> i64
	print(add(tick(1), tick(2)))
	print(tick(3) + tick(4))
	let p = {z = tick(5), a = tick(6)}
	print(p.z + p.a)
	var n = 0
	while condition(n)
		n += 1
	return 0
