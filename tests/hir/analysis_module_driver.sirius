# Check the complete native HIR dependency chain, not just exported signatures.
import parser alias Ast
import types alias Types
import hir alias Hir
import hir_resolve alias Resolve
import hir_constants alias Constants
import hir_declarations alias Decl
import hir_analyze alias Analyze
import hir_specialize alias Spec
import hir_parametric alias Param

def main() -> i64
	let parsed = Ast.parse_module("def id(x: i64) -> i64\n\treturn x\ndef main() -> i64\n\treturn id(42)\n")
	if parsed.state.error != ""
		return 1
	let declarations = Decl.hir_module_declarations(parsed.state, parsed.node)
	if declarations.error != "" or len(declarations.functions) != 2
		return 2
	let analyzed = Analyze.hir_analyze_module_body(parsed.state, declarations.functions[!1], declarations.functions, Array[string]())
	if analyzed.error != "" or len(analyzed.nodes) == 0
		return 3
	let built = Spec.hir_specialize_program(parsed.state, declarations, "main", Array[i64]())
	if built.error != "" or len(built.bodies) != 2
		return 4
	let checked = Resolve.resolve_hir_builtin_call(Types.new_type_table(), "len", [Types.TYPE_TAG_STRING])
	if checked.error != "" or checked.type_id != Types.TYPE_TAG_I64
		return 5
	let record = Resolve.hir_record_put(Array[Types.RecordField](), "x", Types.TYPE_TAG_I64)
	if record.error != "" or len(record.fields) != 1
		return 6
	let evaluated = Constants.hir_constant_push(Types.new_type_table(), Array[Hir.HirConstantValue](), Types.TYPE_TAG_I64, 5, Array[i64]())
	if not evaluated.valid or evaluated.values[!evaluated.index].bits != 5
		return 7
	let generic = Ast.parse_module("def identity(x)\n\treturn x\n")
	if generic.state.error != ""
		return 8
	let declarations_generic = Decl.hir_module_declarations(generic.state, generic.node)
	if declarations_generic.error != ""
		return 9
	let plan = Param.hir_parametric_plan(generic.state, declarations_generic.functions[!0], declarations_generic.functions)
	if len(plan.nodes) == 0 or plan.result_type != -2
		return 10
	print("HIR analysis modules OK")
	return 0
