rec Success(value: i64)

rec Failure(code: i64)

let Result = Success | Failure

def main() -> i64
	var values = Array[Result,1]()
	values = values.append(Success(7))
	values = values.append(Failure(2))
	print(len(values))
	let entry: Result = values[0?]!
	match entry
		Success(value)
			print(value)
		Failure(code)
			print(code)
	return 0
