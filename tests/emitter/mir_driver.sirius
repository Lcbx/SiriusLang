# Standalone MIR-only compiler entry point, without legacy emitter fallback.
def main() -> i64
	let args = arguments()
	if len(args) != 3
		print("usage: sirius input.sirius output.c")
		return 2
	let source = read_text(args[!1]) or ""
	let result = compile_c_mir(source)
	if result.error != ""
		print("ERROR " + str(result.line) + ": " + result.error)
		return 1
	if not write_text(args[!2], result.code)
		print("cannot write output")
		return 2
	return 0
