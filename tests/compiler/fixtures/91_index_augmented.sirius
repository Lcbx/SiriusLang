def index() -> i64
	print("index")
	return 1

def value() -> i64
	print("value")
	return 3

def main() -> i64
	var a = [4, 5, 6]
	let saved_a = a
	a[!index()] += value()
	var r = {group={numbers=[10, 20], grid=[[1, 2], [3, 4]]}, labels=["ab", "cd"]}
	let saved_r = r
	r.group.numbers[!1] -= 2
	r.group.grid[!0][!1] *= 3
	r.labels[!0] += "!"
	if a[!1] != 8 or saved_a[!1] != 5
		return 1
	if r.group.numbers[!1] != 18 or saved_r.group.numbers[!1] != 20
		return 2
	if r.group.grid[!0][!1] != 6 or saved_r.group.grid[!0][!1] != 2
		return 3
	if r.labels[!0] != "ab!" or saved_r.labels[!0] != "ab"
		return 4
	print("ok")
	return 0
