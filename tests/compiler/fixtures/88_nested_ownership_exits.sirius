rec Entry(name: string, values: Array[string])

def change(root: Array[Entry], times: i64) -> Array[Entry]
	var result = root
	for i in 0..times
		let untouched = result
		if i == 1
			continue
		result[!0].values[!0] = "updated"
		result[!0].name = result[!0].name
		if untouched[!0].values[!0] == "updated" and i == 0
			return result
		if i == 2
			break
	return result

def main() -> i64
	var outer = {group={items=[Entry("a", ["old", "keep"]), Entry("b", ["other"])]}, marker="start"}
	let initial = outer
	let saved_array = outer.group.items
	let saved_entry = outer.group.items[!0]
	outer.group.items[!0].values[!0] = "first"
	outer.group.items[!0].name = outer.group.items[!0].name
	if initial.group.items[!0].values[!0] != "old" or saved_entry.values[!0] != "old" or saved_array[!0].name != "a"
		return 1
	let changed = change(outer.group.items, 4)
	if changed[!0].values[!0] != "updated" or outer.group.items[!0].values[!0] != "first"
		return 2
	if changed[!1].name != "b" or initial.group.items[!1].name != "b"
		return 3
	if outer.marker != "start" or outer.group.items[!0].name != "a"
		return 4
	print("ok")
	return 0
