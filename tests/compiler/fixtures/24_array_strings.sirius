def count_letters(words: Array[string]) -> i64
	var total = 0
	for word in words
		total += len(word)
	return total

def main() -> i64
	var words = ["red", "blue"]
	let original = words
	words[!0] = "green"
	words = words.append("purple")
	print(words[!0])
	print(original[!0])
	print(len(words))
	print(count_letters(words))
	return 0
