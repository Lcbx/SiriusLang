# Exercise canonical descriptors independently from legacy C-emitter kinds.
def main() -> i64
	let initial = new_type_table()
	let first = intern_array_type(initial, TYPE_TAG_I64)
	let duplicate = intern_array_type(first.table, TYPE_TAG_I64)
	if first.id != duplicate.id or len(first.table.entries) != len(duplicate.table.entries)
		return 1

	let optional = intern_optional_type(duplicate.table, TYPE_TAG_I64)
	let array_of_optional = intern_array_type(optional.table, optional.id)
	let optional_of_array = intern_optional_type(array_of_optional.table, first.id)
	if array_of_optional.id == optional_of_array.id
		return 2

	let dictionary = intern_dict_type(optional_of_array.table, TYPE_TAG_STRING, array_of_optional.id)
	let same_dict = intern_dict_type(dictionary.table, TYPE_TAG_STRING, array_of_optional.id)
	if dictionary.id != same_dict.id
		return 3

	var ab = Array[RecordField]()
	ab = ab.append(RecordField("a", TYPE_TAG_I64))
	ab = ab.append(RecordField("b", dictionary.id))
	var ba = Array[RecordField]()
	ba = ba.append(RecordField("b", dictionary.id))
	ba = ba.append(RecordField("a", TYPE_TAG_I64))
	let record1 = intern_record_type(same_dict.table, ab)
	let record2 = intern_record_type(record1.table, ba)
	if record1.id != record2.id
		return 4
	let fields = record2.table.entries[record2.id?]!.fields
	if fields[0?]!.name != "a" or fields[1?]!.name != "b"
		return 5

	let changed = intern_record_type(record2.table, [RecordField("a", TYPE_TAG_I64)])
	if changed.id == record1.id
		return 6
	if len(changed.table.entries) != len(record2.table.entries) + 1
		return 7
	print("PASS canonical type descriptors")
	return 0
