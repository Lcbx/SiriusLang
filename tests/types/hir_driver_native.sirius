import hir alias Hir
import hir_analyze alias HirAnalyze
import hir_declarations alias HirDeclarations
import hir_resolve alias HirResolve
import parser alias Parser
import types alias Types
# These tests do not depend on the C emitter's legacy type ranges.
def main() -> i64
	var table = Types.new_type_table()
	let left = Types.intern_record_type(table, [Types.RecordField("z", Types.TYPE_TAG_I64), Types.RecordField("name", Types.TYPE_TAG_STRING)])
	table = left.table
	let same = Types.intern_record_type(table, [Types.RecordField("name", Types.TYPE_TAG_STRING), Types.RecordField("z", Types.TYPE_TAG_I64)])
	if left.id != same.id
		return 1
	let field = Hir.resolve_hir_field(same.table, same.id, "name")
	if field.type_id != Types.TYPE_TAG_STRING or field.field_index != 0
		return 2
	if Hir.resolve_hir_field(same.table, same.id, "missing").error == ""
		return 3
	let numeric = Hir.resolve_hir_binary(table, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, "+")
	if numeric.error != "" or numeric.type_id != Types.TYPE_TAG_I64
		return 4
	let comparison = Hir.resolve_hir_binary(table, Types.TYPE_TAG_I64, Types.TYPE_TAG_I64, "<")
	if comparison.error != "" or comparison.type_id != Types.TYPE_TAG_BOOL
		return 5
	if Hir.resolve_hir_binary(table, Types.TYPE_TAG_I64, Types.TYPE_TAG_STRING, "+").error == ""
		return 6
	if Hir.resolve_hir_binary(table, Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING, "*").error == ""
		return 7
	var names = Array[Hir.SymbolInfo]()
	names = names.append(Hir.SymbolInfo("value", 1, Types.TYPE_TAG_I64, true, 0))
	names = names.append(Hir.SymbolInfo("value", 4, Types.TYPE_TAG_STRING, false, 1))
	let symbol = Hir.resolve_hir_name(names, "value")
	if symbol.field_index != 1 or symbol.type_id != Types.TYPE_TAG_STRING
		return 8
	if Hir.resolve_hir_name(names, "missing").error == ""
		return 9
	if not Hir.hir_types_equal(Types.TYPE_TAG_I64, Types.TYPE_TAG_I64) or Hir.hir_types_equal(Types.TYPE_TAG_I64, Types.TYPE_TAG_STRING)
		return 10
	if Hir.resolve_hir_literal(Parser.NODE_STRING) != Types.TYPE_TAG_STRING or Hir.resolve_hir_literal(Parser.NODE_INTEGER) != Types.TYPE_TAG_I64
		return 11
	if Hir.resolve_hir_unary(table, Types.TYPE_TAG_BOOL, "not").type_id != Types.TYPE_TAG_BOOL
		return 12
	if Hir.resolve_hir_unary(table, Types.TYPE_TAG_STRING, "-").error == ""
		return 13
	let typed_array = Types.intern_array_type(table, Types.TYPE_TAG_STRING)
	let str_join = HirResolve.resolve_hir_string_call(typed_array.table, Types.TYPE_TAG_STRING, "join", [typed_array.id])
	if str_join.error != "" or str_join.type_id != Types.TYPE_TAG_STRING
		return 14
	if HirResolve.resolve_hir_string_call(typed_array.table, Types.TYPE_TAG_STRING, "slice", [Types.TYPE_TAG_I64]).error != "string method argument count mismatch"
		return 15
	if HirResolve.resolve_hir_string_call(typed_array.table, Types.TYPE_TAG_STRING, "join", [Types.TYPE_TAG_I64]).error != "expected Array[string], found i64"
		return 16
	let file_read = HirResolve.resolve_hir_builtin_call(typed_array.table, "read_text", [Types.TYPE_TAG_STRING])
	if file_read.error != "" or file_read.table.entries[!file_read.type_id].tag != Types.TYPE_TAG_OPTIONAL
		return 17
	if HirResolve.resolve_hir_builtin_call(typed_array.table, "write_text", [Types.TYPE_TAG_STRING, Types.TYPE_TAG_I64]).error != "expected string, found i64"
		return 18
	if HirResolve.resolve_hir_builtin_call(typed_array.table, "len", [typed_array.id]).type_id != Types.TYPE_TAG_I64
		return 19
	if HirResolve.resolve_hir_builtin_call(typed_array.table, "print", [typed_array.id]).error != "cannot print this type"
		return 20
	let appended = HirResolve.resolve_hir_collection_call(typed_array.table, typed_array.id, "append", [Types.TYPE_TAG_STRING])
	if appended.error != "" or appended.type_id != typed_array.id
		return 21
	if HirResolve.resolve_hir_collection_call(typed_array.table, typed_array.id, "append", [Types.TYPE_TAG_I64]).error != "expected string, found i64"
		return 22
	let dict = Types.intern_dict_type(typed_array.table, Types.TYPE_TAG_STRING, typed_array.id)
	let get = HirResolve.resolve_hir_collection_call(dict.table, dict.id, "get", [Types.TYPE_TAG_STRING])
	if get.error != "" or get.table.entries[!get.type_id].first != typed_array.id
		return 23
	if HirResolve.resolve_hir_collection_call(dict.table, dict.id, "insert", [Types.TYPE_TAG_I64, typed_array.id]).error != "expected string, found i64"
		return 24
	if HirResolve.resolve_hir_function_call(dict.table, "f", [typed_array.id], [typed_array.id], Types.TYPE_TAG_BOOL).type_id != Types.TYPE_TAG_BOOL
		return 25
	if HirResolve.resolve_hir_function_call(dict.table, "f", [Types.TYPE_TAG_BOOL], [typed_array.id], Types.TYPE_TAG_BOOL).error != "expected Array[string], found bool"
		return 26
	if HirResolve.resolve_hir_function_call(dict.table, "f", [Types.TYPE_TAG_I64], [Types.TYPE_TAG_INVALID], Types.TYPE_TAG_INVALID).error != ""
		return 27
	let first = HirResolve.hir_record_put(Array[Types.RecordField](), "z", Types.TYPE_TAG_I64)
	if first.error != "" or first.index != -1 or len(first.fields) != 1
		return 28
	let second = HirResolve.hir_record_put(first.fields, "name", Types.TYPE_TAG_STRING)
	if second.error != "" or len(second.fields) != 2
		return 29
	let override = HirResolve.hir_record_put(second.fields, "z", Types.TYPE_TAG_BOOL)
	if override.index != 0 or override.fields[!0].kind != Types.TYPE_TAG_BOOL
		return 30
	let restored = HirResolve.hir_record_put(override.fields, "z", Types.TYPE_TAG_I64)
	let same_record = HirResolve.resolve_hir_record(table, restored.fields)
	if same_record.error != "" or same_record.type_id != left.id
		return 31
	let deleted = HirResolve.hir_record_delete(restored.fields, "z")
	if deleted.index != 0 or len(deleted.fields) != 1
		return 32
	if HirResolve.hir_record_delete(deleted.fields, "missing").error != "unknown deleted field 'missing'"
		return 33
	let spread = HirResolve.hir_record_spread(same_record.table, deleted.fields, left.id)
	if spread.error != "" or len(spread.fields) != 2
		return 34
	if HirResolve.hir_record_spread(table, deleted.fields, Types.TYPE_TAG_I64).error != "record spread expects a record"
		return 35
	if HirResolve.hir_constructor_publish(first.fields, "z", Types.TYPE_TAG_I64).error != "constructor field overrides are not supported yet"
		return 36
	if HirResolve.hir_constructor_publish(first.fields, "other", Types.TYPE_TAG_STRING).error != ""
		return 37
	if HirResolve.resolve_hir_record(table, Array[Types.RecordField]()).error != "empty records are not supported yet"
		return 38
	let parsed = Parser.parse_module("def id(x: i64) -> i64\n\treturn x\n\nrec Pair(x: i64, y: i64)\n\nlet LIMIT = 7\n")
	if parsed.state.error != ""
		return 39
	let declarations = HirDeclarations.hir_module_declarations(parsed.state, parsed.node)
	if declarations.error != "" or len(declarations.functions) != 2
		return 40
	let first_fn = declarations.functions[!0]
	if first_fn.name != "id" or first_fn.constructor or len(first_fn.parameters) != 1 or first_fn.result_type_node < 0
		return 41
	let second_fn = declarations.functions[!1]
	if second_fn.name != "Pair" or not second_fn.constructor or len(second_fn.parameters) != 2 or second_fn.result_type_node >= 0
		return 42
	let duplicate = Parser.parse_module("def f(x: i64, x: i64) -> i64\n\treturn x\n")
	if duplicate.state.error != "" or HirDeclarations.hir_module_declarations(duplicate.state, duplicate.node).error != "duplicate parameter 'x'"
		return 43
	let colliding = Parser.parse_module("let N = 3\ndef N() -> i64\n\treturn 0\n")
	if colliding.state.error != "" or HirDeclarations.hir_module_declarations(colliding.state, colliding.node).error != "duplicate function 'N'"
		return 44
	let legacy = Parser.parse_module("def Old(x: i64)\n\tpub x\n")
	if legacy.state.error != "" or HirDeclarations.hir_module_declarations(legacy.state, legacy.node).error != "def constructors are no longer supported; use rec"
		return 45
	let body_source = "def calculate(p: i64) -> i64\n\tlet base = p + 1\n\tif true\n\t\tlet base = false\n\t\tprint(base)\n\tvar result = base + 2\n\tresult += p\n\treturn result\n"
	let body_tree = Parser.parse_module(body_source)
	if body_tree.state.error != ""
		return 46
	let body_decls = HirDeclarations.hir_module_declarations(body_tree.state, body_tree.node)
	let body_check = HirAnalyze.hir_analyze_function_body(body_tree.state, body_decls.functions[!0], ["calculate"], Array[string]())
	if body_check.error != "" or len(body_check.nodes) < 10
		return 47
	var found_binary = false
	var found_binding = false
	for operation in body_check.nodes
		if operation.operation == Hir.HIR_BINARY and operation.type_id == Types.TYPE_TAG_I64
			found_binary = true
		if operation.operation == HirAnalyze.HIR_BINDING and operation.type_id == Types.TYPE_TAG_BOOL
			found_binding = true
	if not found_binary or not found_binding
		return 48
	let repeated = Parser.parse_module("def f() -> i64\n\tlet x = 1\n\tlet x = 2\n\treturn x\n")
	let repeated_decl = HirDeclarations.hir_module_declarations(repeated.state, repeated.node)
	if HirAnalyze.hir_analyze_function_body(repeated.state, repeated_decl.functions[!0], ["f"], Array[string]()).error != "duplicate binding 'x'"
		return 49
	let reassigned = Parser.parse_module("def f() -> i64\n\tlet x = 1\n\tx = 2\n\treturn x\n")
	let reassigned_decl = HirDeclarations.hir_module_declarations(reassigned.state, reassigned.node)
	if HirAnalyze.hir_analyze_function_body(reassigned.state, reassigned_decl.functions[!0], ["f"], Array[string]()).error != "cannot assign immutable binding 'x'"
		return 50
	let loop = Parser.parse_module("def f() -> i64\n\tfor i in 0..3\n\t\ti += 1\n\treturn 0\n")
	let loop_decl = HirDeclarations.hir_module_declarations(loop.state, loop.node)
	if HirAnalyze.hir_analyze_function_body(loop.state, loop_decl.functions[!0], ["f"], Array[string]()).error != "cannot assign immutable binding 'i'"
		return 51
	let wrong_type = Parser.parse_module("def f() -> i64\n\tlet x: bool = 3\n\treturn 0\n")
	let wrong_decl = HirDeclarations.hir_module_declarations(wrong_type.state, wrong_type.node)
	if HirAnalyze.hir_analyze_function_body(wrong_type.state, wrong_decl.functions[!0], ["f"], Array[string]()).error != "expected bool, found i64"
		return 52
	let missing = Parser.parse_module("def f() -> i64\n\treturn missing\n")
	let missing_decl = HirDeclarations.hir_module_declarations(missing.state, missing.node)
	if HirAnalyze.hir_analyze_function_body(missing.state, missing_decl.functions[!0], ["f"], Array[string]()).error != "unknown name 'missing'"
		return 53
	let deferred = Parser.parse_module("def f() -> i64\n\tlet values = [1, 2]\n\treturn len(values)\n")
	let deferred_decl = HirDeclarations.hir_module_declarations(deferred.state, deferred.node)
	if HirAnalyze.hir_analyze_function_body(deferred.state, deferred_decl.functions[!0], ["f"], Array[string]()).error != ""
		return 54
	# Pre-emission canonical types propagate through records, collection methods,
	# optional accesses and fallbacks without asking the C emitter.
	let typed_source = "def f() -> i64\n\tlet base = {x = 1, tag = \"a\"}\n\tlet edited = {base.*, del tag, y = 2}\n\tlet values = [7, 8]\n\tlet grown = values.append(9)\n\tlet maybe = grown[?1]\n\tlet chosen = maybe or 0\n\tlet first = grown[!0]\n\treturn edited.y + first + chosen\n"
	let typed_tree = Parser.parse_module(typed_source)
	if typed_tree.state.error != ""
		return 55
	let typed_decl = HirDeclarations.hir_module_declarations(typed_tree.state, typed_tree.node)
	let typed_body = HirAnalyze.hir_analyze_function_body(typed_tree.state, typed_decl.functions[!0], ["f"], Array[string]())
	if typed_body.error != ""
		return 56
	var records_found = 0
	var arrays_found = 0
	var indices_found = 0
	var calls_found = 0
	var fields_found = 0
	for node in typed_body.nodes
		if node.operation == HirResolve.HIR_RECORD
			records_found += 1
		if node.operation == HirAnalyze.HIR_ARRAY
			arrays_found += 1
		if node.operation == HirAnalyze.HIR_INDEX
			indices_found += 1
		if node.operation == HirResolve.HIR_CALL
			calls_found += 1
		if node.operation == Hir.HIR_FIELD
			fields_found += 1
	if records_found != 2 or arrays_found != 1 or indices_found != 2 or calls_found != 1 or fields_found != 1
		return 57
	let nested_source = "def f() -> i64\n\tlet records = [{x = 1}, {x = 2}]\n\tlet possible = records[?1]\n\tlet value = possible!\n\treturn value.x\n"
	let nested_tree = Parser.parse_module(nested_source)
	let nested_decl = HirDeclarations.hir_module_declarations(nested_tree.state, nested_tree.node)
	let nested_body = HirAnalyze.hir_analyze_function_body(nested_tree.state, nested_decl.functions[!0], ["f"], Array[string]())
	if nested_body.error != ""
		return 58
	var unwrapped_record = false
	for node in nested_body.nodes
		if node.operation == HirAnalyze.HIR_UNWRAP
			unwrapped_record = true
	if not unwrapped_record
		return 59
	let dict_source = "def f() -> i64\n\tlet values = Dict[string, i64]()\n\tlet updated = values.insert(\"a\", 2)\n\tlet found = updated.get(\"a\")\n\treturn found or 0\n"
	let dict_tree = Parser.parse_module(dict_source)
	let dict_decl = HirDeclarations.hir_module_declarations(dict_tree.state, dict_tree.node)
	let dict_body = HirAnalyze.hir_analyze_function_body(dict_tree.state, dict_decl.functions[!0], ["f"], Array[string]())
	if dict_body.error != ""
		return 60
	let bad_field = Parser.parse_module("def f() -> i64\n\tlet point = {x = 1}\n\treturn point.y\n")
	let bad_field_decl = HirDeclarations.hir_module_declarations(bad_field.state, bad_field.node)
	if HirAnalyze.hir_analyze_function_body(bad_field.state, bad_field_decl.functions[!0], ["f"], Array[string]()).error != "unknown record field 'y'"
		return 61
	let mixed_array = Parser.parse_module("def f() -> i64\n\tlet values = [1, \"oops\"]\n\treturn 0\n")
	let mixed_array_decl = HirDeclarations.hir_module_declarations(mixed_array.state, mixed_array.node)
	if HirAnalyze.hir_analyze_function_body(mixed_array.state, mixed_array_decl.functions[!0], ["f"], Array[string]()).error != "expected i64, found string"
		return 62
	let bad_index = Parser.parse_module("def f() -> i64\n\tlet values = [1]\n\treturn values[!\"wrong\"]\n")
	let bad_index_decl = HirDeclarations.hir_module_declarations(bad_index.state, bad_index.node)
	if HirAnalyze.hir_analyze_function_body(bad_index.state, bad_index_decl.functions[!0], ["f"], Array[string]()).error != "expected i64, found string"
		return 63
	let early_return = Parser.parse_module("def f() -> i64\n\tlet values = [1]\n\tlet first = values[?0] else return -1\n\treturn first\n")
	let early_decl = HirDeclarations.hir_module_declarations(early_return.state, early_return.node)
	if HirAnalyze.hir_analyze_function_body(early_return.state, early_decl.functions[!0], ["f"], Array[string]()).error != ""
		return 64
	let annotated_array = Parser.parse_module("def f(items: Array[i64]) -> i64\n\tlet more: Array[i64] = items.append(2)\n\treturn more[!0]\n")
	let annotated_decl = HirDeclarations.hir_module_declarations(annotated_array.state, annotated_array.node)
	let annotated_body = HirAnalyze.hir_analyze_function_body(annotated_array.state, annotated_decl.functions[!0], ["f"], Array[string]())
	if annotated_body.error != ""
		return 65
	let wrong_annotation = Parser.parse_module("def f() -> i64\n\tlet values: Array[string] = [1]\n\treturn 0\n")
	let wrong_annotation_decl = HirDeclarations.hir_module_declarations(wrong_annotation.state, wrong_annotation.node)
	if HirAnalyze.hir_analyze_function_body(wrong_annotation.state, wrong_annotation_decl.functions[!0], ["f"], Array[string]()).error != "expected Array[string], found Array[i64]"
		return 66
	# Concrete generic and constructor calls resolve before C emission, even
	# across forward declarations and nested generic calls.
	let calls_source = "rec Point(x: i64, y: i64)\n\tpub sum = x + y\ndef field(point)\n\treturn point.y\ndef relay(p)\n\treturn field(p)\ndef make(x: i64)\n\treturn Point(x, x + 1)\ndef main() -> i64\n\tlet point = make(3)\n\treturn relay(point)\n"
	let calls_tree = Parser.parse_module(calls_source)
	if calls_tree.state.error != ""
		return 67
	let calls_decls = HirDeclarations.hir_module_declarations(calls_tree.state, calls_tree.node)
	if calls_decls.error != ""
		return 68
	let calls_body = HirAnalyze.hir_analyze_module_body(calls_tree.state, calls_decls.functions[!4], calls_decls.functions, Array[string]())
	if calls_body.error != ""
		return 69
	var found_constructor_result = false
	var found_generic_result = false
	var found_resolved_function = false
	for call in calls_body.nodes
		if call.operation == HirResolve.HIR_CALL and call.type_id == Types.TYPE_TAG_I64
			found_generic_result = true
		if call.operation == HirResolve.HIR_CALL and call.type_id > Types.TYPE_TAG_VOID
			found_constructor_result = true
		if call.operation == HirResolve.HIR_CALL and call.field_index >= 0
			found_resolved_function = true
	if not found_constructor_result or not found_generic_result or not found_resolved_function
		return 70
	let wrong_call = Parser.parse_module("def fixed(v: i64) -> i64\n\treturn v\ndef main() -> i64\n\treturn fixed(\"bad\")\n")
	let wrong_call_decl = HirDeclarations.hir_module_declarations(wrong_call.state, wrong_call.node)
	if HirAnalyze.hir_analyze_module_body(wrong_call.state, wrong_call_decl.functions[!1], wrong_call_decl.functions, Array[string]()).error != "expected i64, found string"
		return 71
	let wrong_arity = Parser.parse_module("def fixed(v: i64) -> i64\n\treturn v\ndef main() -> i64\n\treturn fixed(1, 2)\n")
	let arity_decl = HirDeclarations.hir_module_declarations(wrong_arity.state, wrong_arity.node)
	if HirAnalyze.hir_analyze_module_body(wrong_arity.state, arity_decl.functions[!1], arity_decl.functions, Array[string]()).error != "argument count mismatch for 'fixed'"
		return 72
	print("PASS typed HIR resolution")
	return 0
