# These tests do not depend on the C emitter's legacy type ranges.
def main() -> i64
	var table = new_type_table()
	let left = intern_record_type(table, [RecordField("z", TYPE_TAG_I64), RecordField("name", TYPE_TAG_STRING)])
	table = left.table
	let same = intern_record_type(table, [RecordField("name", TYPE_TAG_STRING), RecordField("z", TYPE_TAG_I64)])
	if left.id != same.id
		return 1
	let field = resolve_hir_field(same.table, same.id, "name")
	if field.type_id != TYPE_TAG_STRING or field.field_index != 0
		return 2
	if resolve_hir_field(same.table, same.id, "missing").error == ""
		return 3
	let numeric = resolve_hir_binary(table, TYPE_TAG_I64, TYPE_TAG_I64, "+")
	if numeric.error != "" or numeric.type_id != TYPE_TAG_I64
		return 4
	let comparison = resolve_hir_binary(table, TYPE_TAG_I64, TYPE_TAG_I64, "<")
	if comparison.error != "" or comparison.type_id != TYPE_TAG_BOOL
		return 5
	if resolve_hir_binary(table, TYPE_TAG_I64, TYPE_TAG_STRING, "+").error == ""
		return 6
	if resolve_hir_binary(table, TYPE_TAG_STRING, TYPE_TAG_STRING, "*").error == ""
		return 7
	var names = Array[SymbolInfo]()
	names = names.append(SymbolInfo("value", 1, TYPE_TAG_I64, true, 0))
	names = names.append(SymbolInfo("value", 4, TYPE_TAG_STRING, false, 1))
	let symbol = resolve_hir_name(names, "value")
	if symbol.field_index != 1 or symbol.type_id != TYPE_TAG_STRING
		return 8
	if resolve_hir_name(names, "missing").error == ""
		return 9
	if not hir_types_equal(TYPE_TAG_I64, TYPE_TAG_I64) or hir_types_equal(TYPE_TAG_I64, TYPE_TAG_STRING)
		return 10
	if resolve_hir_literal(NODE_STRING) != TYPE_TAG_STRING or resolve_hir_literal(NODE_INTEGER) != TYPE_TAG_I64
		return 11
	if resolve_hir_unary(table, TYPE_TAG_BOOL, "not").type_id != TYPE_TAG_BOOL
		return 12
	if resolve_hir_unary(table, TYPE_TAG_STRING, "-").error == ""
		return 13
	let typed_array = intern_array_type(table, TYPE_TAG_STRING)
	let str_join = resolve_hir_string_call(typed_array.table, TYPE_TAG_STRING, "join", [typed_array.id])
	if str_join.error != "" or str_join.type_id != TYPE_TAG_STRING
		return 14
	if resolve_hir_string_call(typed_array.table, TYPE_TAG_STRING, "slice", [TYPE_TAG_I64]).error != "string method argument count mismatch"
		return 15
	if resolve_hir_string_call(typed_array.table, TYPE_TAG_STRING, "join", [TYPE_TAG_I64]).error != "expected Array[string], found i64"
		return 16
	let file_read = resolve_hir_builtin_call(typed_array.table, "read_text", [TYPE_TAG_STRING])
	if file_read.error != "" or file_read.table.entries[!file_read.type_id].tag != TYPE_TAG_OPTIONAL
		return 17
	if resolve_hir_builtin_call(typed_array.table, "write_text", [TYPE_TAG_STRING, TYPE_TAG_I64]).error != "expected string, found i64"
		return 18
	if resolve_hir_builtin_call(typed_array.table, "len", [typed_array.id]).type_id != TYPE_TAG_I64
		return 19
	if resolve_hir_builtin_call(typed_array.table, "print", [typed_array.id]).error != "cannot print this type"
		return 20
	let appended = resolve_hir_collection_call(typed_array.table, typed_array.id, "append", [TYPE_TAG_STRING])
	if appended.error != "" or appended.type_id != typed_array.id
		return 21
	if resolve_hir_collection_call(typed_array.table, typed_array.id, "append", [TYPE_TAG_I64]).error != "expected string, found i64"
		return 22
	let dict = intern_dict_type(typed_array.table, TYPE_TAG_STRING, typed_array.id)
	let get = resolve_hir_collection_call(dict.table, dict.id, "get", [TYPE_TAG_STRING])
	if get.error != "" or get.table.entries[!get.type_id].first != typed_array.id
		return 23
	if resolve_hir_collection_call(dict.table, dict.id, "insert", [TYPE_TAG_I64, typed_array.id]).error != "expected string, found i64"
		return 24
	if resolve_hir_function_call(dict.table, "f", [typed_array.id], [typed_array.id], TYPE_TAG_BOOL).type_id != TYPE_TAG_BOOL
		return 25
	if resolve_hir_function_call(dict.table, "f", [TYPE_TAG_BOOL], [typed_array.id], TYPE_TAG_BOOL).error != "expected Array[string], found bool"
		return 26
	if resolve_hir_function_call(dict.table, "f", [TYPE_TAG_I64], [TYPE_TAG_INVALID], TYPE_TAG_INVALID).error != ""
		return 27
	let first = hir_record_put(Array[RecordField](), "z", TYPE_TAG_I64)
	if first.error != "" or first.index != -1 or len(first.fields) != 1
		return 28
	let second = hir_record_put(first.fields, "name", TYPE_TAG_STRING)
	if second.error != "" or len(second.fields) != 2
		return 29
	let override = hir_record_put(second.fields, "z", TYPE_TAG_BOOL)
	if override.index != 0 or override.fields[!0].kind != TYPE_TAG_BOOL
		return 30
	let restored = hir_record_put(override.fields, "z", TYPE_TAG_I64)
	let same_record = resolve_hir_record(table, restored.fields)
	if same_record.error != "" or same_record.type_id != left.id
		return 31
	let deleted = hir_record_delete(restored.fields, "z")
	if deleted.index != 0 or len(deleted.fields) != 1
		return 32
	if hir_record_delete(deleted.fields, "missing").error != "unknown deleted field 'missing'"
		return 33
	let spread = hir_record_spread(same_record.table, deleted.fields, left.id)
	if spread.error != "" or len(spread.fields) != 2
		return 34
	if hir_record_spread(table, deleted.fields, TYPE_TAG_I64).error != "record spread expects a record"
		return 35
	if hir_constructor_publish(first.fields, "z", TYPE_TAG_I64).error != "constructor field overrides are not supported yet"
		return 36
	if hir_constructor_publish(first.fields, "other", TYPE_TAG_STRING).error != ""
		return 37
	if resolve_hir_record(table, Array[RecordField]()).error != "empty records are not supported yet"
		return 38
	let parsed = parse_module("def id(x: i64) -> i64\n\treturn x\n\nrec Pair(x: i64, y: i64)\n\nlet LIMIT = 7\n")
	if parsed.state.error != ""
		return 39
	let declarations = hir_module_declarations(parsed.state, parsed.node)
	if declarations.error != "" or len(declarations.functions) != 2
		return 40
	let first_fn = declarations.functions[!0]
	if first_fn.name != "id" or first_fn.constructor or len(first_fn.parameters) != 1 or first_fn.result_type_node < 0
		return 41
	let second_fn = declarations.functions[!1]
	if second_fn.name != "Pair" or not second_fn.constructor or len(second_fn.parameters) != 2 or second_fn.result_type_node >= 0
		return 42
	let duplicate = parse_module("def f(x: i64, x: i64) -> i64\n\treturn x\n")
	if duplicate.state.error != "" or hir_module_declarations(duplicate.state, duplicate.node).error != "duplicate parameter 'x'"
		return 43
	let colliding = parse_module("let N = 3\ndef N() -> i64\n\treturn 0\n")
	if colliding.state.error != "" or hir_module_declarations(colliding.state, colliding.node).error != "duplicate function 'N'"
		return 44
	let legacy = parse_module("def Old(x: i64)\n\tpub x\n")
	if legacy.state.error != "" or hir_module_declarations(legacy.state, legacy.node).error != "def constructors are no longer supported; use rec"
		return 45
	let body_source = "def calculate(p: i64) -> i64\n\tlet base = p + 1\n\tif true\n\t\tlet base = false\n\t\tprint(base)\n\tvar result = base + 2\n\tresult += p\n\treturn result\n"
	let body_tree = parse_module(body_source)
	if body_tree.state.error != ""
		return 46
	let body_decls = hir_module_declarations(body_tree.state, body_tree.node)
	let body_check = hir_analyze_function_body(body_tree.state, body_decls.functions[!0], ["calculate"], Array[string]())
	if body_check.error != "" or len(body_check.nodes) < 10
		return 47
	var found_binary = false
	var found_binding = false
	for operation in body_check.nodes
		if operation.operation == HIR_BINARY and operation.type_id == TYPE_TAG_I64
			found_binary = true
		if operation.operation == HIR_BINDING and operation.type_id == TYPE_TAG_BOOL
			found_binding = true
	if not found_binary or not found_binding
		return 48
	let repeated = parse_module("def f() -> i64\n\tlet x = 1\n\tlet x = 2\n\treturn x\n")
	let repeated_decl = hir_module_declarations(repeated.state, repeated.node)
	if hir_analyze_function_body(repeated.state, repeated_decl.functions[!0], ["f"], Array[string]()).error != "duplicate binding 'x'"
		return 49
	let reassigned = parse_module("def f() -> i64\n\tlet x = 1\n\tx = 2\n\treturn x\n")
	let reassigned_decl = hir_module_declarations(reassigned.state, reassigned.node)
	if hir_analyze_function_body(reassigned.state, reassigned_decl.functions[!0], ["f"], Array[string]()).error != "cannot assign immutable binding 'x'"
		return 50
	let loop = parse_module("def f() -> i64\n\tfor i in 0..3\n\t\ti += 1\n\treturn 0\n")
	let loop_decl = hir_module_declarations(loop.state, loop.node)
	if hir_analyze_function_body(loop.state, loop_decl.functions[!0], ["f"], Array[string]()).error != "cannot assign immutable binding 'i'"
		return 51
	let wrong_type = parse_module("def f() -> i64\n\tlet x: bool = 3\n\treturn 0\n")
	let wrong_decl = hir_module_declarations(wrong_type.state, wrong_type.node)
	if hir_analyze_function_body(wrong_type.state, wrong_decl.functions[!0], ["f"], Array[string]()).error != "expected bool, found i64"
		return 52
	let missing = parse_module("def f() -> i64\n\treturn missing\n")
	let missing_decl = hir_module_declarations(missing.state, missing.node)
	if hir_analyze_function_body(missing.state, missing_decl.functions[!0], ["f"], Array[string]()).error != "unknown name 'missing'"
		return 53
	let deferred = parse_module("def f() -> i64\n\tlet values = [1, 2]\n\treturn len(values)\n")
	let deferred_decl = hir_module_declarations(deferred.state, deferred.node)
	if hir_analyze_function_body(deferred.state, deferred_decl.functions[!0], ["f"], Array[string]()).error != ""
		return 54
	print("PASS typed HIR resolution")
	return 0
