import hir alias Hir
import hir_declarations alias HirDeclarations
import hir_specialize alias HirSpecialize
import parser alias Parser
import types alias Types
# HIR worklist is usable without linking MIR or the C emitter.
def main() -> i64
	let source = "def size(values) -> i64\n\treturn len(values)\ndef main() -> i64\n\tlet a = [1, 2]\n\treturn size(a) + size([3, 4])\n"
	let parsed = Parser.parse_module(source)
	if parsed.state.error != ""
		print(parsed.state.error)
		return 1
	let declarations = HirDeclarations.hir_module_declarations(parsed.state, parsed.node)
	let result = HirSpecialize.hir_specialize_program(parsed.state, declarations, "main", Array[i64]())
	if result.error != ""
		print(result.error)
		return 2
	if len(result.bodies) != 2 or len(result.registry.entries) != 2
		return 3
	if len(result.bodies[!0].calls) != 2
		return 4
	if result.bodies[!0].calls[!0].specialization != 1 or result.bodies[!0].calls[!1].specialization != 1
		return 5
	let array_id = result.registry.entries[!1].arguments[!0]
	if array_id < 0 or array_id >= len(result.types.entries)
		return 6
	if result.types.entries[!array_id].tag != Types.TYPE_TAG_ARRAY or result.types.entries[!array_id].first != Types.TYPE_TAG_I64
		return 6
	for i in 0..len(result.bodies)
		if result.registry.entries[!i].status != Hir.HIR_SPEC_COMPLETE
			return 7
	# Distinct signatures occupy distinct slots; repeated calls share a slot.
	let multi = Parser.parse_module("def discard(x) -> i64\n\treturn 1\ndef main() -> i64\n\treturn discard(0) + discard(true) + discard(0)\n")
	let multi_declarations = HirDeclarations.hir_module_declarations(multi.state, multi.node)
	let specialized = HirSpecialize.hir_specialize_program(multi.state, multi_declarations, "main", Array[i64]())
	if specialized.error != "" or len(specialized.bodies) != 3 or len(specialized.registry.entries) != 3
		return 9
	if len(specialized.bodies[!0].calls) != 3
		return 10
	if specialized.bodies[!0].calls[!0].specialization != 1 or specialized.bodies[!0].calls[!1].specialization != 2 or specialized.bodies[!0].calls[!2].specialization != 1
		return 11
	for i in 0..len(specialized.bodies)
		if specialized.registry.entries[!i].status != Hir.HIR_SPEC_COMPLETE
			return 12
	let bad = Parser.parse_module("def f(value: bool) -> i64\n\treturn 0\ndef main() -> i64\n\treturn f(12)\n")
	let bad_declarations = HirDeclarations.hir_module_declarations(bad.state, bad.node)
	let invalid = HirSpecialize.hir_specialize_program(bad.state, bad_declarations, "main", Array[i64]())
	if invalid.error != "expected bool, found i64"
		return 8
	print("PASS HIR worklist without backend")
	return 0
