import types alias Types

# Exercise canonical descriptors independently from legacy C-emitter kinds.
def main() -> i64
	let initial = Types.new_type_table()
	let first = Types.intern_array_type(initial, Types.TYPE_TAG_I64)
	let duplicate = Types.intern_array_type(first.table, Types.TYPE_TAG_I64)
	if first.id != duplicate.id or len(first.table.entries) != len(duplicate.table.entries)
		return 1

	let optional = Types.intern_optional_type(duplicate.table, Types.TYPE_TAG_I64)
	let array_of_optional = Types.intern_array_type(optional.table, optional.id)
	let optional_of_array = Types.intern_optional_type(array_of_optional.table, first.id)
	if array_of_optional.id == optional_of_array.id
		return 2

	let dictionary = Types.intern_dict_type(optional_of_array.table, Types.TYPE_TAG_STRING, array_of_optional.id)
	let same_dict = Types.intern_dict_type(dictionary.table, Types.TYPE_TAG_STRING, array_of_optional.id)
	if dictionary.id != same_dict.id
		return 3

	var ab = Array[Types.RecordField]()
	ab = ab.append(Types.RecordField("a", Types.TYPE_TAG_I64))
	ab = ab.append(Types.RecordField("b", dictionary.id))
	var ba = Array[Types.RecordField]()
	ba = ba.append(Types.RecordField("b", dictionary.id))
	ba = ba.append(Types.RecordField("a", Types.TYPE_TAG_I64))
	let record1 = Types.intern_record_type(same_dict.table, ab)
	let record2 = Types.intern_record_type(record1.table, ba)
	if record1.id != record2.id
		return 4
	let fields = record2.table.entries[!record2.id].fields
	if fields[!0].name != "a" or fields[!1].name != "b"
		return 5

	let changed = Types.intern_record_type(record2.table, [Types.RecordField("a", Types.TYPE_TAG_I64)])
	if changed.id == record1.id
		return 6
	if len(changed.table.entries) != len(record2.table.entries) + 1
		return 7
	# Distinct descriptors must not collide through field-name delimiters.
	let unusual = Types.intern_record_type(changed.table, [Types.RecordField("a:1;b", Types.TYPE_TAG_I64)])
	let other = Types.intern_record_type(unusual.table, [Types.RecordField("a", Types.TYPE_TAG_I64), Types.RecordField("b", Types.TYPE_TAG_I64)])
	if unusual.id == other.id
		return 8
	print("PASS canonical type descriptors")
	return 0
