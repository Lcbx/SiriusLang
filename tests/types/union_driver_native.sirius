import types alias Types
import hir_resolve alias Match
import mir alias Mir
import mir_verify alias Verify
import module alias Module
import module_interface alias Interface

def main() -> i64
	let base = Types.new_type_table()
	let success = Types.intern_record_type(base, [Types.RecordField("value", Types.TYPE_TAG_I64)])
	let failure = Types.intern_record_type(success.table, [Types.RecordField("code", Types.TYPE_TAG_I64)])
	let retry = Types.intern_record_type(failure.table, [Types.RecordField("retry", Types.TYPE_TAG_BOOL)])
	let variants = [retry.id, success.id, failure.id]
	let union = Types.intern_union_type(retry.table, variants)
	if union.id == Types.TYPE_TAG_INVALID or not Types.type_descriptor_canonical(union.table, union.id)
		return 1
	let reversed = Types.intern_union_type(union.table, [failure.id, retry.id, success.id])
	if reversed.id != union.id or len(reversed.table.entries) != len(union.table.entries)
		return 2
	if Types.union_alternative_index(union.table, union.id, retry.id) < 0
		return 3
	if Types.union_alternative_index(union.table, union.id, Types.TYPE_TAG_I64) != -1
		return 4
	# HIR plans the entire nested conversion before any MIR instructions exist.
	let source_record = Types.intern_record_type(union.table, [Types.RecordField("fixed", Types.TYPE_TAG_I64), Types.RecordField("value", success.id)])
	let target_record = Types.intern_record_type(source_record.table, [Types.RecordField("fixed", Types.TYPE_TAG_I64), Types.RecordField("value", union.id)])
	let source_optional = Types.intern_optional_type(target_record.table, source_record.id)
	let target_optional = Types.intern_optional_type(source_optional.table, target_record.id)
	let source_dict = Types.intern_dict_type(target_optional.table, Types.TYPE_TAG_STRING, source_optional.id)
	let target_dict = Types.intern_dict_type(source_dict.table, Types.TYPE_TAG_STRING, target_optional.id)
	let source_array = Types.intern_array_type(target_dict.table, source_dict.id)
	let target_array = Types.intern_array_type(source_array.table, target_dict.id)
	let plan = Match.hir_plan_conversion(target_array.table, source_array.id, target_array.id)
	if plan.error != "" or len(plan.steps) != 6
		return 50
	var step = plan.steps[!plan.root]
	for operation in [Types.TYPE_TAG_ARRAY, Types.TYPE_TAG_DICT, Types.TYPE_TAG_OPTIONAL]
		if step.operation != operation or len(step.children) != 1
			return 51
		step = plan.steps[!step.children[!0]]
	if step.operation != Types.TYPE_TAG_RECORD or len(step.children) != 2
		return 52
	let unchanged = plan.steps[!step.children[!0]]
	let injected = plan.steps[!step.children[!1]]
	if unchanged.operation != Match.HIR_CONVERSION_IDENTITY or injected.operation != Types.TYPE_TAG_UNION
		return 53
	if injected.source_type != success.id or injected.target_type != union.id or injected.alternative != Types.union_alternative_index(target_array.table, union.id, success.id)
		return 54
	let invalid_plan = Match.hir_plan_conversion(target_array.table, target_array.id, source_array.id)
	if invalid_plan.error == "" or invalid_plan.root != -1 or len(invalid_plan.steps) != 0
		return 55
	let ambiguous = Types.intern_labeled_union_type(target_array.table, [Types.RecordField("First", success.id), Types.RecordField("Second", success.id)])
	if Match.hir_plan_conversion(ambiguous.table, success.id, ambiguous.id).error == ""
		return 56
	let wrong_key = Types.intern_dict_type(target_array.table, Types.TYPE_TAG_I64, target_optional.id)
	if Match.hir_plan_conversion(wrong_key.table, source_dict.id, wrong_key.id).error == ""
		return 57
	if Types.intern_union_type(union.table, [success.id, success.id]).id != Types.TYPE_TAG_INVALID
		return 5
	let same_shape = Types.intern_record_type(union.table, [Types.RecordField("value", Types.TYPE_TAG_I64)])
	if Types.intern_union_type(same_shape.table, [success.id, same_shape.id]).id != Types.TYPE_TAG_INVALID
		return 6
	if Types.intern_union_type(union.table, [success.id, Types.TYPE_TAG_I64]).id != Types.TYPE_TAG_INVALID
		return 7
	var complete = false
	match Match.check_exhaustive_match(union.table, union.id, variants)
		Match.HirMatchComplete()
			complete = true
		Match.HirMatchInvalid(message)
			return 8
		Match.HirMatchRepeated(alternative)
			return 8
		Match.HirMatchMissing(alternative)
			return 8
	if not complete
		return 8
	match Match.check_exhaustive_match(union.table, union.id, [success.id, failure.id])
		Match.HirMatchMissing(alternative)
			if alternative != retry.id
				return 9
		Match.HirMatchComplete()
			return 9
		Match.HirMatchInvalid(message)
			return 9
		Match.HirMatchRepeated(alternative)
			return 9
	match Match.check_exhaustive_match(union.table, union.id, [success.id, failure.id, success.id])
		Match.HirMatchRepeated(alternative)
			if alternative != success.id
				return 10
		Match.HirMatchComplete()
			return 10
		Match.HirMatchInvalid(message)
			return 10
		Match.HirMatchMissing(alternative)
			return 10
	match Match.check_exhaustive_match(union.table, union.id, [success.id, failure.id, Types.TYPE_TAG_I64])
		Match.HirMatchInvalid(message)
			if message != "match arm is not a union alternative"
				return 11
		Match.HirMatchComplete()
			return 11
		Match.HirMatchRepeated(alternative)
			return 11
		Match.HirMatchMissing(alternative)
			return 11
	match Match.check_exhaustive_match(union.table, success.id, [success.id])
		Match.HirMatchInvalid(message)
			if message != "match requires a tagged union"
				return 12
		Match.HirMatchComplete()
			return 12
		Match.HirMatchRepeated(alternative)
			return 12
		Match.HirMatchMissing(alternative)
			return 12
	# The HIR source checker receives label indices, not record TypeIds.
	let index_success = Types.union_alternative_index(union.table, union.id, success.id)
	let index_failure = Types.union_alternative_index(union.table, union.id, failure.id)
	match Match.check_exhaustive_match_indices(union.table, union.id, [index_success, index_failure])
		Match.HirMatchMissing(alternative)
			if alternative != retry.id
				return 22
		Match.HirMatchComplete()
			return 22
		Match.HirMatchInvalid(message)
			return 22
		Match.HirMatchRepeated(alternative)
			return 22
	match Match.check_exhaustive_match_indices(union.table, union.id, [index_success, index_success])
		Match.HirMatchRepeated(alternative)
			if alternative != success.id
				return 23
		Match.HirMatchComplete()
			return 23
		Match.HirMatchInvalid(message)
			return 23
		Match.HirMatchMissing(alternative)
			return 23
	match Match.check_exhaustive_match_indices(union.table, union.id, [-1])
		Match.HirMatchInvalid(message)
			if message != "match arm is not a union alternative"
				return 24
		Match.HirMatchComplete()
			return 24
		Match.HirMatchRepeated(alternative)
			return 24
		Match.HirMatchMissing(alternative)
			return 24
	let malformed = Types.intern_type(union.table, Types.TYPE_TAG_UNION, 0, 0, [Types.RecordField("", success.id), Types.RecordField("", failure.id)])
	if malformed.id != Types.TYPE_TAG_INVALID
		return 13
	let import_base = Types.new_type_table()
	let flipped_failure = Types.intern_record_type(import_base, [Types.RecordField("code", Types.TYPE_TAG_I64)])
	let flipped_retry = Types.intern_record_type(flipped_failure.table, [Types.RecordField("retry", Types.TYPE_TAG_BOOL)])
	let flipped_success = Types.intern_record_type(flipped_retry.table, [Types.RecordField("value", Types.TYPE_TAG_I64)])
	let flipped_union = Types.intern_union_type(flipped_success.table, [flipped_success.id, flipped_retry.id, flipped_failure.id])
	let signature = Module.mir_type_signature(union.table, union.id)
	if signature == "invalid" or signature != Module.mir_type_signature(flipped_union.table, flipped_union.id)
		return 14
	# ABI tags must be independent of the order in which member records
	# were interned in separate modules.
	if Types.union_alternative_index(union.table, union.id, success.id) != Types.union_alternative_index(flipped_union.table, flipped_union.id, flipped_success.id)
		return 17
	if Types.union_alternative_index(union.table, union.id, failure.id) != Types.union_alternative_index(flipped_union.table, flipped_union.id, flipped_failure.id)
		return 18
	if Types.union_alternative_index(union.table, union.id, retry.id) != Types.union_alternative_index(flipped_union.table, flipped_union.id, flipped_retry.id)
		return 19
	let imported = Interface.module_import_type(union.table, flipped_union.table, flipped_union.id)
	if imported.id != union.id
		return 15
	if Types.runtime_storage(union.table, union.id) != Types.TYPE_STORAGE_OBJECT
		return 16
	# Executable unions require explicit construction and extraction opcodes.
	if not Verify.mir_type_supported(union.table, union.id)
		return 20
	if Verify.mir_verify(Mir.mir_program_with_types(Array[Mir.MirFunction](), union.table)) != ""
		return 21
	print("PASS structural union types and exhaustive match checking")
	return 0
