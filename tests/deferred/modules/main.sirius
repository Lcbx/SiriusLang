# DEFERRED: import resolves a namespace at compile time, not a runtime object.
import Math.Generic alias Generic

def main() -> i64
	let a = Generic.triple(6)
	let b = Generic.triple("go")
	var point = {x = a, y = 2}
	let original = Generic.copy(point)
	let wrapped = Generic.wrap(12)
	let selected = Generic.select(wrapped)
	let pair = Generic.duplicate("go")
	let count = Generic.count_pair(true)
	point.x = 99
	if original.x != 18 or point.x != 99 or b != "gogogo" or wrapped.item != 12 or selected != 12 or len(pair) != 2 or count != 2
		return 1
	return 0
