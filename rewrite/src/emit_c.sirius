					else
						lines = lines.append("store_array(&" + array_slot(dst) + ", " + read + ");\n")
				else
					lines = lines.append(slot(dst) + " = (uint64_t)s_array_i64_get_checked(" + array_slot(input) + ", array_index(" + array_slot(input) + ", signed_value(" + slot(index) + ")));\n")
			IR.ArrayAppend(dst, input, item)
				let element = IR.array_element(table, function.types[!input])
				if managed_array(table, function.types[!input])
					if element == IR.TYPE_BOOL
						lines = lines.append("{ bool array_item = " + slot(item) + " != 0; store_managed_array(&" + managed_array_slot(dst) + ", s_array_append(s_array_retain(" + managed_array_slot(input) + "), &array_item)); }\n")
					else
						lines = lines.append("store_managed_array(&" + managed_array_slot(dst) + ", s_array_append(s_array_retain(" + managed_array_slot(input) + "), &" + value_slot(item, element, table) + "));\n")
				else
					lines = lines.append("store_array(&" + array_slot(dst) + ", s_array_i64_append_take(s_array_i64_retain(" + array_slot(input) + "), signed_value(" + slot(item) + ")));\n")
			IR.ArraySet(input, index, item)
				let element = IR.array_element(table, function.types[!input])
				if managed_array(table, function.types[!input])
					if element == IR.TYPE_BOOL
						lines = lines.append("{ bool array_item = " + slot(item) + " != 0; s_array_set(&" + managed_array_slot(input) + ", managed_array_index(" + managed_array_slot(input) + ", signed_value(" + slot(index) + ")), &array_item); }\n")
					else
						lines = lines.append("s_array_set(&" + managed_array_slot(input) + ", managed_array_index(" + managed_array_slot(input) + ", signed_value(" + slot(index) + ")), &" + value_slot(item, element, table) + ");\n")
				else
					lines = lines.append("s_array_i64_set(&" + array_slot(input) + ", array_index(" + array_slot(input) + ", signed_value(" + slot(index) + ")), signed_value(" + slot(item) + "));\n")
			IR.MakeRecord(dst, type, inputs)
				var fields = Array[string]()
				for input in inputs
					fields = fields.append(value_slot(input, function.types[!input], table))
				lines = lines.append("store_R" + str(type) + "(&" + value_slot(dst, type, table) + ", retain_R" + str(type) + "(" + record_literal(type, fields) + "));\n")
			IR.CopyRecord(dst, input)
				let type = function.types[!dst]
				let source = value_slot(input, function.types[!input], table)
				lines = lines.append("store_R" + str(type) + "(&" + value_slot(dst, type, table) + ", retain_R" + str(type) + "(" + source + "));\n")
			IR.ReadField(dst, input, field)
				let value = value_slot(input, function.types[!input], table) + ".f" + str(field)
				let type = function.types[!dst]
				if type == IR.TYPE_STRING
					lines = lines.append("store_string(&" + string_slot(dst) + ", s_string_retain(" + value + "));\n")
				elif IR.is_array(table, type)
					if managed_array(table, type)
						lines = lines.append("store_managed_array(&" + managed_array_slot(dst) + ", s_array_retain(" + value + "));\n")
					else
						lines = lines.append("store_array(&" + array_slot(dst) + ", s_array_i64_retain(" + value + "));\n")
				elif IR.is_dict(table, type)
					lines = lines.append("store_dict(&" + dict_slot(dst) + ", s_dict_retain(" + value + "));\n")
				elif IR.is_record(table, type) or IR.is_optional(table, type) or IR.is_union(table, type)
					lines = lines.append(store_value(table, type, value_slot(dst, type, table), retain_value(table, type, value)))
				else
					lines = lines.append(value_slot(dst, type, table) + " = " + value + ";\n")
			IR.SetField(record, field, input)
				let record_type = function.types[!record]
				let field_type = table.entries[!record_type].fields[!field].type
				let target = value_slot(record, record_type, table) + ".f" + str(field)
				let value = value_slot(input, field_type, table)
				if field_type == IR.TYPE_STRING
					lines = lines.append("store_string(&" + target + ", s_string_retain(" + value + "));\n")
				elif IR.is_dict(table, field_type)
					lines = lines.append("store_dict(&" + target + ", s_dict_retain(" + value + "));\n")
				elif IR.is_array(table, field_type)
					if managed_array(table, field_type)
						lines = lines.append("store_managed_array(&" + target + ", s_array_retain(" + value + "));\n")
					else
						lines = lines.append("store_array(&" + target + ", s_array_i64_retain(" + value + "));\n")
				elif IR.is_record(table, field_type) or IR.is_optional(table, field_type) or IR.is_union(table, field_type)
					lines = lines.append(store_value(table, field_type, target, retain_value(table, field_type, value)))
				else
					lines = lines.append(target + " = " + value + ";\n")
			IR.Call(dst, target, arguments)
				var inputs = Array[string]()
				for input in arguments
