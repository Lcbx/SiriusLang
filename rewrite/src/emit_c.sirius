import ir alias IR
import lower alias Lower

let OCTAL_RADIX = 8
let OCTAL_HIGH_PLACE = 64
let OPTIONAL_FORMAT_BUFFER_SIZE = 32

export rec Result(code: string, error: string, line: i64)

def slot(id: i64) -> string
	return "v[" + str(id) + "]"

def string_slot(id: i64) -> string
	return "s[" + str(id) + "]"

def dict_slot(id: i64) -> string
	return "d[" + str(id) + "]"

def array_slot(id: i64) -> string
	return "a[" + str(id) + "]"

def managed_array_slot(id: i64) -> string
	return "b[" + str(id) + "]"

# `Array[i64]` retains the specialized runtime layout. Every other
# executable array uses generic storage parameterized by its element type.
def managed_array(table: IR.TypeTable, type: i64) -> bool
	return IR.is_array(table, type) and IR.array_element(table, type) != IR.TYPE_I64

# Construct ownership operations from the element descriptor, rather than
# enumerating combinations of array nesting depth and record layouts.
def retain_value(table: IR.TypeTable, type: i64, value: string) -> string
	if type == IR.TYPE_STRING
		return "s_string_retain(" + value + ")"
	if IR.is_optional(table, type)
		return "retain_O" + str(type) + "(" + value + ")"
	if IR.is_dict(table, type)
		return "s_dict_retain(" + value + ")"
	if IR.is_record(table, type)
		return "retain_R" + str(type) + "(" + value + ")"
	if IR.is_union(table, type)
		return "retain_U" + str(type) + "(" + value + ")"
	if IR.is_array(table, type)
		if managed_array(table, type)
			return "s_array_retain(" + value + ")"
		return "s_array_i64_retain(" + value + ")"
	return value

def release_value(table: IR.TypeTable, type: i64, value: string) -> string
	if type == IR.TYPE_STRING
		return "s_string_release(" + value + ")"
	if IR.is_optional(table, type)
		return "release_O" + str(type) + "(" + value + ")"
	if IR.is_dict(table, type)
		return "s_dict_release(" + value + ")"
	if IR.is_record(table, type)
		return "release_R" + str(type) + "(" + value + ")"
	if IR.is_union(table, type)
		return "release_U" + str(type) + "(" + value + ")"
	if IR.is_array(table, type)
		if managed_array(table, type)
			return "s_array_release(" + value + ")"
		return "s_array_i64_release(" + value + ")"
	return "(void)" + value

def optional_slot(id: i64, type: i64) -> string
	return "o" + str(type) + "[" + str(id) + "]"

def output(input: i64, type: IR.OutputType, stderr: bool) -> string
	var function = "s_print_"
	if stderr
		function = "s_eprint_"
	match type
		IR.Integer
			return function + "i64(signed_value(" + slot(input) + "));\n"
		IR.Boolean
			return function + "bool(" + slot(input) + " != 0);\n"
		IR.Text
			return function + "string(" + string_slot(input) + ");\n"

# Fixed-width octal escapes preserve every UTF-8 byte, including embedded NUL.
def c_bytes(value: string) -> string
	var parts = Array[string]()
	for i in 0..len(value)
		let byte = value.byte_at(i) or 0
		parts = parts.append("\\" + str(byte / OCTAL_HIGH_PLACE) + str((byte / OCTAL_RADIX) % OCTAL_RADIX) + str(byte % OCTAL_RADIX))
	return "\"" + "".join(parts) + "\""

def c_type(type: i64, table: IR.TypeTable) -> string
	if IR.is_dict(table, type)
		return "S_Dict *"
	if managed_array(table, type)
		return "S_Array *"
	if IR.is_array(table, type)
		return "S_Array_i64 *"
	if IR.is_record(table, type)
		return "R" + str(type) + " "
	if IR.is_union(table, type)
		return "U" + str(type) + " "
	if type == IR.TYPE_STRING
		return "S_String *"
	if IR.is_optional(table, type)
		return "O" + str(type) + " "
	if type == IR.TYPE_BOOL
		return "bool "
	return "uint64_t "

def value_slot(id: i64, type: i64, table: IR.TypeTable) -> string
	if IR.is_dict(table, type)
		return dict_slot(id)
	if managed_array(table, type)
		return managed_array_slot(id)
	if IR.is_array(table, type)
		return array_slot(id)
	if IR.is_record(table, type)
		return "r" + str(type) + "[" + str(id) + "]"
	if IR.is_union(table, type)
		return "u" + str(type) + "[" + str(id) + "]"
	if type == IR.TYPE_STRING
		return string_slot(id)
	if IR.is_optional(table, type)
		return optional_slot(id, type)
	return slot(id)

# Optional payloads are owned values. A present optional retains its payload
# across copies, calls and default/unwrap reads. Absent values own nothing.
def optional_definition(table: IR.TypeTable, type: i64) -> string
	let payload = IR.optional_payload(table, type)
	let name = "O" + str(type)
	var lines = Array[string]()
	if payload == IR.TYPE_I64
		lines = lines.append("typedef S_Optional_i64 " + name + ";\n")
	else
		lines = lines.append("typedef struct { bool has_value; " + c_type(payload, table) + "value; } " + name + ";\n")
	lines = lines.append("static inline " + name + " retain_" + name + "(" + name + " value) { if (value.has_value) value.value = " + retain_value(table, payload, "value.value") + "; return value; }\n")
	lines = lines.append("static inline void release_" + name + "(" + name + " value) { if (value.has_value) { " + release_value(table, payload, "value.value") + "; } }\n")
	lines = lines.append("static inline void store_" + name + "(" + name + " *dst, " + name + " value) { release_" + name + "(*dst); *dst = value; }\n")
	return "".join(lines)

def store_value(table: IR.TypeTable, type: i64, target: string, value: string) -> string
	if IR.is_optional(table, type)
		return "store_O" + str(type) + "(&" + target + ", " + value + ");\n"
	if IR.is_record(table, type)
		return "store_R" + str(type) + "(&" + target + ", " + value + ");\n"
	if IR.is_union(table, type)
		return "store_U" + str(type) + "(&" + target + ", " + value + ");\n"
	if IR.is_dict(table, type)
		return "store_dict(&" + target + ", " + value + ");\n"
	if IR.is_array(table, type)
		if managed_array(table, type)
			return "store_managed_array(&" + target + ", " + value + ");\n"
		return "store_array(&" + target + ", " + value + ");\n"
	if type == IR.TYPE_STRING
		return "store_string(&" + target + ", " + value + ");\n"
	return target + " = " + value + ";\n"

def record_types(function: IR.Function, table: IR.TypeTable) -> Array[i64]
	var result = Array[i64]()
	for type in 0..len(table.entries)
		if not IR.is_record(table, type)
			continue
		var used = false
		for slot_type in function.types
			if slot_type == type
				used = true
		if used
			result = result.append(type)
	return result

def record_definition(table: IR.TypeTable, type: i64) -> string
	var parts = Array[string]()
	let name = "R" + str(type)
	let fields = table.entries[!type].fields
	parts = parts.append("typedef struct {\n")
	if len(fields) == 0
		parts = parts.append("unsigned char unused;\n")
	for i in 0..len(fields)
		parts = parts.append(c_type(fields[!i].type, table) + "f" + str(i) + ";\n")
	parts = parts.append("} " + name + ";\n")
	parts = parts.append("static inline " + name + " retain_" + name + "(" + name + " value) {\n")
	for i in 0..len(fields)
		let field_type = fields[!i].type
		if field_type == IR.TYPE_STRING
			parts = parts.append("s_string_retain(value.f" + str(i) + ");\n")
		elif IR.is_optional(table, field_type)
			parts = parts.append("retain_O" + str(field_type) + "(value.f" + str(i) + ");\n")
		elif IR.is_record(table, field_type)
			parts = parts.append("retain_R" + str(field_type) + "(value.f" + str(i) + ");\n")
		elif IR.is_union(table, field_type)
			parts = parts.append("retain_U" + str(field_type) + "(value.f" + str(i) + ");\n")
		elif IR.is_dict(table, field_type)
			parts = parts.append("s_dict_retain(value.f" + str(i) + ");\n")
		elif IR.is_array(table, field_type)
			if managed_array(table, field_type)
				parts = parts.append("s_array_retain(value.f" + str(i) + ");\n")
			else
				parts = parts.append("s_array_i64_retain(value.f" + str(i) + ");\n")
	parts = parts.append("return value; }\nstatic inline void release_" + name + "(" + name + " value) { (void)value;\n")
	for i in 0..len(fields)
		let field_type = fields[!i].type
		if field_type == IR.TYPE_STRING
			parts = parts.append("s_string_release(value.f" + str(i) + ");\n")
		elif IR.is_optional(table, field_type)
			parts = parts.append("release_O" + str(field_type) + "(value.f" + str(i) + ");\n")
		elif IR.is_record(table, field_type)
			parts = parts.append("release_R" + str(field_type) + "(value.f" + str(i) + ");\n")
		elif IR.is_union(table, field_type)
			parts = parts.append("release_U" + str(field_type) + "(value.f" + str(i) + ");\n")
		elif IR.is_dict(table, field_type)
			parts = parts.append("s_dict_release(value.f" + str(i) + ");\n")
		elif IR.is_array(table, field_type)
			if managed_array(table, field_type)
				parts = parts.append("s_array_release(value.f" + str(i) + ");\n")
			else
				parts = parts.append("s_array_i64_release(value.f" + str(i) + ");\n")
	parts = parts.append("}\nstatic inline void store_" + name + "(" + name + " *dst, " + name + " value) { release_" + name + "(*dst); *dst = value; }\n")
	return "".join(parts)

# An inline tagged union stores exactly one record payload and owns its
# managed fields. Tag 0 is also the zero-initialized slot representation;
# zero-initialized records contain no managed references to release.
def union_definition(table: IR.TypeTable, type: i64) -> string
	let name = "U" + str(type)
	let fields = table.entries[!type].fields
	var lines = ["typedef struct { uint64_t tag; union {\n"]
	for i in 0..len(fields)
		lines = lines.append(c_type(fields[!i].type, table) + "p" + str(i) + ";\n")
	lines = lines.append("} data; } " + name + ";\n")
	lines = lines.append("static inline " + name + " retain_" + name + "(" + name + " value) {\nswitch (value.tag) {\n")
	for i in 0..len(fields)
		let payload = fields[!i].type
		lines = lines.append("case " + str(i) + ": retain_R" + str(payload) + "(value.data.p" + str(i) + "); break;\n")
	lines = lines.append("default: s_panic(\"invalid union tag\"); }\nreturn value; }\n")
	lines = lines.append("static inline void release_" + name + "(" + name + " value) {\nswitch (value.tag) {\n")
	for i in 0..len(fields)
		let payload = fields[!i].type
		lines = lines.append("case " + str(i) + ": release_R" + str(payload) + "(value.data.p" + str(i) + "); break;\n")
	lines = lines.append("default: s_panic(\"invalid union tag\"); } }\n")
	lines = lines.append("static inline void store_" + name + "(" + name + " *dst, " + name + " value) { release_" + name + "(*dst); *dst = value; }\n")
	return "".join(lines)

# Equality uses checked descriptors, never padding or pointer identity for
# distinct aggregate values. Child helpers precede their parents by TypeId.
def equal_value(table: IR.TypeTable, type: i64, left: string, right: string) -> string
	if type == IR.TYPE_STRING
		return "(s_string_compare(" + left + ", " + right + ") == 0)"
	if IR.is_record(table, type)
		return "equal_R" + str(type) + "(" + left + ", " + right + ")"
	if IR.is_union(table, type)
		return "equal_U" + str(type) + "(" + left + ", " + right + ")"
	if IR.is_optional(table, type)
		return "equal_O" + str(type) + "(" + left + ", " + right + ")"
	if IR.is_array(table, type)
		return "equal_A" + str(type) + "(" + left + ", " + right + ")"
	if IR.is_dict(table, type)
		return "equal_D" + str(type) + "(" + left + ", " + right + ")"
	return "(" + left + " == " + right + ")"

def equality_definition(table: IR.TypeTable, type: i64) -> string
	if IR.is_record(table, type)
		let name = "R" + str(type)
		var lines = ["static inline bool equal_" + name + "(" + name + " a, " + name + " b) {\n"]
		let fields = table.entries[!type].fields
		if len(fields) == 0
			lines = lines.append("(void)a; (void)b;\n")
		for i in 0..len(fields)
			lines = lines.append("if (!" + equal_value(table, fields[!i].type, "a.f" + str(i), "b.f" + str(i)) + ") return false;\n")
		return "".join(lines) + "return true; }\n"
	if IR.is_optional(table, type)
		let name = "O" + str(type)
		return "static inline bool equal_" + name + "(" + name + " a, " + name + " b) { if (a.has_value != b.has_value) return false; if (!a.has_value) return true; return " + equal_value(table, IR.optional_payload(table, type), "a.value", "b.value") + "; }\n"
	if IR.is_union(table, type)
		let name = "U" + str(type)
		var lines = ["static inline bool equal_" + name + "(" + name + " a, " + name + " b) { if (a.tag != b.tag) return false; switch (a.tag) {\n"]
		let alternatives = table.entries[!type].fields
		for i in 0..len(alternatives)
			lines = lines.append("case " + str(i) + ": return " + equal_value(table, alternatives[!i].type, "a.data.p" + str(i), "b.data.p" + str(i)) + ";\n")
		return "".join(lines) + "default: s_panic(\"invalid union tag\"); } }\n"
	if IR.is_array(table, type)
		let element = IR.array_element(table, type)
		let name = "equal_A" + str(type)
		if not managed_array(table, type)
			return "static inline bool " + name + "(const S_Array_i64 *a, const S_Array_i64 *b) { if (a == b) return true; if (!a || !b || a->length != b->length) return false; for (size_t i = 0; i < a->length; ++i) if (a->data[i] != b->data[i]) return false; return true; }\n"
		let c = c_type(element, table)
		let left = "*(" + c + "const *)s_array_at(a, (int64_t)i)"
		let right = "*(" + c + "const *)s_array_at(b, (int64_t)i)"
		return "static inline bool " + name + "(const S_Array *a, const S_Array *b) { if (a == b) return true; if (!a || !b || s_array_length(a) != s_array_length(b)) return false; for (size_t i = 0; i < s_array_length(a); ++i) if (!" + equal_value(table, element, left, right) + ") return false; return true; }\n"
	if IR.is_dict(table, type)
		let value = IR.dict_value(table, type)
		let c = c_type(value, table)
		let left = "*(" + c + "const *)s_dict_value_slot(a, cursor)"
		let right = "*(" + c + "const *)found"
		return "static inline bool equal_D" + str(type) + "(const S_Dict *a, const S_Dict *b) { if (a == b) return true; if (!a || !b || s_dict_length(a) != s_dict_length(b)) return false; int64_t cursor = -1; while ((cursor = s_dict_next_slot(a, cursor)) >= 0) { const void *found = s_dict_get(b, s_dict_key_slot(a, cursor)); if (!found || !" + equal_value(table, value, left, right) + ") return false; } return true; }\n"
	return ""

# Composite layout definitions are emitted in descriptor order: a record may
# contain an optional and an optional may contain an earlier record.
def value_definitions(table: IR.TypeTable) -> string
	var parts = Array[string]()
	for type in 0..len(table.entries)
		if not IR.runtime_type(table, type)
			continue
		if IR.is_record(table, type)
			parts = parts.append(record_definition(table, type))
		elif IR.is_optional(table, type)
			parts = parts.append(optional_definition(table, type))
		elif IR.is_union(table, type)
			parts = parts.append(union_definition(table, type))
		parts = parts.append(equality_definition(table, type))
	return "".join(parts)

# Generic arrays need one copy/drop/get group per distinct element descriptor.
# Specializations use the *element's* ownership rules, not the outer depth.
def array_item_helpers(table: IR.TypeTable) -> string
	var parts = Array[string]()
	for type in 0..len(table.entries)
		if not managed_array(table, type) or not IR.runtime_type(table, type)
			continue
		let element = IR.array_element(table, type)
		let c = c_type(element, table)
		let name = str(element)
		parts = parts.append("static inline void copy_item_" + name + "(void *dst, const void *src) { *(" + c + "*)dst = " + retain_value(table, element, "*(" + c + "const *)src") + "; }\n")
		parts = parts.append("static inline void drop_item_" + name + "(void *item) { " + release_value(table, element, "*(" + c + "const *)item") + "; }\n")
		parts = parts.append("static inline " + c + " array_get_" + name + "(const S_Array *a, int64_t i) { " + c + "const *ptr = s_array_at(a, managed_array_index(a, i)); if (!ptr) s_panic(\"index out of bounds\"); return " + retain_value(table, element, "*ptr") + "; }\n")
	return "".join(parts)

def dict_item_helpers(table: IR.TypeTable) -> string
	var parts = Array[string]()
	for type in 0..len(table.entries)
		if not IR.is_dict(table, type) or not IR.runtime_type(table, type)
			continue
		let key = IR.dict_key(table, type)
		let value = IR.dict_value(table, type)
		if key == IR.TYPE_STRING
			parts = parts.append("static inline void dict_copy_key_" + str(type) + "(void *dst, const void *src) { *(S_String **)dst = s_string_retain(*(S_String *const *)src); }\n")
			parts = parts.append("static inline void dict_drop_key_" + str(type) + "(void *src) { s_string_release(*(S_String **)src); }\n")
		if value != IR.TYPE_I64 and value != IR.TYPE_BOOL
			let c = c_type(value, table)
			parts = parts.append("static inline void dict_copy_value_" + str(type) + "(void *dst, const void *src) { *(" + c + "*)dst = " + retain_value(table, value, "*(" + c + "const *)src") + "; }\n")
			parts = parts.append("static inline void dict_drop_value_" + str(type) + "(void *src) { " + release_value(table, value, "*(" + c + "const *)src") + "; }\n")
	return "".join(parts)

def record_literal(type: i64, values: Array[string]) -> string
	if len(values) == 0
		return "(R" + str(type) + "){0}"
	var fields = Array[string]()
	for i in 0..len(values)
		fields = fields.append(".f" + str(i) + " = " + values[!i])
	return "(R" + str(type) + "){" + ", ".join(fields) + "}"

def declaration(function: IR.Function, id: i64, table: IR.TypeTable) -> string
	var parameters = Array[string]()
	for i in 0..len(function.parameters)
		parameters = parameters.append(c_type(function.parameters[!i], table) + "p" + str(i))
	var arguments = ", ".join(parameters)
	if len(parameters) == 0
		arguments = "void"
	return "static inline " + c_type(function.result, table) + "f" + str(id) + "(" + arguments + ")"

def emit_function(function: IR.Function, id: i64, table: IR.TypeTable) -> string
	let program = function.body
	let has_strings = IR.function_has_strings(function)
	var lines = [declaration(function, id, table) + " {\n"]
	var has_scalars = false
	for type in function.types
		if type == IR.TYPE_I64 or type == IR.TYPE_BOOL or IR.is_enum(table, type)
			has_scalars = true
	if has_scalars
		lines = lines.append("uint64_t v[" + str(program.slots) + "]; (void)v;\n")
	var has_arrays = false
	var has_managed_arrays = false
	var has_dicts = false
	for type in function.types
		if IR.is_dict(table, type)
			has_dicts = true
		elif managed_array(table, type)
			has_managed_arrays = true
		elif IR.is_array(table, type)
			has_arrays = true
	if has_dicts
		lines = lines.append("S_Dict *d[" + str(program.slots) + "] = {0}; (void)d;\n")
	if has_managed_arrays
		lines = lines.append("S_Array *b[" + str(program.slots) + "] = {0}; (void)b;\n")
	if has_arrays
		lines = lines.append("S_Array_i64 *a[" + str(program.slots) + "] = {0}; (void)a;\n")
	if has_strings
		lines = lines.append("S_String *s[" + str(program.slots) + "] = {0}; (void)s;\n")
	var optionals = Array[i64]()
	for type in 0..len(table.entries)
		if not IR.is_optional(table, type)
			continue
		var used = false
		for slot_type in function.types
			if slot_type == type
				used = true
		if used
			optionals = optionals.append(type)
			lines = lines.append("O" + str(type) + " o" + str(type) + "[" + str(program.slots) + "] = {0}; (void)o" + str(type) + ";\n")
	let records = record_types(function, table)
	for type in records
		lines = lines.append("R" + str(type) + " r" + str(type) + "[" + str(program.slots) + "] = {0}; (void)r" + str(type) + ";\n")
	var unions = Array[i64]()
	for type in 0..len(table.entries)
		if IR.is_union(table, type)
			for slot_type in function.types
				if slot_type == type
					unions = unions.append(type)
					lines = lines.append("U" + str(type) + " u" + str(type) + "[" + str(program.slots) + "] = {0}; (void)u" + str(type) + ";\n")
					break
	# Arguments are borrowed. Parameter slots retain their own references so all
	# string slots follow the same overwrite/return cleanup rule.
	for i in 0..len(function.parameters)
		let type = function.parameters[!i]
		if IR.is_dict(table, type)
			lines = lines.append("store_dict(&" + dict_slot(i) + ", s_dict_retain(p" + str(i) + "));\n")
		elif managed_array(table, type)
			lines = lines.append("store_managed_array(&" + managed_array_slot(i) + ", s_array_retain(p" + str(i) + "));\n")
		elif IR.is_array(table, type)
			lines = lines.append("store_array(&" + array_slot(i) + ", s_array_i64_retain(p" + str(i) + "));\n")
		elif type == IR.TYPE_STRING
			lines = lines.append("store_string(&" + string_slot(i) + ", s_string_retain(p" + str(i) + "));\n")
		elif IR.is_record(table, type)
			lines = lines.append("store_R" + str(type) + "(&" + value_slot(i, type, table) + ", retain_R" + str(type) + "(p" + str(i) + "));\n")
		elif IR.is_union(table, type)
			lines = lines.append(store_value(table, type, value_slot(i, type, table), retain_value(table, type, "p" + str(i))))
		elif IR.is_optional(table, type)
			lines = lines.append(store_value(table, type, value_slot(i, type, table), retain_value(table, type, "p" + str(i))))
		else
			lines = lines.append(value_slot(i, type, table) + " = p" + str(i) + ";\n")
	lines = lines.append("goto L0;\n")
	for index in 0..len(program.instructions)
		let instruction = program.instructions[!index]
		lines = lines.append("L" + str(index) + ":;\n")
		var fallthrough = true
		match instruction
			IR.MakeDict(dst)
				let type = function.types[!dst]
				let key = IR.dict_key(table, type)
				let value = IR.dict_value(table, type)
				var key_copy = "NULL"
				var key_drop = "NULL"
				var hash = "s_hash_i64_key"
				var equal = "s_eq_i64_key"
				if key == IR.TYPE_STRING
					key_copy = "dict_copy_key_" + str(type)
					key_drop = "dict_drop_key_" + str(type)
					hash = "s_hash_string_key"
					equal = "s_eq_string_key"
				var value_copy = "NULL"
				var value_drop = "NULL"
				if value != IR.TYPE_I64 and value != IR.TYPE_BOOL
					value_copy = "dict_copy_value_" + str(type)
					value_drop = "dict_drop_value_" + str(type)
				lines = lines.append("store_dict(&" + dict_slot(dst) + ", s_dict_new(sizeof(" + c_type(key, table) + "), sizeof(" + c_type(value, table) + "), " + key_copy + ", " + key_drop + ", " + value_copy + ", " + value_drop + ", " + hash + ", " + equal + "));\n")
				var audit_key = "false"
				var audit_value = "false"
				if key == IR.TYPE_STRING
					audit_key = "true"
				if value == IR.TYPE_STRING or IR.is_array(table, value) or IR.is_dict(table, value)
					audit_value = "true"
				if audit_key == "true" or audit_value == "true"
					lines = lines.append("s_dict_arc_audit_fields(" + dict_slot(dst) + ", " + audit_key + ", " + audit_value + ");\n")
			IR.DictNext(dst, input, cursor)
				lines = lines.append(slot(cursor) + " = (uint64_t)s_dict_next_slot(" + dict_slot(input) + ", signed_value(" + slot(cursor) + "));\n")
				lines = lines.append(slot(dst) + " = signed_value(" + slot(cursor) + ") >= 0;\n")
			IR.DictKey(dst, input, cursor)
				let key_type = function.types[!dst]
				let item = "*(" + c_type(key_type, table) + " const *)s_dict_key_slot(" + dict_slot(input) + ", signed_value(" + slot(cursor) + "))"
				lines = lines.append(store_value(table, key_type, value_slot(dst, key_type, table), retain_value(table, key_type, item)))
			IR.DictGet(dst, input, key)
				let type = function.types[!dst]
				let payload = IR.optional_payload(table, type)
				let c = c_type(payload, table)
				let result = value_slot(dst, type, table)
				let lookup = "s_dict_get(" + dict_slot(input) + ", &" + value_slot(key, function.types[!key], table) + ")"
				lines = lines.append("{ const void *item = " + lookup + "; O" + str(type) + " value = {0}; if (item) { value.has_value = true; value.value = " + retain_value(table, payload, "*(" + c + "const *)item") + "; }\n")
				lines = lines.append(store_value(table, type, result, "value"))
				lines = lines.append("}\n")
			IR.CopyDict(dst, input)
				lines = lines.append("store_dict(&" + dict_slot(dst) + ", s_dict_retain(" + dict_slot(input) + "));\n")
			IR.DictLength(dst, input)
				lines = lines.append(slot(dst) + " = (uint64_t)s_dict_length(" + dict_slot(input) + ");\n")
			IR.DictInsert(dst, input, key, value)
				let key_type = function.types[!key]
				let value_type = function.types[!value]
				var value_expr = "&" + value_slot(value, value_type, table)
				if value_type == IR.TYPE_BOOL
					value_expr = "&(bool){" + slot(value) + " != 0}"
				lines = lines.append("store_dict(&" + dict_slot(dst) + ", s_dict_insert(s_dict_retain(" + dict_slot(input) + "), &" + value_slot(key, key_type, table) + ", " + value_expr + "));\n")
			IR.DictRead(dst, input, key)
				let value_type = function.types[!dst]
				let c = c_type(value_type, table)
				let expr = "* (" + c + "const *)dict_value"
				let target = value_slot(dst, value_type, table)
				lines = lines.append("{ const void *dict_value = s_dict_get(" + dict_slot(input) + ", &" + value_slot(key, function.types[!key], table) + "); if (!dict_value) s_panic(\"missing dictionary key\");\n")
				if value_type == IR.TYPE_STRING
					lines = lines.append("store_string(&" + target + ", s_string_retain(" + expr + "));\n")
				elif IR.is_dict(table, value_type)
					lines = lines.append("store_dict(&" + target + ", s_dict_retain(" + expr + "));\n")
				elif IR.is_array(table, value_type)
					var store = "store_array"
					if managed_array(table, value_type)
						store = "store_managed_array"
					lines = lines.append(store + "(&" + target + ", " + retain_value(table, value_type, expr) + ");\n")
				elif IR.is_record(table, value_type) or IR.is_optional(table, value_type) or IR.is_union(table, value_type)
					lines = lines.append(store_value(table, value_type, target, retain_value(table, value_type, expr)))
				else
					lines = lines.append(target + " = " + expr + ";\n")
				lines = lines.append("}\n")
			IR.MakeArray(dst, inputs)
				let element = IR.array_element(table, function.types[!dst])
				var items = Array[string]()
				for input in inputs
					var value = value_slot(input, element, table)
					if not managed_array(table, function.types[!dst])
						value = "signed_value(" + slot(input) + ")"
					items = items.append(value)
				var data = "NULL"
				if len(items) > 0
					if managed_array(table, function.types[!dst])
						data = "(" + c_type(element, table) + "[]){" + ", ".join(items) + "}"
					else
						data = "(int64_t[]){" + ", ".join(items) + "}"
				if managed_array(table, function.types[!dst])
					lines = lines.append("store_managed_array(&" + managed_array_slot(dst) + ", s_array_make(" + str(len(items)) + ", " + data + ", sizeof(" + c_type(element, table) + "), copy_item_" + str(element) + ", drop_item_" + str(element) + "));\n")
				else
					lines = lines.append("store_array(&" + array_slot(dst) + ", s_array_i64_make(" + str(len(items)) + ", " + data + "));\n")
			IR.CopyArray(dst, input)
				if managed_array(table, function.types[!dst])
					lines = lines.append("store_managed_array(&" + managed_array_slot(dst) + ", s_array_retain(" + managed_array_slot(input) + "));\n")
				else
					lines = lines.append("store_array(&" + array_slot(dst) + ", s_array_i64_retain(" + array_slot(input) + "));\n")
			IR.ArrayLength(dst, input)
				if managed_array(table, function.types[!input])
					lines = lines.append(slot(dst) + " = (uint64_t)s_array_length(" + managed_array_slot(input) + ");\n")
				else
					lines = lines.append(slot(dst) + " = (uint64_t)" + array_slot(input) + "->length;\n")
			IR.ArrayGet(dst, input, index)
				let type = function.types[!dst]
				let element = IR.optional_payload(table, type)
				let target = value_slot(dst, type, table)
				if managed_array(table, function.types[!input])
					let ptr = "s_array_at(" + managed_array_slot(input) + ", managed_array_index(" + managed_array_slot(input) + ", signed_value(" + slot(index) + ")))"
					lines = lines.append("{ " + c_type(element, table) + "const *item = " + ptr + "; O" + str(type) + " value = {0}; if (item) { value.has_value = true; value.value = " + retain_value(table, element, "*item") + "; }\n")
					lines = lines.append(store_value(table, type, target, "value"))
					lines = lines.append("}\n")
				else
					lines = lines.append(store_value(table, type, target, "s_array_i64_get(" + array_slot(input) + ", array_index(" + array_slot(input) + ", signed_value(" + slot(index) + ")))"))
			IR.ArrayRead(dst, input, index)
				let element = IR.array_element(table, function.types[!input])
				if managed_array(table, function.types[!input])
					let read = "array_get_" + str(element) + "(" + managed_array_slot(input) + ", signed_value(" + slot(index) + "))"
					if IR.is_record(table, element) or IR.is_optional(table, element) or IR.is_union(table, element)
						lines = lines.append(store_value(table, element, value_slot(dst, element, table), read))
					elif element == IR.TYPE_STRING
						lines = lines.append("store_string(&" + string_slot(dst) + ", " + read + ");\n")
					elif IR.is_dict(table, element)
						lines = lines.append("store_dict(&" + dict_slot(dst) + ", " + read + ");\n")
					elif managed_array(table, element)
						lines = lines.append("store_managed_array(&" + managed_array_slot(dst) + ", " + read + ");\n")
					elif element == IR.TYPE_BOOL or IR.is_enum(table, element)
