# A type ID is an index in a canonical table, not an encoded type kind.
export enum TypeKind
	I64
	Bool
	String
	Optional
	Record
	Array
	Dictionary
	Enum
	Union

export let NO_TYPE = -1
export let TYPE_I64 = 0
export let TYPE_BOOL = 1
export let TYPE_STRING = 2
let PRIMITIVE_TYPE_COUNT = 3

export rec RecordField(name: string, type: i64)
export rec TypeDescriptor(kind: TypeKind, payload: i64, fields: Array[RecordField], key: i64)
export rec TypeTable(entries: Array[TypeDescriptor], optionals: Dict[i64, i64], records: Dict[string, i64])
export rec InternedType(table: TypeTable, id: i64)

export def initial_types() -> TypeTable
	return TypeTable([TypeDescriptor(TypeKind.I64(I64()), NO_TYPE, [], NO_TYPE), TypeDescriptor(TypeKind.Bool(Bool()), NO_TYPE, [], NO_TYPE), TypeDescriptor(TypeKind.String(String()), NO_TYPE, [], NO_TYPE)], Dict[i64, i64](), Dict[string, i64]())

export def valid_type(table: TypeTable, id: i64) -> bool
	return id >= 0 and id < len(table.entries)

export def has_kind(table: TypeTable, id: i64, kind: TypeKind) -> bool
	return valid_type(table, id) and table.entries[!id].kind == kind

export def is_optional(table: TypeTable, id: i64) -> bool
	return has_kind(table, id, TypeKind.Optional(Optional()))

export def optional_payload(table: TypeTable, id: i64) -> i64
	if not is_optional(table, id)
		return NO_TYPE
	return table.entries[!id].payload

export def find_optional(table: TypeTable, payload: i64) -> i64
	return table.optionals.get(payload) or NO_TYPE

export def intern_optional(table: TypeTable, payload: i64) -> InternedType
	if not valid_type(table, payload)
		return InternedType(table, NO_TYPE)
	let existing = find_optional(table, payload)
	if existing != NO_TYPE
		return InternedType(table, existing)
	var result = table
	let id = len(result.entries)
	result.entries = result.entries.append(TypeDescriptor(TypeKind.Optional(Optional()), payload, [], NO_TYPE))
	result.optionals = result.optionals.insert(payload, id)
	return InternedType(result, id)

export def is_array(table: TypeTable, id: i64) -> bool
	return has_kind(table, id, TypeKind.Array(Array()))

export def array_element(table: TypeTable, id: i64) -> i64
	if not is_array(table, id)
		return NO_TYPE
	return table.entries[!id].payload

export def find_array(table: TypeTable, element: i64) -> i64
	for id in PRIMITIVE_TYPE_COUNT..len(table.entries)
		if is_array(table, id) and array_element(table, id) == element
			return id
	return NO_TYPE

export def intern_array(table: TypeTable, element: i64) -> InternedType
	if not valid_type(table, element)
		return InternedType(table, NO_TYPE)
	let existing = find_array(table, element)
	if existing != NO_TYPE
		return InternedType(table, existing)
	var result = table
	let id = len(result.entries)
	result.entries = result.entries.append(TypeDescriptor(TypeKind.Array(Array()), element, [], NO_TYPE))
	return InternedType(result, id)

export def is_dict(table: TypeTable, id: i64) -> bool
	return has_kind(table, id, TypeKind.Dictionary(Dictionary()))

export def dict_key(table: TypeTable, id: i64) -> i64
	if not is_dict(table, id)
		return NO_TYPE
	return table.entries[!id].key

export def dict_value(table: TypeTable, id: i64) -> i64
	if not is_dict(table, id)
		return NO_TYPE
	return table.entries[!id].payload

export def find_dict(table: TypeTable, key: i64, value: i64) -> i64
	for id in PRIMITIVE_TYPE_COUNT..len(table.entries)
		if is_dict(table, id) and dict_key(table, id) == key and dict_value(table, id) == value
			return id
	return NO_TYPE

export def intern_dict(table: TypeTable, key: i64, value: i64) -> InternedType
	if (key != TYPE_I64 and key != TYPE_STRING) or not valid_type(table, value)
		return InternedType(table, NO_TYPE)
	let existing = find_dict(table, key, value)
	if existing != NO_TYPE
		return InternedType(table, existing)
	var result = table
	let id = len(result.entries)
	result.entries = result.entries.append(TypeDescriptor(TypeKind.Dictionary(Dictionary()), value, [], key))
	return InternedType(result, id)

export def is_enum(table: TypeTable, id: i64) -> bool
	return has_kind(table, id, TypeKind.Enum(Enum()))

# Enum identity consists of its ordered labels (nominal names are aliases).
export def enum_index(table: TypeTable, id: i64, label: string) -> i64
	if not is_enum(table, id)
		return -1
	let fields = table.entries[!id].fields
	for i in 0..len(fields)
		if fields[!i].name == label
			return i
	return -1

def equal_enum_fields(left: Array[RecordField], right: Array[RecordField]) -> bool
	if len(left) != len(right)
		return false
	for i in 0..len(left)
		if left[!i].name != right[!i].name or left[!i].type != right[!i].type
			return false
	return true

export def intern_enum(table: TypeTable, labels: Array[string]) -> InternedType
	if len(labels) < 2
		return InternedType(table, NO_TYPE)
	var fields = Array[RecordField]()
	for label in labels
		if label == ""
			return InternedType(table, NO_TYPE)
		for prior in fields
			if prior.name == label
				return InternedType(table, NO_TYPE)
		fields = fields.append(RecordField(label, NO_TYPE))
	for id in PRIMITIVE_TYPE_COUNT..len(table.entries)
		if is_enum(table, id) and equal_enum_fields(table.entries[!id].fields, fields)
			return InternedType(table, id)
	var result = table
	let id = len(result.entries)
	result.entries = result.entries.append(TypeDescriptor(TypeKind.Enum(Enum()), NO_TYPE, fields, NO_TYPE))
	return InternedType(result, id)

export def is_union(table: TypeTable, id: i64) -> bool
	return has_kind(table, id, TypeKind.Union(Union()))

# Ordered, labeled record alternatives. Same-shaped records remain distinct
# because the label and position are stored in the descriptor.
export def union_index(table: TypeTable, id: i64, label: string) -> i64
	if not is_union(table, id)
		return -1
	for i in 0..len(table.entries[!id].fields)
		if table.entries[!id].fields[!i].name == label
			return i
	return -1

export def union_payload(table: TypeTable, id: i64, tag: i64) -> i64
	if not is_union(table, id) or tag < 0 or tag >= len(table.entries[!id].fields)
		return NO_TYPE
	return table.entries[!id].fields[!tag].type

export def intern_union(table: TypeTable, variants: Array[RecordField]) -> InternedType
	if len(variants) < 2
		return InternedType(table, NO_TYPE)
	for i in 0..len(variants)
		if variants[!i].name == "" or not is_record(table, variants[!i].type)
			return InternedType(table, NO_TYPE)
		for j in 0..i
			if variants[!i].name == variants[!j].name
				return InternedType(table, NO_TYPE)
	for id in PRIMITIVE_TYPE_COUNT..len(table.entries)
		if is_union(table, id) and equal_enum_fields(table.entries[!id].fields, variants)
			return InternedType(table, id)
	var result = table
	let id = len(result.entries)
	result.entries = result.entries.append(TypeDescriptor(TypeKind.Union(Union()), NO_TYPE, variants, NO_TYPE))
	return InternedType(result, id)

export def is_record(table: TypeTable, id: i64) -> bool
	return has_kind(table, id, TypeKind.Record(Record()))

def record_key(fields: Array[RecordField]) -> string
	var key = ""
	for field in fields
		key += str(len(field.name)) + ":" + field.name + ":" + str(field.type) + ";"
	return key

export def intern_record(table: TypeTable, fields: Array[RecordField]) -> InternedType
	var ordered = Array[RecordField]()
	for field in fields
		if field.name == "" or not valid_type(table, field.type)
			return InternedType(table, NO_TYPE)
		ordered = ordered.append(field)
		var position = len(ordered) - 1
		while position > 0 and ordered[!position].name < ordered[!position - 1].name
			let previous = ordered[!position - 1]
			ordered[!position - 1] = ordered[!position]
			ordered[!position] = previous
			position -= 1
	for i in 1..len(ordered)
		if ordered[!i - 1].name == ordered[!i].name
			return InternedType(table, NO_TYPE)
	let key = record_key(ordered)
	let existing = table.records.get(key) or NO_TYPE
	if existing != NO_TYPE
		return InternedType(table, existing)
	var result = table
	let id = len(result.entries)
	result.entries = result.entries.append(TypeDescriptor(TypeKind.Record(Record()), NO_TYPE, ordered, NO_TYPE))
	result.records = result.records.insert(key, id)
	return InternedType(result, id)

export def field_index(table: TypeTable, type: i64, name: string) -> i64
	if not is_record(table, type)
		return -1
	let fields = table.entries[!type].fields
	for i in 0..len(fields)
		if fields[!i].name == name
			return i
	return -1

# A stored record has no nominal constructor label. When converting a
# previously built aggregate, only a uniquely matching union alternative may
# be used; direct record constructors are handled contextually by the checker.
export def unique_union_tag(table: TypeTable, source: i64, target: i64) -> i64
	if not is_record(table, source) or not is_union(table, target)
		return -1
	var selected = -1
	for tag in 0..len(table.entries[!target].fields)
		if compatible(table, source, union_payload(table, target, tag))
			if selected >= 0
				return -2
			selected = tag
	return selected

export def can_rewrap(table: TypeTable, source: i64, target: i64) -> bool
	if compatible(table, source, target)
		return true
	if unique_union_tag(table, source, target) >= 0
		return true
	if is_optional(table, source) and is_optional(table, target)
		return can_rewrap(table, optional_payload(table, source), optional_payload(table, target))
	if is_array(table, source) and is_array(table, target)
		return can_rewrap(table, array_element(table, source), array_element(table, target))
	if is_dict(table, source) and is_dict(table, target) and dict_key(table, source) == dict_key(table, target)
		return can_rewrap(table, dict_value(table, source), dict_value(table, target))
	return false

export def compatible(table: TypeTable, source: i64, target: i64) -> bool
	if source == target
		return true
	if not is_record(table, source) or not is_record(table, target)
		return false
	if len(table.entries[!source].fields) != len(table.entries[!target].fields)
		return false
	for field in table.entries[!target].fields
		let index = field_index(table, source, field.name)
		if index < 0 or table.entries[!source].fields[!index].type != field.type
			return false
	return true

def unsupported_type(table: TypeTable, type: i64) -> string
	if is_array(table, type)
		return "unsupported array element type"
	if is_record(table, type)
		return "unsupported record field type"
	if is_dict(table, type)
		return "unsupported dictionary value type"
	return "unsupported optional payload"

# The current string lookup instructions require this type even without an
# Optional annotation. Its ID is obtained by interning, never from TypeKind.
export def runtime_types() -> TypeTable
	return intern_array(intern_array(intern_optional(initial_types(), TYPE_I64).table, TYPE_I64).table, TYPE_STRING).table

export def verify_types(table: TypeTable) -> string
	if len(table.entries) < PRIMITIVE_TYPE_COUNT
		return "missing primitive types"
	let primitives = initial_types()
	for id in 0..PRIMITIVE_TYPE_COUNT
		if table.entries[!id] != primitives.entries[!id]
			return "invalid primitive descriptor"
	var optionals = 0
	var records = 0
	for id in PRIMITIVE_TYPE_COUNT..len(table.entries)
		let descriptor = table.entries[!id]
		match descriptor.kind
			Optional
				optionals += 1
				if descriptor.key != NO_TYPE or len(descriptor.fields) != 0 or descriptor.payload < 0 or descriptor.payload >= id
					return "invalid optional payload type"
				if find_optional(table, descriptor.payload) != id
					return "noncanonical optional type"
			Record
				records += 1
				if descriptor.payload != NO_TYPE or descriptor.key != NO_TYPE
					return "invalid record descriptor"
				var previous = ""
				for field in descriptor.fields
					if field.name <= previous or field.type < 0 or field.type >= id
						return "noncanonical record fields"
					previous = field.name
				if (table.records.get(record_key(descriptor.fields)) or NO_TYPE) != id
					return "noncanonical record type"
			Array
				if descriptor.key != NO_TYPE or len(descriptor.fields) != 0 or descriptor.payload < 0 or descriptor.payload >= id
					return "invalid array element type"
				if find_array(table, descriptor.payload) != id
					return "noncanonical array type"
			Dictionary
				if len(descriptor.fields) != 0 or (descriptor.key != TYPE_I64 and descriptor.key != TYPE_STRING) or descriptor.payload < 0 or descriptor.payload >= id
					return "invalid dictionary descriptor"
				if find_dict(table, descriptor.key, descriptor.payload) != id
					return "noncanonical dictionary type"
			Union
				if descriptor.payload != NO_TYPE or descriptor.key != NO_TYPE or len(descriptor.fields) < 2
					return "invalid union descriptor"
				for i in 0..len(descriptor.fields)
					let field = descriptor.fields[!i]
					if field.name == "" or field.type < 0 or field.type >= id or not is_record(table, field.type)
						return "invalid union alternative"
					for j in 0..i
						if descriptor.fields[!j].name == field.name
							return "duplicate union label"
				for other in PRIMITIVE_TYPE_COUNT..id
					if is_union(table, other) and equal_enum_fields(table.entries[!other].fields, descriptor.fields)
						return "noncanonical union type"
			Enum
				if descriptor.payload != NO_TYPE or descriptor.key != NO_TYPE or len(descriptor.fields) < 2
					return "invalid enum descriptor"
				for i in 0..len(descriptor.fields)
					let field = descriptor.fields[!i]
					if field.type != NO_TYPE or field.name == ""
						return "invalid enum label"
					for previous in 0..i
						if descriptor.fields[!previous].name == field.name
							return "duplicate enum label"
				for previous in PRIMITIVE_TYPE_COUNT..id
					if is_enum(table, previous) and equal_enum_fields(table.entries[!previous].fields, descriptor.fields)
						return "noncanonical enum type"
			I64 | Bool | String
				return "duplicate primitive type"
	if len(table.optionals) != optionals
		return "invalid optional type cache"
	if len(table.records) != records
		return "invalid record type cache"
	return ""

# Descriptors form an acyclic graph: every payload and record field points to
# an earlier ID. Runtime admissibility therefore follows the element/field
# descriptor recursively, independent of array nesting depth.
export def runtime_type(table: TypeTable, id: i64) -> bool
	if not valid_type(table, id)
		return false
	match table.entries[!id].kind
		I64 | Bool | String | Enum
			return true
		Optional
			return runtime_type(table, optional_payload(table, id))
		Dictionary
			return runtime_type(table, dict_value(table, id))
		Array
			let element = array_element(table, id)
			return runtime_type(table, element)
		Union
			for field in table.entries[!id].fields
				if not runtime_type(table, field.type)
					return false
			return true
		Record
			for field in table.entries[!id].fields
				if not runtime_type(table, field.type)
					return false
			return true

export let INTEGER_BITS = 64
export let I64_MAX = 9223372036854775807
let FIRST_INPUT_MASK = 1
let FIRST_TWO_INPUTS_MASK = 3
let FIXED_INPUT_COUNT = 3

# Scalar slots hold i64 values or normalized booleans (0/1).
export rec EnumConstant(dst: i64, tag: i64)
export rec EnumIndex(dst: i64, input: i64)
export rec MakeUnion(dst: i64, input: i64, tag: i64)
export rec CopyUnion(dst: i64, input: i64)
export rec RewrapValue(dst: i64, input: i64)
export rec UnionIndex(dst: i64, input: i64)
export rec TagTest(dst: i64, input: i64, tag: i64)
# A group tests tags together; its subject is evaluated only once.
export rec TagAny(dst: i64, input: i64, tags: Array[i64])
# Extract a canonical record field from the active union payload.
export rec UnionField(dst: i64, input: i64, tag: i64, field: i64)
# Each alternative selects its own canonical payload field; types must agree.
export rec UnionFields(dst: i64, input: i64, tags: Array[i64], fields: Array[i64])
export rec Trap()
export rec Constant(dst: i64, value: i64)
export rec Negate(dst: i64, input: i64)
export rec Not(dst: i64, input: i64)
export rec Add(dst: i64, left: i64, right: i64)
export rec Subtract(dst: i64, left: i64, right: i64)
export rec Multiply(dst: i64, left: i64, right: i64)
export rec Divide(dst: i64, left: i64, right: i64)
export rec Remainder(dst: i64, left: i64, right: i64)
export rec BitAnd(dst: i64, left: i64, right: i64)
export rec BitOr(dst: i64, left: i64, right: i64)
export rec ShiftLeft(dst: i64, left: i64, right: i64)
export rec ShiftRight(dst: i64, left: i64, right: i64)
export rec Copy(dst: i64, input: i64)
export rec Integer()
export rec Boolean()
export rec Text()
export let OutputType = Integer | Boolean | Text
export rec OptionalInteger()
export let FormatType = Integer | Boolean | OptionalInteger

export rec Output(input: i64, type: OutputType, stderr: bool)
export rec Return(input: i64)
export rec Call(dst: i64, function: i64, arguments: Array[i64])
export rec MakeArray(dst: i64, inputs: Array[i64])
export rec MakeDict(dst: i64)
export rec CopyDict(dst: i64, input: i64)
export rec DictLength(dst: i64, input: i64)
export rec DictInsert(dst: i64, input: i64, key: i64, value: i64)
export rec DictRead(dst: i64, input: i64, key: i64)
export rec DictGet(dst: i64, input: i64, key: i64)
# Advances an existing loop cursor (initially -1); dst reports whether a key exists.
export rec DictNext(dst: i64, input: i64, cursor: i64)
export rec DictKey(dst: i64, input: i64, cursor: i64)
export rec CopyArray(dst: i64, input: i64)
export rec ArrayLength(dst: i64, input: i64)
export rec ArrayRead(dst: i64, input: i64, index: i64)
export rec ArrayGet(dst: i64, input: i64, index: i64)
export rec ArrayAppend(dst: i64, input: i64, item: i64)
export rec ArraySet(input: i64, index: i64, item: i64)
export rec MakeRecord(dst: i64, type: i64, inputs: Array[i64])
export rec CopyRecord(dst: i64, input: i64)
export rec ReadField(dst: i64, input: i64, index: i64)
# Mutate an owned record slot; earlier copies own independent struct values.
export rec SetField(record: i64, index: i64, input: i64)
export rec Compare(dst: i64, left: i64, right: i64, op: string)
# Structural equality of owned, descriptor-typed values (without consuming them).
export rec ValueCompare(dst: i64, left: i64, right: i64, op: string)
export rec Branch(input: i64, target: i64)
# Copy the left value on both edges; skip the right operand when it decides.
export rec ShortCircuit(dst: i64, input: i64, target: i64, when_true: bool)
export rec Jump(target: i64)
export rec Nop()
export rec StringConstant(dst: i64, value: string)
export rec StringCopy(dst: i64, input: i64)
export rec StringConcat(dst: i64, left: i64, right: i64)
export rec StringLength(dst: i64, input: i64)
export rec StringCompare(dst: i64, left: i64, right: i64, op: string)
export rec StringSlice(dst: i64, input: i64, start: i64, end: i64)
export rec StringStarts(dst: i64, left: i64, right: i64)
export rec StringEnds(dst: i64, left: i64, right: i64)
export rec StringFormat(dst: i64, input: i64, type: FormatType)
export rec StringByteAt(dst: i64, left: i64, right: i64)
export rec StringFind(dst: i64, left: i64, right: i64)
export rec StringJoin(dst: i64, separator: i64, parts: i64)
export rec MakeOptional(dst: i64, input: i64) # input = -1 for None
export rec OptionalCopy(dst: i64, input: i64)
export rec OptionalUnwrap(dst: i64, input: i64)
# Initializes the payload destination on both edges; only a present value skips fallback.
export rec OptionalDefault(dst: i64, input: i64, target: i64)
export let Instruction = EnumConstant | EnumIndex | MakeUnion | CopyUnion | RewrapValue | UnionIndex | TagTest | TagAny | UnionField | UnionFields | Trap | MakeDict | CopyDict | DictLength | DictInsert | DictRead | DictGet | DictNext | DictKey | MakeArray | CopyArray | ArrayLength | ArrayRead | ArrayGet | ArrayAppend | ArraySet | MakeRecord | CopyRecord | ReadField | SetField | Constant | Negate | Not | Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | Copy | Output | Return | Call | Compare | ValueCompare | Branch | ShortCircuit | Jump | Nop | StringConstant | StringCopy | StringConcat | StringLength | StringCompare | StringSlice | StringStarts | StringEnds | StringFormat | StringByteAt | StringFind | StringJoin | MakeOptional | OptionalCopy | OptionalDefault | OptionalUnwrap
export rec Program(instructions: Array[Instruction], slots: i64, error: string, line: i64)
export rec Function(name: string, body: Program, parameters: Array[i64], result: i64, types: Array[i64])
export rec Module(functions: Array[Function], entry: i64, type_table: TypeTable, error: string, line: i64)

export def function_has_strings(function: Function) -> bool
	for type in function.types
		if type == TYPE_STRING
			return true
	return has_strings(function.body)

export def function_has_optionals(function: Function, table: TypeTable) -> bool
	for type in function.types
		if is_optional(table, type)
			return true
	return has_optionals(function.body)

export def has_strings(program: Program) -> bool
	# Verified string inputs originate in literals or formatting.
	for instruction in program.instructions
		if Instruction.index(instruction) == Instruction.index(StringConstant) or Instruction.index(instruction) == Instruction.index(StringFormat)
			return true
	return false

export def has_optionals(program: Program) -> bool
	for instruction in program.instructions
		if Instruction.index(instruction) == Instruction.index(StringByteAt) or Instruction.index(instruction) == Instruction.index(StringFind) or Instruction.index(instruction) == Instruction.index(DictGet) or Instruction.index(instruction) == Instruction.index(ArrayGet)
			return true
	return false

enum StorageKind
	Uninitialized
	Scalar
	StringReference
	OptionalValue
	RecordValue
	UnionValue
	ArrayReference
	DictionaryReference

rec Flow(dst: i64, inputs: Array[i64], types: Array[i64], next: i64, other: i64, type: i64)

def storage(table: TypeTable, type: i64) -> StorageKind
	if type == TYPE_STRING
		return StringReference()
	if is_optional(table, type)
		return OptionalValue()
	if is_record(table, type)
		return RecordValue()
	if is_union(table, type)
		return UnionValue()
	if is_array(table, type)
		return ArrayReference()
	if is_dict(table, type)
		return DictionaryReference()
	return Scalar()

def in_bounds(slot: i64, count: i64) -> bool
	return slot >= 0 and slot < count

def initialized(facts: Array[i64], slot: i64) -> bool
	return (facts[!(slot / INTEGER_BITS)] & (1 << (slot % INTEGER_BITS))) != 0

# Reachable predecessors contribute definite initialization by intersection.
# A worklist revisits joins when a loop or a later predecessor removes a fact.
export def verify(program: Program) -> string
	return verify_body(program, [], [], TYPE_I64, [], runtime_types())

def verify_body(program: Program, types: Array[i64], parameters: Array[i64], result: i64, functions: Array[Function], table: TypeTable) -> string
	if program.error != ""
		return program.error
	if program.slots < 0
		return "negative slot count"
	let count = len(program.instructions)
	if count == 0
		return "missing return"
	var flows = Array[Flow]()
	var returned = false
	var has_control = false
	let integer = TYPE_I64
	let boolean = TYPE_BOOL
	let text = TYPE_STRING
	let optional = find_optional(table, TYPE_I64)
	let typed = len(types) != 0
	for i in 0..count
		var dst = -1
		var first = -1
		var second = -1
		var third = -1
		var next = i + 1
		var other = -1
		var writes = false
		var strings = 0
		var optionals = 0
		var inputs = Array[i64]()
		var input_types = Array[i64]()
		var output_type = integer
		let instruction = program.instructions[!i]
		match instruction
			MakeDict(target)
				if not typed or not in_bounds(target, program.slots) or not is_dict(table, types[!target]) or not runtime_type(table, types[!target])
					return "invalid dictionary type"
				dst = target
				writes = true
				output_type = types[!target]
			CopyDict(target, input)
				if not typed or not in_bounds(input, program.slots) or not in_bounds(target, program.slots) or not is_dict(table, types[!target])
					return "dictionary copy requires dictionary"
				dst = target
				writes = true
				output_type = types[!target]
				inputs = [input]
				input_types = [output_type]
			DictLength(target, input)
				if not typed or not in_bounds(input, program.slots) or not is_dict(table, types[!input])
					return "dictionary length requires dictionary"
				dst = target
				writes = true
				inputs = [input]
				input_types = [types[!input]]
			DictInsert(target, input, key, value)
				if not typed or not in_bounds(input, program.slots) or not is_dict(table, types[!input]) or not in_bounds(key, program.slots) or not in_bounds(value, program.slots)
					return "dictionary insert requires dictionary"
				dst = target
				writes = true
				output_type = types[!input]
				inputs = [input, key, value]
				input_types = [types[!input], dict_key(table, types[!input]), dict_value(table, types[!input])]
			DictGet(target, input, key)
				if not typed or not in_bounds(input, program.slots) or not is_dict(table, types[!input]) or not in_bounds(key, program.slots)
					return "dictionary get requires dictionary"
				dst = target
				writes = true
				output_type = find_optional(table, dict_value(table, types[!input]))
				if output_type == NO_TYPE
					return "missing optional dictionary value type"
				inputs = [input, key]
				input_types = [types[!input], dict_key(table, types[!input])]
			DictNext(target, input, cursor)
				if not typed or not in_bounds(input, program.slots) or not is_dict(table, types[!input]) or not in_bounds(cursor, program.slots) or cursor == target
					return "invalid dictionary iteration"
				dst = target
				writes = true
				output_type = TYPE_BOOL
				inputs = [input, cursor]
				input_types = [types[!input], TYPE_I64]
			DictKey(target, input, cursor)
				if not typed or not in_bounds(input, program.slots) or not is_dict(table, types[!input]) or not in_bounds(cursor, program.slots)
					return "invalid dictionary key iteration"
				dst = target
				writes = true
				output_type = dict_key(table, types[!input])
				inputs = [input, cursor]
				input_types = [types[!input], TYPE_I64]
			DictRead(target, input, key)
				if not typed or not in_bounds(input, program.slots) or not is_dict(table, types[!input]) or not in_bounds(key, program.slots)
					return "dictionary read requires dictionary"
				dst = target
				writes = true
				output_type = dict_value(table, types[!input])
				inputs = [input, key]
				input_types = [types[!input], dict_key(table, types[!input])]
			MakeArray(target, fields)
				if not in_bounds(target, program.slots)
					return "invalid destination slot"
				if not typed or not is_array(table, types[!target]) or not runtime_type(table, types[!target])
					return "invalid array type"
				dst = target
				writes = true
				output_type = types[!target]
				inputs = fields
				for input in fields
					if not in_bounds(input, program.slots)
						return "undefined input slot"
					input_types = input_types.append(array_element(table, output_type))
			CopyArray(target, input)
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not typed or not in_bounds(target, program.slots) or not is_array(table, types[!target])
					return "array copy requires array"
				dst = target
				writes = true
				output_type = types[!target]
				inputs = [input]
				input_types = [types[!target]]
			ArrayLength(target, input)
				if not typed or not in_bounds(input, program.slots) or not is_array(table, types[!input])
					return "array length requires array"
				dst = target
				writes = true
				inputs = [input]
				input_types = [types[!input]]
			ArrayGet(target, input, index)
				if not typed or not in_bounds(input, program.slots) or not is_array(table, types[!input]) or not in_bounds(index, program.slots)
					return "optional array read requires array"
				dst = target
				writes = true
				output_type = find_optional(table, array_element(table, types[!input]))
				if output_type == NO_TYPE
					return "missing optional array element type"
				inputs = [input, index]
				input_types = [types[!input], TYPE_I64]
			ArrayRead(target, input, index)
				if not in_bounds(index, program.slots)
					return "undefined input slot"
				if not typed or not in_bounds(input, program.slots) or not is_array(table, types[!input])
					return "array read requires array"
				dst = target
				writes = true
				inputs = [input, index]
				input_types = [types[!input], TYPE_I64]
				output_type = array_element(table, types[!input])
			ArrayAppend(target, input, item)
				if not in_bounds(item, program.slots)
					return "undefined input slot"
				if not typed or not in_bounds(input, program.slots) or not is_array(table, types[!input])
					return "array append requires array"
				dst = target
				writes = true
				output_type = types[!input]
				inputs = [input, item]
				input_types = [types[!input], array_element(table, types[!input])]
			ArraySet(input, index, item)
				if not in_bounds(index, program.slots) or not in_bounds(item, program.slots)
					return "undefined input slot"
				if not typed or not in_bounds(input, program.slots) or not is_array(table, types[!input])
					return "array set requires array"
				inputs = [input, index, item]
				input_types = [types[!input], TYPE_I64, array_element(table, types[!input])]
			MakeRecord(target, type, fields)
				if not typed or not is_record(table, type) or not runtime_type(table, type)
					return "invalid record type"
				let descriptor = table.entries[!type]
				if len(fields) != len(descriptor.fields)
					return "record field count mismatch"
				dst = target
				writes = true
				output_type = type
				inputs = fields
				for field in descriptor.fields
					input_types = input_types.append(field.type)
				for input in inputs
					if not in_bounds(input, program.slots)
						return "undefined input slot"
			CopyRecord(target, input)
				if not in_bounds(target, program.slots)
					return "invalid destination slot"
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not typed or not is_record(table, types[!target]) or not is_record(table, types[!input])
					return "record copy requires records"
				dst = target
				writes = true
				output_type = types[!target]
				inputs = [input]
				input_types = [types[!target]]
			ReadField(target, input, index)
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not typed or not is_record(table, types[!input])
					return "field read requires record"
				let fields = table.entries[!types[!input]].fields
				if not in_bounds(index, len(fields))
					return "invalid record field index"
				dst = target
				writes = true
				output_type = fields[!index].type
				inputs = [input]
				input_types = [types[!input]]
			SetField(record, index, input)
				if not in_bounds(record, program.slots) or not in_bounds(input, program.slots)
					return "undefined input slot"
				if not typed or not is_record(table, types[!record])
					return "field update requires record"
				let fields = table.entries[!types[!record]].fields
				if not in_bounds(index, len(fields))
					return "invalid record field index"
				inputs = [record, input]
				input_types = [types[!record], fields[!index].type]
			Call(target, function, arguments)
				if not in_bounds(function, len(functions))
					return "invalid call target"
				let callee = functions[!function]
				if len(arguments) != len(callee.parameters)
					return "argument count mismatch"
				dst = target
				writes = true
				output_type = callee.result
				inputs = arguments
				input_types = callee.parameters
				for input in inputs
					if not in_bounds(input, program.slots)
						return "undefined input slot"
			StringFormat(target, input, type)
				dst = target
				first = input
				writes = true
				output_type = text
				if type == FormatType.OptionalInteger(OptionalInteger())
					optionals = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			(StringByteAt | StringFind)(target, left, right)
				dst = target
				first = left
				second = right
				writes = true
				output_type = optional
				strings = FIRST_INPUT_MASK
				if Instruction.index(instruction) == Instruction.index(StringFind)
					strings = FIRST_TWO_INPUTS_MASK
				if not in_bounds(left, program.slots) or not in_bounds(right, program.slots)
					return "undefined input slot"
			MakeOptional(target, input)
				if not typed or not in_bounds(target, program.slots) or not is_optional(table, types[!target])
					return "optional constructor requires optional destination"
				if input < -1 or input >= program.slots
					return "invalid optional payload slot"
				dst = target
				writes = true
				output_type = types[!target]
				if input >= 0
					inputs = [input]
					input_types = [optional_payload(table, output_type)]
			(OptionalCopy | OptionalUnwrap)(target, input)
				dst = target
				first = input
				writes = true
				output_type = optional
				if Instruction.index(instruction) == Instruction.index(OptionalUnwrap)
					output_type = integer
				optionals = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			OptionalDefault(target_slot, input, target)
				has_control = true
				dst = target_slot
				writes = true
				first = input
				other = target
				optionals = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not in_bounds(target, count)
					return "invalid jump target"
			StringJoin(target, separator, parts)
				if not typed or not in_bounds(separator, program.slots) or not in_bounds(parts, program.slots) or not is_array(table, types[!parts]) or array_element(table, types[!parts]) != text
					return "join requires Array[string]"
				dst = target
				writes = true
				output_type = text
				inputs = [separator, parts]
				input_types = [text, types[!parts]]
			StringSlice(target, input, start, end)
				dst = target
				first = input
				second = start
				third = end
				writes = true
				output_type = text
				strings = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots) or not in_bounds(start, program.slots) or not in_bounds(end, program.slots)
					return "undefined input slot"
			StringConstant(target, value)
				dst = target
				writes = true
				output_type = text
			EnumConstant(target, tag)
				if not typed or not in_bounds(target, program.slots) or not is_enum(table, types[!target]) or tag < 0 or tag >= len(table.entries[!types[!target]].fields)
					return "invalid enum tag"
				dst = target
				writes = true
				output_type = types[!target]
			MakeUnion(target, input, tag)
				if not typed or not in_bounds(target, program.slots) or not in_bounds(input, program.slots) or not is_union(table, types[!target]) or union_payload(table, types[!target], tag) == NO_TYPE
					return "invalid union construction"
				dst = target
				writes = true
				output_type = types[!target]
				inputs = [input]
				input_types = [union_payload(table, output_type, tag)]
			RewrapValue(target, input)
				if not typed or not in_bounds(target, program.slots) or not in_bounds(input, program.slots)
					return "invalid rewrap slots"
				if types[!target] == types[!input] or not can_rewrap(table, types[!input], types[!target])
					return "invalid value rewrap"
				dst = target
				writes = true
				output_type = types[!target]
				inputs = [input]
				input_types = [types[!input]]
			CopyUnion(target, input)
				if not typed or not in_bounds(target, program.slots) or not in_bounds(input, program.slots) or not is_union(table, types[!target])
					return "union copy requires union"
				dst = target
				writes = true
				output_type = types[!target]
				inputs = [input]
				input_types = [output_type]
			TagTest(target, input, tag)
				if not typed or not in_bounds(input, program.slots) or (not is_union(table, types[!input]) and not is_enum(table, types[!input])) or tag < 0 or tag >= len(table.entries[!types[!input]].fields)
					return "invalid match tag test"
				dst = target
				writes = true
				output_type = TYPE_BOOL
				inputs = [input]
				input_types = [types[!input]]
			UnionField(target, input, tag, field)
				if not typed or not in_bounds(input, program.slots) or not is_union(table, types[!input]) or union_payload(table, types[!input], tag) == NO_TYPE
					return "invalid union payload read"
				let payload = union_payload(table, types[!input], tag)
				if field < 0 or field >= len(table.entries[!payload].fields)
					return "invalid union payload field"
				dst = target
				writes = true
				output_type = table.entries[!payload].fields[!field].type
				inputs = [input]
				input_types = [types[!input]]
			TagAny(target, input, tags)
				if not typed or not in_bounds(input, program.slots) or (not is_union(table, types[!input]) and not is_enum(table, types[!input])) or len(tags) == 0
					return "invalid grouped match tag test"
				for j in 0..len(tags)
					let tag = tags[!j]
					if tag < 0 or tag >= len(table.entries[!types[!input]].fields)
						return "invalid grouped match tag"
					for earlier in 0..j
						if tags[!earlier] == tag
							return "duplicate grouped match tag"
				dst = target
				writes = true
				output_type = TYPE_BOOL
				inputs = [input]
				input_types = [types[!input]]
			UnionFields(target, input, tags, fields)
				if not typed or not in_bounds(input, program.slots) or not is_union(table, types[!input]) or len(tags) == 0 or len(tags) != len(fields)
					return "invalid grouped match payload read"
				output_type = NO_TYPE
				for j in 0..len(tags)
					let tag = tags[!j]
					let payload = union_payload(table, types[!input], tag)
					if payload == NO_TYPE or fields[!j] < 0 or fields[!j] >= len(table.entries[!payload].fields)
						return "invalid grouped match payload field"
					for earlier in 0..j
						if tags[!earlier] == tag
							return "duplicate grouped match tag"
					let field_type = table.entries[!payload].fields[!fields[!j]].type
					if output_type != NO_TYPE and output_type != field_type
						return "grouped match payload type mismatch"
					output_type = field_type
				dst = target
				writes = true
				inputs = [input]
				input_types = [types[!input]]
			UnionIndex(target, input)
				if not typed or not in_bounds(input, program.slots) or not is_union(table, types[!input])
					return "union index requires union"
				dst = target
				writes = true
				output_type = integer
				inputs = [input]
				input_types = [types[!input]]
			EnumIndex(target, input)
				if not typed or not in_bounds(input, program.slots) or not is_enum(table, types[!input])
					return "enum index requires enum"
				dst = target
				writes = true
				output_type = integer
				inputs = [input]
				input_types = [types[!input]]
			Constant(target, value)
				dst = target
				writes = true
			(Negate | Not | Copy | StringCopy | StringLength)(target, input)
				dst = target
				first = input
				writes = true
				if Instruction.index(instruction) == Instruction.index(StringCopy)
					output_type = text
					strings = FIRST_INPUT_MASK
				elif Instruction.index(instruction) == Instruction.index(StringLength)
					strings = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			(Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | StringConcat | StringStarts | StringEnds)(target, left, right)
				dst = target
				first = left
				second = right
				writes = true
				if Instruction.index(instruction) == Instruction.index(StringConcat)
					output_type = text
					strings = FIRST_TWO_INPUTS_MASK
				elif Instruction.index(instruction) == Instruction.index(StringStarts) or Instruction.index(instruction) == Instruction.index(StringEnds)
					strings = FIRST_TWO_INPUTS_MASK
				if not in_bounds(left, program.slots) or not in_bounds(right, program.slots)
					return "undefined input slot"
			(Compare | StringCompare | ValueCompare)(target, left, right, op)
				dst = target
				first = left
				second = right
				writes = true
				if Instruction.index(instruction) == Instruction.index(StringCompare)
					strings = FIRST_TWO_INPUTS_MASK
				if not in_bounds(left, program.slots) or not in_bounds(right, program.slots)
					return "undefined input slot"
				if Instruction.index(instruction) == Instruction.index(ValueCompare)
					if not typed or types[!left] != types[!right] or (not is_record(table, types[!left]) and not is_union(table, types[!left]) and not is_optional(table, types[!left]))
						return "invalid structural comparison"
					if op != "==" and op != "!="
						return "invalid structural comparison operator"
				if op != "==" and op != "!=" and op != "<" and op != "<=" and op != ">" and op != ">="
					return "invalid comparison"
			Output(input, type, stderr)
				first = input
				if type == OutputType.Text(Text())
					strings = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			Return(input)
				first = input
				next = -1
				returned = true
				if result == text
					strings = FIRST_INPUT_MASK
				elif result == optional
					optionals = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			Branch(input, target)
				has_control = true
				first = input
				other = target
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not in_bounds(target, count)
					return "invalid jump target"
			ShortCircuit(target_slot, input, target, when_true)
				has_control = true
				dst = target_slot
				writes = true
				first = input
				other = target
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not in_bounds(target, count)
					return "invalid jump target"
			Jump(target)
				has_control = true
				next = target
				if not in_bounds(target, count)
					return "invalid jump target"
			Trap
				next = -1
				returned = true
			Nop
				next = i + 1
		if writes and not in_bounds(dst, program.slots)
			return "invalid destination slot"
		for operand in 0..FIXED_INPUT_COUNT
			let input = [first, second, third][!operand]
			if input < 0
				continue
			var type = integer
			if (strings & (1 << operand)) != 0
				type = text
			elif (optionals & (1 << operand)) != 0
				type = optional
			inputs = inputs.append(input)
			input_types = input_types.append(type)
		# Preserve bool/i64 distinctions in typed functions; legacy Program tests
		# retain their storage-only contract.
		match instruction
			Constant(target, value)
				if typed
					output_type = types[!target]
					if output_type != integer and output_type != boolean
						return "slot type mismatch"
					if output_type == boolean and value != 0 and value != 1
						return "invalid boolean constant"
			Copy(target, input)
				if typed
					output_type = types[!target]
					if output_type != integer and output_type != boolean and not is_enum(table, output_type)
						return "slot type mismatch"
					input_types[!0] = output_type
			OptionalCopy(target, input)
				if typed
					output_type = types[!input]
					if not is_optional(table, output_type)
						return "optional copy requires optional"
					input_types[!0] = output_type
			OptionalUnwrap(target, input)
				if typed
					let input_type = types[!input]
					if not is_optional(table, input_type)
						return "optional unwrap requires optional"
					input_types[!0] = input_type
					output_type = optional_payload(table, input_type)
			OptionalDefault(target, input, branch)
				if typed
					let input_type = types[!input]
					if not is_optional(table, input_type)
						return "optional default requires optional"
					input_types[!0] = input_type
					output_type = optional_payload(table, input_type)
			Not
				output_type = boolean
				input_types[!0] = boolean
			(Compare | ValueCompare)(target, left, right, op)
				output_type = boolean
				if typed and (Instruction.index(instruction) == Instruction.index(ValueCompare) or ((types[!left] == boolean or is_enum(table, types[!left])) and (op == "==" or op == "!=")))
					input_types = [types[!left], types[!left]]
			StringCompare | StringStarts | StringEnds
				output_type = boolean
			Branch
				input_types[!0] = boolean
			ShortCircuit
				output_type = boolean
				input_types[!0] = boolean
			Return
				input_types[!0] = result
			Output(input, type, stderr)
				if type == OutputType.Boolean(Boolean())
					input_types[!0] = boolean
			StringFormat(target, input, type)
				if type == FormatType.Boolean(Boolean())
					input_types[!0] = boolean
			EnumConstant | EnumIndex | MakeUnion | CopyUnion | RewrapValue | UnionIndex | TagTest | TagAny | UnionField | UnionFields | Trap | MakeOptional | MakeDict | CopyDict | DictLength | DictInsert | DictRead | DictGet | DictNext | DictKey | MakeArray | CopyArray | ArrayLength | ArrayRead | ArrayGet | ArrayAppend | ArraySet | MakeRecord | CopyRecord | ReadField | SetField | Call | Negate | Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | Jump | Nop | StringConstant | StringCopy | StringConcat | StringLength | StringSlice | StringByteAt | StringFind | StringJoin
				if not runtime_type(table, output_type)
					return "invalid instruction type"
		if typed
			if dst >= 0 and types[!dst] != output_type
				return "slot type mismatch"
			for operand in 0..len(inputs)
				if types[!inputs[!operand]] != input_types[!operand]
					return "slot type mismatch"
		flows = flows.append(Flow(dst, inputs, input_types, next, other, output_type))
	if not returned
		return "missing return"
	# Each slot has one storage kind, independent of control-flow reachability.
	let uninitialized: StorageKind = Uninitialized()
	var kinds = Array[StorageKind]()
	for i in 0..program.slots
		kinds = kinds.append(uninitialized)
	for i in 0..len(parameters)
		kinds[!i] = storage(table, parameters[!i])
	for flow in flows
		if flow.dst >= 0
			if kinds[!flow.dst] != uninitialized and kinds[!flow.dst] != storage(table, flow.type)
				return "slot type mismatch"
			kinds[!flow.dst] = storage(table, flow.type)
	for flow in flows
		for operand in 0..len(flow.inputs)
			let input = flow.inputs[!operand]
			let expected = storage(table, flow.types[!operand])
			if kinds[!input] == uninitialized
				return "undefined input slot"
			if kinds[!input] != expected
				return "slot type mismatch"
	# One word holds 64 facts, including bit 63 in the signed i64 sign bit.
	var words = program.slots / INTEGER_BITS
	if program.slots % INTEGER_BITS != 0
		words += 1
	var blank = Array[i64]()
	for i in 0..words
		blank = blank.append(0)
	for i in 0..len(parameters)
		blank[!(i / INTEGER_BITS)] = blank[!(i / INTEGER_BITS)] | (1 << (i % INTEGER_BITS))
	# Straight-line code has one predecessor per instruction; no matrix needed.
	if not has_control
		var finished = false
		for flow in flows
			if finished
				return "unreachable instruction"
			for input in flow.inputs
				if input >= 0 and not initialized(blank, input)
					return "undefined input slot"
			if flow.dst >= 0
				let word = flow.dst / INTEGER_BITS
				blank[!word] = blank[!word] | (1 << (flow.dst % INTEGER_BITS))
			finished = flow.next < 0
		return ""
	var incoming = Array[Array[i64]]()
	var reached = Array[bool]()
	for i in 0..count
		incoming = incoming.append(blank)
		reached = reached.append(false)
	reached[!0] = true
	var queue = [0]
	var cursor = 0
	while cursor < len(queue)
		let index = queue[!cursor]
		cursor += 1
		let flow = flows[!index]
		var outgoing = incoming[!index]
		if flow.dst >= 0
			let word = flow.dst / INTEGER_BITS
			outgoing[!word] = outgoing[!word] | (1 << (flow.dst % INTEGER_BITS))
		for successor in [flow.next, flow.other]
			if successor < 0
				continue
			if successor >= count
				return "path falls off program"
			var changed = not reached[!successor]
			if changed
				incoming[!successor] = outgoing
				reached[!successor] = true
			else
				var merged = incoming[!successor]
				for word in 0..words
					let common = merged[!word] & outgoing[!word]
					if common != merged[!word]
						merged[!word] = common
						changed = true
				incoming[!successor] = merged
			if changed
				queue = queue.append(successor)
	for i in 0..count
		if not reached[!i]
			return "unreachable instruction"
		let flow = flows[!i]
		for input in flow.inputs
			if input >= 0 and not initialized(incoming[!i], input)
				return "undefined input slot"
	return ""

# Remove unreachable structural markers after early exits, remapping targets.
export def prune(program: Program) -> Program
	if program.error != ""
		return program
	let count = len(program.instructions)
	var reached = Array[bool]()
	var ids = Array[i64]()
	for i in 0..count
		reached = reached.append(false)
		ids = ids.append(-1)
	var queue = [0]
	var cursor = 0
	while cursor < len(queue)
		let pc = queue[!cursor]
		cursor += 1
		if pc == count
			continue
		if pc < 0 or pc > count
			return Program([], 0, "invalid jump target", 0)
		if reached[!pc]
			continue
		reached[!pc] = true
		match program.instructions[!pc]
			OptionalDefault(dst, input, target)
				queue = queue.append(target)
				queue = queue.append(pc + 1)
			Jump(target)
				queue = queue.append(target)
			Branch(input, target)
				queue = queue.append(target)
				queue = queue.append(pc + 1)
			ShortCircuit(dst, input, target, when_true)
				queue = queue.append(target)
				queue = queue.append(pc + 1)
			Return | Trap
				continue
			EnumConstant | EnumIndex | MakeUnion | CopyUnion | RewrapValue | UnionIndex | TagTest | TagAny | UnionField | UnionFields | MakeOptional | MakeDict | CopyDict | DictLength | DictInsert | DictRead | DictGet | DictNext | DictKey | MakeArray | CopyArray | ArrayLength | ArrayRead | ArrayGet | ArrayAppend | ArraySet | MakeRecord | CopyRecord | ReadField | SetField | Call | Constant | Negate | Not | Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | Copy | Output | Compare | ValueCompare | Nop | StringConstant | StringCopy | StringConcat | StringLength | StringCompare | StringSlice | StringStarts | StringEnds | StringFormat | StringByteAt | StringFind | StringJoin | OptionalCopy | OptionalUnwrap
				queue = queue.append(pc + 1)
	var size = 0
	for i in 0..count
		if reached[!i]
			ids[!i] = size
			size += 1
	var result = Array[Instruction]()
	for i in 0..count
		if not reached[!i]
			continue
		let instruction = program.instructions[!i]
		match instruction
			OptionalDefault(dst, input, target)
				if target < 0 or target >= count
					return Program([], 0, "invalid jump target", 0)
				result = result.append(OptionalDefault(dst, input, ids[!target]))
			Jump(target)
				if target < 0 or target >= count
					return Program([], 0, "invalid jump target", 0)
				result = result.append(Jump(ids[!target]))
			Branch(input, target)
				if target < 0 or target >= count
					return Program([], 0, "invalid jump target", 0)
				result = result.append(Branch(input, ids[!target]))
			ShortCircuit(dst, input, target, when_true)
				if target < 0 or target >= count
					return Program([], 0, "invalid jump target", 0)
				result = result.append(ShortCircuit(dst, input, ids[!target], when_true))
			EnumConstant | EnumIndex | MakeUnion | CopyUnion | RewrapValue | UnionIndex | TagTest | TagAny | UnionField | UnionFields | Trap | MakeOptional | MakeDict | CopyDict | DictLength | DictInsert | DictRead | DictGet | DictNext | DictKey | MakeArray | CopyArray | ArrayLength | ArrayRead | ArrayGet | ArrayAppend | ArraySet | MakeRecord | CopyRecord | ReadField | SetField | Call | Constant | Negate | Not | Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | Copy | Output | Compare | ValueCompare | Nop | Return | StringConstant | StringCopy | StringConcat | StringLength | StringCompare | StringSlice | StringStarts | StringEnds | StringFormat | StringByteAt | StringFind | StringJoin | OptionalCopy | OptionalUnwrap
				result = result.append(instruction)
	return Program(result, program.slots, "", 0)

export def verify_module(module: Module) -> string
	if module.error != ""
		return module.error
	let type_error = verify_types(module.type_table)
	if type_error != ""
		return type_error
	if not in_bounds(module.entry, len(module.functions))
		return "invalid entry function"
	let entry = module.functions[!module.entry]
	if len(entry.parameters) != 0 or entry.result != TYPE_I64
		return "invalid entry signature"
	# Validate all signatures before inspecting recursive calls.
	for function in module.functions
		if not valid_type(module.type_table, function.result)
			return "invalid result type"
		if not runtime_type(module.type_table, function.result)
			return unsupported_type(module.type_table, function.result)
		if len(function.types) != function.body.slots or len(function.parameters) > function.body.slots
			return "invalid function slots"
		for i in 0..len(function.parameters)
			let type = function.parameters[!i]
			if not valid_type(module.type_table, type) or function.types[!i] != type
				return "invalid parameter type"
			if not runtime_type(module.type_table, type)
				return unsupported_type(module.type_table, type)
		for type in function.types
			if type != NO_TYPE and not valid_type(module.type_table, type)
				return "invalid slot type"
			if type != NO_TYPE and not runtime_type(module.type_table, type)
				return unsupported_type(module.type_table, type)
	for function in module.functions
		let error = verify_body(function.body, function.types, function.parameters, function.result, module.functions, module.type_table)
		if error != ""
			return function.name + ": " + error
	return ""

# Lowering initially uses arena IDs for both slots and instruction positions.
# Convert each function's interval to local IDs before pruning its control flow.
export def rebase(instruction: Instruction, base: i64) -> Instruction
	match instruction
		EnumConstant(dst, tag)
			return EnumConstant(dst - base, tag)
		EnumIndex(dst, input)
			return EnumIndex(dst - base, input - base)
		MakeUnion(dst, input, tag)
			return MakeUnion(dst - base, input - base, tag)
		CopyUnion(dst, input)
			return CopyUnion(dst - base, input - base)
		RewrapValue(dst, input)
			return RewrapValue(dst - base, input - base)
		UnionIndex(dst, input)
			return UnionIndex(dst - base, input - base)
		TagTest(dst, input, tag)
			return TagTest(dst - base, input - base, tag)
		TagAny(dst, input, tags)
			return TagAny(dst - base, input - base, tags)
		UnionField(dst, input, tag, field)
			return UnionField(dst - base, input - base, tag, field)
		UnionFields(dst, input, tags, fields)
			return UnionFields(dst - base, input - base, tags, fields)
		Trap
			return Trap()
		MakeOptional(dst, input)
			var source = -1
			if input >= 0
				source = input - base
			return MakeOptional(dst - base, source)
		MakeDict(dst)
			return MakeDict(dst - base)
		CopyDict(dst, input)
			return CopyDict(dst - base, input - base)
		DictLength(dst, input)
			return DictLength(dst - base, input - base)
		DictInsert(dst, input, key, value)
			return DictInsert(dst - base, input - base, key - base, value - base)
		DictRead(dst, input, key)
			return DictRead(dst - base, input - base, key - base)
		DictGet(dst, input, key)
			return DictGet(dst - base, input - base, key - base)
		DictNext(dst, input, cursor)
			return DictNext(dst - base, input - base, cursor - base)
		DictKey(dst, input, cursor)
			return DictKey(dst - base, input - base, cursor - base)
		MakeArray(dst, inputs)
			var fields = Array[i64]()
			for input in inputs
				fields = fields.append(input - base)
			return MakeArray(dst - base, fields)
		CopyArray(dst, input)
			return CopyArray(dst - base, input - base)
		ArrayLength(dst, input)
			return ArrayLength(dst - base, input - base)
		ArrayRead(dst, input, index)
			return ArrayRead(dst - base, input - base, index - base)
		ArrayGet(dst, input, index)
			return ArrayGet(dst - base, input - base, index - base)
		ArrayAppend(dst, input, item)
			return ArrayAppend(dst - base, input - base, item - base)
		ArraySet(input, index, item)
			return ArraySet(input - base, index - base, item - base)
		MakeRecord(dst, type, inputs)
			var fields = Array[i64]()
			for input in inputs
				fields = fields.append(input - base)
			return MakeRecord(dst - base, type, fields)
		CopyRecord(dst, input)
			return CopyRecord(dst - base, input - base)
		ReadField(dst, input, index)
			return ReadField(dst - base, input - base, index)
		SetField(record, index, input)
			return SetField(record - base, index, input - base)
		Call(dst, function, arguments)
			var inputs = Array[i64]()
			for input in arguments
				inputs = inputs.append(input - base)
			return Call(dst - base, function, inputs)
		Constant(dst, value)
			return Constant(dst - base, value)
		StringConstant(dst, value)
			return StringConstant(dst - base, value)
		Negate(dst, input)
			return Negate(dst - base, input - base)
		Not(dst, input)
			return Not(dst - base, input - base)
		Copy(dst, input)
			return Copy(dst - base, input - base)
		StringCopy(dst, input)
			return StringCopy(dst - base, input - base)
		OptionalCopy(dst, input)
			return OptionalCopy(dst - base, input - base)
		OptionalUnwrap(dst, input)
			return OptionalUnwrap(dst - base, input - base)
		StringLength(dst, input)
			return StringLength(dst - base, input - base)
		Add(dst, left, right)
			return Add(dst - base, left - base, right - base)
		Subtract(dst, left, right)
			return Subtract(dst - base, left - base, right - base)
		Multiply(dst, left, right)
			return Multiply(dst - base, left - base, right - base)
		Divide(dst, left, right)
			return Divide(dst - base, left - base, right - base)
		Remainder(dst, left, right)
			return Remainder(dst - base, left - base, right - base)
		BitAnd(dst, left, right)
			return BitAnd(dst - base, left - base, right - base)
		BitOr(dst, left, right)
			return BitOr(dst - base, left - base, right - base)
		ShiftLeft(dst, left, right)
			return ShiftLeft(dst - base, left - base, right - base)
		ShiftRight(dst, left, right)
			return ShiftRight(dst - base, left - base, right - base)
		StringConcat(dst, left, right)
			return StringConcat(dst - base, left - base, right - base)
		StringStarts(dst, left, right)
			return StringStarts(dst - base, left - base, right - base)
		StringEnds(dst, left, right)
			return StringEnds(dst - base, left - base, right - base)
		StringByteAt(dst, left, right)
			return StringByteAt(dst - base, left - base, right - base)
		StringFind(dst, left, right)
			return StringFind(dst - base, left - base, right - base)
		StringJoin(dst, separator, parts)
			return StringJoin(dst - base, separator - base, parts - base)
		Compare(dst, left, right, op)
			return Compare(dst - base, left - base, right - base, op)
		ValueCompare(dst, left, right, op)
			return ValueCompare(dst - base, left - base, right - base, op)
		StringCompare(dst, left, right, op)
			return StringCompare(dst - base, left - base, right - base, op)
		StringSlice(dst, input, start, end)
			return StringSlice(dst - base, input - base, start - base, end - base)
		StringFormat(dst, input, type)
			return StringFormat(dst - base, input - base, type)
		Output(input, type, stderr)
			return Output(input - base, type, stderr)
		Return(input)
			return Return(input - base)
		Branch(input, target)
			return Branch(input - base, target - base)
		Jump(target)
			return Jump(target - base)
		ShortCircuit(dst, input, target, when_true)
			return ShortCircuit(dst - base, input - base, target - base, when_true)
		OptionalDefault(dst, input, target)
			return OptionalDefault(dst - base, input - base, target - base)
		Nop
			return Nop()
