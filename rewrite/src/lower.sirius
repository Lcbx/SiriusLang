import parser alias Parser
import lexer alias Lex
import semantic alias Semantic
import ir alias IR
import modules alias Modules

let DECIMAL_RADIX = 10
let I64_MAX_DECIMAL_PREFIX = 922337203685477580
let I64_MAX_DECIMAL_LAST_DIGIT = 7

rec Decoded(value: string, error: string)
rec ExportedType(name: string, type: i64)
rec ExportedConstructor(name: string, constructor: Semantic.Constructor)

def decode(source: string, begin: i64, end: i64, interpolated: bool) -> Decoded
	var parts = Array[string]()
	var start = begin
	var i = start
	while i < end
		if (source.byte_at(i) or 0) != Lex.ASCII_BACKSLASH
			i += 1
			continue
		parts = parts.append(source.slice(start, i))
		i += 1
		let escaped = source.byte_at(i) or 0
		var value = ""
		if escaped == Lex.ASCII_LOWER_N
			value = "\n"
		elif escaped == Lex.ASCII_LOWER_T
			value = "\t"
		elif escaped == Lex.ASCII_LOWER_R
			value = "\r"
		elif escaped == Lex.ASCII_ZERO
			value = "\0"
		elif escaped == Lex.ASCII_BACKSLASH or escaped == Lex.ASCII_DOUBLE_QUOTE or escaped == Lex.ASCII_SINGLE_QUOTE
			value = source.slice(i, i + 1)
		elif interpolated and escaped == Lex.ASCII_DOLLAR and (source.byte_at(i + 1) or 0) == Lex.ASCII_OPEN_BRACE
			value = "$"
		else
			return Decoded("", "unsupported string escape")
		parts = parts.append(value)
		i += 1
		start = i
	parts = parts.append(source.slice(start, end))
	return Decoded("".join(parts), "")

def copy(dst: i64, input: i64, type: i64, table: IR.TypeTable) -> IR.Instruction
	if IR.is_dict(table, type)
		return IR.CopyDict(dst, input)
	if IR.is_array(table, type)
		return IR.CopyArray(dst, input)
	if IR.is_record(table, type)
		return IR.CopyRecord(dst, input)
	if IR.is_union(table, type)
		return IR.CopyUnion(dst, input)
	if IR.is_optional(table, type)
		return IR.OptionalCopy(dst, input)
	if type == IR.TYPE_STRING
		return IR.StringCopy(dst, input)
	return IR.Copy(dst, input)

# Converted values live in explicit typed slots; their record source retains
# its original type. No implicit conversion ever changes a stored union tag.
def input_slot(id: i64, redirected: Dict[i64, i64]) -> i64
	if id < 0
		return id
	return redirected.get(id) or id

def lower_function(checked: Semantic.Checked, function_id: i64, function_base: i64) -> IR.Program
	let parsed = checked.parsed
	let source = parsed.source
	let function = parsed.functions[!function_id]
	var instructions = Array[IR.Instruction]()
	var redirects = Dict[i64, i64]()
	var extra_types = Array[i64]()
	for id in function.start..function.end
		let conversion = checked.conversions.get(id) or Semantic.Conversion(IR.NO_TYPE, -1)
		if conversion.type != IR.NO_TYPE
			redirects = redirects.insert(id, function.end + len(extra_types))
			extra_types = extra_types.append(conversion.type)
	var starts = Array[i64]()
	for i in function.start..function.end
		starts = starts.append(len(instructions))
		let node = parsed.nodes[!i]
		match node.kind
			Parser.MatchCase
				instructions = instructions.append(IR.Nop())
			Parser.MatchGroup
				let first = parsed.nodes[!node.left]
				if node.left == node.right
					instructions = instructions.append(IR.TagTest(i, first.left, checked.references[!node.left]))
				else
					var tags = Array[i64]()
					for case_id in node.left..node.right + 1
						tags = tags.append(checked.references[!case_id])
					instructions = instructions.append(IR.TagAny(i, first.left, tags))
			Parser.MatchBind
				let group = parsed.nodes[!node.right]
				let first = parsed.nodes[!group.left]
				let fields = checked.match_fields.get(i) or Array[i64]()
				if group.left == group.right
					instructions = instructions.append(IR.UnionField(i, first.left, checked.references[!group.left], fields[!0]))
				else
					var tags = Array[i64]()
					for case_id in group.left..group.right + 1
						tags = tags.append(checked.references[!case_id])
					instructions = instructions.append(IR.UnionFields(i, first.left, tags, fields))
			Parser.MatchFail
				instructions = instructions.append(IR.Trap())
			Parser.MatchEnd
				instructions = instructions.append(IR.Nop())
			Parser.UnionConstruct
				instructions = instructions.append(IR.MakeUnion(i, input_slot(node.left, redirects), checked.references[!i]))
			Parser.EnumConstruct
				instructions = instructions.append(IR.EnumConstant(i, checked.references[!i]))
			Parser.EnumIndex
				var target = IR.NO_TYPE
				if node.left >= 0
					target = checked.types[!node.left]
					let conversion = checked.conversions.get(node.left) or Semantic.Conversion(IR.NO_TYPE, -1)
					if conversion.type != IR.NO_TYPE
						target = conversion.type
				elif checked.references[!i] >= 0
					target = checked.types[!checked.references[!i]]
				if node.left >= 0
					if IR.is_union(checked.type_table, target)
						instructions = instructions.append(IR.UnionIndex(i, input_slot(node.left, redirects)))
					else
						instructions = instructions.append(IR.EnumIndex(i, node.left))
				elif checked.references[!i] >= 0
					if IR.is_union(checked.type_table, target)
						instructions = instructions.append(IR.UnionIndex(i, checked.references[!i]))
					else
						instructions = instructions.append(IR.EnumIndex(i, checked.references[!i]))
				else
					instructions = instructions.append(IR.Constant(i, -checked.references[!i] - 2))
			Parser.Zero
				instructions = instructions.append(IR.Constant(i, 0))
			Parser.ArrayIndex
				let iterable = parsed.nodes[!node.right].left
				if IR.is_dict(checked.type_table, checked.types[!iterable])
					instructions = instructions.append(IR.Constant(i, -1))
				else
					instructions = instructions.append(IR.Copy(i, node.left))
			Parser.ArrayElement
				if IR.is_dict(checked.type_table, checked.types[!node.left])
					instructions = instructions.append(IR.DictKey(i, node.left, node.right))
				else
					instructions = instructions.append(IR.ArrayRead(i, node.left, node.right))
			Parser.DictLiteral
				instructions = instructions.append(IR.MakeDict(i))
			Parser.DictPair
				instructions = instructions.append(IR.Nop())
			Parser.DictGet
				instructions = instructions.append(IR.DictGet(i, node.left, node.right))
			Parser.DictInsert
				let pair = parsed.nodes[!node.right]
				instructions = instructions.append(IR.DictInsert(i, node.left, pair.left, input_slot(pair.right, redirects)))
			Parser.ArrayLiteral
				var reversed = Array[i64]()
				var argument = node.left
				while argument >= 0
					let input = parsed.nodes[!argument]
					reversed = reversed.append(input.left)
					argument = input.right
				var inputs = Array[i64]()
				for index in 0..len(reversed)
					inputs = inputs.append(input_slot(reversed[!len(reversed) - 1 - index], redirects))
				instructions = instructions.append(IR.MakeArray(i, inputs))
			Parser.ArrayRead | Parser.ArrayGet
				var input = node.left
				if Parser.kind_is(parsed.nodes[!input].kind, Parser.ArrayTarget()) or Parser.kind_is(parsed.nodes[!input].kind, Parser.FieldTarget())
					input = checked.references[!input]
				if IR.is_dict(checked.type_table, checked.types[!input])
					if Parser.kind_is(node.kind, Parser.ArrayGet())
						instructions = instructions.append(IR.DictGet(i, input, node.right))
					else
						instructions = instructions.append(IR.DictRead(i, input, node.right))
				elif Parser.kind_is(node.kind, Parser.ArrayGet())
					instructions = instructions.append(IR.ArrayGet(i, input, node.right))
				else
					instructions = instructions.append(IR.ArrayRead(i, input, node.right))
			Parser.ArrayAppend
				instructions = instructions.append(IR.ArrayAppend(i, node.left, input_slot(node.right, redirects)))
			Parser.ArrayTarget
				instructions = instructions.append(IR.Nop())
			Parser.ArraySet
				let target = parsed.nodes[!node.left]
				let index = target.right
				var input = target.left
				if input < 0
					input = checked.references[!node.left]
				elif Parser.kind_is(parsed.nodes[!input].kind, Parser.FieldTarget())
					input = checked.references[!input]
				instructions = instructions.append(IR.ArraySet(input, index, input_slot(node.right, redirects)))
			Parser.FieldRead
				var input = node.left
				if Parser.kind_is(parsed.nodes[!input].kind, Parser.FieldTarget())
					input = checked.references[!input]
				instructions = instructions.append(IR.ReadField(i, input, checked.references[!i]))
			Parser.FieldTarget
				instructions = instructions.append(IR.Nop())
			Parser.FieldAssign
				instructions = instructions.append(IR.SetField(checked.references[!node.left], checked.references[!i], input_slot(node.right, redirects)))
			Parser.ArrayFieldUpdate
				var input = node.left
				if Parser.kind_is(parsed.nodes[!input].kind, Parser.FieldTarget())
					input = checked.references[!input]
				instructions = instructions.append(IR.SetField(input, checked.references[!i], input_slot(node.right, redirects)))
			Parser.Parameter | Parser.Argument
				instructions = instructions.append(IR.Nop())
			Parser.Call
				if IR.is_enum(checked.type_table, checked.types[!i]) and checked.references[!i] < -1
					instructions = instructions.append(IR.EnumConstant(i, -checked.references[!i] - 2))
					continue
				var reversed = Array[i64]()
				var argument = node.left
				while argument >= 0
					let input = parsed.nodes[!argument]
					reversed = reversed.append(input.left)
					argument = input.right
				var arguments = Array[i64]()
				for index in 0..len(reversed)
					arguments = arguments.append(input_slot(reversed[!len(reversed) - 1 - index], redirects))
				let constructor = checked.constructor_calls.get(i) or Semantic.Constructor(IR.NO_TYPE, [])
				if constructor.type != IR.NO_TYPE
					var fields = Array[i64]()
					for field in checked.type_table.entries[!constructor.type].fields
						for parameter in 0..len(constructor.parameters)
							if constructor.parameters[!parameter].name == field.name
								fields = fields.append(arguments[!parameter])
					instructions = instructions.append(IR.MakeRecord(i, constructor.type, fields))
				else
					var target = checked.references[!i]
					if target < len(parsed.functions)
						target += function_base
					else
						target = checked.external_targets[!target - len(parsed.functions)]
					instructions = instructions.append(IR.Call(i, target, arguments))
			Parser.OptionalConstruct
				instructions = instructions.append(IR.MakeOptional(i, input_slot(node.left, redirects)))
			Parser.OptionalUnwrap
				instructions = instructions.append(IR.OptionalUnwrap(i, input_slot(node.left, redirects)))
			Parser.OptionalExit
				instructions = instructions.append(IR.OptionalDefault(i, node.left, node.right))
			Parser.StringByteAt
				instructions = instructions.append(IR.StringByteAt(i, node.left, node.right))
			Parser.StringFind
				instructions = instructions.append(IR.StringFind(i, node.left, node.right))
			Parser.StringJoin
				instructions = instructions.append(IR.StringJoin(i, node.left, node.right))
			Parser.SliceBounds
				instructions = instructions.append(IR.Nop())
			Parser.StringSlice
				let bounds = parsed.nodes[!node.right]
				instructions = instructions.append(IR.StringSlice(i, node.left, bounds.left, bounds.right))
			Parser.StringStarts
				instructions = instructions.append(IR.StringStarts(i, node.left, node.right))
			Parser.StringEnds
				instructions = instructions.append(IR.StringEnds(i, node.left, node.right))
			Parser.StringLiteral | Parser.StringPart
				let token = parsed.tokens[!node.token]
				let part = Parser.kind_is(node.kind, Parser.StringPart())
				var begin = token.start + 1
				var end = token.end - 1
				if part
					begin = node.left
					end = node.right
				let literal = decode(source, begin, end, part)
				if literal.error != ""
					return IR.Program(instructions, 0, literal.error, token.line)
				instructions = instructions.append(IR.StringConstant(i, literal.value))
			Parser.Length
				if IR.is_dict(checked.type_table, checked.types[!node.left])
					instructions = instructions.append(IR.DictLength(i, node.left))
				elif IR.is_array(checked.type_table, checked.types[!node.left])
					instructions = instructions.append(IR.ArrayLength(i, node.left))
				else
					instructions = instructions.append(IR.StringLength(i, node.left))
			Parser.StringConvert
				let type = checked.types[!node.left]
				if type == IR.TYPE_STRING
					instructions = instructions.append(IR.StringCopy(i, node.left))
				else
					var format: IR.FormatType = IR.Integer()
					if type == IR.TYPE_BOOL
						format = IR.FormatType.Boolean(IR.Boolean())
					elif IR.is_optional(checked.type_table, type)
						format = IR.FormatType.OptionalInteger(IR.OptionalInteger())
					instructions = instructions.append(IR.StringFormat(i, node.left, format))
			Parser.RangeBinding
				instructions = instructions.append(IR.Copy(i, node.left))
			Parser.One
				instructions = instructions.append(IR.Constant(i, 1))
			Parser.RangeCompare
				let binding = parsed.nodes[!node.left]
				if Parser.kind_is(binding.kind, Parser.ArrayIndex()) and IR.is_dict(checked.type_table, checked.types[!parsed.nodes[!node.right].left])
					instructions = instructions.append(IR.DictNext(i, parsed.nodes[!node.right].left, node.left))
					continue
				# Match the existing compiler: a bare upper-bound name uses
				# its binding slot, while other expressions retain their value.
				var upper = node.right
				if Parser.kind_is(parsed.nodes[!upper].kind, Parser.Variable())
					upper = checked.references[!upper]
				instructions = instructions.append(IR.Compare(i, node.left, upper, "<"))
			Parser.RangeCondition
				instructions = instructions.append(IR.Branch(node.left, node.right))
			Parser.RangeStep
				let binding = parsed.nodes[!node.left]
				if Parser.kind_is(binding.kind, Parser.ArrayIndex()) and IR.is_dict(checked.type_table, checked.types[!parsed.nodes[!binding.right].left])
					instructions = instructions.append(IR.Nop())
				else
					instructions = instructions.append(IR.Add(node.left, node.left, node.right))
			Parser.AndStart | Parser.OrStart
				if IR.is_optional(checked.type_table, checked.types[!node.left])
					instructions = instructions.append(IR.OptionalDefault(i, node.left, node.right))
				else
					instructions = instructions.append(IR.ShortCircuit(i, node.left, node.right, Parser.kind_is(node.kind, Parser.OrStart())))
			Parser.LogicalEnd
				instructions = instructions.append(copy(node.left, input_slot(node.right, redirects), checked.types[!node.left], checked.type_table))
			Parser.BooleanLiteral
				let token = parsed.tokens[!node.token]
				var value = 0
				if source.slice(token.start, token.end) == "true"
					value = 1
				instructions = instructions.append(IR.Constant(i, value))
			Parser.Compare
				let token = parsed.tokens[!node.token]
				let op = source.slice(token.start, token.end)
				let type = checked.types[!node.left]
				if type == IR.TYPE_STRING
					instructions = instructions.append(IR.StringCompare(i, node.left, node.right, op))
				elif IR.is_record(checked.type_table, type) or IR.is_union(checked.type_table, type) or IR.is_optional(checked.type_table, type)
					instructions = instructions.append(IR.ValueCompare(i, node.left, node.right, op))
				else
					instructions = instructions.append(IR.Compare(i, node.left, node.right, op))
			Parser.If | Parser.While
				instructions = instructions.append(IR.Branch(node.left, node.right))
			Parser.Else | Parser.Break
				instructions = instructions.append(IR.Jump(node.right))
			Parser.EndWhile | Parser.Continue
				instructions = instructions.append(IR.Jump(node.left))
			Parser.LoopStart | Parser.EndIf
				instructions = instructions.append(IR.Nop())
			Parser.IntegerLiteral
				let token = parsed.tokens[!node.token]
				var value = 0
				for offset in token.start..token.end
					let digit = (source.byte_at(offset) or -1) - Lex.ASCII_ZERO
					# Check before multiplying the decimal prefix and adding its final digit.
					if value > I64_MAX_DECIMAL_PREFIX or (value == I64_MAX_DECIMAL_PREFIX and digit > I64_MAX_DECIMAL_LAST_DIGIT)
						return IR.Program(instructions, 0, "integer literal out of range", token.line)
					value = value * DECIMAL_RADIX + digit
				instructions = instructions.append(IR.Constant(i, value))
			Parser.Negate
				instructions = instructions.append(IR.Negate(i, node.left))
			Parser.Not
				instructions = instructions.append(IR.Not(i, node.left))
			Parser.Add
				if checked.types[!i] == IR.TYPE_STRING
					instructions = instructions.append(IR.StringConcat(i, node.left, node.right))
				else
					instructions = instructions.append(IR.Add(i, node.left, node.right))
			Parser.Subtract
				instructions = instructions.append(IR.Subtract(i, node.left, node.right))
			Parser.Multiply
				instructions = instructions.append(IR.Multiply(i, node.left, node.right))
			Parser.Divide
				instructions = instructions.append(IR.Divide(i, node.left, node.right))
			Parser.Remainder
				instructions = instructions.append(IR.Remainder(i, node.left, node.right))
			Parser.BitAnd
				instructions = instructions.append(IR.BitAnd(i, node.left, node.right))
			Parser.BitOr
				instructions = instructions.append(IR.BitOr(i, node.left, node.right))
			Parser.ShiftLeft
				instructions = instructions.append(IR.ShiftLeft(i, node.left, node.right))
			Parser.ShiftRight
				instructions = instructions.append(IR.ShiftRight(i, node.left, node.right))
			Parser.Variable
				instructions = instructions.append(copy(i, checked.references[!i], checked.types[!i], checked.type_table))
			Parser.Binding | Parser.MutableBinding
				instructions = instructions.append(copy(i, input_slot(node.left, redirects), checked.types[!i], checked.type_table))
			Parser.Assign
				instructions = instructions.append(copy(checked.references[!i], input_slot(node.left, redirects), checked.types[!i], checked.type_table))
			Parser.Print | Parser.Eprint
				var type: IR.OutputType = IR.Integer()
				if checked.types[!node.left] == IR.TYPE_BOOL
					type = IR.OutputType.Boolean(IR.Boolean())
				elif checked.types[!node.left] == IR.TYPE_STRING
					type = IR.OutputType.Text(IR.Text())
				instructions = instructions.append(IR.Output(node.left, type, Parser.kind_is(node.kind, Parser.Eprint())))
			Parser.Return
				instructions = instructions.append(IR.Return(input_slot(node.left, redirects)))
		let conversion = checked.conversions.get(i) or Semantic.Conversion(IR.NO_TYPE, -1)
		if conversion.type != IR.NO_TYPE
			if conversion.tag >= 0
				instructions = instructions.append(IR.MakeUnion(input_slot(i, redirects), i, conversion.tag))
			else
				instructions = instructions.append(IR.RewrapValue(input_slot(i, redirects), i))
	# A reachable sentinel exposes a missing return; dead block markers are pruned.
	starts = starts.append(len(instructions))
	instructions = instructions.append(IR.Nop())
	var local = Array[IR.Instruction]()
	for instruction in instructions
		# Parser targets are arena node IDs; inserting conversions changes
		# instruction addresses, so map control flow to instruction positions.
		var mapped: IR.Instruction = instruction
		match instruction
			IR.Branch(input, target)
				mapped = IR.Instruction.Branch(IR.Branch(input, starts[!target - function.start] + function.start))
			IR.Jump(target)
				mapped = IR.Instruction.Jump(IR.Jump(starts[!target - function.start] + function.start))
			IR.ShortCircuit(dst, input, target, when_true)
				mapped = IR.Instruction.ShortCircuit(IR.ShortCircuit(dst, input, starts[!target - function.start] + function.start, when_true))
			IR.OptionalDefault(dst, input, target)
				mapped = IR.Instruction.OptionalDefault(IR.OptionalDefault(dst, input, starts[!target - function.start] + function.start))
			IR.EnumConstant | IR.EnumIndex | IR.MakeUnion | IR.CopyUnion | IR.RewrapValue | IR.UnionIndex | IR.TagTest | IR.TagAny | IR.UnionField | IR.UnionFields | IR.Trap | IR.MakeOptional | IR.MakeDict | IR.CopyDict | IR.DictLength | IR.DictInsert | IR.DictRead | IR.DictGet | IR.DictNext | IR.DictKey | IR.MakeArray | IR.CopyArray | IR.ArrayLength | IR.ArrayRead | IR.ArrayGet | IR.ArrayAppend | IR.ArraySet | IR.MakeRecord | IR.CopyRecord | IR.ReadField | IR.SetField | IR.Call | IR.Constant | IR.Negate | IR.Not | IR.Add | IR.Subtract | IR.Multiply | IR.Divide | IR.Remainder | IR.BitAnd | IR.BitOr | IR.ShiftLeft | IR.ShiftRight | IR.Copy | IR.Output | IR.Compare | IR.ValueCompare | IR.Nop | IR.Return | IR.StringConstant | IR.StringCopy | IR.StringConcat | IR.StringLength | IR.StringCompare | IR.StringSlice | IR.StringStarts | IR.StringEnds | IR.StringFormat | IR.StringByteAt | IR.StringFind | IR.StringJoin | IR.OptionalCopy | IR.OptionalUnwrap
				mapped = instruction
		local = local.append(IR.rebase(mapped, function.start))
	return IR.prune(IR.Program(local, function.end - function.start + len(extra_types), "", parsed.tokens[!function.token].line))

# Keep original local function positions during graph linking. Uninstantiated
# templates occupy temporary slots, which are removed before verification and
# C emission. Concrete specializations get their own checked body and slots.
def empty_template() -> IR.Function
	return IR.Function("template", IR.Program([IR.Trap()], 0, "", 0), [], IR.TYPE_I64, [])

def lower_definition(checked: Semantic.Checked, id: i64, function_base: i64) -> IR.Function
	let signature = checked.signatures[!id]
	let parsed = checked.parsed.functions[!id]
	let body = lower_function(checked, id, function_base)
	var types = Array[i64]()
	for node in parsed.start..parsed.end
		types = types.append(checked.types[!node])
	for node in parsed.start..parsed.end
		let conversion = checked.conversions.get(node) or Semantic.Conversion(IR.NO_TYPE, -1)
		if conversion.type != IR.NO_TYPE
			types = types.append(conversion.type)
	return IR.Function(signature.name, body, signature.parameters, signature.result, types)

def lower_checked(checked: Semantic.Checked, function_base: i64) -> IR.Module
	var functions = Array[IR.Function]()
	if checked.error != ""
		return IR.Module(functions, -1, checked.type_table, checked.error, checked.line)
	var entry = -1
	for id in 0..len(checked.parsed.functions)
		let signature = checked.signatures[!id]
		if Semantic.generic_signature(signature)
			functions = functions.append(empty_template())
			continue
		let function = lower_definition(checked, id, function_base)
		if function.body.error != ""
			return IR.Module(functions, -1, checked.type_table, function.body.error, function.body.line)
		functions = functions.append(function)
		if signature.name == "main"
			entry = function_base + id
	return IR.Module(functions, entry, checked.type_table, "", 0)

export def lower(source: string) -> IR.Module
	let checked = Semantic.check(Parser.parse(source))
	if checked.error != ""
		return IR.Module([], -1, checked.type_table, checked.error, checked.line)
	for signature in checked.signatures
		if Semantic.generic_signature(signature)
			return IR.Module([], -1, checked.type_table, "generic functions require --compile-modules", 1)
	return lower_checked(checked, 0)

# Module environments remain isolated. A template holds the defining module
# and function ID; argument types come from checked call operand slots, not
# names in the consumer. A specialization is checked in that defining module.
rec Environment(unit: Modules.Unit, external: Array[Semantic.External], types: Dict[string, i64], constructors: Dict[string, Semantic.Constructor], base: i64)
rec Pending(template: i64, arguments: Array[i64])

def specialization_key(template: i64, arguments: Array[i64]) -> string
	var key = str(template)
	for type in arguments
		key += ":" + str(type)
	return key

export def lower_graph(graph: Modules.Graph) -> IR.Module
	var functions = Array[IR.Function]()
	var table = IR.runtime_types()
	if graph.error != ""
		return IR.Module(functions, -1, table, graph.error, 0)
	var exported = Dict[string, Array[Semantic.External]]()
	var public_types = Dict[string, Array[ExportedType]]()
	var public_constructors = Dict[string, Array[ExportedConstructor]]()
	var environments = Array[Environment]()
	var template_modules = Dict[i64, i64]()
	var template_locals = Dict[i64, i64]()
	var entry = -1
	for unit in graph.units
		var external = Array[Semantic.External]()
		for imported in unit.parsed.imports
			let exposed = exported.get(imported.path) or Array[Semantic.External]()
			for item in exposed
				external = external.append(Semantic.External(imported.alias + "." + item.name, item.signature, item.function_id))
		var types = Dict[string, i64]()
		var constructors = Dict[string, Semantic.Constructor]()
		for imported in unit.parsed.imports
			let exposed_types = public_types.get(imported.path) or Array[ExportedType]()
			for member in exposed_types
				types = types.insert(imported.alias + "." + member.name, member.type)
			let exposed_constructors = public_constructors.get(imported.path) or Array[ExportedConstructor]()
			for member in exposed_constructors
				constructors = constructors.insert(imported.alias + "." + member.name, member.constructor)
		let is_entry = unit.name == graph.units[!len(graph.units) - 1].name
		let checked = Semantic.check_module(unit.parsed, table, external, types, constructors, is_entry)
		if checked.error != ""
			return IR.Module(functions, -1, checked.type_table, unit.name + ": " + checked.error, checked.line)
		let base = len(functions)
		let lowered = lower_checked(checked, base)
		if lowered.error != ""
			return IR.Module(functions, -1, checked.type_table, unit.name + ": " + lowered.error, lowered.line)
		table = lowered.type_table
		environments = environments.append(Environment(unit, external, types, constructors, base))
		var public_functions = Array[Semantic.External]()
		for id in 0..len(lowered.functions)
			let function = lowered.functions[!id]
			let signature = checked.signatures[!id]
			if Semantic.generic_signature(signature)
				template_modules = template_modules.insert(base + id, len(environments) - 1)
				template_locals = template_locals.insert(base + id, id)
			if unit.parsed.exports.get(signature.name) or false
				public_functions = public_functions.append(Semantic.External(signature.name, signature, base + id))
			functions = functions.append(IR.Function(unit.name + "." + function.name, function.body, function.parameters, function.result, function.types))
		exported = exported.insert(unit.name, public_functions)
		var unit_types = Array[ExportedType]()
		var unit_constructors = Array[ExportedConstructor]()
		for record in unit.parsed.records
			let token = unit.parsed.tokens[!record.token]
			let name = unit.parsed.source.slice(token.start, token.end)
			if unit.parsed.exports.get(name) or false
				unit_types = unit_types.append(ExportedType(name, checked.declared_types.get(name) or IR.NO_TYPE))
				unit_constructors = unit_constructors.append(ExportedConstructor(name, checked.declared_constructors.get(name) or Semantic.Constructor(IR.NO_TYPE, [])))
		for enumeration in unit.parsed.enums
			let token = unit.parsed.tokens[!enumeration.token]
			let name = unit.parsed.source.slice(token.start, token.end)
			if unit.parsed.exports.get(name) or false
				unit_types = unit_types.append(ExportedType(name, checked.declared_types.get(name) or IR.NO_TYPE))
		for alias in unit.parsed.unions
			let token = unit.parsed.tokens[!alias.token]
			let name = unit.parsed.source.slice(token.start, token.end)
			if unit.parsed.exports.get(name) or false
				unit_types = unit_types.append(ExportedType(name, checked.declared_types.get(name) or IR.NO_TYPE))
				# Union patterns expose ordered payload positions, but not private
				# record constructors through the importing module namespace.
				for alternative in alias.labels
					let label_token = unit.parsed.tokens[!alternative]
					let label = unit.parsed.source.slice(label_token.start, label_token.end)
					let declaration = checked.declared_constructors.get(label) or Semantic.Constructor(IR.NO_TYPE, [])
					unit_constructors = unit_constructors.append(ExportedConstructor(name + "." + label, declaration))
		public_types = public_types.insert(unit.name, unit_types)
		public_constructors = public_constructors.insert(unit.name, unit_constructors)
		if is_entry
			entry = lowered.entry

	# Discover and cache calls in definition order, including calls introduced
	# by specializing another template. Register before checking so direct
	# recursive calls converge to the same function ID.
	var pending = Dict[i64, Pending]()
	var instances = Dict[string, i64]()
	var cursor = 0
	var count = 0
	while cursor < len(functions)
		let job = pending.get(cursor) or Pending(-1, [])
		if job.template >= 0
			let environment_id = template_modules.get(job.template) or -1
			let local_id = template_locals.get(job.template) or -1
			let environment = environments[!environment_id]
			let checked = Semantic.check_specialization(environment.unit.parsed, table, environment.external, environment.types, environment.constructors, local_id, job.arguments)
			if checked.error != ""
				return IR.Module(functions, -1, checked.type_table, environment.unit.name + ": " + checked.error, checked.line)
			table = checked.type_table
			let lowered = lower_definition(checked, local_id, environment.base)
			if lowered.body.error != ""
				return IR.Module(functions, -1, table, environment.unit.name + ": " + lowered.body.error, lowered.body.line)
			functions[!cursor] = IR.Function(environment.unit.name + "." + lowered.name + "$" + str(cursor), lowered.body, lowered.parameters, lowered.result, lowered.types)
		let function = functions[!cursor]
		var instructions = Array[IR.Instruction]()
		for instruction in function.body.instructions
			match instruction
				IR.Call(dst, target, arguments)
					let module_id = template_modules.get(target) or -1
					if module_id < 0
						instructions = instructions.append(instruction)
						continue
					var concrete = Array[i64]()
					for operand in arguments
						if operand < 0 or operand >= len(function.types) or function.types[!operand] == IR.NO_TYPE
							return IR.Module(functions, -1, table, "unresolved generic argument", function.body.line)
						concrete = concrete.append(function.types[!operand])
					let key = specialization_key(target, concrete)
					var instance = instances.get(key) or -1
					if instance < 0
						if count >= 128
							return IR.Module(functions, -1, table, "generic specialization limit exceeded", function.body.line)
						instance = len(functions)
						instances = instances.insert(key, instance)
						pending = pending.insert(instance, Pending(target, concrete))
						functions = functions.append(empty_template())
						count += 1
					instructions = instructions.append(IR.Call(dst, instance, arguments))
				IR.EnumConstant | IR.EnumIndex | IR.MakeUnion | IR.CopyUnion | IR.RewrapValue | IR.UnionIndex | IR.TagTest | IR.TagAny | IR.UnionField | IR.UnionFields | IR.Trap | IR.MakeDict | IR.CopyDict | IR.DictLength | IR.DictInsert | IR.DictRead | IR.DictGet | IR.DictNext | IR.DictKey | IR.MakeArray | IR.CopyArray | IR.ArrayLength | IR.ArrayRead | IR.ArrayGet | IR.ArrayAppend | IR.ArraySet | IR.MakeRecord | IR.CopyRecord | IR.ReadField | IR.SetField | IR.Constant | IR.Negate | IR.Not | IR.Add | IR.Subtract | IR.Multiply | IR.Divide | IR.Remainder | IR.BitAnd | IR.BitOr | IR.ShiftLeft | IR.ShiftRight | IR.Copy | IR.Output | IR.Return | IR.Compare | IR.ValueCompare | IR.Branch | IR.ShortCircuit | IR.Jump | IR.Nop | IR.StringConstant | IR.StringCopy | IR.StringConcat | IR.StringLength | IR.StringCompare | IR.StringSlice | IR.StringStarts | IR.StringEnds | IR.StringFormat | IR.StringByteAt | IR.StringFind | IR.StringJoin | IR.MakeOptional | IR.OptionalCopy | IR.OptionalDefault | IR.OptionalUnwrap
					instructions = instructions.append(instruction)
		functions[!cursor] = IR.Function(function.name, IR.Program(instructions, function.body.slots, function.body.error, function.body.line), function.parameters, function.result, function.types)
		cursor += 1

	# No template placeholder survives into verified IR or generated C.
	var remap = Array[i64]()
	var compact = Array[IR.Function]()
	for id in 0..len(functions)
		if (template_modules.get(id) or -1) >= 0
			remap = remap.append(-1)
		else
			remap = remap.append(len(compact))
			compact = compact.append(functions[!id])
	var finished = Array[IR.Function]()
	for function in compact
		var rewritten = Array[IR.Instruction]()
		for instruction in function.body.instructions
			match instruction
				IR.Call(dst, target, arguments)
					if target < 0 or target >= len(remap) or remap[!target] < 0
						return IR.Module([], -1, table, "unresolved generic function target", function.body.line)
					rewritten = rewritten.append(IR.Call(dst, remap[!target], arguments))
				IR.EnumConstant | IR.EnumIndex | IR.MakeUnion | IR.CopyUnion | IR.RewrapValue | IR.UnionIndex | IR.TagTest | IR.TagAny | IR.UnionField | IR.UnionFields | IR.Trap | IR.MakeDict | IR.CopyDict | IR.DictLength | IR.DictInsert | IR.DictRead | IR.DictGet | IR.DictNext | IR.DictKey | IR.MakeArray | IR.CopyArray | IR.ArrayLength | IR.ArrayRead | IR.ArrayGet | IR.ArrayAppend | IR.ArraySet | IR.MakeRecord | IR.CopyRecord | IR.ReadField | IR.SetField | IR.Constant | IR.Negate | IR.Not | IR.Add | IR.Subtract | IR.Multiply | IR.Divide | IR.Remainder | IR.BitAnd | IR.BitOr | IR.ShiftLeft | IR.ShiftRight | IR.Copy | IR.Output | IR.Return | IR.Compare | IR.ValueCompare | IR.Branch | IR.ShortCircuit | IR.Jump | IR.Nop | IR.StringConstant | IR.StringCopy | IR.StringConcat | IR.StringLength | IR.StringCompare | IR.StringSlice | IR.StringStarts | IR.StringEnds | IR.StringFormat | IR.StringByteAt | IR.StringFind | IR.StringJoin | IR.MakeOptional | IR.OptionalCopy | IR.OptionalDefault | IR.OptionalUnwrap
					rewritten = rewritten.append(instruction)
		finished = finished.append(IR.Function(function.name, IR.Program(rewritten, function.body.slots, function.body.error, function.body.line), function.parameters, function.result, function.types))
	return IR.Module(finished, remap[!entry], table, "", 0)
