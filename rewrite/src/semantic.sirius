import parser alias Parser
import ir alias IR

# A result_parameter >= 0 identifies the argument supplying an inferred
# result. result_path is a series of record fields or indexed lookups; the
# empty string denotes [!index] (no valid record field name is empty).
# Resolve the path against concrete argument types at each call site, before
# checking an instantiated body. Annotations keep result_parameter == -1.
export rec Signature(name: string, parameters: Array[i64], result: i64, result_parameter: i64, result_path: Array[string])
export rec External(name: string, signature: Signature, function_id: i64)
export rec Constructor(type: i64, parameters: Array[IR.RecordField])
export rec Conversion(type: i64, tag: i64)
export rec Checked(parsed: Parser.State, type_table: IR.TypeTable, signatures: Array[Signature], references: Array[i64], types: Array[i64], constructor_calls: Dict[i64, Constructor], match_fields: Dict[i64, Array[i64]], conversions: Dict[i64, Conversion], external_targets: Array[i64], declared_types: Dict[string, i64], declared_constructors: Dict[string, Constructor], error: string, line: i64)
rec Binding(node: i64, mutable: bool, depth: i64)

def name(parsed: Parser.State, token_id: i64) -> string
	let token = parsed.tokens[!token_id]
	return parsed.source.slice(token.start, token.end)

# Imported calls are resolved through the source-local alias. Never insert
# the defining module's exported names in the caller's unqualified namespace.
def call_name(parsed: Parser.State, node_id: i64) -> string
	let node = parsed.nodes[!node_id]
	let qualifier = parsed.qualified_calls.get(node_id) or -1
	if qualifier >= 0
		return name(parsed, qualifier) + "." + name(parsed, node.token)
	return name(parsed, node.token)

# The parser attaches a source-local import alias to qualified enum/union
# operations and match cases. Never resolve the exported type as an unqualified
# declaration in the importing module.
def type_member_name(parsed: Parser.State, node_id: i64, token: i64) -> string
	let alias = parsed.qualified_calls.get(node_id) or -1
	if alias >= 0
		return name(parsed, alias) + "." + name(parsed, token)
	return name(parsed, token)

# Match binding positions follow the defining constructor's declaration order,
# not the canonical record descriptor's sorted field order.
def match_constructor_name(parsed: Parser.State, case_id: i64) -> string
	let pattern = parsed.nodes[!case_id]
	let alias = parsed.qualified_calls.get(case_id) or -1
	if alias >= 0
		let qualifier = parsed.match_qualifiers.get(case_id) or -1
		return name(parsed, alias) + "." + name(parsed, qualifier) + "." + name(parsed, pattern.token)
	return name(parsed, pattern.token)

# Resolve a source type expression while interning each array level. The
# descriptor graph is acyclic by construction; records can refer only to
# previously declared records. The token after the type is returned to verify
# closing brackets without guessing the nesting depth.
rec ResolvedType(table: IR.TypeTable, type: i64, next: i64)

def resolve_type(parsed: Parser.State, token: i64, table: IR.TypeTable, records: Dict[string, i64]) -> ResolvedType
	if token < 0 or token >= len(parsed.tokens)
		return ResolvedType(table, IR.NO_TYPE, token)
	let type_name = name(parsed, token)
	if type_name == "Dict"
		if token + 1 >= len(parsed.tokens) or name(parsed, token + 1) != "["
			return ResolvedType(table, IR.NO_TYPE, token)
		let key = resolve_type(parsed, token + 2, table, records)
		if key.type != IR.TYPE_I64 and key.type != IR.TYPE_STRING
			return ResolvedType(table, IR.NO_TYPE, token)
		if key.next >= len(parsed.tokens) or name(parsed, key.next) != ","
			return ResolvedType(table, IR.NO_TYPE, token)
		let value = resolve_type(parsed, key.next + 1, key.table, records)
		if value.type == IR.NO_TYPE or value.next >= len(parsed.tokens) or name(parsed, value.next) != "]" or not IR.runtime_type(value.table, value.type)
			return ResolvedType(table, IR.NO_TYPE, token)
		let dict = IR.intern_dict(value.table, key.type, value.type)
		return ResolvedType(dict.table, dict.id, value.next + 1)
	if type_name == "Array"
		if token + 1 >= len(parsed.tokens) or name(parsed, token + 1) != "["
			return ResolvedType(table, IR.NO_TYPE, token)
		let inner = resolve_type(parsed, token + 2, table, records)
		if inner.type == IR.NO_TYPE or inner.next >= len(parsed.tokens) or name(parsed, inner.next) != "]"
			return ResolvedType(table, IR.NO_TYPE, token)
		if not IR.runtime_type(inner.table, inner.type)
			return ResolvedType(table, IR.NO_TYPE, token)
		let array = IR.intern_array(inner.table, inner.type)
		return ResolvedType(array.table, array.id, inner.next + 1)
	if type_name == "Optional"
		if token + 1 >= len(parsed.tokens) or name(parsed, token + 1) != "["
			return ResolvedType(table, IR.NO_TYPE, token)
		let inner = resolve_type(parsed, token + 2, table, records)
		if inner.type == IR.NO_TYPE or inner.next >= len(parsed.tokens) or name(parsed, inner.next) != "]" or not IR.runtime_type(inner.table, inner.type)
			return ResolvedType(table, IR.NO_TYPE, token)
		let optional = IR.intern_optional(inner.table, inner.type)
		return ResolvedType(optional.table, optional.id, inner.next + 1)
	if type_name == "i64"
		return ResolvedType(table, IR.TYPE_I64, token + 1)
	if type_name == "bool"
		return ResolvedType(table, IR.TYPE_BOOL, token + 1)
	if type_name == "string"
		return ResolvedType(table, IR.TYPE_STRING, token + 1)
	if token + 2 < len(parsed.tokens) and name(parsed, token + 1) == "."
		let qualified = type_name + "." + name(parsed, token + 2)
		return ResolvedType(table, records.get(qualified) or IR.NO_TYPE, token + 3)
	return ResolvedType(table, records.get(type_name) or IR.NO_TYPE, token + 1)

# A record constructor's name is a contextual label; other record values
# have structural identity only. With same-shaped alternatives, a stored
# record cannot choose a label. Existing tagged values never get relabeled.
rec Accepted(conversions: Dict[i64, Conversion], error: string)

def accept_value(parsed: Parser.State, table: IR.TypeTable, expression: i64, actual: i64, expected: i64, conversions: Dict[i64, Conversion], mismatch: string) -> Accepted
	if IR.compatible(table, actual, expected)
		return Accepted(conversions, "")
	if not IR.is_record(table, actual) or not IR.is_union(table, expected)
		if IR.can_rewrap(table, actual, expected)
			return Accepted(conversions.insert(expression, Conversion(expected, -1)), "")
		return Accepted(conversions, mismatch)
	let node = parsed.nodes[!expression]
	if Parser.kind_is(node.kind, Parser.Call())
		let label = name(parsed, node.token)
		let selected = IR.union_index(table, expected, label)
		if selected >= 0 and IR.compatible(table, actual, IR.union_payload(table, expected, selected))
			return Accepted(conversions.insert(expression, Conversion(expected, selected)), "")
	var selected = -1
	for tag in 0..len(table.entries[!expected].fields)
		if IR.compatible(table, actual, IR.union_payload(table, expected, tag))
			if selected >= 0
				return Accepted(conversions, "ambiguous union injection; select a label explicitly")
			selected = tag
	if selected < 0
		return Accepted(conversions, mismatch)
	return Accepted(conversions.insert(expression, Conversion(expected, selected)), "")

# Context is propagated before type checking: children of a typed array
# literal must know the element type before the enclosing literal is checked.
def context_for(parsed: Parser.State, expression: i64, expected: i64, table: IR.TypeTable, contexts: Dict[i64, i64]) -> Dict[i64, i64]
	if expression < 0 or expected == IR.NO_TYPE
		return contexts
	var result = contexts.insert(expression, expected)
	let node = parsed.nodes[!expression]
	if Parser.kind_is(node.kind, Parser.ArrayLiteral()) and IR.is_array(table, expected)
		var argument = node.left
		while argument >= 0
			let item = parsed.nodes[!argument]
			result = context_for(parsed, item.left, IR.array_element(table, expected), table, result)
			argument = item.right
	return result

# Inferred results may be projections of a parameter. A path of field names
# and indexed lookups is independent of the caller's concrete type layout;
# projection resolution uses the canonical type table, not field positions.
# Unknown/invalid operations are rejected when the concrete call is checked.
rec ResultRule(type: i64, parameter: i64, path: Array[string])

def projected_result(table: IR.TypeTable, type: i64, path: Array[string]) -> i64
	var current = type
	for step in path
		if step == ""
			if IR.is_array(table, current)
				current = IR.array_element(table, current)
			elif IR.is_dict(table, current)
				current = IR.dict_value(table, current)
			else
				return IR.NO_TYPE
		else
			let index = IR.field_index(table, current, step)
			if index < 0
				return IR.NO_TYPE
			current = table.entries[!current].fields[!index].type
	return current

def append_projection(table: IR.TypeTable, rule: ResultRule, path: Array[string]) -> ResultRule
	if rule.parameter >= 0
		var combined = rule.path
		for step in path
			combined = combined.append(step)
		return ResultRule(IR.NO_TYPE, rule.parameter, combined)
	if rule.type != IR.NO_TYPE
		return ResultRule(projected_result(table, rule.type, path), -1, [])
	return ResultRule(IR.NO_TYPE, -1, [])

def inferred_expression(parsed: Parser.State, expression: i64, signatures: Array[Signature], functions: Dict[string, i64], table: IR.TypeTable, locals: Dict[string, ResultRule]) -> ResultRule
	if expression < 0
		return ResultRule(IR.NO_TYPE, -1, [])
	let node = parsed.nodes[!expression]
	if Parser.kind_is(node.kind, Parser.IntegerLiteral()) or Parser.kind_is(node.kind, Parser.Length()) or Parser.kind_is(node.kind, Parser.EnumIndex())
		return ResultRule(IR.TYPE_I64, -1, [])
	if Parser.kind_is(node.kind, Parser.BooleanLiteral()) or Parser.kind_is(node.kind, Parser.Compare()) or Parser.kind_is(node.kind, Parser.Not()) or Parser.kind_is(node.kind, Parser.StringStarts()) or Parser.kind_is(node.kind, Parser.StringEnds())
		return ResultRule(IR.TYPE_BOOL, -1, [])
	if Parser.kind_is(node.kind, Parser.StringLiteral()) or Parser.kind_is(node.kind, Parser.StringPart()) or Parser.kind_is(node.kind, Parser.StringConvert()) or Parser.kind_is(node.kind, Parser.StringJoin())
		return ResultRule(IR.TYPE_STRING, -1, [])
	# Integer-only operators and addition have known result rules; the body
	# checker still rejects invalid operand combinations at instantiation.
	if Parser.kind_is(node.kind, Parser.Negate()) or Parser.kind_is(node.kind, Parser.Subtract()) or Parser.kind_is(node.kind, Parser.Multiply()) or Parser.kind_is(node.kind, Parser.Divide()) or Parser.kind_is(node.kind, Parser.Remainder()) or Parser.kind_is(node.kind, Parser.BitAnd()) or Parser.kind_is(node.kind, Parser.BitOr()) or Parser.kind_is(node.kind, Parser.ShiftLeft()) or Parser.kind_is(node.kind, Parser.ShiftRight())
		return ResultRule(IR.TYPE_I64, -1, [])
	if Parser.kind_is(node.kind, Parser.Add())
		return inferred_expression(parsed, node.left, signatures, functions, table, locals)
	if Parser.kind_is(node.kind, Parser.Variable())
		return locals.get(name(parsed, node.token)) or ResultRule(IR.NO_TYPE, -1, [])
	if Parser.kind_is(node.kind, Parser.ArrayRead())
		let base = inferred_expression(parsed, node.left, signatures, functions, table, locals)
		return append_projection(table, base, [""])
	if Parser.kind_is(node.kind, Parser.FieldRead())
		let base = inferred_expression(parsed, node.left, signatures, functions, table, locals)
		return append_projection(table, base, [name(parsed, node.token)])
	if Parser.kind_is(node.kind, Parser.Call())
		let target = functions.get(call_name(parsed, expression)) or -1
		if target >= 0
			let signature = signatures[!target]
			if signature.result != IR.NO_TYPE
				return ResultRule(signature.result, -1, [])
			if signature.result_parameter >= 0 and signature.result_parameter < node.right
				var argument = node.left
				var position = node.right
				while argument >= 0
					position -= 1
					if position == signature.result_parameter
						let rule = inferred_expression(parsed, parsed.nodes[!argument].left, signatures, functions, table, locals)
						return append_projection(table, rule, signature.result_path)
					argument = parsed.nodes[!argument].right
	return ResultRule(IR.NO_TYPE, -1, [])

# Resolve immutable aliases in statement order. Scope snapshots mirror the
# checker's If/Else/EndIf and loop scopes; no inferred rule crosses a branch
# or loop boundary. A mutable binding or match binder shadows earlier rules
# without claiming a stable inferred value.
def inferred_result(parsed: Parser.State, function: Parser.Function, signatures: Array[Signature], functions: Dict[string, i64], table: IR.TypeTable) -> ResultRule
	var locals = Dict[string, ResultRule]()
	for position in 0..len(function.parameters)
		let parameter = parsed.nodes[!function.parameters[!position]]
		locals = locals.insert(name(parsed, parameter.token), ResultRule(IR.NO_TYPE, position, []))
	var scopes = Array[Dict[string, ResultRule]]()
	var depth = 0
	for i in function.start..function.end
		let node = parsed.nodes[!i]
		if Parser.kind_is(node.kind, Parser.Return())
			return inferred_expression(parsed, node.left, signatures, functions, table, locals)
		if Parser.kind_is(node.kind, Parser.Binding())
			var rule = ResultRule(IR.NO_TYPE, -1, [])
			# An annotation can change an aggregate's representation through
			# contextual injection/rewrapping. Do not reuse the source's rule.
			if node.right < 0
				rule = inferred_expression(parsed, node.left, signatures, functions, table, locals)
			locals = locals.insert(name(parsed, node.token), rule)
		elif Parser.kind_is(node.kind, Parser.MutableBinding()) or Parser.kind_is(node.kind, Parser.MatchBind())
			locals = locals.insert(name(parsed, node.token), ResultRule(IR.NO_TYPE, -1, []))
		elif Parser.kind_is(node.kind, Parser.If()) or Parser.kind_is(node.kind, Parser.While()) or Parser.kind_is(node.kind, Parser.RangeBinding()) or Parser.kind_is(node.kind, Parser.ArrayIndex())
			if depth == len(scopes)
				scopes = scopes.append(locals)
			else
				scopes[!depth] = locals
			depth += 1
			if Parser.kind_is(node.kind, Parser.RangeBinding()) or Parser.kind_is(node.kind, Parser.ArrayIndex())
				locals = locals.insert(name(parsed, node.token), ResultRule(IR.NO_TYPE, -1, []))
		elif Parser.kind_is(node.kind, Parser.ArrayElement())
			locals = locals.insert(name(parsed, node.token), ResultRule(IR.NO_TYPE, -1, []))
		elif Parser.kind_is(node.kind, Parser.Else())
			if depth > 0
				locals = scopes[!depth - 1]
		elif Parser.kind_is(node.kind, Parser.EndIf()) or Parser.kind_is(node.kind, Parser.EndWhile())
			if depth > 0
				depth -= 1
				locals = scopes[!depth]
	return ResultRule(IR.NO_TYPE, -1, [])

# Concrete compilation checks only non-generic bodies. A selected specialization
# checks one function under its concrete parameter types, retaining the same
# source-local type/constructor visibility and external signature environment.
def check_module_inner(parsed: Parser.State, initial_table: IR.TypeTable, external: Array[External], imported_types: Dict[string, i64], imported_constructors: Dict[string, Constructor], needs_main: bool, selected: i64, selected_types: Array[i64]) -> Checked
	var type_table = initial_table
	var record_types = imported_types
	var constructors = imported_constructors
	var enum_labels = Dict[string, i64]()
	var constructor_calls = Dict[i64, Constructor]()
	var match_coverage = Dict[i64, Array[bool]]()
	var match_fields = Dict[i64, Array[i64]]()
	var conversions = Dict[i64, Conversion]()
	var references = Array[i64]()
	var types = Array[i64]()
	var signatures = Array[Signature]()
	var external_targets = Array[i64]()
	var functions = Dict[string, i64]()
	var parameter_types = Dict[i64, i64]()
	if parsed.error != ""
		return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, parsed.error, parsed.error_line)
	# Pre-intern complete builtin array annotations before record declarations,
	# preserving stable IDs for existing programs. Record-dependent arrays are
	# resolved after the referenced record has been declared.
	for i in 0..len(parsed.tokens)
		if (name(parsed, i) == "Array" or name(parsed, i) == "Dict") and i + 1 < len(parsed.tokens) and name(parsed, i + 1) == "["
			let resolved = resolve_type(parsed, i, type_table, record_types)
			if resolved.type != IR.NO_TYPE
				type_table = resolved.table
	# Enums use a scalar tag but preserve alternative names and their order in
	# canonical descriptors. A bare label call is valid only when unambiguous.
	for enumeration in parsed.enums
		let target = name(parsed, enumeration.token)
		if (record_types.get(target) or IR.NO_TYPE) != IR.NO_TYPE or target == "main" or target == "i64" or target == "bool" or target == "string" or target == "Array" or target == "Dict" or target == "Optional" or target == "len" or target == "str" or target == "print" or target == "eprint"
			return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "duplicate or reserved enum: " + target, parsed.tokens[!enumeration.token].line)
		var labels = Array[string]()
		for label in enumeration.labels
			labels = labels.append(name(parsed, label))
		let interned = IR.intern_enum(type_table, labels)
		if interned.id == IR.NO_TYPE
			return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "enum requires two distinct labels", parsed.tokens[!enumeration.token].line)
		type_table = interned.table
		record_types = record_types.insert(target, interned.id)
		for i in 0..len(labels)
			let label = labels[!i]
			if label == "index" or label == "main"
				return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "reserved enum label: " + label, parsed.tokens[!enumeration.labels[!i]].line)
			if (constructors.get(label) or Constructor(IR.NO_TYPE, [])).type != IR.NO_TYPE
				return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "enum label conflicts with record: " + label, parsed.tokens[!enumeration.labels[!i]].line)
			let previous = enum_labels.get(label) or IR.NO_TYPE
			if previous != IR.NO_TYPE
				enum_labels = enum_labels.insert(label, -2) # ambiguous
			else
				enum_labels = enum_labels.insert(label, interned.id)
	# Resolve records and unions in declaration order. A record may now refer
	# to an earlier union alias, but cyclic and forward references stay invalid.
	var record_cursor = 0
	var union_cursor = 0
	while record_cursor < len(parsed.records) or union_cursor < len(parsed.unions)
		if union_cursor < len(parsed.unions) and (record_cursor >= len(parsed.records) or parsed.unions[!union_cursor].token < parsed.records[!record_cursor].token)
			let alias = parsed.unions[!union_cursor]
			union_cursor += 1
			let target = name(parsed, alias.token)
			if (record_types.get(target) or IR.NO_TYPE) != IR.NO_TYPE or (constructors.get(target) or Constructor(IR.NO_TYPE, [])).type != IR.NO_TYPE or (enum_labels.get(target) or IR.NO_TYPE) != IR.NO_TYPE or target == "main" or target == "i64" or target == "bool" or target == "string" or target == "Array" or target == "Optional" or target == "Dict"
				return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "duplicate or reserved union: " + target, parsed.tokens[!alias.token].line)
			var variants = Array[IR.RecordField]()
			for label in alias.labels
				let alternative = name(parsed, label)
				let variant = constructors.get(alternative) or Constructor(IR.NO_TYPE, [])
				if variant.type == IR.NO_TYPE
					return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "union alternative must be a record: " + alternative, parsed.tokens[!label].line)
				variants = variants.append(IR.RecordField(alternative, variant.type))
			let interned = IR.intern_union(type_table, variants)
			if interned.id == IR.NO_TYPE
				return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "union requires two distinct record alternatives", parsed.tokens[!alias.token].line)
			type_table = interned.table
			record_types = record_types.insert(target, interned.id)
		else
			let record = parsed.records[!record_cursor]
			record_cursor += 1
			let target = name(parsed, record.token)
			var error = ""
			if (record_types.get(target) or IR.NO_TYPE) != IR.NO_TYPE
				error = "duplicate record or enum: " + target
			elif (enum_labels.get(target) or IR.NO_TYPE) != IR.NO_TYPE
				error = "record name conflicts with enum label: " + target
			elif target == "main" or target == "i64" or target == "bool" or target == "string" or target == "Optional" or target == "Array" or target == "Dict" or target == "len" or target == "str" or target == "print" or target == "eprint"
				error = "reserved record name: " + target
			if error != ""
				return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, error, parsed.tokens[!record.token].line)
			var fields = Array[IR.RecordField]()
			var names = Dict[string, bool]()
			for field in record.fields
				let field_name = name(parsed, field.token)
				let resolved = resolve_type(parsed, field.annotation, type_table, record_types)
				type_table = resolved.table
				let type = resolved.type
				if names.get(field_name) or false
					error = "duplicate record field: " + field_name
				elif not IR.runtime_type(type_table, type)
					error = "unsupported record field type"
				if error != ""
					return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, error, parsed.tokens[!field.token].line)
				names = names.insert(field_name, true)
				fields = fields.append(IR.RecordField(field_name, type))
			let interned = IR.intern_record(type_table, fields)
			type_table = interned.table
			record_types = record_types.insert(target, interned.id)
			constructors = constructors.insert(target, Constructor(interned.id, fields))
	# Array element layouts refer to already canonicalized record descriptors.
	for record in parsed.records
		let id = record_types.get(name(parsed, record.token)) or IR.NO_TYPE
		type_table = IR.intern_array(type_table, id).table
	# Collect every signature before checking any body, including recursive calls.
	var declaration_id = 0
	for function in parsed.functions
		let target = name(parsed, function.token)
		var error = ""
		if (functions.get(target) or -1) >= 0
			error = "duplicate function: " + target
		elif (record_types.get(target) or IR.NO_TYPE) != IR.NO_TYPE
			error = "function name conflicts with type: " + target
		elif (enum_labels.get(target) or IR.NO_TYPE) != IR.NO_TYPE
			error = "function name conflicts with enum label: " + target
		elif target == "len" or target == "str" or target == "print" or target == "eprint"
			error = "reserved builtin function: " + target
		var parameters = Array[i64]()
		var parameter_id = 0
		for parameter in function.parameters
			let token = parsed.nodes[!parameter].right
			var type = IR.NO_TYPE
			if token < 0
				if declaration_id == selected and parameter_id < len(selected_types)
					type = selected_types[!parameter_id]
			else
				let resolved = resolve_type(parsed, token, type_table, record_types)
				type_table = resolved.table
				type = resolved.type
				if type == IR.NO_TYPE
					error = "unknown type: " + name(parsed, token)
			parameter_types = parameter_types.insert(parameter, type)
			parameters = parameters.append(type)
			parameter_id += 1
		var result = IR.NO_TYPE
		if function.result >= 0
			let resolved_result = resolve_type(parsed, function.result, type_table, record_types)
			type_table = resolved_result.table
			result = resolved_result.type
			if result == IR.NO_TYPE
				error = "unknown type: " + name(parsed, function.result)
		if target == "main" and (len(parameters) != 0 or result != IR.TYPE_I64)
			error = "main must have signature main() -> i64"
		if error != ""
			return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, error, parsed.tokens[!function.token].line)
		functions = functions.insert(target, len(signatures))
		signatures = signatures.append(Signature(target, parameters, result, -1, []))
		declaration_id += 1
	if needs_main and (functions.get("main") or -1) < 0
		return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "missing main function", 1)
	for item in external
		functions = functions.insert(item.name, len(signatures))
		signatures = signatures.append(item.signature)
		external_targets = external_targets.append(item.function_id)
	# Resolve body-derived return rules after all names are collected, allowing
	# imported forwarding calls and forward local signatures. A bounded fixed
	# point handles local forwarding chains; cycles without an anchor are errors.
	for pass in 0..len(parsed.functions) + 1
		var progress = false
		for fid in 0..len(parsed.functions)
			let function = parsed.functions[!fid]
			if function.result >= 0 or signatures[!fid].result != IR.NO_TYPE or signatures[!fid].result_parameter >= 0
				continue
			let rule = inferred_result(parsed, function, signatures, functions, type_table)
			if rule.type != IR.NO_TYPE or rule.parameter >= 0
				var result = rule.type
				if rule.parameter >= 0 and signatures[!fid].parameters[!rule.parameter] != IR.NO_TYPE
					result = projected_result(type_table, signatures[!fid].parameters[!rule.parameter], rule.path)
					if result == IR.NO_TYPE
						return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "invalid inferred result projection", parsed.tokens[!function.token].line)
				signatures[!fid] = Signature(signatures[!fid].name, signatures[!fid].parameters, result, rule.parameter, rule.path)
				progress = true
		if not progress
			break
	for fid in 0..len(parsed.functions)
		let function = parsed.functions[!fid]
		if function.result < 0 and signatures[!fid].result == IR.NO_TYPE and signatures[!fid].result_parameter < 0
			return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "cannot infer function result; add -> annotation", parsed.tokens[!function.token].line)
	# A specialized function substitutes its concrete argument types into the
	# inferred result rule; an uninstantiated template keeps its parameter rule.
	if selected >= 0
		let signature = signatures[!selected]
		if signature.result_parameter >= 0
			let pos = signature.result_parameter
			if pos < len(signature.parameters) and signature.parameters[!pos] != IR.NO_TYPE
				signatures[!selected] = Signature(signature.name, signature.parameters, projected_result(type_table, signature.parameters[!pos], signature.result_path), pos, signature.result_path)
	# Seed expected types for expression trees that need context before their
	# children are checked (notably arrays with mixed union alternatives).
	var contexts = Dict[i64, i64]()
	for fid in 0..len(parsed.functions)
		let function = parsed.functions[!fid]
		for id in function.start..function.end
			if (selected >= 0 and selected != fid) or (selected < 0 and generic_signature(signatures[!fid]))
				continue
			let node = parsed.nodes[!id]
			if Parser.kind_is(node.kind, Parser.Return())
				contexts = context_for(parsed, node.left, signatures[!fid].result, type_table, contexts)
			elif Parser.kind_is(node.kind, Parser.Binding()) or Parser.kind_is(node.kind, Parser.MutableBinding())
				if node.right >= 0
					let resolved = resolve_type(parsed, node.right, type_table, record_types)
					type_table = resolved.table
					contexts = context_for(parsed, node.left, resolved.type, type_table, contexts)
			elif Parser.kind_is(node.kind, Parser.Call())
				let target = call_name(parsed, id)
				var parameters = Array[i64]()
				let function_id = functions.get(target) or -1
				let constructor = constructors.get(target) or Constructor(IR.NO_TYPE, [])
				if constructor.type != IR.NO_TYPE
					for field in constructor.parameters
						parameters = parameters.append(field.type)
				elif function_id >= 0
					parameters = signatures[!function_id].parameters
					if selected >= 0 and function_id == selected
						for position in 0..len(parameters)
							let parameter = parsed.functions[!selected].parameters[!position]
							if parsed.nodes[!parameter].right < 0
								parameters[!position] = IR.NO_TYPE
				if len(parameters) == node.right
					var argument = node.left
					var position = node.right
					while argument >= 0
						position -= 1
						contexts = context_for(parsed, parsed.nodes[!argument].left, parameters[!position], type_table, contexts)
						argument = parsed.nodes[!argument].right
			elif Parser.kind_is(node.kind, Parser.OptionalConstruct()) and node.left >= 0
				let resolved = resolve_type(parsed, node.token, type_table, record_types)
				type_table = resolved.table
				contexts = context_for(parsed, node.left, resolved.type, type_table, contexts)
	var bindings = Dict[string, Binding]()
	var scopes = Array[Dict[string, Binding]]()
	var depth = 0
	let integer = IR.TYPE_I64
	let boolean = IR.TYPE_BOOL
	let text = IR.TYPE_STRING
	let optional = IR.find_optional(type_table, IR.TYPE_I64)
	var function_id = 0
	for i in 0..len(parsed.nodes)
		while i >= parsed.functions[!function_id].end
			function_id += 1
		if i == parsed.functions[!function_id].start
			bindings = Dict[string, Binding]()
			scopes = Array[Dict[string, Binding]]()
			depth = 0
		if (selected >= 0 and selected != function_id) or (selected < 0 and generic_signature(signatures[!function_id]))
			references = references.append(-1)
			types = types.append(IR.NO_TYPE)
			continue
		let node = parsed.nodes[!i]
		var reference = -1
		var type = IR.NO_TYPE
		var error = ""
		match node.kind
			Parser.MatchCase
				let subject = types[!node.left]
				let label = name(parsed, node.token)
				let qualifier_token = parsed.match_qualifiers.get(i) or -1
				type = boolean
				if qualifier_token >= 0 and (IR.is_enum(type_table, subject) or IR.is_union(type_table, subject))
					let qualifier = type_member_name(parsed, i, qualifier_token)
					let qualified_type = record_types.get(qualifier) or IR.NO_TYPE
					if qualified_type == IR.NO_TYPE
						error = "unknown match qualifier: " + qualifier
					elif not IR.compatible(type_table, qualified_type, subject)
						error = "match qualifier type mismatch: " + qualifier
				if IR.is_union(type_table, subject)
					reference = IR.union_index(type_table, subject, label)
					if error == "" and reference >= 0 and node.right >= 0
						let record = constructors.get(match_constructor_name(parsed, i)) or Constructor(IR.NO_TYPE, [])
						if len(record.parameters) != node.right
							error = "match payload binding count mismatch"
				elif IR.is_enum(type_table, subject)
					reference = IR.enum_index(type_table, subject, label)
					if node.right > 0
						error = "enum match cannot bind fields"
				else
					error = "match requires enum or labeled union"
				if reference < 0 and error == ""
					error = "unknown match alternative: " + label
				if error == ""
					var seen = match_coverage.get(node.left) or Array[bool]()
					if len(seen) == 0
						for field in type_table.entries[!subject].fields
							seen = seen.append(false)
					if seen[!reference]
						error = "duplicate match alternative: " + label
					else
						seen[!reference] = true
						match_coverage = match_coverage.insert(node.left, seen)
			Parser.MatchGroup
				type = boolean
			Parser.MatchBind
				let group = parsed.nodes[!node.right]
				var fields = Array[i64]()
				for case_id in group.left..group.right + 1
					let test = parsed.nodes[!case_id]
					let subject = types[!test.left]
					let payload = IR.union_payload(type_table, subject, references[!case_id])
					let declared = constructors.get(match_constructor_name(parsed, case_id)) or Constructor(IR.NO_TYPE, [])
					if payload == IR.NO_TYPE or node.left < 0 or node.left >= len(declared.parameters)
						error = "invalid match payload binding"
						break
					let field = IR.field_index(type_table, payload, declared.parameters[!node.left].name)
					if field < 0
						error = "invalid match payload field"
						break
					let field_type = type_table.entries[!payload].fields[!field].type
					if type != IR.NO_TYPE and type != field_type
						error = "grouped match binding types must agree"
						break
					type = field_type
					fields = fields.append(field)
				if error == ""
					match_fields = match_fields.insert(i, fields)
					reference = fields[!0]
					let target = name(parsed, node.token)
					let existing = bindings.get(target) or Binding(-1, false, -1)
					if existing.node >= 0 and existing.depth == depth
						error = "duplicate match binding: " + target
					else
						bindings = bindings.insert(target, Binding(i, false, depth))
			Parser.MatchFail
				type = -1
			Parser.MatchEnd
				let seen = match_coverage.get(node.left) or Array[bool]()
				for present in seen
					if not present
						error = "non-exhaustive match"
				if len(seen) == 0
					error = "non-exhaustive match"
				match_coverage = match_coverage.insert(node.left, [])
			Parser.EnumConstruct
				let target = type_member_name(parsed, i, node.token)
				let enum_type = record_types.get(target) or IR.NO_TYPE
				if not IR.is_enum(type_table, enum_type)
					error = "unknown enum: " + target
				else
					reference = IR.enum_index(type_table, enum_type, name(parsed, node.left))
					type = enum_type
					if reference < 0
						error = "unknown enum label"
			Parser.UnionConstruct
				let target = type_member_name(parsed, i, node.token)
				type = record_types.get(target) or IR.NO_TYPE
				if not IR.is_union(type_table, type)
					error = "unknown union: " + target
				else
					reference = IR.union_index(type_table, type, name(parsed, node.right))
					if reference < 0
						error = "unknown union alternative"
					elif not IR.compatible(type_table, types[!node.left], IR.union_payload(type_table, type, reference))
						error = "union payload type mismatch"
			Parser.EnumIndex
				let enum_type = record_types.get(type_member_name(parsed, i, node.token)) or IR.NO_TYPE
				type = integer
				if not IR.is_enum(type_table, enum_type) and not IR.is_union(type_table, enum_type)
					error = "enum/union index requires enum or union type"
				elif node.left >= 0
					if IR.is_union(type_table, enum_type) and IR.is_record(type_table, types[!node.left]) and not Parser.kind_is(parsed.nodes[!node.left].kind, Parser.Call())
						error = "union index requires tagged value or direct constructor"
					else
						let accepted = accept_value(parsed, type_table, node.left, types[!node.left], enum_type, conversions, "enum index requires matching enum value")
						conversions = accepted.conversions
						error = accepted.error
				else
					let target = name(parsed, node.right)
					let binding = bindings.get(target) or Binding(-1, false, -1)
					if binding.node >= 0
						reference = binding.node
						if types[!reference] != enum_type
							error = "enum index requires matching enum value"
					else
						var index = IR.enum_index(type_table, enum_type, target)
						if IR.is_union(type_table, enum_type)
							index = IR.union_index(type_table, enum_type, target)
						if index < 0
							error = "unknown enum index label"
						else
							reference = -index - 2
			Parser.OptionalConstruct
				let resolved = resolve_type(parsed, node.token, type_table, record_types)
				type_table = resolved.table
				if not IR.runtime_type(type_table, resolved.type)
					error = "invalid optional payload type"
				else
					let optional = IR.intern_optional(type_table, resolved.type)
					type_table = optional.table
					type = optional.id
					if node.left >= 0
						let accepted = accept_value(parsed, type_table, node.left, types[!node.left], resolved.type, conversions, "optional payload type mismatch")
						conversions = accepted.conversions
						error = accepted.error
			Parser.DictLiteral
				let resolved = resolve_type(parsed, node.token, type_table, record_types)
				type_table = resolved.table
				type = resolved.type
				if not IR.is_dict(type_table, type)
					error = "invalid dictionary constructor"
			Parser.DictPair
				type = -1
			Parser.DictGet
				let source = types[!node.left]
				if not IR.is_dict(type_table, source)
					error = "get requires dictionary"
				elif types[!node.right] != IR.dict_key(type_table, source)
					error = "dictionary key type mismatch"
				else
					let interned = IR.intern_optional(type_table, IR.dict_value(type_table, source))
					type_table = interned.table
					type = interned.id
			Parser.DictInsert
				type = types[!node.left]
				let pair = parsed.nodes[!node.right]
				if not IR.is_dict(type_table, type) or types[!pair.left] != IR.dict_key(type_table, type)
					error = "dictionary insert type mismatch"
				else
					let accepted = accept_value(parsed, type_table, pair.right, types[!pair.right], IR.dict_value(type_table, type), conversions, "dictionary insert type mismatch")
					conversions = accepted.conversions
					error = accepted.error
			Parser.ArrayLiteral
				var element = integer
				if name(parsed, node.token) == "Array"
					let resolved = resolve_type(parsed, node.token, type_table, record_types)
					type_table = resolved.table
					type = resolved.type
					element = IR.array_element(type_table, type)
				else
					if node.right == 0
						error = "empty array literal requires Array[T]()"
					else
						element = types[!parsed.nodes[!node.left].left]
					let expected = contexts.get(i) or IR.NO_TYPE
					if IR.is_array(type_table, expected)
						element = IR.array_element(type_table, expected)
						if IR.runtime_type(type_table, element)
							type = expected
					if type == IR.NO_TYPE and IR.runtime_type(type_table, element)
						let interned = IR.intern_array(type_table, element)
						type_table = interned.table
						type = interned.id
				if type == IR.NO_TYPE
					error = "unsupported array element type"
				var arg = node.left
				while arg >= 0
					let item = parsed.nodes[!arg].left
					# Untyped literals must stay homogeneous; do not infer a union
					# context merely because the first element is already tagged.
					if (contexts.get(i) or IR.NO_TYPE) == IR.NO_TYPE and types[!item] != element
						error = "array element type mismatch"
					else
						let accepted = accept_value(parsed, type_table, item, types[!item], element, conversions, "array element type mismatch")
						conversions = accepted.conversions
						if accepted.error != ""
							error = accepted.error
					arg = parsed.nodes[!arg].right
			Parser.ArrayRead | Parser.ArrayGet
				let source = types[!node.left]
				if IR.is_dict(type_table, source)
					type = IR.dict_value(type_table, source)
					if types[!node.right] != IR.dict_key(type_table, source)
						error = "dictionary key type mismatch"
				else
					type = IR.array_element(type_table, source)
					if type == IR.NO_TYPE or types[!node.right] != integer
						error = "checked array read requires array and i64 index"
				if error == "" and Parser.kind_is(node.kind, Parser.ArrayGet())
					let interned = IR.intern_optional(type_table, type)
					type_table = interned.table
					type = interned.id
			Parser.ArrayAppend
				type = types[!node.left]
				if not IR.is_array(type_table, type)
					error = "append element type mismatch"
				else
					let accepted = accept_value(parsed, type_table, node.right, types[!node.right], IR.array_element(type_table, type), conversions, "append element type mismatch")
					conversions = accepted.conversions
					error = accepted.error
			Parser.ArrayIndex
				type = integer
				if types[!node.left] != integer or types[!node.right] != integer
					error = "array iteration requires i64 bounds"
				if depth == len(scopes)
					scopes = scopes.append(bindings)
				else
					scopes[!depth] = bindings
				depth += 1
			Parser.ArrayElement
				let iterable = types[!node.left]
				if IR.is_dict(type_table, iterable)
					type = IR.dict_key(type_table, iterable)
				else
					type = IR.array_element(type_table, iterable)
				if type == IR.NO_TYPE or types[!node.right] != integer
					error = "iteration requires array or dictionary and i64 index"
				bindings = bindings.insert(name(parsed, node.token), Binding(i, false, depth - 1))
			Parser.Zero
				type = integer
			Parser.ArrayTarget
				if node.left >= 0
					type = types[!node.left]
				else
					let target = name(parsed, node.token)
					let binding = bindings.get(target) or Binding(-1, false, -1)
					reference = binding.node
					if reference < 0
						error = "unknown name: " + target
					elif not binding.mutable
						error = "cannot assign to immutable binding: " + target
					else
						type = types[!reference]
				if not IR.is_array(type_table, type) or types[!node.right] != integer
					error = "indexed assignment requires array and i64 index"
			Parser.ArraySet
				let accepted = accept_value(parsed, type_table, node.right, types[!node.right], IR.array_element(type_table, types[!node.left]), conversions, "array assignment type mismatch")
				conversions = accepted.conversions
				error = accepted.error
			Parser.FieldRead
				let source = types[!node.left]
				reference = IR.field_index(type_table, source, name(parsed, node.token))
				if reference < 0
					error = "unknown record field: " + name(parsed, node.token)
				else
					type = type_table.entries[!source].fields[!reference].type
			Parser.ArrayFieldUpdate
				type = types[!node.left]
				reference = IR.field_index(type_table, type, name(parsed, node.token))
				if reference < 0
					error = "unknown record field: " + name(parsed, node.token)
				else
					let accepted = accept_value(parsed, type_table, node.right, types[!node.right], type_table.entries[!type].fields[!reference].type, conversions, "assignment type mismatch")
					conversions = accepted.conversions
					error = accepted.error
			Parser.FieldAssign
				let base = parsed.nodes[!node.left]
				let target = name(parsed, base.token)
				let binding = bindings.get(target) or Binding(-1, false, -1)
				type = types[!node.left]
				reference = IR.field_index(type_table, type, name(parsed, node.token))
				if not binding.mutable
					error = "cannot assign to immutable binding: " + target
				elif reference < 0
					error = "unknown record field: " + name(parsed, node.token)
				else
					let accepted = accept_value(parsed, type_table, node.right, types[!node.right], type_table.entries[!type].fields[!reference].type, conversions, "assignment type mismatch")
					conversions = accepted.conversions
					error = accepted.error
			Parser.Parameter
				let target = name(parsed, node.token)
				type = parameter_types.get(i) or IR.NO_TYPE
				if (bindings.get(target) or Binding(-1, false, -1)).node >= 0
					error = "duplicate parameter: " + target
				bindings = bindings.insert(target, Binding(i, false, depth))
			Parser.Argument
				type = types[!node.left]
			Parser.Call
				let target = call_name(parsed, i)
				reference = functions.get(target) or -1
				let constructor = constructors.get(target) or Constructor(IR.NO_TYPE, [])
				var parameters = Array[i64]()
				if (bindings.get(target) or Binding(-1, false, -1)).node >= 0
					error = "local value is not callable: " + target
				elif constructor.type != IR.NO_TYPE
					type = constructor.type
					constructor_calls = constructor_calls.insert(i, constructor)
					for field in constructor.parameters
						parameters = parameters.append(field.type)
				elif reference < 0 and (enum_labels.get(target) or IR.NO_TYPE) >= 0
					type = enum_labels.get(target) or IR.NO_TYPE
					reference = -IR.enum_index(type_table, type, target) - 2
				elif reference < 0
					error = "unknown or ambiguous function/enum label: " + target
				else
					let signature = signatures[!reference]
					type = signature.result
					parameters = signature.parameters
					if selected >= 0 and reference == selected
						for position in 0..len(parameters)
							let parameter = parsed.functions[!selected].parameters[!position]
							if parsed.nodes[!parameter].right < 0
								parameters[!position] = IR.NO_TYPE
				if reference < -1
					parameters = []
				if error == ""
					if node.right != len(parameters)
						error = "argument count mismatch: " + target
					else
						var argument = node.left
						var parameter = node.right
						while argument >= 0
							parameter -= 1
							let item = parsed.nodes[!argument].left
							if parameters[!parameter] != IR.NO_TYPE
								let accepted = accept_value(parsed, type_table, item, types[!item], parameters[!parameter], conversions, "argument type mismatch: " + target)
								conversions = accepted.conversions
								if accepted.error != ""
									error = accepted.error
							if reference >= 0 and signatures[!reference].result_parameter == parameter
								var base_type = types[!item]
								if parameters[!parameter] != IR.NO_TYPE
									base_type = parameters[!parameter]
								type = projected_result(type_table, base_type, signatures[!reference].result_path)
								if type == IR.NO_TYPE
									error = "invalid inferred result projection: " + target
							argument = parsed.nodes[!argument].right
			Parser.Return
				type = signatures[!function_id].result
				let accepted = accept_value(parsed, type_table, node.left, types[!node.left], type, conversions, "return type mismatch")
				conversions = accepted.conversions
				error = accepted.error
			Parser.OptionalUnwrap | Parser.OptionalExit
				let input = types[!node.left]
				type = IR.optional_payload(type_table, input)
				if type == IR.NO_TYPE
					error = "unwrapping requires Optional[T]"
			Parser.StringJoin
				type = text
				let operand = types[!node.right]
				if types[!node.left] != text or not IR.is_array(type_table, operand) or IR.array_element(type_table, operand) != text
					error = "join requires string separator and Array[string]"
			Parser.StringByteAt | Parser.StringFind
				type = optional
				var argument = text
				if Parser.kind_is(node.kind, Parser.StringByteAt())
					argument = integer
				if types[!node.left] != text or types[!node.right] != argument
					error = "invalid string lookup operands"
			Parser.SliceBounds
				if types[!node.left] != integer or types[!node.right] != integer
					error = "slice bounds must be i64"
			Parser.StringSlice
				type = text
				if types[!node.left] != text
					error = "slice requires string"
			Parser.StringStarts | Parser.StringEnds
				type = boolean
				if types[!node.left] != text or types[!node.right] != text
					error = "string predicate requires strings"
			Parser.RangeBinding
				type = integer
				if types[!node.left] != integer or types[!node.right] != integer
					error = "range bounds must be i64"
				if depth == len(scopes)
					scopes = scopes.append(bindings)
				else
					scopes[!depth] = bindings
				depth += 1
				# The loop binder encloses the body, which may shadow it.
				bindings = bindings.insert(name(parsed, node.token), Binding(i, false, depth - 1))
			Parser.RangeCompare
				type = boolean
			Parser.One
				type = integer
			Parser.RangeCondition | Parser.RangeStep
				type = -1
			Parser.Variable | Parser.FieldTarget | Parser.Assign
				let target = name(parsed, node.token)
				let binding = bindings.get(target) or Binding(-1, false, -1)
				reference = binding.node
				if reference < 0
					error = "unknown name: " + target
				else
					type = types[!reference]
					if Parser.kind_is(node.kind, Parser.FieldTarget()) and not binding.mutable
						error = "cannot assign to immutable binding: " + target
					if Parser.kind_is(node.kind, Parser.Assign())
						if not binding.mutable
							error = "cannot assign to immutable binding: " + target
						else
							let accepted = accept_value(parsed, type_table, node.left, types[!node.left], type, conversions, "assignment type mismatch")
							conversions = accepted.conversions
							error = accepted.error
			Parser.Binding | Parser.MutableBinding
				let target = name(parsed, node.token)
				let existing = bindings.get(target) or Binding(-1, false, -1)
				if existing.node >= 0 and existing.depth == depth
					error = "duplicate binding: " + target
				type = types[!node.left]
				if node.right >= 0
					let resolved = resolve_type(parsed, node.right, type_table, record_types)
					type_table = resolved.table
					let expected = resolved.type
					if expected == IR.NO_TYPE
						error = "unknown type: " + name(parsed, node.right)
					else
						let accepted = accept_value(parsed, type_table, node.left, type, expected, conversions, "binding type mismatch")
						conversions = accepted.conversions
						error = accepted.error
					type = expected
				bindings = bindings.insert(target, Binding(i, Parser.kind_is(node.kind, Parser.MutableBinding()), depth))
			Parser.IntegerLiteral
				type = integer
			Parser.BooleanLiteral
				type = boolean
			Parser.StringLiteral | Parser.StringPart
				type = text
			Parser.Length
				type = integer
				if types[!node.left] != text and not IR.is_array(type_table, types[!node.left]) and not IR.is_dict(type_table, types[!node.left])
					error = "len requires string, array or dictionary"
			Parser.StringConvert
				type = text
				let source = types[!node.left]
				if IR.is_enum(type_table, source)
					error = "str(enum) requires an explicit conversion"
				elif IR.is_record(type_table, source) or IR.is_array(type_table, source) or IR.is_dict(type_table, source)
					error = "str(aggregate) is not yet supported"
				elif IR.is_optional(type_table, source) and source != optional
					error = "str(Optional[T]) is currently supported only for i64"
			Parser.Add
				type = types[!node.left]
				if (type != integer and type != text) or types[!node.right] != type
					error = "invalid addition operands"
			Parser.Not
				type = boolean
				if types[!node.left] != boolean
					error = "not requires bool"
			Parser.OrStart
				type = boolean
				if IR.is_optional(type_table, types[!node.left])
					type = IR.optional_payload(type_table, types[!node.left])
				elif types[!node.left] != boolean
					error = "or requires bool or Optional[T]"
			Parser.AndStart
				type = boolean
				if types[!node.left] != boolean
					error = "logical operator requires bool"
			Parser.LogicalEnd
				type = types[!node.left]
				let accepted = accept_value(parsed, type_table, node.right, types[!node.right], type, conversions, "logical/default operand type mismatch")
				conversions = accepted.conversions
				error = accepted.error
			Parser.Print | Parser.Eprint
				type = types[!node.left]
				if IR.is_optional(type_table, type)
					error = "printing Optional requires unwrapping or a default"
				elif IR.is_enum(type_table, type)
					error = "printing enum requires explicit index or conversion"
				elif IR.is_record(type_table, type) or IR.is_array(type_table, type)
					error = "printing aggregates is not yet supported"
			Parser.If | Parser.While
				if types[!node.left] != boolean
					error = "condition must be bool"
				if depth == len(scopes)
					scopes = scopes.append(bindings)
				else
					scopes[!depth] = bindings
				depth += 1
			Parser.Else
				bindings = scopes[!depth - 1]
			Parser.EndIf | Parser.EndWhile
				depth -= 1
				bindings = scopes[!depth]
			Parser.LoopStart | Parser.Break | Parser.Continue
				type = -1
			Parser.Compare
				type = boolean
				let op = name(parsed, node.token)
				if IR.is_array(type_table, types[!node.left]) or IR.is_dict(type_table, types[!node.left]) or types[!node.left] != types[!node.right] or ((types[!node.left] == boolean or IR.is_enum(type_table, types[!node.left]) or IR.is_optional(type_table, types[!node.left]) or IR.is_record(type_table, types[!node.left]) or IR.is_union(type_table, types[!node.left])) and op != "==" and op != "!=")
					error = "invalid comparison operands"
			Parser.Negate | Parser.Subtract | Parser.Multiply | Parser.Divide | Parser.Remainder | Parser.BitAnd | Parser.BitOr | Parser.ShiftLeft | Parser.ShiftRight
				type = integer
				if types[!node.left] != integer
					error = "expected i64 operand"
				if node.right >= 0 and types[!node.right] != integer
					error = "expected i64 operand"
		if error != ""
			return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, error, parsed.tokens[!node.token].line)
		references = references.append(reference)
		types = types.append(type)
	return Checked(parsed, type_table, signatures, references, types, constructor_calls, match_fields, conversions, external_targets, record_types, constructors, "", 0)

# Preserve the explicit single-file entry point and rejection of imports.
# A generic template is identified by one or more omitted parameter types.
export def generic_signature(signature: Signature) -> bool
	for parameter in signature.parameters
		if parameter == IR.NO_TYPE
			return true
	return false

export def check_specialization(parsed: Parser.State, initial_table: IR.TypeTable, external: Array[External], imported_types: Dict[string, i64], imported_constructors: Dict[string, Constructor], function_id: i64, arguments: Array[i64]) -> Checked
	return check_module_inner(parsed, initial_table, external, imported_types, imported_constructors, false, function_id, arguments)

export def check_module(parsed: Parser.State, initial_table: IR.TypeTable, external: Array[External], imported_types: Dict[string, i64], imported_constructors: Dict[string, Constructor], needs_main: bool) -> Checked
	return check_module_inner(parsed, initial_table, external, imported_types, imported_constructors, needs_main, -1, [])

export def check(parsed: Parser.State) -> Checked
	if len(parsed.imports) != 0
		let table = IR.runtime_types()
		return Checked(parsed, table, [], [], [], Dict[i64, Constructor](), Dict[i64, Array[i64]](), Dict[i64, Conversion](), [], Dict[string, i64](), Dict[string, Constructor](), "source imports require module linking (not yet implemented)", parsed.tokens[!parsed.imports[!0].token].line)
	return check_module(parsed, IR.runtime_types(), [], Dict[string, i64](), Dict[string, Constructor](), true)
