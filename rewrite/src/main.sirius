import emit_c alias Emit
import modules alias Modules
import lower alias Lower

let EXIT_COMPILE_ERROR = 1
let EXIT_IO_OR_USAGE_ERROR = 2

def main() -> i64
	let args = arguments()
	if len(args) == 4 and args[!1] == "--check-modules"
		let graph = Modules.load(args[!2], args[!3])
		if graph.error != ""
			eprint("ERROR " + graph.error)
			return EXIT_COMPILE_ERROR
		for unit in graph.units
			print(unit.name)
		return 0
	if len(args) == 5 and args[!1] == "--compile-modules"
		let graph = Modules.load(args[!2], args[!3])
		if graph.error != ""
			eprint("ERROR " + graph.error)
			return EXIT_COMPILE_ERROR
		let result = Emit.emit(Lower.lower_graph(graph))
		if result.error != ""
			eprint("ERROR " + str(result.line) + ": " + result.error)
			return EXIT_COMPILE_ERROR
		if not write_text(args[!4], result.code)
			eprint("cannot write output: " + args[!4])
			return EXIT_IO_OR_USAGE_ERROR
		return 0
	if len(args) != 3
		eprint("usage: rewrite input.sirius output.c | rewrite --check-modules source-root Entry | rewrite --compile-modules source-root Entry output.c")
		return EXIT_IO_OR_USAGE_ERROR
	let contents = read_text(args[!1]) else return EXIT_IO_OR_USAGE_ERROR
	let result = Emit.compile(contents)
	if result.error != ""
		eprint("ERROR " + str(result.line) + ": " + result.error)
		return EXIT_COMPILE_ERROR
	if not write_text(args[!2], result.code)
		eprint("cannot write output: " + args[!2])
		return EXIT_IO_OR_USAGE_ERROR
	return 0
