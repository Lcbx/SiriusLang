import emit_c alias Emit

let EXIT_COMPILE_ERROR = 1
let EXIT_IO_OR_USAGE_ERROR = 2

def main() -> i64
	let args = arguments()
	if len(args) != 3
		eprint("usage: rewrite input.sirius output.c")
		return EXIT_IO_OR_USAGE_ERROR
	let contents = read_text(args[!1]) else return EXIT_IO_OR_USAGE_ERROR
	let result = Emit.compile(contents)
	if result.error != ""
		eprint("ERROR " + str(result.line) + ": " + result.error)
		return EXIT_COMPILE_ERROR
	if not write_text(args[!2], result.code)
		eprint("cannot write output: " + args[!2])
		return EXIT_IO_OR_USAGE_ERROR
	return 0
