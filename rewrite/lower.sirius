import parser alias Parser
import lexer alias Lex
import semantic alias Semantic
import ir alias IR

let DECIMAL_RADIX = 10
let I64_MAX_DECIMAL_PREFIX = 922337203685477580
let I64_MAX_DECIMAL_LAST_DIGIT = 7

rec Decoded(value: string, error: string)

def decode(source: string, begin: i64, end: i64, interpolated: bool) -> Decoded
	var parts = Array[string]()
	var start = begin
	var i = start
	while i < end
		if (source.byte_at(i) or 0) != Lex.ASCII_BACKSLASH
			i += 1
			continue
		parts = parts.append(source.slice(start, i))
		i += 1
		let escaped = source.byte_at(i) or 0
		var value = ""
		if escaped == Lex.ASCII_LOWER_N
			value = "\n"
		elif escaped == Lex.ASCII_LOWER_T
			value = "\t"
		elif escaped == Lex.ASCII_LOWER_R
			value = "\r"
		elif escaped == Lex.ASCII_ZERO
			value = "\0"
		elif escaped == Lex.ASCII_BACKSLASH or escaped == Lex.ASCII_DOUBLE_QUOTE or escaped == Lex.ASCII_SINGLE_QUOTE
			value = source.slice(i, i + 1)
		elif interpolated and escaped == Lex.ASCII_DOLLAR and (source.byte_at(i + 1) or 0) == Lex.ASCII_OPEN_BRACE
			value = "$"
		else
			return Decoded("", "unsupported string escape")
		parts = parts.append(value)
		i += 1
		start = i
	parts = parts.append(source.slice(start, end))
	return Decoded("".join(parts), "")

def copy(dst: i64, input: i64, type: i64, table: IR.TypeTable) -> IR.Instruction
	if IR.is_record(table, type)
		return IR.CopyRecord(dst, input)
	if IR.is_optional(table, type)
		return IR.OptionalCopy(dst, input)
	if type == IR.TYPE_STRING
		return IR.StringCopy(dst, input)
	return IR.Copy(dst, input)

def lower_function(checked: Semantic.Checked, function_id: i64) -> IR.Program
	let parsed = checked.parsed
	let source = parsed.source
	let function = parsed.functions[!function_id]
	var instructions = Array[IR.Instruction]()
	for i in function.start..function.end
		let node = parsed.nodes[!i]
		match node.kind
			Parser.FieldRead
				var input = node.left
				if Parser.kind_is(parsed.nodes[!input].kind, Parser.FieldTarget())
					input = checked.references[!input]
				instructions = instructions.append(IR.ReadField(i, input, checked.references[!i]))
			Parser.FieldTarget
				instructions = instructions.append(IR.Nop())
			Parser.FieldAssign
				instructions = instructions.append(IR.SetField(checked.references[!node.left], checked.references[!i], node.right))
			Parser.Parameter | Parser.Argument
				instructions = instructions.append(IR.Nop())
			Parser.Call
				var reversed = Array[i64]()
				var argument = node.left
				while argument >= 0
					let input = parsed.nodes[!argument]
					reversed = reversed.append(input.left)
					argument = input.right
				var arguments = Array[i64]()
				for index in 0..len(reversed)
					arguments = arguments.append(reversed[!len(reversed) - 1 - index])
				let constructor = checked.constructor_calls.get(i) or Semantic.Constructor(IR.NO_TYPE, [])
				if constructor.type != IR.NO_TYPE
					var fields = Array[i64]()
					for field in checked.type_table.entries[!constructor.type].fields
						for parameter in 0..len(constructor.parameters)
							if constructor.parameters[!parameter].name == field.name
								fields = fields.append(arguments[!parameter])
					instructions = instructions.append(IR.MakeRecord(i, constructor.type, fields))
				else
					instructions = instructions.append(IR.Call(i, checked.references[!i], arguments))
			Parser.OptionalUnwrap
				instructions = instructions.append(IR.OptionalUnwrap(i, node.left))
			Parser.OptionalExit
				instructions = instructions.append(IR.OptionalDefault(i, node.left, node.right))
			Parser.StringByteAt
				instructions = instructions.append(IR.StringByteAt(i, node.left, node.right))
			Parser.StringFind
				instructions = instructions.append(IR.StringFind(i, node.left, node.right))
			Parser.SliceBounds
				instructions = instructions.append(IR.Nop())
			Parser.StringSlice
				let bounds = parsed.nodes[!node.right]
				instructions = instructions.append(IR.StringSlice(i, node.left, bounds.left, bounds.right))
			Parser.StringStarts
				instructions = instructions.append(IR.StringStarts(i, node.left, node.right))
			Parser.StringEnds
				instructions = instructions.append(IR.StringEnds(i, node.left, node.right))
			Parser.StringLiteral | Parser.StringPart
				let token = parsed.tokens[!node.token]
				let part = Parser.kind_is(node.kind, Parser.StringPart())
				var begin = token.start + 1
				var end = token.end - 1
				if part
					begin = node.left
					end = node.right
				let literal = decode(source, begin, end, part)
				if literal.error != ""
					return IR.Program(instructions, 0, literal.error, token.line)
				instructions = instructions.append(IR.StringConstant(i, literal.value))
			Parser.Length
				instructions = instructions.append(IR.StringLength(i, node.left))
			Parser.StringConvert
				let type = checked.types[!node.left]
				if type == IR.TYPE_STRING
					instructions = instructions.append(IR.StringCopy(i, node.left))
				else
					var format: IR.FormatType = IR.Integer()
					if type == IR.TYPE_BOOL
						format = IR.FormatType.Boolean(IR.Boolean())
					elif IR.is_optional(checked.type_table, type)
						format = IR.FormatType.OptionalInteger(IR.OptionalInteger())
					instructions = instructions.append(IR.StringFormat(i, node.left, format))
			Parser.RangeBinding
				instructions = instructions.append(IR.Copy(i, node.left))
			Parser.One
				instructions = instructions.append(IR.Constant(i, 1))
			Parser.RangeCompare
				# Match the existing compiler: a bare upper-bound name uses
				# its binding slot, while other expressions retain their value.
				var upper = node.right
				if Parser.kind_is(parsed.nodes[!upper].kind, Parser.Variable())
					upper = checked.references[!upper]
				instructions = instructions.append(IR.Compare(i, node.left, upper, "<"))
			Parser.RangeCondition
				instructions = instructions.append(IR.Branch(node.left, node.right))
			Parser.RangeStep
				instructions = instructions.append(IR.Add(node.left, node.left, node.right))
			Parser.AndStart | Parser.OrStart
				if IR.is_optional(checked.type_table, checked.types[!node.left])
					instructions = instructions.append(IR.OptionalDefault(i, node.left, node.right))
				else
					instructions = instructions.append(IR.ShortCircuit(i, node.left, node.right, Parser.kind_is(node.kind, Parser.OrStart())))
			Parser.LogicalEnd
				instructions = instructions.append(IR.Copy(node.left, node.right))
			Parser.BooleanLiteral
				let token = parsed.tokens[!node.token]
				var value = 0
				if source.slice(token.start, token.end) == "true"
					value = 1
				instructions = instructions.append(IR.Constant(i, value))
			Parser.Compare
				let token = parsed.tokens[!node.token]
				let op = source.slice(token.start, token.end)
				if checked.types[!node.left] == IR.TYPE_STRING
					instructions = instructions.append(IR.StringCompare(i, node.left, node.right, op))
				else
					instructions = instructions.append(IR.Compare(i, node.left, node.right, op))
			Parser.If | Parser.While
				instructions = instructions.append(IR.Branch(node.left, node.right))
			Parser.Else | Parser.Break
				instructions = instructions.append(IR.Jump(node.right))
			Parser.EndWhile | Parser.Continue
				instructions = instructions.append(IR.Jump(node.left))
			Parser.LoopStart | Parser.EndIf
				instructions = instructions.append(IR.Nop())
			Parser.IntegerLiteral
				let token = parsed.tokens[!node.token]
				var value = 0
				for offset in token.start..token.end
					let digit = (source.byte_at(offset) or -1) - Lex.ASCII_ZERO
					# Check before multiplying the decimal prefix and adding its final digit.
					if value > I64_MAX_DECIMAL_PREFIX or (value == I64_MAX_DECIMAL_PREFIX and digit > I64_MAX_DECIMAL_LAST_DIGIT)
						return IR.Program(instructions, 0, "integer literal out of range", token.line)
					value = value * DECIMAL_RADIX + digit
				instructions = instructions.append(IR.Constant(i, value))
			Parser.Negate
				instructions = instructions.append(IR.Negate(i, node.left))
			Parser.Not
				instructions = instructions.append(IR.Not(i, node.left))
			Parser.Add
				if checked.types[!i] == IR.TYPE_STRING
					instructions = instructions.append(IR.StringConcat(i, node.left, node.right))
				else
					instructions = instructions.append(IR.Add(i, node.left, node.right))
			Parser.Subtract
				instructions = instructions.append(IR.Subtract(i, node.left, node.right))
			Parser.Multiply
				instructions = instructions.append(IR.Multiply(i, node.left, node.right))
			Parser.Divide
				instructions = instructions.append(IR.Divide(i, node.left, node.right))
			Parser.Remainder
				instructions = instructions.append(IR.Remainder(i, node.left, node.right))
			Parser.BitAnd
				instructions = instructions.append(IR.BitAnd(i, node.left, node.right))
			Parser.BitOr
				instructions = instructions.append(IR.BitOr(i, node.left, node.right))
			Parser.ShiftLeft
				instructions = instructions.append(IR.ShiftLeft(i, node.left, node.right))
			Parser.ShiftRight
				instructions = instructions.append(IR.ShiftRight(i, node.left, node.right))
			Parser.Variable
				instructions = instructions.append(copy(i, checked.references[!i], checked.types[!i], checked.type_table))
			Parser.Binding | Parser.MutableBinding
				instructions = instructions.append(copy(i, node.left, checked.types[!i], checked.type_table))
			Parser.Assign
				instructions = instructions.append(copy(checked.references[!i], node.left, checked.types[!i], checked.type_table))
			Parser.Print | Parser.Eprint
				var type: IR.OutputType = IR.Integer()
				if checked.types[!node.left] == IR.TYPE_BOOL
					type = IR.OutputType.Boolean(IR.Boolean())
				elif checked.types[!node.left] == IR.TYPE_STRING
					type = IR.OutputType.Text(IR.Text())
				instructions = instructions.append(IR.Output(node.left, type, Parser.kind_is(node.kind, Parser.Eprint())))
			Parser.Return
				instructions = instructions.append(IR.Return(node.left))
	# A reachable sentinel exposes a missing return; dead block markers are pruned.
	instructions = instructions.append(IR.Nop())
	var local = Array[IR.Instruction]()
	for instruction in instructions
		local = local.append(IR.rebase(instruction, function.start))
	return IR.prune(IR.Program(local, function.end - function.start, "", parsed.tokens[!function.token].line))

export def lower(source: string) -> IR.Module
	let checked = Semantic.check(Parser.parse(source))
	var functions = Array[IR.Function]()
	if checked.error != ""
		return IR.Module(functions, -1, checked.type_table, checked.error, checked.line)
	var entry = -1
	for id in 0..len(checked.signatures)
		let signature = checked.signatures[!id]
		let parsed = checked.parsed.functions[!id]
		let body = lower_function(checked, id)
		if body.error != ""
			return IR.Module(functions, -1, checked.type_table, body.error, body.line)
		var types = Array[i64]()
		for node in parsed.start..parsed.end
			types = types.append(checked.types[!node])
		functions = functions.append(IR.Function(signature.name, body, signature.parameters, signature.result, types))
		if signature.name == "main"
			entry = id
	return IR.Module(functions, entry, checked.type_table, "", 0)
