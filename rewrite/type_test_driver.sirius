import ir alias IR
import emit_c alias Emit

def entry(table: IR.TypeTable) -> IR.Module
	let body = IR.Program([IR.Constant(0, 0), IR.Return(0)], 1, "", 0)
	return IR.Module([IR.Function("main", body, [], IR.TYPE_I64, [IR.TYPE_I64])], 0, table, "", 0)

def main() -> i64
	let original = IR.initial_types()
	if IR.verify_types(original) != "" or IR.verify_module(entry(original)) != ""
		return 1
	let boolean = IR.intern_optional(original, IR.TYPE_BOOL)
	let integer = IR.intern_optional(boolean.table, IR.TYPE_I64)
	let text = IR.intern_optional(integer.table, IR.TYPE_STRING)
	let nested = IR.intern_optional(text.table, integer.id)
	let repeated = IR.intern_optional(nested.table, IR.TYPE_I64)
	if repeated.id != integer.id or len(repeated.table.entries) != len(nested.table.entries)
		return 2
	if IR.optional_payload(nested.table, nested.id) != integer.id
		return 3
	if IR.optional_payload(nested.table, integer.id) != IR.TYPE_I64
		return 4
	if IR.optional_payload(nested.table, text.id) != IR.TYPE_STRING or IR.optional_payload(nested.table, boolean.id) != IR.TYPE_BOOL
		return 5
	if IR.optional_payload(nested.table, IR.TYPE_I64) != IR.NO_TYPE or IR.is_optional(nested.table, IR.NO_TYPE)
		return 6
	if IR.verify_types(nested.table) != "" or IR.verify_module(entry(nested.table)) != ""
		return 7
	# Interning and later cache updates must preserve earlier table snapshots.
	if len(original.entries) != len(IR.initial_types().entries) or len(original.optionals) != 0
		return 8
	if IR.find_optional(boolean.table, IR.TYPE_I64) != IR.NO_TYPE
		return 9
	if IR.intern_optional(original, IR.NO_TYPE).id != IR.NO_TYPE or IR.intern_optional(original, len(original.entries)).id != IR.NO_TYPE
		return 10
	let again = IR.intern_optional(nested.table, integer.id)
	if again.id != nested.id or len(again.table.entries) != len(nested.table.entries)
		return 11
	var corrupt = integer.table
	corrupt.entries[!integer.id].payload = integer.id
	if IR.verify_module(entry(corrupt)) != "invalid optional payload type"
		return 12
	corrupt = integer.table
	corrupt.entries[!integer.id].payload = len(corrupt.entries)
	if IR.verify_module(entry(corrupt)) != "invalid optional payload type"
		return 13
	corrupt = integer.table
	corrupt.entries[!integer.id].payload = IR.NO_TYPE
	if IR.verify_module(entry(corrupt)) != "invalid optional payload type"
		return 14
	corrupt = integer.table
	corrupt.optionals = corrupt.optionals.insert(IR.TYPE_I64, boolean.id)
	if IR.verify_module(entry(corrupt)) != "noncanonical optional type"
		return 15
	corrupt = integer.table
	corrupt.entries = corrupt.entries.append(corrupt.entries[!integer.id])
	corrupt.optionals = corrupt.optionals.insert(IR.TYPE_STRING, len(corrupt.entries) - 1)
	if IR.verify_module(entry(corrupt)) != "noncanonical optional type"
		return 16
	corrupt = integer.table
	corrupt.entries[!IR.TYPE_I64].payload = IR.TYPE_I64
	if IR.verify_module(entry(corrupt)) != "invalid primitive descriptor"
		return 17
	corrupt = integer.table
	corrupt.optionals = corrupt.optionals.insert(IR.TYPE_STRING, integer.id)
	if IR.verify_module(entry(corrupt)) != "invalid optional type cache"
		return 18
	# Executable optionals now include scalar, managed and nested payload types.
	var unsupported = entry(nested.table)
	unsupported.functions = unsupported.functions.append(IR.Function("unused", IR.Program([IR.Return(0)], 1, "", 0), [boolean.id], boolean.id, [boolean.id]))
	if IR.verify_module(unsupported) != ""
		return 19
	unsupported.functions[!1].parameters = [nested.id]
	unsupported.functions[!1].result = nested.id
	unsupported.functions[!1].types = [nested.id]
	if IR.verify_module(unsupported) != ""
		return 20
	if IR.verify_module(entry(IR.TypeTable([], Dict[i64, i64](), Dict[string, i64]()))) != "missing primitive types"
		return 24
	# Explicit construction is type-checked at the IR boundary too.
	let made = IR.Function("main", IR.Program([IR.Constant(0, 7), IR.MakeOptional(1, 0), IR.OptionalUnwrap(2, 1), IR.Return(2)], 3, "", 0), [], IR.TYPE_I64, [IR.TYPE_I64, integer.id, IR.TYPE_I64])
	if IR.verify_module(IR.Module([made], 0, integer.table, "", 0)) != ""
		return 25
	let bad_dest = IR.Function("main", made.body, [], IR.TYPE_I64, [IR.TYPE_I64, IR.TYPE_I64, IR.TYPE_I64])
	if IR.verify_module(IR.Module([bad_dest], 0, integer.table, "", 0)) != "main: optional constructor requires optional destination"
		return 26
	let bad_slot = IR.Function("main", IR.Program([IR.Constant(0, 7), IR.MakeOptional(1, -2), IR.OptionalUnwrap(2, 1), IR.Return(2)], 3, "", 0), [], IR.TYPE_I64, made.types)
	if IR.verify_module(IR.Module([bad_slot], 0, integer.table, "", 0)) != "main: invalid optional payload slot"
		return 27
	let uninitialized = IR.Function("main", IR.Program([IR.Constant(0, 7), IR.MakeOptional(1, 2), IR.OptionalUnwrap(2, 1), IR.Return(2)], 3, "", 0), [], IR.TYPE_I64, made.types)
	if IR.verify_module(IR.Module([uninitialized], 0, integer.table, "", 0)) != "main: undefined input slot"
		return 28
	let bad_type = IR.Function("main", IR.Program([IR.StringConstant(0, "x"), IR.MakeOptional(1, 0), IR.OptionalUnwrap(2, 1), IR.Return(2)], 3, "", 0), [], IR.TYPE_I64, [IR.TYPE_STRING, integer.id, IR.TYPE_I64])
	if IR.verify_module(IR.Module([bad_type], 0, integer.table, "", 0)) != "main: slot type mismatch"
		return 29
	let absent_constructor = IR.Function("main", IR.Program([IR.MakeOptional(0, -1), IR.OptionalDefault(1, 0, 3), IR.Constant(1, 9), IR.Return(1)], 2, "", 0), [], IR.TYPE_I64, [integer.id, IR.TYPE_I64])
	if IR.verify_module(IR.Module([absent_constructor], 0, integer.table, "", 0)) != ""
		return 30
	# Typed join and dictionary cursor instructions reject incorrect layouts.
	let strings = IR.intern_array(nested.table, IR.TYPE_STRING)
	let join_code = IR.Program([IR.StringConstant(0, ","), IR.StringConstant(1, "a"), IR.MakeArray(2, [1]), IR.StringJoin(3, 0, 2), IR.StringLength(4, 3), IR.Return(4)], 5, "", 0)
	let joining = IR.Module([IR.Function("main", join_code, [], IR.TYPE_I64, [IR.TYPE_STRING, IR.TYPE_STRING, strings.id, IR.TYPE_STRING, IR.TYPE_I64])], 0, strings.table, "", 0)
	if IR.verify_module(joining) != "" or Emit.emit(joining).error != ""
		return 31
	let not_strings = IR.intern_array(strings.table, IR.TYPE_I64)
	var join_bad = IR.Module([IR.Function("main", join_code, [], IR.TYPE_I64, [IR.TYPE_STRING, IR.TYPE_STRING, not_strings.id, IR.TYPE_STRING, IR.TYPE_I64])], 0, not_strings.table, "", 0)
	if IR.verify_module(join_bad) != "main: slot type mismatch"
		return 32
	let empty_bad = IR.Program([IR.StringConstant(0, ","), IR.MakeArray(2, []), IR.StringJoin(3, 0, 2), IR.Constant(4, 0), IR.Return(4)], 5, "", 0)
	join_bad = IR.Module([IR.Function("main", empty_bad, [], IR.TYPE_I64, [IR.TYPE_STRING, IR.TYPE_I64, not_strings.id, IR.TYPE_STRING, IR.TYPE_I64])], 0, not_strings.table, "", 0)
	if IR.verify_module(join_bad) != "main: join requires Array[string]"
		return 33
	let dict = IR.intern_dict(strings.table, IR.TYPE_STRING, IR.TYPE_I64)
	let iter_code = IR.Program([IR.MakeDict(0), IR.Constant(1, -1), IR.DictNext(2, 0, 1), IR.DictKey(3, 0, 1), IR.Constant(4, 0), IR.Return(4)], 5, "", 0)
	let iterating = IR.Module([IR.Function("main", iter_code, [], IR.TYPE_I64, [dict.id, IR.TYPE_I64, IR.TYPE_BOOL, IR.TYPE_STRING, IR.TYPE_I64])], 0, dict.table, "", 0)
	if IR.verify_module(iterating) != "" or Emit.emit(iterating).error != ""
		return 34
	let wrong_cursor = IR.Module([IR.Function("main", iter_code, [], IR.TYPE_I64, [dict.id, IR.TYPE_STRING, IR.TYPE_BOOL, IR.TYPE_STRING, IR.TYPE_I64])], 0, dict.table, "", 0)
	if IR.verify_module(wrong_cursor) != "main: slot type mismatch"
		return 35
	let wrong_key = IR.Module([IR.Function("main", iter_code, [], IR.TYPE_I64, [dict.id, IR.TYPE_I64, IR.TYPE_BOOL, IR.TYPE_I64, IR.TYPE_I64])], 0, dict.table, "", 0)
	if IR.verify_module(wrong_key) != "main: slot type mismatch"
		return 36
	let bad_iter_code = IR.Program([IR.Constant(0, 0), IR.Constant(1, -1), IR.DictNext(2, 0, 1), IR.DictKey(3, 0, 1), IR.Constant(4, 0), IR.Return(4)], 5, "", 0)
	let bad_iter_source = IR.Module([IR.Function("main", bad_iter_code, [], IR.TYPE_I64, [IR.TYPE_I64, IR.TYPE_I64, IR.TYPE_BOOL, IR.TYPE_STRING, IR.TYPE_I64])], 0, dict.table, "", 0)
	if IR.verify_module(bad_iter_source) != "main: invalid dictionary iteration"
		return 37
	# Optional[bool] was interned first: Optional[i64]'s ID differs from the
	# default table. Both backends must use descriptors for slots and calls.
	if integer.id == IR.find_optional(IR.runtime_types(), IR.TYPE_I64)
		return 21
	let main_body = IR.Program([IR.StringConstant(0, "a"), IR.Constant(1, 0), IR.StringByteAt(2, 0, 1), IR.Call(3, 1, [2]), IR.OptionalDefault(4, 3, 6), IR.Constant(4, 9), IR.Output(4, IR.Integer(), false), IR.Constant(5, 0), IR.Return(5)], 6, "", 0)
	let main_function = IR.Function("main", main_body, [], IR.TYPE_I64, [IR.TYPE_STRING, IR.TYPE_I64, integer.id, integer.id, IR.TYPE_I64, IR.TYPE_I64])
	let identity = IR.Function("identity", IR.Program([IR.Return(0)], 1, "", 0), [integer.id], integer.id, [integer.id])
	let module = IR.Module([main_function, identity], 0, nested.table, "", 0)
	let args = arguments()
	if len(args) == 2
		let code = Emit.emit(module)
		if code.error != ""
			return 22
		if not write_text(args[!1], code.code)
			return 23
	return 0
