# A type ID is an index in a canonical table, not an encoded type kind.
export enum TypeKind
	I64
	Bool
	String
	Optional
	Record

export let NO_TYPE = -1
export let TYPE_I64 = 0
export let TYPE_BOOL = 1
export let TYPE_STRING = 2
let PRIMITIVE_TYPE_COUNT = 3

export rec RecordField(name: string, type: i64)
export rec TypeDescriptor(kind: TypeKind, payload: i64, fields: Array[RecordField])
export rec TypeTable(entries: Array[TypeDescriptor], optionals: Dict[i64, i64], records: Dict[string, i64])
export rec InternedType(table: TypeTable, id: i64)

export def initial_types() -> TypeTable
	return TypeTable([TypeDescriptor(TypeKind.I64(I64()), NO_TYPE, []), TypeDescriptor(TypeKind.Bool(Bool()), NO_TYPE, []), TypeDescriptor(TypeKind.String(String()), NO_TYPE, [])], Dict[i64, i64](), Dict[string, i64]())

export def valid_type(table: TypeTable, id: i64) -> bool
	return id >= 0 and id < len(table.entries)

export def has_kind(table: TypeTable, id: i64, kind: TypeKind) -> bool
	return valid_type(table, id) and table.entries[!id].kind == kind

export def is_optional(table: TypeTable, id: i64) -> bool
	return has_kind(table, id, TypeKind.Optional(Optional()))

export def optional_payload(table: TypeTable, id: i64) -> i64
	if not is_optional(table, id)
		return NO_TYPE
	return table.entries[!id].payload

export def find_optional(table: TypeTable, payload: i64) -> i64
	return table.optionals.get(payload) or NO_TYPE

export def intern_optional(table: TypeTable, payload: i64) -> InternedType
	if not valid_type(table, payload)
		return InternedType(table, NO_TYPE)
	let existing = find_optional(table, payload)
	if existing != NO_TYPE
		return InternedType(table, existing)
	var result = table
	let id = len(result.entries)
	result.entries = result.entries.append(TypeDescriptor(TypeKind.Optional(Optional()), payload, []))
	result.optionals = result.optionals.insert(payload, id)
	return InternedType(result, id)

export def is_record(table: TypeTable, id: i64) -> bool
	return has_kind(table, id, TypeKind.Record(Record()))

def record_key(fields: Array[RecordField]) -> string
	var key = ""
	for field in fields
		key += str(len(field.name)) + ":" + field.name + ":" + str(field.type) + ";"
	return key

export def intern_record(table: TypeTable, fields: Array[RecordField]) -> InternedType
	var ordered = Array[RecordField]()
	for field in fields
		if field.name == "" or not valid_type(table, field.type)
			return InternedType(table, NO_TYPE)
		ordered = ordered.append(field)
		var position = len(ordered) - 1
		while position > 0 and ordered[!position].name < ordered[!position - 1].name
			let previous = ordered[!position - 1]
			ordered[!position - 1] = ordered[!position]
			ordered[!position] = previous
			position -= 1
	for i in 1..len(ordered)
		if ordered[!i - 1].name == ordered[!i].name
			return InternedType(table, NO_TYPE)
	let key = record_key(ordered)
	let existing = table.records.get(key) or NO_TYPE
	if existing != NO_TYPE
		return InternedType(table, existing)
	var result = table
	let id = len(result.entries)
	result.entries = result.entries.append(TypeDescriptor(TypeKind.Record(Record()), NO_TYPE, ordered))
	result.records = result.records.insert(key, id)
	return InternedType(result, id)

export def field_index(table: TypeTable, type: i64, name: string) -> i64
	if not is_record(table, type)
		return -1
	let fields = table.entries[!type].fields
	for i in 0..len(fields)
		if fields[!i].name == name
			return i
	return -1

export def compatible(table: TypeTable, source: i64, target: i64) -> bool
	if source == target
		return true
	if not is_record(table, source) or not is_record(table, target)
		return false
	if len(table.entries[!source].fields) != len(table.entries[!target].fields)
		return false
	for field in table.entries[!target].fields
		let index = field_index(table, source, field.name)
		if index < 0 or table.entries[!source].fields[!index].type != field.type
			return false
	return true

def unsupported_type(table: TypeTable, type: i64) -> string
	if is_record(table, type)
		return "unsupported record field type"
	return "unsupported optional payload"

# The current string lookup instructions require this type even without an
# Optional annotation. Its ID is obtained by interning, never from TypeKind.
export def runtime_types() -> TypeTable
	return intern_optional(initial_types(), TYPE_I64).table

export def verify_types(table: TypeTable) -> string
	if len(table.entries) < PRIMITIVE_TYPE_COUNT
		return "missing primitive types"
	let primitives = initial_types()
	for id in 0..PRIMITIVE_TYPE_COUNT
		if table.entries[!id] != primitives.entries[!id]
			return "invalid primitive descriptor"
	var optionals = 0
	var records = 0
	for id in PRIMITIVE_TYPE_COUNT..len(table.entries)
		let descriptor = table.entries[!id]
		match descriptor.kind
			Optional
				optionals += 1
				if len(descriptor.fields) != 0 or descriptor.payload < 0 or descriptor.payload >= id
					return "invalid optional payload type"
				if find_optional(table, descriptor.payload) != id
					return "noncanonical optional type"
			Record
				records += 1
				if descriptor.payload != NO_TYPE
					return "invalid record descriptor"
				var previous = ""
				for field in descriptor.fields
					if field.name <= previous or field.type < 0 or field.type >= id
						return "noncanonical record fields"
					previous = field.name
				if (table.records.get(record_key(descriptor.fields)) or NO_TYPE) != id
					return "noncanonical record type"
			I64 | Bool | String
				return "duplicate primitive type"
	if len(table.optionals) != optionals
		return "invalid optional type cache"
	if len(table.records) != records
		return "invalid record type cache"
	return ""

export def runtime_type(table: TypeTable, id: i64) -> bool
	if not valid_type(table, id)
		return false
	match table.entries[!id].kind
		I64 | Bool | String
			return true
		Optional
			return optional_payload(table, id) == TYPE_I64
		Record
			for field in table.entries[!id].fields
				if field.type != TYPE_I64 and field.type != TYPE_BOOL and field.type != TYPE_STRING
					return false
			return true

export let INTEGER_BITS = 64
export let I64_MAX = 9223372036854775807
let FIRST_INPUT_MASK = 1
let FIRST_TWO_INPUTS_MASK = 3
let FIXED_INPUT_COUNT = 3

# Scalar slots hold i64 values or normalized booleans (0/1).
export rec Constant(dst: i64, value: i64)
export rec Negate(dst: i64, input: i64)
export rec Not(dst: i64, input: i64)
export rec Add(dst: i64, left: i64, right: i64)
export rec Subtract(dst: i64, left: i64, right: i64)
export rec Multiply(dst: i64, left: i64, right: i64)
export rec Divide(dst: i64, left: i64, right: i64)
export rec Remainder(dst: i64, left: i64, right: i64)
export rec BitAnd(dst: i64, left: i64, right: i64)
export rec BitOr(dst: i64, left: i64, right: i64)
export rec ShiftLeft(dst: i64, left: i64, right: i64)
export rec ShiftRight(dst: i64, left: i64, right: i64)
export rec Copy(dst: i64, input: i64)
export rec Integer()
export rec Boolean()
export rec Text()
export let OutputType = Integer | Boolean | Text
export rec OptionalInteger()
export let FormatType = Integer | Boolean | OptionalInteger

export rec Output(input: i64, type: OutputType, stderr: bool)
export rec Return(input: i64)
export rec Call(dst: i64, function: i64, arguments: Array[i64])
export rec MakeRecord(dst: i64, type: i64, inputs: Array[i64])
export rec CopyRecord(dst: i64, input: i64)
export rec ReadField(dst: i64, input: i64, index: i64)
# Mutate an owned record slot; earlier copies own independent struct values.
export rec SetField(record: i64, index: i64, input: i64)
export rec Compare(dst: i64, left: i64, right: i64, op: string)
export rec Branch(input: i64, target: i64)
# Copy the left value on both edges; skip the right operand when it decides.
export rec ShortCircuit(dst: i64, input: i64, target: i64, when_true: bool)
export rec Jump(target: i64)
export rec Nop()
export rec StringConstant(dst: i64, value: string)
export rec StringCopy(dst: i64, input: i64)
export rec StringConcat(dst: i64, left: i64, right: i64)
export rec StringLength(dst: i64, input: i64)
export rec StringCompare(dst: i64, left: i64, right: i64, op: string)
export rec StringSlice(dst: i64, input: i64, start: i64, end: i64)
export rec StringStarts(dst: i64, left: i64, right: i64)
export rec StringEnds(dst: i64, left: i64, right: i64)
export rec StringFormat(dst: i64, input: i64, type: FormatType)
export rec StringByteAt(dst: i64, left: i64, right: i64)
export rec StringFind(dst: i64, left: i64, right: i64)
export rec OptionalCopy(dst: i64, input: i64)
export rec OptionalUnwrap(dst: i64, input: i64)
# Always initializes the scalar destination; only a present value skips fallback.
export rec OptionalDefault(dst: i64, input: i64, target: i64)
export let Instruction = MakeRecord | CopyRecord | ReadField | SetField | Constant | Negate | Not | Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | Copy | Output | Return | Call | Compare | Branch | ShortCircuit | Jump | Nop | StringConstant | StringCopy | StringConcat | StringLength | StringCompare | StringSlice | StringStarts | StringEnds | StringFormat | StringByteAt | StringFind | OptionalCopy | OptionalDefault | OptionalUnwrap
export rec Program(instructions: Array[Instruction], slots: i64, error: string, line: i64)
export rec Function(name: string, body: Program, parameters: Array[i64], result: i64, types: Array[i64])
export rec Module(functions: Array[Function], entry: i64, type_table: TypeTable, error: string, line: i64)

export def function_has_strings(function: Function) -> bool
	for type in function.types
		if type == TYPE_STRING
			return true
	return has_strings(function.body)

export def function_has_optionals(function: Function, table: TypeTable) -> bool
	for type in function.types
		if is_optional(table, type)
			return true
	return has_optionals(function.body)

export def has_strings(program: Program) -> bool
	# Verified string inputs originate in literals or formatting.
	for instruction in program.instructions
		if Instruction.index(instruction) == Instruction.index(StringConstant) or Instruction.index(instruction) == Instruction.index(StringFormat)
			return true
	return false

export def has_optionals(program: Program) -> bool
	for instruction in program.instructions
		if Instruction.index(instruction) == Instruction.index(StringByteAt) or Instruction.index(instruction) == Instruction.index(StringFind)
			return true
	return false

enum StorageKind
	Uninitialized
	Scalar
	StringReference
	OptionalValue
	RecordValue

rec Flow(dst: i64, inputs: Array[i64], types: Array[i64], next: i64, other: i64, type: i64)

def storage(table: TypeTable, type: i64) -> StorageKind
	if type == TYPE_STRING
		return StringReference()
	if is_optional(table, type)
		return OptionalValue()
	if is_record(table, type)
		return RecordValue()
	return Scalar()

def in_bounds(slot: i64, count: i64) -> bool
	return slot >= 0 and slot < count

def initialized(facts: Array[i64], slot: i64) -> bool
	return (facts[!(slot / INTEGER_BITS)] & (1 << (slot % INTEGER_BITS))) != 0

# Reachable predecessors contribute definite initialization by intersection.
# A worklist revisits joins when a loop or a later predecessor removes a fact.
export def verify(program: Program) -> string
	return verify_body(program, [], [], TYPE_I64, [], runtime_types())

def verify_body(program: Program, types: Array[i64], parameters: Array[i64], result: i64, functions: Array[Function], table: TypeTable) -> string
	if program.error != ""
		return program.error
	if program.slots < 0
		return "negative slot count"
	let count = len(program.instructions)
	if count == 0
		return "missing return"
	var flows = Array[Flow]()
	var returned = false
	var has_control = false
	let integer = TYPE_I64
	let boolean = TYPE_BOOL
	let text = TYPE_STRING
	let optional = find_optional(table, TYPE_I64)
	let typed = len(types) != 0
	for i in 0..count
		var dst = -1
		var first = -1
		var second = -1
		var third = -1
		var next = i + 1
		var other = -1
		var writes = false
		var strings = 0
		var optionals = 0
		var inputs = Array[i64]()
		var input_types = Array[i64]()
		var output_type = integer
		let instruction = program.instructions[!i]
		match instruction
			MakeRecord(target, type, fields)
				if not typed or not is_record(table, type) or not runtime_type(table, type)
					return "invalid record type"
				let descriptor = table.entries[!type]
				if len(fields) != len(descriptor.fields)
					return "record field count mismatch"
				dst = target
				writes = true
				output_type = type
				inputs = fields
				for field in descriptor.fields
					input_types = input_types.append(field.type)
				for input in inputs
					if not in_bounds(input, program.slots)
						return "undefined input slot"
			CopyRecord(target, input)
				if not in_bounds(target, program.slots)
					return "invalid destination slot"
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not typed or not is_record(table, types[!target]) or not is_record(table, types[!input])
					return "record copy requires records"
				dst = target
				writes = true
				output_type = types[!target]
				inputs = [input]
				input_types = [types[!target]]
			ReadField(target, input, index)
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not typed or not is_record(table, types[!input])
					return "field read requires record"
				let fields = table.entries[!types[!input]].fields
				if not in_bounds(index, len(fields))
					return "invalid record field index"
				dst = target
				writes = true
				output_type = fields[!index].type
				inputs = [input]
				input_types = [types[!input]]
			SetField(record, index, input)
				if not in_bounds(record, program.slots) or not in_bounds(input, program.slots)
					return "undefined input slot"
				if not typed or not is_record(table, types[!record])
					return "field update requires record"
				let fields = table.entries[!types[!record]].fields
				if not in_bounds(index, len(fields))
					return "invalid record field index"
				inputs = [record, input]
				input_types = [types[!record], fields[!index].type]
			Call(target, function, arguments)
				if not in_bounds(function, len(functions))
					return "invalid call target"
				let callee = functions[!function]
				if len(arguments) != len(callee.parameters)
					return "argument count mismatch"
				dst = target
				writes = true
				output_type = callee.result
				inputs = arguments
				input_types = callee.parameters
				for input in inputs
					if not in_bounds(input, program.slots)
						return "undefined input slot"
			StringFormat(target, input, type)
				dst = target
				first = input
				writes = true
				output_type = text
				if type == FormatType.OptionalInteger(OptionalInteger())
					optionals = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			(StringByteAt | StringFind)(target, left, right)
				dst = target
				first = left
				second = right
				writes = true
				output_type = optional
				strings = FIRST_INPUT_MASK
				if Instruction.index(instruction) == Instruction.index(StringFind)
					strings = FIRST_TWO_INPUTS_MASK
				if not in_bounds(left, program.slots) or not in_bounds(right, program.slots)
					return "undefined input slot"
			(OptionalCopy | OptionalUnwrap)(target, input)
				dst = target
				first = input
				writes = true
				output_type = optional
				if Instruction.index(instruction) == Instruction.index(OptionalUnwrap)
					output_type = integer
				optionals = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			OptionalDefault(target_slot, input, target)
				has_control = true
				dst = target_slot
				writes = true
				first = input
				other = target
				optionals = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not in_bounds(target, count)
					return "invalid jump target"
			StringSlice(target, input, start, end)
				dst = target
				first = input
				second = start
				third = end
				writes = true
				output_type = text
				strings = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots) or not in_bounds(start, program.slots) or not in_bounds(end, program.slots)
					return "undefined input slot"
			StringConstant(target, value)
				dst = target
				writes = true
				output_type = text
			Constant(target, value)
				dst = target
				writes = true
			(Negate | Not | Copy | StringCopy | StringLength)(target, input)
				dst = target
				first = input
				writes = true
				if Instruction.index(instruction) == Instruction.index(StringCopy)
					output_type = text
					strings = FIRST_INPUT_MASK
				elif Instruction.index(instruction) == Instruction.index(StringLength)
					strings = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			(Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | StringConcat | StringStarts | StringEnds)(target, left, right)
				dst = target
				first = left
				second = right
				writes = true
				if Instruction.index(instruction) == Instruction.index(StringConcat)
					output_type = text
					strings = FIRST_TWO_INPUTS_MASK
				elif Instruction.index(instruction) == Instruction.index(StringStarts) or Instruction.index(instruction) == Instruction.index(StringEnds)
					strings = FIRST_TWO_INPUTS_MASK
				if not in_bounds(left, program.slots) or not in_bounds(right, program.slots)
					return "undefined input slot"
			(Compare | StringCompare)(target, left, right, op)
				dst = target
				first = left
				second = right
				writes = true
				if Instruction.index(instruction) == Instruction.index(StringCompare)
					strings = FIRST_TWO_INPUTS_MASK
				if not in_bounds(left, program.slots) or not in_bounds(right, program.slots)
					return "undefined input slot"
				if op != "==" and op != "!=" and op != "<" and op != "<=" and op != ">" and op != ">="
					return "invalid comparison"
			Output(input, type, stderr)
				first = input
				if type == OutputType.Text(Text())
					strings = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			Return(input)
				first = input
				next = -1
				returned = true
				if result == text
					strings = FIRST_INPUT_MASK
				elif result == optional
					optionals = FIRST_INPUT_MASK
				if not in_bounds(input, program.slots)
					return "undefined input slot"
			Branch(input, target)
				has_control = true
				first = input
				other = target
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not in_bounds(target, count)
					return "invalid jump target"
			ShortCircuit(target_slot, input, target, when_true)
				has_control = true
				dst = target_slot
				writes = true
				first = input
				other = target
				if not in_bounds(input, program.slots)
					return "undefined input slot"
				if not in_bounds(target, count)
					return "invalid jump target"
			Jump(target)
				has_control = true
				next = target
				if not in_bounds(target, count)
					return "invalid jump target"
			Nop
				next = i + 1
		if writes and not in_bounds(dst, program.slots)
			return "invalid destination slot"
		for operand in 0..FIXED_INPUT_COUNT
			let input = [first, second, third][!operand]
			if input < 0
				continue
			var type = integer
			if (strings & (1 << operand)) != 0
				type = text
			elif (optionals & (1 << operand)) != 0
				type = optional
			inputs = inputs.append(input)
			input_types = input_types.append(type)
		# Preserve bool/i64 distinctions in typed functions; legacy Program tests
		# retain their storage-only contract.
		match instruction
			Constant(target, value)
				if typed
					output_type = types[!target]
					if output_type != integer and output_type != boolean
						return "slot type mismatch"
					if output_type == boolean and value != 0 and value != 1
						return "invalid boolean constant"
			Copy(target, input)
				if typed
					output_type = types[!target]
					if output_type != integer and output_type != boolean
						return "slot type mismatch"
					input_types[!0] = output_type
			Not
				output_type = boolean
				input_types[!0] = boolean
			Compare(target, left, right, op)
				output_type = boolean
				if typed and types[!left] == boolean and (op == "==" or op == "!=")
					input_types = [boolean, boolean]
			StringCompare | StringStarts | StringEnds
				output_type = boolean
			Branch
				input_types[!0] = boolean
			ShortCircuit
				output_type = boolean
				input_types[!0] = boolean
			Return
				input_types[!0] = result
			Output(input, type, stderr)
				if type == OutputType.Boolean(Boolean())
					input_types[!0] = boolean
			StringFormat(target, input, type)
				if type == FormatType.Boolean(Boolean())
					input_types[!0] = boolean
			MakeRecord | CopyRecord | ReadField | SetField | Call | Negate | Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | Jump | Nop | StringConstant | StringCopy | StringConcat | StringLength | StringSlice | StringByteAt | StringFind | OptionalCopy | OptionalDefault | OptionalUnwrap
				if not runtime_type(table, output_type)
					return "invalid instruction type"
		if typed
			if dst >= 0 and types[!dst] != output_type
				return "slot type mismatch"
			for operand in 0..len(inputs)
				if types[!inputs[!operand]] != input_types[!operand]
					return "slot type mismatch"
		flows = flows.append(Flow(dst, inputs, input_types, next, other, output_type))
	if not returned
		return "missing return"
	# Each slot has one storage kind, independent of control-flow reachability.
	let uninitialized: StorageKind = Uninitialized()
	var kinds = Array[StorageKind]()
	for i in 0..program.slots
		kinds = kinds.append(uninitialized)
	for i in 0..len(parameters)
		kinds[!i] = storage(table, parameters[!i])
	for flow in flows
		if flow.dst >= 0
			if kinds[!flow.dst] != uninitialized and kinds[!flow.dst] != storage(table, flow.type)
				return "slot type mismatch"
			kinds[!flow.dst] = storage(table, flow.type)
	for flow in flows
		for operand in 0..len(flow.inputs)
			let input = flow.inputs[!operand]
			let expected = storage(table, flow.types[!operand])
			if kinds[!input] == uninitialized
				return "undefined input slot"
			if kinds[!input] != expected
				return "slot type mismatch"
	# One word holds 64 facts, including bit 63 in the signed i64 sign bit.
	var words = program.slots / INTEGER_BITS
	if program.slots % INTEGER_BITS != 0
		words += 1
	var blank = Array[i64]()
	for i in 0..words
		blank = blank.append(0)
	for i in 0..len(parameters)
		blank[!(i / INTEGER_BITS)] = blank[!(i / INTEGER_BITS)] | (1 << (i % INTEGER_BITS))
	# Straight-line code has one predecessor per instruction; no matrix needed.
	if not has_control
		var finished = false
		for flow in flows
			if finished
				return "unreachable instruction"
			for input in flow.inputs
				if input >= 0 and not initialized(blank, input)
					return "undefined input slot"
			if flow.dst >= 0
				let word = flow.dst / INTEGER_BITS
				blank[!word] = blank[!word] | (1 << (flow.dst % INTEGER_BITS))
			finished = flow.next < 0
		return ""
	var incoming = Array[Array[i64]]()
	var reached = Array[bool]()
	for i in 0..count
		incoming = incoming.append(blank)
		reached = reached.append(false)
	reached[!0] = true
	var queue = [0]
	var cursor = 0
	while cursor < len(queue)
		let index = queue[!cursor]
		cursor += 1
		let flow = flows[!index]
		var outgoing = incoming[!index]
		if flow.dst >= 0
			let word = flow.dst / INTEGER_BITS
			outgoing[!word] = outgoing[!word] | (1 << (flow.dst % INTEGER_BITS))
		for successor in [flow.next, flow.other]
			if successor < 0
				continue
			if successor >= count
				return "path falls off program"
			var changed = not reached[!successor]
			if changed
				incoming[!successor] = outgoing
				reached[!successor] = true
			else
				var merged = incoming[!successor]
				for word in 0..words
					let common = merged[!word] & outgoing[!word]
					if common != merged[!word]
						merged[!word] = common
						changed = true
				incoming[!successor] = merged
			if changed
				queue = queue.append(successor)
	for i in 0..count
		if not reached[!i]
			return "unreachable instruction"
		let flow = flows[!i]
		for input in flow.inputs
			if input >= 0 and not initialized(incoming[!i], input)
				return "undefined input slot"
	return ""

# Remove unreachable structural markers after early exits, remapping targets.
export def prune(program: Program) -> Program
	if program.error != ""
		return program
	let count = len(program.instructions)
	var reached = Array[bool]()
	var ids = Array[i64]()
	for i in 0..count
		reached = reached.append(false)
		ids = ids.append(-1)
	var queue = [0]
	var cursor = 0
	while cursor < len(queue)
		let pc = queue[!cursor]
		cursor += 1
		if pc == count
			continue
		if pc < 0 or pc > count
			return Program([], 0, "invalid jump target", 0)
		if reached[!pc]
			continue
		reached[!pc] = true
		match program.instructions[!pc]
			OptionalDefault(dst, input, target)
				queue = queue.append(target)
				queue = queue.append(pc + 1)
			Jump(target)
				queue = queue.append(target)
			Branch(input, target)
				queue = queue.append(target)
				queue = queue.append(pc + 1)
			ShortCircuit(dst, input, target, when_true)
				queue = queue.append(target)
				queue = queue.append(pc + 1)
			Return
				continue
			MakeRecord | CopyRecord | ReadField | SetField | Call | Constant | Negate | Not | Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | Copy | Output | Compare | Nop | StringConstant | StringCopy | StringConcat | StringLength | StringCompare | StringSlice | StringStarts | StringEnds | StringFormat | StringByteAt | StringFind | OptionalCopy | OptionalUnwrap
				queue = queue.append(pc + 1)
	var size = 0
	for i in 0..count
		if reached[!i]
			ids[!i] = size
			size += 1
	var result = Array[Instruction]()
	for i in 0..count
		if not reached[!i]
			continue
		let instruction = program.instructions[!i]
		match instruction
			OptionalDefault(dst, input, target)
				if target < 0 or target >= count
					return Program([], 0, "invalid jump target", 0)
				result = result.append(OptionalDefault(dst, input, ids[!target]))
			Jump(target)
				if target < 0 or target >= count
					return Program([], 0, "invalid jump target", 0)
				result = result.append(Jump(ids[!target]))
			Branch(input, target)
				if target < 0 or target >= count
					return Program([], 0, "invalid jump target", 0)
				result = result.append(Branch(input, ids[!target]))
			ShortCircuit(dst, input, target, when_true)
				if target < 0 or target >= count
					return Program([], 0, "invalid jump target", 0)
				result = result.append(ShortCircuit(dst, input, ids[!target], when_true))
			MakeRecord | CopyRecord | ReadField | SetField | Call | Constant | Negate | Not | Add | Subtract | Multiply | Divide | Remainder | BitAnd | BitOr | ShiftLeft | ShiftRight | Copy | Output | Compare | Nop | Return | StringConstant | StringCopy | StringConcat | StringLength | StringCompare | StringSlice | StringStarts | StringEnds | StringFormat | StringByteAt | StringFind | OptionalCopy | OptionalUnwrap
				result = result.append(instruction)
	return Program(result, program.slots, "", 0)

export def verify_module(module: Module) -> string
	if module.error != ""
		return module.error
	let type_error = verify_types(module.type_table)
	if type_error != ""
		return type_error
	if not in_bounds(module.entry, len(module.functions))
		return "invalid entry function"
	let entry = module.functions[!module.entry]
	if len(entry.parameters) != 0 or entry.result != TYPE_I64
		return "invalid entry signature"
	# Validate all signatures before inspecting recursive calls.
	for function in module.functions
		if not valid_type(module.type_table, function.result)
			return "invalid result type"
		if not runtime_type(module.type_table, function.result)
			return unsupported_type(module.type_table, function.result)
		if len(function.types) != function.body.slots or len(function.parameters) > function.body.slots
			return "invalid function slots"
		for i in 0..len(function.parameters)
			let type = function.parameters[!i]
			if not valid_type(module.type_table, type) or function.types[!i] != type
				return "invalid parameter type"
			if not runtime_type(module.type_table, type)
				return unsupported_type(module.type_table, type)
		for type in function.types
			if type != NO_TYPE and not valid_type(module.type_table, type)
				return "invalid slot type"
			if type != NO_TYPE and not runtime_type(module.type_table, type)
				return unsupported_type(module.type_table, type)
	for function in module.functions
		let error = verify_body(function.body, function.types, function.parameters, function.result, module.functions, module.type_table)
		if error != ""
			return function.name + ": " + error
	return ""

# Lowering initially uses arena IDs for both slots and instruction positions.
# Convert each function's interval to local IDs before pruning its control flow.
export def rebase(instruction: Instruction, base: i64) -> Instruction
	match instruction
		MakeRecord(dst, type, inputs)
			var fields = Array[i64]()
			for input in inputs
				fields = fields.append(input - base)
			return MakeRecord(dst - base, type, fields)
		CopyRecord(dst, input)
			return CopyRecord(dst - base, input - base)
		ReadField(dst, input, index)
			return ReadField(dst - base, input - base, index)
		SetField(record, index, input)
			return SetField(record - base, index, input - base)
		Call(dst, function, arguments)
			var inputs = Array[i64]()
			for input in arguments
				inputs = inputs.append(input - base)
			return Call(dst - base, function, inputs)
		Constant(dst, value)
			return Constant(dst - base, value)
		StringConstant(dst, value)
			return StringConstant(dst - base, value)
		Negate(dst, input)
			return Negate(dst - base, input - base)
		Not(dst, input)
			return Not(dst - base, input - base)
		Copy(dst, input)
			return Copy(dst - base, input - base)
		StringCopy(dst, input)
			return StringCopy(dst - base, input - base)
		OptionalCopy(dst, input)
			return OptionalCopy(dst - base, input - base)
		OptionalUnwrap(dst, input)
			return OptionalUnwrap(dst - base, input - base)
		StringLength(dst, input)
			return StringLength(dst - base, input - base)
		Add(dst, left, right)
			return Add(dst - base, left - base, right - base)
		Subtract(dst, left, right)
			return Subtract(dst - base, left - base, right - base)
		Multiply(dst, left, right)
			return Multiply(dst - base, left - base, right - base)
		Divide(dst, left, right)
			return Divide(dst - base, left - base, right - base)
		Remainder(dst, left, right)
			return Remainder(dst - base, left - base, right - base)
		BitAnd(dst, left, right)
			return BitAnd(dst - base, left - base, right - base)
		BitOr(dst, left, right)
			return BitOr(dst - base, left - base, right - base)
		ShiftLeft(dst, left, right)
			return ShiftLeft(dst - base, left - base, right - base)
		ShiftRight(dst, left, right)
			return ShiftRight(dst - base, left - base, right - base)
		StringConcat(dst, left, right)
			return StringConcat(dst - base, left - base, right - base)
		StringStarts(dst, left, right)
			return StringStarts(dst - base, left - base, right - base)
		StringEnds(dst, left, right)
			return StringEnds(dst - base, left - base, right - base)
		StringByteAt(dst, left, right)
			return StringByteAt(dst - base, left - base, right - base)
		StringFind(dst, left, right)
			return StringFind(dst - base, left - base, right - base)
		Compare(dst, left, right, op)
			return Compare(dst - base, left - base, right - base, op)
		StringCompare(dst, left, right, op)
			return StringCompare(dst - base, left - base, right - base, op)
		StringSlice(dst, input, start, end)
			return StringSlice(dst - base, input - base, start - base, end - base)
		StringFormat(dst, input, type)
			return StringFormat(dst - base, input - base, type)
		Output(input, type, stderr)
			return Output(input - base, type, stderr)
		Return(input)
			return Return(input - base)
		Branch(input, target)
			return Branch(input - base, target - base)
		Jump(target)
			return Jump(target - base)
		ShortCircuit(dst, input, target, when_true)
			return ShortCircuit(dst - base, input - base, target - base, when_true)
		OptionalDefault(dst, input, target)
			return OptionalDefault(dst - base, input - base, target - base)
		Nop
			return Nop()
