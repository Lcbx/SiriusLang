import ir alias IR

let EXIT_RUNTIME_ERROR = 1

def output(value, stderr: bool) -> i64
	if stderr
		eprint(value)
	else
		print(value)
	return 0

def present(input: Optional[i64]) -> bool
	let value = input else return false
	return true

def format_optional(input: Optional[i64]) -> string
	let value = input else return "None"
	return "Some(" + str(value) + ")"

def compare(left, right, op: string) -> bool
	if op == "=="
		return left == right
	if op == "!="
		return left != right
	if op == "<"
		return left < right
	if op == "<="
		return left <= right
	if op == ">"
		return left > right
	return left >= right

rec RecordValue(scalars: Array[i64], strings: Array[string], arrays: Array[Array[i64]], text_arrays: Array[Array[string]], nested_arrays: Array[Array[Array[i64]]], nested: Array[i64], nested_text_arrays: Array[Array[Array[string]]])
rec Frame(function: i64, pc: i64, dst: i64, slots: Array[i64], strings: Array[string], optionals: Array[Optional[i64]], records: Array[RecordValue], arrays: Array[Array[i64]], text_arrays: Array[Array[string]], record_arrays: Array[Array[RecordValue]], nested_arrays: Array[Array[Array[i64]]], nested_text_arrays: Array[Array[Array[string]]])

def empty_record(count: i64) -> RecordValue
	var scalars = Array[i64]()
	var strings = Array[string]()
	var arrays = Array[Array[i64]]()
	var text_arrays = Array[Array[string]]()
	var nested = Array[i64]()
	var nested_arrays = Array[Array[Array[i64]]]()
	var nested_text_arrays = Array[Array[Array[string]]]()
	for i in 0..count
		scalars = scalars.append(0)
		strings = strings.append("")
		arrays = arrays.append(Array[i64]())
		text_arrays = text_arrays.append(Array[string]())
		nested_arrays = nested_arrays.append(Array[Array[i64]]())
		nested_text_arrays = nested_text_arrays.append(Array[Array[string]]())
		nested = nested.append(-1)
	return RecordValue(scalars, strings, arrays, text_arrays, nested_arrays, nested, nested_text_arrays)

def empty_frame(function: IR.Function, id: i64, table: IR.TypeTable) -> Frame
	var slots = Array[i64]()
	var strings = Array[string]()
	var optionals = Array[Optional[i64]]()
	var records = Array[RecordValue]()
	var arrays = Array[Array[i64]]()
	var text_arrays = Array[Array[string]]()
	var record_arrays = Array[Array[RecordValue]]()
	var nested_arrays = Array[Array[Array[i64]]]()
	var nested_text_arrays = Array[Array[Array[string]]]()
	var has_arrays = false
	var has_records = false
	for type in function.types
		if IR.is_record(table, type)
			has_records = true
		if IR.is_array(table, type)
			has_arrays = true
	for i in 0..function.body.slots
		slots = slots.append(0)
	if IR.function_has_strings(function)
		for i in 0..function.body.slots
			strings = strings.append("")
	if IR.function_has_optionals(function, table)
		for i in 0..function.body.slots
			optionals = optionals.append("".byte_at(0))
	if has_records
		for i in 0..function.body.slots
			records = records.append(empty_record(0))
	if has_arrays
		for i in 0..function.body.slots
			arrays = arrays.append(Array[i64]())
			text_arrays = text_arrays.append(Array[string]())
			record_arrays = record_arrays.append(Array[RecordValue]())
			nested_arrays = nested_arrays.append(Array[Array[i64]]())
			nested_text_arrays = nested_text_arrays.append(Array[Array[string]]())
	return Frame(id, 0, -1, slots, strings, optionals, records, arrays, text_arrays, record_arrays, nested_arrays, nested_text_arrays)

def execute(module: IR.Module) -> i64
	let initial = empty_frame(module.functions[!module.entry], module.entry, module.type_table)
	var slots = initial.slots
	var strings = initial.strings
	var optionals = initial.optionals
	var records = initial.records
	var arrays = initial.arrays
	var text_arrays = initial.text_arrays
	var record_arrays = initial.record_arrays
	var nested_arrays = initial.nested_arrays
	var nested_text_arrays = initial.nested_text_arrays
	# Shared append-only arena: nested record references survive frame changes.
	var record_pool = Array[RecordValue]()
	# Keep array-valued record fields in a separate pool to avoid a recursive
	# RecordValue layout in the self-hosted compiler.
	var record_array_pool = Array[Array[RecordValue]]()
	var function_id = module.entry
	var program = module.functions[!function_id].body
	var stack = Array[Frame]()
	var depth = 0
	var pc = 0
	while pc < len(program.instructions)
		let instruction = program.instructions[!pc]
		var next = pc + 1
		match instruction
			IR.MakeArray(dst, inputs)
				let item_type = IR.array_element(module.type_table, module.functions[!function_id].types[!dst])
				if IR.is_record(module.type_table, item_type)
					var values = Array[RecordValue]()
					for input in inputs
						values = values.append(records[!input])
					record_arrays[!dst] = values
				elif IR.is_array(module.type_table, item_type)
					if IR.array_element(module.type_table, item_type) == IR.TYPE_STRING
						var values = Array[Array[string]]()
						for input in inputs
							values = values.append(text_arrays[!input])
						nested_text_arrays[!dst] = values
					else
						var values = Array[Array[i64]]()
						for input in inputs
							values = values.append(arrays[!input])
						nested_arrays[!dst] = values
				elif item_type == IR.TYPE_STRING
					var values = Array[string]()
					for input in inputs
						values = values.append(strings[!input])
					text_arrays[!dst] = values
				else
					var values = Array[i64]()
					for input in inputs
						values = values.append(slots[!input])
					arrays[!dst] = values
			IR.CopyArray(dst, input)
				let element = IR.array_element(module.type_table, module.functions[!function_id].types[!dst])
				if IR.is_record(module.type_table, element)
					record_arrays[!dst] = record_arrays[!input]
				elif IR.is_array(module.type_table, element)
					if IR.array_element(module.type_table, element) == IR.TYPE_STRING
						nested_text_arrays[!dst] = nested_text_arrays[!input]
					else
						nested_arrays[!dst] = nested_arrays[!input]
				elif element == IR.TYPE_STRING
					text_arrays[!dst] = text_arrays[!input]
				else
					arrays[!dst] = arrays[!input]
			IR.ArrayLength(dst, input)
				let element = IR.array_element(module.type_table, module.functions[!function_id].types[!input])
				if IR.is_record(module.type_table, element)
					slots[!dst] = len(record_arrays[!input])
				elif IR.is_array(module.type_table, element)
					if IR.array_element(module.type_table, element) == IR.TYPE_STRING
						slots[!dst] = len(nested_text_arrays[!input])
					else
						slots[!dst] = len(nested_arrays[!input])
				elif element == IR.TYPE_STRING
					slots[!dst] = len(text_arrays[!input])
				else
					slots[!dst] = len(arrays[!input])
			IR.ArrayRead(dst, input, index)
				var at = slots[!index]
				let element = IR.array_element(module.type_table, module.functions[!function_id].types[!input])
				let record_items = IR.is_record(module.type_table, element)
				let string_items = element == IR.TYPE_STRING
				let nested_items = IR.is_array(module.type_table, element)
				var count = len(arrays[!input])
				if string_items
					count = len(text_arrays[!input])
				elif record_items
					count = len(record_arrays[!input])
				elif nested_items
					if IR.array_element(module.type_table, element) == IR.TYPE_STRING
						count = len(nested_text_arrays[!input])
					else
						count = len(nested_arrays[!input])
				if at < 0
					at += count
				if at < 0 or at >= count
					eprint("ERROR: index out of bounds")
					return EXIT_RUNTIME_ERROR
				if record_items
					records[!dst] = record_arrays[!input][!at]
				elif nested_items
					if IR.array_element(module.type_table, element) == IR.TYPE_STRING
						text_arrays[!dst] = nested_text_arrays[!input][!at]
					else
						arrays[!dst] = nested_arrays[!input][!at]
				elif string_items
					strings[!dst] = text_arrays[!input][!at]
				else
					slots[!dst] = arrays[!input][!at]
			IR.ArrayAppend(dst, input, item)
				let element = IR.array_element(module.type_table, module.functions[!function_id].types[!input])
				if IR.is_record(module.type_table, element)
					record_arrays[!dst] = record_arrays[!input].append(records[!item])
				elif IR.is_array(module.type_table, element)
					if IR.array_element(module.type_table, element) == IR.TYPE_STRING
						nested_text_arrays[!dst] = nested_text_arrays[!input].append(text_arrays[!item])
					else
						nested_arrays[!dst] = nested_arrays[!input].append(arrays[!item])
				elif element == IR.TYPE_STRING
					text_arrays[!dst] = text_arrays[!input].append(strings[!item])
				else
					arrays[!dst] = arrays[!input].append(slots[!item])
			IR.ArraySet(input, index, item)
				var at = slots[!index]
				let element = IR.array_element(module.type_table, module.functions[!function_id].types[!input])
				let record_items = IR.is_record(module.type_table, element)
				let string_items = element == IR.TYPE_STRING
				let nested_items = IR.is_array(module.type_table, element)
				var count = len(arrays[!input])
				if string_items
					count = len(text_arrays[!input])
				elif record_items
					count = len(record_arrays[!input])
				elif nested_items
					if IR.array_element(module.type_table, element) == IR.TYPE_STRING
						count = len(nested_text_arrays[!input])
					else
						count = len(nested_arrays[!input])
				if at < 0
					at += count
				if at < 0 or at >= count
					eprint("ERROR: index out of bounds")
					return EXIT_RUNTIME_ERROR
				if record_items
					var values = record_arrays[!input]
					values[!at] = records[!item]
					record_arrays[!input] = values
				elif nested_items
					if IR.array_element(module.type_table, element) == IR.TYPE_STRING
						var values = nested_text_arrays[!input]
						values[!at] = text_arrays[!item]
						nested_text_arrays[!input] = values
					else
						var values = nested_arrays[!input]
						values[!at] = arrays[!item]
						nested_arrays[!input] = values
				elif string_items
					var values = text_arrays[!input]
					values[!at] = strings[!item]
					text_arrays[!input] = values
				else
					var values = arrays[!input]
					values[!at] = slots[!item]
					arrays[!input] = values
			IR.MakeRecord(dst, type, inputs)
				let fields = module.type_table.entries[!type].fields
				var value = empty_record(len(fields))
				for i in 0..len(fields)
					let type = fields[!i].type
					if IR.is_record(module.type_table, type)
						value.nested[!i] = len(record_pool)
						record_pool = record_pool.append(records[!inputs[!i]])
					elif type == IR.TYPE_STRING
						value.strings[!i] = strings[!inputs[!i]]
					elif IR.is_array(module.type_table, type)
						let element = IR.array_element(module.type_table, type)
						if IR.is_record(module.type_table, element)
							value.nested[!i] = len(record_array_pool)
							record_array_pool = record_array_pool.append(record_arrays[!inputs[!i]])
						elif IR.is_array(module.type_table, element)
							if IR.array_element(module.type_table, element) == IR.TYPE_STRING
								value.nested_text_arrays[!i] = nested_text_arrays[!inputs[!i]]
							else
								value.nested_arrays[!i] = nested_arrays[!inputs[!i]]
						elif element == IR.TYPE_STRING
							value.text_arrays[!i] = text_arrays[!inputs[!i]]
						else
							value.arrays[!i] = arrays[!inputs[!i]]
					else
						value.scalars[!i] = slots[!inputs[!i]]
				records[!dst] = value
			IR.CopyRecord(dst, input)
				records[!dst] = records[!input]
			IR.ReadField(dst, input, index)
				let type = module.functions[!function_id].types[!dst]
				if IR.is_record(module.type_table, type)
					records[!dst] = record_pool[!records[!input].nested[!index]]
				elif type == IR.TYPE_STRING
					strings[!dst] = records[!input].strings[!index]
				elif IR.is_array(module.type_table, type)
					let element = IR.array_element(module.type_table, type)
					if IR.is_record(module.type_table, element)
						record_arrays[!dst] = record_array_pool[!records[!input].nested[!index]]
					elif IR.is_array(module.type_table, element)
						if IR.array_element(module.type_table, element) == IR.TYPE_STRING
							nested_text_arrays[!dst] = records[!input].nested_text_arrays[!index]
						else
							nested_arrays[!dst] = records[!input].nested_arrays[!index]
					elif element == IR.TYPE_STRING
						text_arrays[!dst] = records[!input].text_arrays[!index]
					else
						arrays[!dst] = records[!input].arrays[!index]
				else
					slots[!dst] = records[!input].scalars[!index]
			IR.SetField(record, index, input)
				var value = records[!record]
				let type = module.type_table.entries[!module.functions[!function_id].types[!record]].fields[!index].type
				if IR.is_record(module.type_table, type)
					value.nested[!index] = len(record_pool)
					record_pool = record_pool.append(records[!input])
				elif type == IR.TYPE_STRING
					value.strings[!index] = strings[!input]
				elif IR.is_array(module.type_table, type)
					let element = IR.array_element(module.type_table, type)
					if IR.is_record(module.type_table, element)
						value.nested[!index] = len(record_array_pool)
						record_array_pool = record_array_pool.append(record_arrays[!input])
					elif IR.is_array(module.type_table, element)
						if IR.array_element(module.type_table, element) == IR.TYPE_STRING
							value.nested_text_arrays[!index] = nested_text_arrays[!input]
						else
							value.nested_arrays[!index] = nested_arrays[!input]
					elif element == IR.TYPE_STRING
						value.text_arrays[!index] = text_arrays[!input]
					else
						value.arrays[!index] = arrays[!input]
				else
					value.scalars[!index] = slots[!input]
				records[!record] = value
			IR.Call(dst, target, arguments)
				let callee = module.functions[!target]
				var frame = empty_frame(callee, target, module.type_table)
				for i in 0..len(arguments)
					let input = arguments[!i]
					let type = callee.parameters[!i]
					if type == IR.TYPE_STRING
						frame.strings[!i] = strings[!input]
					elif IR.is_optional(module.type_table, type)
						frame.optionals[!i] = optionals[!input]
					elif IR.is_record(module.type_table, type)
						frame.records[!i] = records[!input]
					elif IR.is_array(module.type_table, type)
						let element = IR.array_element(module.type_table, type)
						if IR.is_record(module.type_table, element)
							frame.record_arrays[!i] = record_arrays[!input]
						elif IR.is_array(module.type_table, element)
							if IR.array_element(module.type_table, element) == IR.TYPE_STRING
								frame.nested_text_arrays[!i] = nested_text_arrays[!input]
							else
								frame.nested_arrays[!i] = nested_arrays[!input]
						elif element == IR.TYPE_STRING
							frame.text_arrays[!i] = text_arrays[!input]
						else
							frame.arrays[!i] = arrays[!input]
					else
						frame.slots[!i] = slots[!input]
				let saved = Frame(function_id, next, dst, slots, strings, optionals, records, arrays, text_arrays, record_arrays, nested_arrays, nested_text_arrays)
				if depth == len(stack)
					stack = stack.append(saved)
				else
					stack[!depth] = saved
				depth += 1
				function_id = target
				program = callee.body
				slots = frame.slots
				strings = frame.strings
				optionals = frame.optionals
				records = frame.records
				arrays = frame.arrays
				text_arrays = frame.text_arrays
				record_arrays = frame.record_arrays
				nested_arrays = frame.nested_arrays
				nested_text_arrays = frame.nested_text_arrays
				next = 0
			IR.OptionalUnwrap(dst, input)
				if not present(optionals[!input])
					eprint("ERROR: missing optional value")
					return EXIT_RUNTIME_ERROR
				slots[!dst] = optionals[!input] or 0
			IR.StringByteAt(dst, left, right)
				optionals[!dst] = strings[!left].byte_at(slots[!right])
			IR.StringFind(dst, left, right)
				optionals[!dst] = strings[!left].find(strings[!right])
			IR.OptionalCopy(dst, input)
				optionals[!dst] = optionals[!input]
			IR.OptionalDefault(dst, input, target)
				slots[!dst] = optionals[!input] or 0
				if present(optionals[!input])
					next = target
			IR.StringFormat(dst, input, type)
				match type
					IR.Integer
						strings[!dst] = str(slots[!input])
					IR.Boolean
						var value = "false"
						if slots[!input] != 0
							value = "true"
						strings[!dst] = value
					IR.OptionalInteger
						strings[!dst] = format_optional(optionals[!input])
			IR.Output(input, type, stderr)
				match type
					IR.Integer
						output(slots[!input], stderr)
					IR.Boolean
						output(slots[!input] != 0, stderr)
					IR.Text
						output(strings[!input], stderr)
			IR.StringSlice(dst, input, start, end)
				let from = slots[!start]
				let to = slots[!end]
				if from < 0 or to < from or to > len(strings[!input])
					eprint("ERROR: string slice out of bounds")
					return EXIT_RUNTIME_ERROR
				strings[!dst] = strings[!input].slice(from, to)
			(IR.StringStarts | IR.StringEnds)(dst, left, right)
				var result = false
				if IR.Instruction.index(instruction) == IR.Instruction.index(IR.StringStarts)
					result = strings[!left].starts_with(strings[!right])
				else
					result = strings[!left].ends_with(strings[!right])
				var value = 0
				if result
					value = 1
				slots[!dst] = value
			IR.StringConstant(dst, value)
				strings[!dst] = value
			IR.StringCopy(dst, input)
				strings[!dst] = strings[!input]
			IR.StringConcat(dst, left, right)
				strings[!dst] = strings[!left] + strings[!right]
			IR.StringLength(dst, input)
				slots[!dst] = len(strings[!input])
			IR.StringCompare(dst, left, right, op)
				var value = 0
				if compare(strings[!left], strings[!right], op)
					value = 1
				slots[!dst] = value
			IR.ShortCircuit(dst, input, target, when_true)
				slots[!dst] = slots[!input]
				if (slots[!input] != 0) == when_true
					next = target
			IR.Compare(dst, left, right, op)
				var value = 0
				if compare(slots[!left], slots[!right], op)
					value = 1
				slots[!dst] = value
			IR.Branch(input, target)
				if slots[!input] == 0
					next = target
			IR.Jump(target)
				next = target
			IR.Nop
				next = pc + 1
			IR.Constant(dst, value)
				slots[!dst] = value
			IR.Negate(dst, input)
				slots[!dst] = -slots[!input]
			IR.Not(dst, input)
				var value = 0
				if slots[!input] == 0
					value = 1
				slots[!dst] = value
			IR.Add(dst, left, right)
				slots[!dst] = slots[!left] + slots[!right]
			IR.Subtract(dst, left, right)
				slots[!dst] = slots[!left] - slots[!right]
			IR.Multiply(dst, left, right)
				slots[!dst] = slots[!left] * slots[!right]
			(IR.Divide | IR.Remainder)(dst, left, right)
				let numerator = slots[!left]
				let denominator = slots[!right]
				if denominator == 0
					eprint("ERROR: division by zero")
					return EXIT_RUNTIME_ERROR
				if numerator == (-IR.I64_MAX - 1) and denominator == -1
					eprint("ERROR: integer overflow")
					return EXIT_RUNTIME_ERROR
				if IR.Instruction.index(instruction) == IR.Instruction.index(IR.Divide)
					slots[!dst] = numerator / denominator
				else
					slots[!dst] = numerator % denominator
			IR.BitAnd(dst, left, right)
				slots[!dst] = slots[!left] & slots[!right]
			IR.BitOr(dst, left, right)
				slots[!dst] = slots[!left] | slots[!right]
			(IR.ShiftLeft | IR.ShiftRight)(dst, left, right)
				let count = slots[!right]
				if count < 0 or count >= IR.INTEGER_BITS
					eprint("ERROR: shift count out of range")
					return EXIT_RUNTIME_ERROR
				if IR.Instruction.index(instruction) == IR.Instruction.index(IR.ShiftLeft)
					slots[!dst] = slots[!left] << count
				else
					slots[!dst] = slots[!left] >> count
			IR.Copy(dst, input)
				slots[!dst] = slots[!input]
			IR.Return(input)
				if depth == 0
					return slots[!input]
				let type = module.functions[!function_id].result
				var scalar = 0
				var text = ""
				var optional = "".byte_at(0)
				var record = empty_record(0)
				var array = Array[i64]()
				var text_array = Array[string]()
				var record_array = Array[RecordValue]()
				var nested_array = Array[Array[i64]]()
				var nested_text_array = Array[Array[string]]()
				if type == IR.TYPE_STRING
					text = strings[!input]
				elif IR.is_optional(module.type_table, type)
					optional = optionals[!input]
				elif IR.is_record(module.type_table, type)
					record = records[!input]
				elif IR.is_array(module.type_table, type)
					let element = IR.array_element(module.type_table, type)
					if IR.is_record(module.type_table, element)
						record_array = record_arrays[!input]
					elif IR.is_array(module.type_table, element)
						if IR.array_element(module.type_table, element) == IR.TYPE_STRING
							nested_text_array = nested_text_arrays[!input]
						else
							nested_array = nested_arrays[!input]
					elif element == IR.TYPE_STRING
						text_array = text_arrays[!input]
					else
						array = arrays[!input]
				else
					scalar = slots[!input]
				depth -= 1
				let saved = stack[!depth]
				stack[!depth] = Frame(-1, 0, -1, [], [], [], [], [], [], [], [], [])
				function_id = saved.function
				program = module.functions[!function_id].body
				slots = saved.slots
				strings = saved.strings
				optionals = saved.optionals
				records = saved.records
				arrays = saved.arrays
				text_arrays = saved.text_arrays
				record_arrays = saved.record_arrays
				nested_arrays = saved.nested_arrays
				nested_text_arrays = saved.nested_text_arrays
				if type == IR.TYPE_STRING
					strings[!saved.dst] = text
				elif IR.is_optional(module.type_table, type)
					optionals[!saved.dst] = optional
				elif IR.is_record(module.type_table, type)
					records[!saved.dst] = record
				elif IR.is_array(module.type_table, type)
					let element = IR.array_element(module.type_table, type)
					if IR.is_record(module.type_table, element)
						record_arrays[!saved.dst] = record_array
					elif IR.is_array(module.type_table, element)
						if IR.array_element(module.type_table, element) == IR.TYPE_STRING
							nested_text_arrays[!saved.dst] = nested_text_array
						else
							nested_arrays[!saved.dst] = nested_array
					elif element == IR.TYPE_STRING
						text_arrays[!saved.dst] = text_array
					else
						arrays[!saved.dst] = array
				else
					slots[!saved.dst] = scalar
				next = saved.pc
		pc = next
	return EXIT_RUNTIME_ERROR

export def run_module(module: IR.Module) -> i64
	let error = IR.verify_module(module)
	if error != ""
		eprint("ERROR " + str(module.line) + ": " + error)
		return EXIT_RUNTIME_ERROR
	return execute(module)

# Keep the storage-verifier fixtures independent of source-level type metadata.
export def run(program: IR.Program) -> i64
	let error = IR.verify(program)
	if error != ""
		eprint("ERROR " + str(program.line) + ": " + error)
		return EXIT_RUNTIME_ERROR
	return execute(IR.Module([IR.Function("main", program, [], IR.TYPE_I64, [])], 0, IR.runtime_types(), "", 0))
