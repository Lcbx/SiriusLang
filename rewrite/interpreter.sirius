import ir alias IR

def compare(left: i64, right: i64, op: string) -> bool
	if op == "=="
		return left == right
	if op == "!="
		return left != right
	if op == "<"
		return left < right
	if op == "<="
		return left <= right
	if op == ">"
		return left > right
	return left >= right

export def run(program: IR.Program) -> i64
	let error = IR.verify(program)
	if error != ""
		eprint("ERROR " + str(program.line) + ": " + error)
		return 1
	var slots = Array[i64]()
	for i in 0..program.slots
		slots = slots.append(0)
	var pc = 0
	while pc < len(program.instructions)
		let instruction = program.instructions[!pc]
		var next = pc + 1
		match instruction
			IR.Compare(dst, left, right, op)
				var value = 0
				if compare(slots[!left], slots[!right], op)
					value = 1
				slots[!dst] = value
			IR.Branch(input, target)
				if slots[!input] == 0
					next = target
			IR.Jump(target)
				next = target
			IR.Nop
				next = pc + 1
			IR.Constant(dst, value)
				slots[!dst] = value
			IR.Negate(dst, input)
				slots[!dst] = -slots[!input]
			IR.Not(dst, input)
				var value = 0
				if slots[!input] == 0
					value = 1
				slots[!dst] = value
			IR.PrintBool(input)
				print(slots[!input] != 0)
			IR.Add(dst, left, right)
				slots[!dst] = slots[!left] + slots[!right]
			IR.Subtract(dst, left, right)
				slots[!dst] = slots[!left] - slots[!right]
			IR.Multiply(dst, left, right)
				slots[!dst] = slots[!left] * slots[!right]
			IR.BitAnd(dst, left, right)
				slots[!dst] = slots[!left] & slots[!right]
			IR.BitOr(dst, left, right)
				slots[!dst] = slots[!left] | slots[!right]
			IR.Copy(dst, input)
				slots[!dst] = slots[!input]
			IR.Print(input)
				print(slots[!input])
			IR.Return(input)
				return slots[!input]
		pc = next
	return 1
