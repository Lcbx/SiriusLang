import lexer alias Lex

let PREC_NONE = 0
let PREC_OR = 1
let PREC_AND = 2
let PREC_BIT_OR = 3
let PREC_COMPARE = 4
let PREC_SHIFT = 5
let PREC_ADD = 6
let PREC_MULTIPLY = 7
let PREC_UNARY = 8

# Flat expression arena: logical starts precede their conditional right operand.
export enum NodeKind
	IntegerLiteral
	StringLiteral
	StringPart
	Length
	StringConvert
	SliceBounds
	StringSlice
	StringStarts
	StringEnds
	StringByteAt
	StringFind
	OptionalUnwrap
	OptionalExit
	BooleanLiteral
	Compare
	AndStart
	OrStart
	LogicalEnd
	If
	Else
	EndIf
	LoopStart
	While
	EndWhile
	Negate
	Not
	Add
	Subtract
	Multiply
	Divide
	Remainder
	BitAnd
	BitOr
	ShiftLeft
	ShiftRight
	Variable
	Binding
	MutableBinding
	Assign
	FieldAssign
	Print
	Eprint
	Return
	Break
	Continue
	RangeBinding
	RangeCompare
	RangeCondition
	RangeStep
	One
	Parameter
	Argument
	Call
	FieldRead
	FieldTarget
	ArrayLiteral
	ArrayRead
	ArrayGet
	ArrayAppend
	DictLiteral
	DictPair
	DictInsert
	DictGet
	ArrayTarget
	ArraySet
	ArrayFieldUpdate
	Zero
	ArrayIndex
	ArrayElement

export rec Node(kind: NodeKind, left: i64, right: i64, token: i64)
export rec Function(token: i64, parameters: Array[i64], result: i64, start: i64, end: i64)
export rec Field(token: i64, annotation: i64)
export rec Record(token: i64, fields: Array[Field])
export rec State(source: string, tokens: Array[Lex.Token], nodes: Array[Node], functions: Array[Function], records: Array[Record], index: i64, error: string, error_line: i64)
export rec Parsed(state: State, node: i64)

export def kind_is(kind: NodeKind, expected: NodeKind) -> bool
	return kind == expected

def current(p: State) -> Lex.Token
	return p.tokens[!p.index]

def text(p: State) -> string
	let token = current(p)
	return p.source.slice(token.start, token.end)

def next_text(p: State) -> string
	let token = p.tokens[!p.index + 1]
	return p.source.slice(token.start, token.end)

def fail(p: State, message: string) -> State
	var result = p
	if result.error == ""
		result.error = message
		result.error_line = current(p).line
	return result

def expect(p: State, expected: string) -> State
	if p.error != ""
		return p
	if text(p) != expected
		return fail(p, "expected '" + expected + "'")
	var result = p
	result.index += 1
	return result

def expect_kind(p: State, kind: i64, expected: string) -> State
	if p.error != ""
		return p
	if current(p).kind != kind
		return fail(p, "expected " + expected)
	var result = p
	result.index += 1
	return result

def node(p: State, kind: NodeKind, left: i64, right: i64, token: i64) -> Parsed
	if p.error != ""
		return Parsed(p, -1)
	var result = p
	let id = len(result.nodes)
	result.nodes = result.nodes.append(Node(kind, left, right, token))
	return Parsed(result, id)

def precedence(op: string) -> i64
	if op == "or"
		return PREC_OR
	if op == "and"
		return PREC_AND
	if op == "|"
		return PREC_BIT_OR
	if op == "&" or op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
		return PREC_COMPARE
	if op == "+" or op == "-"
		return PREC_ADD
	if op == "*" or op == "/" or op == "%"
		return PREC_MULTIPLY
	if op == "<<" or op == ">>"
		return PREC_SHIFT
	return PREC_NONE

def interpolated(p: State) -> Parsed
	let token_id = p.index
	let token = current(p)
	let resume = p.index + 1
	var state = p
	var start = token.start + 2 # f and quote
	var pos = start
	var result = -1
	while pos < token.end - 1
		let byte = p.source.byte_at(pos) or 0
		if byte == Lex.ASCII_BACKSLASH # escaped characters, including \${
			pos += 2
			continue
		if byte != Lex.ASCII_DOLLAR or (p.source.byte_at(pos + 1) or 0) != Lex.ASCII_OPEN_BRACE
			pos += 1
			continue
		let literal = node(state, StringPart(), start, pos, token_id)
		state = literal.state
		if result < 0
			result = literal.node
		else
			let joined = node(state, Add(), result, literal.node, token_id)
			state = joined.state
			result = joined.node
		let end = Lex.interpolation_end(p.source, pos + 2)
		if end < 0
			return Parsed(fail(state, "unclosed interpolation"), -1)
		# Reuse the ordinary expression parser in the same arena and scope.
		# Parentheses suppress indentation; remap tokens to original byte offsets.
		let embedded = Lex.tokenize("(" + p.source.slice(pos + 2, end) + ")")
		let first = len(state.tokens)
		for i in 1..len(embedded)
			let part = embedded[!i]
			if part.kind >= Lex.TokenKind.index(Lex.InvalidChar)
				return Parsed(fail(state, "invalid interpolation expression: " + Lex.label(part.kind)), -1)
			let offset = pos + 1 + part.start
			state.tokens = state.tokens.append(Lex.Token(part.kind, offset, pos + 1 + part.end, token.line, token.column + offset - token.start))
		state.index = first
		let value = expression(state, PREC_OR)
		# The wrapper's final ')' maps to the source interpolation's '}'.
		state = expect(value.state, "}")
		let formatted = node(state, StringConvert(), value.node, -1, token_id)
		let joined = node(formatted.state, Add(), result, formatted.node, token_id)
		state = joined.state
		if state.error != ""
			return Parsed(state, -1)
		result = joined.node
		pos = end + 1
		start = pos
	let last = node(state, StringPart(), start, token.end - 1, token_id)
	state = last.state
	if result < 0
		result = last.node
	else
		let joined = node(state, Add(), result, last.node, token_id)
		state = joined.state
		result = joined.node
	state.index = resume
	return Parsed(state, result)

def expression(p: State, minimum: i64) -> Parsed
	var next = p
	let token = next.index
	var result = Parsed(next, -1)
	if text(next) == "-" or text(next) == "not"
		let logical = text(next) == "not"
		next.index += 1
		let operand = expression(next, PREC_UNARY)
		var kind: NodeKind = Negate()
		if logical
			kind = NodeKind.Not(Not())
		result = node(operand.state, kind, operand.node, -1, token)
	elif text(next) == "("
		next.index += 1
		let inside = expression(next, PREC_OR)
		result = Parsed(expect(inside.state, ")"), inside.node)
	elif text(next) == "true" or text(next) == "false"
		next.index += 1
		result = node(next, BooleanLiteral(), -1, -1, token)
	elif current(next).kind == Lex.TokenKind.index(Lex.InterpolatedString)
		result = interpolated(next)
	elif current(next).kind == Lex.TokenKind.index(Lex.String)
		next.index += 1
		result = node(next, StringLiteral(), -1, -1, token)
	elif (text(next) == "Array" or text(next) == "Dict") and next_text(next) == "["
		next = annotation(next)
		next = expect(next, "(")
		var kind: NodeKind = ArrayLiteral()
		if text(p) == "Dict"
			kind = NodeKind.DictLiteral(DictLiteral())
		result = node(expect(next, ")"), kind, -1, 0, token)
	elif text(next) == "["
		next.index += 1
		var arguments = -1
		var count = 0
		while next.error == "" and text(next) != "]"
			let value = expression(next, PREC_OR)
			let argument = node(value.state, Argument(), value.node, arguments, token)
			next = argument.state
			arguments = argument.node
			count += 1
			if text(next) != ","
				break
			next.index += 1
			if text(next) == "]"
				next = fail(next, "expected array element after comma")
		result = node(expect(next, "]"), ArrayLiteral(), arguments, count, token)
	elif (text(next) == "len" or text(next) == "str") and next_text(next) == "("
		var kind: NodeKind = Length()
		if text(next) == "str"
			kind = NodeKind.StringConvert(StringConvert())
		next.index += 1
		next = expect(next, "(")
		let value = expression(next, PREC_OR)
		result = node(expect(value.state, ")"), kind, value.node, -1, token)
	elif current(next).kind == Lex.TokenKind.index(Lex.Integer)
		next.index += 1
		result = node(next, IntegerLiteral(), -1, -1, token)
	elif current(next).kind == Lex.TokenKind.index(Lex.Name)
		next.index += 1
		if text(next) == "("
			next.index += 1
			var arguments = -1
			var count = 0
			while next.error == "" and text(next) != ")"
				let value = expression(next, PREC_OR)
				let argument = node(value.state, Argument(), value.node, arguments, token)
				next = argument.state
				arguments = argument.node
				count += 1
				if text(next) != ","
					break
				next.index += 1
				if text(next) == ")"
					next = fail(next, "expected argument after comma")
			result = node(expect(next, ")"), Call(), arguments, count, token)
		else
			result = node(next, Variable(), -1, -1, token)
	else
		return Parsed(fail(next, "expected integer expression"), -1)
	while result.state.error == ""
		let op = text(result.state)
		if op == "["
			var after = result.state
			let token = after.index
			after = expect(after, "[")
			var kind: NodeKind = ArrayRead()
			if text(after) == "?"
				kind = NodeKind.ArrayGet(ArrayGet())
				after = expect(after, "?")
			else
				after = expect(after, "!")
			let index = expression(after, PREC_OR)
			result = node(expect(index.state, "]"), kind, result.node, index.node, token)
			continue
		if op == "!"
			var after = result.state
			let unwrap_token = after.index
			after.index += 1
			result = node(after, OptionalUnwrap(), result.node, -1, unwrap_token)
			continue
		if op == "."
			var after = result.state
			after.index += 1
			let method_token = after.index
			let method = text(after)
			after = expect_kind(after, Lex.TokenKind.index(Lex.Name), "field name")
			if text(after) != "("
				result = node(after, FieldRead(), result.node, -1, method_token)
				continue
			if method == "get"
				after = expect(after, "(")
				let key = expression(after, PREC_OR)
				result = node(expect(key.state, ")"), DictGet(), result.node, key.node, method_token)
				continue
			if method == "insert"
				after = expect(after, "(")
				let key = expression(after, PREC_OR)
				after = expect(key.state, ",")
				let value = expression(after, PREC_OR)
				let pair = node(expect(value.state, ")"), DictPair(), key.node, value.node, method_token)
				result = node(pair.state, DictInsert(), result.node, pair.node, method_token)
				continue
			if method == "append"
				after = expect(after, "(")
				let value = expression(after, PREC_OR)
				result = node(expect(value.state, ")"), ArrayAppend(), result.node, value.node, method_token)
				continue
			if method != "slice" and method != "starts_with" and method != "ends_with" and method != "byte_at" and method != "find"
				return Parsed(fail(after, "unsupported string method"), -1)
			after = expect(after, "(")
			let first = expression(after, PREC_OR)
			if method == "slice"
				after = expect(first.state, ",")
				let last = expression(after, PREC_OR)
				let bounds = node(expect(last.state, ")"), SliceBounds(), first.node, last.node, method_token)
				result = node(bounds.state, StringSlice(), result.node, bounds.node, method_token)
			else
				var kind: NodeKind = StringStarts()
				if method == "ends_with"
					kind = NodeKind.StringEnds(StringEnds())
				elif method == "byte_at"
					kind = NodeKind.StringByteAt(StringByteAt())
				elif method == "find"
					kind = NodeKind.StringFind(StringFind())
				result = node(expect(first.state, ")"), kind, result.node, first.node, method_token)
			continue
		let priority = precedence(op)
		if priority < minimum
			break
		let operator_token = result.state.index
		var after = result.state
		after.index += 1
		if op == "and" or op == "or"
			var kind: NodeKind = AndStart()
			if op == "or"
				kind = NodeKind.OrStart(OrStart())
			let start = node(after, kind, result.node, -1, operator_token)
			let rhs = expression(start.state, priority + 1)
			let end = node(rhs.state, LogicalEnd(), start.node, rhs.node, operator_token)
			var state = end.state
			if state.error != ""
				return Parsed(state, -1)
			state.nodes[!start.node].right = len(state.nodes)
			result = Parsed(state, start.node)
			continue
		let rhs = expression(after, priority + 1)
		var kind: NodeKind = Add()
		if op == "-"
			kind = NodeKind.Subtract(Subtract())
		elif op == "*"
			kind = NodeKind.Multiply(Multiply())
		elif op == "/"
			kind = NodeKind.Divide(Divide())
		elif op == "%"
			kind = NodeKind.Remainder(Remainder())
		elif op == "&"
			kind = NodeKind.BitAnd(BitAnd())
		elif op == "|"
			kind = NodeKind.BitOr(BitOr())
		elif op == "<<"
			kind = NodeKind.ShiftLeft(ShiftLeft())
		elif op == ">>"
			kind = NodeKind.ShiftRight(ShiftRight())
		elif op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
			kind = NodeKind.Compare(Compare())
		result = node(rhs.state, kind, result.node, rhs.node, operator_token)
	return result

def is_assignment(p: State) -> bool
	if current(p).kind != Lex.TokenKind.index(Lex.Name)
		return false
	var index = p.index + 1
	while index < len(p.tokens)
		let mark = p.source.slice(p.tokens[!index].start, p.tokens[!index].end)
		if mark == "."
			if index + 1 >= len(p.tokens) or p.tokens[!index + 1].kind != Lex.TokenKind.index(Lex.Name)
				return false
			index += 2
		elif mark == "["
			var depth = 0
			while index < len(p.tokens)
				let bracket = p.source.slice(p.tokens[!index].start, p.tokens[!index].end)
				if bracket == "["
					depth += 1
				elif bracket == "]"
					depth -= 1
					if depth == 0
						index += 1
						break
				index += 1
			if depth != 0
				return false
		else
			break
	if index >= len(p.tokens)
		return false
	let token = p.tokens[!index]
	let op = p.source.slice(token.start, token.end)
	return op == "=" or op == "+=" or op == "-=" or op == "*=" or op == "/="

def annotation(p: State) -> State
	var result = p
	if text(result) == "Dict"
		result.index += 1
		result = expect(result, "[")
		result = annotation(result)
		result = expect(result, ",")
		result = annotation(result)
		return expect(result, "]")
	if text(result) == "Array"
		result.index += 1
		result = expect(result, "[")
		result = annotation(result)
		return expect(result, "]")
	if text(result) == "Optional"
		result.index += 1
		result = expect(result, "[")
		result = annotation(result)
		return expect(result, "]")
	return expect_kind(result, Lex.TokenKind.index(Lex.Name), "type name")

def block(initial: State, loop_start: i64) -> State
	var p = initial
	p = expect_kind(p, Lex.TokenKind.index(Lex.Newline), "newline")
	p = expect_kind(p, Lex.TokenKind.index(Lex.Indent), "indented body")
	var returned = false
	while p.error == "" and current(p).kind != Lex.TokenKind.index(Lex.Dedent) and current(p).kind != Lex.TokenKind.index(Lex.Eof)
		let token = p.index
		if returned
			return fail(p, "statement after control-flow exit")
		if text(p) == "for"
			p.index += 1
			let name = p.index
			p = expect_kind(p, Lex.TokenKind.index(Lex.Name), "loop binding")
			p = expect(p, "in")
			let lower = expression(p, PREC_OR)
			var binding = Parsed(lower.state, -1)
			var upper = Parsed(lower.state, -1)
			var element_source = -1
			if text(lower.state) == ".."
				p = expect(lower.state, "..")
				upper = expression(p, PREC_OR)
				binding = node(upper.state, RangeBinding(), lower.node, upper.node, name)
			else
				element_source = lower.node
				let zero = node(lower.state, Zero(), -1, -1, token)
				upper = node(zero.state, Length(), lower.node, -1, token)
				binding = node(upper.state, ArrayIndex(), zero.node, upper.node, name)
			let one = node(binding.state, One(), -1, -1, token)
			let compare = node(one.state, RangeCompare(), binding.node, upper.node, token)
			let branch = node(compare.state, RangeCondition(), compare.node, -1, token)
			var body = branch.state
			if element_source >= 0
				body = node(body, ArrayElement(), element_source, binding.node, name).state
			p = block(body, compare.node)
			if p.error != ""
				return p
			let step = len(p.nodes)
			p = node(p, RangeStep(), binding.node, one.node, token).state
			p = node(p, EndWhile(), compare.node, -1, token).state
			let end = len(p.nodes)
			p.nodes[!branch.node].right = end
			for i in compare.node..step
				if p.nodes[!i].left == compare.node
					if kind_is(p.nodes[!i].kind, Break())
						p.nodes[!i].right = end
					elif kind_is(p.nodes[!i].kind, Continue())
						p.nodes[!i].left = step
			continue
		if text(p) == "if" or text(p) == "while"
			let loop = text(p) == "while"
			let start = len(p.nodes)
			if loop
				p = node(p, LoopStart(), -1, -1, token).state
			p.index += 1
			let condition = expression(p, PREC_OR)
			var kind: NodeKind = If()
			if loop
				kind = NodeKind.While(While())
			let branch = node(condition.state, kind, condition.node, -1, token)
			var body_loop = loop_start
			if loop
				body_loop = start
			p = block(branch.state, body_loop)
			if p.error != ""
				return p
			# An elif is an if in the preceding else scope. Parse chains
			# iteratively; only genuinely nested source blocks recurse.
			var current_branch = branch.node
			var exits = Array[i64]()
			var levels = 1
			var has_else = false
			while not loop and (text(p) == "elif" or text(p) == "else")
				let alternate_token = p.index
				has_else = text(p) == "else"
				let alternate = len(p.nodes)
				p = node(p, Else(), -1, -1, alternate_token).state
				p.nodes[!current_branch].right = alternate + 1
				exits = exits.append(alternate)
				p.index += 1
				if not has_else
					let condition = expression(p, PREC_OR)
					let next_branch = node(condition.state, If(), condition.node, -1, alternate_token)
					p = next_branch.state
					current_branch = next_branch.node
					levels += 1
				p = block(p, loop_start)
				if p.error != ""
					return p
				if has_else
					break
			let end = len(p.nodes)
			if loop
				p = node(p, EndWhile(), start, -1, token).state
				p.nodes[!branch.node].right = end + 1
				for i in start..end
					if kind_is(p.nodes[!i].kind, Break()) and p.nodes[!i].left == start
						p.nodes[!i].right = end + 1
			else
				for level in 0..levels
					p = node(p, EndIf(), -1, -1, token).state
				if not has_else
					p.nodes[!current_branch].right = end
				for exit in exits
					p.nodes[!exit].right = end
			continue
		elif text(p) == "let" or text(p) == "var"
			let mutable = text(p) == "var"
			p.index += 1
			let name = p.index
			p = expect_kind(p, Lex.TokenKind.index(Lex.Name), "binding name")
			var type_token = -1
			if text(p) == ":"
				p = expect(p, ":")
				type_token = p.index
				p = annotation(p)
			p = expect(p, "=")
			var value = expression(p, PREC_OR)
			if value.state.error == "" and text(value.state) == "else"
				p = expect(value.state, "else")
				p = expect(p, "return")
				let start = node(p, OptionalExit(), value.node, -1, token)
				let fallback = expression(start.state, PREC_OR)
				p = node(fallback.state, Return(), fallback.node, -1, token).state
				if p.error != ""
					return p
				p.nodes[!start.node].right = len(p.nodes)
				value = Parsed(p, start.node)
			var kind: NodeKind = Binding()
			if mutable
				kind = NodeKind.MutableBinding(MutableBinding())
			p = node(value.state, kind, value.node, type_token, name).state
		elif (text(p) == "print" or text(p) == "eprint") and next_text(p) == "("
			var kind: NodeKind = Print()
			if text(p) == "eprint"
				kind = NodeKind.Eprint(Eprint())
			p.index += 1
			p = expect(p, "(")
			let value = expression(p, PREC_OR)
			p = expect(value.state, ")")
			p = node(p, kind, value.node, -1, token).state
		elif text(p) == "return"
			p = expect(p, "return")
			let value = expression(p, PREC_OR)
			p = node(value.state, Return(), value.node, -1, token).state
			returned = true
		elif text(p) == "break" or text(p) == "continue"
			if loop_start < 0
				return fail(p, "loop exit outside loop")
			var kind: NodeKind = Break()
			if text(p) == "continue"
				kind = NodeKind.Continue(Continue())
			p.index += 1
			p = node(p, kind, loop_start, -1, token).state
			returned = true
		elif is_assignment(p)
			p.index += 1
			if text(p) == "." or text(p) == "["
				# Keep the mutable root as a binding reference. Each intermediate
				# read owns a value; write modified values back from leaf to root.
				let root = node(p, FieldTarget(), -1, -1, token)
				p = root.state
				var base = root.node
				var steps = Array[i64]()
				var final_field = -1
				var final_index = -1
				var final_is_field = false
				while p.error == "" and (text(p) == "." or text(p) == "[")
					let field = text(p) == "."
					var field_token = -1
					var index_node = -1
					if field
						p.index += 1
						field_token = p.index
						p = expect_kind(p, Lex.TokenKind.index(Lex.Name), "field name")
					else
						p = expect(p, "[")
						p = expect(p, "!")
						let index = expression(p, PREC_OR)
						p = expect(index.state, "]")
						index_node = index.node
					if text(p) != "." and text(p) != "["
						final_field = field_token
						final_index = index_node
						final_is_field = field
						break
					var read = Parsed(p, -1)
					if field
						read = node(p, FieldRead(), base, -1, field_token)
					else
						read = node(p, ArrayRead(), base, index_node, token)
					p = read.state
					base = read.node
					steps = steps.append(read.node)
				let op = text(p)
				let operator_token = p.index
				var old = -1
				if op != "="
					var read = Parsed(p, -1)
					if final_is_field
						read = node(p, FieldRead(), base, -1, final_field)
					else
						read = node(p, ArrayRead(), base, final_index, token)
					p = read.state
					old = read.node
				p.index += 1
				var value = expression(p, PREC_OR)
				if op != "="
					var kind: NodeKind = Add()
					if op == "-="
						kind = NodeKind.Subtract(Subtract())
					elif op == "*="
						kind = NodeKind.Multiply(Multiply())
					elif op == "/="
						kind = NodeKind.Divide(Divide())
					value = node(value.state, kind, old, value.node, operator_token)
				p = value.state
				if final_is_field
					p = node(p, ArrayFieldUpdate(), base, value.node, final_field).state
				else
					let target = node(p, ArrayTarget(), base, final_index, token)
					p = node(target.state, ArraySet(), target.node, value.node, token).state
				# The intermediate read nodes are mutable local value slots.
				# Only their immediate parent must be updated at each step.
				var child = base
				for n in 0..len(steps)
					let step = p.nodes[!steps[!len(steps) - 1 - n]]
					if kind_is(step.kind, FieldRead())
						p = node(p, ArrayFieldUpdate(), step.left, child, step.token).state
					else
						let target = node(p, ArrayTarget(), step.left, step.right, token)
						p = node(target.state, ArraySet(), target.node, child, token).state
					child = step.left
				p = expect_kind(p, Lex.TokenKind.index(Lex.Newline), "newline")
				continue
			let op = text(p)
			let operator_token = p.index
			var left = -1
			if op != "="
				let read = node(p, Variable(), -1, -1, token)
				p = read.state
				left = read.node
			p.index += 1
			var value = expression(p, PREC_OR)
			if op != "="
				var kind: NodeKind = Add()
				if op == "-="
					kind = NodeKind.Subtract(Subtract())
				elif op == "*="
					kind = NodeKind.Multiply(Multiply())
				elif op == "/="
					kind = NodeKind.Divide(Divide())
				value = node(value.state, kind, left, value.node, operator_token)
			p = node(value.state, Assign(), value.node, -1, token).state
		else
			# A guard is an if on the negated condition with one exit statement.
			let condition = expression(p, PREC_OR)
			p = expect(condition.state, "else")
			let negated = node(p, Not(), condition.node, -1, token)
			let branch = node(negated.state, If(), negated.node, -1, token)
			p = branch.state
			if text(p) == "return"
				let exit_token = p.index
				p.index += 1
				let value = expression(p, PREC_OR)
				p = node(value.state, Return(), value.node, -1, exit_token).state
			elif text(p) == "break" or text(p) == "continue"
				if loop_start < 0
					return fail(p, "loop exit outside loop")
				var kind: NodeKind = Break()
				if text(p) == "continue"
					kind = NodeKind.Continue(Continue())
				let exit_token = p.index
				p.index += 1
				p = node(p, kind, loop_start, -1, exit_token).state
			else
				return fail(p, "guard else requires return, break, or continue")
			if p.error != ""
				return p
			let end = len(p.nodes)
			p = node(p, EndIf(), -1, -1, token).state
			p.nodes[!branch.node].right = end
		p = expect_kind(p, Lex.TokenKind.index(Lex.Newline), "newline")
	if p.error != ""
		return p
	return expect_kind(p, Lex.TokenKind.index(Lex.Dedent), "dedent")

export def parse(source: string) -> State
	let tokens = Lex.tokenize(source)
	var p = State(source, tokens, Array[Node](), Array[Function](), Array[Record](), 0, "", 0)
	for token in tokens
		if token.kind >= Lex.TokenKind.index(Lex.InvalidChar)
			p.error = Lex.label(token.kind)
			p.error_line = token.line
			return p
	while p.error == "" and current(p).kind != Lex.TokenKind.index(Lex.Eof)
		if text(p) == "rec"
			p.index += 1
			let record_name = p.index
			p = expect_kind(p, Lex.TokenKind.index(Lex.Name), "record name")
			p = expect(p, "(")
			var fields = Array[Field]()
			while p.error == "" and text(p) != ")"
				let field_name = p.index
				p = expect_kind(p, Lex.TokenKind.index(Lex.Name), "field name")
				p = expect(p, ":")
				let type_token = p.index
				p = annotation(p)
				fields = fields.append(Field(field_name, type_token))
				if text(p) != ","
					break
				p.index += 1
				if text(p) == ")"
					p = fail(p, "expected field after comma")
			p = expect(p, ")")
			p = expect_kind(p, Lex.TokenKind.index(Lex.Newline), "newline")
			if p.error == ""
				p.records = p.records.append(Record(record_name, fields))
			continue
		p = expect(p, "def")
		let name = p.index
		p = expect_kind(p, Lex.TokenKind.index(Lex.Name), "function name")
		p = expect(p, "(")
		let start = len(p.nodes)
		var parameters = Array[i64]()
		while p.error == "" and text(p) != ")"
			let parameter_name = p.index
			p = expect_kind(p, Lex.TokenKind.index(Lex.Name), "parameter name")
			p = expect(p, ":")
			let type_token = p.index
			p = annotation(p)
			let parameter = node(p, Parameter(), -1, type_token, parameter_name)
			p = parameter.state
			parameters = parameters.append(parameter.node)
			if text(p) != ","
				break
			p.index += 1
			if text(p) == ")"
				p = fail(p, "expected parameter after comma")
		p = expect(p, ")")
		p = expect(p, "->")
		let result = p.index
		p = annotation(p)
		p = block(p, -1)
		if p.error == ""
			p.functions = p.functions.append(Function(name, parameters, result, start, len(p.nodes)))
	return expect_kind(p, Lex.TokenKind.index(Lex.Eof), "end of file")


