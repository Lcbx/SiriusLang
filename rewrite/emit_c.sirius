import ir alias IR
import lower alias Lower

let OCTAL_RADIX = 8
let OCTAL_HIGH_PLACE = 64
let OPTIONAL_FORMAT_BUFFER_SIZE = 32

export rec Result(code: string, error: string, line: i64)

def slot(id: i64) -> string
	return "v[" + str(id) + "]"

def string_slot(id: i64) -> string
	return "s[" + str(id) + "]"

def optional_slot(id: i64) -> string
	return "o[" + str(id) + "]"

def output(input: i64, type: IR.OutputType, stderr: bool) -> string
	var function = "s_print_"
	if stderr
		function = "s_eprint_"
	match type
		IR.Integer
			return function + "i64(signed_value(" + slot(input) + "));\n"
		IR.Boolean
			return function + "bool(" + slot(input) + " != 0);\n"
		IR.Text
			return function + "string(" + string_slot(input) + ");\n"

# Fixed-width octal escapes preserve every UTF-8 byte, including embedded NUL.
def c_bytes(value: string) -> string
	var parts = Array[string]()
	for i in 0..len(value)
		let byte = value.byte_at(i) or 0
		parts = parts.append("\\" + str(byte / OCTAL_HIGH_PLACE) + str((byte / OCTAL_RADIX) % OCTAL_RADIX) + str(byte % OCTAL_RADIX))
	return "\"" + "".join(parts) + "\""

def c_type(type: i64, table: IR.TypeTable) -> string
	if type == IR.TYPE_STRING
		return "S_String *"
	if IR.is_optional(table, type)
		return "S_Optional_i64 "
	if type == IR.TYPE_BOOL
		return "bool "
	return "uint64_t "

def value_slot(id: i64, type: i64, table: IR.TypeTable) -> string
	if type == IR.TYPE_STRING
		return string_slot(id)
	if IR.is_optional(table, type)
		return optional_slot(id)
	return slot(id)

def declaration(function: IR.Function, id: i64, table: IR.TypeTable) -> string
	var parameters = Array[string]()
	for i in 0..len(function.parameters)
		parameters = parameters.append(c_type(function.parameters[!i], table) + "p" + str(i))
	var arguments = ", ".join(parameters)
	if len(parameters) == 0
		arguments = "void"
	return "static inline " + c_type(function.result, table) + "f" + str(id) + "(" + arguments + ")"

def emit_function(function: IR.Function, id: i64, table: IR.TypeTable) -> string
	let program = function.body
	let has_strings = IR.function_has_strings(function)
	var lines = [declaration(function, id, table) + " {\n"]
	var has_scalars = false
	for type in function.types
		if type == IR.TYPE_I64 or type == IR.TYPE_BOOL
			has_scalars = true
	if has_scalars
		lines = lines.append("uint64_t v[" + str(program.slots) + "]; (void)v;\n")
	if has_strings
		lines = lines.append("S_String *s[" + str(program.slots) + "] = {0}; (void)s;\n")
	if IR.function_has_optionals(function, table)
		lines = lines.append("S_Optional_i64 o[" + str(program.slots) + "]; (void)o;\n")
	# Arguments are borrowed. Parameter slots retain their own references so all
	# string slots follow the same overwrite/return cleanup rule.
	for i in 0..len(function.parameters)
		let type = function.parameters[!i]
		if type == IR.TYPE_STRING
			lines = lines.append("store_string(&" + string_slot(i) + ", s_string_retain(p" + str(i) + "));\n")
		else
			lines = lines.append(value_slot(i, type, table) + " = p" + str(i) + ";\n")
	lines = lines.append("goto L0;\n")
	for index in 0..len(program.instructions)
		let instruction = program.instructions[!index]
		lines = lines.append("L" + str(index) + ":;\n")
		var fallthrough = true
		match instruction
			IR.Call(dst, target, arguments)
				var inputs = Array[string]()
				for input in arguments
					inputs = inputs.append(value_slot(input, function.types[!input], table))
				let call = "f" + str(target) + "(" + ", ".join(inputs) + ")"
				let type = function.types[!dst]
				if type == IR.TYPE_STRING
					lines = lines.append("store_string(&" + string_slot(dst) + ", " + call + ");\n")
				else
					lines = lines.append(value_slot(dst, type, table) + " = " + call + ";\n")
			IR.OptionalUnwrap(dst, input)
				let value = optional_slot(input)
				lines = lines.append("if (!" + value + ".has_value) s_panic(\"missing optional value\");\n")
				lines = lines.append(slot(dst) + " = (uint64_t)" + value + ".value;\n")
			IR.StringByteAt(dst, left, right)
				lines = lines.append(optional_slot(dst) + " = s_string_byte_at(" + string_slot(left) + ", signed_value(" + slot(right) + "));\n")
			IR.StringFind(dst, left, right)
				lines = lines.append(optional_slot(dst) + " = s_string_find(" + string_slot(left) + ", " + string_slot(right) + ");\n")
			IR.OptionalCopy(dst, input)
				lines = lines.append(optional_slot(dst) + " = " + optional_slot(input) + ";\n")
			IR.OptionalDefault(dst, input, target)
				let value = optional_slot(input)
				lines = lines.append(slot(dst) + " = " + value + ".has_value ? (uint64_t)" + value + ".value : UINT64_C(0);\n")
				lines = lines.append("if (" + value + ".has_value) goto L" + str(target) + ";\n")
			IR.StringFormat(dst, input, type)
				let target = "store_string(&" + string_slot(dst) + ", "
				match type
					IR.Integer
						lines = lines.append(target + "s_string_from_i64(signed_value(" + slot(input) + ")));\n")
					IR.Boolean
						lines = lines.append(target + "s_string_from_utf8(" + slot(input) + " ? \"true\" : \"false\"));\n")
					IR.OptionalInteger
						let value = optional_slot(input)
						# Some( plus a signed i64 and closing parenthesis fits 27 bytes.
						lines = lines.append("if (" + value + ".has_value) { char text[" + str(OPTIONAL_FORMAT_BUFFER_SIZE) + "]; snprintf(text, sizeof text, \"Some(%\" PRId64 \")\", " + value + ".value); " + target + "s_string_from_utf8(text)); } else { " + target + "s_string_from_utf8(\"None\")); }\n")
			IR.Output(input, type, stderr)
				lines = lines.append(output(input, type, stderr))
			IR.StringSlice(dst, input, start, end)
				lines = lines.append("store_string(&" + string_slot(dst) + ", s_string_slice(" + string_slot(input) + ", signed_value(" + slot(start) + "), signed_value(" + slot(end) + ")));\n")
			(IR.StringStarts | IR.StringEnds)(dst, left, right)
				var method = "s_string_starts_with"
				if IR.Instruction.index(instruction) == IR.Instruction.index(IR.StringEnds)
					method = "s_string_ends_with"
				lines = lines.append(slot(dst) + " = " + method + "(" + string_slot(left) + ", " + string_slot(right) + ");\n")
			IR.StringConstant(dst, value)
				lines = lines.append("store_string(&" + string_slot(dst) + ", s_string_from_bytes(" + c_bytes(value) + ", " + str(len(value)) + "));\n")
			IR.StringCopy(dst, input)
				lines = lines.append("store_string(&" + string_slot(dst) + ", s_string_retain(" + string_slot(input) + "));\n")
			IR.StringConcat(dst, left, right)
				lines = lines.append("store_string(&" + string_slot(dst) + ", s_string_concat(" + string_slot(left) + ", " + string_slot(right) + "));\n")
			IR.StringLength(dst, input)
				lines = lines.append(slot(dst) + " = s_string_length(" + string_slot(input) + ");\n")
			IR.StringCompare(dst, left, right, op)
				lines = lines.append(slot(dst) + " = s_string_compare(" + string_slot(left) + ", " + string_slot(right) + ") " + op + " 0;\n")
			IR.ShortCircuit(dst, input, target, when_true)
				lines = lines.append(slot(dst) + " = " + slot(input) + ";\n")
				var condition = "!" + slot(input)
				if when_true
					condition = slot(input)
				lines = lines.append("if (" + condition + ") goto L" + str(target) + ";\n")
			IR.Compare(dst, left, right, op)
				lines = lines.append(slot(dst) + " = signed_value(" + slot(left) + ") " + op + " signed_value(" + slot(right) + ");\n")
			IR.Branch(input, target)
				lines = lines.append("if (!" + slot(input) + ") goto L" + str(target) + ";\n")
			IR.Jump(target)
				lines = lines.append("goto L" + str(target) + ";\n")
				fallthrough = false
			IR.Nop
				fallthrough = true
			IR.Constant(dst, value)
				lines = lines.append(slot(dst) + " = UINT64_C(" + str(value) + ");\n")
			IR.Negate(dst, input)
				lines = lines.append(slot(dst) + " = UINT64_C(0) - " + slot(input) + ";\n")
			IR.Not(dst, input)
				lines = lines.append(slot(dst) + " = !" + slot(input) + ";\n")
			IR.Add(dst, left, right)
				lines = lines.append(slot(dst) + " = " + slot(left) + " + " + slot(right) + ";\n")
			IR.Subtract(dst, left, right)
				lines = lines.append(slot(dst) + " = " + slot(left) + " - " + slot(right) + ";\n")
			IR.Multiply(dst, left, right)
				lines = lines.append(slot(dst) + " = " + slot(left) + " * " + slot(right) + ";\n")
			(IR.Divide | IR.Remainder)(dst, left, right)
				let numerator = "signed_value(" + slot(left) + ")"
				let denominator = "signed_value(" + slot(right) + ")"
				lines = lines.append("if (" + denominator + " == 0) s_panic(\"division by zero\");\n")
				lines = lines.append("if (" + numerator + " == INT64_MIN && " + denominator + " == -1) s_panic(\"integer overflow\");\n")
				var op = " / "
				if IR.Instruction.index(instruction) == IR.Instruction.index(IR.Remainder)
					op = " % "
				lines = lines.append(slot(dst) + " = " + numerator + op + denominator + ";\n")
			IR.BitAnd(dst, left, right)
				lines = lines.append(slot(dst) + " = " + slot(left) + " & " + slot(right) + ";\n")
			IR.BitOr(dst, left, right)
				lines = lines.append(slot(dst) + " = " + slot(left) + " | " + slot(right) + ";\n")
			(IR.ShiftLeft | IR.ShiftRight)(dst, left, right)
				let count = slot(right)
				lines = lines.append("if (" + count + " >= UINT64_C(" + str(IR.INTEGER_BITS) + ")) s_panic(\"shift count out of range\");\n")
				var value = slot(left) + " << " + count
				if IR.Instruction.index(instruction) == IR.Instruction.index(IR.ShiftRight)
					value = slot(left) + " >> " + count
				lines = lines.append(slot(dst) + " = " + value + ";\n")
			IR.Copy(dst, input)
				lines = lines.append(slot(dst) + " = " + slot(input) + ";\n")
			IR.Return(input)
				var value = value_slot(input, function.result, table)
				if function.result == IR.TYPE_STRING
					value = "s_string_retain(" + value + ")"
				lines = lines.append("{ " + c_type(function.result, table) + "result = " + value + ";\n")
				if has_strings
					lines = lines.append("for (size_t i = 0; i < " + str(program.slots) + "; ++i) s_string_release(s[i]);\n")
				lines = lines.append("return result; }\n")
				fallthrough = false
		if fallthrough
			lines = lines.append("goto L" + str(index + 1) + ";\n")
	lines = lines.append("}\n")
	return "".join(lines)

export def emit(module: IR.Module) -> Result
	let error = IR.verify_module(module)
	if error != ""
		return Result("", error, module.line)
	var lines = ["#include <stdint.h>\n#include <inttypes.h>\n#include <stdio.h>\n#include <string.h>\n#include \"sirius_runtime.h\"\n"]
	var has_strings = false
	for function in module.functions
		if IR.function_has_strings(function)
			has_strings = true
	if has_strings
		lines = lines.append("static inline void store_string(S_String **dst, S_String *value) { s_string_release(*dst); *dst = value; }\n")
	lines = lines.append("static int64_t signed_value(uint64_t n) { int64_t r; memcpy(&r, &n, sizeof r); return r; }\n")
	for id in 0..len(module.functions)
		lines = lines.append(declaration(module.functions[!id], id, module.type_table) + ";\n")
	for id in 0..len(module.functions)
		lines = lines.append(emit_function(module.functions[!id], id, module.type_table))
	lines = lines.append("int main(void) { return (int)signed_value(f" + str(module.entry) + "()); }\n")
	return Result("".join(lines), "", 0)

export def compile(source: string) -> Result
	return emit(Lower.lower(source))
