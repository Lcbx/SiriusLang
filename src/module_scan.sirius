# Compiler-owned source-module discovery and export interface extraction.
# The manifest is a deterministic tab-separated protocol; its fields are
# identifiers or normalized type expressions, never arbitrary source text.
rec ModuleScanExport(name: string, parameters: Array[HirParameterDecl], argument_types: Array[i64], result_type: i64)
	pub constructor = false
	pub generic = false
rec ModuleScanUnit(name: string, path: string, tree: ParseState, declarations: HirModuleDecl, types: TypeTable, exports: Array[ModuleScanExport], has_main: bool)
	pub exported_constants = Array[HirModuleConstant]()
rec ModuleScanResult(visited: Array[string], error: string, units: Array[ModuleScanUnit])
rec ModuleScanType(text: string, valid: bool)

# Import dependency interfaces into a private HIR declaration context. This
# path is shared by export-signature resolution and actual module compilation.
rec ModuleScanImports(declarations: HirModuleDecl, error: string)

def module_scan_import_declarations(decl: HirModuleDecl, units: Array[ModuleScanUnit]) -> ModuleScanImports
	var declarations = decl
	var types = declarations.types
	for imported in declarations.imports
		var found = false
		for dependency in units
			if dependency.name != imported.path
				continue
			found = true
			for exported in dependency.exports
				var parameters = Array[HirParameterDecl]()
				var arguments = Array[i64]()
				for i in 0..len(exported.parameters)
					let imported_type = module_import_type(types, dependency.types, exported.argument_types[!i])
					types = imported_type.table
					if imported_type.id == TYPE_TAG_INVALID and exported.argument_types[!i] != TYPE_TAG_INVALID
						return ModuleScanImports(declarations, "unsupported imported parameter type: " + dependency.name + "." + exported.name)
					arguments = arguments.append(imported_type.id)
					parameters = parameters.append(HirParameterDecl(exported.parameters[!i].name, -1, -1))
				let result_type = module_import_type(types, dependency.types, exported.result_type)
				types = result_type.table
				if result_type.id == TYPE_TAG_INVALID
					return ModuleScanImports(declarations, "unsupported imported return type: " + dependency.name + "." + exported.name)
				var function = HirFunctionDecl(hir_module_symbol(dependency.name, exported.name), -1, -1 - len(declarations.functions), false, -1, parameters)
				function.external = true
				function.constructor = exported.constructor
				function.argument_types = arguments
				function.result_type = result_type.id
				declarations.functions = declarations.functions.append(function)
			for constant in dependency.exported_constants
				let copied = module_import_constant(types, declarations.values, dependency.types, dependency.declarations.values, constant.value)
				if copied.index < 0
					return ModuleScanImports(declarations, "unsupported imported constant: " + dependency.name + "." + constant.name)
				types = copied.table
				declarations.values = copied.values
				let type_id = declarations.values[!copied.index].type_id
				declarations.constants = declarations.constants.append(HirModuleConstant(hir_module_symbol(dependency.name, constant.name), copied.index, type_id))
		if not found
			return ModuleScanImports(declarations, "missing dependency: " + imported.path)
	declarations.types = types
	return ModuleScanImports(declarations, "")

# Prevent module path components from escaping the source root.
def module_scan_path_valid(path: string) -> bool
	if len(path) == 0
		return false
	var segment_start = true
	for i in 0..len(path)
		let c = path.byte_at(i) or 0
		if c == 46 # '.'
			if segment_start
				return false
			segment_start = true
		elif segment_start
			if not is_alpha(c)
				return false
			segment_start = false
		elif not is_ident(c)
			return false
	return not segment_start

def module_scan_reserved(name: string) -> bool
	for word in ["let", "var", "def", "rec", "extern", "pub", "export", "if", "elif", "else", "while", "for", "return", "and", "or", "not", "true", "false", "in", "import", "alias", "break", "continue"]
		if word == name
			return true
	return false

def module_scan_type(tree: ParseState, id: i64) -> ModuleScanType
	if id < 0 or tree.nodes[!id].kind != NODE_TYPE
		return ModuleScanType("", false)
	let name = hir_ast_text(tree, id)
	let count = tree.nodes[!id].count
	if count == 0
		return ModuleScanType(name, true) # Checked against the module TypeTable below.
	if (name != "Array" and name != "Optional" and name != "Dict") or (name == "Dict" and count != 2) or (name != "Dict" and count != 1)
		return ModuleScanType("", false)
	var result = name + "["
	for i in 0..count
		let child = module_scan_type(tree, hir_ast_child(tree, id, i))
		if not child.valid
			return ModuleScanType("", false)
		if i > 0
			result += ", "
		result += child.text
	return ModuleScanType(result + "]", true)

def module_scan_export(tree: ParseState, fn_decl: HirFunctionDecl) -> string
	var params = ""
	for i in 0..len(fn_decl.parameters)
		let param = fn_decl.parameters[!i]
		if i > 0
			params += ", "
		if param.type_node < 0
			params += param.name
		else
			let typ = module_scan_type(tree, param.type_node)
			if not typ.valid
				return ""
			params += param.name + ": " + typ.text
	let result = module_scan_type(tree, fn_decl.result_type_node)
	if not result.valid
		return ""
	return fn_decl.name + "\t" + params + "\t" + result.text + "\n"

def module_scan_visit(root: string, name: string, visiting: Array[string], done: Array[string], units: Array[ModuleScanUnit]) -> ModuleScanResult
	if not module_scan_path_valid(name)
		return ModuleScanResult(done, "invalid module path: " + name, units)
	for current in visiting
		if current == name
			var chain = ""
			for part in visiting
				if chain != ""
					chain += " -> "
				chain += part
			return ModuleScanResult(done, "cyclic source imports: " + chain + " -> " + name, units)
	for current in done
		if current == name
			return ModuleScanResult(done, "", units)
	let path = module_scan_filename(root, name)
	let source = read_text(path) else return ModuleScanResult(done, "module " + name + " not found under source root: " + path, units)
	let parsed = parse_module(source)
	if parsed.state.error != ""
		return ModuleScanResult(done, name + ":" + str(parsed.state.error_line) + ": " + parsed.state.error, units)
	let decl = hir_module_declarations(parsed.state, parsed.node)
	if decl.error != ""
		return ModuleScanResult(done, name + ":" + str(decl.error_line) + ": " + decl.error, units)
	var state = ModuleScanResult(done, "", units)
	let stack = visiting.append(name)
	for imported in decl.imports
		if module_scan_reserved(imported.alias)
			return ModuleScanResult(state.visited, name + ": invalid import alias: " + imported.alias, state.units)
		state = module_scan_visit(root, imported.path, stack, state.visited, state.units)
		if state.error != ""
			return state
	let imported = module_scan_import_declarations(decl, state.units)
	if imported.error != ""
		return ModuleScanResult(state.visited, name + ": " + imported.error, state.units)
	let resolved = hir_resolve_module_calls(parsed.state, imported.declarations)
	if resolved.error != ""
		return ModuleScanResult(state.visited, name + ":" + str(resolved.line) + ": " + resolved.error, state.units)
	var signatures = Array[ModuleScanExport]()
	var exported_constants = Array[HirModuleConstant]()
	var types = imported.declarations.types
	for exported in decl.exports
		var found = false
		for fn_decl in imported.declarations.functions
			if fn_decl.name == exported
				var arguments = Array[i64]()
				var generic = false
				for parameter in fn_decl.parameters
					if parameter.type_node < 0
						if fn_decl.constructor
							return ModuleScanResult(state.visited, name + ": exported constructors require parameter annotations: " + exported, state.units)
						generic = true
						arguments = arguments.append(TYPE_TAG_INVALID)
						continue
					let resolved = hir_module_type_reference_with_constants(types, resolved.tree, parameter.type_node, imported.declarations.functions, imported.declarations.constants)
					types = resolved.table
					if resolved.type_id == TYPE_TAG_INVALID
						return ModuleScanResult(state.visited, name + ": unsupported exported signature: " + exported, state.units)
					arguments = arguments.append(resolved.type_id)
				var return_type = TYPE_TAG_INVALID
				if fn_decl.constructor
					# Export only constructors that expose direct parameter fields.
					# Computed pub expressions require exporting executable code instead.
					let body = resolved.tree.nodes[!fn_decl.body]
					if body.count == 0
						return ModuleScanResult(state.visited, name + ": exported constructor requires public fields: " + exported, state.units)
					for i in 0..body.count
						let pub_id = hir_ast_child(resolved.tree, fn_decl.body, i)
						let pub = resolved.tree.nodes[!pub_id]
						if pub.kind != NODE_PUB or pub.count != 0
							return ModuleScanResult(state.visited, name + ": exported constructor requires direct pub fields: " + exported, state.units)
						var matches = false
						for parameter in fn_decl.parameters
							if parameter.name == hir_ast_text(resolved.tree, pub_id)
								matches = true
						if not matches
							return ModuleScanResult(state.visited, name + ": exported constructor field is not a parameter: " + exported, state.units)
					# Resolve its published shape with the same HIR implementation
					# used by named local annotations.
					var reference_tree = resolved.tree
					let reference = len(reference_tree.nodes)
					reference_tree.nodes = reference_tree.nodes.append(Node(NODE_TYPE, resolved.tree.nodes[!fn_decl.source].token, 0, 0))
					let resolved = hir_module_type_reference_with_constants(types, reference_tree, reference, imported.declarations.functions, imported.declarations.constants)
					types = resolved.table
					return_type = resolved.type_id
				else
					let returned = hir_module_type_reference_with_constants(types, resolved.tree, fn_decl.result_type_node, imported.declarations.functions, imported.declarations.constants)
					types = returned.table
					return_type = returned.type_id
				if return_type == TYPE_TAG_INVALID
					return ModuleScanResult(state.visited, name + ": unsupported exported signature: " + exported, state.units)
				var signature = ModuleScanExport(exported, fn_decl.parameters, arguments, return_type)
				signature.constructor = fn_decl.constructor
				signature.generic = generic
				signatures = signatures.append(signature)
				found = true
		if not found
			for constant in imported.declarations.constants
				if constant.name == exported
					exported_constants = exported_constants.append(constant)
					found = true
		if not found
			return ModuleScanResult(state.visited, name + ": missing exported declaration: " + exported, state.units)
	var has_main = false
	for fn_decl in decl.functions
		if fn_decl.name == "main" and parsed.state.nodes[!fn_decl.source].kind == NODE_DEF
			has_main = true
	var unit = ModuleScanUnit(name, path, parsed.state, decl, types, signatures, has_main)
	unit.exported_constants = exported_constants
	return ModuleScanResult(state.visited.append(name), "", state.units.append(unit))


# Text manifest is only a scanner CLI interchange format. Native module builds
# consume ModuleScanUnit and never serialize or parse this representation.
def module_scan_manifest(units: Array[ModuleScanUnit]) -> string
	var manifest = "SIRIUS-MODULES/1\n"
	for unit in units
		manifest += "M\t" + unit.name + "\n"
		for imported in unit.declarations.imports
			manifest += "I\t" + imported.alias + "\t" + imported.path + "\n"
		for exported in unit.exports
			if exported.constructor
				manifest += "T\t" + exported.name + "\t" + hir_type_name(unit.types, exported.result_type) + "\n"
			else
				for function in unit.declarations.functions
					if function.name == exported.name
						manifest += "E\t" + module_scan_export(unit.tree, function)
		for constant in unit.exported_constants
			manifest += "C\t" + constant.name + "\t" + hir_type_name(unit.types, constant.type_id) + "\n"
		if unit.has_main
			manifest += "F\tmain\n"
	return manifest
