import hir alias Hir
import hir_analyze alias HirAnalyze
import hir_declarations alias HirDeclarations
import hir_resolve alias HirResolve
import module alias Module
import module_interface alias ModuleInterface
import module_resolve alias ModuleResolve
import parser alias Parser
import tokenizer alias Tokenizer
import types alias Types
# Compiler-owned source-module discovery and export interface extraction.
# The manifest is a deterministic tab-separated protocol; its fields are
# identifiers or normalized type expressions, never arbitrary source text.
export rec ModuleScanExport(name: string, parameters: Array[Hir.HirParameterDecl], argument_types: Array[i64], result_type: i64, constructor: bool, generic: bool, origin: string, body_signature: string)

def new_module_scan_export(name: string, parameters: Array[Hir.HirParameterDecl], argument_types: Array[i64], result_type: i64) -> ModuleScanExport
	return ModuleScanExport(name, parameters, argument_types, result_type, false, false, "", "")

export rec ModuleScanUnit(name: string, path: string, tree: Parser.ParseState, declarations: Hir.HirModuleDecl, types: Types.TypeTable, exports: Array[ModuleScanExport], has_main: bool, exported_constants: Array[Hir.HirModuleConstant], exported_values: Array[Hir.HirConstantValue], exported_aliases: Array[Hir.HirTypeAlias])
export rec ModuleScanResult(visited: Array[string], error: string, units: Array[ModuleScanUnit], missing: string)

export def new_module_scan_result(visited: Array[string], error: string, units: Array[ModuleScanUnit]) -> ModuleScanResult
	return ModuleScanResult(visited, error, units, "")
rec ModuleScanType(text: string, valid: bool)

# Import dependency interfaces into a private HIR declaration context. This
# path is shared by export-signature resolution and actual module compilation.
rec ModuleScanImports(declarations: Hir.HirModuleDecl, error: string)

export def module_scan_import_declarations(decl: Hir.HirModuleDecl, units: Array[ModuleScanUnit]) -> ModuleScanImports
	var declarations = decl
	var types = declarations.types
	for imported in declarations.imports
		var found = false
		for dependency in units
			if dependency.name != imported.path
				continue
			found = true
			for exported in dependency.exports
				var parameters = Array[Hir.HirParameterDecl]()
				var arguments = Array[i64]()
				for i in 0..len(exported.parameters)
					let imported_type = ModuleInterface.module_import_type(types, dependency.types, exported.argument_types[!i])
					types = imported_type.table
					if imported_type.id == Types.TYPE_TAG_INVALID and exported.argument_types[!i] != Types.TYPE_TAG_INVALID
						return ModuleScanImports(declarations, "unsupported imported parameter type: " + dependency.name + "." + exported.name)
					arguments = arguments.append(imported_type.id)
					parameters = parameters.append(Hir.HirParameterDecl(exported.parameters[!i].name, -1, -1))
				let result_type = ModuleInterface.module_import_type(types, dependency.types, exported.result_type)
				types = result_type.table
				if result_type.id == Types.TYPE_TAG_INVALID
					return ModuleScanImports(declarations, "unsupported imported return type: " + dependency.name + "." + exported.name)
				let public_symbol = Module.hir_module_symbol(dependency.name, exported.name)
				var target = public_symbol
				if exported.origin != ""
					target = exported.origin
					declarations.external_aliases = declarations.external_aliases.append(Hir.HirExternalAlias(public_symbol, target))
				var found_function = false
				for existing in declarations.functions
					if existing.name == target
						found_function = true
				if not found_function
					var function = Hir.new_hir_function_decl(target, -1, -1 - len(declarations.functions), false, -1, parameters)
					function.external = true
					function.constructor = exported.constructor
					function.argument_types = arguments
					function.result_type = result_type.id
					declarations.functions = declarations.functions.append(function)
			for alias in dependency.exported_aliases
				let mapped = ModuleInterface.module_import_type(types, dependency.types, alias.type_id)
				if mapped.id == Types.TYPE_TAG_INVALID
					return ModuleScanImports(declarations, "unsupported imported union type: " + dependency.name + "." + alias.name)
				types = mapped.table
				declarations.type_aliases = declarations.type_aliases.append(Hir.HirTypeAlias(Module.hir_module_symbol(dependency.name, alias.name), mapped.id))
			for constant in dependency.exported_constants
				let copied = ModuleInterface.module_import_constant(types, declarations.values, dependency.types, dependency.exported_values, constant.value)
				if copied.index < 0
					return ModuleScanImports(declarations, "unsupported imported constant: " + dependency.name + "." + constant.name)
				types = copied.table
				declarations.values = copied.values
				let type_id = declarations.values[!copied.index].type_id
				declarations.constants = declarations.constants.append(Hir.HirModuleConstant(Module.hir_module_symbol(dependency.name, constant.name), copied.index, type_id))
		if not found
			return ModuleScanImports(declarations, "missing dependency: " + imported.path)
	declarations.types = types
	return ModuleScanImports(declarations, "")

# Source-free .smirg packages retain their constructor AST. A public
# constructor body can therefore be copied into the importing syntax arena,
# with its canonical result type still coming from the exported interface.
# Imported expressions are analyzed in a fresh parameter/publication scope.
export rec ModuleScanBodies(tree: Parser.ParseState, declarations: Hir.HirModuleDecl, error: string)

# Copy only the reachable constructor subtree. Each copied syntax token keeps
# its text and token kind, but source offsets belong to the importing arena.
def module_scan_copy_node(tree: Parser.ParseState, foreign: Parser.ParseState, id: i64) -> Parser.ParseResult
	var next = tree
	var children = Array[i64]()
	let node = foreign.nodes[!id]
	for i in 0..node.count
		let copied = module_scan_copy_node(next, foreign, Hir.hir_ast_child(foreign, id, i))
		next = copied.state
		children = children.append(copied.node)
	let original = foreign.tokens[!node.token]
	let text = Tokenizer.token_text(foreign.source, original)
	let start = len(next.source)
	next.source += text
	let token = len(next.tokens)
	next.tokens = next.tokens.append(Tokenizer.Token(original.kind, start, len(next.source), original.line, original.column))
	let first = len(next.edges)
	for child in children
		next.edges = next.edges.append(child)
	let result = len(next.nodes)
	next.nodes = next.nodes.append(Parser.Node(node.kind, token, first, len(children)))
	return Parser.ParseResult(next, result)

# Public computed bodies must affect package dependency signatures. Normalize
# syntax nodes (rather than byte offsets/whitespace or local TypeIds) so this
# is stable across source files and source-free package round trips.
def module_scan_body_signature(tree: Parser.ParseState, id: i64) -> string
	let node = tree.nodes[!id]
	var parts = str(node.kind) + ":" + str(len(Hir.hir_ast_text(tree, id))) + ":" + Hir.hir_ast_text(tree, id) + "("
	for i in 0..node.count
		parts += module_scan_body_signature(tree, Hir.hir_ast_child(tree, id, i))
	return parts + ")"

# Private dependencies participate in the constructor's public interface.
# This is essential for source-free packages: the record shape can stay the
# same while a referenced constant or helper changes its behavior.
def module_scan_constant_signature(decl: Hir.HirModuleDecl, id: i64) -> string
	let value = decl.values[!id]
	var result = Module.mir_type_signature(decl.types, value.type_id) + ":" + str(value.bits) + ":" + str(len(value.text)) + ":" + value.text + "["
	for child in value.fields
		result += module_scan_constant_signature(decl, child) + ","
	return result + "]"

def module_scan_dependency_names(tree: Parser.ParseState, id: i64, decl: Hir.HirModuleDecl, visited: Array[string]) -> Array[string]
	var names = visited
	let node = tree.nodes[!id]
	if node.kind == Parser.NODE_NAME
		let name = Hir.hir_ast_text(tree, id)
		var already = false
		for seen in names
			if seen == name
				already = true
		if not already
			for constant in decl.constants
				if constant.name == name
					names = names.append(name)
			for function in decl.functions
				if function.name == name and not function.constructor and function.source >= 0
					names = names.append(name)
					names = module_scan_dependency_names(tree, function.source, decl, names)
	for i in 0..node.count
		names = module_scan_dependency_names(tree, Hir.hir_ast_child(tree, id, i), decl, names)
	return names

def module_scan_constructor_signature(tree: Parser.ParseState, id: i64, decl: Hir.HirModuleDecl) -> string
	var result = module_scan_body_signature(tree, id)
	for name in module_scan_dependency_names(tree, id, decl, Array[string]())
		for constant in decl.constants
			if constant.name == name
				result += ":constant:" + name + ":" + module_scan_constant_signature(decl, constant.value)
		for function in decl.functions
			if function.name == name and not function.constructor
				result += ":function:" + name + ":" + module_scan_body_signature(tree, function.source)
	return result

def module_scan_computed_constructor(tree: Parser.ParseState, function: Hir.HirFunctionDecl) -> bool
	let body = tree.nodes[!function.body]
	for i in 0..body.count
		let id = Hir.hir_ast_child(tree, function.body, i)
		let pub = tree.nodes[!id]
		if pub.kind != Parser.NODE_PUB or pub.count != 0
			return true
		var parameter = false
		for item in function.parameters
			if item.name == Hir.hir_ast_text(tree, id)
				parameter = true
		if not parameter
			return true
	return false

# Resolve transported constructor references in the defining module rather
# than in the importer. Only parameter/publication names are lexical locals.
# Helper definitions and constants are transported with private module symbols.
def module_scan_constructor_closed(tree: Parser.ParseState, id: i64, bindings: Array[string], declarations: Hir.HirModuleDecl) -> bool
	let node = tree.nodes[!id]
	if node.kind == Parser.NODE_NAME
		let name = Hir.hir_ast_text(tree, id)
		var found = name == "len" or name == "str" or name == "Array" or name == "Dict" or name == "Optional"
		for binding in bindings
			if binding == name
				found = true
		for constant in declarations.constants
			if constant.name == name
				found = true
		for function in declarations.functions
			if function.name == name and not function.constructor and function.source >= 0 and function.body >= 0
				found = true
		if not found
			return false
	for i in 0..node.count
		if not module_scan_constructor_closed(tree, Hir.hir_ast_child(tree, id, i), bindings, declarations)
			return false
	return true

def module_scan_constructor_body_closed(tree: Parser.ParseState, function: Hir.HirFunctionDecl, declarations: Hir.HirModuleDecl) -> bool
	var bindings = Array[string]()
	for parameter in function.parameters
		bindings = bindings.append(parameter.name)
	let body = tree.nodes[!function.body]
	for i in 0..body.count
		let id = Hir.hir_ast_child(tree, function.body, i)
		let item = tree.nodes[!id]
		if item.kind == Parser.NODE_IF
			if not module_scan_constructor_closed(tree, id, bindings, declarations)
				return false
			continue
		if item.kind != Parser.NODE_PUB
			return false
		for j in 0..item.count
			if not module_scan_constructor_closed(tree, Hir.hir_ast_child(tree, id, j), bindings, declarations)
				return false
		bindings = bindings.append(Hir.hir_ast_text(tree, id))
	return true

# Rename a copied name node. The imported AST is private to the caller, while
# the mangled symbol is deterministic across source and .smirg imports.
def module_scan_rename(tree: Parser.ParseState, id: i64, name: string) -> Parser.ParseState
	var next = tree
	let position = len(next.source)
	next.source += name
	let original = next.tokens[!next.nodes[!id].token]
	let token = len(next.tokens)
	next.tokens = next.tokens.append(Tokenizer.Token(Tokenizer.TOKEN_NAME, position, len(next.source), original.line, original.column))
	let node = next.nodes[!id]
	next.nodes[!id] = Parser.Node(node.kind, token, node.first, node.count)
	return next

def module_scan_capture_symbol(owner: string, name: string) -> string
	return "__SiriusConstructorCapture_" + Module.hir_module_symbol(owner, name)

export rec ModuleScanCapture(tree: Parser.ParseState, declarations: Hir.HirModuleDecl, helpers: Array[string], error: string)

# Every free module binding is mapped to its owner before HIR analysis.
# In particular, an importer declaring OFFSET or helper cannot capture it.
def module_scan_capture_node(tree: Parser.ParseState, id: i64, bindings: Array[string], owner: ModuleScanUnit, declarations: Hir.HirModuleDecl, helpers: Array[string]) -> ModuleScanCapture
	var next = tree
	var updated = declarations
	var required = helpers
	let node = next.nodes[!id]
	if node.kind == Parser.NODE_NAME
		let name = Hir.hir_ast_text(next, id)
		for binding in bindings
			if binding == name
				return ModuleScanCapture(next, updated, required, "")
		for constant in owner.declarations.constants
			if constant.name != name
				continue
			let symbol = module_scan_capture_symbol(owner.name, name)
			var exists = false
			for existing in updated.constants
				if existing.name == symbol
					exists = true
			if not exists
				let copied = ModuleInterface.module_import_constant(updated.types, updated.values, owner.declarations.types, owner.declarations.values, constant.value)
				if copied.index < 0
					return ModuleScanCapture(next, updated, required, "cannot import constructor constant: " + name)
				updated.types = copied.table
				updated.values = copied.values
				updated.constants = updated.constants.append(Hir.HirModuleConstant(symbol, copied.index, updated.values[!copied.index].type_id))
			next = module_scan_rename(next, id, symbol)
			return ModuleScanCapture(next, updated, required, "")
		for function in owner.declarations.functions
			if function.name == name and not function.constructor and function.source >= 0 and function.body >= 0
				let symbol = module_scan_capture_symbol(owner.name, name)
				next = module_scan_rename(next, id, symbol)
				var exists = false
				for helper in required
					if helper == name
						exists = true
				if not exists
					required = required.append(name)
				return ModuleScanCapture(next, updated, required, "")
		if name != "len" and name != "str" and name != "Array" and name != "Dict" and name != "Optional" and name != "print" and name != "eprint"
			return ModuleScanCapture(next, updated, required, "unresolved defining-module constructor name: " + name)
	for i in 0..node.count
		let child = module_scan_capture_node(next, Hir.hir_ast_child(next, id, i), bindings, owner, updated, required)
		if child.error != ""
			return child
		next = child.tree
		updated = child.declarations
		required = child.helpers
	return ModuleScanCapture(next, updated, required, "")

def module_scan_capture_constructor(tree: Parser.ParseState, body: i64, function: Hir.HirFunctionDecl, owner: ModuleScanUnit, declarations: Hir.HirModuleDecl) -> ModuleScanCapture
	var result = ModuleScanCapture(tree, declarations, Array[string](), "")
	var bindings = Array[string]()
	for parameter in function.parameters
		bindings = bindings.append(parameter.name)
	let block = tree.nodes[!body]
	for i in 0..block.count
		let item = Hir.hir_ast_child(tree, body, i)
		result = module_scan_capture_node(result.tree, item, bindings, owner, result.declarations, result.helpers)
		if result.error != ""
			return result
		if tree.nodes[!item].kind == Parser.NODE_PUB
			bindings = bindings.append(Hir.hir_ast_text(tree, item))
	return result

# Reconstruct copied helper declarations with AST-local parameter/type nodes.
# The owner-qualified name prevents collisions with caller-local definitions.
def module_scan_import_helpers(state: ModuleScanCapture, owner: ModuleScanUnit) -> ModuleScanCapture
	var result = state
	var cursor = 0
	while cursor < len(result.helpers)
		let name = result.helpers[!cursor]
		cursor += 1
		let symbol = module_scan_capture_symbol(owner.name, name)
		var exists = false
		for existing in result.declarations.functions
			if existing.name == symbol
				exists = true
		if exists
			continue
		for original in owner.declarations.functions
			if original.name != name or original.constructor or original.body < 0
				continue
			let copied = module_scan_copy_node(result.tree, owner.tree, original.source)
			result.tree = copied.state
			let node = result.tree.nodes[!copied.node]
			var parameters = Array[Hir.HirParameterDecl]()
			var returned = -1
			for j in 0..node.count - 1
				let part = Hir.hir_ast_child(result.tree, copied.node, j)
				let info = result.tree.nodes[!part]
				if info.kind == Parser.NODE_PARAM
					var annotation = -1
					if info.count > 0
						annotation = Hir.hir_ast_child(result.tree, part, 0)
					parameters = parameters.append(Hir.HirParameterDecl(Hir.hir_ast_text(result.tree, part), part, annotation))
				elif info.kind == Parser.NODE_TYPE
					returned = part
			let body = Hir.hir_ast_child(result.tree, copied.node, node.count - 1)
			result.declarations.functions = result.declarations.functions.append(Hir.new_hir_function_decl(symbol, copied.node, body, false, returned, parameters))
			var bindings = Array[string]()
			for parameter in parameters
				bindings = bindings.append(parameter.name)
			# Local binding declarations must not be mistaken for free module names.
			let block = result.tree.nodes[!body]
			for j in 0..block.count
				let statement = Hir.hir_ast_child(result.tree, body, j)
				let captured = module_scan_capture_node(result.tree, statement, bindings, owner, result.declarations, result.helpers)
				if captured.error != ""
					return captured
				result = captured
				if result.tree.nodes[!statement].kind == Parser.NODE_LET or result.tree.nodes[!statement].kind == Parser.NODE_VAR
					bindings = bindings.append(Hir.hir_ast_text(result.tree, statement))
	return result

export def module_scan_import_constructor_bodies(tree: Parser.ParseState, declarations: Hir.HirModuleDecl, units: Array[ModuleScanUnit]) -> ModuleScanBodies
	var next = tree
	var updated = declarations
	for i in 0..len(declarations.functions)
		var function = updated.functions[!i]
		if not function.constructor or not function.external
			continue
		for unit in units
			for exported in unit.exports
				var symbol = Module.hir_module_symbol(unit.name, exported.name)
				if exported.origin != ""
					symbol = exported.origin
				if symbol != function.name or exported.body_signature == ""
					continue
				for owner in units
					for original in owner.declarations.functions
						if not original.constructor or function.name != Module.hir_module_symbol(owner.name, original.name)
							continue
						let copied = module_scan_copy_node(next, owner.tree, original.body)
						let captured = module_scan_capture_constructor(copied.state, copied.node, original, owner, updated)
						let helpers = module_scan_import_helpers(captured, owner)
						if helpers.error != ""
							return ModuleScanBodies(helpers.tree, helpers.declarations, helpers.error)
						next = helpers.tree
						updated = helpers.declarations
						function.body = copied.node
						updated.functions[!i] = function
						break
					if function.body >= 0
						break
				if function.body >= 0
					break
	return ModuleScanBodies(next, updated, "")

# Prevent module path components from escaping the source root.
export def module_scan_path_valid(path: string) -> bool
	if len(path) == 0
		return false
	var segment_start = true
	for i in 0..len(path)
		let c = path.byte_at(i) or 0
		if c == 46 # '.'
			if segment_start
				return false
			segment_start = true
		elif segment_start
			if not Tokenizer.is_alpha(c)
				return false
			segment_start = false
		elif not Tokenizer.is_ident(c)
			return false
	return not segment_start

export def module_scan_reserved(name: string) -> bool
	for word in ["let", "var", "def", "rec", "extern", "pub", "export", "if", "elif", "else", "while", "for", "return", "and", "or", "not", "true", "false", "in", "import", "alias", "break", "continue"]
		if word == name
			return true
	return false

def module_scan_type(tree: Parser.ParseState, id: i64) -> ModuleScanType
	if id < 0 or tree.nodes[!id].kind != Parser.NODE_TYPE
		return ModuleScanType("", false)
	let name = Hir.hir_ast_text(tree, id)
	let count = tree.nodes[!id].count
	if count == 0
		return ModuleScanType(name, true) # Checked against the module TypeTable below.
	if (name != "Array" and name != "Optional" and name != "Dict") or (name == "Dict" and count != 2) or (name != "Dict" and count != 1)
		return ModuleScanType("", false)
	var result = name + "["
	for i in 0..count
		let child = module_scan_type(tree, Hir.hir_ast_child(tree, id, i))
		if not child.valid
			return ModuleScanType("", false)
		if i > 0
			result += ", "
		result += child.text
	return ModuleScanType(result + "]", true)

def module_scan_export(tree: Parser.ParseState, fn_decl: Hir.HirFunctionDecl) -> string
	var params = ""
	for i in 0..len(fn_decl.parameters)
		let param = fn_decl.parameters[!i]
		if i > 0
			params += ", "
		if param.type_node < 0
			params += param.name
		else
			let typ = module_scan_type(tree, param.type_node)
			if not typ.valid
				return ""
			params += param.name + ": " + typ.text
	let result = module_scan_type(tree, fn_decl.result_type_node)
	if not result.valid
		return ""
	return fn_decl.name + "\t" + params + "\t" + result.text + "\n"

# A build-local memo retains parsed sources and resolved typed interfaces across
# discovery retries. It is never shared across builds: source or package changes
# are therefore observed on the next invocation.
rec ModuleScanSource(name: string, path: string, tree: Parser.ParseState, declarations: Hir.HirModuleDecl)
export rec ModuleScanCache(sources: Array[ModuleScanSource], completed: Array[ModuleScanUnit])
export rec ModuleScanCached(result: ModuleScanResult, cache: ModuleScanCache)

export def module_scan_empty_cache() -> ModuleScanCache
	return ModuleScanCache(Array[ModuleScanSource](), Array[ModuleScanUnit]())

# Parse each source at most once within a build. Both scanner and native builder
# use the same parse/declaration path, but maintain their own traversal state.
export rec ModuleScanParsed(index: i64, error: string, cache: ModuleScanCache, missing: bool)

export def module_scan_parse_cached(root: string, name: string, cache: ModuleScanCache) -> ModuleScanParsed
	for i in 0..len(cache.sources)
		if cache.sources[!i].name == name
			return ModuleScanParsed(i, "", cache, false)
	let path = Module.module_scan_filename(root, name)
	let text = read_text(path) or ""
	if text == ""
		return ModuleScanParsed(-1, "module " + name + " not found under source root: " + path, cache, true)
	let parsed = Parser.parse_module(text)
	if parsed.state.error != ""
		return ModuleScanParsed(-1, name + ":" + str(parsed.state.error_line) + ": " + parsed.state.error, cache, false)
	let declarations = HirDeclarations.hir_module_declarations(parsed.state, parsed.node)
	if declarations.error != ""
		return ModuleScanParsed(-1, name + ":" + str(declarations.error_line) + ": " + declarations.error, cache, false)
	let updated = ModuleScanCache(cache.sources.append(ModuleScanSource(name, path, parsed.state, declarations)), cache.completed)
	return ModuleScanParsed(len(cache.sources), "", updated, false)

# The standalone scanner uses an empty cache; the native builder carries it
# across retries while resolving missing packages.
def module_scan_visit_cached(root: string, name: string, visiting: Array[string], state: ModuleScanCached, packages: Array[ModuleScanUnit]) -> ModuleScanCached
	let done = state.result.visited
	let units = state.result.units
	if not module_scan_path_valid(name)
		return ModuleScanCached(new_module_scan_result(done, "invalid module path: " + name, units), state.cache)
	for current in visiting
		if current == name
			var chain = ""
			for part in visiting
				if chain != ""
					chain += " -> "
				chain += part
			return ModuleScanCached(new_module_scan_result(done, "cyclic source imports: " + chain + " -> " + name, units), state.cache)
	for current in done
		if current == name
			return state
	for package in packages
		if package.name == name
			var current = state
			for imported in package.declarations.imports
				current = module_scan_visit_cached(root, imported.path, visiting.append(name), current, packages)
				if current.result.error != ""
					return current
			let result = current.result
			return ModuleScanCached(new_module_scan_result(result.visited.append(name), "", result.units.append(package)), current.cache)
	let parsed = module_scan_parse_cached(root, name, state.cache)
	if parsed.error != ""
		var failed = new_module_scan_result(done, parsed.error, units)
		if parsed.missing
			failed.missing = name
		return ModuleScanCached(failed, parsed.cache)
	var current = ModuleScanCached(state.result, parsed.cache)
	let source = current.cache.sources[!parsed.index]
	let path = source.path
	let tree = source.tree
	let decl = source.declarations
	let stack = visiting.append(name)
	for imported in decl.imports
		if module_scan_reserved(imported.alias)
			return ModuleScanCached(new_module_scan_result(current.result.visited, name + ": invalid import alias: " + imported.alias, current.result.units), current.cache)
		current = module_scan_visit_cached(root, imported.path, stack, current, packages)
		if current.result.error != ""
			return current
	for unit in current.cache.completed
		if unit.name == name
			let result = current.result
			return ModuleScanCached(new_module_scan_result(result.visited.append(name), "", result.units.append(unit)), current.cache)
	let result = module_scan_complete(name, path, tree, decl, current.result.visited, current.result.units)
	if result.error == "" and len(result.units) > 0
		current.cache.completed = current.cache.completed.append(result.units[!len(result.units) - 1])
	return ModuleScanCached(result, current.cache)

def module_scan_visit_with_packages(root: string, name: string, visiting: Array[string], done: Array[string], units: Array[ModuleScanUnit], packages: Array[ModuleScanUnit]) -> ModuleScanResult
	let initial = ModuleScanCached(new_module_scan_result(done, "", units), module_scan_empty_cache())
	return module_scan_visit_cached(root, name, visiting, initial, packages).result

def module_scan_visit(root: string, name: string, visiting: Array[string], done: Array[string], units: Array[ModuleScanUnit]) -> ModuleScanResult
	return module_scan_visit_with_packages(root, name, visiting, done, units, Array[ModuleScanUnit]())

export def module_scan_complete(name: string, path: string, tree: Parser.ParseState, decl: Hir.HirModuleDecl, done: Array[string], units: Array[ModuleScanUnit]) -> ModuleScanResult
	let imported = module_scan_import_declarations(decl, units)
	if imported.error != ""
		return new_module_scan_result(done, name + ": " + imported.error, units)
	let resolved = ModuleResolve.hir_resolve_module_calls(tree, imported.declarations)
	if resolved.error != ""
		return new_module_scan_result(done, name + ":" + str(resolved.line) + ": " + resolved.error, units)
	var signatures = Array[ModuleScanExport]()
	var exported_constants = Array[Hir.HirModuleConstant]()
	var exported_aliases = Array[Hir.HirTypeAlias]()
	var types = imported.declarations.types
	for exported in decl.exports
		var found = false
		for fn_decl in imported.declarations.functions
			if fn_decl.name == exported
				var arguments = Array[i64]()
				var generic = false
				for parameter in fn_decl.parameters
					if parameter.type_node < 0
						if fn_decl.constructor
							return new_module_scan_result(done, name + ": exported constructors require parameter annotations: " + exported, units)
						generic = true
						arguments = arguments.append(Types.TYPE_TAG_INVALID)
						continue
					let resolved = HirAnalyze.hir_module_type_reference_with_constants(types, resolved.tree, parameter.type_node, imported.declarations.functions, imported.declarations.constants, imported.declarations.type_aliases)
					types = resolved.table
					if resolved.type_id == Types.TYPE_TAG_INVALID
						return new_module_scan_result(done, name + ": unsupported exported signature: " + exported, units)
					arguments = arguments.append(resolved.type_id)
				var return_type = Types.TYPE_TAG_INVALID
				if fn_decl.constructor
					# Compute the canonical published shape through HIR, including
					# sequential publications and conditional overrides.
					var reference_tree = resolved.tree
					let reference = len(reference_tree.nodes)
					reference_tree.nodes = reference_tree.nodes.append(Parser.Node(Parser.NODE_TYPE, resolved.tree.nodes[!fn_decl.source].token, 0, 0))
					let constructor_type = HirAnalyze.hir_module_type_reference_with_constants(types, reference_tree, reference, imported.declarations.functions, imported.declarations.constants, imported.declarations.type_aliases)
					if constructor_type.error != ""
						return new_module_scan_result(done, name + ": " + constructor_type.error + ": " + exported, units)
					types = constructor_type.table
					return_type = constructor_type.type_id
					if Types.type_tag(types, return_type) != Types.TYPE_TAG_RECORD
						return new_module_scan_result(done, name + ": exported constructor requires public fields: " + exported, units)
				else
					let returned = HirAnalyze.hir_module_type_reference_with_constants(types, resolved.tree, fn_decl.result_type_node, imported.declarations.functions, imported.declarations.constants, imported.declarations.type_aliases)
					types = returned.table
					return_type = returned.type_id
				if return_type == Types.TYPE_TAG_INVALID
					return new_module_scan_result(done, name + ": unsupported exported signature: " + exported, units)
				var signature = new_module_scan_export(exported, fn_decl.parameters, arguments, return_type)
				signature.constructor = fn_decl.constructor
				if fn_decl.constructor and module_scan_computed_constructor(resolved.tree, fn_decl)
					if not module_scan_constructor_body_closed(resolved.tree, fn_decl, imported.declarations)
						return new_module_scan_result(done, name + ": exported computed constructor references names outside its parameter/publication scope: " + exported, units)
					signature.body_signature = module_scan_constructor_signature(resolved.tree, fn_decl.body, imported.declarations)
				signature.generic = generic
				signatures = signatures.append(signature)
				found = true
		if not found
			for alias in imported.declarations.type_aliases
				if alias.name == exported
					exported_aliases = exported_aliases.append(alias)
					found = true
		if not found
			for constant in imported.declarations.constants
				if constant.name == exported
					exported_constants = exported_constants.append(constant)
					found = true
		if not found
			return new_module_scan_result(done, name + ": missing exported declaration: " + exported, units)
	# Re-export only members that are public in the direct dependency. Keep
	# the original function symbol so no forwarding MIR functions are needed.
	for reexport in decl.reexports
		var dependency_name = ""
		for imported in decl.imports
			if imported.alias == reexport.alias
				dependency_name = imported.path
		var found = false
		for dependency in units
			if dependency.name != dependency_name
				continue
			for exported in dependency.exports
				if exported.name != reexport.name
					continue
				var arguments = Array[i64]()
				for argument in exported.argument_types
					let mapped = ModuleInterface.module_import_type(types, dependency.types, argument)
					if mapped.id == Types.TYPE_TAG_INVALID and argument != Types.TYPE_TAG_INVALID
						return new_module_scan_result(done, name + ": unsupported re-export type: " + reexport.public_name, units)
					types = mapped.table
					arguments = arguments.append(mapped.id)
				let result_type = ModuleInterface.module_import_type(types, dependency.types, exported.result_type)
				if result_type.id == Types.TYPE_TAG_INVALID
					return new_module_scan_result(done, name + ": unsupported re-export type: " + reexport.public_name, units)
				types = result_type.table
				var signature = new_module_scan_export(reexport.public_name, exported.parameters, arguments, result_type.id)
				signature.constructor = exported.constructor
				signature.generic = exported.generic
				signature.body_signature = exported.body_signature
				signature.origin = Module.hir_module_symbol(dependency.name, exported.name)
				if exported.origin != ""
					signature.origin = exported.origin
				signatures = signatures.append(signature)
				found = true
			for alias in dependency.exported_aliases
				if alias.name != reexport.name
					continue
				let mapped = ModuleInterface.module_import_type(types, dependency.types, alias.type_id)
				if mapped.id == Types.TYPE_TAG_INVALID
					return new_module_scan_result(done, name + ": unsupported re-export union: " + reexport.public_name, units)
				types = mapped.table
				exported_aliases = exported_aliases.append(Hir.HirTypeAlias(reexport.public_name, mapped.id))
				found = true
			for constant in dependency.exported_constants
				if constant.name != reexport.name
					continue
				for imported_constant in imported.declarations.constants
					if imported_constant.name == Module.hir_module_symbol(dependency.name, reexport.name)
						exported_constants = exported_constants.append(Hir.HirModuleConstant(reexport.public_name, imported_constant.value, imported_constant.type_id))
						found = true
		if not found
			return new_module_scan_result(done, name + ": member is not exported: " + reexport.alias + "." + reexport.name, units)
	var has_main = false
	for fn_decl in decl.functions
		if fn_decl.name == "main" and tree.nodes[!fn_decl.source].kind == Parser.NODE_DEF
			has_main = true
	let unit = ModuleScanUnit(name, path, tree, decl, types, signatures, has_main, exported_constants, imported.declarations.values, exported_aliases)
	return new_module_scan_result(done.append(name), "", units.append(unit))


# Text manifest is only a scanner CLI interchange format. Native module builds
# consume ModuleScanUnit and never serialize or parse this representation.
def module_scan_manifest(units: Array[ModuleScanUnit]) -> string
	var manifest = "SIRIUS-MODULES/1\n"
	for unit in units
		manifest += "M\t" + unit.name + "\n"
		for imported in unit.declarations.imports
			manifest += "I\t" + imported.alias + "\t" + imported.path + "\n"
		for exported in unit.exports
			if exported.constructor
				manifest += "T\t" + exported.name + "\t" + HirResolve.hir_type_name(unit.types, exported.result_type) + "\n"
			else
				if exported.origin != ""
					var params = ""
					for i in 0..len(exported.parameters)
						if i > 0
							params += ", "
						params += exported.parameters[!i].name
						if exported.argument_types[!i] != Types.TYPE_TAG_INVALID
							params += ": " + HirResolve.hir_type_name(unit.types, exported.argument_types[!i])
					manifest += "E\t" + exported.name + "\t" + params + "\t" + HirResolve.hir_type_name(unit.types, exported.result_type) + "\n"
				else
					for function in unit.declarations.functions
						if function.name == exported.name
							manifest += "E\t" + module_scan_export(unit.tree, function)
		for constant in unit.exported_constants
			manifest += "C\t" + constant.name + "\t" + HirResolve.hir_type_name(unit.types, constant.type_id) + "\n"
		for alias in unit.exported_aliases
			manifest += "U\t" + alias.name + "\t" + HirResolve.hir_type_name(unit.types, alias.type_id) + "\n"
		if unit.has_main
			manifest += "F\tmain\n"
	return manifest

# Small public boundary for the standalone scanner CLI. Keep graph internals private.
export rec ModuleScanCliResult(text: string, error: string)
	pub text
	pub error

export def module_scan_cli_root(root: string, entry: string) -> ModuleScanCliResult
	let result = module_scan_visit(root, entry, Array[string](), Array[string](), Array[ModuleScanUnit]())
	if result.error != ""
		return ModuleScanCliResult("", result.error)
	return ModuleScanCliResult(module_scan_manifest(result.units), "")
