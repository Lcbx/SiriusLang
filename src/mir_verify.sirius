import types alias Types
import mir alias Mir
import mir_cfg alias Cfg

# Verification is structural and type-directed. Definite register initialization
# is checked dynamically for now (CFG data-flow analysis comes with lowering).
# Validate ownership transfer positions shared by calls and constructors.
def mir_verify_input_moves(program: Mir.MirProgram, function: Mir.MirFunction, ins: Mir.MirInstruction) -> string
	let types = function.register_types
	if ins.dst == ins.first or ins.first < 0 or ins.first >= len(types) or not mir_managed_type(program.types, types[!ins.first])
		return "input move requires a distinct managed register"
	if ins.second < 0
		return "input move requires a nonnegative argument mask"
	var count = 0
	var mask = ins.second
	for i in 0..len(ins.inputs)
		let arg = ins.inputs[!i]
		if arg == ins.first
			count += 1
		if i < 62
			if mask % 2 == 1
				if arg == ins.first or arg == ins.dst or not mir_managed_type(program.types, types[!arg])
					return "input move requires distinct managed arguments"
				for j in 0..i
					if ins.inputs[!j] == arg
						return "input move cannot transfer duplicate arguments"
			mask = mask / 2
		elif mask != 0
			return "input move argument mask exceeds supported width"
	if count != 1 or mask != 0
		return "input move requires one matching argument and a valid mask"
	for i in 0..len(ins.inputs)
		if ins.inputs[!i] == ins.first
			continue
		for j in 0..len(ins.inputs)
			if i != j and ins.inputs[!j] == ins.inputs[!i] and Mir.mir_input_move_at(ins, j)
				return "input move cannot transfer duplicate arguments"
	return ""

export def mir_register_valid(types: Array[i64], register: i64, expected: i64) -> bool
	return register >= 0 and register < len(types) and types[!register] == expected

export def mir_supported_type(type_id: i64) -> bool
	return type_id == Types.TYPE_TAG_I64 or type_id == Types.TYPE_TAG_BOOL or type_id == Types.TYPE_TAG_STRING or type_id == Types.TYPE_TAG_F64

export def mir_type_supported(types: Types.TypeTable, type_id: i64) -> bool
	if type_id < 0 or type_id >= len(types.entries)
		return false
	let tag = types.entries[!type_id].tag
	return mir_supported_type(tag) or tag == Types.TYPE_TAG_RECORD or tag == Types.TYPE_TAG_ARRAY or tag == Types.TYPE_TAG_DICT or tag == Types.TYPE_TAG_OPTIONAL or tag == Types.TYPE_TAG_UNION or tag == Types.TYPE_TAG_FUNCTION

# All backends and analyses use the canonical storage descriptor for ARC.
export def mir_managed_type(types: Types.TypeTable, type_id: i64) -> bool
	let ownership = Types.runtime_ownership(types, type_id)
	return ownership == Types.TYPE_OWNERSHIP_STRING or ownership == Types.TYPE_OWNERSHIP_OBJECT

export def mir_verify_instruction(program: Mir.MirProgram, function: Mir.MirFunction, ins: Mir.MirInstruction) -> string
	let types = function.register_types
	if ins.op == Mir.MIR_PRINT or ins.op == Mir.MIR_EPRINT
		if ins.first < 0 or ins.first >= len(types) or not mir_supported_type(types[!ins.first])
			return "invalid print operand"
		return ""
	if ins.dst < 0 or ins.dst >= len(types)
		return "invalid destination register"
	let dst_type = types[!ins.dst]
	if ins.op == Mir.MIR_ARGUMENTS
		let desc = program.types.entries[!dst_type]
		if desc.tag != Types.TYPE_TAG_ARRAY or desc.first != Types.TYPE_TAG_STRING
			return "arguments requires Array[string] destination"
		return ""
	if ins.op == Mir.MIR_STR_I64
		if dst_type != Types.TYPE_TAG_STRING or not mir_register_valid(types, ins.first, Types.TYPE_TAG_I64)
			return "str requires i64 and string result"
		return ""
	if ins.op == Mir.MIR_FILESYSTEM_ERROR_KIND or ins.op == Mir.MIR_FILESYSTEM_ERROR_CODE
		if dst_type != Types.TYPE_TAG_I64 or ins.first != -1 or ins.second != -1 or len(ins.inputs) != 0
			return "filesystem error snapshot requires i64 result and no operands"
		return ""
	if ins.op == Mir.MIR_READ_TEXT
		let desc = program.types.entries[!dst_type]
		if desc.tag != Types.TYPE_TAG_OPTIONAL or desc.first != Types.TYPE_TAG_STRING or not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING)
			return "read_text requires string path and Optional[string] result"
		return ""
	if ins.op == Mir.MIR_LIST_DIR
		let optional = program.types.entries[!dst_type]
		if optional.tag != Types.TYPE_TAG_OPTIONAL or optional.first < 0 or optional.first >= len(program.types.entries)
			return "list_dir requires Optional[Array[string]] result"
		let array = program.types.entries[!optional.first]
		if array.tag != Types.TYPE_TAG_ARRAY or array.first != Types.TYPE_TAG_STRING or not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING)
			return "list_dir requires string path and Optional[Array[string]] result"
		return ""
	if ins.op == Mir.MIR_IS_DIR
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING)
			return "is_dir requires string path and bool result"
		return ""
	if ins.op == Mir.MIR_PATH_KIND
		if dst_type != Types.TYPE_TAG_I64 or not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING) or ins.second != -1 or len(ins.inputs) != 0
			return "path_kind requires string path and i64 result"
		return ""
	if ins.op == Mir.MIR_WRITE_TEXT
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING) or not mir_register_valid(types, ins.second, Types.TYPE_TAG_STRING)
			return "write_text requires two strings and bool result"
		return ""
	if ins.op == Mir.MIR_CONST_I64
		if dst_type != Types.TYPE_TAG_I64
			return "integer constant destination must be i64"
		return ""
	if ins.op == Mir.MIR_CONST_BOOL
		if dst_type != Types.TYPE_TAG_BOOL or (ins.immediate != 0 and ins.immediate != 1)
			return "invalid boolean constant"
		return ""
	if ins.op == Mir.MIR_CONST_STRING
		if dst_type != Types.TYPE_TAG_STRING
			return "string constant destination must be string"
		return ""
	if ins.op == Mir.MIR_CONST_F64
		if dst_type != Types.TYPE_TAG_F64 or ins.text == ""
			return "floating constant destination must be f64"
		return ""
	if ins.op == Mir.MIR_I64_TO_F64
		if dst_type != Types.TYPE_TAG_F64 or not mir_register_valid(types, ins.first, Types.TYPE_TAG_I64) or ins.second != -1
			return "i64 to f64 conversion type mismatch"
		return ""
	if ins.op == Mir.MIR_F64_TO_I64
		if dst_type != Types.TYPE_TAG_I64 or not mir_register_valid(types, ins.first, Types.TYPE_TAG_F64) or ins.second != -1
			return "f64 to i64 conversion type mismatch"
		return ""
	if ins.op == Mir.MIR_F64_TO_I64_VALID
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_F64) or ins.second != -1
			return "f64 to i64 guard type mismatch"
		return ""
	if ins.op == Mir.MIR_SHIFT_VALID
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_I64)
			return "shift guard type mismatch"
		return ""
	if ins.op == Mir.MIR_NONZERO_I64
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_I64)
			return "nonzero guard type mismatch"
		return ""
	if ins.op == Mir.MIR_DIV_NO_OVERFLOW_I64
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_I64) or not mir_register_valid(types, ins.second, Types.TYPE_TAG_I64)
			return "division overflow guard type mismatch"
		return ""
	if ins.op == Mir.MIR_ARRAY_INDEX_VALID
		if dst_type != Types.TYPE_TAG_BOOL or ins.first < 0 or ins.first >= len(types) or program.types.entries[!types[!ins.first]].tag != Types.TYPE_TAG_ARRAY or not mir_register_valid(types, ins.second, Types.TYPE_TAG_I64)
			return "array index guard type mismatch"
		return ""
	if ins.op == Mir.MIR_OPTIONAL_NONE or ins.op == Mir.MIR_OPTIONAL_SOME
		let desc = program.types.entries[!dst_type]
		if desc.tag != Types.TYPE_TAG_OPTIONAL
			return "optional constructor requires Optional destination"
		if ins.op == Mir.MIR_OPTIONAL_SOME and not mir_register_valid(types, ins.first, desc.first)
			return "optional payload type mismatch"
		return ""
	if ins.op == Mir.MIR_OPTIONAL_HAS or ins.op == Mir.MIR_OPTIONAL_UNWRAP
		if ins.first < 0 or ins.first >= len(types)
			return "invalid optional source"
		let desc = program.types.entries[!types[!ins.first]]
		if desc.tag != Types.TYPE_TAG_OPTIONAL
			return "optional operation requires Optional"
		if ins.op == Mir.MIR_OPTIONAL_HAS and dst_type != Types.TYPE_TAG_BOOL
			return "optional presence destination must be bool"
		if ins.op == Mir.MIR_OPTIONAL_UNWRAP and dst_type != desc.first
			return "optional unwrap type mismatch"
		return ""
	if ins.op == Mir.MIR_UNION_NEW
		if ins.first == -1
			if not Types.union_is_enum(program.types, dst_type)
				return "empty union constructor requires enum destination"
			let alternatives = program.types.entries[!dst_type].fields
			if ins.second < 0 or ins.second >= len(alternatives) or alternatives[!ins.second].name == "" or ins.immediate != 0 or len(ins.inputs) != 0
				return "invalid empty union alternative"
			return ""
		if ins.first < 0 or ins.first >= len(types)
			return "invalid union payload register"
		if ins.second >= 0
			if Types.type_tag(program.types, dst_type) != Types.TYPE_TAG_UNION
				return "labeled union constructor requires union destination"
			let alternatives = program.types.entries[!dst_type].fields
			if ins.second >= len(alternatives)
				return "invalid labeled union alternative"
			let selected = alternatives[!ins.second]
			if selected.name == "" or selected.kind != types[!ins.first]
				return "labeled union constructor payload mismatch"
		elif ins.second != -1 or Types.union_alternative_index(program.types, dst_type, types[!ins.first]) < 0
			return "union constructor requires member record"
		return ""
	if ins.op == Mir.MIR_UNION_TAG or ins.op == Mir.MIR_UNION_GET
		if ins.first < 0 or ins.first >= len(types) or program.types.entries[!types[!ins.first]].tag != Types.TYPE_TAG_UNION
			return "union operation requires union source"
		if ins.op == Mir.MIR_UNION_TAG
			if dst_type != Types.TYPE_TAG_I64
				return "union tag requires i64 destination"
		elif ins.second >= 0
			let alternatives = program.types.entries[!types[!ins.first]].fields
			if ins.second >= len(alternatives)
				return "invalid labeled union alternative"
			let selected = alternatives[!ins.second]
			if selected.name == "" or selected.kind != dst_type
				return "labeled union extraction payload mismatch"
		elif ins.second != -1 or Types.union_alternative_index(program.types, types[!ins.first], dst_type) < 0
			return "union extraction requires member record destination"
		return ""
	if ins.op == Mir.MIR_DICT_NEXT or ins.op == Mir.MIR_DICT_KEY or ins.op == Mir.MIR_DICT_VALUE
		if ins.first < 0 or ins.first >= len(types) or not mir_register_valid(types, ins.second, Types.TYPE_TAG_I64)
			return "invalid dictionary traversal operands"
		let desc = program.types.entries[!types[!ins.first]]
		if desc.tag != Types.TYPE_TAG_DICT
			return "dictionary traversal requires Dict"
		if ins.op == Mir.MIR_DICT_NEXT and dst_type != Types.TYPE_TAG_I64
			return "dictionary cursor destination must be i64"
		if ins.op == Mir.MIR_DICT_KEY and dst_type != desc.first
			return "dictionary key destination type mismatch"
		if ins.op == Mir.MIR_DICT_VALUE and dst_type != desc.second
			return "dictionary value destination type mismatch"
		return ""
	if ins.op == Mir.MIR_DICT_NEW
		if program.types.entries[!dst_type].tag != Types.TYPE_TAG_DICT
			return "dictionary construction requires Dict destination"
		return ""
	if ins.op == Mir.MIR_DICT_INSERT or ins.op == Mir.MIR_DICT_GET_OR or ins.op == Mir.MIR_DICT_LENGTH or ins.op == Mir.MIR_DICT_GET_OPTIONAL
		if ins.first < 0 or ins.first >= len(types)
			return "invalid dictionary source"
		let owner = types[!ins.first]
		let desc = program.types.entries[!owner]
		if desc.tag != Types.TYPE_TAG_DICT
			return "dictionary operation requires Dict"
		if ins.op == Mir.MIR_DICT_LENGTH
			if dst_type != Types.TYPE_TAG_I64
				return "dictionary length destination must be i64"
			return ""
		if ins.op == Mir.MIR_DICT_INSERT
			if len(ins.inputs) != 2 or dst_type != owner
				return "dictionary insert signature mismatch"
			if not mir_register_valid(types, ins.inputs[!0], desc.first) or not mir_register_valid(types, ins.inputs[!1], desc.second)
				return "dictionary insert key/value type mismatch"
			return ""
		if ins.op == Mir.MIR_DICT_GET_OPTIONAL
			let optional = program.types.entries[!dst_type]
			if optional.tag != Types.TYPE_TAG_OPTIONAL or optional.first != desc.second or not mir_register_valid(types, ins.second, desc.first)
				return "dictionary optional lookup signature mismatch"
			return ""
		if not mir_register_valid(types, ins.second, desc.first) or not mir_register_valid(types, ins.immediate, desc.second) or dst_type != desc.second
			return "dictionary get-or signature mismatch"
		return ""
	if ins.op == Mir.MIR_RECORD_NEW or ins.op == Mir.MIR_RECORD_NEW_MOVE or ins.op == Mir.MIR_RECORD_NEW_FUSED or ins.op == Mir.MIR_RECORD_NEW_FUSED_MOVE
		if program.types.entries[!dst_type].tag != Types.TYPE_TAG_RECORD
			return "record construction requires record destination"
		let fields = program.types.entries[!dst_type].fields
		if len(ins.inputs) != len(fields)
			return "record constructor field count mismatch"
		for i in 0..len(fields)
			if not mir_register_valid(types, ins.inputs[!i], fields[!i].kind)
				return "record constructor field type mismatch"
		if ins.op == Mir.MIR_RECORD_NEW_FUSED or ins.op == Mir.MIR_RECORD_NEW_FUSED_MOVE
			if ins.immediate < 0 or ins.immediate >= len(types)
				return "invalid fused union destination"
			let union_type = types[!ins.immediate]
			if program.types.entries[!union_type].tag != Types.TYPE_TAG_UNION or Types.union_is_enum(program.types, union_type)
				return "fused record requires payload-bearing union"
			let alternatives = program.types.entries[!union_type].fields
			var compatible = false
			for member in alternatives
				if member.kind == dst_type
					compatible = true
			if not compatible
				return "fused record type not in union"
		if ins.op == Mir.MIR_RECORD_NEW_MOVE or ins.op == Mir.MIR_RECORD_NEW_FUSED_MOVE
			return mir_verify_input_moves(program, function, ins)
		return ""
	if ins.op == Mir.MIR_ARRAY_NEW or ins.op == Mir.MIR_ARRAY_NEW_MOVE
		let desc = program.types.entries[!dst_type]
		if desc.tag != Types.TYPE_TAG_ARRAY
			return "array constructor requires array destination"
		for input in ins.inputs
			if not mir_register_valid(types, input, desc.first)
				return "array constructor element type mismatch"
		if ins.op == Mir.MIR_ARRAY_NEW_MOVE
			return mir_verify_input_moves(program, function, ins)
		return ""
	if ins.op == Mir.MIR_ARRAY_APPEND
		if ins.first < 0 or ins.first >= len(types)
			return "invalid append owner"
		let owner = types[!ins.first]
		let desc = program.types.entries[!owner]
		if desc.tag != Types.TYPE_TAG_ARRAY or dst_type != owner or not mir_register_valid(types, ins.second, desc.first)
			return "array append signature mismatch"
		return ""
	if ins.op == Mir.MIR_ARRAY_GET or ins.op == Mir.MIR_ARRAY_LENGTH or ins.op == Mir.MIR_ARRAY_SET or ins.op == Mir.MIR_ARRAY_GET_OPTIONAL
		if ins.first < 0 or ins.first >= len(types)
			return "invalid array source"
		let source_type = types[!ins.first]
		let desc = program.types.entries[!source_type]
		if desc.tag != Types.TYPE_TAG_ARRAY
			return "array operand requires array"
		if ins.op == Mir.MIR_ARRAY_LENGTH
			if dst_type != Types.TYPE_TAG_I64
				return "array length destination must be i64"
			return ""
		if not mir_register_valid(types, ins.second, Types.TYPE_TAG_I64)
			return "array index must be i64"
		if ins.op == Mir.MIR_ARRAY_GET_OPTIONAL
			let optional = program.types.entries[!dst_type]
			if optional.tag != Types.TYPE_TAG_OPTIONAL or optional.first != desc.first
				return "array optional index type mismatch"
		elif ins.op == Mir.MIR_ARRAY_GET
			if dst_type != desc.first
				return "array element destination type mismatch"
		elif dst_type != source_type or not mir_register_valid(types, ins.immediate, desc.first)
			return "array update type mismatch"
		return ""
	if ins.op == Mir.MIR_RECORD_ARRAY_APPEND
		if ins.first < 0 or ins.first >= len(types)
			return "invalid record update source"
		let owner = types[!ins.first]
		if program.types.entries[!owner].tag != Types.TYPE_TAG_RECORD or dst_type != owner
			return "record array append requires matching record destination"
		let fields = program.types.entries[!owner].fields
		if ins.immediate < 0 or ins.immediate >= len(fields)
			return "invalid record update field"
		let field_type = fields[!ins.immediate].kind
		if program.types.entries[!field_type].tag != Types.TYPE_TAG_ARRAY or not mir_register_valid(types, ins.second, program.types.entries[!field_type].first)
			return "record array append type mismatch"
		return ""
	if ins.op == Mir.MIR_RECORD_SET
		if ins.first < 0 or ins.first >= len(types)
			return "invalid record update source"
		let owner = types[!ins.first]
		if program.types.entries[!owner].tag != Types.TYPE_TAG_RECORD or dst_type != owner
			return "record update requires matching record destination"
		let fields = program.types.entries[!owner].fields
		if ins.immediate < 0 or ins.immediate >= len(fields)
			return "invalid record update field"
		if not mir_register_valid(types, ins.second, fields[!ins.immediate].kind)
			return "record update field type mismatch"
		return ""
	if ins.op == Mir.MIR_RECORD_GET
		if ins.first < 0 or ins.first >= len(types)
			return "invalid record source"
		let owner = types[!ins.first]
		if program.types.entries[!owner].tag != Types.TYPE_TAG_RECORD
			return "record field access requires record"
		let fields = program.types.entries[!owner].fields
		if ins.immediate < 0 or ins.immediate >= len(fields)
			return "invalid record field"
		if dst_type != fields[!ins.immediate].kind
			return "record field type mismatch"
		return ""
	if ins.op == Mir.MIR_COPY or ins.op == Mir.MIR_RETAIN or ins.op == Mir.MIR_MOVE
		if not mir_register_valid(types, ins.first, dst_type)
			return "copy/move register type mismatch"
		if ins.op == Mir.MIR_RETAIN and not mir_managed_type(program.types, dst_type)
			return "retain requires a managed register"
		if ins.op == Mir.MIR_MOVE and (ins.dst == ins.first or not mir_managed_type(program.types, dst_type))
			return "move requires distinct managed registers"
		return ""
	if ins.op == Mir.MIR_RELEASE or ins.op == Mir.MIR_RELEASE_IF_INIT
		if not mir_managed_type(program.types, dst_type) or ins.first != ins.dst
			return "release requires a managed register"
		return ""
	if ins.op == Mir.MIR_STRING_LENGTH
		if dst_type != Types.TYPE_TAG_I64 or not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING)
			return "string length operand type mismatch"
		return ""
	if ins.op == Mir.MIR_STRING_CONCAT
		if dst_type != Types.TYPE_TAG_STRING or not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING) or not mir_register_valid(types, ins.second, Types.TYPE_TAG_STRING)
			return "string concat operand type mismatch"
		return ""
	if ins.op >= Mir.MIR_EQ_STRING and ins.op <= Mir.MIR_LE_STRING
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING) or not mir_register_valid(types, ins.second, Types.TYPE_TAG_STRING)
			return "string comparison signature mismatch"
		return ""
	if ins.op >= Mir.MIR_STRING_SLICE and ins.op <= Mir.MIR_STRING_JOIN
		if not mir_register_valid(types, ins.first, Types.TYPE_TAG_STRING)
			return "string operation requires a string receiver"
		if ins.op == Mir.MIR_STRING_SLICE
			if dst_type != Types.TYPE_TAG_STRING or not mir_register_valid(types, ins.second, Types.TYPE_TAG_I64) or not mir_register_valid(types, ins.immediate, Types.TYPE_TAG_I64)
				return "string slice signature mismatch"
		elif ins.op == Mir.MIR_STRING_BYTE_AT
			if not mir_register_valid(types, ins.second, Types.TYPE_TAG_I64)
				return "string byte_at argument mismatch"
		elif ins.op == Mir.MIR_STRING_JOIN
			if ins.second < 0 or ins.second >= len(types)
				return "invalid string join argument"
			let array = program.types.entries[!types[!ins.second]]
			if array.tag != Types.TYPE_TAG_ARRAY or array.first != Types.TYPE_TAG_STRING or dst_type != Types.TYPE_TAG_STRING
				return "string join signature mismatch"
		elif not mir_register_valid(types, ins.second, Types.TYPE_TAG_STRING)
			return "string operation argument type mismatch"
		if ins.op == Mir.MIR_STRING_BYTE_AT or ins.op == Mir.MIR_STRING_FIND
			let optional = program.types.entries[!dst_type]
			if optional.tag != Types.TYPE_TAG_OPTIONAL or optional.first != Types.TYPE_TAG_I64
				return "string optional result mismatch"
		elif (ins.op == Mir.MIR_STRING_STARTS_WITH or ins.op == Mir.MIR_STRING_ENDS_WITH) and dst_type != Types.TYPE_TAG_BOOL
			return "string predicate result mismatch"
		return ""
	if ins.op == Mir.MIR_FUNCTION_REF
		if ins.immediate < 0 or ins.immediate >= len(program.functions) or program.types.entries[!dst_type].tag != Types.TYPE_TAG_FUNCTION
			return "invalid function reference"
		let signature = program.types.entries[!dst_type]
		let target = program.functions[!ins.immediate]
		if signature.first != Types.FUNCTION_EFFECT_UNCHECKED or signature.second != target.return_type or len(signature.fields) != target.argument_count
			return "function reference signature mismatch"
		for i in 0..target.argument_count
			if signature.fields[!i].kind != target.register_types[!i]
				return "function reference parameter mismatch"
		if ins.first != -1 or ins.second != -1 or len(ins.inputs) != 0
			return "function reference must not have operands"
		return ""
	if ins.op == Mir.MIR_CALL_INDIRECT
		if ins.first < 0 or ins.first >= len(types)
			return "invalid indirect callee"
		let signature = program.types.entries[!types[!ins.first]]
		if signature.tag != Types.TYPE_TAG_FUNCTION or len(ins.inputs) != len(signature.fields) or dst_type != signature.second
			return "indirect call signature mismatch"
		if ins.second != -1 or ins.immediate != 0
			return "invalid indirect call encoding"
		for i in 0..len(ins.inputs)
			if not mir_register_valid(types, ins.inputs[!i], signature.fields[!i].kind)
				return "indirect call argument type mismatch"
		return ""
	if ins.op == Mir.MIR_CALL or ins.op == Mir.MIR_CALL_MOVE
		if ins.immediate < 0 or ins.immediate >= len(program.functions)
			return "invalid callee"
		let callee = program.functions[!ins.immediate]
		if len(ins.inputs) != callee.argument_count or dst_type != callee.return_type
			return "call signature mismatch"
		for i in 0..len(ins.inputs)
			if not mir_register_valid(types, ins.inputs[!i], callee.register_types[!i])
				return "call argument type mismatch"
		if ins.op == Mir.MIR_CALL_MOVE
			return mir_verify_input_moves(program, function, ins)
		return ""
	if ins.op == Mir.MIR_NOT_BOOL
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_BOOL)
			return "boolean operand type mismatch"
		return ""
	if ins.op == Mir.MIR_NEG_I64
		if dst_type != Types.TYPE_TAG_I64 or not mir_register_valid(types, ins.first, Types.TYPE_TAG_I64)
			return "integer operand type mismatch"
		return ""
	if ins.op == Mir.MIR_NEG_F64 or ins.op == Mir.MIR_SQRT_F64
		if dst_type != Types.TYPE_TAG_F64 or not mir_register_valid(types, ins.first, Types.TYPE_TAG_F64)
			return "floating unary operand type mismatch"
		return ""
	if ins.op >= Mir.MIR_ADD_F64 and ins.op <= Mir.MIR_LE_F64
		let comparison = ins.op == Mir.MIR_EQ_F64 or ins.op == Mir.MIR_LT_F64 or ins.op == Mir.MIR_LE_F64
		if comparison and dst_type != Types.TYPE_TAG_BOOL
			return "floating comparison destination must be bool"
		if not comparison and dst_type != Types.TYPE_TAG_F64
			return "floating arithmetic destination must be f64"
		if not mir_register_valid(types, ins.first, Types.TYPE_TAG_F64) or not mir_register_valid(types, ins.second, Types.TYPE_TAG_F64)
			return "floating operand type mismatch"
		return ""
	if ins.op == Mir.MIR_EQ_VALUE
		if dst_type != Types.TYPE_TAG_BOOL or ins.first < 0 or ins.first >= len(types) or ins.second < 0 or ins.second >= len(types)
			return "invalid structural equality registers"
		let source = types[!ins.first]
		let tag = Types.type_tag(program.types, source)
		if source != types[!ins.second] or (tag != Types.TYPE_TAG_RECORD and tag != Types.TYPE_TAG_OPTIONAL and tag != Types.TYPE_TAG_UNION) or not Types.type_supports_equality(program.types, source)
			return "invalid structural equality operand type"
		return ""
	if ins.op == Mir.MIR_EQ_BOOL
		if dst_type != Types.TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, Types.TYPE_TAG_BOOL) or not mir_register_valid(types, ins.second, Types.TYPE_TAG_BOOL)
			return "boolean operand type mismatch"
		return ""
	if ins.op >= Mir.MIR_ADD_I64 and ins.op <= Mir.MIR_LE_I64 or ins.op >= Mir.MIR_BIT_AND_I64 and ins.op <= Mir.MIR_SHR_I64
		let comparison = ins.op == Mir.MIR_EQ_I64 or ins.op == Mir.MIR_LT_I64 or ins.op == Mir.MIR_LE_I64
		let required = Types.TYPE_TAG_I64
		if comparison
			if dst_type != Types.TYPE_TAG_BOOL
				return "integer comparison destination must be bool"
		elif dst_type != required
			return "integer arithmetic destination must be i64"
		if not mir_register_valid(types, ins.first, required) or not mir_register_valid(types, ins.second, required)
			return "integer operand type mismatch"
		return ""
	return "unsupported MIR opcode"

# Audit only compiler-produced MIR (after guard insertion). Handwritten MIR
# may deliberately omit guards and rely on the interpreter/C defensive checks.
# Verified emission requires proof of the compiler's structured CFG guard
# shape, including cleanup-only edges; the public audit verifies types first.
# A guard's successful branch can cross cleanup-only edges before reaching
# its instruction. Every incoming path must still establish that predicate.
# The failed branch can also cross cleanup blocks on its way to panic.
def mir_guarded_failure_path(function: Mir.MirFunction, block_id: i64, remaining: i64) -> bool
	if remaining == 0
		return false
	let block = function.blocks[!block_id]
	if block.terminator.kind == Mir.MIR_PANIC
		return true
	if block.terminator.kind != Mir.MIR_JUMP
		return false
	for ins in block.instructions
		if ins.op != Mir.MIR_RELEASE and ins.op != Mir.MIR_RELEASE_IF_INIT
			return false
	return mir_guarded_failure_path(function, block.terminator.target, remaining - 1)

def mir_guarded_predecessors(function: Mir.MirFunction, predecessors: Array[Array[i64]], block_id: i64, op: i64, first: i64, second: i64, earlier: i64, earlier_first: i64, earlier_second: i64, remaining: i64) -> bool
	if remaining == 0 or block_id == function.entry or len(predecessors[!block_id]) == 0
		return false
	for previous_id in predecessors[!block_id]
		let previous = function.blocks[!previous_id]
		let branch = previous.terminator
		if branch.kind == Mir.MIR_JUMP and branch.target == block_id
			for ins in previous.instructions
				if (ins.op != Mir.MIR_RELEASE and ins.op != Mir.MIR_RELEASE_IF_INIT) or ins.first == first or ins.first == second
					return false
			if not mir_guarded_predecessors(function, predecessors, previous_id, op, first, second, earlier, earlier_first, earlier_second, remaining - 1)
				return false
			continue
		if branch.kind != Mir.MIR_BRANCH or branch.target != block_id or branch.alternative == block_id
			return false
		if not mir_guarded_failure_path(function, branch.alternative, remaining)
			return false
		var found = false
		for offset in 0..len(previous.instructions)
			let ins = previous.instructions[!len(previous.instructions) - 1 - offset]
			if ins.dst == branch.operand
				if ins.op != op or ins.first != first or (second >= 0 and ins.second != second)
					return false
				found = true
				break
			if (ins.op != Mir.MIR_RELEASE and ins.op != Mir.MIR_RELEASE_IF_INIT) or ins.first == first or ins.first == second
				return false
		if not found
			return false
		if earlier >= 0 and not mir_guarded_predecessors(function, predecessors, previous_id, earlier, earlier_first, earlier_second, -1, -1, -1, remaining - 1)
			return false
	return true

def mir_guarded_instruction(function: Mir.MirFunction, predecessors: Array[Array[i64]], block_id: i64, position: i64, ins: Mir.MirInstruction) -> bool
	# No operand definition may intervene between the guard and its use.
	if position != 0
		return false
	if ins.op == Mir.MIR_F64_TO_I64
		return mir_guarded_predecessors(function, predecessors, block_id, Mir.MIR_F64_TO_I64_VALID, ins.first, -1, -1, -1, -1, len(function.blocks))
	if ins.op == Mir.MIR_DIV_I64 or ins.op == Mir.MIR_REM_I64
		return mir_guarded_predecessors(function, predecessors, block_id, Mir.MIR_DIV_NO_OVERFLOW_I64, ins.first, ins.second, Mir.MIR_NONZERO_I64, ins.second, -1, len(function.blocks))
	if ins.op == Mir.MIR_SHL_I64 or ins.op == Mir.MIR_SHR_I64
		return mir_guarded_predecessors(function, predecessors, block_id, Mir.MIR_SHIFT_VALID, ins.second, -1, -1, -1, -1, len(function.blocks))
	if ins.op == Mir.MIR_ARRAY_GET or ins.op == Mir.MIR_ARRAY_SET
		return mir_guarded_predecessors(function, predecessors, block_id, Mir.MIR_ARRAY_INDEX_VALID, ins.first, ins.second, -1, -1, -1, len(function.blocks))
	if ins.op == Mir.MIR_OPTIONAL_UNWRAP
		return mir_guarded_predecessors(function, predecessors, block_id, Mir.MIR_OPTIONAL_HAS, ins.first, -1, -1, -1, -1, len(function.blocks))
	return false

export def mir_audit_failures_unchecked(program: Mir.MirProgram) -> Mir.MirFailureAudit
	var guarded = 0
	var aborts = 0
	var in_band = 0
	for function in program.functions
		let predecessors = Cfg.mir_cfg_predecessors(function)
		for block_id in 0..len(function.blocks)
			let block = function.blocks[!block_id]
			for position in 0..len(block.instructions)
				let ins = block.instructions[!position]
				let failure = Mir.mir_failure_info(ins.op)
				if failure.guarded
					if ins.text != "__mir_guarded"
						return Mir.MirFailureAudit("unguarded MIR runtime failure", guarded, aborts, in_band)
					if not mir_guarded_instruction(function, predecessors, block_id, position, ins)
						return Mir.MirFailureAudit("guarded MIR runtime failure lacks matching CFG guard", guarded, aborts, in_band)
					guarded += 1
				elif ins.text == "__mir_guarded" and ins.op != Mir.MIR_CONST_STRING
					# A string literal may contain the marker text; it is not metadata.
					return Mir.MirFailureAudit("guard marker on non-fallible MIR instruction", guarded, aborts, in_band)
				if failure.abort
					aborts += 1
				if failure.in_band
					in_band += 1
	return Mir.MirFailureAudit("", guarded, aborts, in_band)

export def mir_audit_failures(program: Mir.MirProgram) -> Mir.MirFailureAudit
	let error = mir_verify(program)
	if error != ""
		return Mir.MirFailureAudit(error, 0, 0, 0)
	return mir_audit_failures_unchecked(program)

# Dictionary keys may be scalars, strings, or acyclic records consisting
# exclusively of hashable fields. Canonical field order defines key identity.
export def mir_dict_hashable_key(types: Types.TypeTable, kind: i64) -> bool
	if kind < 0 or kind >= len(types.entries)
		return false
	let desc = types.entries[!kind]
	if desc.tag == Types.TYPE_TAG_I64 or desc.tag == Types.TYPE_TAG_BOOL or desc.tag == Types.TYPE_TAG_STRING or desc.tag == Types.TYPE_TAG_F64
		return true
	if desc.tag == Types.TYPE_TAG_OPTIONAL
		return mir_dict_hashable_key(types, desc.first)
	if desc.tag != Types.TYPE_TAG_RECORD and desc.tag != Types.TYPE_TAG_UNION
		return false
	for field in desc.fields
		if not mir_dict_hashable_key(types, field.kind)
			return false
	return true

export def mir_verify(program: Mir.MirProgram) -> string
	# Primitive TypeIds are the only reserved IDs. All composite TypeIds must
	# have a managed descriptor, rather than an arithmetic kind encoding.
	if len(program.types.entries) <= Types.TYPE_TAG_VOID
		return "missing canonical primitive descriptors"
	for i in 0..len(program.types.entries)
		let entry = program.types.entries[!i]
		if i <= Types.TYPE_TAG_VOID
			if entry.tag != i or entry.first != 0 or entry.second != 0 or len(entry.fields) != 0
				return "noncanonical primitive type descriptor"
		elif entry.tag != Types.TYPE_TAG_RECORD and entry.tag != Types.TYPE_TAG_ARRAY and entry.tag != Types.TYPE_TAG_DICT and entry.tag != Types.TYPE_TAG_OPTIONAL and entry.tag != Types.TYPE_TAG_UNION and entry.tag != Types.TYPE_TAG_FUNCTION
			return "noncanonical composite type descriptor"
		if entry.tag == Types.TYPE_TAG_FUNCTION and not Types.type_descriptor_canonical(program.types, i)
			return "noncanonical function type descriptor"
		if entry.tag == Types.TYPE_TAG_UNION
			if not Types.type_descriptor_canonical(program.types, i)
				return "noncanonical union type descriptor"
			for member in entry.fields
				if member.kind >= i or not mir_type_supported(program.types, member.kind)
					return "invalid or cyclic union member"
		if entry.tag == Types.TYPE_TAG_RECORD and (entry.first != 0 or entry.second != 0)
			return "noncanonical record type descriptor"
		if entry.tag == Types.TYPE_TAG_ARRAY or entry.tag == Types.TYPE_TAG_OPTIONAL
			if entry.second != 0 or len(entry.fields) != 0
				return "noncanonical container type descriptor"
		if entry.tag == Types.TYPE_TAG_DICT and len(entry.fields) != 0
			return "noncanonical dictionary type descriptor"
		if entry.tag == Types.TYPE_TAG_OPTIONAL
			if entry.first < 0 or entry.first >= i or not mir_type_supported(program.types, entry.first)
				return "invalid or cyclic optional type"
		if entry.tag == Types.TYPE_TAG_DICT
			if entry.first < 0 or entry.first >= i or entry.second < 0 or entry.second >= i
				return "invalid or cyclic dictionary type"
			if not mir_dict_hashable_key(program.types, entry.first)
				return "unsupported dictionary key type"
			if not mir_type_supported(program.types, entry.second)
				return "unsupported dictionary value type"
		if entry.tag == Types.TYPE_TAG_ARRAY
			if entry.first < 0 or entry.first >= i or not mir_type_supported(program.types, entry.first)
				return "invalid or cyclic array element type"
		if entry.tag == Types.TYPE_TAG_RECORD
			for j in 0..len(entry.fields)
				let field = entry.fields[!j]
				if not mir_type_supported(program.types, field.kind)
					return "unsupported record field type"
				if j > 0 and entry.fields[!j - 1].name >= field.name
					return "record field order is not canonical"
				if (program.types.entries[!field.kind].tag == Types.TYPE_TAG_RECORD or program.types.entries[!field.kind].tag == Types.TYPE_TAG_ARRAY or program.types.entries[!field.kind].tag == Types.TYPE_TAG_DICT or program.types.entries[!field.kind].tag == Types.TYPE_TAG_OPTIONAL) and field.kind >= i
					return "cyclic record type descriptor"
	# Validate signatures first: call validation may inspect any callee.
	for function in program.functions
		let count = len(function.register_types)
		if function.argument_count < 0 or function.argument_count > count or not mir_type_supported(program.types, function.return_type)
			return "invalid function signature"
		for type_id in function.register_types
			if not mir_type_supported(program.types, type_id)
				return "unsupported register type"
	for function in program.functions
		if function.entry < 0 or function.entry >= len(function.blocks)
			return "invalid entry block"
		for block in function.blocks
			for position in 0..len(block.instructions)
				let ins = block.instructions[!position]
				# Fused allocation cannot be exposed as a standalone record.
				# Require the exact wrapping and release sequence in one block.
				if ins.op == Mir.MIR_RECORD_NEW_FUSED or ins.op == Mir.MIR_RECORD_NEW_FUSED_MOVE
					if position + 2 >= len(block.instructions)
						return "fused record missing union construction"
					let wrapped = block.instructions[!position + 1]
					let released = block.instructions[!position + 2]
					if wrapped.op != Mir.MIR_UNION_NEW or wrapped.first != ins.dst or wrapped.dst != ins.immediate or released.op != Mir.MIR_RELEASE or released.first != ins.dst
						return "fused record requires adjacent union and release"
				let error = mir_verify_instruction(program, function, ins)
				if error != ""
					return error
			let term = block.terminator
			if term.kind == Mir.MIR_JUMP or term.kind == Mir.MIR_BRANCH
				if term.target < 0 or term.target >= len(function.blocks)
					return "invalid jump target"
			if term.kind == Mir.MIR_BRANCH
				if term.alternative < 0 or term.alternative >= len(function.blocks)
					return "invalid branch target"
				if not mir_register_valid(function.register_types, term.operand, Types.TYPE_TAG_BOOL)
					return "branch condition must be bool"
			elif term.kind == Mir.MIR_RETURN
				if not mir_register_valid(function.register_types, term.operand, function.return_type)
					return "return type mismatch"
			elif term.kind != Mir.MIR_JUMP and term.kind != Mir.MIR_PANIC
				return "invalid block terminator"
	return ""
