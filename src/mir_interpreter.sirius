import mir alias Mir
import mir_common alias MirCommon
import mir_float alias Float
import types alias Types
# Dynamic execution of verified typed MIR; the source runner uses the same
# HIR specialization, MIR lowering, and optimization as the C backend.

def mir_failure(error: string, steps: i64) -> Mir.MirOutcome
	return Mir.new_mir_outcome(Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, ""), error, steps)

def mir_success(value: Mir.MirValue, steps: i64, heap: Array[Mir.MirHeapRecord]) -> Mir.MirOutcome
	return Mir.MirOutcome(value, "", steps, heap)

def mir_heap_retain(heap: Array[Mir.MirHeapRecord], index: i64) -> Array[Mir.MirHeapRecord]
	var next = heap
	var record = next[!index]
	record.refs += 1
	next[!index] = record
	return next

# Records own their fields. Releasing the last owner recursively drops fields.
def mir_heap_release(types: Types.TypeTable, heap: Array[Mir.MirHeapRecord], index: i64) -> Array[Mir.MirHeapRecord]
	var next = heap
	var record = next[!index]
	record.refs -= 1
	next[!index] = record
	if record.refs == 0
		for field in record.fields
			if MirCommon.mir_common_managed(types, field.type_id) and field.type_id != Types.TYPE_TAG_STRING
				next = mir_heap_release(types, next, field.bits)
	return next

def mir_heap_drop(types: Types.TypeTable, heap: Array[Mir.MirHeapRecord], value: Mir.MirValue) -> Array[Mir.MirHeapRecord]
	if value.type_id != Types.TYPE_TAG_INVALID and MirCommon.mir_common_managed(types, value.type_id) and value.type_id != Types.TYPE_TAG_STRING
		return mir_heap_release(types, heap, value.bits)
	return heap

def mir_heap_copy(types: Types.TypeTable, heap: Array[Mir.MirHeapRecord], value: Mir.MirValue) -> Array[Mir.MirHeapRecord]
	if value.type_id != Types.TYPE_TAG_INVALID and MirCommon.mir_common_managed(types, value.type_id) and value.type_id != Types.TYPE_TAG_STRING
		return mir_heap_retain(heap, value.bits)
	return heap

# Preserve the presence bit of read_text without conflating missing and empty files.
def mir_read_text_fields(path: string) -> Array[Mir.MirValue]
	let content = read_text(path) else return Array[Mir.MirValue]()
	return [Mir.new_mir_value(Types.TYPE_TAG_STRING, 0, content)]

rec MirDirectoryValues(present: bool, values: Array[Mir.MirValue])
def mir_list_dir_values(path: string) -> MirDirectoryValues
	let names = list_dir(path) else return MirDirectoryValues(false, Array[Mir.MirValue]())
	var values = Array[Mir.MirValue]()
	for name in names
		values = values.append(Mir.new_mir_value(Types.TYPE_TAG_STRING, 0, name))
	return MirDirectoryValues(true, values)

# The interpreter stores floating values separately from i64 handles/integers.
def mir_real_value(value: f64) -> Mir.MirValue
	return Mir.MirValue(Types.TYPE_TAG_F64, 0, "", value)

def mir_dict_equal(types: Types.TypeTable, heap: Array[Mir.MirHeapRecord], a: Mir.MirValue, b: Mir.MirValue) -> bool
	if a.type_id != b.type_id
		return false
	if a.type_id == Types.TYPE_TAG_STRING
		return a.text == b.text
	if a.type_id == Types.TYPE_TAG_F64
		return a.real == b.real
	if a.type_id >= Types.TYPE_TAG_RECORD and a.type_id < len(types.entries) and types.entries[!a.type_id].tag == Types.TYPE_TAG_RECORD
		let first = heap[!a.bits]
		let second = heap[!b.bits]
		if len(first.fields) != len(second.fields)
			return false
		for i in 0..len(first.fields)
			if not mir_dict_equal(types, heap, first.fields[!i], second.fields[!i])
				return false
		return true
	return a.bits == b.bits

def mir_execute_function_owned(program: Mir.MirProgram, function_id: i64, arguments: Array[Mir.MirValue], budget: i64, max_depth: i64, depth: i64, input_heap: Array[Mir.MirHeapRecord], moved_args: Array[i64], runtime_args: Array[string]) -> Mir.MirOutcome
	if depth >= max_depth
		return mir_failure("call depth limit exceeded", 0)
	let function = program.functions[!function_id]
	if len(arguments) != function.argument_count
		return mir_failure("wrong argument count", 0)
	var heap = input_heap
	var registers = Array[Mir.MirValue]()
	while len(registers) < len(function.register_types)
		registers = registers.append(Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, ""))
	for i in 0..len(arguments)
		let argument = arguments[!i]
		if argument.type_id != function.register_types[!i]
			return mir_failure("argument type mismatch", 0)
		if argument.type_id == Types.TYPE_TAG_BOOL and argument.bits != 0 and argument.bits != 1
			return mir_failure("invalid boolean value", 0)
		var moved = false
		for position in moved_args
			if position == i
				moved = true
		if not moved
			heap = mir_heap_copy(program.types, heap, argument)
		registers[!i] = argument
	var block_id = function.entry
	var steps = 0
	while true
		let block = function.blocks[!block_id]
		for ins in block.instructions
			if steps >= budget
				return mir_failure("step limit exceeded", steps)
			steps += 1
			if ins.op == Mir.MIR_CONST_F64
				registers[!ins.dst] = mir_real_value(Float.mir_parse_real(ins.text))
				continue
			if ins.op == Mir.MIR_NEG_F64 or ins.op == Mir.MIR_SQRT_F64
				let value = registers[!ins.first]
				if value.type_id != Types.TYPE_TAG_F64
					return mir_failure("invalid floating operand", steps)
				if ins.op == Mir.MIR_NEG_F64
					registers[!ins.dst] = mir_real_value(-value.real)
				else
					registers[!ins.dst] = mir_real_value(sqrt(value.real))
				continue
			if ins.op == Mir.MIR_RELEASE_IF_INIT
				if registers[!ins.dst].type_id != Types.TYPE_TAG_INVALID
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				continue
			if ins.op == Mir.MIR_ARGUMENTS
				var fields = Array[Mir.MirValue]()
				for argument in runtime_args
					fields = fields.append(Mir.new_mir_value(Types.TYPE_TAG_STRING, 0, argument))
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op == Mir.MIR_STR_I64
				let value = registers[!ins.first]
				if value.type_id != Types.TYPE_TAG_I64
					return mir_failure("str expects i64", steps)
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_STRING, 0, str(value.bits))
				continue
			if ins.op == Mir.MIR_FILESYSTEM_ERROR_KIND or ins.op == Mir.MIR_FILESYSTEM_ERROR_CODE
				var error = filesystem_error_kind()
				if ins.op == Mir.MIR_FILESYSTEM_ERROR_CODE
					error = filesystem_error_code()
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, error, "")
				continue
			if ins.op == Mir.MIR_READ_TEXT
				let path = registers[!ins.first]
				if path.type_id != Types.TYPE_TAG_STRING
					return mir_failure("read_text expects a string", steps)
				let fields = mir_read_text_fields(path.text)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op == Mir.MIR_LIST_DIR
				let path = registers[!ins.first]
				if path.type_id != Types.TYPE_TAG_STRING
					return mir_failure("list_dir expects a string", steps)
				let entries = mir_list_dir_values(path.text)
				var fields = Array[Mir.MirValue]()
				if entries.present
					let array_type = program.types.entries[!function.register_types[!ins.dst]].first
					fields = fields.append(Mir.new_mir_value(array_type, len(heap), ""))
					heap = heap.append(Mir.MirHeapRecord(array_type, entries.values, 1))
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op == Mir.MIR_IS_DIR
				let path = registers[!ins.first]
				if path.type_id != Types.TYPE_TAG_STRING
					return mir_failure("is_dir expects a string", steps)
				var value = 0
				if is_dir(path.text)
					value = 1
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, value, "")
				continue
			if ins.op == Mir.MIR_PATH_KIND
				let path = registers[!ins.first]
				if path.type_id != Types.TYPE_TAG_STRING
					return mir_failure("path_kind expects a string", steps)
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, path_kind(path.text), "")
				continue
			if ins.op == Mir.MIR_WRITE_TEXT
				let path = registers[!ins.first]
				let content = registers[!ins.second]
				if path.type_id != Types.TYPE_TAG_STRING or content.type_id != Types.TYPE_TAG_STRING
					return mir_failure("write_text expects strings", steps)
				var success = 0
				if write_text(path.text, content.text)
					success = 1
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, success, "")
				continue
			if ins.op == Mir.MIR_UNION_NEW
				if ins.first == -1
					let alternatives = program.types.entries[!function.register_types[!ins.dst]].fields
					if not Types.union_is_enum(program.types, function.register_types[!ins.dst]) or ins.second < 0 or ins.second >= len(alternatives) or alternatives[!ins.second].name == ""
						return mir_failure("invalid empty union alternative", steps)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], ins.second, "")
					continue
				let payload = registers[!ins.first]
				if payload.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized union payload", steps)
				var tag = ins.second
				if tag == -1
					tag = Types.union_alternative_index(program.types, function.register_types[!ins.dst], payload.type_id)
				if tag < 0 or Types.type_tag(program.types, function.register_types[!ins.dst]) != Types.TYPE_TAG_UNION
					return mir_failure("invalid union payload", steps)
				let alternatives = program.types.entries[!function.register_types[!ins.dst]].fields
				if tag >= len(alternatives) or alternatives[!tag].kind != payload.type_id or (ins.second >= 0 and alternatives[!tag].name == "")
					return mir_failure("invalid union payload", steps)
				if Types.union_is_enum(program.types, function.register_types[!ins.dst])
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], tag, "")
					continue
				heap = mir_heap_copy(program.types, heap, payload)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], [Mir.new_mir_value(Types.TYPE_TAG_I64, tag, ""), payload], 1))
				continue
			if ins.op == Mir.MIR_UNION_TAG or ins.op == Mir.MIR_UNION_GET
				let wrapper = registers[!ins.first]
				if Types.union_is_enum(program.types, function.register_types[!ins.first])
					let alternatives = program.types.entries[!function.register_types[!ins.first]].fields
					if wrapper.type_id == Types.TYPE_TAG_INVALID or wrapper.bits < 0 or wrapper.bits >= len(alternatives)
						return mir_failure("invalid enum tag", steps)
					if ins.op == Mir.MIR_UNION_TAG
						registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, wrapper.bits, "")
					else
						let member = alternatives[!wrapper.bits]
						if member.kind != function.register_types[!ins.dst] or (ins.second >= 0 and wrapper.bits != ins.second)
							return mir_failure("union variant mismatch", steps)
						heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
						registers[!ins.dst] = Mir.new_mir_value(member.kind, len(heap), "")
						heap = heap.append(Mir.MirHeapRecord(member.kind, Array[Mir.MirValue](), 1))
					continue
				if wrapper.type_id == Types.TYPE_TAG_INVALID or wrapper.bits < 0 or wrapper.bits >= len(heap) or heap[!wrapper.bits].refs <= 0
					return mir_failure("invalid union handle", steps)
				let fields = heap[!wrapper.bits].fields
				if len(fields) != 2
					return mir_failure("invalid union representation", steps)
				if ins.op == Mir.MIR_UNION_TAG
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, fields[!0].bits, "")
				else
					let payload = fields[!1]
					if payload.type_id != function.register_types[!ins.dst]
						return mir_failure("union variant mismatch", steps)
					if ins.second >= 0 and fields[!0].bits != ins.second
						return mir_failure("union variant mismatch", steps)
					heap = mir_heap_copy(program.types, heap, payload)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = payload
				continue
			if ins.op == Mir.MIR_OPTIONAL_NONE or ins.op == Mir.MIR_OPTIONAL_SOME
				var fields = Array[Mir.MirValue]()
				if ins.op == Mir.MIR_OPTIONAL_SOME
					let payload = registers[!ins.first]
					if payload.type_id == Types.TYPE_TAG_INVALID
						return mir_failure("uninitialized optional payload", steps)
					fields = fields.append(payload)
					heap = mir_heap_copy(program.types, heap, payload)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op == Mir.MIR_NONZERO_I64 or ins.op == Mir.MIR_DIV_NO_OVERFLOW_I64 or ins.op == Mir.MIR_SHIFT_VALID
				let first = registers[!ins.first]
				var valid = 0
				if first.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized guard operand", steps)
				if ins.op == Mir.MIR_SHIFT_VALID
					if first.bits >= 0 and first.bits < 64
						valid = 1
				elif ins.op == Mir.MIR_NONZERO_I64
					if first.bits != 0
						valid = 1
				else
					let second = registers[!ins.second]
					if second.type_id == Types.TYPE_TAG_INVALID
						return mir_failure("uninitialized guard operand", steps)
					if first.bits != (-9223372036854775807 - 1) or second.bits != -1
						valid = 1
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, valid, "")
				continue
			if ins.op == Mir.MIR_OPTIONAL_HAS or ins.op == Mir.MIR_OPTIONAL_UNWRAP
				let wrapped = registers[!ins.first]
				if wrapped.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized optional", steps)
				if wrapped.bits < 0 or wrapped.bits >= len(heap) or heap[!wrapped.bits].refs <= 0
					return mir_failure("invalid optional handle", steps)
				let fields = heap[!wrapped.bits].fields
				if ins.op == Mir.MIR_OPTIONAL_HAS
					var present = 0
					if len(fields) == 1
						present = 1
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, present, "")
					continue
				if len(fields) == 0
					return mir_failure("missing optional value", steps)
				let payload = fields[!0]
				heap = mir_heap_copy(program.types, heap, payload)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = payload
				continue
			if ins.op == Mir.MIR_DICT_NEXT or ins.op == Mir.MIR_DICT_KEY or ins.op == Mir.MIR_DICT_VALUE
				let owner = registers[!ins.first]
				if owner.type_id == Types.TYPE_TAG_INVALID or owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid dictionary handle", steps)
				let fields = heap[!owner.bits].fields
				let cursor = registers[!ins.second].bits
				if registers[!ins.second].type_id != Types.TYPE_TAG_I64
					return mir_failure("invalid dictionary cursor", steps)
				if ins.op == Mir.MIR_DICT_NEXT
					if cursor < -1 or cursor >= len(fields) / 2
						return mir_failure("invalid dictionary cursor", steps)
					var following = cursor + 1
					if following >= len(fields) / 2
						following = -1
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, following, "")
					continue
				if cursor < 0 or cursor >= len(fields) / 2
					return mir_failure("invalid dictionary cursor", steps)
				var slot = cursor * 2
				if ins.op == Mir.MIR_DICT_VALUE
					slot += 1
				let item = fields[!slot]
				heap = mir_heap_copy(program.types, heap, item)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = item
				continue
			if ins.op == Mir.MIR_DICT_NEW
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], Array[Mir.MirValue](), 1))
				continue
			if ins.op == Mir.MIR_DICT_INSERT or ins.op == Mir.MIR_DICT_GET_OR or ins.op == Mir.MIR_DICT_LENGTH or ins.op == Mir.MIR_DICT_GET_OPTIONAL
				let owner = registers[!ins.first]
				if owner.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized dictionary", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid dictionary handle", steps)
				let dict = heap[!owner.bits]
				if ins.op == Mir.MIR_DICT_LENGTH
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, len(dict.fields) / 2, "")
					continue
				var key_slot = ins.second
				if ins.op == Mir.MIR_DICT_INSERT
					key_slot = ins.inputs[!0]
				let key = registers[!key_slot]
				if key.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized dictionary key", steps)
				var at = -1
				for i in 0..len(dict.fields) / 2
					if mir_dict_equal(program.types, heap, dict.fields[!i * 2], key)
						at = i
						break
				if ins.op == Mir.MIR_DICT_GET_OPTIONAL
					var fields = Array[Mir.MirValue]()
					if at >= 0
						let payload = dict.fields[!at * 2 + 1]
						heap = mir_heap_copy(program.types, heap, payload)
						fields = fields.append(payload)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
					heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], fields, 1))
					continue
				if ins.op == Mir.MIR_DICT_GET_OR
					var selected = registers[!ins.immediate]
					if at >= 0
						selected = dict.fields[!at * 2 + 1]
					if selected.type_id == Types.TYPE_TAG_INVALID
						return mir_failure("uninitialized dictionary fallback", steps)
					heap = mir_heap_copy(program.types, heap, selected)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = selected
					continue
				let value = registers[!ins.inputs[!1]]
				if value.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized dictionary value", steps)
				# Retain inputs before modifying or dropping aliases.
				heap = mir_heap_copy(program.types, heap, key)
				heap = mir_heap_copy(program.types, heap, value)
				var result_index = owner.bits
				if dict.refs > 1
					for field in dict.fields
						heap = mir_heap_copy(program.types, heap, field)
					result_index = len(heap)
					heap = heap.append(Mir.MirHeapRecord(owner.type_id, dict.fields, 1))
					heap = mir_heap_release(program.types, heap, owner.bits)
				var modified = heap[!result_index]
				if at >= 0
					# Retain even the replaced key during the lookup above; now drop it.
					heap = mir_heap_drop(program.types, heap, modified.fields[!at * 2])
					heap = mir_heap_drop(program.types, heap, modified.fields[!at * 2 + 1])
					modified.fields[!at * 2] = key
					modified.fields[!at * 2 + 1] = value
				else
					modified.fields = modified.fields.append(key).append(value)
				heap[!result_index] = modified
				registers[!ins.first] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(owner.type_id, result_index, "")
				continue
			if ins.op == Mir.MIR_ARRAY_APPEND
				let owner = registers[!ins.first]
				let value = registers[!ins.second]
				if owner.type_id == Types.TYPE_TAG_INVALID or value.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized array append", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid array handle", steps)
				var fields = heap[!owner.bits].fields
				for item in fields
					heap = mir_heap_copy(program.types, heap, item)
				heap = mir_heap_copy(program.types, heap, value)
				fields = fields.append(value)
				heap = mir_heap_drop(program.types, heap, owner)
				registers[!ins.first] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(owner.type_id, len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(owner.type_id, fields, 1))
				continue
			if ins.op == Mir.MIR_ARRAY_NEW or ins.op == Mir.MIR_ARRAY_NEW_MOVE
				var values = Array[Mir.MirValue]()
				for source in ins.inputs
					let element = registers[!source]
					if element.type_id == Types.TYPE_TAG_INVALID
						return mir_failure("uninitialized array element", steps)
					values = values.append(element)
				for i in 0..len(values)
					if not Mir.mir_input_move_at(ins, i)
						heap = mir_heap_copy(program.types, heap, values[!i])
					else
						registers[!ins.inputs[!i]] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], values, 1))
				continue
			if ins.op == Mir.MIR_ARRAY_GET or ins.op == Mir.MIR_ARRAY_LENGTH or ins.op == Mir.MIR_ARRAY_SET or ins.op == Mir.MIR_ARRAY_GET_OPTIONAL or ins.op == Mir.MIR_ARRAY_INDEX_VALID
				let owner = registers[!ins.first]
				if owner.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized array", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid array handle", steps)
				let array = heap[!owner.bits]
				if ins.op == Mir.MIR_ARRAY_LENGTH
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, len(array.fields), "")
					continue
				let index = registers[!ins.second]
				if index.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized array index", steps)
				# Negative indices count back from the end. Adding a nonnegative
				# length to a negative i64 cannot overflow, even for i64::MIN.
				var position = index.bits
				if position < 0
					position += len(array.fields)
				if ins.op == Mir.MIR_ARRAY_INDEX_VALID
					var valid = 0
					if position >= 0 and position < len(array.fields)
						valid = 1
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, valid, "")
					continue
				if ins.op == Mir.MIR_ARRAY_GET_OPTIONAL
					var fields = Array[Mir.MirValue]()
					if position >= 0 and position < len(array.fields)
						let payload = array.fields[!position]
						heap = mir_heap_copy(program.types, heap, payload)
						fields = fields.append(payload)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
					heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], fields, 1))
					continue
				if position < 0 or position >= len(array.fields)
					return mir_failure("array index out of bounds", steps)
				if ins.op == Mir.MIR_ARRAY_GET
					let element = array.fields[!position]
					heap = mir_heap_copy(program.types, heap, element)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = element
					continue
				let value = registers[!ins.immediate]
				if value.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized array update value", steps)
				# Retain replacement before releasing the previous element, even on self-update.
				heap = mir_heap_copy(program.types, heap, value)
				var result_index = owner.bits
				if array.refs > 1
					for element in array.fields
						heap = mir_heap_copy(program.types, heap, element)
					result_index = len(heap)
					heap = heap.append(Mir.MirHeapRecord(owner.type_id, array.fields, 1))
					heap = mir_heap_release(program.types, heap, owner.bits)
				var changed = heap[!result_index]
				heap = mir_heap_drop(program.types, heap, changed.fields[!position])
				changed.fields[!position] = value
				heap[!result_index] = changed
				registers[!ins.first] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(owner.type_id, result_index, "")
				continue
			if ins.op == Mir.MIR_RECORD_NEW or ins.op == Mir.MIR_RECORD_NEW_MOVE or ins.op == Mir.MIR_RECORD_NEW_FUSED or ins.op == Mir.MIR_RECORD_NEW_FUSED_MOVE
				var fields = Array[Mir.MirValue]()
				for input in ins.inputs
					let field = registers[!input]
					if field.type_id == Types.TYPE_TAG_INVALID
						return mir_failure("uninitialized record field", steps)
					fields = fields.append(field)
				for i in 0..len(fields)
					if not Mir.mir_input_move_at(ins, i)
						heap = mir_heap_copy(program.types, heap, fields[!i])
					else
						registers[!ins.inputs[!i]] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op == Mir.MIR_RECORD_ARRAY_APPEND
				let owner = registers[!ins.first]
				let value = registers[!ins.second]
				if owner.type_id == Types.TYPE_TAG_INVALID or value.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized record array append", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid record handle", steps)
				let record = heap[!owner.bits]
				if ins.immediate < 0 or ins.immediate >= len(record.fields)
					return mir_failure("invalid record field", steps)
				# Clone the containing record before changing a shared snapshot.
				var result_index = owner.bits
				if record.refs > 1
					for element in record.fields
						heap = mir_heap_copy(program.types, heap, element)
					result_index = len(heap)
					heap = heap.append(Mir.MirHeapRecord(owner.type_id, record.fields, 1))
					heap = mir_heap_release(program.types, heap, owner.bits)
				let field_value = heap[!result_index].fields[!ins.immediate]
				let array = heap[!field_value.bits]
				var array_index = field_value.bits
				if array.refs > 1
					for element in array.fields
						heap = mir_heap_copy(program.types, heap, element)
					array_index = len(heap)
					heap = heap.append(Mir.MirHeapRecord(field_value.type_id, array.fields, 1))
					heap = mir_heap_release(program.types, heap, field_value.bits)
				heap = mir_heap_copy(program.types, heap, value)
				var updated_array = heap[!array_index]
				updated_array.fields = updated_array.fields.append(value)
				heap[!array_index] = updated_array
				var updated = heap[!result_index]
				updated.fields[!ins.immediate] = Mir.new_mir_value(field_value.type_id, array_index, "")
				heap[!result_index] = updated
				registers[!ins.first] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(owner.type_id, result_index, "")
				continue
			if ins.op == Mir.MIR_RECORD_SET
				let owner = registers[!ins.first]
				let value = registers[!ins.second]
				if owner.type_id == Types.TYPE_TAG_INVALID or value.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized record update", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid record handle", steps)
				let record = heap[!owner.bits]
				if ins.immediate < 0 or ins.immediate >= len(record.fields)
					return mir_failure("invalid record field", steps)
				# Retain the replacement before dropping an aliased old field.
				heap = mir_heap_copy(program.types, heap, value)
				var result_index = owner.bits
				if record.refs > 1
					for field in record.fields
						heap = mir_heap_copy(program.types, heap, field)
					result_index = len(heap)
					heap = heap.append(Mir.MirHeapRecord(owner.type_id, record.fields, 1))
					heap = mir_heap_release(program.types, heap, owner.bits)
				var updated = heap[!result_index]
				heap = mir_heap_drop(program.types, heap, updated.fields[!ins.immediate])
				updated.fields[!ins.immediate] = value
				heap[!result_index] = updated
				registers[!ins.first] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = Mir.new_mir_value(owner.type_id, result_index, "")
				continue
			if ins.op == Mir.MIR_RECORD_GET
				let owner = registers[!ins.first]
				if owner.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized record", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid record handle", steps)
				let field = heap[!owner.bits].fields[!ins.immediate]
				heap = mir_heap_copy(program.types, heap, field)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = field
				continue
			if ins.op == Mir.MIR_FUNCTION_REF
				registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], ins.immediate, "")
				continue
			if ins.op == Mir.MIR_CONST_I64
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, ins.immediate, "")
				continue
			if ins.op == Mir.MIR_CONST_BOOL
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, ins.immediate, "")
				continue
			if ins.op == Mir.MIR_CONST_STRING
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_STRING, 0, ins.text)
				continue
			if ins.op == Mir.MIR_COPY or ins.op == Mir.MIR_RETAIN or ins.op == Mir.MIR_MOVE or ins.op == Mir.MIR_RELEASE or ins.op == Mir.MIR_STRING_LENGTH or ins.op == Mir.MIR_NEG_I64 or ins.op == Mir.MIR_NOT_BOOL or ins.op == Mir.MIR_PRINT or ins.op == Mir.MIR_EPRINT
				let value = registers[!ins.first]
				if value.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized register", steps)
				if ins.op == Mir.MIR_COPY or ins.op == Mir.MIR_RETAIN
					heap = mir_heap_copy(program.types, heap, value)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = value
				elif ins.op == Mir.MIR_MOVE
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = value
					registers[!ins.first] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				elif ins.op == Mir.MIR_RELEASE
					heap = mir_heap_drop(program.types, heap, value)
					registers[!ins.first] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				elif ins.op == Mir.MIR_STRING_LENGTH
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, len(value.text), "")
				elif ins.op == Mir.MIR_NEG_I64
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, -value.bits, "")
				elif ins.op == Mir.MIR_NOT_BOOL
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, 1 - value.bits, "")
				elif ins.op == Mir.MIR_EPRINT
					if value.type_id == Types.TYPE_TAG_F64
						eprint(value.real)
					elif value.type_id == Types.TYPE_TAG_STRING
						eprint(value.text)
					elif value.type_id == Types.TYPE_TAG_BOOL
						eprint(value.bits != 0)
					else
						eprint(value.bits)
				elif value.type_id == Types.TYPE_TAG_F64
					print(value.real)
				elif value.type_id == Types.TYPE_TAG_STRING
					print(value.text)
				elif value.type_id == Types.TYPE_TAG_BOOL
					if value.bits == 0
						print(false)
					else
						print(true)
				else
					print(value.bits)
				continue
			if ins.op == Mir.MIR_CALL or ins.op == Mir.MIR_CALL_MOVE or ins.op == Mir.MIR_CALL_INDIRECT
				var target = ins.immediate
				if ins.op == Mir.MIR_CALL_INDIRECT
					let callee = registers[!ins.first]
					if callee.type_id != function.register_types[!ins.first] or callee.bits < 0 or callee.bits >= len(program.functions)
						return mir_failure("invalid indirect callee", steps)
					target = callee.bits
				var call_args = Array[Mir.MirValue]()
				for arg_register in ins.inputs
					let argument = registers[!arg_register]
					if argument.type_id == Types.TYPE_TAG_INVALID
						return mir_failure("uninitialized register", steps)
					call_args = call_args.append(argument)
				var moved_args = Array[i64]()
				if ins.op == Mir.MIR_CALL_MOVE
					for i in 0..len(ins.inputs)
						if Mir.mir_call_move_at(ins, i)
							moved_args = moved_args.append(i)
							registers[!ins.inputs[!i]] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
				let outcome = mir_execute_function_owned(program, target, call_args, budget - steps, max_depth, depth + 1, heap, moved_args, runtime_args)
				steps += outcome.steps
				if outcome.error != ""
					return mir_failure(outcome.error, steps)
				heap = outcome.heap
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = outcome.value
				continue
			let left = registers[!ins.first]
			let right = registers[!ins.second]
			if ins.op == Mir.MIR_STRING_CONCAT
				if left.type_id == Types.TYPE_TAG_INVALID or right.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("uninitialized register", steps)
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_STRING, 0, left.text + right.text)
				continue
			if ins.op >= Mir.MIR_EQ_STRING and ins.op <= Mir.MIR_LE_STRING
				if left.type_id != Types.TYPE_TAG_STRING or right.type_id != Types.TYPE_TAG_STRING
					return mir_failure("invalid string comparison operands", steps)
				var compare = false
				if ins.op == Mir.MIR_EQ_STRING
					compare = left.text == right.text
				elif ins.op == Mir.MIR_LT_STRING
					compare = left.text < right.text
				else
					compare = left.text <= right.text
				var bits = 0
				if compare
					bits = 1
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, bits, "")
				continue
			if ins.op >= Mir.MIR_STRING_SLICE and ins.op <= Mir.MIR_STRING_JOIN
				if left.type_id != Types.TYPE_TAG_STRING or right.type_id == Types.TYPE_TAG_INVALID
					return mir_failure("invalid string operation operands", steps)
				if ins.op == Mir.MIR_STRING_SLICE
					let end = registers[!ins.immediate]
					if end.type_id != Types.TYPE_TAG_I64
						return mir_failure("invalid string slice end", steps)
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_STRING, 0, left.text.slice(right.bits, end.bits))
				elif ins.op == Mir.MIR_STRING_STARTS_WITH or ins.op == Mir.MIR_STRING_ENDS_WITH
					var matches = false
					if ins.op == Mir.MIR_STRING_STARTS_WITH
						matches = left.text.starts_with(right.text)
					else
						matches = left.text.ends_with(right.text)
					var bits = 0
					if matches
						bits = 1
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, bits, "")
				elif ins.op == Mir.MIR_STRING_JOIN
					if right.bits < 0 or right.bits >= len(heap)
						return mir_failure("invalid join array", steps)
					var joined = ""
					let parts = heap[!right.bits].fields
					for i in 0..len(parts)
						if i > 0
							joined = joined + left.text
						joined = joined + parts[!i].text
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_STRING, 0, joined)
				else
					var index = -1
					if ins.op == Mir.MIR_STRING_BYTE_AT
						index = left.text.byte_at(right.bits) or -1
					else
						index = left.text.find(right.text) or -1
					var fields = Array[Mir.MirValue]()
					if index >= 0
						fields = fields.append(Mir.new_mir_value(Types.TYPE_TAG_I64, index, ""))
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = Mir.new_mir_value(function.register_types[!ins.dst], len(heap), "")
					heap = heap.append(Mir.MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op >= Mir.MIR_ADD_F64 and ins.op <= Mir.MIR_LE_F64
				if left.type_id != Types.TYPE_TAG_F64 or right.type_id != Types.TYPE_TAG_F64
					return mir_failure("invalid floating operands", steps)
				if ins.op == Mir.MIR_ADD_F64
					registers[!ins.dst] = mir_real_value(left.real + right.real)
				elif ins.op == Mir.MIR_SUB_F64
					registers[!ins.dst] = mir_real_value(left.real - right.real)
				elif ins.op == Mir.MIR_MUL_F64
					registers[!ins.dst] = mir_real_value(left.real * right.real)
				elif ins.op == Mir.MIR_DIV_F64
					registers[!ins.dst] = mir_real_value(left.real / right.real)
				else
					var answer = 0
					if ins.op == Mir.MIR_EQ_F64 and left.real == right.real or ins.op == Mir.MIR_LT_F64 and left.real < right.real or ins.op == Mir.MIR_LE_F64 and left.real <= right.real
						answer = 1
					registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, answer, "")
				continue
			if left.type_id == Types.TYPE_TAG_INVALID or right.type_id == Types.TYPE_TAG_INVALID
				return mir_failure("uninitialized register", steps)
			var answer = 0
			if ins.op == Mir.MIR_ADD_I64
				answer = left.bits + right.bits
			elif ins.op == Mir.MIR_SUB_I64
				answer = left.bits - right.bits
			elif ins.op == Mir.MIR_MUL_I64
				answer = left.bits * right.bits
			elif ins.op == Mir.MIR_DIV_I64 or ins.op == Mir.MIR_REM_I64
				if right.bits == 0
					return mir_failure("division by zero", steps)
				if left.bits == (-9223372036854775807 - 1) and right.bits == -1
					return mir_failure("integer overflow", steps)
				if ins.op == Mir.MIR_DIV_I64
					answer = left.bits / right.bits
				else
					answer = left.bits % right.bits
			elif ins.op == Mir.MIR_BIT_AND_I64
				answer = left.bits & right.bits
			elif ins.op == Mir.MIR_BIT_OR_I64
				answer = left.bits | right.bits
			elif ins.op == Mir.MIR_SHL_I64 or ins.op == Mir.MIR_SHR_I64
				if right.bits < 0 or right.bits >= 64
					return mir_failure("shift count out of range", steps)
				if ins.op == Mir.MIR_SHL_I64
					answer = left.bits << right.bits
				else
					answer = left.bits >> right.bits
			elif ins.op == Mir.MIR_EQ_I64 or ins.op == Mir.MIR_EQ_BOOL
				if left.bits == right.bits
					answer = 1
			elif ins.op == Mir.MIR_LT_I64
				if left.bits < right.bits
					answer = 1
			elif ins.op == Mir.MIR_LE_I64
				if left.bits <= right.bits
					answer = 1
			else
				return mir_failure("unsupported MIR opcode " + str(ins.op), steps)
			if ins.op == Mir.MIR_EQ_I64 or ins.op == Mir.MIR_EQ_BOOL or ins.op == Mir.MIR_LT_I64 or ins.op == Mir.MIR_LE_I64
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_BOOL, answer, "")
			else
				registers[!ins.dst] = Mir.new_mir_value(Types.TYPE_TAG_I64, answer, "")
		if steps >= budget
			return mir_failure("step limit exceeded", steps)
		steps += 1
		let term = block.terminator
		if term.kind == Mir.MIR_RETURN
			let result = registers[!term.operand]
			if result.type_id == Types.TYPE_TAG_INVALID
				return mir_failure("uninitialized return register", steps)
			registers[!term.operand] = Mir.new_mir_value(Types.TYPE_TAG_INVALID, 0, "")
			for value in registers
				heap = mir_heap_drop(program.types, heap, value)
			return mir_success(result, steps, heap)
		if term.kind == Mir.MIR_PANIC
			return mir_failure(term.message, steps)
		if term.kind == Mir.MIR_JUMP
			block_id = term.target
		else
			let condition = registers[!term.operand]
			if condition.type_id == Types.TYPE_TAG_INVALID
				return mir_failure("uninitialized branch condition", steps)
			if condition.bits == 0
				block_id = term.alternative
			else
				block_id = term.target
	return mir_failure("unreachable", steps)

def mir_execute_function(program: Mir.MirProgram, function_id: i64, arguments: Array[Mir.MirValue], budget: i64, max_depth: i64, depth: i64, input_heap: Array[Mir.MirHeapRecord], runtime_args: Array[string]) -> Mir.MirOutcome
	return mir_execute_function_owned(program, function_id, arguments, budget, max_depth, depth, input_heap, Array[i64](), runtime_args)

# Runtime arguments are provided by the execution host, not the compiler CLI.
export def mir_execute_with_arguments(program: Mir.MirProgram, function_id: i64, arguments: Array[Mir.MirValue], max_steps: i64, max_depth: i64, runtime_args: Array[string]) -> Mir.MirOutcome
	let error = MirCommon.mir_common_entry_error(program, function_id)
	if error != ""
		return mir_failure(error, 0)
	if max_steps <= 0 or max_depth <= 0
		return mir_failure("invalid execution limits", 0)
	# External callers cannot fabricate record handles without the execution heap.
	for argument in arguments
		if argument.type_id >= 0 and argument.type_id < len(program.types.entries) and (program.types.entries[!argument.type_id].tag == Types.TYPE_TAG_RECORD or program.types.entries[!argument.type_id].tag == Types.TYPE_TAG_ARRAY or program.types.entries[!argument.type_id].tag == Types.TYPE_TAG_DICT or program.types.entries[!argument.type_id].tag == Types.TYPE_TAG_OPTIONAL)
			return mir_failure("managed collection arguments require an execution heap", 0)
	return mir_execute_function(program, function_id, arguments, max_steps, max_depth, 0, Array[Mir.MirHeapRecord](), runtime_args)

export def mir_execute(program: Mir.MirProgram, function_id: i64, arguments: Array[Mir.MirValue], max_steps: i64, max_depth: i64) -> Mir.MirOutcome
	return mir_execute_with_arguments(program, function_id, arguments, max_steps, max_depth, arguments())

# On a successful return, the returned value is the sole external owner.
# Each reachable heap object owns its fields once, regardless of its refcount;
# multiple parent fields (or parents) contribute independent credits.
# This is an optional dynamic audit, not an unwinding guarantee on failure.
export def mir_audit_return_credits(types: Types.TypeTable, outcome: Mir.MirOutcome) -> string
	if outcome.error != ""
		return "cannot audit failed MIR execution"
	var credits = Array[i64]()
	var visited = Array[i64]()
	for cell in outcome.heap
		credits = credits.append(0)
		visited = visited.append(0)
	var queue = [outcome.value]
	var head = 0
	while head < len(queue)
		let value = queue[!head]
		head += 1
		if value.type_id != Types.TYPE_TAG_INVALID and MirCommon.mir_common_managed(types, value.type_id) and value.type_id != Types.TYPE_TAG_STRING
			if value.bits < 0 or value.bits >= len(outcome.heap)
				return "invalid owned heap handle"
			let index = value.bits
			let cell = outcome.heap[!index]
			if cell.type_id != value.type_id
				return "owned heap handle type mismatch"
			credits[!index] += 1
			if visited[!index] == 0
				visited[!index] = 1
				for field in cell.fields
					queue = queue.append(field)
	for i in 0..len(outcome.heap)
		if outcome.heap[!i].refs != credits[!i]
			return "heap ownership credit mismatch at object " + str(i)
	return ""
