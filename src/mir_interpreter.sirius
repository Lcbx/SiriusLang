# Unoptimized execution of verified typed MIR. This is not a source-level
# backend until the compiler lowers its typed HIR into this same representation.

def mir_failure(error: string, steps: i64) -> MirOutcome
	return MirOutcome(MirValue(TYPE_TAG_INVALID, 0, ""), error, steps)

def mir_success(value: MirValue, steps: i64, heap: Array[MirHeapRecord]) -> MirOutcome
	var result = MirOutcome(value, "", steps)
	result.heap = heap
	return result

def mir_heap_retain(heap: Array[MirHeapRecord], index: i64) -> Array[MirHeapRecord]
	var next = heap
	var record = next[!index]
	record.refs += 1
	next[!index] = record
	return next

# Records own their fields. Releasing the last owner recursively drops fields.
def mir_heap_release(types: TypeTable, heap: Array[MirHeapRecord], index: i64) -> Array[MirHeapRecord]
	var next = heap
	var record = next[!index]
	record.refs -= 1
	next[!index] = record
	if record.refs == 0
		for field in record.fields
			if mir_common_managed(field.type_id) and field.type_id != TYPE_TAG_STRING
				next = mir_heap_release(types, next, field.bits)
	return next

def mir_heap_drop(types: TypeTable, heap: Array[MirHeapRecord], value: MirValue) -> Array[MirHeapRecord]
	if value.type_id != TYPE_TAG_INVALID and mir_common_managed(value.type_id) and value.type_id != TYPE_TAG_STRING
		return mir_heap_release(types, heap, value.bits)
	return heap

def mir_heap_copy(types: TypeTable, heap: Array[MirHeapRecord], value: MirValue) -> Array[MirHeapRecord]
	if value.type_id != TYPE_TAG_INVALID and mir_common_managed(value.type_id) and value.type_id != TYPE_TAG_STRING
		return mir_heap_retain(heap, value.bits)
	return heap

def mir_dict_equal(a: MirValue, b: MirValue) -> bool
	if a.type_id == TYPE_TAG_STRING
		return a.text == b.text
	return a.bits == b.bits

def mir_execute_function_owned(program: MirProgram, function_id: i64, arguments: Array[MirValue], budget: i64, max_depth: i64, depth: i64, input_heap: Array[MirHeapRecord], moved_args: Array[i64]) -> MirOutcome
	if depth >= max_depth
		return mir_failure("call depth limit exceeded", 0)
	let function = program.functions[!function_id]
	if len(arguments) != function.argument_count
		return mir_failure("wrong argument count", 0)
	var heap = input_heap
	var registers = Array[MirValue]()
	while len(registers) < len(function.register_types)
		registers = registers.append(MirValue(TYPE_TAG_INVALID, 0, ""))
	for i in 0..len(arguments)
		let argument = arguments[!i]
		if argument.type_id != function.register_types[!i]
			return mir_failure("argument type mismatch", 0)
		if argument.type_id == TYPE_TAG_BOOL and argument.bits != 0 and argument.bits != 1
			return mir_failure("invalid boolean value", 0)
		var moved = false
		for position in moved_args
			if position == i
				moved = true
		if not moved
			heap = mir_heap_copy(program.types, heap, argument)
		registers[!i] = argument
	var block_id = function.entry
	var steps = 0
	while true
		let block = function.blocks[!block_id]
		for ins in block.instructions
			if steps >= budget
				return mir_failure("step limit exceeded", steps)
			steps += 1
			if ins.op == MIR_RELEASE_IF_INIT
				if registers[!ins.dst].type_id != TYPE_TAG_INVALID
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = MirValue(TYPE_TAG_INVALID, 0, "")
				continue
			if ins.op == MIR_ARGUMENTS
				var fields = Array[MirValue]()
				for argument in arguments()
					fields = fields.append(MirValue(TYPE_TAG_STRING, 0, argument))
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op == MIR_STR_I64
				let value = registers[!ins.first]
				if value.type_id != TYPE_TAG_I64
					return mir_failure("str expects i64", steps)
				registers[!ins.dst] = MirValue(TYPE_TAG_STRING, 0, str(value.bits))
				continue
			if ins.op == MIR_READ_TEXT
				return mir_failure("read_text is not yet supported in the MIR interpreter", steps)
			if ins.op == MIR_WRITE_TEXT
				let path = registers[!ins.first]
				let content = registers[!ins.second]
				if path.type_id != TYPE_TAG_STRING or content.type_id != TYPE_TAG_STRING
					return mir_failure("write_text expects strings", steps)
				var success = 0
				if write_text(path.text, content.text)
					success = 1
				registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, success, "")
				continue
			if ins.op == MIR_OPTIONAL_NONE or ins.op == MIR_OPTIONAL_SOME
				var fields = Array[MirValue]()
				if ins.op == MIR_OPTIONAL_SOME
					let payload = registers[!ins.first]
					if payload.type_id == TYPE_TAG_INVALID
						return mir_failure("uninitialized optional payload", steps)
					fields = fields.append(payload)
					heap = mir_heap_copy(program.types, heap, payload)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op == MIR_NONZERO_I64 or ins.op == MIR_DIV_NO_OVERFLOW_I64
				let first = registers[!ins.first]
				var valid = 0
				if first.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized guard operand", steps)
				if ins.op == MIR_NONZERO_I64
					if first.bits != 0
						valid = 1
				else
					let second = registers[!ins.second]
					if second.type_id == TYPE_TAG_INVALID
						return mir_failure("uninitialized guard operand", steps)
					if first.bits != (-9223372036854775807 - 1) or second.bits != -1
						valid = 1
				registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, valid, "")
				continue
			if ins.op == MIR_OPTIONAL_HAS or ins.op == MIR_OPTIONAL_UNWRAP
				let wrapped = registers[!ins.first]
				if wrapped.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized optional", steps)
				if wrapped.bits < 0 or wrapped.bits >= len(heap) or heap[!wrapped.bits].refs <= 0
					return mir_failure("invalid optional handle", steps)
				let fields = heap[!wrapped.bits].fields
				if ins.op == MIR_OPTIONAL_HAS
					var present = 0
					if len(fields) == 1
						present = 1
					registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, present, "")
					continue
				if len(fields) == 0
					return mir_failure("missing optional value", steps)
				let payload = fields[!0]
				heap = mir_heap_copy(program.types, heap, payload)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = payload
				continue
			if ins.op == MIR_DICT_NEW
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(MirHeapRecord(function.register_types[!ins.dst], Array[MirValue](), 1))
				continue
			if ins.op == MIR_DICT_INSERT or ins.op == MIR_DICT_GET_OR or ins.op == MIR_DICT_LENGTH or ins.op == MIR_DICT_GET_OPTIONAL
				let owner = registers[!ins.first]
				if owner.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized dictionary", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid dictionary handle", steps)
				let dict = heap[!owner.bits]
				if ins.op == MIR_DICT_LENGTH
					registers[!ins.dst] = MirValue(TYPE_TAG_I64, len(dict.fields) / 2, "")
					continue
				var key_slot = ins.second
				if ins.op == MIR_DICT_INSERT
					key_slot = ins.inputs[!0]
				let key = registers[!key_slot]
				if key.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized dictionary key", steps)
				var at = -1
				for i in 0..len(dict.fields) / 2
					if mir_dict_equal(dict.fields[!i * 2], key)
						at = i
						break
				if ins.op == MIR_DICT_GET_OPTIONAL
					var fields = Array[MirValue]()
					if at >= 0
						let payload = dict.fields[!at * 2 + 1]
						heap = mir_heap_copy(program.types, heap, payload)
						fields = fields.append(payload)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = MirValue(function.register_types[!ins.dst], len(heap), "")
					heap = heap.append(MirHeapRecord(function.register_types[!ins.dst], fields, 1))
					continue
				if ins.op == MIR_DICT_GET_OR
					var selected = registers[!ins.immediate]
					if at >= 0
						selected = dict.fields[!at * 2 + 1]
					if selected.type_id == TYPE_TAG_INVALID
						return mir_failure("uninitialized dictionary fallback", steps)
					heap = mir_heap_copy(program.types, heap, selected)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = selected
					continue
				let value = registers[!ins.inputs[!1]]
				if value.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized dictionary value", steps)
				# Retain inputs before modifying or dropping aliases.
				heap = mir_heap_copy(program.types, heap, key)
				heap = mir_heap_copy(program.types, heap, value)
				var result_index = owner.bits
				if dict.refs > 1
					for field in dict.fields
						heap = mir_heap_copy(program.types, heap, field)
					result_index = len(heap)
					heap = heap.append(MirHeapRecord(owner.type_id, dict.fields, 1))
					heap = mir_heap_release(program.types, heap, owner.bits)
				var modified = heap[!result_index]
				if at >= 0
					# Retain even the replaced key during the lookup above; now drop it.
					heap = mir_heap_drop(program.types, heap, modified.fields[!at * 2])
					heap = mir_heap_drop(program.types, heap, modified.fields[!at * 2 + 1])
					modified.fields[!at * 2] = key
					modified.fields[!at * 2 + 1] = value
				else
					modified.fields = modified.fields.append(key).append(value)
				heap[!result_index] = modified
				registers[!ins.first] = MirValue(TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(owner.type_id, result_index, "")
				continue
			if ins.op == MIR_ARRAY_APPEND
				let owner = registers[!ins.first]
				let value = registers[!ins.second]
				if owner.type_id == TYPE_TAG_INVALID or value.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized array append", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid array handle", steps)
				var fields = heap[!owner.bits].fields
				for item in fields
					heap = mir_heap_copy(program.types, heap, item)
				heap = mir_heap_copy(program.types, heap, value)
				fields = fields.append(value)
				heap = mir_heap_drop(program.types, heap, owner)
				registers[!ins.first] = MirValue(TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(owner.type_id, len(heap), "")
				heap = heap.append(MirHeapRecord(owner.type_id, fields, 1))
				continue
			if ins.op == MIR_ARRAY_NEW
				var values = Array[MirValue]()
				for source in ins.inputs
					let element = registers[!source]
					if element.type_id == TYPE_TAG_INVALID
						return mir_failure("uninitialized array element", steps)
					values = values.append(element)
				for element in values
					heap = mir_heap_copy(program.types, heap, element)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(MirHeapRecord(function.register_types[!ins.dst], values, 1))
				continue
			if ins.op == MIR_ARRAY_GET or ins.op == MIR_ARRAY_LENGTH or ins.op == MIR_ARRAY_SET or ins.op == MIR_ARRAY_GET_OPTIONAL or ins.op == MIR_ARRAY_INDEX_VALID
				let owner = registers[!ins.first]
				if owner.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized array", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid array handle", steps)
				let array = heap[!owner.bits]
				if ins.op == MIR_ARRAY_LENGTH
					registers[!ins.dst] = MirValue(TYPE_TAG_I64, len(array.fields), "")
					continue
				let index = registers[!ins.second]
				if index.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized array index", steps)
				if ins.op == MIR_ARRAY_INDEX_VALID
					var valid = 0
					if index.bits >= 0 and index.bits < len(array.fields)
						valid = 1
					registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, valid, "")
					continue
				if ins.op == MIR_ARRAY_GET_OPTIONAL
					var fields = Array[MirValue]()
					if index.bits >= 0 and index.bits < len(array.fields)
						let payload = array.fields[!index.bits]
						heap = mir_heap_copy(program.types, heap, payload)
						fields = fields.append(payload)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = MirValue(function.register_types[!ins.dst], len(heap), "")
					heap = heap.append(MirHeapRecord(function.register_types[!ins.dst], fields, 1))
					continue
				if index.bits < 0 or index.bits >= len(array.fields)
					return mir_failure("array index out of bounds", steps)
				if ins.op == MIR_ARRAY_GET
					let element = array.fields[!index.bits]
					heap = mir_heap_copy(program.types, heap, element)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = element
					continue
				let value = registers[!ins.immediate]
				if value.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized array update value", steps)
				# Retain replacement before releasing the previous element, even on self-update.
				heap = mir_heap_copy(program.types, heap, value)
				var result_index = owner.bits
				if array.refs > 1
					for element in array.fields
						heap = mir_heap_copy(program.types, heap, element)
					result_index = len(heap)
					heap = heap.append(MirHeapRecord(owner.type_id, array.fields, 1))
					heap = mir_heap_release(program.types, heap, owner.bits)
				var changed = heap[!result_index]
				heap = mir_heap_drop(program.types, heap, changed.fields[!index.bits])
				changed.fields[!index.bits] = value
				heap[!result_index] = changed
				registers[!ins.first] = MirValue(TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(owner.type_id, result_index, "")
				continue
			if ins.op == MIR_RECORD_NEW
				var fields = Array[MirValue]()
				for input in ins.inputs
					let field = registers[!input]
					if field.type_id == TYPE_TAG_INVALID
						return mir_failure("uninitialized record field", steps)
					fields = fields.append(field)
				for field in fields
					heap = mir_heap_copy(program.types, heap, field)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(function.register_types[!ins.dst], len(heap), "")
				heap = heap.append(MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if ins.op == MIR_RECORD_ARRAY_APPEND
				let owner = registers[!ins.first]
				let value = registers[!ins.second]
				if owner.type_id == TYPE_TAG_INVALID or value.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized record array append", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid record handle", steps)
				let record = heap[!owner.bits]
				if ins.immediate < 0 or ins.immediate >= len(record.fields)
					return mir_failure("invalid record field", steps)
				# Clone the containing record before changing a shared snapshot.
				var result_index = owner.bits
				if record.refs > 1
					for element in record.fields
						heap = mir_heap_copy(program.types, heap, element)
					result_index = len(heap)
					heap = heap.append(MirHeapRecord(owner.type_id, record.fields, 1))
					heap = mir_heap_release(program.types, heap, owner.bits)
				let field_value = heap[!result_index].fields[!ins.immediate]
				let array = heap[!field_value.bits]
				var array_index = field_value.bits
				if array.refs > 1
					for element in array.fields
						heap = mir_heap_copy(program.types, heap, element)
					array_index = len(heap)
					heap = heap.append(MirHeapRecord(field_value.type_id, array.fields, 1))
					heap = mir_heap_release(program.types, heap, field_value.bits)
				heap = mir_heap_copy(program.types, heap, value)
				var updated_array = heap[!array_index]
				updated_array.fields = updated_array.fields.append(value)
				heap[!array_index] = updated_array
				var updated = heap[!result_index]
				updated.fields[!ins.immediate] = MirValue(field_value.type_id, array_index, "")
				heap[!result_index] = updated
				registers[!ins.first] = MirValue(TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(owner.type_id, result_index, "")
				continue
			if ins.op == MIR_RECORD_SET
				let owner = registers[!ins.first]
				let value = registers[!ins.second]
				if owner.type_id == TYPE_TAG_INVALID or value.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized record update", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid record handle", steps)
				let record = heap[!owner.bits]
				if ins.immediate < 0 or ins.immediate >= len(record.fields)
					return mir_failure("invalid record field", steps)
				# Retain the replacement before dropping an aliased old field.
				heap = mir_heap_copy(program.types, heap, value)
				var result_index = owner.bits
				if record.refs > 1
					for field in record.fields
						heap = mir_heap_copy(program.types, heap, field)
					result_index = len(heap)
					heap = heap.append(MirHeapRecord(owner.type_id, record.fields, 1))
					heap = mir_heap_release(program.types, heap, owner.bits)
				var updated = heap[!result_index]
				heap = mir_heap_drop(program.types, heap, updated.fields[!ins.immediate])
				updated.fields[!ins.immediate] = value
				heap[!result_index] = updated
				registers[!ins.first] = MirValue(TYPE_TAG_INVALID, 0, "")
				if ins.dst != ins.first
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = MirValue(owner.type_id, result_index, "")
				continue
			if ins.op == MIR_RECORD_GET
				let owner = registers[!ins.first]
				if owner.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized record", steps)
				if owner.bits < 0 or owner.bits >= len(heap) or heap[!owner.bits].refs <= 0
					return mir_failure("invalid record handle", steps)
				let field = heap[!owner.bits].fields[!ins.immediate]
				heap = mir_heap_copy(program.types, heap, field)
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = field
				continue
			if ins.op == MIR_CONST_I64
				registers[!ins.dst] = MirValue(TYPE_TAG_I64, ins.immediate, "")
				continue
			if ins.op == MIR_CONST_BOOL
				registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, ins.immediate, "")
				continue
			if ins.op == MIR_CONST_STRING
				registers[!ins.dst] = MirValue(TYPE_TAG_STRING, 0, ins.text)
				continue
			if ins.op == MIR_COPY or ins.op == MIR_RETAIN or ins.op == MIR_MOVE or ins.op == MIR_RELEASE or ins.op == MIR_STRING_LENGTH or ins.op == MIR_NEG_I64 or ins.op == MIR_NOT_BOOL or ins.op == MIR_PRINT
				let value = registers[!ins.first]
				if value.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized register", steps)
				if ins.op == MIR_COPY or ins.op == MIR_RETAIN
					heap = mir_heap_copy(program.types, heap, value)
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = value
				elif ins.op == MIR_MOVE
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = value
					registers[!ins.first] = MirValue(TYPE_TAG_INVALID, 0, "")
				elif ins.op == MIR_RELEASE
					heap = mir_heap_drop(program.types, heap, value)
					registers[!ins.first] = MirValue(TYPE_TAG_INVALID, 0, "")
				elif ins.op == MIR_STRING_LENGTH
					registers[!ins.dst] = MirValue(TYPE_TAG_I64, len(value.text), "")
				elif ins.op == MIR_NEG_I64
					registers[!ins.dst] = MirValue(TYPE_TAG_I64, -value.bits, "")
				elif ins.op == MIR_NOT_BOOL
					registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, 1 - value.bits, "")
				elif value.type_id == TYPE_TAG_STRING
					print(value.text)
				elif value.type_id == TYPE_TAG_BOOL
					if value.bits == 0
						print(false)
					else
						print(true)
				else
					print(value.bits)
				continue
			if ins.op == MIR_CALL or ins.op == MIR_CALL_MOVE
				var call_args = Array[MirValue]()
				for arg_register in ins.inputs
					let argument = registers[!arg_register]
					if argument.type_id == TYPE_TAG_INVALID
						return mir_failure("uninitialized register", steps)
					call_args = call_args.append(argument)
				var moved_args = Array[i64]()
				if ins.op == MIR_CALL_MOVE
					for i in 0..len(ins.inputs)
						if mir_call_move_at(ins, i)
							moved_args = moved_args.append(i)
							registers[!ins.inputs[!i]] = MirValue(TYPE_TAG_INVALID, 0, "")
				let outcome = mir_execute_function_owned(program, ins.immediate, call_args, budget - steps, max_depth, depth + 1, heap, moved_args)
				steps += outcome.steps
				if outcome.error != ""
					return mir_failure(outcome.error, steps)
				heap = outcome.heap
				heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
				registers[!ins.dst] = outcome.value
				continue
			let left = registers[!ins.first]
			let right = registers[!ins.second]
			if ins.op == MIR_STRING_CONCAT
				if left.type_id == TYPE_TAG_INVALID or right.type_id == TYPE_TAG_INVALID
					return mir_failure("uninitialized register", steps)
				registers[!ins.dst] = MirValue(TYPE_TAG_STRING, 0, left.text + right.text)
				continue
			if ins.op >= MIR_EQ_STRING and ins.op <= MIR_LE_STRING
				if left.type_id != TYPE_TAG_STRING or right.type_id != TYPE_TAG_STRING
					return mir_failure("invalid string comparison operands", steps)
				var compare = false
				if ins.op == MIR_EQ_STRING
					compare = left.text == right.text
				elif ins.op == MIR_LT_STRING
					compare = left.text < right.text
				else
					compare = left.text <= right.text
				var bits = 0
				if compare
					bits = 1
				registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, bits, "")
				continue
			if ins.op >= MIR_STRING_SLICE and ins.op <= MIR_STRING_JOIN
				if left.type_id != TYPE_TAG_STRING or right.type_id == TYPE_TAG_INVALID
					return mir_failure("invalid string operation operands", steps)
				if ins.op == MIR_STRING_SLICE
					let end = registers[!ins.immediate]
					if end.type_id != TYPE_TAG_I64
						return mir_failure("invalid string slice end", steps)
					registers[!ins.dst] = MirValue(TYPE_TAG_STRING, 0, left.text.slice(right.bits, end.bits))
				elif ins.op == MIR_STRING_STARTS_WITH or ins.op == MIR_STRING_ENDS_WITH
					var matches = false
					if ins.op == MIR_STRING_STARTS_WITH
						matches = left.text.starts_with(right.text)
					else
						matches = left.text.ends_with(right.text)
					var bits = 0
					if matches
						bits = 1
					registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, bits, "")
				elif ins.op == MIR_STRING_JOIN
					if right.bits < 0 or right.bits >= len(heap)
						return mir_failure("invalid join array", steps)
					var joined = ""
					let parts = heap[!right.bits].fields
					for i in 0..len(parts)
						if i > 0
							joined = joined + left.text
						joined = joined + parts[!i].text
					registers[!ins.dst] = MirValue(TYPE_TAG_STRING, 0, joined)
				else
					var index = -1
					if ins.op == MIR_STRING_BYTE_AT
						index = left.text.byte_at(right.bits) or -1
					else
						index = left.text.find(right.text) or -1
					var fields = Array[MirValue]()
					if index >= 0
						fields = fields.append(MirValue(TYPE_TAG_I64, index, ""))
					heap = mir_heap_drop(program.types, heap, registers[!ins.dst])
					registers[!ins.dst] = MirValue(function.register_types[!ins.dst], len(heap), "")
					heap = heap.append(MirHeapRecord(function.register_types[!ins.dst], fields, 1))
				continue
			if left.type_id == TYPE_TAG_INVALID or right.type_id == TYPE_TAG_INVALID
				return mir_failure("uninitialized register", steps)
			var answer = 0
			if ins.op == MIR_ADD_I64
				answer = left.bits + right.bits
			elif ins.op == MIR_SUB_I64
				answer = left.bits - right.bits
			elif ins.op == MIR_MUL_I64
				answer = left.bits * right.bits
			elif ins.op == MIR_DIV_I64 or ins.op == MIR_REM_I64
				if right.bits == 0
					return mir_failure("division by zero", steps)
				if ins.op == MIR_DIV_I64
					answer = left.bits / right.bits
				else
					answer = left.bits % right.bits
			elif ins.op == MIR_EQ_I64 or ins.op == MIR_EQ_BOOL
				if left.bits == right.bits
					answer = 1
			elif ins.op == MIR_LT_I64
				if left.bits < right.bits
					answer = 1
			elif ins.op == MIR_LE_I64
				if left.bits <= right.bits
					answer = 1
			if ins.op == MIR_EQ_I64 or ins.op == MIR_EQ_BOOL or ins.op == MIR_LT_I64 or ins.op == MIR_LE_I64
				registers[!ins.dst] = MirValue(TYPE_TAG_BOOL, answer, "")
			else
				registers[!ins.dst] = MirValue(TYPE_TAG_I64, answer, "")
		if steps >= budget
			return mir_failure("step limit exceeded", steps)
		steps += 1
		let term = block.terminator
		if term.kind == MIR_RETURN
			let result = registers[!term.operand]
			if result.type_id == TYPE_TAG_INVALID
				return mir_failure("uninitialized return register", steps)
			registers[!term.operand] = MirValue(TYPE_TAG_INVALID, 0, "")
			for value in registers
				heap = mir_heap_drop(program.types, heap, value)
			return mir_success(result, steps, heap)
		if term.kind == MIR_PANIC
			return mir_failure(term.message, steps)
		if term.kind == MIR_JUMP
			block_id = term.target
		else
			let condition = registers[!term.operand]
			if condition.type_id == TYPE_TAG_INVALID
				return mir_failure("uninitialized branch condition", steps)
			if condition.bits == 0
				block_id = term.alternative
			else
				block_id = term.target
	return mir_failure("unreachable", steps)

def mir_execute_function(program: MirProgram, function_id: i64, arguments: Array[MirValue], budget: i64, max_depth: i64, depth: i64, input_heap: Array[MirHeapRecord]) -> MirOutcome
	return mir_execute_function_owned(program, function_id, arguments, budget, max_depth, depth, input_heap, Array[i64]())

def mir_execute(program: MirProgram, function_id: i64, arguments: Array[MirValue], max_steps: i64, max_depth: i64) -> MirOutcome
	let error = mir_common_entry_error(program, function_id)
	if error != ""
		return mir_failure(error, 0)
	if max_steps <= 0 or max_depth <= 0
		return mir_failure("invalid execution limits", 0)
	# External callers cannot fabricate record handles without the execution heap.
	for argument in arguments
		if argument.type_id >= 0 and argument.type_id < len(program.types.entries) and (program.types.entries[!argument.type_id].tag == TYPE_TAG_RECORD or program.types.entries[!argument.type_id].tag == TYPE_TAG_ARRAY or program.types.entries[!argument.type_id].tag == TYPE_TAG_DICT or program.types.entries[!argument.type_id].tag == TYPE_TAG_OPTIONAL)
			return mir_failure("managed collection arguments require an execution heap", 0)
	return mir_execute_function(program, function_id, arguments, max_steps, max_depth, 0, Array[MirHeapRecord]())
