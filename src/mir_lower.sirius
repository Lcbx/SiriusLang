# Typed-HIR -> CFG MIR lowering, including managed collections, record spreads, and tail recurrence.
# Deeply nested mutable projections remain unsupported.
# Expressions require corresponding checked HIR nodes and preserve source order.

rec MirSourceBinding(name: string, slot: i64, depth: i64)
rec MirCallTarget(source: i64, specialization: i64)
rec MirLowerField(name: string, slot: i64)

# Source analysis is immutable during lowering; the builder owns only mutable CFG state.
rec MirLowerContext(tree: ParseState, hir: Array[HirNode], annotation_index: HirAnnotationIndex, types: TypeTable, functions: Array[HirFunctionDecl], constants: Array[HirModuleConstant], call_targets: Array[MirCallTarget], function_name: string, argument_count: i64)

rec MirBuilder(active: i64)
	pub register_types = Array[i64]()
	pub blocks = Array[MirBlock]()
	pub bindings = Array[MirSourceBinding]()
	pub depth = 0
	pub error = ""
	pub break_targets = Array[i64]()
	pub continue_targets = Array[i64]()

rec MirLowerExpr(state: MirBuilder, slot: i64)
rec MirLowerResult(function: MirFunction, error: string)

def mir_lower_error(state: MirBuilder, message: string) -> MirBuilder
	var next = state
	if next.error == ""
		next.error = message
	return next

def mir_lower_block(state: MirBuilder) -> MirBuilder
	var next = state
	next.active = len(next.blocks)
	next.blocks = next.blocks.append(MirBlock(Array[MirInstruction](), MirTerminator(0, -1, -1, -1, "")))
	return next

def mir_lower_ended(state: MirBuilder) -> bool
	return state.blocks[!state.active].terminator.kind != 0

def mir_lower_emit(state: MirBuilder, instruction: MirInstruction) -> MirBuilder
	var next = state
	let block = next.blocks[!next.active]
	next.blocks[!next.active] = MirBlock(block.instructions.append(instruction), block.terminator)
	return next

def mir_lower_end(state: MirBuilder, term: MirTerminator) -> MirBuilder
	var next = state
	let block = next.blocks[!next.active]
	next.blocks[!next.active] = MirBlock(block.instructions, term)
	return next

def mir_lower_register(state: MirBuilder, type_id: i64) -> MirBuilder
	var next = state
	next.register_types = next.register_types.append(type_id)
	return next

def mir_lower_type(context: MirLowerContext, source: i64, operation: i64) -> i64
	let at = hir_annotation_find(context.hir, context.annotation_index, source, operation)
	if at >= 0
		return context.hir[!at].type_id
	return TYPE_TAG_INVALID

def mir_lower_field_index(context: MirLowerContext, source: i64) -> i64
	let at = hir_annotation_find(context.hir, context.annotation_index, source, HIR_FIELD)
	if at >= 0
		return context.hir[!at].field_index
	return -1

def mir_lower_binding(state: MirBuilder, name: string) -> i64
	for i in 0..len(state.bindings)
		let j = len(state.bindings) - 1 - i
		if state.bindings[!j].name == name
			return state.bindings[!j].slot
	return -1

# Record updates transfer ownership of the local record; the C backend
# mutates uniquely owned records and clones when a snapshot is still alive.
def mir_lower_record_update(state: MirBuilder, context: MirLowerContext, root: i64, field: i64, value: i64) -> MirBuilder
	let record_type = state.register_types[!root]
	let layout = context.types.entries[!record_type].fields
	if field < 0 or field >= len(layout) or layout[!field].kind != state.register_types[!value]
		return mir_lower_error(state, "MIR record update type mismatch")
	return mir_lower_emit(state, mir_record_set(root, root, field, value))

# Evaluate a compound assignment using the current target before storing it.
def mir_lower_augmented(state: MirBuilder, operator: string, previous: i64, value: i64) -> MirLowerExpr
	var next = state
	let kind = next.register_types[!previous]
	if kind != next.register_types[!value]
		return MirLowerExpr(mir_lower_error(next, "MIR assignment type mismatch"), -1)
	var opcode = -1
	if operator == "+="
		if kind == TYPE_TAG_F64
			opcode = MIR_ADD_F64
		elif kind == TYPE_TAG_STRING
			opcode = MIR_STRING_CONCAT
		elif kind == TYPE_TAG_I64
			opcode = MIR_ADD_I64
	elif kind == TYPE_TAG_F64
		if operator == "-="
			opcode = MIR_SUB_F64
		elif operator == "*="
			opcode = MIR_MUL_F64
		elif operator == "/="
			opcode = MIR_DIV_F64
	elif kind == TYPE_TAG_I64
		if operator == "-="
			opcode = MIR_SUB_I64
		elif operator == "*="
			opcode = MIR_MUL_I64
		elif operator == "/="
			opcode = MIR_DIV_I64
	if opcode < 0
		return MirLowerExpr(mir_lower_error(next, "unsupported MIR augmented assignment"), -1)
	let dst = len(next.register_types)
	next = mir_lower_register(next, kind)
	next = mir_lower_emit(next, mir_op(opcode, dst, previous, value, 0))
	return MirLowerExpr(next, dst)

def mir_lower_literal(text: string) -> i64
	var value = 0
	for i in 0..len(text)
		value = value * 10 + (text.byte_at(i) or 48) - 48
	return value

rec MirLowerString(value: string, error: string)

# The parser retains the quotes. Decode the initial supported escape set;
# unsupported escapes are rejected, never interpreted differently by C.
def mir_lower_string(text: string) -> MirLowerString
	var result = ""
	var i = 1
	while i < len(text) - 1
		let byte = text.byte_at(i) or 0
		if byte == 92
			i += 1
			if i >= len(text) - 1
				return MirLowerString("", "unterminated MIR string escape")
			let escaped = text.byte_at(i) or 0
			if escaped == 110
				result = result + "\n"
			elif escaped == 116
				result = result + "\t"
			elif escaped == 114
				result = result + "\r"
			elif escaped == 92
				result = result + "\\"
			elif escaped == 34
				result = result + "\""
			elif escaped == 39
				result = result + "'"
			elif escaped == 48
				result = result + "\0"
			else
				return MirLowerString("", "unsupported MIR string escape")
		else
			result = result + text.slice(i, i + 1)
		i += 1
	return MirLowerString(result, "")

def mir_lower_expression(state: MirBuilder, context: MirLowerContext, id: i64) -> MirLowerExpr
	state.error == "" else return MirLowerExpr(state, -1)
	let node = context.tree.nodes[!id]
	let text = hir_ast_text(context.tree, id)
	var next = state
	if node.kind == NODE_NAME
		if mir_lower_type(context, id, HIR_NAME) == TYPE_TAG_INVALID
			return MirLowerExpr(mir_lower_error(state, "missing typed name"), -1)
		let register = mir_lower_binding(state, text)
		if register < 0
			for constant in context.constants
				if constant.name == text
					let dst = len(next.register_types)
					next = mir_lower_register(next, TYPE_TAG_I64)
					next = mir_lower_emit(next, mir_op(MIR_CONST_I64, dst, -1, -1, constant.value))
					return MirLowerExpr(next, dst)
			return MirLowerExpr(mir_lower_error(state, "unknown MIR binding '" + text + "'"), -1)
		return MirLowerExpr(state, register)
	if node.kind == NODE_ARRAY
		let type_id = mir_lower_type(context, id, HIR_ARRAY)
		if not mir_type_supported(context.types, type_id) or context.types.entries[!type_id].tag != TYPE_TAG_ARRAY
			return MirLowerExpr(mir_lower_error(next, "missing typed MIR array"), -1)
		var inputs = Array[i64]()
		for i in 0..node.count
			let element = mir_lower_expression(next, context, hir_ast_child(context.tree, id, i))
			next = element.state
			next.error == "" else return MirLowerExpr(next, -1)
			inputs = inputs.append(element.slot)
		let dst = len(next.register_types)
		next = mir_lower_register(next, type_id)
		next = mir_lower_emit(next, mir_array_new(dst, inputs))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_OPTIONAL_INDEX or node.kind == NODE_CHECKED_INDEX
		let owner = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 0))
		next = owner.state
		next.error == "" else return MirLowerExpr(next, -1)
		let index = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
		next = index.state
		next.error == "" else return MirLowerExpr(next, -1)
		let type_id = mir_lower_type(context, id, HIR_INDEX)
		if not mir_type_supported(context.types, type_id) or next.register_types[!index.slot] != TYPE_TAG_I64
			return MirLowerExpr(mir_lower_error(next, "unsupported MIR index expression"), -1)
		let dst = len(next.register_types)
		next = mir_lower_register(next, type_id)
		if node.kind == NODE_OPTIONAL_INDEX
			next = mir_lower_emit(next, mir_array_get_optional(dst, owner.slot, index.slot))
		else
			next = mir_lower_emit(next, mir_array_get(dst, owner.slot, index.slot))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_UNWRAP
		let wrapped = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 0))
		next = wrapped.state
		next.error == "" else return MirLowerExpr(next, -1)
		let type_id = mir_lower_type(context, id, HIR_UNWRAP)
		if not mir_type_supported(context.types, type_id)
			return MirLowerExpr(mir_lower_error(next, "missing typed optional unwrap"), -1)
		let dst = len(next.register_types)
		next = mir_lower_register(next, type_id)
		next = mir_lower_emit(next, mir_optional_unwrap(dst, wrapped.slot))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_RECORD
		let type_id = mir_lower_type(context, id, HIR_RECORD)
		if not mir_type_supported(context.types, type_id) or context.types.entries[!type_id].tag != TYPE_TAG_RECORD
			return MirLowerExpr(mir_lower_error(next, "missing typed record"), -1)
		var evaluated = Array[MirLowerField]()
		# Evaluate source fields left to right, then lay them out canonically.
		for i in 0..node.count
			let field = hir_ast_child(context.tree, id, i)
			let field_node = context.tree.nodes[!field]
			if field_node.kind == NODE_SPREAD
				let owner = mir_lower_binding(next, hir_ast_text(context.tree, field))
				if owner < 0
					return MirLowerExpr(mir_lower_error(next, "unknown MIR record spread source"), -1)
				let owner_type = next.register_types[!owner]
				if context.types.entries[!owner_type].tag != TYPE_TAG_RECORD
					return MirLowerExpr(mir_lower_error(next, "MIR spread requires record"), -1)
				let members = context.types.entries[!owner_type].fields
				for j in 0..len(members)
					let slot = len(next.register_types)
					next = mir_lower_register(next, members[!j].kind)
					next = mir_lower_emit(next, mir_record_get(slot, owner, j))
					evaluated = evaluated.append(MirLowerField(members[!j].name, slot))
			elif field_node.kind == NODE_DELETE
				let name = hir_ast_text(context.tree, field)
				var found = false
				for candidate in evaluated
					if candidate.name == name and candidate.slot >= 0
						found = true
				if not found
					return MirLowerExpr(mir_lower_error(next, "unknown MIR record field to delete"), -1)
				evaluated = evaluated.append(MirLowerField(name, -1))
			elif field_node.kind == NODE_FIELD
				let expression = mir_lower_expression(next, context, hir_ast_child(context.tree, field, 0))
				next = expression.state
				next.error == "" else return MirLowerExpr(next, -1)
				evaluated = evaluated.append(MirLowerField(hir_ast_text(context.tree, field), expression.slot))
			else
				return MirLowerExpr(mir_lower_error(next, "invalid MIR record field"), -1)
		let layout = context.types.entries[!type_id].fields
		var inputs = Array[i64]()
		for field in layout
			var source = -1
			for candidate in evaluated
				if candidate.name == field.name
					source = candidate.slot
			if source < 0
				return MirLowerExpr(mir_lower_error(next, "missing canonical MIR record field"), -1)
			inputs = inputs.append(source)
		let dst = len(next.register_types)
		next = mir_lower_register(next, type_id)
		next = mir_lower_emit(next, mir_record_new(dst, inputs))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_ATTR
		let owner = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 0))
		next = owner.state
		next.error == "" else return MirLowerExpr(next, -1)
		let field_type = mir_lower_type(context, id, HIR_FIELD)
		let index = mir_lower_field_index(context, id)
		if index < 0 or not mir_type_supported(context.types, field_type)
			return MirLowerExpr(mir_lower_error(next, "missing typed MIR record field"), -1)
		let dst = len(next.register_types)
		next = mir_lower_register(next, field_type)
		next = mir_lower_emit(next, mir_record_get(dst, owner.slot, index))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_STRING
		if mir_lower_type(context, id, HIR_LITERAL) != TYPE_TAG_STRING
			return MirLowerExpr(mir_lower_error(next, "missing typed string literal"), -1)
		let decoded = mir_lower_string(text)
		if decoded.error != ""
			return MirLowerExpr(mir_lower_error(next, decoded.error), -1)
		let dst = len(next.register_types)
		next = mir_lower_register(next, TYPE_TAG_STRING)
		next = mir_lower_emit(next, mir_string(dst, decoded.value))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_FLOAT
		if mir_lower_type(context, id, HIR_LITERAL) != TYPE_TAG_F64
			return MirLowerExpr(mir_lower_error(next, "missing typed float literal"), -1)
		let dst = len(next.register_types)
		next = mir_lower_register(next, TYPE_TAG_F64)
		next = mir_lower_emit(next, MirInstruction(MIR_CONST_F64, dst, -1, -1, 0, Array[i64](), text))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_INTEGER or node.kind == NODE_BOOL
		let type_id = mir_lower_type(context, id, HIR_LITERAL)
		if type_id == TYPE_TAG_INVALID
			return MirLowerExpr(mir_lower_error(state, "missing typed literal"), -1)
		let dst = len(next.register_types)
		next = mir_lower_register(next, type_id)
		var immediate = 0
		var opcode = MIR_CONST_BOOL
		if type_id == TYPE_TAG_I64
			immediate = mir_lower_literal(text)
			opcode = MIR_CONST_I64
		elif text == "true"
			immediate = 1
		next = mir_lower_emit(next, mir_op(opcode, dst, -1, -1, immediate))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_CALL
		let callee = hir_ast_child(context.tree, id, 0)
		if context.tree.nodes[!callee].kind == NODE_NAME
			let name = hir_ast_text(context.tree, callee)
			for function in context.functions
				if function.name == name and function.constructor
					let type_id = mir_lower_type(context, id, HIR_CALL)
					if not mir_type_supported(context.types, type_id) or context.types.entries[!type_id].tag != TYPE_TAG_RECORD
						return MirLowerExpr(mir_lower_error(next, "constructor requires typed record result: " + name + " at source line " + str(hir_ast_line(context.tree, id))), -1)
					if node.count - 1 != len(function.parameters)
						return MirLowerExpr(mir_lower_error(next, "constructor argument count mismatch"), -1)
					let previous = next.bindings
					for j in 0..len(function.parameters)
						let argument = mir_lower_expression(next, context, hir_ast_child(context.tree, id, j + 1))
						next = argument.state
						next.error == "" else return MirLowerExpr(next, -1)
						next.bindings = next.bindings.append(MirSourceBinding(function.parameters[!j].name, argument.slot, next.depth + 1))
					var evaluated = Array[MirLowerField]()
					let body = context.tree.nodes[!function.body]
					for j in 0..body.count
						let published = hir_ast_child(context.tree, function.body, j)
						let pub = context.tree.nodes[!published]
						if pub.kind != NODE_PUB
							return MirLowerExpr(mir_lower_error(next, "constructor requires direct pub statements"), -1)
						var field_name = hir_ast_text(context.tree, published)
						var slot = -1
						if pub.count == 0
							slot = mir_lower_binding(next, field_name)
						else
							let expression_id = hir_ast_child(context.tree, published, 0)
							if context.tree.nodes[!expression_id].kind == NODE_ATTR
								field_name = hir_ast_text(context.tree, expression_id)
							let expression = mir_lower_expression(next, context, expression_id)
							next = expression.state
							next.error == "" else return MirLowerExpr(next, -1)
							slot = expression.slot
						if slot < 0
							return MirLowerExpr(mir_lower_error(next, "unknown published constructor field"), -1)
						evaluated = evaluated.append(MirLowerField(field_name, slot))
					next.bindings = previous
					var inputs = Array[i64]()
					for field in context.types.entries[!type_id].fields
						var source = -1
						for candidate in evaluated
							if candidate.name == field.name
								source = candidate.slot
						if source < 0
							return MirLowerExpr(mir_lower_error(next, "missing canonical constructor field"), -1)
						inputs = inputs.append(source)
					let dst = len(next.register_types)
					next = mir_lower_register(next, type_id)
					next = mir_lower_emit(next, mir_record_new(dst, inputs))
					return MirLowerExpr(next, dst)
		if context.tree.nodes[!callee].kind == NODE_INDEX and node.count == 1
			let type_id = mir_lower_type(context, id, HIR_CALL)
			if mir_type_supported(context.types, type_id) and context.types.entries[!type_id].tag == TYPE_TAG_ARRAY
				let dst = len(next.register_types)
				next = mir_lower_register(next, type_id)
				next = mir_lower_emit(next, mir_array_new(dst, Array[i64]()))
				return MirLowerExpr(next, dst)
			if mir_type_supported(context.types, type_id) and context.types.entries[!type_id].tag == TYPE_TAG_DICT
				let dst = len(next.register_types)
				next = mir_lower_register(next, type_id)
				next = mir_lower_emit(next, mir_dict_new(dst))
				return MirLowerExpr(next, dst)
		if context.tree.nodes[!callee].kind == NODE_ATTR
			let method = hir_ast_text(context.tree, callee)
			var string_op = 0
			if method == "slice" and node.count == 3
				string_op = MIR_STRING_SLICE
			elif method == "find" and node.count == 2
				string_op = MIR_STRING_FIND
			elif method == "byte_at" and node.count == 2
				string_op = MIR_STRING_BYTE_AT
			elif method == "starts_with" and node.count == 2
				string_op = MIR_STRING_STARTS_WITH
			elif method == "ends_with" and node.count == 2
				string_op = MIR_STRING_ENDS_WITH
			elif method == "join" and node.count == 2
				string_op = MIR_STRING_JOIN
			if string_op != 0
				let type_id = mir_lower_type(context, id, HIR_CALL)
				if mir_type_supported(context.types, type_id)
					let receiver = mir_lower_expression(next, context, hir_ast_child(context.tree, callee, 0))
					next = receiver.state
					next.error == "" else return MirLowerExpr(next, -1)
					if next.register_types[!receiver.slot] == TYPE_TAG_STRING
						var arguments = Array[i64]()
						for i in 1..node.count
							let argument = mir_lower_expression(next, context, hir_ast_child(context.tree, id, i))
							next = argument.state
							next.error == "" else return MirLowerExpr(next, -1)
							arguments = arguments.append(argument.slot)
						let dst = len(next.register_types)
						next = mir_lower_register(next, type_id)
						var extra = 0
						if len(arguments) > 1
							extra = arguments[!1]
						next = mir_lower_emit(next, mir_op(string_op, dst, receiver.slot, arguments[!0], extra))
						return MirLowerExpr(next, dst)
		if context.tree.nodes[!callee].kind == NODE_ATTR and hir_ast_text(context.tree, callee) == "append" and node.count == 2
			let type_id = mir_lower_type(context, id, HIR_CALL)
			if mir_type_supported(context.types, type_id) and context.types.entries[!type_id].tag == TYPE_TAG_ARRAY
				let owner = mir_lower_expression(next, context, hir_ast_child(context.tree, callee, 0))
				next = owner.state
				next.error == "" else return MirLowerExpr(next, -1)
				let value = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
				next = value.state
				next.error == "" else return MirLowerExpr(next, -1)
				let owned = len(next.register_types)
				next = mir_lower_register(next, type_id)
				next = mir_lower_emit(next, mir_op(MIR_COPY, owned, owner.slot, -1, 0))
				let dst = len(next.register_types)
				next = mir_lower_register(next, type_id)
				next = mir_lower_emit(next, mir_array_append(dst, owned, value.slot))
				return MirLowerExpr(next, dst)
		if context.tree.nodes[!callee].kind == NODE_ATTR and hir_ast_text(context.tree, callee) == "get" and node.count == 2
			let type_id = mir_lower_type(context, id, HIR_CALL)
			if mir_type_supported(context.types, type_id) and context.types.entries[!type_id].tag == TYPE_TAG_OPTIONAL
				let owner = mir_lower_expression(next, context, hir_ast_child(context.tree, callee, 0))
				next = owner.state
				next.error == "" else return MirLowerExpr(next, -1)
				if context.types.entries[!next.register_types[!owner.slot]].tag != TYPE_TAG_DICT
					return MirLowerExpr(mir_lower_error(next, "optional get requires Dict"), -1)
				let key = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
				next = key.state
				next.error == "" else return MirLowerExpr(next, -1)
				let dst = len(next.register_types)
				next = mir_lower_register(next, type_id)
				next = mir_lower_emit(next, mir_dict_get_optional(dst, owner.slot, key.slot))
				return MirLowerExpr(next, dst)
		if context.tree.nodes[!callee].kind == NODE_ATTR and hir_ast_text(context.tree, callee) == "insert" and node.count == 3
			let type_id = mir_lower_type(context, id, HIR_CALL)
			if mir_type_supported(context.types, type_id) and context.types.entries[!type_id].tag == TYPE_TAG_DICT
				let owner = mir_lower_expression(next, context, hir_ast_child(context.tree, callee, 0))
				next = owner.state
				next.error == "" else return MirLowerExpr(next, -1)
				let key = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
				next = key.state
				next.error == "" else return MirLowerExpr(next, -1)
				let value = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 2))
				next = value.state
				next.error == "" else return MirLowerExpr(next, -1)
				# Insert consumes its owner in MIR, but source collection calls are nonconsuming.
				let owned = len(next.register_types)
				next = mir_lower_register(next, type_id)
				next = mir_lower_emit(next, mir_op(MIR_COPY, owned, owner.slot, -1, 0))
				let dst = len(next.register_types)
				next = mir_lower_register(next, type_id)
				next = mir_lower_emit(next, mir_dict_insert(dst, owned, key.slot, value.slot))
				return MirLowerExpr(next, dst)
		if context.tree.nodes[!callee].kind == NODE_NAME and hir_ast_text(context.tree, callee) == "sqrt" and node.count == 2
			let operand = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
			next = operand.state
			next.error == "" else return MirLowerExpr(next, -1)
			if next.register_types[!operand.slot] != TYPE_TAG_F64 or mir_lower_type(context, id, HIR_CALL) != TYPE_TAG_F64
				return MirLowerExpr(mir_lower_error(next, "sqrt requires f64"), -1)
			let dst = len(next.register_types)
			next = mir_lower_register(next, TYPE_TAG_F64)
			next = mir_lower_emit(next, mir_op(MIR_SQRT_F64, dst, operand.slot, -1, 0))
			return MirLowerExpr(next, dst)
		if context.tree.nodes[!callee].kind == NODE_NAME
			let builtin = hir_ast_text(context.tree, callee)
			var op = 0
			if builtin == "arguments" and node.count == 1
				op = MIR_ARGUMENTS
			elif builtin == "read_text" and node.count == 2
				op = MIR_READ_TEXT
			elif builtin == "write_text" and node.count == 3
				op = MIR_WRITE_TEXT
			elif builtin == "str" and node.count == 2
				op = MIR_STR_I64
			if op != 0
				let type_id = mir_lower_type(context, id, HIR_CALL)
				if not mir_type_supported(context.types, type_id)
					return MirLowerExpr(mir_lower_error(next, "missing typed builtin call"), -1)
				var inputs = Array[i64]()
				for i in 1..node.count
					let argument = mir_lower_expression(next, context, hir_ast_child(context.tree, id, i))
					next = argument.state
					next.error == "" else return MirLowerExpr(next, -1)
					inputs = inputs.append(argument.slot)
				var first = -1
				var second = -1
				if len(inputs) > 0
					first = inputs[!0]
				if len(inputs) > 1
					second = inputs[!1]
				let dst = len(next.register_types)
				next = mir_lower_register(next, type_id)
				next = mir_lower_emit(next, mir_op(op, dst, first, second, 0))
				return MirLowerExpr(next, dst)
		if context.tree.nodes[!callee].kind == NODE_NAME and hir_ast_text(context.tree, callee) == "len" and node.count == 2
			let value = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
			next = value.state
			next.error == "" else return MirLowerExpr(next, -1)
			if mir_lower_type(context, id, HIR_CALL) == TYPE_TAG_I64
				let kind = next.register_types[!value.slot]
				var op = 0
				if kind == TYPE_TAG_STRING
					op = MIR_STRING_LENGTH
				elif context.types.entries[!kind].tag == TYPE_TAG_ARRAY
					op = MIR_ARRAY_LENGTH
				elif context.types.entries[!kind].tag == TYPE_TAG_DICT
					op = MIR_DICT_LENGTH
				if op != 0
					let dst = len(next.register_types)
					next = mir_lower_register(next, TYPE_TAG_I64)
					next = mir_lower_emit(next, mir_op(op, dst, value.slot, -1, 0))
					return MirLowerExpr(next, dst)
		var callee_id = -1
		for target in context.call_targets
			if target.source == id
				callee_id = target.specialization
		if callee_id < 0
			return MirLowerExpr(mir_lower_error(next, "unsupported MIR call target: " + hir_ast_text(context.tree, callee)), -1)
		let type_id = mir_lower_type(context, id, HIR_CALL)
		if not mir_type_supported(context.types, type_id)
			return MirLowerExpr(mir_lower_error(next, "unsupported MIR call result type"), -1)
		var inputs = Array[i64]()
		for i in 1..node.count
			let argument = mir_lower_expression(next, context, hir_ast_child(context.tree, id, i))
			next = argument.state
			next.error == "" else return MirLowerExpr(next, -1)
			inputs = inputs.append(argument.slot)
		let dst = len(next.register_types)
		next = mir_lower_register(next, type_id)
		next = mir_lower_emit(next, mir_call(dst, callee_id, inputs))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_UNARY
		let operand = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 0))
		next = operand.state
		next.error == "" else return MirLowerExpr(next, -1)
		let type_id = mir_lower_type(context, id, HIR_UNARY)
		let dst = len(next.register_types)
		var opcode = MIR_NEG_I64
		if type_id == TYPE_TAG_F64
			opcode = MIR_NEG_F64
		if text == "not"
			opcode = MIR_NOT_BOOL
		elif text == "+"
			return MirLowerExpr(next, operand.slot)
		elif text != "-"
			return MirLowerExpr(mir_lower_error(next, "unsupported unary MIR operator"), -1)
		if not mir_supported_type(type_id)
			return MirLowerExpr(mir_lower_error(next, "unsupported unary MIR type"), -1)
		next = mir_lower_register(next, type_id)
		next = mir_lower_emit(next, mir_op(opcode, dst, operand.slot, -1, 0))
		return MirLowerExpr(next, dst)
	if node.kind == NODE_BINARY
		let left = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 0))
		next = left.state
		next.error == "" else return MirLowerExpr(next, -1)
		let type_id = mir_lower_type(context, id, HIR_BINARY)
		if text == "or" and context.types.entries[!next.register_types[!left.slot]].tag == TYPE_TAG_OPTIONAL
			if not mir_type_supported(context.types, type_id)
				return MirLowerExpr(mir_lower_error(next, "unsupported optional fallback type"), -1)
			let result = len(next.register_types)
			next = mir_lower_register(next, type_id)
			let present = len(next.register_types)
			next = mir_lower_register(next, TYPE_TAG_BOOL)
			next = mir_lower_emit(next, mir_optional_has(present, left.slot))
			let condition = next.active
			next = mir_lower_block(next)
			let has_value = next.active
			next = mir_lower_block(next)
			let missing = next.active
			next = mir_lower_block(next)
			let done = next.active
			next.active = condition
			next = mir_lower_end(next, mir_branch(present, has_value, missing))
			next.active = has_value
			let unwrapped = len(next.register_types)
			next = mir_lower_register(next, type_id)
			next = mir_lower_emit(next, mir_optional_unwrap(unwrapped, left.slot))
			next = mir_lower_emit(next, mir_op(MIR_COPY, result, unwrapped, -1, 0))
			next = mir_lower_end(next, mir_jump(done))
			next.active = missing
			let fallback = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
			next = fallback.state
			next.error == "" else return MirLowerExpr(next, -1)
			next = mir_lower_emit(next, mir_op(MIR_COPY, result, fallback.slot, -1, 0))
			next = mir_lower_end(next, mir_jump(done))
			next.active = done
			return MirLowerExpr(next, result)
		if not mir_supported_type(type_id)
			return MirLowerExpr(mir_lower_error(next, "unsupported binary MIR type"), -1)
		if text == "and" or text == "or"
			let dst = len(next.register_types)
			next = mir_lower_register(next, TYPE_TAG_BOOL)
			next = mir_lower_emit(next, mir_op(MIR_COPY, dst, left.slot, -1, 0))
			let condition_block = next.active
			next = mir_lower_block(next)
			let evaluate = next.active
			next = mir_lower_block(next)
			let done = next.active
			# The condition is evaluated in the block preceding both successors.
			next.active = condition_block
			if text == "and"
				next = mir_lower_end(next, mir_branch(left.slot, evaluate, done))
			else
				next = mir_lower_end(next, mir_branch(left.slot, done, evaluate))
			next.active = evaluate
			let right = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
			next = right.state
			next.error == "" else return MirLowerExpr(next, -1)
			next = mir_lower_emit(next, mir_op(MIR_COPY, dst, right.slot, -1, 0))
			next = mir_lower_end(next, mir_jump(done))
			next.active = done
			return MirLowerExpr(next, dst)
		let right = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
		next = right.state
		next.error == "" else return MirLowerExpr(next, -1)
		var opcode = 0
		let first = left.slot
		let second = right.slot
		var negate = false
		if text == "+"
			if type_id == TYPE_TAG_STRING
				opcode = MIR_STRING_CONCAT
			elif type_id == TYPE_TAG_F64
				opcode = MIR_ADD_F64
			else
				opcode = MIR_ADD_I64
		elif text == "-"
			if type_id == TYPE_TAG_F64
				opcode = MIR_SUB_F64
			else
				opcode = MIR_SUB_I64
		elif text == "*"
			if type_id == TYPE_TAG_F64
				opcode = MIR_MUL_F64
			else
				opcode = MIR_MUL_I64
		elif text == "/"
			if type_id == TYPE_TAG_F64
				opcode = MIR_DIV_F64
			else
				opcode = MIR_DIV_I64
		elif text == "%"
			opcode = MIR_REM_I64
		elif text == "==" or text == "!="
			opcode = MIR_EQ_I64
			if next.register_types[!first] == TYPE_TAG_F64
				opcode = MIR_EQ_F64
			elif next.register_types[!first] == TYPE_TAG_BOOL
				opcode = MIR_EQ_BOOL
			elif next.register_types[!first] == TYPE_TAG_STRING
				opcode = MIR_EQ_STRING
			negate = text == "!="
		elif text == "<" or text == ">="
			opcode = MIR_LT_I64
			if next.register_types[!first] == TYPE_TAG_F64
				opcode = MIR_LT_F64
			elif next.register_types[!first] == TYPE_TAG_STRING
				opcode = MIR_LT_STRING
			negate = text == ">="
		elif text == "<=" or text == ">"
			opcode = MIR_LE_I64
			if next.register_types[!first] == TYPE_TAG_F64
				opcode = MIR_LE_F64
			elif next.register_types[!first] == TYPE_TAG_STRING
				opcode = MIR_LE_STRING
			negate = text == ">"
		if opcode == 0
			return MirLowerExpr(mir_lower_error(next, "unsupported binary MIR operator"), -1)
		let dst = len(next.register_types)
		next = mir_lower_register(next, type_id)
		next = mir_lower_emit(next, mir_op(opcode, dst, first, second, 0))
		if negate
			let inverted = len(next.register_types)
			next = mir_lower_register(next, TYPE_TAG_BOOL)
			next = mir_lower_emit(next, mir_op(MIR_NOT_BOOL, inverted, dst, -1, 0))
			return MirLowerExpr(next, inverted)
		return MirLowerExpr(next, dst)
	return MirLowerExpr(mir_lower_error(next, "unsupported source expression for MIR"), -1)

def mir_lower_statements(state: MirBuilder, context: MirLowerContext, block_id: i64) -> MirBuilder
	var next = state
	let initial = len(state.bindings)
	next.depth += 1
	let block = context.tree.nodes[!block_id]
	for i in 0..block.count
		if mir_lower_ended(next)
			break
		next = mir_lower_statement(next, context, hir_ast_child(context.tree, block_id, i))
		next.error == "" else return next
	var kept = Array[MirSourceBinding]()
	for i in 0..initial
		kept = kept.append(next.bindings[!i])
	next.bindings = kept
	next.depth -= 1
	return next

def mir_lower_statement(state: MirBuilder, context: MirLowerContext, id: i64) -> MirBuilder
	state.error == "" else return state
	let node = context.tree.nodes[!id]
	var next = state
	if node.kind == NODE_RECUR
		if node.count != 1
			return mir_lower_error(next, "recur expects a direct self-call")
		let call = hir_ast_child(context.tree, id, 0)
		let invocation = context.tree.nodes[!call]
		if invocation.kind != NODE_CALL
			return mir_lower_error(next, "recur expects a direct self-call")
		let callee = hir_ast_child(context.tree, call, 0)
		if context.tree.nodes[!callee].kind != NODE_NAME or hir_ast_text(context.tree, callee) != context.function_name
			return mir_lower_error(next, "recur must call the enclosing function")
		if invocation.count - 1 != context.argument_count
			return mir_lower_error(next, "recur argument count mismatch")
		# Evaluate and snapshot every argument before changing parameter registers.
		var arguments = Array[i64]()
		for i in 0..context.argument_count
			let argument = mir_lower_expression(next, context, hir_ast_child(context.tree, call, i + 1))
			next = argument.state
			next.error == "" else return next
			if next.register_types[!argument.slot] != next.register_types[!i]
				return mir_lower_error(next, "recur argument type mismatch")
			let snapshot = len(next.register_types)
			next = mir_lower_register(next, next.register_types[!i])
			next = mir_lower_emit(next, mir_op(MIR_COPY, snapshot, argument.slot, -1, 0))
			arguments = arguments.append(snapshot)
		for i in 0..context.argument_count
			next = mir_lower_emit(next, mir_op(MIR_COPY, i, arguments[!i], -1, 0))
		return mir_lower_end(next, mir_jump(0))
	if node.kind == NODE_BREAK or node.kind == NODE_CONTINUE
		var target = -1
		if node.kind == NODE_BREAK and len(next.break_targets) > 0
			target = next.break_targets[!len(next.break_targets) - 1]
		elif node.kind == NODE_CONTINUE and len(next.continue_targets) > 0
			target = next.continue_targets[!len(next.continue_targets) - 1]
		if target < 0
			return mir_lower_error(next, "loop control outside loop")
		return mir_lower_end(next, mir_jump(target))
	if node.kind == NODE_EXPR
		let expression_id = hir_ast_child(context.tree, id, 0)
		let expression_node = context.tree.nodes[!expression_id]
		if expression_node.kind == NODE_CALL and expression_node.count == 2
			let callee = hir_ast_child(context.tree, expression_id, 0)
			if context.tree.nodes[!callee].kind == NODE_NAME and hir_ast_text(context.tree, callee) == "print"
				let argument = mir_lower_expression(next, context, hir_ast_child(context.tree, expression_id, 1))
				next = argument.state
				next.error == "" else return next
				return mir_lower_emit(next, mir_op(MIR_PRINT, -1, argument.slot, -1, 0))
		let expression = mir_lower_expression(next, context, expression_id)
		return expression.state
	if node.kind == NODE_LET or node.kind == NODE_VAR
		var initializer = -1
		var fallback = -1
		for i in 0..node.count
			let child = hir_ast_child(context.tree, id, i)
			if context.tree.nodes[!child].kind == NODE_ELSE_RETURN
				fallback = hir_ast_child(context.tree, child, 0)
			elif context.tree.nodes[!child].kind != NODE_TYPE
				initializer = child
		if initializer < 0
			return mir_lower_error(next, "MIR requires an initializer")
		let value = mir_lower_expression(next, context, initializer)
		next = value.state
		next.error == "" else return next
		var value_slot = value.slot
		if fallback >= 0
			let wrapped_type = next.register_types[!value.slot]
			if context.types.entries[!wrapped_type].tag != TYPE_TAG_OPTIONAL
				return mir_lower_error(next, "else return requires Optional")
			let present = len(next.register_types)
			next = mir_lower_register(next, TYPE_TAG_BOOL)
			next = mir_lower_emit(next, mir_optional_has(present, value.slot))
			let condition = next.active
			next = mir_lower_block(next)
			let has_value = next.active
			next = mir_lower_block(next)
			let missing = next.active
			next.active = condition
			next = mir_lower_end(next, mir_branch(present, has_value, missing))
			next.active = missing
			let returned = mir_lower_expression(next, context, fallback)
			next = returned.state
			next.error == "" else return next
			next = mir_lower_end(next, mir_return(returned.slot))
			next.active = has_value
			let unwrapped = len(next.register_types)
			next = mir_lower_register(next, context.types.entries[!wrapped_type].first)
			next = mir_lower_emit(next, mir_optional_unwrap(unwrapped, value.slot))
			value_slot = unwrapped
		let type_id = mir_lower_type(context, id, HIR_BINDING)
		if not mir_type_supported(context.types, type_id)
			return mir_lower_error(next, "unsupported MIR binding type")
		let register = len(next.register_types)
		next = mir_lower_register(next, type_id)
		next = mir_lower_emit(next, mir_op(MIR_COPY, register, value_slot, -1, 0))
		next.bindings = next.bindings.append(MirSourceBinding(hir_ast_text(context.tree, id), register, next.depth))
		return next
	if node.kind == NODE_ASSIGN
		let target = hir_ast_child(context.tree, id, 0)
		if context.tree.nodes[!target].kind == NODE_CHECKED_INDEX
			if hir_ast_text(context.tree, id) != "="
				return mir_lower_error(next, "unsupported MIR indexed assignment")
			let owner = hir_ast_child(context.tree, target, 0)
			if context.tree.nodes[!owner].kind == NODE_ATTR
				let base = hir_ast_child(context.tree, owner, 0)
				if context.tree.nodes[!base].kind != NODE_NAME
					return mir_lower_error(next, "nested MIR indexed update is not supported yet")
				let root = mir_lower_binding(next, hir_ast_text(context.tree, base))
				if root < 0
					return mir_lower_error(next, "unknown MIR indexed record")
				let record_type = next.register_types[!root]
				if context.types.entries[!record_type].tag != TYPE_TAG_RECORD
					return mir_lower_error(next, "MIR indexed update requires a record")
				let field = resolve_hir_field(context.types, record_type, hir_ast_text(context.tree, owner))
				if field.error != "" or context.types.entries[!field.type_id].tag != TYPE_TAG_ARRAY
					return mir_lower_error(next, "MIR indexed field must be an array")
				let array = mir_lower_expression(next, context, owner)
				next = array.state
				next.error == "" else return next
				let index = mir_lower_expression(next, context, hir_ast_child(context.tree, target, 1))
				next = index.state
				next.error == "" else return next
				let value = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
				next = value.state
				next.error == "" else return next
				next = mir_lower_emit(next, mir_array_set(array.slot, array.slot, index.slot, value.slot))
				return mir_lower_record_update(next, context, root, field.field_index, array.slot)
			if context.tree.nodes[!owner].kind != NODE_NAME
				return mir_lower_error(next, "MIR indexed update requires a local array")
			let register = mir_lower_binding(next, hir_ast_text(context.tree, owner))
			if register < 0 or context.types.entries[!next.register_types[!register]].tag != TYPE_TAG_ARRAY
				return mir_lower_error(next, "MIR indexed update requires an array")
			let index = mir_lower_expression(next, context, hir_ast_child(context.tree, target, 1))
			next = index.state
			next.error == "" else return next
			let value = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
			next = value.state
			next.error == "" else return next
			return mir_lower_emit(next, mir_array_set(register, register, index.slot, value.slot))
		if context.tree.nodes[!target].kind == NODE_ATTR
			let owner = hir_ast_child(context.tree, target, 0)
			if context.tree.nodes[!owner].kind != NODE_NAME
				return mir_lower_error(next, "nested MIR record updates are not supported yet")
			let root = mir_lower_binding(next, hir_ast_text(context.tree, owner))
			if root < 0
				return mir_lower_error(next, "unknown MIR record assignment target")
			let record_type = next.register_types[!root]
			if context.types.entries[!record_type].tag != TYPE_TAG_RECORD
				return mir_lower_error(next, "MIR field update requires a record")
			let field = resolve_hir_field(context.types, record_type, hir_ast_text(context.tree, target))
			if field.error != ""
				return mir_lower_error(next, field.error)
			# Direct self-field append: no intermediate array reference should
			# force cloning the array just before replacing the field.
			let rhs = hir_ast_child(context.tree, id, 1)
			if hir_ast_text(context.tree, id) == "=" and context.tree.nodes[!rhs].kind == NODE_CALL and context.tree.nodes[!rhs].count == 2 and context.types.entries[!field.type_id].tag == TYPE_TAG_ARRAY
				let callee = hir_ast_child(context.tree, rhs, 0)
				if context.tree.nodes[!callee].kind == NODE_ATTR and hir_ast_text(context.tree, callee) == "append"
					let receiver = hir_ast_child(context.tree, callee, 0)
					if context.tree.nodes[!receiver].kind == NODE_ATTR and hir_ast_text(context.tree, receiver) == hir_ast_text(context.tree, target)
						let base = hir_ast_child(context.tree, receiver, 0)
						if context.tree.nodes[!base].kind == NODE_NAME and hir_ast_text(context.tree, base) == hir_ast_text(context.tree, owner)
							let item = mir_lower_expression(next, context, hir_ast_child(context.tree, rhs, 1))
							next = item.state
							next.error == "" else return next
							if next.register_types[!item.slot] == context.types.entries[!field.type_id].first
								return mir_lower_emit(next, mir_record_array_append(root, root, field.field_index, item.slot))
			let value = mir_lower_expression(next, context, rhs)
			next = value.state
			next.error == "" else return next
			if next.register_types[!value.slot] != field.type_id
				return mir_lower_error(next, "expected " + hir_type_name(context.types, field.type_id) + ", found " + hir_type_name(context.types, next.register_types[!value.slot]))
			var updated_slot = value.slot
			let operator = hir_ast_text(context.tree, id)
			if operator != "="
				let previous = len(next.register_types)
				next = mir_lower_register(next, field.type_id)
				next = mir_lower_emit(next, mir_record_get(previous, root, field.field_index))
				let updated = mir_lower_augmented(next, operator, previous, value.slot)
				next = updated.state
				next.error == "" else return next
				updated_slot = updated.slot
			return mir_lower_record_update(next, context, root, field.field_index, updated_slot)
		if context.tree.nodes[!target].kind != NODE_NAME
			return mir_lower_error(next, "unsupported MIR assignment target")
		let register = mir_lower_binding(next, hir_ast_text(context.tree, target))
		if register < 0
			return mir_lower_error(next, "unknown MIR assignment target")
		let value = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 1))
		next = value.state
		next.error == "" else return next
		let operator = hir_ast_text(context.tree, id)
		if operator == "="
			return mir_lower_emit(next, mir_op(MIR_COPY, register, value.slot, -1, 0))
		let updated = mir_lower_augmented(next, operator, register, value.slot)
		next = updated.state
		next.error == "" else return next
		return mir_lower_emit(next, mir_op(MIR_COPY, register, updated.slot, -1, 0))

	if node.kind == NODE_GUARD
		let condition = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 0))
		next = condition.state
		next.error == "" else return next
		if next.register_types[!condition.slot] != TYPE_TAG_BOOL
			return mir_lower_error(next, "MIR guard requires bool")
		let decision = next.active
		next = mir_lower_block(next)
		let proceed = next.active
		next = mir_lower_block(next)
		let failed = next.active
		next.active = decision
		next = mir_lower_end(next, mir_branch(condition.slot, proceed, failed))
		next.active = failed
		next = mir_lower_statement(next, context, hir_ast_child(context.tree, id, 1))
		next.error == "" else return next
		if not mir_lower_ended(next)
			return mir_lower_error(next, "guard fallback must terminate")
		next.active = proceed
		return next
	if node.kind == NODE_RETURN
		if node.count != 1
			return mir_lower_error(next, "MIR requires a return value")
		let value = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 0))
		next = value.state
		next.error == "" else return next
		return mir_lower_end(next, mir_return(value.slot))
	if node.kind == NODE_IF
		var after = -1
		var can_fallthrough = false
		var has_else = false
		for i in 0..node.count
			let arm_id = hir_ast_child(context.tree, id, i)
			let arm = context.tree.nodes[!arm_id]
			if arm.kind == NODE_ELSE
				has_else = true
				next = mir_lower_statements(next, context, hir_ast_child(context.tree, arm_id, 0))
			else
				let cond = mir_lower_expression(next, context, hir_ast_child(context.tree, arm_id, 0))
				next = cond.state
				next.error == "" else return next
				let cond_block = next.active
				next = mir_lower_block(next)
				let yes = next.active
				next = mir_lower_block(next)
				let no = next.active
				next.active = cond_block
				next = mir_lower_end(next, mir_branch(cond.slot, yes, no))
				next.active = yes
				next = mir_lower_statements(next, context, hir_ast_child(context.tree, arm_id, 1))
				let body_end = next.active
				if after < 0
					next = mir_lower_block(next)
					after = next.active
				next.active = body_end
				if not mir_lower_ended(next)
					can_fallthrough = true
					next = mir_lower_end(next, mir_jump(after))
				next.active = no
			if i == node.count - 1 and after >= 0 and not mir_lower_ended(next)
				can_fallthrough = true
				next = mir_lower_end(next, mir_jump(after))
		if after >= 0
			next.active = after
			if not can_fallthrough and has_else
				next = mir_lower_end(next, mir_panic("unreachable"))
		return next
	if node.kind == NODE_FOR
		let iterable_id = hir_ast_child(context.tree, id, node.count - 2)
		let body_id = hir_ast_child(context.tree, id, node.count - 1)
		let iterable_node = context.tree.nodes[!iterable_id]
		var is_range = iterable_node.kind == NODE_BINARY and hir_ast_text(context.tree, iterable_id) == ".."
		var begin_slot = -1
		var end_slot = -1
		var array_slot = -1
		var item_type = TYPE_TAG_I64
		if is_range
			let begin_value = mir_lower_expression(next, context, hir_ast_child(context.tree, iterable_id, 0))
			next = begin_value.state
			next.error == "" else return next
			let end_value = mir_lower_expression(next, context, hir_ast_child(context.tree, iterable_id, 1))
			next = end_value.state
			next.error == "" else return next
			begin_slot = begin_value.slot
			end_slot = end_value.slot
		else
			let array = mir_lower_expression(next, context, iterable_id)
			next = array.state
			next.error == "" else return next
			array_slot = array.slot
			let array_type = next.register_types[!array_slot]
			if context.types.entries[!array_type].tag != TYPE_TAG_ARRAY
				return mir_lower_error(next, "MIR for requires range or array")
			item_type = context.types.entries[!array_type].first
			let empty = len(next.register_types)
			next = mir_lower_register(next, TYPE_TAG_I64)
			next = mir_lower_emit(next, mir_op(MIR_CONST_I64, empty, -1, -1, 0))
			begin_slot = empty
			let size = len(next.register_types)
			next = mir_lower_register(next, TYPE_TAG_I64)
			next = mir_lower_emit(next, mir_op(MIR_ARRAY_LENGTH, size, array_slot, -1, 0))
			end_slot = size
		let index = len(next.register_types)
		next = mir_lower_register(next, TYPE_TAG_I64)
		next = mir_lower_emit(next, mir_op(MIR_COPY, index, begin_slot, -1, 0))
		let one = len(next.register_types)
		next = mir_lower_register(next, TYPE_TAG_I64)
		next = mir_lower_emit(next, mir_op(MIR_CONST_I64, one, -1, -1, 1))
		let previous = next.active
		next = mir_lower_block(next)
		let condition = next.active
		next.active = previous
		next = mir_lower_end(next, mir_jump(condition))
		next.active = condition
		let has_item = len(next.register_types)
		next = mir_lower_register(next, TYPE_TAG_BOOL)
		next = mir_lower_emit(next, mir_op(MIR_LT_I64, has_item, index, end_slot, 0))
		next = mir_lower_block(next)
		let body_block = next.active
		next = mir_lower_block(next)
		let step_block = next.active
		next = mir_lower_block(next)
		let exit_block = next.active
		next.active = condition
		next = mir_lower_end(next, mir_branch(has_item, body_block, exit_block))
		next.active = body_block
		let item = len(next.register_types)
		next = mir_lower_register(next, item_type)
		if is_range
			next = mir_lower_emit(next, mir_op(MIR_COPY, item, index, -1, 0))
		else
			next = mir_lower_emit(next, mir_array_get(item, array_slot, index))
		let initial = len(next.bindings)
		next.bindings = next.bindings.append(MirSourceBinding(hir_ast_text(context.tree, id), item, next.depth + 1))
		next.break_targets = next.break_targets.append(exit_block)
		next.continue_targets = next.continue_targets.append(step_block)
		next = mir_lower_statements(next, context, body_id)
		next.error == "" else return next
		var saved = Array[MirSourceBinding]()
		for j in 0..initial
			saved = saved.append(next.bindings[!j])
		next.bindings = saved
		var previous_breaks = Array[i64]()
		var previous_continues = Array[i64]()
		for j in 0..len(next.break_targets) - 1
			previous_breaks = previous_breaks.append(next.break_targets[!j])
			previous_continues = previous_continues.append(next.continue_targets[!j])
		next.break_targets = previous_breaks
		next.continue_targets = previous_continues
		if not mir_lower_ended(next)
			next = mir_lower_end(next, mir_jump(step_block))
		next.active = step_block
		let incremented = len(next.register_types)
		next = mir_lower_register(next, TYPE_TAG_I64)
		next = mir_lower_emit(next, mir_op(MIR_ADD_I64, incremented, index, one, 0))
		next = mir_lower_emit(next, mir_op(MIR_COPY, index, incremented, -1, 0))
		next = mir_lower_end(next, mir_jump(condition))
		next.active = exit_block
		return next
	if node.kind == NODE_WHILE
		let previous = next.active
		next = mir_lower_block(next)
		let condition_block = next.active
		next.active = previous
		next = mir_lower_end(next, mir_jump(condition_block))
		next.active = condition_block
		let cond = mir_lower_expression(next, context, hir_ast_child(context.tree, id, 0))
		next = cond.state
		next.error == "" else return next
		let decision_block = next.active
		next = mir_lower_block(next)
		let body_block = next.active
		next = mir_lower_block(next)
		let exit_block = next.active
		next.active = decision_block
		next = mir_lower_end(next, mir_branch(cond.slot, body_block, exit_block))
		next.active = body_block
		next.break_targets = next.break_targets.append(exit_block)
		next.continue_targets = next.continue_targets.append(condition_block)
		next = mir_lower_statements(next, context, hir_ast_child(context.tree, id, 1))
		next.error == "" else return next
		var previous_breaks = Array[i64]()
		var previous_continues = Array[i64]()
		for j in 0..len(next.break_targets) - 1
			previous_breaks = previous_breaks.append(next.break_targets[!j])
			previous_continues = previous_continues.append(next.continue_targets[!j])
		next.break_targets = previous_breaks
		next.continue_targets = previous_continues
		if not mir_lower_ended(next)
			next = mir_lower_end(next, mir_jump(condition_block))
		next.active = exit_block
		return next
	return mir_lower_error(next, "unsupported source statement for MIR: " + node_kind_name(node.kind))

def mir_lower_function_module(tree: ParseState, header: HirFunctionDecl, hir: Array[HirNode], arguments: Array[i64], return_type: i64, targets: Array[MirCallTarget], types: TypeTable, functions: Array[HirFunctionDecl], constants: Array[HirModuleConstant]) -> MirLowerResult
	let context = MirLowerContext(tree, hir, hir_annotation_index(hir, len(tree.nodes)), types, functions, constants, targets, header.name, len(arguments))
	var state = MirBuilder(0)
	state = mir_lower_block(state)
	if not mir_type_supported(context.types, return_type) or len(arguments) != len(header.parameters)
		return MirLowerResult(MirFunction(0, return_type, state.register_types, state.blocks, 0), "unsupported MIR function signature")
	for i in 0..len(arguments)
		if not mir_type_supported(context.types, arguments[!i])
			return MirLowerResult(MirFunction(0, return_type, state.register_types, state.blocks, 0), "unsupported MIR parameter type")
		state = mir_lower_register(state, arguments[!i])
		state.bindings = state.bindings.append(MirSourceBinding(header.parameters[!i].name, i, 0))
	state = mir_lower_statements(state, context, header.body)
	if state.error == "" and not mir_lower_ended(state)
		state = mir_lower_error(state, "missing MIR return")
	return MirLowerResult(MirFunction(len(arguments), return_type, state.register_types, state.blocks, 0), state.error)

def mir_lower_function_typed(tree: ParseState, header: HirFunctionDecl, hir: Array[HirNode], arguments: Array[i64], return_type: i64, targets: Array[MirCallTarget], types: TypeTable) -> MirLowerResult
	return mir_lower_function_module(tree, header, hir, arguments, return_type, targets, types, Array[HirFunctionDecl](), Array[HirModuleConstant]())

# Compatibility wrapper for scalar standalone lowering tests.
def mir_lower_function_calls(tree: ParseState, header: HirFunctionDecl, hir: Array[HirNode], arguments: Array[i64], return_type: i64, targets: Array[MirCallTarget]) -> MirLowerResult
	return mir_lower_function_typed(tree, header, hir, arguments, return_type, targets, new_type_table())

# Retain the simple single-function entry point for existing tests.
def mir_lower_function(tree: ParseState, header: HirFunctionDecl, hir: Array[HirNode], arguments: Array[i64], return_type: i64) -> MirLowerResult
	return mir_lower_function_calls(tree, header, hir, arguments, return_type, Array[MirCallTarget]())
