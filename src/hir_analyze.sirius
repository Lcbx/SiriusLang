import types alias Types
import parser alias Ast
import hir alias Hir
import hir_resolve alias Resolve

# Independent, pre-emission body analysis. Unresolved types are explicitly
# deferred rather than guessed: specialization and collection typing still
# belong to the legacy emitter during this migration.
export let HIR_BINDING = 9
export let HIR_ASSIGN = 10
export let HIR_ARRAY = 11
export let HIR_INDEX = 12
export let HIR_UNWRAP = 13

# Specialization requests are discovered while analyzing a concrete function.
# source is the call AST node; definition is the callee's declaration body ID.
export rec HirSpecializationRequest(source: i64, definition: i64, arguments: Array[i64])

# Inclusive nonnegative range of an immutable i64 expression; -1 means unknown.
export rec HirIndexRange(low: i64, high: i64)
export rec HirStaticFact(array_literal: i64, index_range: HirIndexRange, array_shape: Array[i64])

def hir_unknown_range() -> HirIndexRange
	return HirIndexRange(-1, -1)

export rec HirBodyState(tree: Ast.ParseState, names: Array[string], constants: Array[string], types: Types.TypeTable, symbols: Array[Hir.SymbolInfo], nodes: Array[Hir.HirNode], depth: i64, last_type: i64, error: string, error_line: i64, functions: Array[Hir.HirFunctionDecl], active_functions: Array[string], inferred_return: i64, collect_calls: bool, requests: Array[HirSpecializationRequest], module_constants: Array[Hir.HirModuleConstant], facts: Array[HirStaticFact], type_aliases: Array[Hir.HirTypeAlias], expected_return: i64)

export def new_hir_body_state(tree: Ast.ParseState, names: Array[string], constants: Array[string], types: Types.TypeTable) -> HirBodyState
	return HirBodyState(tree, names, constants, types, Array[Hir.SymbolInfo](), Array[Hir.HirNode](), 0, Types.TYPE_TAG_INVALID, "", 0, Array[Hir.HirFunctionDecl](), Array[string](), Types.TYPE_TAG_INVALID, false, Array[HirSpecializationRequest](), Array[Hir.HirModuleConstant](), Array[HirStaticFact](), Array[Hir.HirTypeAlias](), Types.TYPE_TAG_INVALID)

export rec HirBodyAnalysis(nodes: Array[Hir.HirNode], error: string, error_line: i64)

# Bounds facts are scoped exactly like HIR symbols. Only immutable locals and
# literal arrays contribute lengths; no runtime-dependent or mutable facts are
# used to authorize plain indexing. All ranges are inclusive, nonnegative i64.
export def hir_index_range(state: HirBodyState, id: i64) -> HirIndexRange
	let tree = state.tree
	let node = tree.nodes[!id]
	if node.kind == Ast.NODE_NAME
		let resolved = Hir.resolve_hir_name(state.symbols, Hir.hir_ast_text(tree, id))
		if resolved.error == "" and not state.symbols[!resolved.field_index].mutable
			return state.facts[!resolved.field_index].index_range
		return hir_unknown_range()
	if node.kind == Ast.NODE_CALL and node.count == 2
		let callee = Hir.hir_ast_child(tree, id, 0)
		if tree.nodes[!callee].kind == Ast.NODE_NAME and Hir.hir_ast_text(tree, callee) == "len"
			let shape = hir_static_array_shape(state, Hir.hir_ast_child(tree, id, 1))
			if len(shape) > 0
				return HirIndexRange(shape[!0], shape[!0])
		return hir_unknown_range()
	if node.kind == Ast.NODE_UNARY
		if Hir.hir_ast_text(tree, id) == "+"
			return hir_index_range(state, Hir.hir_ast_child(tree, id, 0))
		return hir_unknown_range()
	if node.kind == Ast.NODE_BINARY and node.count == 2
		let op = Hir.hir_ast_text(tree, id)
		if op != "+" and op != "-" and op != "*"
			return hir_unknown_range()
		let left = hir_index_range(state, Hir.hir_ast_child(tree, id, 0))
		let right = hir_index_range(state, Hir.hir_ast_child(tree, id, 1))
		if left.low < 0 or right.low < 0
			return hir_unknown_range()
		if op == "+"
			if left.high > 9223372036854775807 - right.high
				return hir_unknown_range()
			return HirIndexRange(left.low + right.low, left.high + right.high)
		if op == "-"
			if left.low < right.high
				return hir_unknown_range()
			return HirIndexRange(left.low - right.high, left.high - right.low)
		if right.high > 0 and left.high > 9223372036854775807 / right.high
			return hir_unknown_range()
		return HirIndexRange(left.low * right.low, left.high * right.high)
	if node.kind != Ast.NODE_INTEGER
		return hir_unknown_range()
	let digits = Hir.hir_ast_text(tree, id)
	if len(digits) == 0
		return hir_unknown_range()
	var value = 0
	for i in 0..len(digits)
		let digit = (digits.byte_at(i) or 0) - 48
		if digit < 0 or digit > 9
			return hir_unknown_range()
		if value > (9223372036854775807 - digit) / 10
			return hir_unknown_range()
		value = value * 10 + digit
	return HirIndexRange(value, value)

export def hir_static_array_literal(state: HirBodyState, id: i64) -> i64
	let tree = state.tree
	let node = tree.nodes[!id]
	if node.kind == Ast.NODE_ARRAY
		return id
	if node.kind == Ast.NODE_NAME
		let resolved = Hir.resolve_hir_name(state.symbols, Hir.hir_ast_text(tree, id))
		if resolved.error == "" and not state.symbols[!resolved.field_index].mutable
			return state.facts[!resolved.field_index].array_literal
		return -1
	if node.kind != Ast.NODE_INDEX or node.count != 2
		return -1
	let base = hir_static_array_literal(state, Hir.hir_ast_child(tree, id, 0))
	if base < 0
		return -1
	let index = hir_index_range(state, Hir.hir_ast_child(tree, id, 1))
	if index.low < 0 or index.low != index.high or index.high >= tree.nodes[!base].count
		return -1
	let selected = Hir.hir_ast_child(tree, base, index.low)
	if tree.nodes[!selected].kind != Ast.NODE_ARRAY
		return -1
	return selected

# The common rectangular prefix of an array literal's elements, including
# immutable aliases and length-preserving expressions. Element values may be
# computed at runtime; only their provable shapes are used here.
export def hir_literal_array_shape(state: HirBodyState, id: i64) -> Array[i64]
	let tree = state.tree
	let node = tree.nodes[!id]
	if node.kind != Ast.NODE_ARRAY
		return Array[i64]()
	var shape = [node.count]
	if node.count == 0
		return shape
	var common = hir_static_array_shape(state, Hir.hir_ast_child(tree, id, 0))
	for i in 1..node.count
		let other = hir_static_array_shape(state, Hir.hir_ast_child(tree, id, i))
		var equal = 0
		while equal < len(common) and equal < len(other) and common[!equal] == other[!equal]
			equal += 1
		var prefix = Array[i64]()
		for j in 0..equal
			prefix = prefix.append(common[!j])
		common = prefix
		if len(common) == 0
			return shape
	for dimension in common
		shape = shape.append(dimension)
	return shape

# Array constructors and append preserve a known outer length even when the
# stored elements are dynamic. Keep inner dimensions only if every appended
# element has the same proven shape as the existing rows.
export def hir_static_array_shape(state: HirBodyState, id: i64) -> Array[i64]
	let tree = state.tree
	let literal = hir_static_array_literal(state, id)
	if literal >= 0
		return hir_literal_array_shape(state, literal)
	let node = tree.nodes[!id]
	if node.kind == Ast.NODE_NAME
		let resolved = Hir.resolve_hir_name(state.symbols, Hir.hir_ast_text(tree, id))
		if resolved.error == "" and not state.symbols[!resolved.field_index].mutable
			return state.facts[!resolved.field_index].array_shape
	if node.kind == Ast.NODE_CALL
		let callee = Hir.hir_ast_child(tree, id, 0)
		if node.count == 1 and tree.nodes[!callee].kind == Ast.NODE_INDEX
			let constructor = Hir.hir_ast_child(tree, callee, 0)
			if tree.nodes[!constructor].kind == Ast.NODE_NAME and Hir.hir_ast_text(tree, constructor) == "Array"
				return [0]
		if node.count == 2 and tree.nodes[!callee].kind == Ast.NODE_ATTR and Hir.hir_ast_text(tree, callee) == "append"
			let receiver = Hir.hir_ast_child(tree, callee, 0)
			let base = hir_static_array_shape(state, receiver)
			if len(base) == 0 or base[!0] == 9223372036854775807
				return Array[i64]()
			var shape = [base[!0] + 1]
			let element = hir_static_array_shape(state, Hir.hir_ast_child(tree, id, 1))
			if base[!0] == 0 and len(base) == 1
				for dimension in element
					shape = shape.append(dimension)
			elif len(base) == len(element) + 1
				var equal = true
				for i in 0..len(element)
					if base[!i + 1] != element[!i]
						equal = false
				if equal
					for dimension in element
						shape = shape.append(dimension)
			return shape
	if node.kind == Ast.NODE_INDEX and node.count == 2
		let shape = hir_static_array_shape(state, Hir.hir_ast_child(tree, id, 0))
		let index = hir_index_range(state, Hir.hir_ast_child(tree, id, 1))
		if len(shape) > 1 and index.low >= 0 and index.high < shape[!0]
			var tail = Array[i64]()
			for i in 1..len(shape)
				tail = tail.append(shape[!i])
			return tail
	return Array[i64]()

export def hir_index_proven(state: HirBodyState, id: i64) -> bool
	let tree = state.tree
	let node = tree.nodes[!id]
	if node.kind != Ast.NODE_INDEX or node.count != 2
		return false
	let shape = hir_static_array_shape(state, Hir.hir_ast_child(tree, id, 0))
	if len(shape) == 0
		return false
	let index = hir_index_range(state, Hir.hir_ast_child(tree, id, 1))
	return index.low >= 0 and index.high < shape[!0]

export def hir_body_error(state: HirBodyState, id: i64, message: string) -> HirBodyState
	var result = state
	if result.error == ""
		result.error = message
		result.error_line = Hir.hir_ast_line(state.tree, id)
	return result

# Resolve primitive and nested collection constructors without C ABI kinds.
# Unsupported type expressions stay unresolved until specialization.
export def hir_body_type_reference(types: Types.TypeTable, tree: Ast.ParseState, id: i64) -> Resolve.HirCallCheck
	let node = tree.nodes[!id]
	if node.kind == Ast.NODE_NAME or node.kind == Ast.NODE_TYPE
		let name = Hir.hir_ast_text(tree, id)
		if node.count == 0
			if name == "i64"
				return Resolve.HirCallCheck(types, Types.TYPE_TAG_I64, "")
			if name == "f64"
				return Resolve.HirCallCheck(types, Types.TYPE_TAG_F64, "")
			if name == "bool"
				return Resolve.HirCallCheck(types, Types.TYPE_TAG_BOOL, "")
			if name == "string"
				return Resolve.HirCallCheck(types, Types.TYPE_TAG_STRING, "")
			return Resolve.HirCallCheck(types, Types.TYPE_TAG_INVALID, "")
	else
		if node.kind != Ast.NODE_INDEX or node.count < 2
			return Resolve.HirCallCheck(types, Types.TYPE_TAG_INVALID, "")
	var name = Hir.hir_ast_text(tree, id)
	var first = 0
	if node.kind == Ast.NODE_INDEX
		name = Hir.hir_ast_text(tree, Hir.hir_ast_child(tree, id, 0))
		first = 1
	if name != "Array" and name != "Dict" and name != "Optional" and name != "Fn"
		return Resolve.HirCallCheck(types, Types.TYPE_TAG_INVALID, "")
	if name == "Fn"
		if node.count < first + 1
			return Resolve.HirCallCheck(types, Types.TYPE_TAG_INVALID, "Fn requires a return type")
		var current = types
		var arguments = Array[i64]()
		for i in first..node.count - 1
			let parameter = hir_body_type_reference(current, tree, Hir.hir_ast_child(tree, id, i))
			if parameter.type_id == Types.TYPE_TAG_INVALID
				return parameter
			current = parameter.table
			arguments = arguments.append(parameter.type_id)
		let ret = hir_body_type_reference(current, tree, Hir.hir_ast_child(tree, id, node.count - 1))
		if ret.type_id == Types.TYPE_TAG_INVALID
			return ret
		let function_type = Types.intern_function_type(ret.table, arguments, ret.type_id, Types.FUNCTION_EFFECT_UNCHECKED)
		return Resolve.HirCallCheck(function_type.table, function_type.id, "")
	if (name == "Dict" and node.count != first + 2) or (name != "Dict" and node.count != first + 1)
		return Resolve.HirCallCheck(types, Types.TYPE_TAG_INVALID, "")
	let element = hir_body_type_reference(types, tree, Hir.hir_ast_child(tree, id, first))
	if element.type_id == Types.TYPE_TAG_INVALID
		return element
	if name == "Array"
		let array = Types.intern_array_type(element.table, element.type_id)
		return Resolve.HirCallCheck(array.table, array.id, "")
	if name == "Optional"
		let optional = Types.intern_optional_type(element.table, element.type_id)
		return Resolve.HirCallCheck(optional.table, optional.id, "")
	let value = hir_body_type_reference(element.table, tree, Hir.hir_ast_child(tree, id, first + 1))
	if value.type_id == Types.TYPE_TAG_INVALID
		return value
	let dict = Types.intern_dict_type(value.table, element.type_id, value.type_id)
	return Resolve.HirCallCheck(dict.table, dict.id, "")

# Named record annotations refer to a constructor's canonical published shape.
# The plain resolver above remains useful for type-only clients without a module.
export def hir_module_type_reference_with_constants(types: Types.TypeTable, tree: Ast.ParseState, id: i64, functions: Array[Hir.HirFunctionDecl], constants: Array[Hir.HirModuleConstant], aliases: Array[Hir.HirTypeAlias]) -> Resolve.HirCallCheck
	let resolved = hir_body_type_reference(types, tree, id)
	if resolved.type_id != Types.TYPE_TAG_INVALID
		return resolved
	let node = tree.nodes[!id]
	if ((node.kind == Ast.NODE_NAME or node.kind == Ast.NODE_TYPE) and node.count == 0) or node.kind == Ast.NODE_CASE
		let name = Hir.hir_ast_text(tree, id)
		for alias in aliases
			if alias.name == name
				return Resolve.HirCallCheck(types, alias.type_id, "")
		for function in functions
			if function.name == name and function.constructor
				if function.external
					return Resolve.HirCallCheck(types, function.result_type, "")
				var current = types
				var arguments = Array[i64]()
				for parameter in function.parameters
					if parameter.type_node < 0
						return Resolve.HirCallCheck(current, Types.TYPE_TAG_INVALID, "named record type requires annotated constructor parameters")
					let argument = hir_module_type_reference_with_constants(current, tree, parameter.type_node, functions, constants, aliases)
					if argument.type_id == Types.TYPE_TAG_INVALID
						return argument
					current = argument.table
					arguments = arguments.append(argument.type_id)
				var state = new_hir_body_state(tree, Array[string](), Array[string](), current)
				state.functions = functions
				state.module_constants = constants
				state.type_aliases = aliases
				let constructed = hir_body_user_call(state, id, name, arguments)
				return Resolve.HirCallCheck(constructed.types, constructed.last_type, constructed.error)
		return resolved
	var name = Hir.hir_ast_text(tree, id)
	var start = 0
	if node.kind == Ast.NODE_INDEX and node.count > 0
		name = Hir.hir_ast_text(tree, Hir.hir_ast_child(tree, id, 0))
		start = 1
	if name != "Array" and name != "Optional" and name != "Dict"
		return resolved
	if (name == "Dict" and node.count != start + 2) or (name != "Dict" and node.count != start + 1)
		return resolved
	let first = hir_module_type_reference_with_constants(types, tree, Hir.hir_ast_child(tree, id, start), functions, constants, aliases)
	if first.type_id == Types.TYPE_TAG_INVALID
		return first
	if name == "Array"
		let result = Types.intern_array_type(first.table, first.type_id)
		return Resolve.HirCallCheck(result.table, result.id, "")
	if name == "Optional"
		let result = Types.intern_optional_type(first.table, first.type_id)
		return Resolve.HirCallCheck(result.table, result.id, "")
	let second = hir_module_type_reference_with_constants(first.table, tree, Hir.hir_ast_child(tree, id, start + 1), functions, constants, aliases)
	if second.type_id == Types.TYPE_TAG_INVALID
		return second
	let result = Types.intern_dict_type(second.table, first.type_id, second.type_id)
	return Resolve.HirCallCheck(result.table, result.id, "")

# Compatibility for clients without module constants.
export def hir_module_type_reference(types: Types.TypeTable, tree: Ast.ParseState, id: i64, functions: Array[Hir.HirFunctionDecl]) -> Resolve.HirCallCheck
	return hir_module_type_reference_with_constants(types, tree, id, functions, Array[Hir.HirModuleConstant](), Array[Hir.HirTypeAlias]())

export def hir_body_binding(state: HirBodyState, id: i64, name: string, type_id: i64, mutable: bool) -> HirBodyState
	var result = state
	for symbol in result.symbols
		if symbol.name == name and symbol.depth == result.depth
			return hir_body_error(result, id, "duplicate binding '" + name + "'")
	result.symbols = result.symbols.append(Hir.SymbolInfo(name, type_id, type_id, mutable, result.depth))
	result.facts = result.facts.append(HirStaticFact(-1, hir_unknown_range(), Array[i64]()))
	result.nodes = result.nodes.append(Hir.HirNode(id, HIR_BINDING, type_id, len(result.symbols) - 1))
	return result

# Resolve concrete user calls independently of C emission. Unknown parameter or
# return types are deferred; an active unannotated recursive call is deferred too.
# The backend remains responsible for generating/reusing specializations.
export def hir_body_user_call(state: HirBodyState, id: i64, name: string, args: Array[i64]) -> HirBodyState
	var result = state
	var found = false
	var function = Hir.new_hir_function_decl("", -1, -1, false, -1, Array[Hir.HirParameterDecl]())
	for candidate in state.functions
		if candidate.name == name
			function = candidate
			found = true
	if not found
		return result
	if len(args) != len(function.parameters)
		return hir_body_error(result, id, "argument count mismatch for '" + name + "'")
	var specialized_args = args
	for i in 0..len(args)
		let parameter = function.parameters[!i]
		if function.external and function.argument_types[!i] != Types.TYPE_TAG_INVALID and function.argument_types[!i] != args[!i] and not Types.type_coercible(result.types, function.argument_types[!i], args[!i])
			return hir_body_error(result, id, "expected " + Resolve.hir_type_name(result.types, function.argument_types[!i]) + ", found " + Resolve.hir_type_name(result.types, args[!i]))
		if parameter.type_node >= 0
			let annotation = hir_module_type_reference_with_constants(result.types, result.tree, parameter.type_node, result.functions, result.module_constants, result.type_aliases)
			result.types = annotation.table
			if annotation.type_id != Types.TYPE_TAG_INVALID and annotation.type_id != args[!i]
				if not Types.type_coercible(result.types, annotation.type_id, args[!i])
					return hir_body_error(result, id, "expected " + Resolve.hir_type_name(result.types, annotation.type_id) + ", found " + Resolve.hir_type_name(result.types, args[!i]))
				result.nodes = result.nodes.append(Hir.HirNode(Hir.hir_ast_child(result.tree, id, i + 1), Hir.HIR_UNION_INJECT, annotation.type_id, -1))
				specialized_args[!i] = annotation.type_id
	# In concrete-specialization mode, register calls for the HIR worklist.
	# Do not recursively analyze callees from inside an expression.
	if result.collect_calls and not function.constructor
		result.requests = result.requests.append(HirSpecializationRequest(id, function.body, specialized_args))
		if function.external
			result.last_type = function.result_type
			return result
		if function.result_type_node >= 0
			let declared = hir_module_type_reference_with_constants(result.types, result.tree, function.result_type_node, result.functions, result.module_constants, result.type_aliases)
			result.types = declared.table
			result.last_type = declared.type_id
			return result
		# Unannotated callees need a concrete result type for their caller's
		# expressions. Infer it without recursively registering specializations.
		# The worklist still owns emission and deduplication of these calls.
	if function.external and (not function.constructor or function.body < 0)
		result.last_type = function.result_type
		return result
	if function.constructor
		var nested = new_hir_body_state(state.tree, state.names, state.constants, result.types)
		nested.functions = state.functions
		nested.module_constants = state.module_constants
		nested.type_aliases = state.type_aliases
		nested.active_functions = state.active_functions
		nested.collect_calls = result.collect_calls
		for i in 0..len(args)
			let param = function.parameters[!i]
			nested = hir_body_binding(nested, param.source, param.name, specialized_args[!i], false)
		var fields = Array[Types.RecordField]()
		let block = state.tree.nodes[!function.body]
		for i in 0..block.count
			let pub_id = Hir.hir_ast_child(state.tree, function.body, i)
			let pub = state.tree.nodes[!pub_id]
			if pub.kind == Ast.NODE_IF and i == block.count - 1
				for j in 0..pub.count
					let arm_id = Hir.hir_ast_child(state.tree, pub_id, j)
					let arm = state.tree.nodes[!arm_id]
					var branch_id = Hir.hir_ast_child(state.tree, arm_id, 0)
					if arm.kind != Ast.NODE_ELSE
						nested = hir_body_expression(nested, branch_id)
						if nested.error != "" or nested.last_type != Types.TYPE_TAG_BOOL
							return hir_body_error(result, arm_id, "constructor branch requires bool condition")
						branch_id = Hir.hir_ast_child(state.tree, arm_id, 1)
					let branch = state.tree.nodes[!branch_id]
					for k in 0..branch.count
						let override_id = Hir.hir_ast_child(state.tree, branch_id, k)
						let override = state.tree.nodes[!override_id]
						if override.kind != Ast.NODE_PUB
							return hir_body_error(result, override_id, "constructor branches may only override published fields")
						var override_name = Hir.hir_ast_text(state.tree, override_id)
						var override_type = Types.TYPE_TAG_INVALID
						if override.count == 0
							let resolved = Hir.resolve_hir_name(nested.symbols, override_name)
							override_type = resolved.type_id
						else
							let expression = Hir.hir_ast_child(state.tree, override_id, 0)
							if state.tree.nodes[!expression].kind == Ast.NODE_ATTR
								override_name = Hir.hir_ast_text(state.tree, expression)
							nested = hir_body_expression(nested, expression)
							override_type = nested.last_type
						let index = Resolve.hir_record_field(fields, override_name)
						if nested.error != "" or index < 0 or override_type != fields[!index].kind
							return hir_body_error(result, override_id, "constructor branch must override an existing field with the same type")
				continue
			if pub.kind != Ast.NODE_PUB
				return hir_body_error(result, pub_id, "constructor requires publications followed by an optional conditional override")
			var field_name = Hir.hir_ast_text(state.tree, pub_id)
			var field_type = Types.TYPE_TAG_INVALID
			if pub.count == 0
				let symbol = Hir.resolve_hir_name(nested.symbols, field_name)
				field_type = symbol.type_id
			else
				let expression = Hir.hir_ast_child(state.tree, pub_id, 0)
				if state.tree.nodes[!expression].kind == Ast.NODE_ATTR
					field_name = Hir.hir_ast_text(state.tree, expression)
				nested = hir_body_expression(nested, expression)
				field_type = nested.last_type
			if nested.error != "" or field_type == Types.TYPE_TAG_INVALID
				return result
			let edit = Resolve.hir_constructor_publish(fields, field_name, field_type)
			if edit.error != ""
				return hir_body_error(result, pub_id, edit.error)
			fields = edit.fields
			# Publications are visible to later publications, including overrides.
			nested.symbols = nested.symbols.append(Hir.SymbolInfo(field_name, field_type, field_type, false, nested.depth + 1))
			nested.facts = nested.facts.append(HirStaticFact(-1, hir_unknown_range(), Array[i64]()))
		for typed_node in nested.nodes
			if typed_node.operation != HIR_BINDING
				result.nodes = result.nodes.append(typed_node)
		for request in nested.requests
			result.requests = result.requests.append(request)
		if len(fields) > 0
			let record = Types.intern_record_type(nested.types, fields)
			result.types = record.table
			result.last_type = record.id
		return result
	if function.result_type_node >= 0
		let declared = hir_module_type_reference_with_constants(result.types, result.tree, function.result_type_node, result.functions, result.module_constants, result.type_aliases)
		result.types = declared.table
		result.last_type = declared.type_id
		if declared.type_id != Types.TYPE_TAG_INVALID
			return result
	for active in state.active_functions
		if active == name
			return result
	var nested = new_hir_body_state(state.tree, state.names, state.constants, result.types)
	nested.functions = state.functions
	nested.module_constants = state.module_constants
	nested.type_aliases = state.type_aliases
	nested.active_functions = state.active_functions.append(name)
	for i in 0..len(args)
		let parameter = function.parameters[!i]
		nested = hir_body_binding(nested, parameter.source, parameter.name, args[!i], false)
	nested = hir_body_block(nested, function.body)
	if nested.error != ""
		result.error = nested.error
		result.error_line = nested.error_line
		return result
	result.types = nested.types
	result.last_type = nested.inferred_return
	return result

# Infer omitted parameter annotations only when an expected Fn signature is
# available. Analyze the body in a separate scope to prohibit captures.
def hir_body_lambda(state: HirBodyState, id: i64, expected: i64) -> HirBodyState
	let node = state.tree.nodes[!id]
	var result = state
	# A separate lexical scope rules out captures of enclosing locals.
	var nested = new_hir_body_state(state.tree, state.names, state.constants, result.types)
	nested.functions = state.functions
	nested.module_constants = state.module_constants
	nested.type_aliases = state.type_aliases
	var parameters = Array[i64]()
	var signature = Types.TypeDescriptor(0, 0, 0, Array[Types.RecordField]())
	var has_expected = false
	if Types.type_tag(nested.types, expected) == Types.TYPE_TAG_FUNCTION
		signature = nested.types.entries[!expected]
		has_expected = true
		if len(signature.fields) != node.count - 1
			return hir_body_error(result, id, "lambda parameter count does not match expected Fn type")
	for i in 0..node.count - 1
		let part = Hir.hir_ast_child(state.tree, id, i)
		let parameter = state.tree.nodes[!part]
		var parameter_type = Types.TYPE_TAG_INVALID
		if parameter.count > 0
			let annotation = Hir.hir_ast_child(state.tree, part, 0)
			let typed = hir_module_type_reference_with_constants(nested.types, nested.tree, annotation, nested.functions, nested.module_constants, nested.type_aliases)
			nested.types = typed.table
			parameter_type = typed.type_id
		elif has_expected
			parameter_type = signature.fields[!i].kind
		if parameter_type == Types.TYPE_TAG_INVALID
			return hir_body_error(result, part, "lambda parameter requires annotation or expected Fn type")
		if has_expected and parameter_type != signature.fields[!i].kind
			return hir_body_error(result, part, "lambda parameter type does not match expected Fn type")
		parameters = parameters.append(parameter_type)
		nested = hir_body_binding(nested, part, Hir.hir_ast_text(state.tree, part), parameter_type, false)
	let body = Hir.hir_ast_child(state.tree, id, node.count - 1)
	nested = hir_body_expression(nested, body)
	if nested.error != ""
		result.error = nested.error
		result.error_line = nested.error_line
		return result
	if nested.last_type == Types.TYPE_TAG_INVALID
		return hir_body_error(result, body, "cannot infer lambda return type")
	if has_expected and nested.last_type != signature.second
		return hir_body_error(result, body, "lambda return type does not match expected Fn type")
	let typed = Types.intern_function_type(nested.types, parameters, nested.last_type, Types.FUNCTION_EFFECT_UNCHECKED)
	result.types = typed.table
	result.last_type = typed.id
	result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_LAMBDA, typed.id, -1))
	if result.collect_calls
		result.requests = result.requests.append(HirSpecializationRequest(id, id, parameters))
	return result

export def hir_body_expression(state: HirBodyState, id: i64) -> HirBodyState
	state.error == "" else return state
	let node = state.tree.nodes[!id]
	let kind = node.kind
	var result = state
	result.last_type = Types.TYPE_TAG_INVALID
	let literal = Hir.resolve_hir_literal(kind)
	if literal != Types.TYPE_TAG_INVALID
		result.last_type = literal
		result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_LITERAL, literal, -1))
		return result
	if kind == Ast.NODE_NAME
		let name = Hir.hir_ast_text(state.tree, id)
		let resolved = Hir.resolve_hir_name(result.symbols, name)
		if resolved.error == ""
			result.last_type = resolved.type_id
			result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_NAME, resolved.type_id, resolved.field_index))
			return result
		for constant in result.module_constants
			if constant.name == name
				result.last_type = constant.type_id
				result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_NAME, constant.type_id, -1))
				return result
		for constant in result.constants
			if constant == name
				result.last_type = Types.TYPE_TAG_I64
				result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_NAME, Types.TYPE_TAG_I64, -1))
				return result
		for function in result.functions
			if function.name == name and not function.constructor
				var parameters = Array[i64]()
				for i in 0..len(function.parameters)
					let parameter = function.parameters[!i]
					var parameter_type = Types.TYPE_TAG_INVALID
					if function.external
						parameter_type = function.argument_types[!i]
					elif parameter.type_node >= 0
						let annotated = hir_module_type_reference_with_constants(result.types, result.tree, parameter.type_node, result.functions, result.module_constants, result.type_aliases)
						result.types = annotated.table
						parameter_type = annotated.type_id
					if parameter_type == Types.TYPE_TAG_INVALID
						return hir_body_error(result, id, "function values require annotated parameters")
					parameters = parameters.append(parameter_type)
				var returned = function.result_type
				if function.result_type_node >= 0
					let annotation = hir_module_type_reference_with_constants(result.types, result.tree, function.result_type_node, result.functions, result.module_constants, result.type_aliases)
					result.types = annotation.table
					returned = annotation.type_id
				if returned == Types.TYPE_TAG_INVALID
					return hir_body_error(result, id, "function values require an annotated return type")
				let typed = Types.intern_function_type(result.types, parameters, returned, Types.FUNCTION_EFFECT_UNCHECKED)
				result.types = typed.table
				if typed.id == Types.TYPE_TAG_INVALID
					return hir_body_error(result, id, "invalid function value type")
				result.last_type = typed.id
				result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_NAME, typed.id, -1))
				if result.collect_calls
					result.requests = result.requests.append(HirSpecializationRequest(id, function.body, parameters))
				return result
		return hir_body_error(result, id, "unknown name '" + name + "'")
	if kind == Ast.NODE_CALL
		let callee = Hir.hir_ast_child(state.tree, id, 0)
		let callee_kind = state.tree.nodes[!callee].kind
		var receiver = Types.TYPE_TAG_INVALID
		var method = ""
		var resolved_function = -1
		var indirect_type = Types.TYPE_TAG_INVALID
		if callee_kind == Ast.NODE_NAME
			let local = Hir.resolve_hir_name(result.symbols, Hir.hir_ast_text(state.tree, callee))
			if local.error == "" and Types.type_tag(result.types, local.type_id) == Types.TYPE_TAG_FUNCTION
				indirect_type = local.type_id
		if callee_kind == Ast.NODE_ATTR
			method = Hir.hir_ast_text(state.tree, callee)
			result = hir_body_expression(result, Hir.hir_ast_child(state.tree, callee, 0))
			receiver = result.last_type
		elif callee_kind != Ast.NODE_NAME and callee_kind != Ast.NODE_INDEX
			result = hir_body_expression(result, callee)
			if Types.type_tag(result.types, result.last_type) == Types.TYPE_TAG_FUNCTION
				indirect_type = result.last_type
		var args = Array[i64]()
		var complete = true
		for i in 1..node.count
			let child = Hir.hir_ast_child(state.tree, id, i)
			var expected = Types.TYPE_TAG_INVALID
			if indirect_type != Types.TYPE_TAG_INVALID and i - 1 < len(result.types.entries[!indirect_type].fields)
				expected = result.types.entries[!indirect_type].fields[!i - 1].kind
			elif callee_kind == Ast.NODE_NAME
				for function in result.functions
					if function.name == Hir.hir_ast_text(state.tree, callee) and i - 1 < len(function.parameters)
						let parameter = function.parameters[!i - 1]
						if function.external
							expected = function.argument_types[!i - 1]
						elif parameter.type_node >= 0
							let annotation = hir_module_type_reference_with_constants(result.types, result.tree, parameter.type_node, result.functions, result.module_constants, result.type_aliases)
							result.types = annotation.table
							expected = annotation.type_id
			if callee_kind == Ast.NODE_ATTR and receiver != Types.TYPE_TAG_INVALID
				let tag = Types.type_tag(result.types, receiver)
				if tag == Types.TYPE_TAG_ARRAY and method == "append" and i == 1
					expected = result.types.entries[!receiver].first
				elif tag == Types.TYPE_TAG_DICT and method == "insert"
					if i == 1
						expected = result.types.entries[!receiver].first
					elif i == 2
						expected = result.types.entries[!receiver].second
			if expected != Types.TYPE_TAG_INVALID
				result = hir_body_expression_expected(result, child, expected)
			else
				result = hir_body_expression(result, child)
			if result.error != ""
				return result
			if result.last_type == Types.TYPE_TAG_INVALID
				complete = false
			args = args.append(result.last_type)
		result.last_type = Types.TYPE_TAG_INVALID
		if callee_kind == Ast.NODE_INDEX and node.count == 1
			let typed = hir_module_type_reference_with_constants(result.types, result.tree, callee, result.functions, result.module_constants, result.type_aliases)
			if typed.type_id != Types.TYPE_TAG_INVALID
				result.types = typed.table
				result.last_type = typed.type_id
		elif complete and indirect_type != Types.TYPE_TAG_INVALID
			let signature = result.types.entries[!indirect_type]
			if len(args) != len(signature.fields)
				return hir_body_error(result, id, "indirect call argument count mismatch")
			for i in 0..len(args)
				if not Types.type_coercible(result.types, signature.fields[!i].kind, args[!i])
					return hir_body_error(result, id, "indirect call argument type mismatch")
				if args[!i] != signature.fields[!i].kind
					result.nodes = result.nodes.append(Hir.HirNode(Hir.hir_ast_child(result.tree, id, i + 1), Hir.HIR_UNION_INJECT, signature.fields[!i].kind, -1))
			result.last_type = signature.second
		elif complete and callee_kind == Ast.NODE_NAME
			let name = Hir.hir_ast_text(state.tree, callee)
			if Resolve.hir_is_builtin(name)
				let checked = Resolve.resolve_hir_builtin_call(result.types, name, args)
				if checked.error != ""
					return hir_body_error(result, id, checked.error)
				result.types = checked.table
				result.last_type = checked.type_id
			else
				for j in 0..len(result.functions)
					if result.functions[!j].name == name
						resolved_function = j
				result = hir_body_user_call(result, id, name, args)
		elif complete and receiver != Types.TYPE_TAG_INVALID
			let tag = Types.type_tag(result.types, receiver)
			var checked = Resolve.HirCallCheck(result.types, Types.TYPE_TAG_INVALID, "")
			if tag == Types.TYPE_TAG_STRING and Resolve.hir_is_string_method(method)
				checked = Resolve.resolve_hir_string_call(result.types, receiver, method, args)
			elif (tag == Types.TYPE_TAG_ARRAY and method == "append") or (tag == Types.TYPE_TAG_DICT and (method == "get" or method == "insert"))
				checked = Resolve.resolve_hir_collection_call(result.types, receiver, method, args)
			if checked.error != ""
				return hir_body_error(result, id, checked.error)
			result.types = checked.table
			result.last_type = checked.type_id
			if (tag == Types.TYPE_TAG_ARRAY and method == "append") or (tag == Types.TYPE_TAG_DICT and method == "insert")
				let descriptor = result.types.entries[!receiver]
				for i in 0..len(args)
					var expected = descriptor.first
					if tag == Types.TYPE_TAG_DICT and i == 1
						expected = descriptor.second
					if args[!i] != expected
						result.nodes = result.nodes.append(Hir.HirNode(Hir.hir_ast_child(result.tree, id, i + 1), Hir.HIR_UNION_INJECT, expected, -1))
		if result.last_type != Types.TYPE_TAG_INVALID
			result.nodes = result.nodes.append(Hir.HirNode(id, Resolve.HIR_CALL, result.last_type, resolved_function))
		return result
	if kind == Ast.NODE_UNARY
		result = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, 0))
		if result.last_type != Types.TYPE_TAG_INVALID
			let checked = Hir.resolve_hir_unary(result.types, result.last_type, Hir.hir_ast_text(state.tree, id))
			if checked.error != ""
				return hir_body_error(result, id, checked.error)
			result.last_type = checked.type_id
			result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_UNARY, checked.type_id, -1))
		return result
	if kind == Ast.NODE_BINARY
		let lhs = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, 0))
		let left = lhs.last_type
		result = hir_body_expression(lhs, Hir.hir_ast_child(state.tree, id, 1))
		let right = result.last_type
		let op = Hir.hir_ast_text(state.tree, id)
		if left != Types.TYPE_TAG_INVALID and right != Types.TYPE_TAG_INVALID and op == "or" and Types.type_tag(result.types, left) == Types.TYPE_TAG_OPTIONAL
			let value_type = result.types.entries[!left].first
			if right != value_type
				return hir_body_error(result, id, "expected " + Resolve.hir_type_name(result.types, value_type) + ", found " + Resolve.hir_type_name(result.types, right))
			result.last_type = value_type
			result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_BINARY, value_type, -1))
		elif left != Types.TYPE_TAG_INVALID and right != Types.TYPE_TAG_INVALID and op != ".."
			let checked = Hir.resolve_hir_binary(result.types, left, right, op)
			if checked.error != ""
				return hir_body_error(result, id, checked.error)
			result.last_type = checked.type_id
			result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_BINARY, checked.type_id, -1))
		else
			result.last_type = Types.TYPE_TAG_INVALID
		return result
	if kind == Ast.NODE_ATTR
		result = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, 0))
		let owner = result.last_type
		if owner != Types.TYPE_TAG_INVALID and Types.type_tag(result.types, owner) == Types.TYPE_TAG_RECORD
			let field = Hir.resolve_hir_field(result.types, owner, Hir.hir_ast_text(state.tree, id))
			if field.error != ""
				return hir_body_error(result, id, field.error)
			result.last_type = field.type_id
			result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_FIELD, field.type_id, field.field_index))
		else
			result.last_type = Types.TYPE_TAG_INVALID
		return result
	if kind == Ast.NODE_LAMBDA
		return hir_body_lambda(state, id, Types.TYPE_TAG_INVALID)
	if kind == Ast.NODE_RECORD
		var fields = Array[Types.RecordField]()
		var complete = true
		for i in 0..node.count
			let field_id = Hir.hir_ast_child(state.tree, id, i)
			let field = state.tree.nodes[!field_id]
			let name = Hir.hir_ast_text(state.tree, field_id)
			if field.kind == Ast.NODE_FIELD
				result = hir_body_expression(result, Hir.hir_ast_child(state.tree, field_id, 0))
				if result.error != ""
					return result
				if result.last_type == Types.TYPE_TAG_INVALID
					complete = false
				elif complete
					let edit = Resolve.hir_record_put(fields, name, result.last_type)
					if edit.error != ""
						return hir_body_error(result, field_id, edit.error)
					fields = edit.fields
			elif field.kind == Ast.NODE_SPREAD
				let symbol = Hir.resolve_hir_name(result.symbols, name)
				if symbol.type_id == Types.TYPE_TAG_INVALID
					complete = false
				elif complete
					let edit = Resolve.hir_record_spread(result.types, fields, symbol.type_id)
					if edit.error != ""
						return hir_body_error(result, field_id, edit.error)
					fields = edit.fields
			elif field.kind == Ast.NODE_DELETE and complete
				let edit = Resolve.hir_record_delete(fields, name)
				if edit.error != ""
					return hir_body_error(result, field_id, edit.error)
				fields = edit.fields
		result.last_type = Types.TYPE_TAG_INVALID
		if complete
			let typed = Resolve.resolve_hir_record(result.types, fields)
			if typed.error != ""
				return hir_body_error(result, id, typed.error)
			result.types = typed.table
			result.last_type = typed.type_id
			result.nodes = result.nodes.append(Hir.HirNode(id, Resolve.HIR_RECORD, typed.type_id, -1))
		return result
	if kind == Ast.NODE_ARRAY
		var element_type = Types.TYPE_TAG_INVALID
		var complete = true
		for i in 0..node.count
			result = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, i))
			if result.error != ""
				return result
			let current = result.last_type
			if current == Types.TYPE_TAG_INVALID
				complete = false
			elif element_type == Types.TYPE_TAG_INVALID
				element_type = current
			elif element_type != current and complete
				return hir_body_error(result, id, "expected " + Resolve.hir_type_name(result.types, element_type) + ", found " + Resolve.hir_type_name(result.types, current))
		result.last_type = Types.TYPE_TAG_INVALID
		if complete
			if element_type == Types.TYPE_TAG_INVALID
				element_type = Types.TYPE_TAG_I64
			let typed = Types.intern_array_type(result.types, element_type)
			result.types = typed.table
			result.last_type = typed.id
			result.nodes = result.nodes.append(Hir.HirNode(id, HIR_ARRAY, typed.id, -1))
		return result
	if kind == Ast.NODE_INDEX or kind == Ast.NODE_OPTIONAL_INDEX or kind == Ast.NODE_CHECKED_INDEX
		if kind == Ast.NODE_INDEX and node.count > 0
			let base = Hir.hir_ast_child(state.tree, id, 0)
			if state.tree.nodes[!base].kind == Ast.NODE_NAME
				let type_name = Hir.hir_ast_text(state.tree, base)
				if type_name == "Array" or type_name == "Dict" or type_name == "Optional"
					return result
		let owner_state = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, 0))
		let owner = owner_state.last_type
		result = owner_state
		for i in 1..node.count
			result = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, i))
			if result.error != ""
				return result
			if result.last_type != Types.TYPE_TAG_INVALID and result.last_type != Types.TYPE_TAG_I64
				return hir_body_error(result, id, "expected i64, found " + Resolve.hir_type_name(result.types, result.last_type))
		let valid_index = result.last_type == Types.TYPE_TAG_I64 and node.count == 2
		if kind == Ast.NODE_INDEX and not hir_index_proven(result, id)
			return hir_body_error(result, id, "index is not statically proven in bounds; use [?] or [!]")
		result.last_type = Types.TYPE_TAG_INVALID
		if valid_index and owner != Types.TYPE_TAG_INVALID and Types.type_tag(result.types, owner) == Types.TYPE_TAG_ARRAY
			let element = result.types.entries[!owner].first
			if kind == Ast.NODE_OPTIONAL_INDEX
				let optional = Types.intern_optional_type(result.types, element)
				result.types = optional.table
				result.last_type = optional.id
			else
				result.last_type = element
			# HIR_INDEX.field_index records the proof consumed by MIR lowering.
			var proven = -1
			if kind == Ast.NODE_INDEX
				proven = 1
			result.nodes = result.nodes.append(Hir.HirNode(id, HIR_INDEX, result.last_type, proven))
		return result
	if kind == Ast.NODE_UNWRAP
		result = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, 0))
		let wrapped = result.last_type
		if wrapped != Types.TYPE_TAG_INVALID
			let descriptor = result.types.entries[!wrapped]
			if descriptor.tag != Types.TYPE_TAG_OPTIONAL
				return hir_body_error(result, id, "unboxing requires an Optional")
			result.last_type = descriptor.first
			result.nodes = result.nodes.append(Hir.HirNode(id, HIR_UNWRAP, descriptor.first, -1))
		return result
	if kind == Ast.NODE_ELSE_RETURN
		for i in 0..node.count
			result = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, i))
		return result
	# Other expressions keep their original emitter validation until typed.
	return result

# Instantiate a named generic function using an expected first-class Fn type.
# The same specialization request as an ordinary named call is consumed by the
# HIR worklist, so function references and calls share their specialization.
def hir_body_function_value_expected(state: HirBodyState, id: i64, expected: i64) -> HirBodyState
	let name = Hir.hir_ast_text(state.tree, id)
	let local = Hir.resolve_hir_name(state.symbols, name)
	if local.error == ""
		return hir_body_expression(state, id)
	var result = state
	let signature = state.types.entries[!expected]
	for function in state.functions
		if function.name != name or function.constructor
			continue
		if len(function.parameters) != len(signature.fields)
			return hir_body_error(result, id, "function parameter count does not match expected Fn type")
		var parameters = Array[i64]()
		for i in 0..len(signature.fields)
			let concrete = signature.fields[!i].kind
			let parameter = function.parameters[!i]
			var annotated = Types.TYPE_TAG_INVALID
			if function.external
				annotated = function.argument_types[!i]
			elif parameter.type_node >= 0
				let typed = hir_module_type_reference_with_constants(result.types, result.tree, parameter.type_node, result.functions, result.module_constants, result.type_aliases)
				result.types = typed.table
				annotated = typed.type_id
			if annotated != Types.TYPE_TAG_INVALID and annotated != concrete
				return hir_body_error(result, id, "function parameter type does not match expected Fn type")
			parameters = parameters.append(concrete)
		# Reuse named-call inference, checking both annotated and inferred returns.
		result = hir_body_user_call(result, id, name, parameters)
		if result.error != ""
			return result
		if result.last_type == Types.TYPE_TAG_INVALID
			return hir_body_error(result, id, "cannot infer function return type")
		if result.last_type != signature.second
			return hir_body_error(result, id, "function return type does not match expected Fn type")
		result.last_type = expected
		result.nodes = result.nodes.append(Hir.HirNode(id, Hir.HIR_NAME, expected, -1))
		return result
	return hir_body_expression(state, id)

# Contextual homogeneous arrays can hold distinct alternatives when their
# expected element type is a union. Every element is checked independently.
export def hir_body_expression_expected(state: HirBodyState, id: i64, expected: i64) -> HirBodyState
	if state.tree.nodes[!id].kind == Ast.NODE_LAMBDA
		return hir_body_lambda(state, id, expected)
	if state.tree.nodes[!id].kind == Ast.NODE_NAME and Types.type_tag(state.types, expected) == Types.TYPE_TAG_FUNCTION
		return hir_body_function_value_expected(state, id, expected)
	if state.tree.nodes[!id].kind != Ast.NODE_ARRAY or Types.type_tag(state.types, expected) != Types.TYPE_TAG_ARRAY
		return hir_body_expression(state, id)
	var result = state
	let element_type = result.types.entries[!expected].first
	let node = result.tree.nodes[!id]
	for i in 0..node.count
		let child = Hir.hir_ast_child(result.tree, id, i)
		result = hir_body_expression_expected(result, child, element_type)
		result.error == "" else return result
		if result.last_type != element_type
			if not Types.type_coercible(result.types, element_type, result.last_type)
				return hir_body_error(result, child, "expected " + Resolve.hir_type_name(result.types, element_type) + ", found " + Resolve.hir_type_name(result.types, result.last_type))
			result.nodes = result.nodes.append(Hir.HirNode(child, Hir.HIR_UNION_INJECT, element_type, -1))
	result.last_type = expected
	result.nodes = result.nodes.append(Hir.HirNode(id, HIR_ARRAY, expected, -1))
	return result

export def hir_body_block(state: HirBodyState, id: i64) -> HirBodyState
	var result = state
	let initial = len(result.symbols)
	result.depth += 1
	let block = result.tree.nodes[!id]
	for i in 0..block.count
		result = hir_body_statement(result, Hir.hir_ast_child(result.tree, id, i))
		result.error == "" else return result
	var symbols = Array[Hir.SymbolInfo]()
	for i in 0..initial
		symbols = symbols.append(result.symbols[!i])
	result.symbols = symbols
	var facts = Array[HirStaticFact]()
	for i in 0..initial
		facts = facts.append(result.facts[!i])
	result.facts = facts
	result.depth -= 1
	return result

export def hir_body_statement(state: HirBodyState, id: i64) -> HirBodyState
	state.error == "" else return state
	let node = state.tree.nodes[!id]
	var result = state
	if node.kind == Ast.NODE_MATCH
		let subject = Hir.hir_ast_child(state.tree, id, 0)
		result = hir_body_expression(result, subject)
		result.error == "" else return result
		let union_id = result.last_type
		if Types.type_tag(result.types, union_id) != Types.TYPE_TAG_UNION
			return hir_body_error(result, id, "match requires a tagged union")
		var alternatives = Array[i64]()
		for i in 1..node.count
			let arm_id = Hir.hir_ast_child(state.tree, id, i)
			let case_type = hir_module_type_reference_with_constants(result.types, result.tree, arm_id, result.functions, result.module_constants, result.type_aliases)
			result.types = case_type.table
			if case_type.error != ""
				return hir_body_error(result, arm_id, case_type.error)
			if case_type.type_id == Types.TYPE_TAG_INVALID
				return hir_body_error(result, arm_id, "unknown match constructor '" + Hir.hir_ast_text(state.tree, arm_id) + "'")
			if Types.union_alternative_index(result.types, union_id, case_type.type_id) < 0
				return hir_body_error(result, arm_id, "match arm is not a union alternative")
			alternatives = alternatives.append(case_type.type_id)
			result.nodes = result.nodes.append(Hir.HirNode(arm_id, Hir.HIR_MATCH_CASE, case_type.type_id, Types.union_alternative_index(result.types, union_id, case_type.type_id)))
			# Existing positional parameters precede optional computed fields.
			var constructor = Hir.new_hir_function_decl("", -1, -1, false, -1, Array[Hir.HirParameterDecl]())
			for function in result.functions
				if function.name == Hir.hir_ast_text(state.tree, arm_id) and function.constructor
					constructor = function
			let fields = result.types.entries[!case_type.type_id].fields
			let bound = result.tree.nodes[!arm_id].count - 1
			if bound < len(constructor.parameters) or bound > len(fields)
				return hir_body_error(result, arm_id, "match pattern requires constructor parameters, followed by optional published fields")
			let previous = len(result.symbols)
			result.depth += 1
			for j in 0..bound
				let field_index = Resolve.hir_match_field_index(fields, constructor.parameters, j)
				if field_index < 0
					return hir_body_error(result, arm_id, "match pattern field is missing")
				let binding = Hir.hir_ast_child(state.tree, arm_id, j)
				result = hir_body_binding(result, binding, Hir.hir_ast_text(state.tree, binding), fields[!field_index].kind, false)
				result.error == "" else return result
			result = hir_body_block(result, Hir.hir_ast_child(state.tree, arm_id, bound))
			result.error == "" else return result
			var scoped = Array[Hir.SymbolInfo]()
			var scoped_facts = Array[HirStaticFact]()
			for j in 0..previous
				scoped = scoped.append(result.symbols[!j])
				scoped_facts = scoped_facts.append(result.facts[!j])
			result.symbols = scoped
			result.facts = scoped_facts
			result.depth -= 1
		let checked = Resolve.check_exhaustive_match(result.types, union_id, alternatives)
		if checked.error != ""
			return hir_body_error(result, id, checked.error)
		return result
	if node.kind == Ast.NODE_DESTRUCTURE
		let initializer = Hir.hir_ast_child(state.tree, id, 0)
		result = hir_body_expression(result, initializer)
		result.error == "" else return result
		let record_type = result.last_type
		if record_type == Types.TYPE_TAG_INVALID or Types.type_tag(result.types, record_type) != Types.TYPE_TAG_RECORD
			return hir_body_error(result, id, "record destructuring requires a record")
		for i in 1..node.count
			let field_id = Hir.hir_ast_child(state.tree, id, i)
			let selector = Hir.hir_ast_child(state.tree, field_id, 0)
			let field = Hir.resolve_hir_field(result.types, record_type, Hir.hir_ast_text(state.tree, selector))
			if field.error != ""
				return hir_body_error(result, field_id, field.error)
			result.nodes = result.nodes.append(Hir.HirNode(field_id, Hir.HIR_FIELD, field.type_id, field.field_index))
			result = hir_body_binding(result, field_id, Hir.hir_ast_text(state.tree, field_id), field.type_id, false)
			result.error == "" else return result
		return result
	if node.kind == Ast.NODE_LET or node.kind == Ast.NODE_VAR
		var declared = Types.TYPE_TAG_INVALID
		var initializer = -1
		var fallback = -1
		for i in 0..node.count
			let child = Hir.hir_ast_child(state.tree, id, i)
			let child_kind = state.tree.nodes[!child].kind
			if child_kind == Ast.NODE_TYPE
				let annotated = hir_module_type_reference_with_constants(result.types, result.tree, child, result.functions, result.module_constants, result.type_aliases)
				result.types = annotated.table
				declared = annotated.type_id
			elif child_kind == Ast.NODE_ELSE_RETURN
				fallback = Hir.hir_ast_child(state.tree, child, 0)
			else
				initializer = child
		if initializer >= 0
			if declared != Types.TYPE_TAG_INVALID
				result = hir_body_expression_expected(result, initializer, declared)
			else
				result = hir_body_expression(result, initializer)
		result.error == "" else return result
		if fallback >= 0
			let wrapped = result.last_type
			result = hir_body_expression(result, fallback)
			result.error == "" else return result
			result.last_type = Types.TYPE_TAG_INVALID
			if wrapped != Types.TYPE_TAG_INVALID
				let descriptor = result.types.entries[!wrapped]
				if descriptor.tag != Types.TYPE_TAG_OPTIONAL
					return hir_body_error(result, id, "else return requires an Optional")
				result.last_type = descriptor.first
		if declared != Types.TYPE_TAG_INVALID and result.last_type != Types.TYPE_TAG_INVALID and declared != result.last_type and not Types.type_coercible(result.types, declared, result.last_type)
			return hir_body_error(result, id, "expected " + Resolve.hir_type_name(result.types, declared) + ", found " + Resolve.hir_type_name(result.types, result.last_type))
		if declared == Types.TYPE_TAG_INVALID
			declared = result.last_type
		if node.kind == Ast.NODE_LET and initializer >= 0 and fallback < 0
			# Evaluate before binding to preserve lexical shadowing.
			let fact = HirStaticFact(hir_static_array_literal(result, initializer), hir_index_range(result, initializer), hir_static_array_shape(result, initializer))
			result = hir_body_binding(result, id, Hir.hir_ast_text(state.tree, id), declared, false)
			if result.error == ""
				result.facts[!len(result.facts) - 1] = fact
			return result
		return hir_body_binding(result, id, Hir.hir_ast_text(state.tree, id), declared, node.kind == Ast.NODE_VAR)
	if node.kind == Ast.NODE_ASSIGN
		let lhs = Hir.hir_ast_child(state.tree, id, 0)
		let rhs = Hir.hir_ast_child(state.tree, id, 1)
		let target = state.tree.nodes[!lhs]
		var root = lhs
		while state.tree.nodes[!root].kind == Ast.NODE_ATTR or state.tree.nodes[!root].kind == Ast.NODE_CHECKED_INDEX
			root = Hir.hir_ast_child(state.tree, root, 0)
		if state.tree.nodes[!root].kind == Ast.NODE_NAME
			let name = Hir.hir_ast_text(state.tree, root)
			let resolved = Hir.resolve_hir_name(result.symbols, name)
			if resolved.error == ""
				if not result.symbols[!resolved.field_index].mutable
					if target.kind == Ast.NODE_CHECKED_INDEX
						return hir_body_error(result, id, "indexed update requires a mutable local array")
					return hir_body_error(result, id, "cannot assign immutable binding '" + name + "'")
		var target_type = Types.TYPE_TAG_INVALID
		if target.kind == Ast.NODE_NAME
			let binding = Hir.resolve_hir_name(result.symbols, Hir.hir_ast_text(state.tree, lhs))
			if binding.error == ""
				target_type = binding.type_id
		if target.kind == Ast.NODE_CHECKED_INDEX
			result = hir_body_expression(result, lhs)
			result.error == "" else return result
			target_type = result.last_type
		elif target.kind == Ast.NODE_ATTR and state.tree.nodes[!Hir.hir_ast_child(state.tree, lhs, 0)].kind != Ast.NODE_NAME
			# Nested targets can contain checked indices. Analyze their expressions
			# before MIR lowering so their literals and calls have typed HIR nodes.
			result = hir_body_expression(result, lhs)
			result.error == "" else return result
			target_type = result.last_type
		if target_type != Types.TYPE_TAG_INVALID
			result = hir_body_expression_expected(result, rhs, target_type)
		else
			result = hir_body_expression(result, rhs)
		if target_type != Types.TYPE_TAG_INVALID and result.last_type != Types.TYPE_TAG_INVALID and target_type != result.last_type
			if target.kind == Ast.NODE_CHECKED_INDEX
				return hir_body_error(result, id, "indexed assignment type mismatch")
			return hir_body_error(result, id, "expected " + Resolve.hir_type_name(result.types, target_type) + ", found " + Resolve.hir_type_name(result.types, result.last_type))
		if target.kind == Ast.NODE_NAME
			let resolved = Hir.resolve_hir_name(result.symbols, Hir.hir_ast_text(state.tree, lhs))
			if resolved.error == "" and result.last_type != Types.TYPE_TAG_INVALID and resolved.type_id != Types.TYPE_TAG_INVALID and resolved.type_id != result.last_type
				return hir_body_error(result, id, "expected " + Resolve.hir_type_name(result.types, resolved.type_id) + ", found " + Resolve.hir_type_name(result.types, result.last_type))
		result.nodes = result.nodes.append(Hir.HirNode(id, HIR_ASSIGN, result.last_type, -1))
		return result
	if node.kind == Ast.NODE_IF
		for i in 0..node.count
			let arm = Hir.hir_ast_child(state.tree, id, i)
			let branch = state.tree.nodes[!arm]
			if branch.kind == Ast.NODE_ELSE
				result = hir_body_block(result, Hir.hir_ast_child(state.tree, arm, 0))
			else
				result = hir_body_expression(result, Hir.hir_ast_child(state.tree, arm, 0))
				result = hir_body_block(result, Hir.hir_ast_child(state.tree, arm, 1))
		return result
	if node.kind == Ast.NODE_WHILE
		result = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, 0))
		return hir_body_block(result, Hir.hir_ast_child(state.tree, id, 1))
	if node.kind == Ast.NODE_FOR
		let iterable = Hir.hir_ast_child(state.tree, id, node.count - 2)
		result = hir_body_expression(result, iterable)
		let initial = len(result.symbols)
		result.depth += 1
		var item_type = Types.TYPE_TAG_INVALID
		if result.tree.nodes[!iterable].kind == Ast.NODE_BINARY and Hir.hir_ast_text(result.tree, iterable) == ".."
			item_type = Types.TYPE_TAG_I64
		elif result.last_type != Types.TYPE_TAG_INVALID and Types.type_tag(result.types, result.last_type) == Types.TYPE_TAG_ARRAY
			item_type = result.types.entries[!result.last_type].first
		var loop_range = hir_unknown_range()
		if result.tree.nodes[!iterable].kind == Ast.NODE_BINARY and Hir.hir_ast_text(result.tree, iterable) == ".."
			let start = hir_index_range(result, Hir.hir_ast_child(result.tree, iterable, 0))
			let end = hir_index_range(result, Hir.hir_ast_child(result.tree, iterable, 1))
			if start.low >= 0 and end.low > 0 and start.low < end.high
				loop_range = HirIndexRange(start.low, end.high - 1)
		result = hir_body_binding(result, id, Hir.hir_ast_text(state.tree, id), item_type, false)
		if result.error == "" and item_type == Types.TYPE_TAG_I64
			result.facts[!len(result.facts) - 1] = HirStaticFact(-1, loop_range, Array[i64]())
		result = hir_body_block(result, Hir.hir_ast_child(state.tree, id, node.count - 1))
		var symbols = Array[Hir.SymbolInfo]()
		for i in 0..initial
			symbols = symbols.append(result.symbols[!i])
		result.symbols = symbols
		var facts = Array[HirStaticFact]()
		for i in 0..initial
			facts = facts.append(result.facts[!i])
		result.facts = facts
		result.depth -= 1
		return result
	if node.kind == Ast.NODE_GUARD
		result = hir_body_expression(result, Hir.hir_ast_child(state.tree, id, 0))
		if result.last_type != Types.TYPE_TAG_INVALID and result.last_type != Types.TYPE_TAG_BOOL
			return hir_body_error(result, id, "expected bool, found " + Resolve.hir_type_name(result.types, result.last_type))
		let exit_node = Hir.hir_ast_child(state.tree, id, 1)
		return hir_body_statement(result, exit_node)
	if node.kind == Ast.NODE_RETURN or node.kind == Ast.NODE_EXPR or node.kind == Ast.NODE_RECUR
		for i in 0..node.count
			let child = Hir.hir_ast_child(state.tree, id, i)
			if node.kind == Ast.NODE_RETURN and result.expected_return != Types.TYPE_TAG_INVALID
				result = hir_body_expression_expected(result, child, result.expected_return)
			else
				result = hir_body_expression(result, child)
		if node.kind == Ast.NODE_RETURN and result.last_type != Types.TYPE_TAG_INVALID
			var returned = result.last_type
			if result.expected_return != Types.TYPE_TAG_INVALID and Types.type_coercible(result.types, result.expected_return, returned)
				returned = result.expected_return
			if result.inferred_return != Types.TYPE_TAG_INVALID and result.inferred_return != returned
				return hir_body_error(result, id, "inconsistent return types")
			result.inferred_return = returned
		return result
	return result

export def hir_analyze_function_body(tree: Ast.ParseState, header: Hir.HirFunctionDecl, names: Array[string], constants: Array[string]) -> HirBodyAnalysis
	var state = new_hir_body_state(tree, names, constants, Types.new_type_table())
	for parameter in header.parameters
		var type_id = Types.TYPE_TAG_INVALID
		if parameter.type_node >= 0
			let annotated = hir_module_type_reference(state.types, tree, parameter.type_node, state.functions)
			state.types = annotated.table
			type_id = annotated.type_id
		state = hir_body_binding(state, parameter.source, parameter.name, type_id, false)
	if state.error == ""
		state = hir_body_block(state, header.body)
	return HirBodyAnalysis(state.nodes, state.error, state.error_line)

# The module-level entry point shares the declaration table with the body
# analyzer, enabling concrete user calls before C generation begins.
export def hir_analyze_module_body(tree: Ast.ParseState, header: Hir.HirFunctionDecl, functions: Array[Hir.HirFunctionDecl], constants: Array[string]) -> HirBodyAnalysis
	var names = Array[string]()
	for function in functions
		names = names.append(function.name)
	var state = new_hir_body_state(tree, names, constants, Types.new_type_table())
	state.functions = functions
	state.active_functions = [header.name]
	for parameter in header.parameters
		var type_id = Types.TYPE_TAG_INVALID
		if parameter.type_node >= 0
			let annotated = hir_module_type_reference(state.types, tree, parameter.type_node, state.functions)
			state.types = annotated.table
			type_id = annotated.type_id
		state = hir_body_binding(state, parameter.source, parameter.name, type_id, false)
	if state.error == ""
		state = hir_body_block(state, header.body)
	return HirBodyAnalysis(state.nodes, state.error, state.error_line)
