import types alias Types
import parser alias Ast
import hir alias Hir
import hir_resolve alias Resolve
import hir_analyze alias Analyze
import hir_declarations alias Decl

# HIR owns concrete specialization analysis, independent of the MIR and C
# backends. A worklist slot is a stable specialization ID; recursion and
# duplicate signatures reuse existing IN_PROGRESS entries.

export rec HirConcreteBody(nodes: Array[Hir.HirNode], requests: Array[Analyze.HirSpecializationRequest], types: Types.TypeTable, return_type: i64, error: string, error_line: i64)
# Bodies are in specialization-ID order; the array index is the ID.
export rec HirSpecializedFunction(nodes: Array[Hir.HirNode], calls: Array[Hir.HirSpecializedCall], return_type: i64)
export rec HirSpecializedRoot(name: string, function_id: i64)
export rec HirSpecializedProgram(registry: Hir.HirSpecializationRegistry, bodies: Array[HirSpecializedFunction], types: Types.TypeTable, entry: i64, error: string, roots: Array[HirSpecializedRoot])

export def new_hir_specialized_program(registry: Hir.HirSpecializationRegistry, bodies: Array[HirSpecializedFunction], types: Types.TypeTable, entry: i64, error: string) -> HirSpecializedProgram
	return HirSpecializedProgram(registry, bodies, types, entry, error, Array[HirSpecializedRoot]())

export def hir_concrete_body(tree: Ast.ParseState, header: Hir.HirFunctionDecl, functions: Array[Hir.HirFunctionDecl], constants: Array[Hir.HirModuleConstant], types: Types.TypeTable, arguments: Array[i64], aliases: Array[Hir.HirTypeAlias]) -> HirConcreteBody
	var names = Array[string]()
	for function in functions
		names = names.append(function.name)
	var state = Analyze.new_hir_body_state(tree, names, Array[string](), types)
	state.functions = functions
	state.module_constants = constants
	state.type_aliases = aliases
	state.active_functions = [header.name]
	state.collect_calls = true
	if header.result_type_node >= 0
		let expected = Analyze.hir_module_type_reference_with_constants(state.types, tree, header.result_type_node, functions, constants, aliases)
		state.types = expected.table
		state.expected_return = expected.type_id
	if len(arguments) != len(header.parameters)
		return HirConcreteBody(state.nodes, state.requests, state.types, Types.TYPE_TAG_INVALID, "specialization argument count mismatch", Hir.hir_ast_line(tree, header.source))
	for i in 0..len(arguments)
		let parameter = header.parameters[!i]
		if parameter.type_node >= 0
			let annotation = Analyze.hir_module_type_reference_with_constants(state.types, tree, parameter.type_node, functions, constants, aliases)
			state.types = annotation.table
			if annotation.type_id != Types.TYPE_TAG_INVALID and annotation.type_id != arguments[!i]
				state = Analyze.hir_body_error(state, parameter.source, "specialization argument type mismatch")
		if state.error != ""
			break
		state = Analyze.hir_body_binding(state, parameter.source, parameter.name, arguments[!i], false)
	if state.error == ""
		state = Analyze.hir_body_block(state, header.body)
	var result_type = state.inferred_return
	if state.error == "" and header.result_type_node >= 0
		let declared = Analyze.hir_module_type_reference_with_constants(state.types, tree, header.result_type_node, functions, constants, aliases)
		state.types = declared.table
		if declared.type_id != Types.TYPE_TAG_INVALID
			if result_type != Types.TYPE_TAG_INVALID and result_type != declared.type_id and Types.union_alternative_index(state.types, declared.type_id, result_type) < 0
				state = Analyze.hir_body_error(state, header.source, "expected " + Resolve.hir_type_name(state.types, declared.type_id) + ", found " + Resolve.hir_type_name(state.types, result_type))
			result_type = declared.type_id
	return HirConcreteBody(state.nodes, state.requests, state.types, result_type, state.error, state.error_line)

export def hir_definition(functions: Array[Hir.HirFunctionDecl], definition: i64) -> i64
	for i in 0..len(functions)
		if functions[!i].body == definition
			return i
	return -1

# Body analysis runs once per canonical signature; no recursive traversal
# of other function bodies is performed by the worklist.
export def hir_specialize_program_roots(tree: Ast.ParseState, declarations: Hir.HirModuleDecl, names: Array[string], arguments: Array[i64]) -> HirSpecializedProgram
	var registry = Hir.new_hir_specializations()
	var bodies = Array[HirSpecializedFunction]()
	var types = declarations.types
	var entry = -1
	var roots = Array[HirSpecializedRoot]()
	for name in names
		var found = false
		for declaration in declarations.functions
			if declaration.name == name and not declaration.constructor
				var concrete = arguments
				if len(arguments) == 0 and len(declaration.parameters) != 0
					concrete = Array[i64]()
					for parameter in declaration.parameters
						if parameter.type_node < 0
							return new_hir_specialized_program(registry, bodies, types, entry, "exported function parameters require annotations")
						let annotated = Analyze.hir_module_type_reference_with_constants(types, tree, parameter.type_node, declarations.functions, declarations.constants, declarations.type_aliases)
						types = annotated.table
						if annotated.type_id == Types.TYPE_TAG_INVALID
							return new_hir_specialized_program(registry, bodies, types, entry, "unsupported exported parameter type")
						concrete = concrete.append(annotated.type_id)
				let started = Hir.hir_begin_specialization(registry, declaration.body, concrete, Types.TYPE_TAG_INVALID)
				registry = started.registry
				roots = roots.append(HirSpecializedRoot(name, started.index))
				if entry < 0
					entry = started.index
				found = true
		if not found
			return new_hir_specialized_program(registry, bodies, types, -1, "unknown HIR entry function '" + name + "'")
	var cursor = 0
	while cursor < len(registry.entries)
		let spec = registry.entries[!cursor]
		let definition = hir_definition(declarations.functions, spec.definition)
		if definition < 0
			return new_hir_specialized_program(registry, bodies, types, entry, "missing specialization declaration")
		let header = declarations.functions[!definition]
		if header.constructor
			return new_hir_specialized_program(registry, bodies, types, entry, "constructor specialization not supported yet")
		var typed = HirConcreteBody(Array[Hir.HirNode](), Array[Analyze.HirSpecializationRequest](), types, Types.TYPE_TAG_INVALID, "", 0)
		if Decl.hir_function_external(tree, header)
			if len(header.parameters) != len(spec.arguments)
				return new_hir_specialized_program(registry, bodies, types, entry, "external specialization arity mismatch")
			if header.external
				for i in 0..len(spec.arguments)
					if header.argument_types[!i] != Types.TYPE_TAG_INVALID and header.argument_types[!i] != spec.arguments[!i]
						return new_hir_specialized_program(registry, bodies, types, entry, "external specialization type mismatch")
				typed.return_type = header.result_type
			else
				for i in 0..len(header.parameters)
					let declared = Analyze.hir_module_type_reference_with_constants(typed.types, tree, header.parameters[!i].type_node, declarations.functions, declarations.constants, declarations.type_aliases)
					typed.types = declared.table
					if declared.type_id == Types.TYPE_TAG_INVALID or declared.type_id != spec.arguments[!i]
						return new_hir_specialized_program(registry, bodies, types, entry, "external specialization type mismatch")
				let declared = Analyze.hir_module_type_reference_with_constants(typed.types, tree, header.result_type_node, declarations.functions, declarations.constants, declarations.type_aliases)
				typed.types = declared.table
				typed.return_type = declared.type_id
		else
			typed = hir_concrete_body(tree, header, declarations.functions, declarations.constants, types, spec.arguments, declarations.type_aliases)
		types = typed.types
		if typed.error != ""
			return new_hir_specialized_program(registry, bodies, types, entry, typed.error)
		if typed.return_type == Types.TYPE_TAG_INVALID
			return new_hir_specialized_program(registry, bodies, types, entry, "cannot infer specialized function return type")
		var calls = Array[Hir.HirSpecializedCall]()
		for request in typed.requests
			let called = hir_definition(declarations.functions, request.definition)
			if called < 0
				return new_hir_specialized_program(registry, bodies, types, entry, "unknown specialized callee")
			let callee = declarations.functions[!called]
			var result_type = Types.TYPE_TAG_INVALID
			var recursive = false
			if callee.external
				result_type = callee.result_type
			elif callee.result_type_node >= 0
				let declared = Analyze.hir_module_type_reference_with_constants(types, tree, callee.result_type_node, declarations.functions, declarations.constants, declarations.type_aliases)
				types = declared.table
				result_type = declared.type_id
			else
				let inferred = hir_concrete_body(tree, callee, declarations.functions, declarations.constants, types, request.arguments, declarations.type_aliases)
				types = inferred.types
				if inferred.error != ""
					return new_hir_specialized_program(registry, bodies, types, entry, inferred.error)
				result_type = inferred.return_type
				for nested in inferred.requests
					if nested.definition == callee.body
						recursive = true
			if result_type == Types.TYPE_TAG_INVALID
				if recursive
					return new_hir_specialized_program(registry, bodies, types, entry, "recursive generic call requires an explicit return type")
				return new_hir_specialized_program(registry, bodies, types, entry, "cannot infer function return type")
			let started = Hir.hir_begin_specialization(registry, request.definition, request.arguments, result_type)
			registry = started.registry
			calls = calls.append(Hir.HirSpecializedCall(request.source, started.index))
		bodies = bodies.append(HirSpecializedFunction(typed.nodes, calls, typed.return_type))
		registry = Hir.hir_complete_specialization(registry, cursor, typed.return_type)
		cursor += 1
	var result = new_hir_specialized_program(registry, bodies, types, entry, "")
	result.roots = roots
	return result

# Preserve the existing single-entry API for typed specialization tests.
export def hir_specialize_program(tree: Ast.ParseState, declarations: Hir.HirModuleDecl, name: string, arguments: Array[i64]) -> HirSpecializedProgram
	return hir_specialize_program_roots(tree, declarations, [name], arguments)
