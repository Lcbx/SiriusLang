# HIR owns concrete specialization analysis, independent of the MIR and C
# backends. A worklist slot is a stable specialization ID; recursion and
# duplicate signatures reuse existing IN_PROGRESS entries.

rec HirConcreteBody(nodes: Array[HirNode], requests: Array[HirSpecializationRequest], types: TypeTable, return_type: i64, error: string, error_line: i64)
# Bodies are in specialization-ID order; the array index is the ID.
rec HirSpecializedFunction(nodes: Array[HirNode], calls: Array[HirSpecializedCall], return_type: i64)
rec HirSpecializedProgram(registry: HirSpecializationRegistry, bodies: Array[HirSpecializedFunction], types: TypeTable, entry: i64, error: string)

def hir_concrete_body(tree: ParseState, header: HirFunctionDecl, functions: Array[HirFunctionDecl], constants: Array[HirModuleConstant], types: TypeTable, arguments: Array[i64]) -> HirConcreteBody
	var names = Array[string]()
	for function in functions
		names = names.append(function.name)
	var state = HirBodyState(tree, names, Array[string](), types)
	state.functions = functions
	state.module_constants = constants
	state.active_functions = [header.name]
	state.collect_calls = true
	if len(arguments) != len(header.parameters)
		return HirConcreteBody(state.nodes, state.requests, state.types, TYPE_TAG_INVALID, "specialization argument count mismatch", hir_ast_line(tree, header.source))
	for i in 0..len(arguments)
		let parameter = header.parameters[!i]
		if parameter.type_node >= 0
			let annotation = hir_module_type_reference_with_constants(state.types, tree, parameter.type_node, functions, constants)
			state.types = annotation.table
			if annotation.type_id != TYPE_TAG_INVALID and annotation.type_id != arguments[!i]
				state = hir_body_error(state, parameter.source, "specialization argument type mismatch")
		if state.error != ""
			break
		state = hir_body_binding(state, parameter.source, parameter.name, arguments[!i], false)
	if state.error == ""
		state = hir_body_block(state, header.body)
	var result_type = state.inferred_return
	if state.error == "" and header.result_type_node >= 0
		let declared = hir_module_type_reference_with_constants(state.types, tree, header.result_type_node, functions, constants)
		state.types = declared.table
		if declared.type_id != TYPE_TAG_INVALID
			if result_type != TYPE_TAG_INVALID and result_type != declared.type_id
				state = hir_body_error(state, header.source, "expected " + hir_type_name(state.types, declared.type_id) + ", found " + hir_type_name(state.types, result_type))
			result_type = declared.type_id
	return HirConcreteBody(state.nodes, state.requests, state.types, result_type, state.error, state.error_line)

def hir_definition(functions: Array[HirFunctionDecl], definition: i64) -> i64
	for i in 0..len(functions)
		if functions[!i].body == definition
			return i
	return -1

# Body analysis runs once per canonical signature; no recursive traversal
# of other function bodies is performed by the worklist.
def hir_specialize_program(tree: ParseState, declarations: HirModuleDecl, name: string, arguments: Array[i64]) -> HirSpecializedProgram
	var registry = new_hir_specializations()
	var bodies = Array[HirSpecializedFunction]()
	var types = declarations.types
	var entry = -1
	for declaration in declarations.functions
		if declaration.name == name and not declaration.constructor
			let started = hir_begin_specialization(registry, declaration.body, arguments, TYPE_TAG_INVALID)
			registry = started.registry
			entry = started.index
	if entry < 0
		return HirSpecializedProgram(registry, bodies, types, -1, "unknown HIR entry function '" + name + "'")
	var cursor = 0
	while cursor < len(registry.entries)
		let spec = registry.entries[!cursor]
		let definition = hir_definition(declarations.functions, spec.definition)
		if definition < 0
			return HirSpecializedProgram(registry, bodies, types, entry, "missing specialization declaration")
		let header = declarations.functions[!definition]
		if header.constructor
			return HirSpecializedProgram(registry, bodies, types, entry, "constructor specialization not supported yet")
		let typed = hir_concrete_body(tree, header, declarations.functions, declarations.constants, types, spec.arguments)
		types = typed.types
		if typed.error != ""
			return HirSpecializedProgram(registry, bodies, types, entry, typed.error)
		if typed.return_type == TYPE_TAG_INVALID
			return HirSpecializedProgram(registry, bodies, types, entry, "cannot infer specialized function return type")
		var calls = Array[HirSpecializedCall]()
		for request in typed.requests
			let called = hir_definition(declarations.functions, request.definition)
			if called < 0
				return HirSpecializedProgram(registry, bodies, types, entry, "unknown specialized callee")
			let callee = declarations.functions[!called]
			var result_type = TYPE_TAG_INVALID
			var recursive = false
			if callee.result_type_node >= 0
				let declared = hir_module_type_reference_with_constants(types, tree, callee.result_type_node, declarations.functions, declarations.constants)
				types = declared.table
				result_type = declared.type_id
			else
				let inferred = hir_concrete_body(tree, callee, declarations.functions, declarations.constants, types, request.arguments)
				types = inferred.types
				if inferred.error != ""
					return HirSpecializedProgram(registry, bodies, types, entry, inferred.error)
				result_type = inferred.return_type
				for nested in inferred.requests
					if nested.definition == callee.body
						recursive = true
			if result_type == TYPE_TAG_INVALID
				if recursive
					return HirSpecializedProgram(registry, bodies, types, entry, "recursive generic call requires an explicit return type")
				return HirSpecializedProgram(registry, bodies, types, entry, "cannot infer function return type")
			let started = hir_begin_specialization(registry, request.definition, request.arguments, result_type)
			registry = started.registry
			calls = calls.append(HirSpecializedCall(request.source, started.index))
		bodies = bodies.append(HirSpecializedFunction(typed.nodes, calls, typed.return_type))
		registry = hir_complete_specialization(registry, cursor, typed.return_type)
		cursor += 1
	return HirSpecializedProgram(registry, bodies, types, entry, "")
