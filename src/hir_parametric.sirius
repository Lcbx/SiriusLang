import types alias Types
import parser alias Ast
import hir alias Hir
import hir_resolve alias Resolve
import hir_analyze alias Analyze

# Test-only symbolic HIR planner for immutable locals, simple calls and returns.
# Negative type IDs below -1 represent argument type parameters. Production
# compilation uses the concrete HIR analyzer and specialization worklist.

export rec HirParametricExpression(nodes: Array[Hir.HirNode], type_id: i64, valid: bool)
export rec HirParametricBody(definition: i64, nodes: Array[Hir.HirNode], result_type: i64)

export def hir_parametric_expression(tree: Ast.ParseState, header: Hir.HirFunctionDecl, functions: Array[Hir.HirFunctionDecl], id: i64, locals: Array[string], local_types: Array[i64]) -> HirParametricExpression
	let node = tree.nodes[!id]
	let literal = Hir.resolve_hir_literal(node.kind)
	if literal != Types.TYPE_TAG_INVALID
		return HirParametricExpression([Hir.HirNode(id, Hir.HIR_LITERAL, literal, -1)], literal, true)
	if node.kind == Ast.NODE_NAME
		let name = Hir.hir_ast_text(tree, id)
		for offset in 0..len(locals)
			let i = len(locals) - 1 - offset
			if locals[!i] == name
				return HirParametricExpression([Hir.HirNode(id, Hir.HIR_NAME, local_types[!i], len(header.parameters) + i)], local_types[!i], true)
		for offset in 0..len(header.parameters)
			let i = len(header.parameters) - 1 - offset
			if header.parameters[!i].name == name
				let type_id = -2 - i
				return HirParametricExpression([Hir.HirNode(id, Hir.HIR_NAME, type_id, i)], type_id, true)
	if node.kind == Ast.NODE_ATTR and node.count == 1
		let owner = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, id, 0), locals, local_types)
		if owner.valid
			return HirParametricExpression(owner.nodes.append(Hir.HirNode(id, Hir.HIR_FIELD, Types.TYPE_TAG_INVALID, -1)), Types.TYPE_TAG_INVALID, true)
	if node.kind == Ast.NODE_RECORD and node.count > 0
		var nodes = Array[Hir.HirNode]()
		for i in 0..node.count
			let field_id = Hir.hir_ast_child(tree, id, i)
			if tree.nodes[!field_id].kind != Ast.NODE_FIELD
				return HirParametricExpression(Array[Hir.HirNode](), Types.TYPE_TAG_INVALID, false)
			let value = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, field_id, 0), locals, local_types)
			if not value.valid
				return HirParametricExpression(Array[Hir.HirNode](), Types.TYPE_TAG_INVALID, false)
			for typed in value.nodes
				nodes = nodes.append(typed)
		return HirParametricExpression(nodes.append(Hir.HirNode(id, Resolve.HIR_RECORD, Types.TYPE_TAG_INVALID, -1)), Types.TYPE_TAG_INVALID, true)
	if node.kind == Ast.NODE_ARRAY
		var nodes = Array[Hir.HirNode]()
		for i in 0..node.count
			let value = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, id, i), locals, local_types)
			if not value.valid
				return HirParametricExpression(Array[Hir.HirNode](), Types.TYPE_TAG_INVALID, false)
			for typed in value.nodes
				nodes = nodes.append(typed)
		return HirParametricExpression(nodes.append(Hir.HirNode(id, Analyze.HIR_ARRAY, Types.TYPE_TAG_INVALID, -1)), Types.TYPE_TAG_INVALID, true)
	if node.kind == Ast.NODE_CALL and node.count >= 1
		let callee = Hir.hir_ast_child(tree, id, 0)
		if tree.nodes[!callee].kind == Ast.NODE_NAME
			let name = Hir.hir_ast_text(tree, callee)
			var supported = name == "len" or name == "str" or name == "sqrt" or name == "f64" or name == "i64" or name == "empty_array_like"
			if not supported
				for function in functions
					if function.name == name and not function.constructor
						supported = true
				for local in locals
					if local == name
						supported = false
				for parameter in header.parameters
					if parameter.name == name
						supported = false
			if supported
				var nodes = Array[Hir.HirNode]()
				for i in 1..node.count
					let argument = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, id, i), locals, local_types)
					if not argument.valid
						return HirParametricExpression(Array[Hir.HirNode](), Types.TYPE_TAG_INVALID, false)
					for typed in argument.nodes
						nodes = nodes.append(typed)
				return HirParametricExpression(nodes.append(Hir.HirNode(id, Resolve.HIR_CALL, Types.TYPE_TAG_INVALID, -1)), Types.TYPE_TAG_INVALID, true)
	if node.kind == Ast.NODE_BINARY and node.count == 2
		let lhs = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, id, 0), locals, local_types)
		let rhs = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, id, 1), locals, local_types)
		if lhs.valid and rhs.valid
			let operator = Hir.hir_ast_text(tree, id)
			if operator != "+" and operator != "-" and operator != "*" and operator != "/" and operator != "%" and operator != "and" and operator != "or" and operator != "==" and operator != "!=" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
				return HirParametricExpression(Array[Hir.HirNode](), Types.TYPE_TAG_INVALID, false)
			var result_type = lhs.type_id
			if operator == "==" or operator == "!=" or operator == "<" or operator == "<=" or operator == ">" or operator == ">=" or operator == "and" or operator == "or"
				result_type = Types.TYPE_TAG_BOOL
			var nodes = lhs.nodes
			for typed in rhs.nodes
				nodes = nodes.append(typed)
			return HirParametricExpression(nodes.append(Hir.HirNode(id, Hir.HIR_BINARY, result_type, -1)), result_type, true)
	if node.kind == Ast.NODE_UNARY and node.count == 1
		let value = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, id, 0), locals, local_types)
		if value.valid
			let operator = Hir.hir_ast_text(tree, id)
			if operator != "-" and operator != "+" and operator != "not"
				return HirParametricExpression(Array[Hir.HirNode](), Types.TYPE_TAG_INVALID, false)
			var result_type = value.type_id
			if Hir.hir_ast_text(tree, id) == "not"
				result_type = Types.TYPE_TAG_BOOL
			return HirParametricExpression(value.nodes.append(Hir.HirNode(id, Hir.HIR_UNARY, result_type, -1)), result_type, true)
	return HirParametricExpression(Array[Hir.HirNode](), Types.TYPE_TAG_INVALID, false)

export def hir_parametric_plan(tree: Ast.ParseState, header: Hir.HirFunctionDecl, functions: Array[Hir.HirFunctionDecl]) -> HirParametricBody
	let empty = HirParametricBody(header.body, Array[Hir.HirNode](), Types.TYPE_TAG_INVALID)
	if header.external or header.constructor or header.result_type_node >= 0
		return empty
	for param in header.parameters
		if param.type_node >= 0
			return empty
	let block = tree.nodes[!header.body]
	if block.kind != Ast.NODE_BLOCK or block.count == 0
		return empty
	var nodes = Array[Hir.HirNode]()
	var locals = Array[string]()
	var local_types = Array[i64]()
	for i in 0..block.count
		let statement = Hir.hir_ast_child(tree, header.body, i)
		let kind = tree.nodes[!statement].kind
		if kind == Ast.NODE_LET and i + 1 < block.count and tree.nodes[!statement].count == 1
			let name = Hir.hir_ast_text(tree, statement)
			for previous in locals
				if previous == name
					return empty
			let value = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, statement, 0), locals, local_types)
			if not value.valid
				return empty
			for typed in value.nodes
				nodes = nodes.append(typed)
			nodes = nodes.append(Hir.HirNode(statement, Analyze.HIR_BINDING, value.type_id, len(header.parameters) + len(locals)))
			locals = locals.append(name)
			local_types = local_types.append(value.type_id)
		elif kind == Ast.NODE_IF and i + 1 < block.count and tree.nodes[!statement].count == 1
			# A single early-return arm has no branch-local bindings to escape.
			let arm_id = Hir.hir_ast_child(tree, statement, 0)
			let arm = tree.nodes[!arm_id]
			if arm.kind != Ast.NODE_ARM or arm.count != 2
				return empty
			let branch_id = Hir.hir_ast_child(tree, arm_id, 1)
			let branch = tree.nodes[!branch_id]
			if branch.kind != Ast.NODE_BLOCK or branch.count != 1
				return empty
			let returned_id = Hir.hir_ast_child(tree, branch_id, 0)
			if tree.nodes[!returned_id].kind != Ast.NODE_RETURN or tree.nodes[!returned_id].count != 1
				return empty
			let condition = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, arm_id, 0), locals, local_types)
			let returned = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, returned_id, 0), locals, local_types)
			if not condition.valid or not returned.valid
				return empty
			for typed in condition.nodes
				nodes = nodes.append(typed)
			for typed in returned.nodes
				nodes = nodes.append(typed)
		elif kind == Ast.NODE_RETURN and i + 1 == block.count and tree.nodes[!statement].count == 1
			let result = hir_parametric_expression(tree, header, functions, Hir.hir_ast_child(tree, statement, 0), locals, local_types)
			if not result.valid
				return empty
			for typed in result.nodes
				nodes = nodes.append(typed)
			return HirParametricBody(header.body, nodes, result.type_id)
		else
			return empty
	return empty
