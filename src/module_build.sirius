import hir alias Hir
import mir alias Mir
import mir_bundle alias MirBundle
import mir_generic alias MirGeneric
import mir_library alias MirLibrary
import mir_link alias MirLink
import mir_program alias MirProgram
import module alias Module
import module_interface alias ModuleInterface
import module_resolve alias ModuleResolve
import module_scan alias ModuleScan
import parser alias Parser
import types alias Types
# Compile scanned source modules, specializing imported generics on demand.
# Concrete MIR libraries are linked only after all referenced specializations
# have been emitted from their defining module.
rec ModuleBuildResult(entry: string, error: string)

def module_build_compile(unit: ModuleScan.ModuleScanUnit, units: Array[ModuleScan.ModuleScanUnit], roots: Array[string], arguments: Array[i64], generic: bool, caller_types: Types.TypeTable) -> MirLibrary.ModuleBuildCompiled
	let imported = ModuleScan.module_scan_import_declarations(unit.declarations, units)
	if imported.error != ""
		return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(imported.error), imported.error)
	var declarations = imported.declarations
	var concrete = arguments
	if generic
		concrete = Array[i64]()
		var types = declarations.types
		for argument in arguments
			let mapped = ModuleInterface.module_import_type(types, caller_types, argument)
			if mapped.id == Types.TYPE_TAG_INVALID
				return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure("unsupported generic argument type"), "unsupported generic argument type")
			types = mapped.table
			concrete = concrete.append(mapped.id)
		declarations.types = types
	let bodies = ModuleScan.module_scan_import_constructor_bodies(unit.tree, declarations, units)
	if bodies.error != ""
		return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(bodies.error), bodies.error)
	declarations = bodies.declarations
	let inferred = ModuleScan.module_scan_import_inferred_bodies(bodies.tree, declarations, units)
	if inferred.error != ""
		return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(inferred.error), inferred.error)
	declarations = inferred.declarations
	let resolved = ModuleResolve.hir_resolve_module_calls(inferred.tree, declarations)
	if resolved.error != ""
		let message = str(resolved.line) + ": " + resolved.error
		return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(message), message)
	let lowered = MirProgram.mir_build_program_roots(resolved.tree, declarations, roots, concrete)
	if lowered.error != ""
		return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(lowered.error), lowered.error)
	var exports = Array[Mir.MirNamedExport]()
	for exported in lowered.exports
		var symbol = Module.hir_module_symbol(unit.name, exported.name)
		if generic
			symbol = Module.mir_generic_symbol(symbol, lowered.program.types, concrete)
		else
			var overload_count = 0
			for signature in unit.exports
				if signature.name == exported.name and not signature.constructor and not signature.generic and signature.origin == ""
					overload_count += 1
			if overload_count > 1
				let function = lowered.program.functions[!exported.function_id]
				var arguments = Array[i64]()
				for i in 0..function.argument_count
					arguments = arguments.append(function.register_types[!i])
				symbol = Module.mir_overload_symbol(symbol, lowered.program.types, arguments)
		exports = exports.append(Mir.MirNamedExport(symbol, exported.function_id))
	let library = MirLibrary.MirLibraryLoad(lowered.program, exports, "", lowered.imports)
	return MirLibrary.ModuleBuildCompiled(library, "")

# Find a generic definition matching the import's canonical type signature.
# Each distinct concrete signature is compiled once, even if many modules use it.
def module_build_specialization(units: Array[ModuleScan.ModuleScanUnit], library: MirLibrary.MirLibraryLoad, imported: Mir.MirNamedImport) -> MirLibrary.ModuleBuildCompiled
	let function = library.program.functions[!imported.function_id]
	var arguments = Array[i64]()
	for i in 0..function.argument_count
		arguments = arguments.append(function.register_types[!i])
	for unit in units
		for exported in unit.exports
			if exported.origin != "" or not exported.generic
				continue
			let name = Module.hir_module_symbol(unit.name, exported.name)
			if Module.mir_generic_symbol(name, library.program.types, arguments) != imported.name
				continue
			return module_build_compile(unit, units, [exported.name], arguments, true, library.program.types)
	return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(""), "")

# Finish a module after all its imports. Dependency order and public interface
# validation are shared by source modules and serialized generic packages.
def module_build_visit_imports(root: string, name: string, path: string, tree: Parser.ParseState, declarations: Hir.HirModuleDecl, requirements: Array[MirGeneric.MirGenericDependency], packaged: bool, visiting: Array[string], state: ModuleScan.ModuleScanCached, bundles: Array[MirBundle.MirBundlePackage]) -> ModuleScan.ModuleScanCached
	var current = state
	let stack = visiting.append(name)
	for imported in declarations.imports
		if ModuleScan.module_scan_reserved(imported.alias)
			return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(current.result.visited, name + ": invalid import alias: " + imported.alias, current.result.units), current.cache)
		current = module_build_visit(root, imported.path, stack, current, bundles)
		if current.result.error != ""
			return current
	if packaged
		for requirement in requirements
			var verified = false
			for unit in current.result.units
				if unit.name == requirement.name
					let actual = MirGeneric.mir_generic_interface(unit)
					if actual != requirement.signature
						return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(current.result.visited, "generic package dependency interface mismatch: " + name + " -> " + requirement.name, current.result.units), current.cache)
					verified = true
			if not verified
				return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(current.result.visited, "missing generic package dependency: " + requirement.name, current.result.units), current.cache)
	let resolved = ModuleScan.module_scan_complete(name, path, tree, declarations, current.result.visited, current.result.units)
	return ModuleScan.ModuleScanCached(resolved, current.cache)

# Walk the dependency graph once. Source takes precedence over packages, and
# visiting detects cycles including source/package combinations.
def module_build_visit(root: string, name: string, visiting: Array[string], state: ModuleScan.ModuleScanCached, bundles: Array[MirBundle.MirBundlePackage]) -> ModuleScan.ModuleScanCached
	let previous = state.result
	if not ModuleScan.module_scan_path_valid(name)
		return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(previous.visited, "invalid module path: " + name, previous.units), state.cache)
	for current in visiting
		if current == name
			var chain = ""
			for part in visiting
				if chain != ""
					chain += " -> "
				chain += part
			return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(previous.visited, "cyclic module imports: " + chain + " -> " + name, previous.units), state.cache)
	for completed in previous.visited
		if completed == name
			return state
	let source_path = Module.module_scan_filename(root, name)
	let parsed = ModuleScan.module_scan_parse_cached(root, name, state.cache)
	var missing_error = ""
	match parsed.outcome
		ModuleScan.ModuleSourceFound(index)
			let source = parsed.cache.sources[!index]
			return module_build_visit_imports(root, name, source_path, source.tree, source.declarations, Array[MirGeneric.MirGenericDependency](), false, visiting, ModuleScan.ModuleScanCached(previous, parsed.cache), bundles)
		ModuleScan.ModuleSourceInvalid(message)
			return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(previous.visited, message, previous.units), parsed.cache)
		ModuleScan.ModuleSourceMissing(message)
			missing_error = message
	let package_path = source_path.slice(0, len(source_path) - 7) + ".smirg"
	var serialized = read_text(package_path) or ""
	if serialized == ""
		for bundle in bundles
			if bundle.name == name
				serialized = bundle.contents
	if serialized == ""
		return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(previous.visited, missing_error, previous.units), parsed.cache)
	let archive = MirBundle.mir_bundle_read(serialized)
	if archive.error != ""
		return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(previous.visited, "invalid generic bundle " + name + ": " + archive.error, previous.units), parsed.cache)
	let loaded = MirGeneric.mir_deserialize_generic(archive.contents)
	if loaded.error != ""
		return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(previous.visited, "invalid generic package " + name + ": " + loaded.error, previous.units), parsed.cache)
	if loaded.module != name
		return ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(previous.visited, "generic package module mismatch: " + name, previous.units), parsed.cache)
	var declarations = loaded.declarations
	# Packages expose concrete generic functions plus compile-time-only
	# constructors, union aliases and constants. Concrete function bodies are
	# still unavailable as linkable exports from a .smirg package.
	var public = loaded.exports
	for name in declarations.exports
		var compile_time = false
		for function in declarations.functions
			if function.name == name and function.constructor
				compile_time = true
		for alias in declarations.type_aliases
			if alias.name == name
				compile_time = true
		for constant in declarations.constants
			if constant.name == name
				compile_time = true
		if compile_time
			public = public.append(name)
	declarations.exports = public
	var available = bundles
	for package in archive.packages
		available = available.append(package)
	return module_build_visit_imports(root, name, package_path, loaded.tree, declarations, loaded.dependencies, true, visiting, ModuleScan.ModuleScanCached(previous, parsed.cache), available)

# A single build-local visit replaces repeated full-root scans and package
# preparation retries. Each module is completed only after its dependencies.
export def module_build_scan(root: string, entry: string) -> ModuleScan.ModuleScanResult
	let initial = ModuleScan.ModuleScanCached(ModuleScan.new_module_scan_result(Array[string](), "", Array[ModuleScan.ModuleScanUnit]()), ModuleScan.module_scan_empty_cache())
	return module_build_visit(root, entry, Array[string](), initial, Array[MirBundle.MirBundlePackage]()).result

export def module_build_link(root: string, entry: string) -> MirLibrary.ModuleBuildCompiled
	let scanned = module_build_scan(root, entry)
	if scanned.error != ""
		return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(scanned.error), scanned.error)
	var libraries = Array[MirLibrary.MirLibraryLoad]()
	for unit in scanned.units
		var roots = Array[string]()
		for function in unit.exports
			if not function.constructor and not function.generic and function.origin == ""
				var found = false
				for name in roots
					if name == function.name
						found = true
				if not found
					roots = roots.append(function.name)
		if unit.name == entry
			if not unit.has_main
				return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure("entry module has no main() function: " + entry), "entry module has no main() function: " + entry)
			var main_exported = false
			for name in roots
				if name == "main"
					main_exported = true
			if not main_exported
				roots = roots.append("main")
		if len(roots) == 0
			if len(unit.exported_constants) > 0 or len(unit.exported_aliases) > 0 or len(unit.exports) > 0
				continue
			return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure("module has no exported declarations: " + unit.name), "module has no exported declarations: " + unit.name)
		let compiled = module_build_compile(unit, scanned.units, roots, Array[i64](), false, unit.types)
		if compiled.error != ""
			return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(unit.name + ": " + compiled.error), unit.name + ": " + compiled.error)
		libraries = libraries.append(compiled.library)
	# Scan newly emitted imports too: specializations can call other generics.
	var cursor = 0
	while cursor < len(libraries)
		let library = libraries[!cursor]
		for imported in library.imports
			var resolved = false
			for existing in libraries
				for exported in existing.exports
					if imported.name == exported.name
						resolved = true
			if not resolved
				let compiled = module_build_specialization(scanned.units, library, imported)
				if compiled.error != ""
					return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(compiled.error), compiled.error)
				if len(compiled.library.exports) > 0
					libraries = libraries.append(compiled.library)
		cursor += 1
	let linked = MirLink.mir_link_libraries(libraries)
	if linked.error != ""
		return MirLibrary.ModuleBuildCompiled(MirLibrary.mir_library_failure(linked.error), linked.error)
	return MirLibrary.ModuleBuildCompiled(MirLibrary.MirLibraryLoad(linked.program, linked.exports, "", Array[Mir.MirNamedImport]()), "")

export def module_build(root: string, entry: string, output: string) -> ModuleBuildResult
	let compiled = module_build_link(root, entry)
	if compiled.error != ""
		return ModuleBuildResult("", compiled.error)
	let linked = compiled.library
	let saved = MirLibrary.mir_serialize_library(linked.program, linked.exports, linked.imports)
	if saved.error != ""
		return ModuleBuildResult("", saved.error)
	if not write_text(output, saved.text)
		return ModuleBuildResult("", "cannot write MIR library: " + output)
	return ModuleBuildResult(Module.hir_module_symbol(entry, "main"), "")
