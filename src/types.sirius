# Canonical semantic types. TypeId is an index in TypeTable.entries, not a
# description encoded into an integer. This table is separate from the legacy
# C-emitter kind integers while callers migrate to canonical IDs.

export let TYPE_TAG_INVALID = 0
export let TYPE_TAG_I64 = 1
export let TYPE_TAG_F64 = 2
export let TYPE_TAG_BOOL = 3
export let TYPE_TAG_STRING = 4
export let TYPE_TAG_VOID = 5
export let TYPE_TAG_RECORD = 6
export let TYPE_TAG_ARRAY = 7
export let TYPE_TAG_DICT = 8
export let TYPE_TAG_OPTIONAL = 9
export let TYPE_TAG_UNION = 10
export let TYPE_TAG_FUNCTION = 11

# Effect guarantees form part of the structural function signature. Only
# UNCHECKED can currently be inferred; PURE needs transitive effect checking.
export let FUNCTION_EFFECT_UNCHECKED = 0
export let FUNCTION_EFFECT_PURE = 1

export rec RecordField(name: string, kind: i64)

export rec TypeDescriptor(tag: i64, first: i64, second: i64, fields: Array[RecordField])

export rec TypeTable(entries: Array[TypeDescriptor], lookup: Dict[string,i64])

export rec InternedType(table: TypeTable, id: i64)

# Target-neutral runtime representation. C uses a tagged-by-static-TypeId
# S_MirField union for composite payloads; its byte size/alignment are fixed
# by the target ABI, not by TypeId or by this descriptor.
export let TYPE_STORAGE_INVALID = 0
export let TYPE_STORAGE_VOID = 1
export let TYPE_STORAGE_I64 = 2
export let TYPE_STORAGE_F64 = 3
export let TYPE_STORAGE_BOOL = 4
export let TYPE_STORAGE_STRING = 5
export let TYPE_STORAGE_OBJECT = 6

export let TYPE_OWNERSHIP_INVALID = -1
export let TYPE_OWNERSHIP_NONE = 0
export let TYPE_OWNERSHIP_STRING = 1
export let TYPE_OWNERSHIP_OBJECT = 2

# fixed_slots counts S_MirField payload slots in a composite object.
# variable_slots means that length determines the remaining slot count:
# arrays have 0..n slots, optionals have 0..1. Dictionaries have a single
# slot holding the runtime dictionary pointer; record field offsets are the
# indices of lexicographically sorted descriptor fields.
export rec RuntimeLayout(storage: i64, ownership: i64, fixed_slots: i64, variable_slots: bool)

# These queries deliberately do not derive ownership from the TypeId value.
# The type table is canonical after interning or MIR artifact verification.
# A union of only empty record alternatives carries no payload. Store its
# alternative index in an i64 slot instead of a managed wrapper. This retains
# label identity while keeping array/dictionary field slots unchanged.
export def union_is_enum(types: TypeTable, id: i64) -> bool
	if type_tag(types, id) != TYPE_TAG_UNION
		return false
	for alt in types.entries[!id].fields
		let payload = types.entries[!alt.kind]
		if payload.tag != TYPE_TAG_RECORD or len(payload.fields) != 0
			return false
	return true

export def runtime_storage(types: TypeTable, id: i64) -> i64
	let tag = type_tag(types, id)
	if tag == TYPE_TAG_I64 or tag == TYPE_TAG_FUNCTION
		return TYPE_STORAGE_I64
	if tag == TYPE_TAG_F64
		return TYPE_STORAGE_F64
	if tag == TYPE_TAG_BOOL
		return TYPE_STORAGE_BOOL
	if tag == TYPE_TAG_STRING
		return TYPE_STORAGE_STRING
	if tag == TYPE_TAG_UNION and union_is_enum(types, id)
		return TYPE_STORAGE_I64
	if tag == TYPE_TAG_RECORD or tag == TYPE_TAG_ARRAY or tag == TYPE_TAG_DICT or tag == TYPE_TAG_OPTIONAL or tag == TYPE_TAG_UNION
		return TYPE_STORAGE_OBJECT
	if tag == TYPE_TAG_VOID
		return TYPE_STORAGE_VOID
	return TYPE_STORAGE_INVALID

export def runtime_ownership(types: TypeTable, id: i64) -> i64
	let storage = runtime_storage(types, id)
	if storage == TYPE_STORAGE_INVALID
		return TYPE_OWNERSHIP_INVALID
	if storage == TYPE_STORAGE_STRING
		return TYPE_OWNERSHIP_STRING
	if storage == TYPE_STORAGE_OBJECT
		return TYPE_OWNERSHIP_OBJECT
	return TYPE_OWNERSHIP_NONE

export def runtime_layout(types: TypeTable, id: i64) -> RuntimeLayout
	let storage = runtime_storage(types, id)
	let ownership = runtime_ownership(types, id)
	if storage != TYPE_STORAGE_OBJECT
		return RuntimeLayout(storage, ownership, 0, false)
	let desc = types.entries[!id]
	if desc.tag == TYPE_TAG_RECORD
		return RuntimeLayout(storage, ownership, len(desc.fields), false)
	if desc.tag == TYPE_TAG_UNION
		return RuntimeLayout(storage, ownership, 2, false)
	if desc.tag == TYPE_TAG_DICT
		return RuntimeLayout(storage, ownership, 1, false)
	return RuntimeLayout(storage, ownership, 0, true)

# Interned type keys are based on canonical child TypeIds and sorted fields.
# Identifier names cannot contain the separators, so the encoding is unique.
def type_descriptor_key(tag: i64, first: i64, second: i64, fields: Array[RecordField]) -> string
	var parts = Array[string]()
	parts = parts.append(str(tag) + "|" + str(first) + "|" + str(second) + "|")
	for field in fields
		parts = parts.append(str(len(field.name)) + ":" + field.name + ":" + str(field.kind) + ";")
	return "".join(parts)

export def new_type_table() -> TypeTable
	var entries = Array[TypeDescriptor]()
	var lookup = Dict[string,i64]()
	for tag in 0..6
		entries = entries.append(TypeDescriptor(tag, 0, 0, Array[RecordField]()))
		lookup = lookup.insert(type_descriptor_key(tag, 0, 0, Array[RecordField]()), tag)
	return TypeTable(entries, lookup)

# Check a prospective descriptor before inserting it. Child TypeIds must
# already exist, so successful interning preserves an acyclic type table.
def type_descriptor_parts_canonical(id: i64, tag: i64, first: i64, second: i64, fields: Array[RecordField]) -> bool
	if id <= TYPE_TAG_VOID
		return tag == id and first == 0 and second == 0 and len(fields) == 0
	if tag == TYPE_TAG_FUNCTION
		if (first != FUNCTION_EFFECT_UNCHECKED and first != FUNCTION_EFFECT_PURE) or second <= TYPE_TAG_INVALID or second >= id
			return false
		for parameter in fields
			if parameter.name != "" or parameter.kind <= TYPE_TAG_INVALID or parameter.kind == TYPE_TAG_VOID or parameter.kind >= id
				return false
		return true
	if tag == TYPE_TAG_UNION
		if first != 0 or second != 0 or len(fields) < 2
			return false
		let labeled = fields[!0].name != ""
		for member in fields
			if (member.name != "") != labeled or member.kind <= TYPE_TAG_VOID or member.kind >= id
				return false
		return true
	if tag == TYPE_TAG_RECORD
		if first != 0 or second != 0
			return false
		for i in 0..len(fields)
			let field = fields[!i]
			if field.kind <= TYPE_TAG_INVALID or field.kind == TYPE_TAG_VOID or field.kind >= id
				return false
			if i > 0 and fields[!i - 1].name >= field.name
				return false
		return true
	if len(fields) != 0 or first <= TYPE_TAG_INVALID or first == TYPE_TAG_VOID or first >= id
		return false
	if tag == TYPE_TAG_ARRAY or tag == TYPE_TAG_OPTIONAL
		return second == 0
	if tag == TYPE_TAG_DICT
		return second > TYPE_TAG_INVALID and second != TYPE_TAG_VOID and second < id
	return false

# Union alternatives have two distinct canonical encodings. Legacy unions are
# unnamed and ordered by payload signature. Labeled unions are ordered by
# unique labels, independent of payload shape (which can repeat). Mixed forms
# are invalid; an unlabelled payload cannot select a labeled alternative.
def union_fields_canonical(table: TypeTable, fields: Array[RecordField]) -> bool
	if len(fields) < 2
		return false
	let labeled = fields[!0].name != ""
	var previous = ""
	for i in 0..len(fields)
		let member = fields[!i]
		if type_tag(table, member.kind) != TYPE_TAG_RECORD or (member.name != "") != labeled
			return false
		let signature = type_signature(table, member.kind)
		if signature == "invalid"
			return false
		var key = signature
		if labeled
			key = member.name
		if i > 0 and previous >= key
			return false
		previous = key
	return true

# Canonical fields are sorted by the caller. Invalid construction leaves the
# table unchanged and returns the existing invalid TypeId (0).
export def intern_type(table: TypeTable, tag: i64, first: i64, second: i64, fields: Array[RecordField]) -> InternedType
	let id = len(table.entries)
	if tag <= TYPE_TAG_VOID
		if tag < TYPE_TAG_INVALID or not type_descriptor_parts_canonical(tag, tag, first, second, fields)
			return InternedType(table, TYPE_TAG_INVALID)
		return InternedType(table, tag)
	if not type_descriptor_parts_canonical(id, tag, first, second, fields)
		return InternedType(table, TYPE_TAG_INVALID)
	if tag == TYPE_TAG_UNION and not union_fields_canonical(table, fields)
		return InternedType(table, TYPE_TAG_INVALID)
	let key = type_descriptor_key(tag, first, second, fields)
	let existing = table.lookup.get(key) or -1
	if existing >= 0
		return InternedType(table, existing)
	var next = table
	next.entries = next.entries.append(TypeDescriptor(tag, first, second, fields))
	next.lookup = next.lookup.insert(key, id)
	return InternedType(next, id)

# Validate a single descriptor against the canonical, acyclic TypeId table.
# This checks representation, not whether a type is supported by a particular
# MIR instruction (for example, whether a dictionary key is hashable).
export def type_descriptor_canonical(types: TypeTable, id: i64) -> bool
	if id < 0 or id >= len(types.entries)
		return false
	let desc = types.entries[!id]
	if not type_descriptor_parts_canonical(id, desc.tag, desc.first, desc.second, desc.fields)
		return false
	if desc.tag == TYPE_TAG_UNION and not union_fields_canonical(types, desc.fields)
		return false
	return true

# TypeId is an opaque table index. Query the descriptor before branching on
# the kind; an absent ID must never be mistaken for a composite type.
# Primitive TypeIds 0..5 are reserved, but all kind queries use the table.
export def type_tag(types: TypeTable, id: i64) -> i64
	if id < 0 or id >= len(types.entries)
		return TYPE_TAG_INVALID
	return types.entries[!id].tag

export def type_has_tag(types: TypeTable, id: i64, tag: i64) -> bool
	return tag != TYPE_TAG_INVALID and type_tag(types, id) == tag

export def intern_array_type(table: TypeTable, element: i64) -> InternedType
	return intern_type(table, TYPE_TAG_ARRAY, element, 0, Array[RecordField]())

export def intern_dict_type(table: TypeTable, key: i64, value: i64) -> InternedType
	return intern_type(table, TYPE_TAG_DICT, key, value, Array[RecordField]())

export def intern_optional_type(table: TypeTable, value: i64) -> InternedType
	return intern_type(table, TYPE_TAG_OPTIONAL, value, 0, Array[RecordField]())

# Positional argument types are stored in descriptor fields, without names.
# The result TypeId is stored in second, and the effect guarantee in first.
export def intern_function_type(table: TypeTable, parameters: Array[i64], result: i64, effects: i64) -> InternedType
	var fields = Array[RecordField]()
	for parameter in parameters
		fields = fields.append(RecordField("", parameter))
	return intern_type(table, TYPE_TAG_FUNCTION, effects, result, fields)

def ordered_fields(fields: Array[RecordField]) -> Array[RecordField]
	var result = Array[RecordField]()
	for field in fields
		var at = 0
		while at < len(result) and result[!at].name < field.name
			at += 1
		var sorted = Array[RecordField]()
		for i in 0..at
			sorted = sorted.append(result[!i])
		sorted = sorted.append(field)
		for i in at..len(result)
			sorted = sorted.append(result[!i])
		result = sorted
	return result

export def intern_record_type(table: TypeTable, fields: Array[RecordField]) -> InternedType
	return intern_type(table, TYPE_TAG_RECORD, 0, 0, ordered_fields(fields))

# Structural signatures do not depend on module-local TypeIds.
export def type_signature(types: TypeTable, id: i64) -> string
	if not type_descriptor_canonical(types, id)
		return "invalid"
	let desc = types.entries[!id]
	if desc.tag == TYPE_TAG_I64
		return "i64"
	if desc.tag == TYPE_TAG_F64
		return "f64"
	if desc.tag == TYPE_TAG_BOOL
		return "bool"
	if desc.tag == TYPE_TAG_STRING
		return "string"
	if desc.tag == TYPE_TAG_VOID
		return "void"
	if desc.tag == TYPE_TAG_ARRAY
		let element = type_signature(types, desc.first)
		if element == "invalid"
			return "invalid"
		return "Array[" + element + "]"
	if desc.tag == TYPE_TAG_OPTIONAL
		let element = type_signature(types, desc.first)
		if element == "invalid"
			return "invalid"
		return "Optional[" + element + "]"
	if desc.tag == TYPE_TAG_DICT
		let key = type_signature(types, desc.first)
		let value = type_signature(types, desc.second)
		if key == "invalid" or value == "invalid"
			return "invalid"
		return "Dict[" + key + "," + value + "]"
	if desc.tag == TYPE_TAG_FUNCTION
		let ret = type_signature(types, desc.second)
		if ret == "invalid"
			return "invalid"
		var parts = ["Fn{", str(desc.first), "|", str(len(ret)), ":", ret, "|"]
		for parameter in desc.fields
			let signature = type_signature(types, parameter.kind)
			if signature == "invalid"
				return "invalid"
			parts = parts.append(str(len(signature)) + ":" + signature + ";")
		return "".join(parts) + "}"
	if desc.tag == TYPE_TAG_UNION
		var parts = ["Union{"]
		for member in desc.fields
			let variant = type_signature(types, member.kind)
			if variant == "invalid"
				return "invalid"
			# Retain the historical signature of unnamed unions. Labeled
			# alternatives include their identity, not just their layout.
			if member.name != ""
				parts = parts.append(str(len(member.name)) + ":" + member.name + "=")
			parts = parts.append(str(len(variant)) + ":" + variant + ";")
		return "".join(parts) + "}"
	if desc.tag != TYPE_TAG_RECORD
		return "invalid"
	var parts = ["Record{"]
	for field in desc.fields
		let value = type_signature(types, field.kind)
		if value == "invalid"
			return "invalid"
		parts = parts.append(str(len(field.name)) + ":" + field.name + "=" + value + ";")
	return "".join(parts) + "}"


# Existing constructor-based unions use ordered, unnamed record alternatives.
# Labeled unions (below) instead include the constructor label in type identity.
# Both use this descriptor field arena; neither changes structural record types.
# Executable unions currently use a two-slot tag-and-payload managed wrapper.
export def intern_union_type(table: TypeTable, alternatives: Array[i64]) -> InternedType
	if len(alternatives) < 2
		return InternedType(table, TYPE_TAG_INVALID)
	var fields = Array[RecordField]()
	for alternative in alternatives
		if type_tag(table, alternative) != TYPE_TAG_RECORD
			return InternedType(table, TYPE_TAG_INVALID)
		let signature = type_signature(table, alternative)
		if signature == "invalid"
			return InternedType(table, TYPE_TAG_INVALID)
		var at = 0
		while at < len(fields) and type_signature(table, fields[!at].kind) < signature
			at += 1
		if at < len(fields) and type_signature(table, fields[!at].kind) == signature
			return InternedType(table, TYPE_TAG_INVALID)
		var ordered = Array[RecordField]()
		for i in 0..at
			ordered = ordered.append(fields[!i])
		ordered = ordered.append(RecordField("", alternative))
		for i in at..len(fields)
			ordered = ordered.append(fields[!i])
		fields = ordered
	return intern_type(table, TYPE_TAG_UNION, 0, 0, fields)

# Labeled alternatives are structurally identified by (label, payload type).
# Sorting by label makes tag indices stable across independent modules and
# construction order. Duplicate labels are rejected even for different shapes.
# This type-level API does not enable source-level variant construction yet.
export def intern_labeled_union_type(table: TypeTable, alternatives: Array[RecordField]) -> InternedType
	if len(alternatives) < 2
		return InternedType(table, TYPE_TAG_INVALID)
	var fields = Array[RecordField]()
	for alternative in alternatives
		if alternative.name == "" or type_tag(table, alternative.kind) != TYPE_TAG_RECORD
			return InternedType(table, TYPE_TAG_INVALID)
		var at = 0
		while at < len(fields) and fields[!at].name < alternative.name
			at += 1
		if at < len(fields) and fields[!at].name == alternative.name
			return InternedType(table, TYPE_TAG_INVALID)
		var ordered = Array[RecordField]()
		for i in 0..at
			ordered = ordered.append(fields[!i])
		ordered = ordered.append(alternative)
		for i in at..len(fields)
			ordered = ordered.append(fields[!i])
		fields = ordered
	return intern_type(table, TYPE_TAG_UNION, 0, 0, fields)

# Explicit labels distinguish alternatives sharing the same structural payload.
# A record can still be implicitly injected when exactly one alternative has
# its shape. Never infer an ambiguous label from the record's type alone.
export def union_labeled_alternative_index(table: TypeTable, union_id: i64, label: string, member: i64) -> i64
	if label == "" or type_tag(table, union_id) != TYPE_TAG_UNION
		return -1
	let alternatives = table.entries[!union_id].fields
	for i in 0..len(alternatives)
		if alternatives[!i].name == label and alternatives[!i].kind == member
			return i
	return -1

# Constructor names may be module-qualified in a resolved source program.
# Qualifiers select the constructor, not part of the union's canonical label.
export def union_constructor_alternative_index(table: TypeTable, union_id: i64, constructor: string, member: i64) -> i64
	if type_tag(table, union_id) != TYPE_TAG_UNION
		return -1
	for alternative in table.entries[!union_id].fields
		if alternative.name != "" and (constructor == alternative.name or constructor.ends_with("." + alternative.name))
			return union_labeled_alternative_index(table, union_id, alternative.name, member)
	return -1

# Implicit injection preserves structural field names and collection shape.
# Conversion may allocate new records/arrays; it never reinterprets their layout.
export def type_coercible(table: TypeTable, expected: i64, actual: i64) -> bool
	if expected == actual
		return true
	if union_alternative_index(table, expected, actual) >= 0
		return true
	let expected_tag = type_tag(table, expected)
	if expected_tag != type_tag(table, actual)
		return false
	if expected_tag == TYPE_TAG_ARRAY or expected_tag == TYPE_TAG_OPTIONAL
		return type_coercible(table, table.entries[!expected].first, table.entries[!actual].first)
	if expected_tag == TYPE_TAG_DICT
		let left = table.entries[!expected]
		let right = table.entries[!actual]
		return left.first == right.first and type_coercible(table, left.second, right.second)
	if expected_tag == TYPE_TAG_RECORD
		let left = table.entries[!expected].fields
		let right = table.entries[!actual].fields
		if len(left) != len(right)
			return false
		for i in 0..len(left)
			if left[!i].name != right[!i].name or not type_coercible(table, left[!i].kind, right[!i].kind)
				return false
		return true
	return false

# Resolve a structurally distinct alternative to its stable tag index.
export def union_alternative_index(table: TypeTable, union_id: i64, member: i64) -> i64
	if type_tag(table, union_id) != TYPE_TAG_UNION
		return -1
	let alternatives = table.entries[!union_id].fields
	var found = -1
	for i in 0..len(alternatives)
		if alternatives[!i].kind == member
			if found >= 0
				return -1
			found = i
	return found
