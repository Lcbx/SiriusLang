# Canonical semantic types. TypeId is an index in TypeTable.entries, not a
# description encoded into an integer. This table is separate from the legacy
# C-emitter kind integers while callers migrate to canonical IDs.

let TYPE_TAG_INVALID = 0
let TYPE_TAG_I64 = 1
let TYPE_TAG_F64 = 2
let TYPE_TAG_BOOL = 3
let TYPE_TAG_STRING = 4
let TYPE_TAG_VOID = 5
let TYPE_TAG_RECORD = 6
let TYPE_TAG_ARRAY = 7
let TYPE_TAG_DICT = 8
let TYPE_TAG_OPTIONAL = 9

rec RecordField(name: string, kind: i64)

rec TypeDescriptor(tag: i64, first: i64, second: i64, fields: Array[RecordField])

rec TypeTable(entries: Array[TypeDescriptor])

rec InternedType(table: TypeTable, id: i64)

def new_type_table() -> TypeTable
	var entries = Array[TypeDescriptor]()
	for tag in 0..6
		entries = entries.append(TypeDescriptor(tag, 0, 0, Array[RecordField]()))
	return TypeTable(entries)

# Input record fields are already sorted by name. Equal descriptors always
# receive the same TypeId, including when their nested types were interned
# through different paths.
def intern_type(table: TypeTable, tag: i64, first: i64, second: i64, fields: Array[RecordField]) -> InternedType
	for i in 0..len(table.entries)
		let entry = table.entries[i?]!
		if entry.tag != tag or entry.first != first or entry.second != second or len(entry.fields) != len(fields)
			continue
		var equal = true
		for j in 0..len(fields)
			let a = entry.fields[j?]!
			let b = fields[j?]!
			if a.name != b.name or a.kind != b.kind
				equal = false
		if equal
			return InternedType(table, i)
	var next = table
	let id = len(next.entries)
	next.entries = next.entries.append(TypeDescriptor(tag, first, second, fields))
	return InternedType(next, id)

def intern_array_type(table: TypeTable, element: i64) -> InternedType
	return intern_type(table, TYPE_TAG_ARRAY, element, 0, Array[RecordField]())

def intern_dict_type(table: TypeTable, key: i64, value: i64) -> InternedType
	return intern_type(table, TYPE_TAG_DICT, key, value, Array[RecordField]())

def intern_optional_type(table: TypeTable, value: i64) -> InternedType
	return intern_type(table, TYPE_TAG_OPTIONAL, value, 0, Array[RecordField]())

def ordered_fields(fields: Array[RecordField]) -> Array[RecordField]
	var result = Array[RecordField]()
	for field in fields
		var at = 0
		while at < len(result) and result[at?]!.name < field.name
			at += 1
		var sorted = Array[RecordField]()
		for i in 0..at
			sorted = sorted.append(result[i?]!)
		sorted = sorted.append(field)
		for i in at..len(result)
			sorted = sorted.append(result[i?]!)
		result = sorted
	return result

def intern_record_type(table: TypeTable, fields: Array[RecordField]) -> InternedType
	return intern_type(table, TYPE_TAG_RECORD, 0, 0, ordered_fields(fields))
