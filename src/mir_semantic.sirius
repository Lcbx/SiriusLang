import hir alias Hir
import hir_declarations alias HirDeclarations
import mir_template alias MirTemplate
import mir_wire alias MirWire
import parser alias Parser
import tokenizer alias Tokenizer
import types alias Types
# Persist the resolved module declarations alongside the generic syntax arena.
# Generic bodies still undergo concrete HIR specialization. The declaration
# snapshot is checked against the syntax once when a library is loaded, rather
# than recomputed for every requested specialization.
let MIR_SEMANTIC_MAGIC = "SIRIUS-TEMPLATE-DECL/1\n"

export rec MirSemanticLoad(tree: Parser.ParseState, root: i64, declarations: Hir.HirModuleDecl, error: string)

def mir_semantic_failure(message: string) -> MirSemanticLoad
	return MirSemanticLoad(Parser.new_parse_state("", Array[Tokenizer.Token]()), -1, HirDeclarations.hir_declaration_error(Array[Hir.HirFunctionDecl](), Array[Hir.HirModuleConstant](), message, 0), message)

export def mir_serialize_semantic(tree: Parser.ParseState, root: i64, declarations: Hir.HirModuleDecl) -> MirWire.MirWireSave
	if declarations.error != ""
		return MirWire.MirWireSave("", declarations.error)
	let syntax = MirTemplate.mir_serialize_template(tree, root)
	if syntax.error != ""
		return syntax
	var parts = [MIR_SEMANTIC_MAGIC]
	parts = MirWire.mir_wire_str(parts, syntax.text)
	parts = MirWire.mir_wire_num(parts, len(declarations.functions))
	for function in declarations.functions
		parts = MirWire.mir_wire_str(parts, function.name)
		parts = MirWire.mir_wire_num(parts, function.source)
		parts = MirWire.mir_wire_num(parts, function.body)
		var constructor = 0
		if function.constructor
			constructor = 1
		var external = 0
		if function.external
			external = 1
		parts = MirWire.mir_wire_num(parts, constructor)
		parts = MirWire.mir_wire_num(parts, external)
		parts = MirWire.mir_wire_num(parts, function.result_type_node)
		parts = MirWire.mir_wire_num(parts, len(function.parameters))
		for parameter in function.parameters
			parts = MirWire.mir_wire_str(parts, parameter.name)
			parts = MirWire.mir_wire_num(parts, parameter.source)
			parts = MirWire.mir_wire_num(parts, parameter.type_node)
	parts = MirWire.mir_wire_num(parts, len(declarations.types.entries))
	for i in 6..len(declarations.types.entries)
		let descriptor = declarations.types.entries[!i]
		parts = MirWire.mir_wire_num(parts, descriptor.tag)
		parts = MirWire.mir_wire_num(parts, descriptor.first)
		parts = MirWire.mir_wire_num(parts, descriptor.second)
		parts = MirWire.mir_wire_num(parts, len(descriptor.fields))
		for field in descriptor.fields
			parts = MirWire.mir_wire_str(parts, field.name)
			parts = MirWire.mir_wire_num(parts, field.kind)
	parts = MirWire.mir_wire_num(parts, len(declarations.values))
	for value in declarations.values
		parts = MirWire.mir_wire_num(parts, value.type_id)
		parts = MirWire.mir_wire_num(parts, value.bits)
		parts = MirWire.mir_wire_num(parts, len(value.fields))
		for field in value.fields
			parts = MirWire.mir_wire_num(parts, field)
		parts = MirWire.mir_wire_str(parts, value.text)
	parts = MirWire.mir_wire_num(parts, len(declarations.constants))
	for constant in declarations.constants
		parts = MirWire.mir_wire_str(parts, constant.name)
		parts = MirWire.mir_wire_num(parts, constant.value)
		parts = MirWire.mir_wire_num(parts, constant.type_id)
	let data = "".join(parts)
	if len(data) > MirWire.MIR_WIRE_MAX_SIZE
		return MirWire.MirWireSave("", "generic declaration snapshot exceeds format size limit")
	return MirWire.MirWireSave(data, "")

export def mir_deserialize_semantic(data: string) -> MirSemanticLoad
	if len(data) > MirWire.MIR_WIRE_MAX_SIZE or not data.starts_with(MIR_SEMANTIC_MAGIC)
		return mir_semantic_failure("unsupported generic declaration snapshot")
	var reader = MirWire.MirWireReader(data, len(MIR_SEMANTIC_MAGIC), "")
	let syntax = MirWire.mir_wire_string(reader)
	reader = syntax.reader
	if reader.error != ""
		return mir_semantic_failure(reader.error)
	let parsed = MirTemplate.mir_deserialize_template(syntax.value)
	if parsed.error != ""
		return mir_semantic_failure(parsed.error)
	let count = MirWire.mir_wire_count(reader)
	reader = count.reader
	if reader.error != "" or count.value > 4096
		return mir_semantic_failure("invalid generic declaration count")
	var functions = Array[Hir.HirFunctionDecl]()
	for i in 0..count.value
		let name = MirWire.mir_wire_string(reader)
		let source = MirWire.mir_wire_number(name.reader)
		let body = MirWire.mir_wire_number(source.reader)
		let constructor = MirWire.mir_wire_number(body.reader)
		let external = MirWire.mir_wire_number(constructor.reader)
		let result_type_node = MirWire.mir_wire_number(external.reader)
		let parameters_count = MirWire.mir_wire_count(result_type_node.reader)
		reader = parameters_count.reader
		if reader.error != "" or parameters_count.value > 4096
			return mir_semantic_failure("invalid generic function declaration")
		var parameters = Array[Hir.HirParameterDecl]()
		for j in 0..parameters_count.value
			let pname = MirWire.mir_wire_string(reader)
			let psource = MirWire.mir_wire_number(pname.reader)
			let ptype = MirWire.mir_wire_number(psource.reader)
			reader = ptype.reader
			if reader.error != ""
				return mir_semantic_failure(reader.error)
			parameters = parameters.append(Hir.HirParameterDecl(pname.value, psource.value, ptype.value))
		if constructor.value < 0 or constructor.value > 1 or external.value < 0 or external.value > 1
			return mir_semantic_failure("invalid generic declaration flags")
		var function = Hir.new_hir_function_decl(name.value, source.value, body.value, constructor.value == 1, result_type_node.value, parameters)
		function.external = external.value == 1
		functions = functions.append(function)
	let type_count = MirWire.mir_wire_count(reader)
	reader = type_count.reader
	if reader.error != "" or type_count.value < 6
		return mir_semantic_failure("invalid generic declaration type count")
	var types = Types.new_type_table()
	for i in 6..type_count.value
		let tag = MirWire.mir_wire_number(reader)
		let first = MirWire.mir_wire_number(tag.reader)
		let second = MirWire.mir_wire_number(first.reader)
		let fields_count = MirWire.mir_wire_count(second.reader)
		reader = fields_count.reader
		if reader.error != ""
			return mir_semantic_failure(reader.error)
		var fields = Array[Types.RecordField]()
		for j in 0..fields_count.value
			let fname = MirWire.mir_wire_string(reader)
			let kind = MirWire.mir_wire_number(fname.reader)
			reader = kind.reader
			if reader.error != ""
				return mir_semantic_failure(reader.error)
			fields = fields.append(Types.RecordField(fname.value, kind.value))
		let interned = Types.intern_type(types, tag.value, first.value, second.value, fields)
		if interned.id != i or not Types.type_descriptor_canonical(interned.table, i)
			return mir_semantic_failure("noncanonical generic declaration types")
		types = interned.table
	let value_count = MirWire.mir_wire_count(reader)
	reader = value_count.reader
	if reader.error != ""
		return mir_semantic_failure(reader.error)
	var values = Array[Hir.HirConstantValue]()
	for i in 0..value_count.value
		let kind = MirWire.mir_wire_number(reader)
		let bits = MirWire.mir_wire_number(kind.reader)
		let field_count = MirWire.mir_wire_count(bits.reader)
		reader = field_count.reader
		if reader.error != ""
			return mir_semantic_failure(reader.error)
		var fields = Array[i64]()
		for j in 0..field_count.value
			let field = MirWire.mir_wire_number(reader)
			reader = field.reader
			if reader.error != ""
				return mir_semantic_failure(reader.error)
			fields = fields.append(field.value)
		let value_text = MirWire.mir_wire_string(reader)
		reader = value_text.reader
		if reader.error != ""
			return mir_semantic_failure(reader.error)
		values = values.append(Hir.HirConstantValue(kind.value, bits.value, fields, value_text.value))
	let constant_count = MirWire.mir_wire_count(reader)
	reader = constant_count.reader
	if reader.error != "" or constant_count.value > 4096
		return mir_semantic_failure("invalid generic constant count")
	var constants = Array[Hir.HirModuleConstant]()
	for i in 0..constant_count.value
		let name = MirWire.mir_wire_string(reader)
		let value = MirWire.mir_wire_number(name.reader)
		let kind = MirWire.mir_wire_number(value.reader)
		reader = kind.reader
		if reader.error != ""
			return mir_semantic_failure(reader.error)
		constants = constants.append(Hir.HirModuleConstant(name.value, value.value, kind.value))
	if reader.error != "" or reader.at != len(data)
		return mir_semantic_failure("invalid generic declaration payload")
	let declarations = Hir.new_hir_module_decl(functions, constants, types, values, "", 0)
	# Verify the persisted environment against its syntax at the untrusted
	# artifact boundary. Link-time specializations reuse this verified state.
	let checked = HirDeclarations.hir_module_declarations(parsed.tree, parsed.root)
	if checked.error != ""
		return mir_semantic_failure("invalid generic declarations: " + checked.error)
	let canonical = mir_serialize_semantic(parsed.tree, parsed.root, checked)
	if canonical.error != "" or canonical.text != data
		return mir_semantic_failure("generic declaration metadata mismatch")
	var verified = declarations
	verified.imports = checked.imports
	verified.exports = checked.exports
	verified.reexports = checked.reexports
	verified.type_aliases = checked.type_aliases
	return MirSemanticLoad(parsed.tree, parsed.root, verified, "")
