# Convert the HIR-owned specialization worklist to a complete supported MIR
# program. Function indices exactly match HIR specialization IDs.

# The backend owns only MIR output; HIR analyses remain local to lowering.
rec MirProgramBuild(program: MirProgram, entry: i64, error: string)
	pub exports = Array[MirNamedExport]()
	pub imports = Array[MirNamedImport]()

def mir_build_program_roots(tree: ParseState, declarations: HirModuleDecl, names: Array[string], arguments: Array[i64]) -> MirProgramBuild
	let analyzed = hir_specialize_program_roots(tree, declarations, names, arguments)
	var functions = Array[MirFunction]()
	if analyzed.error != ""
		return MirProgramBuild(MirProgram(functions), analyzed.entry, analyzed.error)
	for i in 0..len(analyzed.bodies)
		let body = analyzed.bodies[!i]
		let spec = analyzed.registry.entries[!i]
		let definition = hir_definition(declarations.functions, spec.definition)
		let header = declarations.functions[!definition]
		if not mir_type_supported(analyzed.types, body.return_type)
			return MirProgramBuild(MirProgram(functions), analyzed.entry, "MIR specialization requires a scalar return type")
		if hir_function_external(tree, header)
			var releases = Array[MirInstruction]()
			for j in 0..len(spec.arguments)
				if mir_managed_type(analyzed.types, spec.arguments[!j])
					releases = releases.append(mir_op(MIR_RELEASE, j, j, -1, 0))
			var symbol = header.name
			for argument in header.argument_types
				if argument == TYPE_TAG_INVALID
					symbol = mir_generic_symbol(header.name, analyzed.types, spec.arguments)
					break
			functions = functions.append(MirFunction(len(spec.arguments), body.return_type, spec.arguments, [MirBlock(releases, mir_panic("unresolved MIR import: " + symbol))], 0))
		else
			let lowered = mir_lower_function_module(tree, header, body.nodes, spec.arguments, body.return_type, body.calls, analyzed.types, declarations.functions, declarations.constants, declarations.values)
			if lowered.error != ""
				return MirProgramBuild(MirProgram(functions), analyzed.entry, lowered.error)
			functions = functions.append(lowered.function)
	let program = mir_program_with_types(functions, analyzed.types)
	# Only the public individual passes check MIR at every boundary. The
	# combined compiler pipeline validates before transformations and after
	# cleanup, avoiding repeated CFG fixed-point and MIR verifier passes.
	let error = mir_check_ownership(program)
	if error != ""
		return MirProgramBuild(program, analyzed.entry, error)
	let guarded = mir_insert_guards_unchecked(program)
	let owned = mir_insert_lifetimes_unchecked(guarded.program)
	let cleaned = mir_insert_exit_cleanup_unchecked(owned.program)
	let optimized = mir_optimize_unchecked(cleaned.program)
	let checked = mir_check_balance(optimized.program)
	if checked != ""
		return MirProgramBuild(optimized.program, analyzed.entry, checked)
	let audited = mir_audit_failures_unchecked(optimized.program)
	var result = MirProgramBuild(optimized.program, analyzed.entry, audited.error)
	for i in 0..len(analyzed.registry.entries)
		let spec = analyzed.registry.entries[!i]
		let declaration = hir_definition(declarations.functions, spec.definition)
		if declaration >= 0 and hir_function_external(tree, declarations.functions[!declaration])
			let header = declarations.functions[!declaration]
			var symbol = header.name
			for argument in header.argument_types
				if argument == TYPE_TAG_INVALID
					symbol = mir_generic_symbol(header.name, analyzed.types, spec.arguments)
					break
			result.imports = result.imports.append(MirNamedImport(symbol, i))
	for root in analyzed.roots
		result.exports = result.exports.append(MirNamedExport(root.name, root.function_id))
	return result

def mir_build_program(tree: ParseState, declarations: HirModuleDecl, name: string, arguments: Array[i64]) -> MirProgramBuild
	return mir_build_program_roots(tree, declarations, [name], arguments)
