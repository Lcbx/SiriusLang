# Semantics shared by the MIR interpreter and the native C backend.

# The canonical type table reserves TypeIds 0..5 for primitive types.
# All other valid TypeIds are managed collections; strings are managed too.
def mir_common_managed(type_id: i64) -> bool
	return type_id == TYPE_TAG_STRING or type_id >= TYPE_TAG_RECORD

# Both execution backends reject malformed MIR and invalid entry indices
# before interpreting or generating any code.
def mir_common_entry_error(program: MirProgram, entry: i64) -> string
	let error = mir_verify(program)
	if error != ""
		return error
	if entry < 0 or entry >= len(program.functions)
		return "invalid entry function"
	return ""
