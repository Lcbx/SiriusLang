import types alias Types
import hir alias Hir
import module alias Module

# Call signature validation is semantic: no C names or ownership helpers.
# A checked call returns an interned result type, and (possibly) an extended
# type table for results such as Optional[string].
# Operation IDs 1..17 are defined by hir and hir_analyze. These must remain
# distinct: an expression and its conversion can annotate the same source.
export let HIR_CALL = 18

export rec HirCallCheck(table: Types.TypeTable, type_id: i64, error: string)

export def hir_type_name(types: Types.TypeTable, id: i64) -> string
	if id < 0 or id >= len(types.entries)
		return "unknown"
	let descriptor = types.entries[!id]
	if descriptor.tag == Types.TYPE_TAG_I64
		return "i64"
	if descriptor.tag == Types.TYPE_TAG_F64
		return "f64"
	if descriptor.tag == Types.TYPE_TAG_BOOL
		return "bool"
	if descriptor.tag == Types.TYPE_TAG_STRING
		return "string"
	if descriptor.tag == Types.TYPE_TAG_VOID
		return "void"
	if descriptor.tag == Types.TYPE_TAG_ARRAY
		return "Array[" + hir_type_name(types, descriptor.first) + "]"
	if descriptor.tag == Types.TYPE_TAG_DICT
		return "Dict[" + hir_type_name(types, descriptor.first) + "," + hir_type_name(types, descriptor.second) + "]"
	if descriptor.tag == Types.TYPE_TAG_OPTIONAL
		return "Optional[" + hir_type_name(types, descriptor.first) + "]"
	if descriptor.tag == Types.TYPE_TAG_UNION
		return "union"
	if descriptor.tag == Types.TYPE_TAG_FUNCTION
		var parts = Array[string]()
		for param in descriptor.fields
			parts = parts.append(hir_type_name(types, param.kind))
		parts = parts.append(hir_type_name(types, descriptor.second))
		return "Fn[" + ",".join(parts) + "]"
	return "record"

# Postorder conversion steps separate semantic compatibility and alternative
# selection from CFG construction. Children refer to earlier steps.
export let HIR_CONVERSION_IDENTITY = -1
export rec HirConversionStep(source_type: i64, target_type: i64, operation: i64, alternative: i64, children: Array[i64])
export rec HirConversionPlan(steps: Array[HirConversionStep], root: i64, error: string)

export def hir_conversion_find(plans: Array[HirConversionPlan], actual: i64, expected: i64) -> i64
	for i in 0..len(plans)
		let plan = plans[!i]
		let root = plan.steps[!plan.root]
		if root.source_type == actual and root.target_type == expected
			return i
	return -1

def hir_conversion_steps(types: Types.TypeTable, actual: i64, expected: i64, plan: HirConversionPlan) -> HirConversionPlan
	var result = plan
	var operation = HIR_CONVERSION_IDENTITY
	var alternative = -1
	var children = Array[i64]()
	if actual != expected
		operation = Types.type_tag(types, expected)
		if operation == Types.TYPE_TAG_UNION
			alternative = Types.union_alternative_index(types, expected, actual)
		elif operation == Types.TYPE_TAG_ARRAY or operation == Types.TYPE_TAG_OPTIONAL
			result = hir_conversion_steps(types, types.entries[!actual].first, types.entries[!expected].first, result)
			children = children.append(result.root)
		elif operation == Types.TYPE_TAG_DICT
			result = hir_conversion_steps(types, types.entries[!actual].second, types.entries[!expected].second, result)
			children = children.append(result.root)
		elif operation == Types.TYPE_TAG_RECORD
			let source_fields = types.entries[!actual].fields
			let target_fields = types.entries[!expected].fields
			for i in 0..len(target_fields)
				result = hir_conversion_steps(types, source_fields[!i].kind, target_fields[!i].kind, result)
				children = children.append(result.root)
	result.root = len(result.steps)
	result.steps = result.steps.append(HirConversionStep(actual, expected, operation, alternative, children))
	return result

export def hir_plan_conversion(types: Types.TypeTable, actual: i64, expected: i64) -> HirConversionPlan
	let empty = HirConversionPlan(Array[HirConversionStep](), -1, "")
	if not Types.type_coercible(types, expected, actual)
		return HirConversionPlan(empty.steps, -1, "incompatible implicit union conversion")
	return hir_conversion_steps(types, actual, expected, empty)

export def hir_expected(types: Types.TypeTable, expected: i64, found: i64) -> HirCallCheck
	if Types.type_coercible(types, expected, found)
		return HirCallCheck(types, expected, "")
	return HirCallCheck(types, Types.TYPE_TAG_INVALID, "expected " + hir_type_name(types, expected) + ", found " + hir_type_name(types, found))

export def hir_call_arguments(types: Types.TypeTable, actual: Array[i64], expected: Array[i64], result: i64, arity_error: string) -> HirCallCheck
	if len(actual) != len(expected)
		return HirCallCheck(types, Types.TYPE_TAG_INVALID, arity_error)
	for i in 0..len(actual)
		let check = hir_expected(types, expected[!i], actual[!i])
		check.error == "" else return check
	return HirCallCheck(types, result, "")

export def hir_is_builtin(name: string) -> bool
	return name == "arguments" or name == "read_text" or name == "write_text" or name == "list_dir" or name == "is_dir" or name == "path_kind" or name == "filesystem_error_kind" or name == "filesystem_error_code" or name == "print" or name == "eprint" or name == "len" or name == "str" or name == "sqrt" or name == "f64" or name == "i64" or name == "empty_array_like"

export def resolve_hir_builtin_call(types: Types.TypeTable, name: string, args: Array[i64]) -> HirCallCheck
	if name == "empty_array_like"
		if len(args) != 1
			return HirCallCheck(types, Types.TYPE_TAG_INVALID, "empty_array_like expects one array or function")
		let source = args[!0]
		let tag = Types.type_tag(types, source)
		var element = Types.TYPE_TAG_INVALID
		if tag == Types.TYPE_TAG_ARRAY
			element = types.entries[!source].first
		elif tag == Types.TYPE_TAG_FUNCTION
			element = types.entries[!source].second
		if element == Types.TYPE_TAG_INVALID or element == Types.TYPE_TAG_VOID
			return HirCallCheck(types, Types.TYPE_TAG_INVALID, "empty_array_like expects an array or a function returning a value")
		let array = Types.intern_array_type(types, element)
		return HirCallCheck(array.table, array.id, "")
	if name == "arguments"
		let array = Types.intern_array_type(types, Types.TYPE_TAG_STRING)
		return hir_call_arguments(array.table, args, Array[i64](), array.id, "arguments expects no arguments")
	if name == "filesystem_error_kind" or name == "filesystem_error_code"
		return hir_call_arguments(types, args, Array[i64](), Types.TYPE_TAG_I64, "filesystem error builtin expects no arguments")
	if name == "read_text"
		let optional = Types.intern_optional_type(types, Types.TYPE_TAG_STRING)
		return hir_call_arguments(optional.table, args, [Types.TYPE_TAG_STRING], optional.id, "read_text expects one string argument")
	if name == "write_text"
		return hir_call_arguments(types, args, [Types.TYPE_TAG_STRING, Types.TYPE_TAG_STRING], Types.TYPE_TAG_BOOL, "write_text expects two string arguments")
	if name == "list_dir"
		let array = Types.intern_array_type(types, Types.TYPE_TAG_STRING)
		let optional = Types.intern_optional_type(array.table, array.id)
		return hir_call_arguments(optional.table, args, [Types.TYPE_TAG_STRING], optional.id, "list_dir expects one string argument")
	if name == "is_dir"
		return hir_call_arguments(types, args, [Types.TYPE_TAG_STRING], Types.TYPE_TAG_BOOL, "is_dir expects one string argument")
	if name == "path_kind"
		return hir_call_arguments(types, args, [Types.TYPE_TAG_STRING], Types.TYPE_TAG_I64, "path_kind expects one string argument")
	if name == "str"
		if len(args) != 1 or args[!0] != Types.TYPE_TAG_I64
			return HirCallCheck(types, Types.TYPE_TAG_INVALID, "str expects one i64 argument")
		return HirCallCheck(types, Types.TYPE_TAG_STRING, "")
	if name == "f64"
		return hir_call_arguments(types, args, [Types.TYPE_TAG_I64], Types.TYPE_TAG_F64, "f64 expects one i64 argument")
	if name == "i64"
		return hir_call_arguments(types, args, [Types.TYPE_TAG_F64], Types.TYPE_TAG_I64, "i64 expects one f64 argument")
	if name == "sqrt"
		return hir_call_arguments(types, args, [Types.TYPE_TAG_F64], Types.TYPE_TAG_F64, "sqrt expects one argument")
	if name == "print" or name == "eprint"
		if len(args) != 1
			return HirCallCheck(types, Types.TYPE_TAG_INVALID, "print expects one argument")
		let id = args[!0]
		if id == Types.TYPE_TAG_I64 or id == Types.TYPE_TAG_F64 or id == Types.TYPE_TAG_BOOL or id == Types.TYPE_TAG_STRING
			return HirCallCheck(types, Types.TYPE_TAG_VOID, "")
		return HirCallCheck(types, Types.TYPE_TAG_INVALID, "cannot print this type")
	if name == "len"
		if len(args) != 1
			return HirCallCheck(types, Types.TYPE_TAG_INVALID, "len expects one argument")
		let id = args[!0]
		if id >= 0 and id < len(types.entries)
			let tag = types.entries[!id].tag
			if tag == Types.TYPE_TAG_STRING or tag == Types.TYPE_TAG_ARRAY or tag == Types.TYPE_TAG_DICT
				return HirCallCheck(types, Types.TYPE_TAG_I64, "")
		return HirCallCheck(types, Types.TYPE_TAG_INVALID, "len expects a string or array")
	return HirCallCheck(types, Types.TYPE_TAG_INVALID, "unknown builtin")

export def hir_is_string_method(name: string) -> bool
	return name == "byte_at" or name == "slice" or name == "find" or name == "starts_with" or name == "ends_with" or name == "join"

export def resolve_hir_string_call(types: Types.TypeTable, receiver: i64, method: string, args: Array[i64]) -> HirCallCheck
	var current = types
	let check = hir_expected(types, Types.TYPE_TAG_STRING, receiver)
	check.error == "" else return check
	var expected = Array[i64]()
	var result = Types.TYPE_TAG_BOOL
	if method == "byte_at"
		expected = [Types.TYPE_TAG_I64]
	elif method == "slice"
		expected = [Types.TYPE_TAG_I64, Types.TYPE_TAG_I64]
		result = Types.TYPE_TAG_STRING
	elif method == "find"
		expected = [Types.TYPE_TAG_STRING]
	elif method == "starts_with" or method == "ends_with"
		expected = [Types.TYPE_TAG_STRING]
	elif method == "join"
		let array = Types.intern_array_type(types, Types.TYPE_TAG_STRING)
		current = array.table
		expected = [array.id]
		result = Types.TYPE_TAG_STRING
	if method == "byte_at" or method == "find"
		let optional = Types.intern_optional_type(types, Types.TYPE_TAG_I64)
		current = optional.table
		result = optional.id
	return hir_call_arguments(current, args, expected, result, "string method argument count mismatch")

export def resolve_hir_function_call(types: Types.TypeTable, name: string, args: Array[i64], params: Array[i64], result: i64) -> HirCallCheck
	if len(args) != len(params)
		return HirCallCheck(types, Types.TYPE_TAG_INVALID, "argument count mismatch for '" + name + "'")
	for i in 0..len(args)
		if params[!i] != Types.TYPE_TAG_INVALID
			let check = hir_expected(types, params[!i], args[!i])
			check.error == "" else return check
	return HirCallCheck(types, result, "")

# Collection method typing only examines the canonical container descriptor.
export def resolve_hir_collection_call(types: Types.TypeTable, receiver: i64, method: string, args: Array[i64]) -> HirCallCheck
	if receiver < 0 or receiver >= len(types.entries)
		return HirCallCheck(types, Types.TYPE_TAG_INVALID, "unknown collection receiver type")
	let descriptor = types.entries[!receiver]
	if method == "append"
		if descriptor.tag != Types.TYPE_TAG_ARRAY
			return HirCallCheck(types, Types.TYPE_TAG_INVALID, "append requires an array")
		return hir_call_arguments(types, args, [descriptor.first], receiver, "append expects one argument")
	if descriptor.tag != Types.TYPE_TAG_DICT
		return HirCallCheck(types, Types.TYPE_TAG_INVALID, "dictionary method requires Dict")
	if method == "insert"
		return hir_call_arguments(types, args, [descriptor.first, descriptor.second], receiver, "dictionary method argument count mismatch")
	if method == "get"
		let optional = Types.intern_optional_type(types, descriptor.second)
		return hir_call_arguments(optional.table, args, [descriptor.first], optional.id, "dictionary method argument count mismatch")
	return HirCallCheck(types, Types.TYPE_TAG_INVALID, "unknown collection method")


# Record construction is a semantic operation. The editor carries canonical
# TypeIds, independent of source-level field ordering and C field expressions.
export let HIR_RECORD = 19

export rec HirRecordUpdated(index: i64)
export rec HirRecordEditError(message: string)
export let HirRecordEditOutcome = HirRecordUpdated | HirRecordEditError
export rec HirRecordEdit(fields: Array[Types.RecordField], outcome: HirRecordEditOutcome)

export def hir_record_field(fields: Array[Types.RecordField], name: string) -> i64
	for i in 0..len(fields)
		if fields[!i].name == name
			return i
	return -1

export def hir_record_put(fields: Array[Types.RecordField], name: string, type_id: i64) -> HirRecordEdit
	if type_id == Types.TYPE_TAG_INVALID or type_id == Types.TYPE_TAG_VOID
		return HirRecordEdit(fields, HirRecordEditError("invalid record field type"))
	let index = hir_record_field(fields, name)
	var result = fields
	if index >= 0
		result[!index] = Types.RecordField(name, type_id)
	else
		result = result.append(Types.RecordField(name, type_id))
	return HirRecordEdit(result, HirRecordUpdated(index))

export def hir_record_delete(fields: Array[Types.RecordField], name: string) -> HirRecordEdit
	let index = hir_record_field(fields, name)
	if index < 0
		return HirRecordEdit(fields, HirRecordEditError("unknown deleted field '" + name + "'"))
	var result = Array[Types.RecordField]()
	for i in 0..len(fields)
		if i != index
			result = result.append(fields[!i])
	return HirRecordEdit(result, HirRecordUpdated(index))

export def hir_record_spread(types: Types.TypeTable, fields: Array[Types.RecordField], owner: i64) -> HirRecordEdit
	if owner < 0 or owner >= len(types.entries)
		return HirRecordEdit(fields, HirRecordEditError("record spread expects a record"))
	let descriptor = types.entries[!owner]
	if descriptor.tag != Types.TYPE_TAG_RECORD
		return HirRecordEdit(fields, HirRecordEditError("record spread expects a record"))
	var result = fields
	for field in descriptor.fields
		let edit = hir_record_put(result, field.name, field.kind)
		match edit.outcome
			HirRecordUpdated
				result = edit.fields
			HirRecordEditError(message)
				return HirRecordEdit(result, HirRecordEditError(message))
	return HirRecordEdit(result, HirRecordUpdated(-1))

export def resolve_hir_record(types: Types.TypeTable, fields: Array[Types.RecordField]) -> HirCallCheck
	let interned = Types.intern_record_type(types, fields)
	return HirCallCheck(interned.table, interned.id, "")

export def hir_constructor_publish(fields: Array[Types.RecordField], name: string, type_id: i64) -> HirRecordEdit
	return hir_record_put(fields, name, type_id)

# Positional match bindings follow constructor parameters first. Additional
# published fields follow in canonical (lexicographic) record-field order.
export def hir_match_field_index(fields: Array[Types.RecordField], parameters: Array[Hir.HirParameterDecl], position: i64) -> i64
	if position < len(parameters)
		for i in 0..len(fields)
			if fields[!i].name == parameters[!position].name
				return i
		return -1
	var extra = len(parameters)
	for i in 0..len(fields)
		var parameter = false
		for item in parameters
			if item.name == fields[!i].name
				parameter = true
		if not parameter
			if extra == position
				return i
			extra += 1
	return -1


# Exhaustiveness checks carry exactly one semantic outcome. The alternative
# payload is meaningful only for repeated and missing arms; errors that have
# no alternative cannot accidentally expose a sentinel TypeId.
export rec HirMatchComplete()
export rec HirMatchInvalid(message: string)
export rec HirMatchRepeated(alternative: i64)
export rec HirMatchMissing(alternative: i64)
export let HirMatchOutcome = HirMatchComplete | HirMatchInvalid | HirMatchRepeated | HirMatchMissing

# Semantic matching operates on structural record alternatives, without
# relying on source constructor names or a C/MIR runtime representation.
export def check_exhaustive_match(types: Types.TypeTable, union_id: i64, arms: Array[i64]) -> HirMatchOutcome
	if Types.type_tag(types, union_id) != Types.TYPE_TAG_UNION
		return HirMatchInvalid("match requires a tagged union")
	var indices = Array[i64]()
	for arm in arms
		indices = indices.append(Types.union_alternative_index(types, union_id, arm))
	return check_exhaustive_match_indices(types, union_id, indices)

# Exhaustiveness is about labels, not payload record shapes. Source match
# analysis resolves each constructor name to a canonical alternative index.
export def check_exhaustive_match_indices(types: Types.TypeTable, union_id: i64, arms: Array[i64]) -> HirMatchOutcome
	if Types.type_tag(types, union_id) != Types.TYPE_TAG_UNION
		return HirMatchInvalid("match requires a tagged union")
	let members = types.entries[!union_id].fields
	var seen = Array[bool]()
	for member in members
		seen = seen.append(false)
	for index in arms
		if index < 0 or index >= len(members)
			return HirMatchInvalid("match arm is not a union alternative")
		if seen[!index]
			return HirMatchRepeated(members[!index].kind)
		seen[!index] = true
	for i in 0..len(seen)
		if not seen[!i]
			return HirMatchMissing(members[!i].kind)
	return HirMatchComplete()

# Resolve the exported constructor's source label after module name mangling.
# Only a direct constructor call or match pattern uses this entry point;
# stored record values carry no constructor identity.
export def hir_union_constructor_alternative_index(types: Types.TypeTable, union_id: i64, constructor: string, record_type: i64) -> i64
	return Types.union_constructor_alternative_index(types, union_id, Module.hir_module_symbol_member(constructor), record_type)
