# First typed HIR operations. Source indexes refer to the syntax AST arena;
# type_id is always an interned semantic TypeId, never a legacy C kind.
# Semantic resolution is independent of C syntax and runtime helper names.

let HIR_FIELD = 1
let HIR_BINARY = 2
let HIR_NAME = 3
let HIR_LITERAL = 4
let HIR_UNARY = 5

rec HirNode(source: i64, operation: i64, type_id: i64, field_index: i64)

# Index source AST node IDs to their typed annotations. Multiple operations may
# annotate one syntax node; chaining keeps lookup local to that node.
rec HirAnnotationIndex(heads: Dict[i64,i64], previous: Array[i64], source_count: i64)

def hir_annotation_index(nodes: Array[HirNode], source_count: i64) -> HirAnnotationIndex
	var heads = Dict[i64,i64]()
	var previous = Array[i64]()
	for node in nodes
		previous = previous.append(-1)
	# Preserve the first annotation for any repeated (source, operation) pair.
	for offset in 0..len(nodes)
		let i = len(nodes) - offset - 1
		let source = nodes[!i].source
		if source >= 0 and source < source_count
			previous[!i] = heads.get(source) or -1
			heads = heads.insert(source, i)
	return HirAnnotationIndex(heads, previous, source_count)

def hir_annotation_find(nodes: Array[HirNode], index: HirAnnotationIndex, source: i64, operation: i64) -> i64
	if source < 0 or source >= index.source_count
		return -1
	var at = index.heads.get(source) or -1
	while at >= 0
		if nodes[!at].operation == operation
			return at
		at = index.previous[!at]
	return -1

rec HirResolution(type_id: i64, field_index: i64, error: string)

# Bindings belong to semantic resolution; the C backend merely retains their
# temporary legacy ABI kind until the rest of emission moves to HIR.
rec SymbolInfo(name: string, kind: i64, type_id: i64, mutable: bool, depth: i64)

def resolve_hir_name(symbols: Array[SymbolInfo], name: string) -> HirResolution
	for i in 0..len(symbols)
		let index = len(symbols) - 1 - i
		let symbol = symbols[!index]
		if symbol.name == name
			return HirResolution(symbol.type_id, index, "")
	return HirResolution(TYPE_TAG_INVALID, -1, "unknown name '" + name + "'")

def hir_types_equal(left: i64, right: i64) -> bool
	return left == right and left != TYPE_TAG_INVALID

def resolve_hir_field(types: TypeTable, owner: i64, name: string) -> HirResolution
	if owner < 0 or owner >= len(types.entries)
		return HirResolution(TYPE_TAG_INVALID, -1, "unknown record field '" + name + "'")
	let descriptor = types.entries[!owner]
	if descriptor.tag == TYPE_TAG_RECORD
		for i in 0..len(descriptor.fields)
			let field = descriptor.fields[!i]
			if field.name == name
				return HirResolution(field.kind, i, "")
	return HirResolution(TYPE_TAG_INVALID, -1, "unknown record field '" + name + "'")

# Binary operations are checked on semantic type identities. The returned
# type is already canonical, so the C emitter does not reimplement these rules.
def resolve_hir_binary(types: TypeTable, left: i64, right: i64, op: string) -> HirResolution
	if left != right
		return HirResolution(TYPE_TAG_INVALID, -1, "binary operand types differ")
	if left < 0 or left >= len(types.entries)
		return HirResolution(TYPE_TAG_INVALID, -1, "unknown binary operand type")
	let tag = types.entries[!left].tag
	if op == "and" or op == "or"
		if tag != TYPE_TAG_BOOL
			return HirResolution(TYPE_TAG_INVALID, -1, "logical operator requires bool")
		return HirResolution(TYPE_TAG_BOOL, -1, "")
	if op == "==" or op == "!="
		return HirResolution(TYPE_TAG_BOOL, -1, "")
	if op == "<" or op == "<=" or op == ">" or op == ">="
		if tag != TYPE_TAG_I64 and tag != TYPE_TAG_F64 and tag != TYPE_TAG_STRING
			return HirResolution(TYPE_TAG_INVALID, -1, "comparison requires numeric or string operands")
		return HirResolution(TYPE_TAG_BOOL, -1, "")
	if op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
		if tag != TYPE_TAG_I64 and tag != TYPE_TAG_F64 and not (op == "+" and tag == TYPE_TAG_STRING)
			return HirResolution(TYPE_TAG_INVALID, -1, "arithmetic requires numeric operands")
		if op == "%" and tag != TYPE_TAG_I64
			return HirResolution(TYPE_TAG_INVALID, -1, "remainder requires i64")
		return HirResolution(left, -1, "")
	return HirResolution(TYPE_TAG_INVALID, -1, "unsupported binary operator '" + op + "'")

# Literal classification and unary operand validation are compiler semantics,
# independent of how the eventual backend materializes the value.
def resolve_hir_literal(node_kind: i64) -> i64
	if node_kind == NODE_INTEGER
		return TYPE_TAG_I64
	if node_kind == NODE_FLOAT
		return TYPE_TAG_F64
	if node_kind == NODE_BOOL
		return TYPE_TAG_BOOL
	if node_kind == NODE_STRING
		return TYPE_TAG_STRING
	return TYPE_TAG_INVALID

def resolve_hir_unary(types: TypeTable, operand: i64, op: string) -> HirResolution
	if operand < 0 or operand >= len(types.entries)
		return HirResolution(TYPE_TAG_INVALID, -1, "invalid unary operand")
	let tag = types.entries[!operand].tag
	if op == "not" and tag == TYPE_TAG_BOOL
		return HirResolution(TYPE_TAG_BOOL, -1, "")
	if (op == "-" or op == "+") and (tag == TYPE_TAG_I64 or tag == TYPE_TAG_F64)
		return HirResolution(operand, -1, "")
	return HirResolution(TYPE_TAG_INVALID, -1, "unsupported unary operator '" + op + "'")

# A specialization belongs to semantic HIR, not to a particular code emitter.
# definition is the function declaration's stable AST body ID for this module;
# future cross-module symbol IDs can replace it without changing the registry.
# Canonical argument TypeIds are interned in the owning module TypeTable.
let HIR_SPEC_IN_PROGRESS = 1
let HIR_SPEC_COMPLETE = 2

rec HirSpecialization(definition: i64, arguments: Array[i64], result_type: i64, status: i64)
rec HirSpecializationRegistry(entries: Array[HirSpecialization])
# Resolved call targets share these stable IDs with MIR function indices.
rec HirSpecializedCall(source: i64, specialization: i64)
rec HirSpecializationStart(registry: HirSpecializationRegistry, index: i64, created: bool)

def new_hir_specializations() -> HirSpecializationRegistry
	return HirSpecializationRegistry(Array[HirSpecialization]())

def hir_find_specialization(registry: HirSpecializationRegistry, definition: i64, arguments: Array[i64]) -> i64
	for i in 0..len(registry.entries)
		let entry = registry.entries[!i]
		if entry.definition != definition or len(entry.arguments) != len(arguments)
			continue
		var same = true
		for j in 0..len(arguments)
			if entry.arguments[!j] != arguments[!j]
				same = false
		if same
			return i
	return -1

# Insert BEFORE analyzing a body. Recursive calls then reuse the in-progress
# entry rather than triggering another specialization of the same signature.
def hir_begin_specialization(registry: HirSpecializationRegistry, definition: i64, arguments: Array[i64], result_type: i64) -> HirSpecializationStart
	let existing = hir_find_specialization(registry, definition, arguments)
	if existing >= 0
		return HirSpecializationStart(registry, existing, false)
	var next = registry
	let index = len(next.entries)
	next.entries = next.entries.append(HirSpecialization(definition, arguments, result_type, HIR_SPEC_IN_PROGRESS))
	return HirSpecializationStart(next, index, true)

def hir_complete_specialization(registry: HirSpecializationRegistry, index: i64, result_type: i64) -> HirSpecializationRegistry
	var next = registry
	let entry = next.entries[!index]
	next.entries[!index] = HirSpecialization(entry.definition, entry.arguments, result_type, HIR_SPEC_COMPLETE)
	return next

# Call signature validation is semantic: no C names or ownership helpers.
# A checked call returns an interned result type, and (possibly) an extended
# type table for results such as Optional[string].
let HIR_CALL = 6

rec HirCallCheck(table: TypeTable, type_id: i64, error: string)

def hir_type_name(types: TypeTable, id: i64) -> string
	if id < 0 or id >= len(types.entries)
		return "unknown"
	let descriptor = types.entries[!id]
	if descriptor.tag == TYPE_TAG_I64
		return "i64"
	if descriptor.tag == TYPE_TAG_F64
		return "f64"
	if descriptor.tag == TYPE_TAG_BOOL
		return "bool"
	if descriptor.tag == TYPE_TAG_STRING
		return "string"
	if descriptor.tag == TYPE_TAG_VOID
		return "void"
	if descriptor.tag == TYPE_TAG_ARRAY
		return "Array[" + hir_type_name(types, descriptor.first) + "]"
	if descriptor.tag == TYPE_TAG_DICT
		return "Dict[" + hir_type_name(types, descriptor.first) + "," + hir_type_name(types, descriptor.second) + "]"
	if descriptor.tag == TYPE_TAG_OPTIONAL
		return "Optional[" + hir_type_name(types, descriptor.first) + "]"
	return "record"

def hir_expected(types: TypeTable, expected: i64, found: i64) -> HirCallCheck
	if hir_types_equal(expected, found)
		return HirCallCheck(types, expected, "")
	return HirCallCheck(types, TYPE_TAG_INVALID, "expected " + hir_type_name(types, expected) + ", found " + hir_type_name(types, found))

def hir_call_arguments(types: TypeTable, actual: Array[i64], expected: Array[i64], result: i64, arity_error: string) -> HirCallCheck
	if len(actual) != len(expected)
		return HirCallCheck(types, TYPE_TAG_INVALID, arity_error)
	for i in 0..len(actual)
		let check = hir_expected(types, expected[!i], actual[!i])
		check.error == "" else return check
	return HirCallCheck(types, result, "")

def hir_is_builtin(name: string) -> bool
	return name == "arguments" or name == "read_text" or name == "write_text" or name == "print" or name == "len" or name == "str" or name == "sqrt"

def resolve_hir_builtin_call(types: TypeTable, name: string, args: Array[i64]) -> HirCallCheck
	if name == "arguments"
		let array = intern_array_type(types, TYPE_TAG_STRING)
		return hir_call_arguments(array.table, args, Array[i64](), array.id, "arguments expects no arguments")
	if name == "read_text"
		let optional = intern_optional_type(types, TYPE_TAG_STRING)
		return hir_call_arguments(optional.table, args, [TYPE_TAG_STRING], optional.id, "read_text expects one string argument")
	if name == "write_text"
		return hir_call_arguments(types, args, [TYPE_TAG_STRING, TYPE_TAG_STRING], TYPE_TAG_BOOL, "write_text expects two string arguments")
	if name == "str"
		if len(args) != 1 or args[!0] != TYPE_TAG_I64
			return HirCallCheck(types, TYPE_TAG_INVALID, "str expects one i64 argument")
		return HirCallCheck(types, TYPE_TAG_STRING, "")
	if name == "sqrt"
		return hir_call_arguments(types, args, [TYPE_TAG_F64], TYPE_TAG_F64, "sqrt expects one argument")
	if name == "print"
		if len(args) != 1
			return HirCallCheck(types, TYPE_TAG_INVALID, "print expects one argument")
		let id = args[!0]
		if id == TYPE_TAG_I64 or id == TYPE_TAG_F64 or id == TYPE_TAG_BOOL or id == TYPE_TAG_STRING
			return HirCallCheck(types, TYPE_TAG_VOID, "")
		return HirCallCheck(types, TYPE_TAG_INVALID, "cannot print this type")
	if name == "len"
		if len(args) != 1
			return HirCallCheck(types, TYPE_TAG_INVALID, "len expects one argument")
		let id = args[!0]
		if id >= 0 and id < len(types.entries)
			let tag = types.entries[!id].tag
			if tag == TYPE_TAG_STRING or tag == TYPE_TAG_ARRAY or tag == TYPE_TAG_DICT
				return HirCallCheck(types, TYPE_TAG_I64, "")
		return HirCallCheck(types, TYPE_TAG_INVALID, "len expects a string or array")
	return HirCallCheck(types, TYPE_TAG_INVALID, "unknown builtin")

def hir_is_string_method(name: string) -> bool
	return name == "byte_at" or name == "slice" or name == "find" or name == "starts_with" or name == "ends_with" or name == "join"

def resolve_hir_string_call(types: TypeTable, receiver: i64, method: string, args: Array[i64]) -> HirCallCheck
	var current = types
	let check = hir_expected(types, TYPE_TAG_STRING, receiver)
	check.error == "" else return check
	var expected = Array[i64]()
	var result = TYPE_TAG_BOOL
	if method == "byte_at"
		expected = [TYPE_TAG_I64]
	elif method == "slice"
		expected = [TYPE_TAG_I64, TYPE_TAG_I64]
		result = TYPE_TAG_STRING
	elif method == "find"
		expected = [TYPE_TAG_STRING]
	elif method == "starts_with" or method == "ends_with"
		expected = [TYPE_TAG_STRING]
	elif method == "join"
		let array = intern_array_type(types, TYPE_TAG_STRING)
		current = array.table
		expected = [array.id]
		result = TYPE_TAG_STRING
	if method == "byte_at" or method == "find"
		let optional = intern_optional_type(types, TYPE_TAG_I64)
		current = optional.table
		result = optional.id
	return hir_call_arguments(current, args, expected, result, "string method argument count mismatch")

def resolve_hir_function_call(types: TypeTable, name: string, args: Array[i64], params: Array[i64], result: i64) -> HirCallCheck
	if len(args) != len(params)
		return HirCallCheck(types, TYPE_TAG_INVALID, "argument count mismatch for '" + name + "'")
	for i in 0..len(args)
		if params[!i] != TYPE_TAG_INVALID
			let check = hir_expected(types, params[!i], args[!i])
			check.error == "" else return check
	return HirCallCheck(types, result, "")

# Collection method typing only examines the canonical container descriptor.
def resolve_hir_collection_call(types: TypeTable, receiver: i64, method: string, args: Array[i64]) -> HirCallCheck
	if receiver < 0 or receiver >= len(types.entries)
		return HirCallCheck(types, TYPE_TAG_INVALID, "unknown collection receiver type")
	let descriptor = types.entries[!receiver]
	if method == "append"
		if descriptor.tag != TYPE_TAG_ARRAY
			return HirCallCheck(types, TYPE_TAG_INVALID, "append requires an array")
		return hir_call_arguments(types, args, [descriptor.first], receiver, "append expects one argument")
	if descriptor.tag != TYPE_TAG_DICT
		return HirCallCheck(types, TYPE_TAG_INVALID, "dictionary method requires Dict")
	if method == "insert"
		return hir_call_arguments(types, args, [descriptor.first, descriptor.second], receiver, "dictionary method argument count mismatch")
	if method == "get"
		let optional = intern_optional_type(types, descriptor.second)
		return hir_call_arguments(optional.table, args, [descriptor.first], optional.id, "dictionary method argument count mismatch")
	return HirCallCheck(types, TYPE_TAG_INVALID, "unknown collection method")


# Record construction is a semantic operation. The editor carries canonical
# TypeIds, independent of source-level field ordering and C field expressions.
let HIR_RECORD = 7
let HIR_CONSTRUCTOR = 8

rec HirRecordEdit(fields: Array[RecordField], index: i64, error: string)

def hir_record_field(fields: Array[RecordField], name: string) -> i64
	for i in 0..len(fields)
		if fields[!i].name == name
			return i
	return -1

def hir_record_put(fields: Array[RecordField], name: string, type_id: i64) -> HirRecordEdit
	if type_id == TYPE_TAG_INVALID or type_id == TYPE_TAG_VOID
		return HirRecordEdit(fields, -1, "invalid record field type")
	let index = hir_record_field(fields, name)
	var result = fields
	if index >= 0
		result[!index] = RecordField(name, type_id)
	else
		result = result.append(RecordField(name, type_id))
	return HirRecordEdit(result, index, "")

def hir_record_delete(fields: Array[RecordField], name: string) -> HirRecordEdit
	let index = hir_record_field(fields, name)
	if index < 0
		return HirRecordEdit(fields, -1, "unknown deleted field '" + name + "'")
	var result = Array[RecordField]()
	for i in 0..len(fields)
		if i != index
			result = result.append(fields[!i])
	return HirRecordEdit(result, index, "")

def hir_record_spread(types: TypeTable, fields: Array[RecordField], owner: i64) -> HirRecordEdit
	if owner < 0 or owner >= len(types.entries)
		return HirRecordEdit(fields, -1, "record spread expects a record")
	let descriptor = types.entries[!owner]
	if descriptor.tag != TYPE_TAG_RECORD
		return HirRecordEdit(fields, -1, "record spread expects a record")
	var result = fields
	for field in descriptor.fields
		result = hir_record_put(result, field.name, field.kind).fields
	return HirRecordEdit(result, -1, "")

def resolve_hir_record(types: TypeTable, fields: Array[RecordField]) -> HirCallCheck
	if len(fields) == 0
		return HirCallCheck(types, TYPE_TAG_INVALID, "empty records are not supported yet")
	let interned = intern_record_type(types, fields)
	return HirCallCheck(interned.table, interned.id, "")

def hir_constructor_publish(fields: Array[RecordField], name: string, type_id: i64) -> HirRecordEdit
	if hir_record_field(fields, name) >= 0
		return HirRecordEdit(fields, -1, "constructor field overrides are not supported yet")
	return hir_record_put(fields, name, type_id)


# Pre-emission module declaration pass. Index every function and module constant
# in source order, and validate declaration syntax before generating any C.
# Type annotations remain AST references until constructors have been resolved;
# concrete generic signatures are determined later during specialization.
rec HirParameterDecl(name: string, source: i64, type_node: i64)

rec HirFunctionDecl(name: string, source: i64, body: i64, constructor: bool, result_type_node: i64, parameters: Array[HirParameterDecl])

rec HirModuleConstant(name: string, value: i64)
rec HirConstantEval(value: i64, valid: bool)
rec HirModuleDecl(functions: Array[HirFunctionDecl], constants: Array[HirModuleConstant], error: string, error_line: i64)

def hir_eval_constant(tree: ParseState, id: i64, constants: Array[HirModuleConstant]) -> HirConstantEval
	let node = tree.nodes[!id]
	let value = hir_ast_text(tree, id)
	if node.kind == NODE_INTEGER
		var number = 0
		for i in 0..len(value)
			number = number * 10 + (value.byte_at(i) or 48) - 48
		return HirConstantEval(number, true)
	if node.kind == NODE_NAME
		for item in constants
			if item.name == value
				return HirConstantEval(item.value, true)
	if node.kind == NODE_UNARY and (value == "-" or value == "+")
		let inner = hir_eval_constant(tree, hir_ast_child(tree, id, 0), constants)
		if not inner.valid
			return inner
		if value == "-"
			return HirConstantEval(-inner.value, true)
		return inner
	if node.kind == NODE_BINARY and (value == "+" or value == "-" or value == "*")
		let left = hir_eval_constant(tree, hir_ast_child(tree, id, 0), constants)
		let right = hir_eval_constant(tree, hir_ast_child(tree, id, 1), constants)
		if not left.valid or not right.valid
			return HirConstantEval(0, false)
		if value == "+"
			return HirConstantEval(left.value + right.value, true)
		if value == "-"
			return HirConstantEval(left.value - right.value, true)
		return HirConstantEval(left.value * right.value, true)
	return HirConstantEval(0, false)


def hir_ast_child(tree: ParseState, id: i64, offset: i64) -> i64
	let node = tree.nodes[!id]
	return tree.edges[!node.first + offset]

def hir_ast_text(tree: ParseState, id: i64) -> string
	return token_text(tree.source, tree.tokens[!tree.nodes[!id].token])

def hir_ast_line(tree: ParseState, id: i64) -> i64
	return tree.tokens[!tree.nodes[!id].token].line

def hir_declaration_error(functions: Array[HirFunctionDecl], constants: Array[HirModuleConstant], message: string, line: i64) -> HirModuleDecl
	return HirModuleDecl(functions, constants, message, line)

def hir_module_declarations(tree: ParseState, root: i64) -> HirModuleDecl
	var functions = Array[HirFunctionDecl]()
	var names = Array[string]()
	var constants = Array[HirModuleConstant]()
	let module = tree.nodes[!root]
	for i in 0..module.count
		let id = hir_ast_child(tree, root, i)
		let entry = tree.nodes[!id]
		let name = hir_ast_text(tree, id)
		if entry.kind != NODE_DEF and entry.kind != NODE_REC and entry.kind != NODE_LET
			return hir_declaration_error(functions, constants, "unsupported module statement", hir_ast_line(tree, id))
		if name == "print" and (entry.kind == NODE_DEF or entry.kind == NODE_REC)
			return hir_declaration_error(functions, constants, "duplicate function '" + name + "'", hir_ast_line(tree, id))
		for seen in names
			if seen == name
				if entry.kind == NODE_LET
					return hir_declaration_error(functions, constants, "duplicate module name", hir_ast_line(tree, id))
				return hir_declaration_error(functions, constants, "duplicate function '" + name + "'", hir_ast_line(tree, id))
		names = names.append(name)
		if entry.kind == NODE_LET
			if entry.count == 0
				return hir_declaration_error(functions, constants, "module constant requires initializer", hir_ast_line(tree, id))
			let initializer = hir_ast_child(tree, id, entry.count - 1)
			let evaluated = hir_eval_constant(tree, initializer, constants)
			if not evaluated.valid
				return hir_declaration_error(functions, constants, "unsupported module constant initializer", hir_ast_line(tree, id))
			constants = constants.append(HirModuleConstant(name, evaluated.value))
			continue
		var parameters = Array[HirParameterDecl]()
		var return_type = -1
		for j in 0..entry.count - 1
			let part = hir_ast_child(tree, id, j)
			let info = tree.nodes[!part]
			if info.kind == NODE_PARAM
				var annotation = -1
				if info.count > 0
					annotation = hir_ast_child(tree, part, 0)
					if info.count != 1 or tree.nodes[!annotation].kind != NODE_TYPE
						return hir_declaration_error(functions, constants, "parameter defaults are not supported yet", hir_ast_line(tree, part))
				let pname = hir_ast_text(tree, part)
				for previous in parameters
					if previous.name == pname
						return hir_declaration_error(functions, constants, "duplicate parameter '" + pname + "'", hir_ast_line(tree, part))
				parameters = parameters.append(HirParameterDecl(pname, part, annotation))
			elif info.kind == NODE_TYPE
				return_type = part
		let body_id = hir_ast_child(tree, id, entry.count - 1)
		if entry.kind == NODE_REC
			var published = Array[string]()
			let body = tree.nodes[!body_id]
			for j in 0..body.count
				let pub_id = hir_ast_child(tree, body_id, j)
				if tree.nodes[!pub_id].kind == NODE_PUB
					var field_name = hir_ast_text(tree, pub_id)
					if tree.nodes[!pub_id].count > 0
						let value_id = hir_ast_child(tree, pub_id, 0)
						if tree.nodes[!value_id].kind == NODE_ATTR
							field_name = hir_ast_text(tree, value_id)
					for seen in published
						if seen == field_name
							return hir_declaration_error(functions, constants, "constructor field overrides are not supported yet", hir_ast_line(tree, pub_id))
					published = published.append(field_name)
		if entry.kind == NODE_DEF
			let body = tree.nodes[!body_id]
			for j in 0..body.count
				if tree.nodes[!hir_ast_child(tree, body_id, j)].kind == NODE_PUB
					return hir_declaration_error(functions, constants, "def constructors are no longer supported; use rec", hir_ast_line(tree, id))
		functions = functions.append(HirFunctionDecl(name, id, body_id, entry.kind == NODE_REC, return_type, parameters))
	return HirModuleDecl(functions, constants, "", 0)

# Independent, pre-emission body analysis. Unresolved types are explicitly
# deferred rather than guessed: specialization and collection typing still
# belong to the legacy emitter during this migration.
let HIR_BINDING = 9
let HIR_ASSIGN = 10
let HIR_ARRAY = 11
let HIR_INDEX = 12
let HIR_UNWRAP = 13

# Specialization requests are discovered while analyzing a concrete function.
# source is the call AST node; definition is the callee's declaration body ID.
rec HirSpecializationRequest(source: i64, definition: i64, arguments: Array[i64])

rec HirBodyState(tree: ParseState, names: Array[string], constants: Array[string])
	pub symbols = Array[SymbolInfo]()
	pub nodes = Array[HirNode]()
	pub types = new_type_table()
	pub depth = 0
	pub last_type = TYPE_TAG_INVALID
	pub error = ""
	pub error_line = 0
	pub functions = Array[HirFunctionDecl]()
	pub active_functions = Array[string]()
	pub inferred_return = TYPE_TAG_INVALID
	pub collect_calls = false
	pub requests = Array[HirSpecializationRequest]()
	pub module_constants = Array[HirModuleConstant]()

rec HirBodyAnalysis(nodes: Array[HirNode], error: string, error_line: i64)

def hir_body_error(state: HirBodyState, id: i64, message: string) -> HirBodyState
	var result = state
	if result.error == ""
		result.error = message
		result.error_line = hir_ast_line(state.tree, id)
	return result

# Resolve primitive and nested collection constructors without C ABI kinds.
# Unsupported type expressions stay unresolved until specialization.
def hir_body_type_reference(types: TypeTable, tree: ParseState, id: i64) -> HirCallCheck
	let node = tree.nodes[!id]
	if node.kind == NODE_NAME or node.kind == NODE_TYPE
		let name = hir_ast_text(tree, id)
		if node.count == 0
			if name == "i64"
				return HirCallCheck(types, TYPE_TAG_I64, "")
			if name == "f64"
				return HirCallCheck(types, TYPE_TAG_F64, "")
			if name == "bool"
				return HirCallCheck(types, TYPE_TAG_BOOL, "")
			if name == "string"
				return HirCallCheck(types, TYPE_TAG_STRING, "")
			return HirCallCheck(types, TYPE_TAG_INVALID, "")
	else
		if node.kind != NODE_INDEX or node.count < 2
			return HirCallCheck(types, TYPE_TAG_INVALID, "")
	var name = hir_ast_text(tree, id)
	var first = 0
	if node.kind == NODE_INDEX
		name = hir_ast_text(tree, hir_ast_child(tree, id, 0))
		first = 1
	if name != "Array" and name != "Dict" and name != "Optional"
		return HirCallCheck(types, TYPE_TAG_INVALID, "")
	if (name == "Dict" and node.count != first + 2) or (name != "Dict" and node.count != first + 1)
		return HirCallCheck(types, TYPE_TAG_INVALID, "")
	let element = hir_body_type_reference(types, tree, hir_ast_child(tree, id, first))
	if element.type_id == TYPE_TAG_INVALID
		return element
	if name == "Array"
		let array = intern_array_type(element.table, element.type_id)
		return HirCallCheck(array.table, array.id, "")
	if name == "Optional"
		let optional = intern_optional_type(element.table, element.type_id)
		return HirCallCheck(optional.table, optional.id, "")
	let value = hir_body_type_reference(element.table, tree, hir_ast_child(tree, id, first + 1))
	if value.type_id == TYPE_TAG_INVALID
		return value
	let dict = intern_dict_type(value.table, element.type_id, value.type_id)
	return HirCallCheck(dict.table, dict.id, "")

# Named record annotations refer to a constructor's canonical published shape.
# The plain resolver above remains useful for type-only clients without a module.
def hir_module_type_reference_with_constants(types: TypeTable, tree: ParseState, id: i64, functions: Array[HirFunctionDecl], constants: Array[HirModuleConstant]) -> HirCallCheck
	let resolved = hir_body_type_reference(types, tree, id)
	if resolved.type_id != TYPE_TAG_INVALID
		return resolved
	let node = tree.nodes[!id]
	if (node.kind == NODE_NAME or node.kind == NODE_TYPE) and node.count == 0
		let name = hir_ast_text(tree, id)
		for function in functions
			if function.name == name and function.constructor
				var current = types
				var arguments = Array[i64]()
				for parameter in function.parameters
					if parameter.type_node < 0
						return HirCallCheck(current, TYPE_TAG_INVALID, "named record type requires annotated constructor parameters")
					let argument = hir_module_type_reference_with_constants(current, tree, parameter.type_node, functions, constants)
					if argument.type_id == TYPE_TAG_INVALID
						return argument
					current = argument.table
					arguments = arguments.append(argument.type_id)
				var state = HirBodyState(tree, Array[string](), Array[string]())
				state.types = current
				state.functions = functions
				state.module_constants = constants
				let constructed = hir_body_user_call(state, id, name, arguments)
				return HirCallCheck(constructed.types, constructed.last_type, constructed.error)
		return resolved
	var name = hir_ast_text(tree, id)
	var start = 0
	if node.kind == NODE_INDEX and node.count > 0
		name = hir_ast_text(tree, hir_ast_child(tree, id, 0))
		start = 1
	if name != "Array" and name != "Optional" and name != "Dict"
		return resolved
	if (name == "Dict" and node.count != start + 2) or (name != "Dict" and node.count != start + 1)
		return resolved
	let first = hir_module_type_reference_with_constants(types, tree, hir_ast_child(tree, id, start), functions, constants)
	if first.type_id == TYPE_TAG_INVALID
		return first
	if name == "Array"
		let result = intern_array_type(first.table, first.type_id)
		return HirCallCheck(result.table, result.id, "")
	if name == "Optional"
		let result = intern_optional_type(first.table, first.type_id)
		return HirCallCheck(result.table, result.id, "")
	let second = hir_module_type_reference_with_constants(first.table, tree, hir_ast_child(tree, id, start + 1), functions, constants)
	if second.type_id == TYPE_TAG_INVALID
		return second
	let result = intern_dict_type(second.table, first.type_id, second.type_id)
	return HirCallCheck(result.table, result.id, "")

# Compatibility for clients without module constants.
def hir_module_type_reference(types: TypeTable, tree: ParseState, id: i64, functions: Array[HirFunctionDecl]) -> HirCallCheck
	return hir_module_type_reference_with_constants(types, tree, id, functions, Array[HirModuleConstant]())

def hir_body_binding(state: HirBodyState, id: i64, name: string, type_id: i64, mutable: bool) -> HirBodyState
	var result = state
	for symbol in result.symbols
		if symbol.name == name and symbol.depth == result.depth
			return hir_body_error(result, id, "duplicate binding '" + name + "'")
	result.symbols = result.symbols.append(SymbolInfo(name, type_id, type_id, mutable, result.depth))
	result.nodes = result.nodes.append(HirNode(id, HIR_BINDING, type_id, len(result.symbols) - 1))
	return result

# Resolve concrete user calls independently of C emission. Unknown parameter or
# return types are deferred; an active unannotated recursive call is deferred too.
# The backend remains responsible for generating/reusing specializations.
def hir_body_user_call(state: HirBodyState, id: i64, name: string, args: Array[i64]) -> HirBodyState
	var result = state
	var found = false
	var function = HirFunctionDecl("", -1, -1, false, -1, Array[HirParameterDecl]())
	for candidate in state.functions
		if candidate.name == name
			function = candidate
			found = true
	if not found
		return result
	if len(args) != len(function.parameters)
		return hir_body_error(result, id, "argument count mismatch for '" + name + "'")
	for i in 0..len(args)
		let parameter = function.parameters[!i]
		if parameter.type_node >= 0
			let annotation = hir_module_type_reference_with_constants(result.types, result.tree, parameter.type_node, result.functions, result.module_constants)
			result.types = annotation.table
			if annotation.type_id != TYPE_TAG_INVALID and annotation.type_id != args[!i]
				return hir_body_error(result, id, "expected " + hir_type_name(result.types, annotation.type_id) + ", found " + hir_type_name(result.types, args[!i]))
	# In concrete-specialization mode, register calls for the HIR worklist.
	# Do not recursively analyze callees from inside an expression.
	if result.collect_calls and not function.constructor
		result.requests = result.requests.append(HirSpecializationRequest(id, function.body, args))
		if function.result_type_node >= 0
			let declared = hir_module_type_reference_with_constants(result.types, result.tree, function.result_type_node, result.functions, result.module_constants)
			result.types = declared.table
			result.last_type = declared.type_id
			return result
		# Unannotated callees need a concrete result type for their caller's
		# expressions. Infer it without recursively registering specializations.
		# The worklist still owns emission and deduplication of these calls.
	if function.constructor
		var nested = HirBodyState(state.tree, state.names, state.constants)
		nested.types = result.types
		nested.functions = state.functions
		nested.module_constants = state.module_constants
		nested.active_functions = state.active_functions
		nested.collect_calls = result.collect_calls
		for i in 0..len(args)
			let param = function.parameters[!i]
			nested = hir_body_binding(nested, param.source, param.name, args[!i], false)
		var fields = Array[RecordField]()
		let block = state.tree.nodes[!function.body]
		for i in 0..block.count
			let pub_id = hir_ast_child(state.tree, function.body, i)
			let pub = state.tree.nodes[!pub_id]
			if pub.kind != NODE_PUB
				return result
			var field_name = hir_ast_text(state.tree, pub_id)
			var field_type = TYPE_TAG_INVALID
			if pub.count == 0
				let symbol = resolve_hir_name(nested.symbols, field_name)
				field_type = symbol.type_id
			else
				let expression = hir_ast_child(state.tree, pub_id, 0)
				if state.tree.nodes[!expression].kind == NODE_ATTR
					field_name = hir_ast_text(state.tree, expression)
				nested = hir_body_expression(nested, expression)
				field_type = nested.last_type
			if nested.error != "" or field_type == TYPE_TAG_INVALID
				return result
			let edit = hir_constructor_publish(fields, field_name, field_type)
			if edit.error != ""
				return hir_body_error(result, pub_id, edit.error)
			fields = edit.fields
		for typed_node in nested.nodes
			if typed_node.operation != HIR_BINDING
				result.nodes = result.nodes.append(typed_node)
		for request in nested.requests
			result.requests = result.requests.append(request)
		if len(fields) > 0
			let record = intern_record_type(nested.types, fields)
			result.types = record.table
			result.last_type = record.id
		return result
	if function.result_type_node >= 0
		let declared = hir_module_type_reference_with_constants(result.types, result.tree, function.result_type_node, result.functions, result.module_constants)
		result.types = declared.table
		result.last_type = declared.type_id
		if declared.type_id != TYPE_TAG_INVALID
			return result
	for active in state.active_functions
		if active == name
			return result
	var nested = HirBodyState(state.tree, state.names, state.constants)
	nested.types = result.types
	nested.functions = state.functions
	nested.module_constants = state.module_constants
	nested.active_functions = state.active_functions.append(name)
	for i in 0..len(args)
		let parameter = function.parameters[!i]
		nested = hir_body_binding(nested, parameter.source, parameter.name, args[!i], false)
	nested = hir_body_block(nested, function.body)
	if nested.error != ""
		result.error = nested.error
		result.error_line = nested.error_line
		return result
	result.types = nested.types
	result.last_type = nested.inferred_return
	return result

def hir_body_expression(state: HirBodyState, id: i64) -> HirBodyState
	state.error == "" else return state
	let node = state.tree.nodes[!id]
	let kind = node.kind
	var result = state
	result.last_type = TYPE_TAG_INVALID
	let literal = resolve_hir_literal(kind)
	if literal != TYPE_TAG_INVALID
		result.last_type = literal
		result.nodes = result.nodes.append(HirNode(id, HIR_LITERAL, literal, -1))
		return result
	if kind == NODE_NAME
		let name = hir_ast_text(state.tree, id)
		let resolved = resolve_hir_name(result.symbols, name)
		if resolved.error == ""
			result.last_type = resolved.type_id
			result.nodes = result.nodes.append(HirNode(id, HIR_NAME, resolved.type_id, resolved.field_index))
			return result
		for constant in result.module_constants
			if constant.name == name
				result.last_type = TYPE_TAG_I64
				result.nodes = result.nodes.append(HirNode(id, HIR_NAME, TYPE_TAG_I64, -1))
				return result
		for constant in result.constants
			if constant == name
				result.last_type = TYPE_TAG_I64
				result.nodes = result.nodes.append(HirNode(id, HIR_NAME, TYPE_TAG_I64, -1))
				return result
		for function in result.names
			if function == name
				# Function values and constructor calls need specialization.
				return result
		return hir_body_error(result, id, "unknown name '" + name + "'")
	if kind == NODE_CALL
		let callee = hir_ast_child(state.tree, id, 0)
		let callee_kind = state.tree.nodes[!callee].kind
		var receiver = TYPE_TAG_INVALID
		var method = ""
		var resolved_function = -1
		if callee_kind == NODE_ATTR
			method = hir_ast_text(state.tree, callee)
			result = hir_body_expression(result, hir_ast_child(state.tree, callee, 0))
			receiver = result.last_type
		elif callee_kind != NODE_NAME and callee_kind != NODE_INDEX
			result = hir_body_expression(result, callee)
		var args = Array[i64]()
		var complete = true
		for i in 1..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
			if result.error != ""
				return result
			if result.last_type == TYPE_TAG_INVALID
				complete = false
			args = args.append(result.last_type)
		result.last_type = TYPE_TAG_INVALID
		if callee_kind == NODE_INDEX and node.count == 1
			let typed = hir_module_type_reference_with_constants(result.types, result.tree, callee, result.functions, result.module_constants)
			if typed.type_id != TYPE_TAG_INVALID
				result.types = typed.table
				result.last_type = typed.type_id
		elif complete and callee_kind == NODE_NAME
			let name = hir_ast_text(state.tree, callee)
			if hir_is_builtin(name)
				let checked = resolve_hir_builtin_call(result.types, name, args)
				if checked.error != ""
					return hir_body_error(result, id, checked.error)
				result.types = checked.table
				result.last_type = checked.type_id
			else
				for j in 0..len(result.functions)
					if result.functions[!j].name == name
						resolved_function = j
				result = hir_body_user_call(result, id, name, args)
		elif complete and receiver != TYPE_TAG_INVALID
			let tag = result.types.entries[!receiver].tag
			var checked = HirCallCheck(result.types, TYPE_TAG_INVALID, "")
			if tag == TYPE_TAG_STRING and hir_is_string_method(method)
				checked = resolve_hir_string_call(result.types, receiver, method, args)
			elif (tag == TYPE_TAG_ARRAY and method == "append") or (tag == TYPE_TAG_DICT and (method == "get" or method == "insert"))
				checked = resolve_hir_collection_call(result.types, receiver, method, args)
			if checked.error != ""
				return hir_body_error(result, id, checked.error)
			result.types = checked.table
			result.last_type = checked.type_id
		if result.last_type != TYPE_TAG_INVALID
			result.nodes = result.nodes.append(HirNode(id, HIR_CALL, result.last_type, resolved_function))
		return result
	if kind == NODE_UNARY
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		if result.last_type != TYPE_TAG_INVALID
			let checked = resolve_hir_unary(result.types, result.last_type, hir_ast_text(state.tree, id))
			if checked.error != ""
				return hir_body_error(result, id, checked.error)
			result.last_type = checked.type_id
			result.nodes = result.nodes.append(HirNode(id, HIR_UNARY, checked.type_id, -1))
		return result
	if kind == NODE_BINARY
		let lhs = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		let left = lhs.last_type
		result = hir_body_expression(lhs, hir_ast_child(state.tree, id, 1))
		let right = result.last_type
		let op = hir_ast_text(state.tree, id)
		if left != TYPE_TAG_INVALID and right != TYPE_TAG_INVALID and op == "or" and result.types.entries[!left].tag == TYPE_TAG_OPTIONAL
			let value_type = result.types.entries[!left].first
			if right != value_type
				return hir_body_error(result, id, "expected " + hir_type_name(result.types, value_type) + ", found " + hir_type_name(result.types, right))
			result.last_type = value_type
			result.nodes = result.nodes.append(HirNode(id, HIR_BINARY, value_type, -1))
		elif left != TYPE_TAG_INVALID and right != TYPE_TAG_INVALID and op != ".."
			let checked = resolve_hir_binary(result.types, left, right, op)
			if checked.error != ""
				return hir_body_error(result, id, checked.error)
			result.last_type = checked.type_id
			result.nodes = result.nodes.append(HirNode(id, HIR_BINARY, checked.type_id, -1))
		else
			result.last_type = TYPE_TAG_INVALID
		return result
	if kind == NODE_ATTR
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		let owner = result.last_type
		if owner != TYPE_TAG_INVALID and result.types.entries[!owner].tag == TYPE_TAG_RECORD
			let field = resolve_hir_field(result.types, owner, hir_ast_text(state.tree, id))
			if field.error != ""
				return hir_body_error(result, id, field.error)
			result.last_type = field.type_id
			result.nodes = result.nodes.append(HirNode(id, HIR_FIELD, field.type_id, field.field_index))
		else
			result.last_type = TYPE_TAG_INVALID
		return result
	if kind == NODE_LAMBDA
		# Lambda parameter binding is specialized with the target function type.
		return result
	if kind == NODE_RECORD
		var fields = Array[RecordField]()
		var complete = true
		for i in 0..node.count
			let field_id = hir_ast_child(state.tree, id, i)
			let field = state.tree.nodes[!field_id]
			let name = hir_ast_text(state.tree, field_id)
			if field.kind == NODE_FIELD
				result = hir_body_expression(result, hir_ast_child(state.tree, field_id, 0))
				if result.error != ""
					return result
				if result.last_type == TYPE_TAG_INVALID
					complete = false
				elif complete
					let edit = hir_record_put(fields, name, result.last_type)
					if edit.error != ""
						return hir_body_error(result, field_id, edit.error)
					fields = edit.fields
			elif field.kind == NODE_SPREAD
				let symbol = resolve_hir_name(result.symbols, name)
				if symbol.type_id == TYPE_TAG_INVALID
					complete = false
				elif complete
					let edit = hir_record_spread(result.types, fields, symbol.type_id)
					if edit.error != ""
						return hir_body_error(result, field_id, edit.error)
					fields = edit.fields
			elif field.kind == NODE_DELETE and complete
				let edit = hir_record_delete(fields, name)
				if edit.error != ""
					return hir_body_error(result, field_id, edit.error)
				fields = edit.fields
		result.last_type = TYPE_TAG_INVALID
		if complete
			let typed = resolve_hir_record(result.types, fields)
			if typed.error != ""
				return hir_body_error(result, id, typed.error)
			result.types = typed.table
			result.last_type = typed.type_id
			result.nodes = result.nodes.append(HirNode(id, HIR_RECORD, typed.type_id, -1))
		return result
	if kind == NODE_ARRAY
		var element_type = TYPE_TAG_INVALID
		var complete = true
		for i in 0..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
			if result.error != ""
				return result
			let current = result.last_type
			if current == TYPE_TAG_INVALID
				complete = false
			elif element_type == TYPE_TAG_INVALID
				element_type = current
			elif element_type != current and complete
				return hir_body_error(result, id, "expected " + hir_type_name(result.types, element_type) + ", found " + hir_type_name(result.types, current))
		result.last_type = TYPE_TAG_INVALID
		if complete
			if element_type == TYPE_TAG_INVALID
				element_type = TYPE_TAG_I64
			let typed = intern_array_type(result.types, element_type)
			result.types = typed.table
			result.last_type = typed.id
			result.nodes = result.nodes.append(HirNode(id, HIR_ARRAY, typed.id, -1))
		return result
	if kind == NODE_INDEX or kind == NODE_OPTIONAL_INDEX or kind == NODE_CHECKED_INDEX
		if kind == NODE_INDEX and node.count > 0
			let base = hir_ast_child(state.tree, id, 0)
			if state.tree.nodes[!base].kind == NODE_NAME
				let type_name = hir_ast_text(state.tree, base)
				if type_name == "Array" or type_name == "Dict" or type_name == "Optional"
					return result
		let owner_state = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		let owner = owner_state.last_type
		result = owner_state
		for i in 1..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
			if result.error != ""
				return result
			if result.last_type != TYPE_TAG_INVALID and result.last_type != TYPE_TAG_I64
				return hir_body_error(result, id, "expected i64, found " + hir_type_name(result.types, result.last_type))
		let valid_index = result.last_type == TYPE_TAG_I64 and node.count == 2
		result.last_type = TYPE_TAG_INVALID
		if valid_index and owner != TYPE_TAG_INVALID and result.types.entries[!owner].tag == TYPE_TAG_ARRAY
			let element = result.types.entries[!owner].first
			if kind == NODE_OPTIONAL_INDEX
				let optional = intern_optional_type(result.types, element)
				result.types = optional.table
				result.last_type = optional.id
			else
				result.last_type = element
			result.nodes = result.nodes.append(HirNode(id, HIR_INDEX, result.last_type, -1))
		return result
	if kind == NODE_UNWRAP
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		let wrapped = result.last_type
		if wrapped != TYPE_TAG_INVALID
			let descriptor = result.types.entries[!wrapped]
			if descriptor.tag != TYPE_TAG_OPTIONAL
				return hir_body_error(result, id, "unboxing requires an Optional")
			result.last_type = descriptor.first
			result.nodes = result.nodes.append(HirNode(id, HIR_UNWRAP, descriptor.first, -1))
		return result
	if kind == NODE_ELSE_RETURN
		for i in 0..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
		return result
	# Other expressions keep their original emitter validation until typed.
	return result

def hir_body_block(state: HirBodyState, id: i64) -> HirBodyState
	var result = state
	let initial = len(result.symbols)
	result.depth += 1
	let block = result.tree.nodes[!id]
	for i in 0..block.count
		result = hir_body_statement(result, hir_ast_child(result.tree, id, i))
		result.error == "" else return result
	var symbols = Array[SymbolInfo]()
	for i in 0..initial
		symbols = symbols.append(result.symbols[!i])
	result.symbols = symbols
	result.depth -= 1
	return result

def hir_body_statement(state: HirBodyState, id: i64) -> HirBodyState
	state.error == "" else return state
	let node = state.tree.nodes[!id]
	var result = state
	if node.kind == NODE_DESTRUCTURE
		let initializer = hir_ast_child(state.tree, id, 0)
		result = hir_body_expression(result, initializer)
		result.error == "" else return result
		let record_type = result.last_type
		if record_type == TYPE_TAG_INVALID or result.types.entries[!record_type].tag != TYPE_TAG_RECORD
			return hir_body_error(result, id, "record destructuring requires a record")
		for i in 1..node.count
			let field_id = hir_ast_child(state.tree, id, i)
			let selector = hir_ast_child(state.tree, field_id, 0)
			let field = resolve_hir_field(result.types, record_type, hir_ast_text(state.tree, selector))
			if field.error != ""
				return hir_body_error(result, field_id, field.error)
			result.nodes = result.nodes.append(HirNode(field_id, HIR_FIELD, field.type_id, field.field_index))
			result = hir_body_binding(result, field_id, hir_ast_text(state.tree, field_id), field.type_id, false)
			result.error == "" else return result
		return result
	if node.kind == NODE_LET or node.kind == NODE_VAR
		var declared = TYPE_TAG_INVALID
		var initializer = -1
		var fallback = -1
		for i in 0..node.count
			let child = hir_ast_child(state.tree, id, i)
			let child_kind = state.tree.nodes[!child].kind
			if child_kind == NODE_TYPE
				let annotated = hir_module_type_reference_with_constants(result.types, result.tree, child, result.functions, result.module_constants)
				result.types = annotated.table
				declared = annotated.type_id
			elif child_kind == NODE_ELSE_RETURN
				fallback = hir_ast_child(state.tree, child, 0)
			else
				initializer = child
		if initializer >= 0
			result = hir_body_expression(result, initializer)
		result.error == "" else return result
		if fallback >= 0
			let wrapped = result.last_type
			result = hir_body_expression(result, fallback)
			result.error == "" else return result
			result.last_type = TYPE_TAG_INVALID
			if wrapped != TYPE_TAG_INVALID
				let descriptor = result.types.entries[!wrapped]
				if descriptor.tag != TYPE_TAG_OPTIONAL
					return hir_body_error(result, id, "else return requires an Optional")
				result.last_type = descriptor.first
		if declared != TYPE_TAG_INVALID and result.last_type != TYPE_TAG_INVALID and declared != result.last_type
			return hir_body_error(result, id, "expected " + hir_type_name(result.types, declared) + ", found " + hir_type_name(result.types, result.last_type))
		if declared == TYPE_TAG_INVALID
			declared = result.last_type
		return hir_body_binding(result, id, hir_ast_text(state.tree, id), declared, node.kind == NODE_VAR)
	if node.kind == NODE_ASSIGN
		let lhs = hir_ast_child(state.tree, id, 0)
		let rhs = hir_ast_child(state.tree, id, 1)
		let target = state.tree.nodes[!lhs]
		var root = lhs
		while state.tree.nodes[!root].kind == NODE_ATTR or state.tree.nodes[!root].kind == NODE_CHECKED_INDEX
			root = hir_ast_child(state.tree, root, 0)
		if state.tree.nodes[!root].kind == NODE_NAME
			let name = hir_ast_text(state.tree, root)
			let resolved = resolve_hir_name(result.symbols, name)
			if resolved.error == ""
				if not result.symbols[!resolved.field_index].mutable
					if target.kind == NODE_CHECKED_INDEX
						return hir_body_error(result, id, "indexed update requires a mutable local array")
					return hir_body_error(result, id, "cannot assign immutable binding '" + name + "'")
		var target_type = TYPE_TAG_INVALID
		if target.kind == NODE_CHECKED_INDEX
			result = hir_body_expression(result, lhs)
			result.error == "" else return result
			target_type = result.last_type
		elif target.kind == NODE_ATTR and state.tree.nodes[!hir_ast_child(state.tree, lhs, 0)].kind != NODE_NAME
			# Nested targets can contain checked indices. Analyze their expressions
			# before MIR lowering so their literals and calls have typed HIR nodes.
			result = hir_body_expression(result, lhs)
			result.error == "" else return result
			target_type = result.last_type
		result = hir_body_expression(result, rhs)
		if target_type != TYPE_TAG_INVALID and result.last_type != TYPE_TAG_INVALID and target_type != result.last_type
			if target.kind == NODE_CHECKED_INDEX
				return hir_body_error(result, id, "indexed assignment type mismatch")
			return hir_body_error(result, id, "expected " + hir_type_name(result.types, target_type) + ", found " + hir_type_name(result.types, result.last_type))
		if target.kind == NODE_NAME
			let resolved = resolve_hir_name(result.symbols, hir_ast_text(state.tree, lhs))
			if resolved.error == "" and result.last_type != TYPE_TAG_INVALID and resolved.type_id != TYPE_TAG_INVALID and resolved.type_id != result.last_type
				return hir_body_error(result, id, "expected " + hir_type_name(result.types, resolved.type_id) + ", found " + hir_type_name(result.types, result.last_type))
		result.nodes = result.nodes.append(HirNode(id, HIR_ASSIGN, result.last_type, -1))
		return result
	if node.kind == NODE_IF
		for i in 0..node.count
			let arm = hir_ast_child(state.tree, id, i)
			let branch = state.tree.nodes[!arm]
			if branch.kind == NODE_ELSE
				result = hir_body_block(result, hir_ast_child(state.tree, arm, 0))
			else
				result = hir_body_expression(result, hir_ast_child(state.tree, arm, 0))
				result = hir_body_block(result, hir_ast_child(state.tree, arm, 1))
		return result
	if node.kind == NODE_WHILE
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		return hir_body_block(result, hir_ast_child(state.tree, id, 1))
	if node.kind == NODE_FOR
		let iterable = hir_ast_child(state.tree, id, node.count - 2)
		result = hir_body_expression(result, iterable)
		let initial = len(result.symbols)
		result.depth += 1
		var item_type = TYPE_TAG_INVALID
		if result.tree.nodes[!iterable].kind == NODE_BINARY and hir_ast_text(result.tree, iterable) == ".."
			item_type = TYPE_TAG_I64
		elif result.last_type != TYPE_TAG_INVALID and result.types.entries[!result.last_type].tag == TYPE_TAG_ARRAY
			item_type = result.types.entries[!result.last_type].first
		result = hir_body_binding(result, id, hir_ast_text(state.tree, id), item_type, false)
		result = hir_body_block(result, hir_ast_child(state.tree, id, node.count - 1))
		var symbols = Array[SymbolInfo]()
		for i in 0..initial
			symbols = symbols.append(result.symbols[!i])
		result.symbols = symbols
		result.depth -= 1
		return result
	if node.kind == NODE_GUARD
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		if result.last_type != TYPE_TAG_INVALID and result.last_type != TYPE_TAG_BOOL
			return hir_body_error(result, id, "expected bool, found " + hir_type_name(result.types, result.last_type))
		let exit_node = hir_ast_child(state.tree, id, 1)
		return hir_body_statement(result, exit_node)
	if node.kind == NODE_RETURN or node.kind == NODE_EXPR or node.kind == NODE_RECUR
		for i in 0..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
		if node.kind == NODE_RETURN and result.last_type != TYPE_TAG_INVALID
			if result.inferred_return != TYPE_TAG_INVALID and result.inferred_return != result.last_type
				return hir_body_error(result, id, "inconsistent return types")
			result.inferred_return = result.last_type
		return result
	return result

def hir_analyze_function_body(tree: ParseState, header: HirFunctionDecl, names: Array[string], constants: Array[string]) -> HirBodyAnalysis
	var state = HirBodyState(tree, names, constants)
	for parameter in header.parameters
		var type_id = TYPE_TAG_INVALID
		if parameter.type_node >= 0
			let annotated = hir_module_type_reference(state.types, tree, parameter.type_node, state.functions)
			state.types = annotated.table
			type_id = annotated.type_id
		state = hir_body_binding(state, parameter.source, parameter.name, type_id, false)
	if state.error == ""
		state = hir_body_block(state, header.body)
	return HirBodyAnalysis(state.nodes, state.error, state.error_line)

# The module-level entry point shares the declaration table with the body
# analyzer, enabling concrete user calls before C generation begins.
def hir_analyze_module_body(tree: ParseState, header: HirFunctionDecl, functions: Array[HirFunctionDecl], constants: Array[string]) -> HirBodyAnalysis
	var names = Array[string]()
	for function in functions
		names = names.append(function.name)
	var state = HirBodyState(tree, names, constants)
	state.functions = functions
	state.active_functions = [header.name]
	for parameter in header.parameters
		var type_id = TYPE_TAG_INVALID
		if parameter.type_node >= 0
			let annotated = hir_module_type_reference(state.types, tree, parameter.type_node, state.functions)
			state.types = annotated.table
			type_id = annotated.type_id
		state = hir_body_binding(state, parameter.source, parameter.name, type_id, false)
	if state.error == ""
		state = hir_body_block(state, header.body)
	return HirBodyAnalysis(state.nodes, state.error, state.error_line)
