# First typed HIR operations. Source indexes refer to the syntax AST arena;
# type_id is always an interned semantic TypeId, never a legacy C kind.
# Semantic resolution is independent of C syntax and runtime helper names.

let HIR_FIELD = 1
let HIR_BINARY = 2
let HIR_NAME = 3
let HIR_LITERAL = 4
let HIR_UNARY = 5

rec HirNode(source: i64, operation: i64, type_id: i64, field_index: i64)

rec HirResolution(type_id: i64, field_index: i64, error: string)

# Bindings belong to semantic resolution; the C backend merely retains their
# temporary legacy ABI kind until the rest of emission moves to HIR.
rec SymbolInfo(name: string, kind: i64, type_id: i64, mutable: bool, depth: i64)

def resolve_hir_name(symbols: Array[SymbolInfo], name: string) -> HirResolution
	for i in 0..len(symbols)
		let index = len(symbols) - 1 - i
		let symbol = symbols[!index]
		if symbol.name == name
			return HirResolution(symbol.type_id, index, "")
	return HirResolution(TYPE_TAG_INVALID, -1, "unknown name '" + name + "'")

def hir_types_equal(left: i64, right: i64) -> bool
	return left == right and left != TYPE_TAG_INVALID

def resolve_hir_field(types: TypeTable, owner: i64, name: string) -> HirResolution
	if owner < 0 or owner >= len(types.entries)
		return HirResolution(TYPE_TAG_INVALID, -1, "unknown record field '" + name + "'")
	let descriptor = types.entries[!owner]
	if descriptor.tag == TYPE_TAG_RECORD
		for i in 0..len(descriptor.fields)
			let field = descriptor.fields[!i]
			if field.name == name
				return HirResolution(field.kind, i, "")
	return HirResolution(TYPE_TAG_INVALID, -1, "unknown record field '" + name + "'")

# Binary operations are checked on semantic type identities. The returned
# type is already canonical, so the C emitter does not reimplement these rules.
def resolve_hir_binary(types: TypeTable, left: i64, right: i64, op: string) -> HirResolution
	if left != right
		return HirResolution(TYPE_TAG_INVALID, -1, "binary operand types differ")
	if left < 0 or left >= len(types.entries)
		return HirResolution(TYPE_TAG_INVALID, -1, "unknown binary operand type")
	let tag = types.entries[!left].tag
	if op == "and" or op == "or"
		if tag != TYPE_TAG_BOOL
			return HirResolution(TYPE_TAG_INVALID, -1, "logical operator requires bool")
		return HirResolution(TYPE_TAG_BOOL, -1, "")
	if op == "==" or op == "!="
		return HirResolution(TYPE_TAG_BOOL, -1, "")
	if op == "<" or op == "<=" or op == ">" or op == ">="
		if tag != TYPE_TAG_I64 and tag != TYPE_TAG_F64 and tag != TYPE_TAG_STRING
			return HirResolution(TYPE_TAG_INVALID, -1, "comparison requires numeric or string operands")
		return HirResolution(TYPE_TAG_BOOL, -1, "")
	if op == "+" or op == "-" or op == "*" or op == "/" or op == "%"
		if tag != TYPE_TAG_I64 and tag != TYPE_TAG_F64 and not (op == "+" and tag == TYPE_TAG_STRING)
			return HirResolution(TYPE_TAG_INVALID, -1, "arithmetic requires numeric operands")
		if op == "%" and tag != TYPE_TAG_I64
			return HirResolution(TYPE_TAG_INVALID, -1, "remainder requires i64")
		return HirResolution(left, -1, "")
	return HirResolution(TYPE_TAG_INVALID, -1, "unsupported binary operator '" + op + "'")

# Literal classification and unary operand validation are compiler semantics,
# independent of how the eventual backend materializes the value.
def resolve_hir_literal(node_kind: i64) -> i64
	if node_kind == NODE_INTEGER
		return TYPE_TAG_I64
	if node_kind == NODE_FLOAT
		return TYPE_TAG_F64
	if node_kind == NODE_BOOL
		return TYPE_TAG_BOOL
	if node_kind == NODE_STRING
		return TYPE_TAG_STRING
	return TYPE_TAG_INVALID

def resolve_hir_unary(types: TypeTable, operand: i64, op: string) -> HirResolution
	if operand < 0 or operand >= len(types.entries)
		return HirResolution(TYPE_TAG_INVALID, -1, "invalid unary operand")
	let tag = types.entries[!operand].tag
	if op == "not" and tag == TYPE_TAG_BOOL
		return HirResolution(TYPE_TAG_BOOL, -1, "")
	if (op == "-" or op == "+") and (tag == TYPE_TAG_I64 or tag == TYPE_TAG_F64)
		return HirResolution(operand, -1, "")
	return HirResolution(TYPE_TAG_INVALID, -1, "unsupported unary operator '" + op + "'")

# Call signature validation is semantic: no C names or ownership helpers.
# A checked call returns an interned result type, and (possibly) an extended
# type table for results such as Optional[string].
let HIR_CALL = 6

rec HirCallCheck(table: TypeTable, type_id: i64, error: string)

def hir_type_name(types: TypeTable, id: i64) -> string
	if id < 0 or id >= len(types.entries)
		return "unknown"
	let descriptor = types.entries[!id]
	if descriptor.tag == TYPE_TAG_I64
		return "i64"
	if descriptor.tag == TYPE_TAG_F64
		return "f64"
	if descriptor.tag == TYPE_TAG_BOOL
		return "bool"
	if descriptor.tag == TYPE_TAG_STRING
		return "string"
	if descriptor.tag == TYPE_TAG_VOID
		return "void"
	if descriptor.tag == TYPE_TAG_ARRAY
		return "Array[" + hir_type_name(types, descriptor.first) + "]"
	if descriptor.tag == TYPE_TAG_DICT
		return "Dict[" + hir_type_name(types, descriptor.first) + "," + hir_type_name(types, descriptor.second) + "]"
	if descriptor.tag == TYPE_TAG_OPTIONAL
		return "Optional[" + hir_type_name(types, descriptor.first) + "]"
	return "record"

def hir_expected(types: TypeTable, expected: i64, found: i64) -> HirCallCheck
	if hir_types_equal(expected, found)
		return HirCallCheck(types, expected, "")
	return HirCallCheck(types, TYPE_TAG_INVALID, "expected " + hir_type_name(types, expected) + ", found " + hir_type_name(types, found))

def hir_call_arguments(types: TypeTable, actual: Array[i64], expected: Array[i64], result: i64, arity_error: string) -> HirCallCheck
	if len(actual) != len(expected)
		return HirCallCheck(types, TYPE_TAG_INVALID, arity_error)
	for i in 0..len(actual)
		let check = hir_expected(types, expected[!i], actual[!i])
		if check.error != ""
			return check
	return HirCallCheck(types, result, "")

def hir_is_builtin(name: string) -> bool
	return name == "arguments" or name == "read_text" or name == "write_text" or name == "print" or name == "len" or name == "str" or name == "sqrt"

def resolve_hir_builtin_call(types: TypeTable, name: string, args: Array[i64]) -> HirCallCheck
	if name == "arguments"
		let array = intern_array_type(types, TYPE_TAG_STRING)
		return hir_call_arguments(array.table, args, Array[i64](), array.id, "arguments expects no arguments")
	if name == "read_text"
		let optional = intern_optional_type(types, TYPE_TAG_STRING)
		return hir_call_arguments(optional.table, args, [TYPE_TAG_STRING], optional.id, "read_text expects one string argument")
	if name == "write_text"
		return hir_call_arguments(types, args, [TYPE_TAG_STRING, TYPE_TAG_STRING], TYPE_TAG_BOOL, "write_text expects two string arguments")
	if name == "str"
		if len(args) != 1 or args[!0] != TYPE_TAG_I64
			return HirCallCheck(types, TYPE_TAG_INVALID, "str expects one i64 argument")
		return HirCallCheck(types, TYPE_TAG_STRING, "")
	if name == "sqrt"
		return hir_call_arguments(types, args, [TYPE_TAG_F64], TYPE_TAG_F64, "sqrt expects one argument")
	if name == "print"
		if len(args) != 1
			return HirCallCheck(types, TYPE_TAG_INVALID, "print expects one argument")
		let id = args[!0]
		if id == TYPE_TAG_I64 or id == TYPE_TAG_F64 or id == TYPE_TAG_BOOL or id == TYPE_TAG_STRING
			return HirCallCheck(types, TYPE_TAG_VOID, "")
		return HirCallCheck(types, TYPE_TAG_INVALID, "cannot print this type")
	if name == "len"
		if len(args) != 1
			return HirCallCheck(types, TYPE_TAG_INVALID, "len expects one argument")
		let id = args[!0]
		if id >= 0 and id < len(types.entries)
			let tag = types.entries[!id].tag
			if tag == TYPE_TAG_STRING or tag == TYPE_TAG_ARRAY or tag == TYPE_TAG_DICT
				return HirCallCheck(types, TYPE_TAG_I64, "")
		return HirCallCheck(types, TYPE_TAG_INVALID, "len expects a string or array")
	return HirCallCheck(types, TYPE_TAG_INVALID, "unknown builtin")

def hir_is_string_method(name: string) -> bool
	return name == "byte_at" or name == "slice" or name == "find" or name == "starts_with" or name == "ends_with" or name == "join"

def resolve_hir_string_call(types: TypeTable, receiver: i64, method: string, args: Array[i64]) -> HirCallCheck
	var current = types
	let check = hir_expected(types, TYPE_TAG_STRING, receiver)
	if check.error != ""
		return check
	var expected = Array[i64]()
	var result = TYPE_TAG_BOOL
	if method == "byte_at"
		expected = [TYPE_TAG_I64]
	elif method == "slice"
		expected = [TYPE_TAG_I64, TYPE_TAG_I64]
		result = TYPE_TAG_STRING
	elif method == "find"
		expected = [TYPE_TAG_STRING]
	elif method == "starts_with" or method == "ends_with"
		expected = [TYPE_TAG_STRING]
	elif method == "join"
		let array = intern_array_type(types, TYPE_TAG_STRING)
		current = array.table
		expected = [array.id]
		result = TYPE_TAG_STRING
	if method == "byte_at" or method == "find"
		let optional = intern_optional_type(types, TYPE_TAG_I64)
		current = optional.table
		result = optional.id
	return hir_call_arguments(current, args, expected, result, "string method argument count mismatch")

def resolve_hir_function_call(types: TypeTable, name: string, args: Array[i64], params: Array[i64], result: i64) -> HirCallCheck
	if len(args) != len(params)
		return HirCallCheck(types, TYPE_TAG_INVALID, "argument count mismatch for '" + name + "'")
	for i in 0..len(args)
		if params[!i] != TYPE_TAG_INVALID
			let check = hir_expected(types, params[!i], args[!i])
			if check.error != ""
				return check
	return HirCallCheck(types, result, "")

# Collection method typing only examines the canonical container descriptor.
def resolve_hir_collection_call(types: TypeTable, receiver: i64, method: string, args: Array[i64]) -> HirCallCheck
	if receiver < 0 or receiver >= len(types.entries)
		return HirCallCheck(types, TYPE_TAG_INVALID, "unknown collection receiver type")
	let descriptor = types.entries[!receiver]
	if method == "append"
		if descriptor.tag != TYPE_TAG_ARRAY
			return HirCallCheck(types, TYPE_TAG_INVALID, "append requires an array")
		return hir_call_arguments(types, args, [descriptor.first], receiver, "append expects one argument")
	if descriptor.tag != TYPE_TAG_DICT
		return HirCallCheck(types, TYPE_TAG_INVALID, "dictionary method requires Dict")
	if method == "insert"
		return hir_call_arguments(types, args, [descriptor.first, descriptor.second], receiver, "dictionary method argument count mismatch")
	if method == "get"
		let optional = intern_optional_type(types, descriptor.second)
		return hir_call_arguments(optional.table, args, [descriptor.first], optional.id, "dictionary method argument count mismatch")
	return HirCallCheck(types, TYPE_TAG_INVALID, "unknown collection method")


# Record construction is a semantic operation. The editor carries canonical
# TypeIds, independent of source-level field ordering and C field expressions.
let HIR_RECORD = 7
let HIR_CONSTRUCTOR = 8

rec HirRecordEdit(fields: Array[RecordField], index: i64, error: string)

def hir_record_field(fields: Array[RecordField], name: string) -> i64
	for i in 0..len(fields)
		if fields[!i].name == name
			return i
	return -1

def hir_record_put(fields: Array[RecordField], name: string, type_id: i64) -> HirRecordEdit
	if type_id == TYPE_TAG_INVALID or type_id == TYPE_TAG_VOID
		return HirRecordEdit(fields, -1, "invalid record field type")
	let index = hir_record_field(fields, name)
	var result = fields
	if index >= 0
		result[!index] = RecordField(name, type_id)
	else
		result = result.append(RecordField(name, type_id))
	return HirRecordEdit(result, index, "")

def hir_record_delete(fields: Array[RecordField], name: string) -> HirRecordEdit
	let index = hir_record_field(fields, name)
	if index < 0
		return HirRecordEdit(fields, -1, "unknown deleted field '" + name + "'")
	var result = Array[RecordField]()
	for i in 0..len(fields)
		if i != index
			result = result.append(fields[!i])
	return HirRecordEdit(result, index, "")

def hir_record_spread(types: TypeTable, fields: Array[RecordField], owner: i64) -> HirRecordEdit
	if owner < 0 or owner >= len(types.entries)
		return HirRecordEdit(fields, -1, "record spread expects a record")
	let descriptor = types.entries[!owner]
	if descriptor.tag != TYPE_TAG_RECORD
		return HirRecordEdit(fields, -1, "record spread expects a record")
	var result = fields
	for field in descriptor.fields
		result = hir_record_put(result, field.name, field.kind).fields
	return HirRecordEdit(result, -1, "")

def resolve_hir_record(types: TypeTable, fields: Array[RecordField]) -> HirCallCheck
	if len(fields) == 0
		return HirCallCheck(types, TYPE_TAG_INVALID, "empty records are not supported yet")
	let interned = intern_record_type(types, fields)
	return HirCallCheck(interned.table, interned.id, "")

def hir_constructor_publish(fields: Array[RecordField], name: string, type_id: i64) -> HirRecordEdit
	if hir_record_field(fields, name) >= 0
		return HirRecordEdit(fields, -1, "constructor field overrides are not supported yet")
	return hir_record_put(fields, name, type_id)


# Pre-emission module declaration pass. Index every function and module constant
# in source order, and validate declaration syntax before generating any C.
# Type annotations remain AST references until constructors have been resolved;
# concrete generic signatures are determined later during specialization.
rec HirParameterDecl(name: string, source: i64, type_node: i64)

rec HirFunctionDecl(name: string, source: i64, body: i64, constructor: bool, result_type_node: i64, parameters: Array[HirParameterDecl])

rec HirModuleDecl(functions: Array[HirFunctionDecl], error: string, error_line: i64)

def hir_ast_child(tree: ParseState, id: i64, offset: i64) -> i64
	let node = tree.nodes[!id]
	return tree.edges[!node.first + offset]

def hir_ast_text(tree: ParseState, id: i64) -> string
	return token_text(tree.source, tree.tokens[!tree.nodes[!id].token])

def hir_ast_line(tree: ParseState, id: i64) -> i64
	return tree.tokens[!tree.nodes[!id].token].line

def hir_declaration_error(functions: Array[HirFunctionDecl], message: string, line: i64) -> HirModuleDecl
	return HirModuleDecl(functions, message, line)

def hir_module_declarations(tree: ParseState, root: i64) -> HirModuleDecl
	var functions = Array[HirFunctionDecl]()
	var names = Array[string]()
	let module = tree.nodes[!root]
	for i in 0..module.count
		let id = hir_ast_child(tree, root, i)
		let entry = tree.nodes[!id]
		let name = hir_ast_text(tree, id)
		if entry.kind != NODE_DEF and entry.kind != NODE_REC and entry.kind != NODE_LET
			return hir_declaration_error(functions, "unsupported module statement", hir_ast_line(tree, id))
		if name == "print" and (entry.kind == NODE_DEF or entry.kind == NODE_REC)
			return hir_declaration_error(functions, "duplicate function '" + name + "'", hir_ast_line(tree, id))
		for seen in names
			if seen == name
				if entry.kind == NODE_LET
					return hir_declaration_error(functions, "duplicate module name", hir_ast_line(tree, id))
				return hir_declaration_error(functions, "duplicate function '" + name + "'", hir_ast_line(tree, id))
		names = names.append(name)
		if entry.kind == NODE_LET
			continue
		var parameters = Array[HirParameterDecl]()
		var return_type = -1
		for j in 0..entry.count - 1
			let part = hir_ast_child(tree, id, j)
			let info = tree.nodes[!part]
			if info.kind == NODE_PARAM
				var annotation = -1
				if info.count > 0
					annotation = hir_ast_child(tree, part, 0)
					if info.count != 1 or tree.nodes[!annotation].kind != NODE_TYPE
						return hir_declaration_error(functions, "parameter defaults are not supported yet", hir_ast_line(tree, part))
				let pname = hir_ast_text(tree, part)
				for previous in parameters
					if previous.name == pname
						return hir_declaration_error(functions, "duplicate parameter '" + pname + "'", hir_ast_line(tree, part))
				parameters = parameters.append(HirParameterDecl(pname, part, annotation))
			elif info.kind == NODE_TYPE
				return_type = part
		let body_id = hir_ast_child(tree, id, entry.count - 1)
		if entry.kind == NODE_DEF
			let body = tree.nodes[!body_id]
			for j in 0..body.count
				if tree.nodes[!hir_ast_child(tree, body_id, j)].kind == NODE_PUB
					return hir_declaration_error(functions, "def constructors are no longer supported; use rec", hir_ast_line(tree, id))
		functions = functions.append(HirFunctionDecl(name, id, body_id, entry.kind == NODE_REC, return_type, parameters))
	return HirModuleDecl(functions, "", 0)

# Independent, pre-emission body analysis. Unresolved types are explicitly
# deferred rather than guessed: specialization and collection typing still
# belong to the legacy emitter during this migration.
let HIR_BINDING = 9
let HIR_ASSIGN = 10

rec HirBodyState(tree: ParseState, names: Array[string], constants: Array[string])
	pub symbols = Array[SymbolInfo]()
	pub nodes = Array[HirNode]()
	pub types = new_type_table()
	pub depth = 0
	pub last_type = TYPE_TAG_INVALID
	pub error = ""
	pub error_line = 0

rec HirBodyAnalysis(nodes: Array[HirNode], error: string, error_line: i64)

def hir_body_error(state: HirBodyState, id: i64, message: string) -> HirBodyState
	var result = state
	if result.error == ""
		result.error = message
		result.error_line = hir_ast_line(state.tree, id)
	return result

def hir_annotation_type(tree: ParseState, id: i64) -> i64
	if id < 0
		return TYPE_TAG_INVALID
	let annotation = tree.nodes[!id]
	if annotation.kind != NODE_TYPE or annotation.count != 0
		return TYPE_TAG_INVALID
	let name = hir_ast_text(tree, id)
	if name == "i64"
		return TYPE_TAG_I64
	if name == "f64"
		return TYPE_TAG_F64
	if name == "bool"
		return TYPE_TAG_BOOL
	if name == "string"
		return TYPE_TAG_STRING
	return TYPE_TAG_INVALID

def hir_body_binding(state: HirBodyState, id: i64, name: string, type_id: i64, mutable: bool) -> HirBodyState
	var result = state
	for symbol in result.symbols
		if symbol.name == name and symbol.depth == result.depth
			return hir_body_error(result, id, "duplicate binding '" + name + "'")
	result.symbols = result.symbols.append(SymbolInfo(name, type_id, type_id, mutable, result.depth))
	result.nodes = result.nodes.append(HirNode(id, HIR_BINDING, type_id, len(result.symbols) - 1))
	return result

def hir_body_expression(state: HirBodyState, id: i64) -> HirBodyState
	if state.error != ""
		return state
	let node = state.tree.nodes[!id]
	let kind = node.kind
	var result = state
	result.last_type = TYPE_TAG_INVALID
	let literal = resolve_hir_literal(kind)
	if literal != TYPE_TAG_INVALID
		result.last_type = literal
		result.nodes = result.nodes.append(HirNode(id, HIR_LITERAL, literal, -1))
		return result
	if kind == NODE_NAME
		let name = hir_ast_text(state.tree, id)
		let resolved = resolve_hir_name(result.symbols, name)
		if resolved.error == ""
			result.last_type = resolved.type_id
			result.nodes = result.nodes.append(HirNode(id, HIR_NAME, resolved.type_id, resolved.field_index))
			return result
		for constant in result.constants
			if constant == name
				result.last_type = TYPE_TAG_I64
				result.nodes = result.nodes.append(HirNode(id, HIR_NAME, TYPE_TAG_I64, -1))
				return result
		for function in result.names
			if function == name
				# Function values and constructor calls need specialization.
				return result
		return hir_body_error(result, id, "unknown name '" + name + "'")
	if kind == NODE_CALL
		# The callee is not a local-value use when it names a function or type.
		let callee = hir_ast_child(state.tree, id, 0)
		let callee_kind = state.tree.nodes[!callee].kind
		if callee_kind == NODE_ATTR
			result = hir_body_expression(result, hir_ast_child(state.tree, callee, 0))
		elif callee_kind != NODE_NAME and callee_kind != NODE_INDEX
			result = hir_body_expression(result, callee)
		for i in 1..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
		result.last_type = TYPE_TAG_INVALID
		return result
	if kind == NODE_UNARY
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		if result.last_type != TYPE_TAG_INVALID
			let checked = resolve_hir_unary(result.types, result.last_type, hir_ast_text(state.tree, id))
			if checked.error != ""
				return hir_body_error(result, id, checked.error)
			result.last_type = checked.type_id
			result.nodes = result.nodes.append(HirNode(id, HIR_UNARY, checked.type_id, -1))
		return result
	if kind == NODE_BINARY
		let lhs = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		let left = lhs.last_type
		result = hir_body_expression(lhs, hir_ast_child(state.tree, id, 1))
		let right = result.last_type
		let op = hir_ast_text(state.tree, id)
		if left != TYPE_TAG_INVALID and right != TYPE_TAG_INVALID and op != ".."
			let checked = resolve_hir_binary(result.types, left, right, op)
			if checked.error != ""
				return hir_body_error(result, id, checked.error)
			result.last_type = checked.type_id
			result.nodes = result.nodes.append(HirNode(id, HIR_BINARY, checked.type_id, -1))
		else
			result.last_type = TYPE_TAG_INVALID
		return result
	if kind == NODE_ATTR
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		# Record field types need full canonical construction/specialization.
		result.last_type = TYPE_TAG_INVALID
		return result
	if kind == NODE_LAMBDA
		# Lambda parameter binding is specialized with the target function type.
		return result
	if kind == NODE_RECORD
		for i in 0..node.count
			let field = hir_ast_child(state.tree, id, i)
			if state.tree.nodes[!field].kind == NODE_FIELD
				result = hir_body_expression(result, hir_ast_child(state.tree, field, 0))
		result.last_type = TYPE_TAG_INVALID
		return result
	if kind == NODE_INDEX or kind == NODE_OPTIONAL_INDEX or kind == NODE_CHECKED_INDEX or kind == NODE_ARRAY or kind == NODE_UNWRAP
		if kind == NODE_INDEX and node.count > 0
			let base = hir_ast_child(state.tree, id, 0)
			if state.tree.nodes[!base].kind == NODE_NAME
				let type_name = hir_ast_text(state.tree, base)
				if type_name == "Array" or type_name == "Dict" or type_name == "Optional"
					return result
		for i in 0..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
		result.last_type = TYPE_TAG_INVALID
		return result
	if kind == NODE_ELSE_RETURN
		for i in 0..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
		return result
	# Other expressions keep their original emitter validation until typed.
	return result

def hir_body_block(state: HirBodyState, id: i64) -> HirBodyState
	var result = state
	let initial = len(result.symbols)
	result.depth += 1
	let block = result.tree.nodes[!id]
	for i in 0..block.count
		result = hir_body_statement(result, hir_ast_child(result.tree, id, i))
		if result.error != ""
			return result
	var symbols = Array[SymbolInfo]()
	for i in 0..initial
		symbols = symbols.append(result.symbols[!i])
	result.symbols = symbols
	result.depth -= 1
	return result

def hir_body_statement(state: HirBodyState, id: i64) -> HirBodyState
	if state.error != ""
		return state
	let node = state.tree.nodes[!id]
	var result = state
	if node.kind == NODE_LET or node.kind == NODE_VAR
		var declared = TYPE_TAG_INVALID
		var initializer = -1
		for i in 0..node.count
			let child = hir_ast_child(state.tree, id, i)
			if state.tree.nodes[!child].kind == NODE_TYPE
				declared = hir_annotation_type(state.tree, child)
			else
				initializer = child
		if initializer >= 0
			result = hir_body_expression(result, initializer)
		if result.error != ""
			return result
		if declared != TYPE_TAG_INVALID and result.last_type != TYPE_TAG_INVALID and declared != result.last_type
			return hir_body_error(result, id, "expected " + hir_type_name(result.types, declared) + ", found " + hir_type_name(result.types, result.last_type))
		if declared == TYPE_TAG_INVALID
			declared = result.last_type
		return hir_body_binding(result, id, hir_ast_text(state.tree, id), declared, node.kind == NODE_VAR)
	if node.kind == NODE_ASSIGN
		let lhs = hir_ast_child(state.tree, id, 0)
		let rhs = hir_ast_child(state.tree, id, 1)
		let target = state.tree.nodes[!lhs]
		var root = lhs
		while state.tree.nodes[!root].kind == NODE_ATTR or state.tree.nodes[!root].kind == NODE_CHECKED_INDEX
			root = hir_ast_child(state.tree, root, 0)
		if state.tree.nodes[!root].kind == NODE_NAME
			let name = hir_ast_text(state.tree, root)
			let resolved = resolve_hir_name(result.symbols, name)
			if resolved.error == ""
				if not result.symbols[!resolved.field_index].mutable
					if target.kind == NODE_CHECKED_INDEX
						return hir_body_error(result, id, "indexed update requires a mutable local array")
					return hir_body_error(result, id, "cannot assign immutable binding '" + name + "'")
		result = hir_body_expression(result, rhs)
		if target.kind == NODE_NAME
			let resolved = resolve_hir_name(result.symbols, hir_ast_text(state.tree, lhs))
			if resolved.error == "" and result.last_type != TYPE_TAG_INVALID and resolved.type_id != TYPE_TAG_INVALID and resolved.type_id != result.last_type
				return hir_body_error(result, id, "expected " + hir_type_name(result.types, resolved.type_id) + ", found " + hir_type_name(result.types, result.last_type))
		result.nodes = result.nodes.append(HirNode(id, HIR_ASSIGN, result.last_type, -1))
		return result
	if node.kind == NODE_IF
		for i in 0..node.count
			let arm = hir_ast_child(state.tree, id, i)
			let branch = state.tree.nodes[!arm]
			if branch.kind == NODE_ELSE
				result = hir_body_block(result, hir_ast_child(state.tree, arm, 0))
			else
				result = hir_body_expression(result, hir_ast_child(state.tree, arm, 0))
				result = hir_body_block(result, hir_ast_child(state.tree, arm, 1))
		return result
	if node.kind == NODE_WHILE
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		return hir_body_block(result, hir_ast_child(state.tree, id, 1))
	if node.kind == NODE_FOR
		let iterable = hir_ast_child(state.tree, id, node.count - 2)
		result = hir_body_expression(result, iterable)
		let initial = len(result.symbols)
		result.depth += 1
		var item_type = TYPE_TAG_INVALID
		if result.tree.nodes[!iterable].kind == NODE_BINARY and hir_ast_text(result.tree, iterable) == ".."
			item_type = TYPE_TAG_I64
		result = hir_body_binding(result, id, hir_ast_text(state.tree, id), item_type, false)
		result = hir_body_block(result, hir_ast_child(state.tree, id, node.count - 1))
		var symbols = Array[SymbolInfo]()
		for i in 0..initial
			symbols = symbols.append(result.symbols[!i])
		result.symbols = symbols
		result.depth -= 1
		return result
	if node.kind == NODE_GUARD
		result = hir_body_expression(result, hir_ast_child(state.tree, id, 0))
		if result.last_type != TYPE_TAG_INVALID and result.last_type != TYPE_TAG_BOOL
			return hir_body_error(result, id, "expected bool, found " + hir_type_name(result.types, result.last_type))
		let exit_node = hir_ast_child(state.tree, id, 1)
		return hir_body_statement(result, exit_node)
	if node.kind == NODE_RETURN or node.kind == NODE_EXPR or node.kind == NODE_RECUR
		for i in 0..node.count
			result = hir_body_expression(result, hir_ast_child(state.tree, id, i))
		return result
	return result

def hir_analyze_function_body(tree: ParseState, header: HirFunctionDecl, names: Array[string], constants: Array[string]) -> HirBodyAnalysis
	var state = HirBodyState(tree, names, constants)
	for parameter in header.parameters
		state = hir_body_binding(state, parameter.source, parameter.name, hir_annotation_type(tree, parameter.type_node), false)
	if state.error == ""
		state = hir_body_block(state, header.body)
	return HirBodyAnalysis(state.nodes, state.error, state.error_line)
