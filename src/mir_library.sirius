# Concrete named-export MIR library. Symbols carry structural signatures whose
# spelling does not depend on local TypeIds or the order of type interning.
# Version 3 retains generic source; version 4 stores a parsed syntax snapshot.
let MIR_LIBRARY_MAGIC = "SIRIUS-MIR-LIB/1\n"
let MIR_LIBRARY_IMPORT_MAGIC = "SIRIUS-MIR-LIB/2\n"
let MIR_LIBRARY_GENERIC_MAGIC = "SIRIUS-MIR-LIB/3\n"
let MIR_LIBRARY_SYNTAX_MAGIC = "SIRIUS-MIR-LIB/4\n"
let MIR_LIBRARY_SEMANTIC_MAGIC = "SIRIUS-MIR-LIB/5\n"
let MIR_LIBRARY_PARAMETRIC_MAGIC = "SIRIUS-MIR-LIB/6\n"

# An import occupies a normal, statically typed function slot. Its source
# declaration has no body and is never executed before linking.
rec MirNamedImport(name: string, function_id: i64)
rec MirLibraryLoad(program: MirProgram, exports: Array[MirNamedExport], error: string)
	pub imports = Array[MirNamedImport]()
	pub templates = Array[string]()
	pub source = ""
	pub snapshot = ""

def mir_type_signature(types: TypeTable, id: i64) -> string
	if id == TYPE_TAG_I64
		return "i64"
	if id == TYPE_TAG_F64
		return "f64"
	if id == TYPE_TAG_BOOL
		return "bool"
	if id == TYPE_TAG_STRING
		return "string"
	if id == TYPE_TAG_VOID
		return "void"
	if id < 6 or id >= len(types.entries)
		return "invalid"
	let desc = types.entries[!id]
	if desc.tag == TYPE_TAG_ARRAY
		return "Array[" + mir_type_signature(types, desc.first) + "]"
	if desc.tag == TYPE_TAG_OPTIONAL
		return "Optional[" + mir_type_signature(types, desc.first) + "]"
	if desc.tag == TYPE_TAG_DICT
		return "Dict[" + mir_type_signature(types, desc.first) + "," + mir_type_signature(types, desc.second) + "]"
	var parts = ["Record{"]
	for field in desc.fields
		parts = parts.append(str(len(field.name)) + ":" + field.name + "=" + mir_type_signature(types, field.kind) + ";")
	return "".join(parts) + "}"

def mir_function_signature(program: MirProgram, id: i64) -> string
	let function = program.functions[!id]
	var parts = ["("]
	for i in 0..function.argument_count
		if i > 0
			parts = parts.append(",")
		parts = parts.append(mir_type_signature(program.types, function.register_types[!i]))
	return "".join(parts) + ")->" + mir_type_signature(program.types, function.return_type)

def mir_library_name_valid(name: string) -> bool
	if len(name) == 0 or len(name) > 256
		return false
	for i in 0..len(name)
		let byte = name.byte_at(i) or 0
		if not ((byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95 or (i > 0 and byte >= 48 and byte <= 57))
			return false
	return true

def mir_library_exports_error(program: MirProgram, exports: Array[MirNamedExport]) -> string
	if len(exports) > 4096
		return "invalid MIR export count"
	var names = Dict[string,bool]()
	for symbol in exports
		if not mir_library_name_valid(symbol.name)
			return "invalid MIR export name"
		if names.get(symbol.name) or false
			return "duplicate MIR export"
		names = names.insert(symbol.name, true)
		if symbol.function_id < 0 or symbol.function_id >= len(program.functions)
			return "invalid MIR exported function"
	return ""

def mir_library_imports_error(program: MirProgram, exports: Array[MirNamedExport], imports: Array[MirNamedImport]) -> string
	if len(imports) > 4096
		return "invalid MIR import count"
	var names = Dict[string,bool]()
	for symbol in imports
		if not mir_library_name_valid(symbol.name)
			return "invalid MIR import name"
		if names.get(symbol.name) or false
			return "duplicate MIR import: " + symbol.name
		names = names.insert(symbol.name, true)
		if symbol.function_id < 0 or symbol.function_id >= len(program.functions)
			return "invalid MIR imported function"
		for exported in exports
			if exported.function_id == symbol.function_id
				return "MIR function cannot be imported and exported"
	return ""

def mir_library_templates_error(templates: Array[string], snapshot: string) -> string
	if len(templates) > 4096 or (len(templates) > 0 and snapshot == "")
		return "invalid MIR generic templates"
	var names = Dict[string,bool]()
	for name in templates
		if not mir_library_name_valid(name) or (names.get(name) or false)
			return "invalid or duplicate MIR generic template"
		names = names.insert(name, true)
	return ""

def mir_serialize_library_generic(program: MirProgram, exports: Array[MirNamedExport], imports: Array[MirNamedImport], templates: Array[string], snapshot: string) -> MirWireSave
	let template_error = mir_library_templates_error(templates, snapshot)
	if template_error != ""
		return MirWireSave("", template_error)
	if len(exports) == 0 and len(templates) == 0
		return MirWireSave("", "MIR library requires exports or generic templates")
	let error = mir_library_exports_error(program, exports)
	if error != ""
		return MirWireSave("", error)
	let import_error = mir_library_imports_error(program, exports, imports)
	if import_error != ""
		return MirWireSave("", import_error)
	var entry = 0
	if len(exports) > 0
		entry = exports[!0].function_id
	let executable = mir_serialize_program(program, entry)
	if executable.error != ""
		return executable
	var parts = [MIR_LIBRARY_MAGIC]
	if len(templates) > 0
		parts = [MIR_LIBRARY_SYNTAX_MAGIC]
		if snapshot.starts_with(MIR_SEMANTIC_MAGIC)
			parts = [MIR_LIBRARY_SEMANTIC_MAGIC]
		elif snapshot.starts_with(MIR_PARAMETRIC_MAGIC)
			parts = [MIR_LIBRARY_PARAMETRIC_MAGIC]
	elif len(imports) > 0
		parts = [MIR_LIBRARY_IMPORT_MAGIC]
	parts = mir_wire_num(parts, len(exports))
	for symbol in exports
		parts = mir_wire_str(parts, symbol.name)
		parts = mir_wire_num(parts, symbol.function_id)
		parts = mir_wire_str(parts, mir_function_signature(program, symbol.function_id))
	if len(imports) > 0 or len(templates) > 0
		parts = mir_wire_num(parts, len(imports))
		for symbol in imports
			parts = mir_wire_str(parts, symbol.name)
			parts = mir_wire_num(parts, symbol.function_id)
			parts = mir_wire_str(parts, mir_function_signature(program, symbol.function_id))
	if len(templates) > 0
		parts = mir_wire_num(parts, len(templates))
		for name in templates
			parts = mir_wire_str(parts, name)
		parts = mir_wire_str(parts, snapshot)
	parts = mir_wire_str(parts, executable.text)
	let data = "".join(parts)
	if len(data) > MIR_WIRE_MAX_SIZE
		return MirWireSave("", "MIR library exceeds format size limit")
	return MirWireSave(data, "")

def mir_serialize_library_imports(program: MirProgram, exports: Array[MirNamedExport], imports: Array[MirNamedImport]) -> MirWireSave
	return mir_serialize_library_generic(program, exports, imports, Array[string](), "")

def mir_serialize_library(program: MirProgram, exports: Array[MirNamedExport]) -> MirWireSave
	return mir_serialize_library_imports(program, exports, Array[MirNamedImport]())

def mir_library_failure(error: string) -> MirLibraryLoad
	return MirLibraryLoad(MirProgram(Array[MirFunction]()), Array[MirNamedExport](), error)

def mir_deserialize_library(data: string) -> MirLibraryLoad
	if len(data) > MIR_WIRE_MAX_SIZE
		return mir_library_failure("unsupported MIR library format or size")
	var version = 1
	if data.starts_with(MIR_LIBRARY_PARAMETRIC_MAGIC)
		version = 6
	elif data.starts_with(MIR_LIBRARY_SEMANTIC_MAGIC)
		version = 5
	elif data.starts_with(MIR_LIBRARY_SYNTAX_MAGIC)
		version = 4
	elif data.starts_with(MIR_LIBRARY_GENERIC_MAGIC)
		version = 3
	elif data.starts_with(MIR_LIBRARY_IMPORT_MAGIC)
		version = 2
	elif not data.starts_with(MIR_LIBRARY_MAGIC)
		return mir_library_failure("unsupported MIR library format or size")
	var start = len(MIR_LIBRARY_MAGIC)
	if version == 2
		start = len(MIR_LIBRARY_IMPORT_MAGIC)
	elif version == 3
		start = len(MIR_LIBRARY_GENERIC_MAGIC)
	elif version == 4
		start = len(MIR_LIBRARY_SYNTAX_MAGIC)
	elif version == 5
		start = len(MIR_LIBRARY_SEMANTIC_MAGIC)
	elif version == 6
		start = len(MIR_LIBRARY_PARAMETRIC_MAGIC)
	var reader = MirWireReader(data, start, "")
	let count = mir_wire_count(reader)
	reader = count.reader
	if reader.error != "" or (version < 3 and count.value == 0) or count.value > 4096
		return mir_library_failure("invalid MIR export count")
	var exports = Array[MirNamedExport]()
	var signatures = Array[string]()
	for i in 0..count.value
		let name = mir_wire_string(reader)
		let id = mir_wire_number(name.reader)
		let signature = mir_wire_string(id.reader)
		reader = signature.reader
		if reader.error != ""
			return mir_library_failure(reader.error)
		exports = exports.append(MirNamedExport(name.value, id.value))
		signatures = signatures.append(signature.value)
	var imports = Array[MirNamedImport]()
	var import_signatures = Array[string]()
	if version >= 2
		let import_count = mir_wire_count(reader)
		reader = import_count.reader
		if reader.error != "" or (version == 2 and import_count.value == 0) or import_count.value > 4096
			return mir_library_failure("invalid MIR import count")
		for i in 0..import_count.value
			let name = mir_wire_string(reader)
			let id = mir_wire_number(name.reader)
			let signature = mir_wire_string(id.reader)
			reader = signature.reader
			if reader.error != ""
				return mir_library_failure(reader.error)
			imports = imports.append(MirNamedImport(name.value, id.value))
			import_signatures = import_signatures.append(signature.value)
	var templates = Array[string]()
	var source = ""
	var snapshot = ""
	if version >= 3
		let template_count = mir_wire_count(reader)
		reader = template_count.reader
		if reader.error != "" or template_count.value == 0 or template_count.value > 4096
			return mir_library_failure("invalid MIR generic template count")
		for i in 0..template_count.value
			let name = mir_wire_string(reader)
			reader = name.reader
			if reader.error != ""
				return mir_library_failure(reader.error)
			templates = templates.append(name.value)
		let stored_source = mir_wire_string(reader)
		reader = stored_source.reader
		if version == 3
			source = stored_source.value
		else
			snapshot = stored_source.value
			if version >= 5
				var validated = mir_deserialize_semantic(snapshot)
				if version == 6
					validated = mir_deserialize_parametric(snapshot)
				if validated.error != ""
					return mir_library_failure(validated.error)
				for name in templates
					var found = false
					for function in validated.declarations.functions
						if function.name == name and not function.constructor and not function.external
							found = true
					if not found
						return mir_library_failure("missing generic template declaration: " + name)
			else
				let validated = mir_deserialize_template(snapshot)
				if validated.error != ""
					return mir_library_failure(validated.error)
		let template_error = mir_library_templates_error(templates, stored_source.value)
		if template_error != ""
			return mir_library_failure(template_error)
	let payload = mir_wire_string(reader)
	reader = payload.reader
	if reader.error != "" or reader.at != len(data)
		return mir_library_failure("invalid MIR library payload")
	let loaded = mir_deserialize_program(payload.value)
	if loaded.error != ""
		return mir_library_failure(loaded.error)
	let error = mir_library_exports_error(loaded.program, exports)
	if error != ""
		return mir_library_failure(error)
	if len(exports) == 0 and len(templates) == 0
		return mir_library_failure("MIR library requires exports or generic templates")
	if len(exports) > 0 and loaded.entry != exports[!0].function_id
		return mir_library_failure("MIR library entry mismatch")
	for i in 0..len(exports)
		if mir_function_signature(loaded.program, exports[!i].function_id) != signatures[!i]
			return mir_library_failure("MIR exported signature mismatch")
	let import_error = mir_library_imports_error(loaded.program, exports, imports)
	if import_error != ""
		return mir_library_failure(import_error)
	for i in 0..len(imports)
		if mir_function_signature(loaded.program, imports[!i].function_id) != import_signatures[!i]
			return mir_library_failure("MIR imported signature mismatch")
	var result = MirLibraryLoad(loaded.program, exports, "")
	result.imports = imports
	result.templates = templates
	result.source = source
	result.snapshot = snapshot
	return result
