import mir alias Mir
import mir_wire alias MirWire
import module alias Module
# Concrete named-export MIR library. Symbols carry structural signatures whose
# spelling does not depend on local TypeIds or the order of type interning.
# These archives contain concrete functions and named unresolved import slots.
let MIR_LIBRARY_MAGIC = "SIRIUS-MIR-LIB/2\n"

export rec MirLibraryLoad(program: Mir.MirProgram, exports: Array[Mir.MirNamedExport], error: string, imports: Array[Mir.MirNamedImport])

export rec ModuleBuildCompiled(library: MirLibraryLoad, error: string)

export def mir_function_signature(program: Mir.MirProgram, id: i64) -> string
	let function = program.functions[!id]
	var parts = ["("]
	for i in 0..function.argument_count
		if i > 0
			parts = parts.append(",")
		parts = parts.append(Module.mir_type_signature(program.types, function.register_types[!i]))
	return "".join(parts) + ")->" + Module.mir_type_signature(program.types, function.return_type)

export def mir_library_name_valid(name: string) -> bool
	if len(name) == 0 or len(name) > 256
		return false
	for i in 0..len(name)
		let byte = name.byte_at(i) or 0
		if not ((byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95 or (i > 0 and byte >= 48 and byte <= 57))
			return false
	return true

export def mir_library_exports_error(program: Mir.MirProgram, exports: Array[Mir.MirNamedExport]) -> string
	if len(exports) == 0 or len(exports) > 4096
		return "invalid MIR export count"
	var names = Dict[string,bool]()
	for symbol in exports
		if not mir_library_name_valid(symbol.name)
			return "invalid MIR export name"
		if names.get(symbol.name) or false
			return "duplicate MIR export"
		names = names.insert(symbol.name, true)
		if symbol.function_id < 0 or symbol.function_id >= len(program.functions)
			return "invalid MIR exported function"
	return ""

export def mir_library_imports_error(program: Mir.MirProgram, exports: Array[Mir.MirNamedExport], imports: Array[Mir.MirNamedImport]) -> string
	if len(imports) > 4096
		return "invalid MIR import count"
	var names = Dict[string,bool]()
	var indices = Dict[i64,bool]()
	for symbol in imports
		if not mir_library_name_valid(symbol.name)
			return "invalid MIR import name"
		if names.get(symbol.name) or false
			return "duplicate MIR import"
		names = names.insert(symbol.name, true)
		if symbol.function_id < 0 or symbol.function_id >= len(program.functions)
			return "invalid MIR imported function"
		if indices.get(symbol.function_id) or false
			return "duplicate MIR imported function"
		indices = indices.insert(symbol.function_id, true)
		for exported in exports
			if exported.function_id == symbol.function_id
				return "MIR function cannot be both imported and exported"
		let function = program.functions[!symbol.function_id]
		if len(function.blocks) != 1 or function.blocks[!0].terminator.kind != Mir.MIR_PANIC or function.blocks[!0].terminator.message != "unresolved MIR import: " + symbol.name
			return "invalid MIR import placeholder"
	return ""

export def mir_serialize_library(program: Mir.MirProgram, exports: Array[Mir.MirNamedExport], imports: Array[Mir.MirNamedImport]) -> MirWire.MirWireSave
	let error = mir_library_exports_error(program, exports)
	if error != ""
		return MirWire.MirWireSave("", error)
	let import_error = mir_library_imports_error(program, exports, imports)
	if import_error != ""
		return MirWire.MirWireSave("", import_error)
	let executable = MirWire.mir_serialize_program(program, exports[!0].function_id)
	if executable.error != ""
		return executable
	var parts = [MIR_LIBRARY_MAGIC]
	parts = MirWire.mir_wire_num(parts, len(exports))
	for symbol in exports
		parts = MirWire.mir_wire_str(parts, symbol.name)
		parts = MirWire.mir_wire_num(parts, symbol.function_id)
		parts = MirWire.mir_wire_str(parts, mir_function_signature(program, symbol.function_id))
	parts = MirWire.mir_wire_num(parts, len(imports))
	for symbol in imports
		parts = MirWire.mir_wire_str(parts, symbol.name)
		parts = MirWire.mir_wire_num(parts, symbol.function_id)
		parts = MirWire.mir_wire_str(parts, mir_function_signature(program, symbol.function_id))
	parts = MirWire.mir_wire_str(parts, executable.text)
	let data = "".join(parts)
	if len(data) > MirWire.MIR_WIRE_MAX_SIZE
		return MirWire.MirWireSave("", "MIR library exceeds format size limit")
	return MirWire.MirWireSave(data, "")

export def mir_library_failure(error: string) -> MirLibraryLoad
	return MirLibraryLoad(Mir.new_mir_program(Array[Mir.MirFunction]()), Array[Mir.MirNamedExport](), error, Array[Mir.MirNamedImport]())

export def mir_deserialize_library(data: string) -> MirLibraryLoad
	if len(data) > MirWire.MIR_WIRE_MAX_SIZE or not data.starts_with(MIR_LIBRARY_MAGIC)
		return mir_library_failure("unsupported MIR library format or size")
	var reader = MirWire.MirWireReader(data, len(MIR_LIBRARY_MAGIC), "")
	let count = MirWire.mir_wire_count(reader)
	reader = count.reader
	if reader.error != "" or count.value == 0 or count.value > 4096
		return mir_library_failure("invalid MIR export count")
	var exports = Array[Mir.MirNamedExport]()
	var signatures = Array[string]()
	for i in 0..count.value
		let name = MirWire.mir_wire_string(reader)
		let id = MirWire.mir_wire_number(name.reader)
		let signature = MirWire.mir_wire_string(id.reader)
		reader = signature.reader
		if reader.error != ""
			return mir_library_failure(reader.error)
		exports = exports.append(Mir.MirNamedExport(name.value, id.value))
		signatures = signatures.append(signature.value)
	let import_count = MirWire.mir_wire_count(reader)
	reader = import_count.reader
	if reader.error != "" or import_count.value > 4096
		return mir_library_failure("invalid MIR import count")
	var imports = Array[Mir.MirNamedImport]()
	var import_signatures = Array[string]()
	for i in 0..import_count.value
		let name = MirWire.mir_wire_string(reader)
		let id = MirWire.mir_wire_number(name.reader)
		let signature = MirWire.mir_wire_string(id.reader)
		reader = signature.reader
		if reader.error != ""
			return mir_library_failure(reader.error)
		imports = imports.append(Mir.MirNamedImport(name.value, id.value))
		import_signatures = import_signatures.append(signature.value)
	let payload = MirWire.mir_wire_string(reader)
	reader = payload.reader
	if reader.error != "" or reader.at != len(data)
		return mir_library_failure("invalid MIR library payload")
	let loaded = MirWire.mir_deserialize_program(payload.value)
	if loaded.error != ""
		return mir_library_failure(loaded.error)
	let error = mir_library_exports_error(loaded.program, exports)
	if error != ""
		return mir_library_failure(error)
	let import_error = mir_library_imports_error(loaded.program, exports, imports)
	if import_error != ""
		return mir_library_failure(import_error)
	if loaded.entry != exports[!0].function_id
		return mir_library_failure("MIR library entry mismatch")
	for i in 0..len(exports)
		if mir_function_signature(loaded.program, exports[!i].function_id) != signatures[!i]
			return mir_library_failure("MIR exported signature mismatch")
	for i in 0..len(imports)
		if mir_function_signature(loaded.program, imports[!i].function_id) != import_signatures[!i]
			return mir_library_failure("MIR imported signature mismatch")
	return MirLibraryLoad(loaded.program, exports, "", imports)
