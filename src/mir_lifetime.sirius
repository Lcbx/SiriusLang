# Conservative CFG liveness for MIR register ownership.
# Releases managed values immediately after their last use on a path.
# Existing return cleanup remains responsible for values not definitely used.

rec MirLifetimeBlock(live_in: Array[i64], live_out: Array[i64])
rec MirLifetimeResult(program: MirProgram, releases: i64, error: string)
rec MirLowerLifetime(function: MirFunction, releases: i64)

def mir_live_contains(registers: Array[i64], register: i64) -> bool
	for value in registers
		if value == register
			return true
	return false

def mir_live_add(registers: Array[i64], register: i64) -> Array[i64]
	if register < 0 or mir_live_contains(registers, register)
		return registers
	return registers.append(register)

def mir_live_remove(registers: Array[i64], register: i64) -> Array[i64]
	var result = Array[i64]()
	for value in registers
		if value != register
			result = result.append(value)
	return result

def mir_live_union(left: Array[i64], right: Array[i64]) -> Array[i64]
	var result = left
	for value in right
		result = mir_live_add(result, value)
	return result

def mir_live_equal(left: Array[i64], right: Array[i64]) -> bool
	if len(left) != len(right)
		return false
	for value in left
		if not mir_live_contains(right, value)
			return false
	return true

def mir_live_reads(ins: MirInstruction) -> Array[i64]
	let op = ins.op
	var reads = Array[i64]()
	if op == MIR_CONST_I64 or op == MIR_CONST_BOOL or op == MIR_CONST_STRING or op == MIR_DICT_NEW or op == MIR_OPTIONAL_NONE
		return reads
	if op == MIR_CALL or op == MIR_RECORD_NEW or op == MIR_ARRAY_NEW
		return ins.inputs
	reads = mir_live_add(reads, ins.first)
	if op == MIR_DICT_INSERT
		return mir_live_union(reads, ins.inputs)
	if op == MIR_ARRAY_SET or op == MIR_DICT_GET_OR
		reads = mir_live_add(reads, ins.immediate)
	if (op >= MIR_ADD_I64 and op <= MIR_LE_I64) or op == MIR_EQ_BOOL or op == MIR_STRING_CONCAT or op == MIR_ARRAY_GET or op == MIR_ARRAY_GET_OPTIONAL or op == MIR_ARRAY_SET or op == MIR_DICT_GET_OR or op == MIR_DICT_GET_OPTIONAL
		reads = mir_live_add(reads, ins.second)
	return reads

def mir_live_consumes(ins: MirInstruction) -> bool
	return ins.op == MIR_MOVE or ins.op == MIR_ARRAY_SET or ins.op == MIR_DICT_INSERT or ins.op == MIR_RELEASE

def mir_live_before(ins: MirInstruction, after: Array[i64]) -> Array[i64]
	var before = after
	if ins.op != MIR_PRINT
		before = mir_live_remove(before, ins.dst)
	if mir_live_consumes(ins)
		before = mir_live_remove(before, ins.first)
	return mir_live_union(before, mir_live_reads(ins))

def mir_live_term(term: MirTerminator, after: Array[i64]) -> Array[i64]
	if term.kind == MIR_BRANCH or term.kind == MIR_RETURN
		return mir_live_add(after, term.operand)
	return after

def mir_managed_type_id(function: MirFunction, register: i64) -> bool
	if register < 0 or register >= len(function.register_types)
		return false
	return function.register_types[!register] == TYPE_TAG_STRING or function.register_types[!register] >= TYPE_TAG_RECORD

def mir_lifetime_function(function: MirFunction) -> MirLowerLifetime
	var state = Array[MirLifetimeBlock]()
	for block in function.blocks
		state = state.append(MirLifetimeBlock(Array[i64](), Array[i64]()))
	var changed = true
	while changed
		changed = false
		for step in 0..len(function.blocks)
			let i = len(function.blocks) - 1 - step
			let block = function.blocks[!i]
			var outgoing = Array[i64]()
			if block.terminator.kind == MIR_JUMP or block.terminator.kind == MIR_BRANCH
				outgoing = mir_live_union(outgoing, state[!block.terminator.target].live_in)
			if block.terminator.kind == MIR_BRANCH
				outgoing = mir_live_union(outgoing, state[!block.terminator.alternative].live_in)
			var incoming = mir_live_term(block.terminator, outgoing)
			for position in 0..len(block.instructions)
				let ins = block.instructions[!len(block.instructions) - 1 - position]
				incoming = mir_live_before(ins, incoming)
			if not mir_live_equal(incoming, state[!i].live_in) or not mir_live_equal(outgoing, state[!i].live_out)
				state[!i] = MirLifetimeBlock(incoming, outgoing)
				changed = true
	var blocks = Array[MirBlock]()
	var count = 0
	for i in 0..len(function.blocks)
		let block = function.blocks[!i]
		var live = mir_live_term(block.terminator, state[!i].live_out)
		var releases = Array[Array[i64]]()
		for position in 0..len(block.instructions)
			let ins = block.instructions[!len(block.instructions) - 1 - position]
			var dropping = Array[i64]()
			if ins.op != MIR_RELEASE
				if ins.op != MIR_PRINT and not mir_live_contains(live, ins.dst) and mir_managed_type_id(function, ins.dst)
					dropping = mir_live_add(dropping, ins.dst)
				for register in mir_live_reads(ins)
					if register != ins.dst and not (mir_live_consumes(ins) and register == ins.first) and not mir_live_contains(live, register) and mir_managed_type_id(function, register)
						dropping = mir_live_add(dropping, register)
			releases = releases.append(dropping)
			live = mir_live_before(ins, live)
		var instructions = Array[MirInstruction]()
		for position in 0..len(block.instructions)
			instructions = instructions.append(block.instructions[!position])
			let dropping = releases[!len(block.instructions) - 1 - position]
			for register in dropping
				instructions = instructions.append(mir_op(MIR_RELEASE, register, register, -1, 0))
				count += 1
		blocks = blocks.append(MirBlock(instructions, block.terminator))
	return MirLowerLifetime(MirFunction(function.argument_count, function.return_type, function.register_types, blocks, function.entry), count)


def mir_insert_lifetimes(program: MirProgram) -> MirLifetimeResult
	let error = mir_verify(program)
	if error != ""
		return MirLifetimeResult(program, 0, error)
	var functions = Array[MirFunction]()
	var count = 0
	for function in program.functions
		let lowered = mir_lifetime_function(function)
		functions = functions.append(lowered.function)
		count += lowered.releases
	var result = MirProgram(functions)
	result.types = program.types
	return MirLifetimeResult(result, count, mir_verify(result))
