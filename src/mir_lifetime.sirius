import types alias Types
import mir alias Mir
import mir_cfg alias Cfg
import mir_verify alias Verify
import mir_ownership alias Ownership
# Conservative CFG liveness for MIR register ownership.
# Releases managed values immediately after their last use on a path.
# Existing return cleanup remains responsible for values not definitely used.

export rec MirLifetimeBlock(live_in: Array[i64], live_out: Array[i64])
rec MirLifetimeResult(program: Mir.MirProgram, releases: i64, error: string)
rec MirLowerLifetime(function: Mir.MirFunction, releases: i64)

def mir_live_empty(count: i64) -> Array[i64]
	var values = Array[i64]()
	for i in 0..count
		values = values.append(0)
	return values

export def mir_live_contains(registers: Array[i64], register: i64) -> bool
	return register >= 0 and register < len(registers) and registers[!register] != 0

def mir_live_add(registers: Array[i64], register: i64) -> Array[i64]
	var next = registers
	if register >= 0 and register < len(next) and next[!register] == 0
		next[!register] = 1
	return next

def mir_live_remove(registers: Array[i64], register: i64) -> Array[i64]
	var next = registers
	if register >= 0 and register < len(next) and next[!register] != 0
		next[!register] = 0
	return next

def mir_live_union(left: Array[i64], right: Array[i64]) -> Array[i64]
	var next = left
	for i in 0..len(next)
		if right[!i] != 0 and next[!i] == 0
			next[!i] = 1
	return next

export def mir_live_equal(left: Array[i64], right: Array[i64]) -> bool
	return Cfg.mir_cfg_state_equal(left, right)

def mir_live_before(ins: Mir.MirInstruction, after: Array[i64]) -> Array[i64]
	var before = after
	if ins.op != Mir.MIR_PRINT and ins.op != Mir.MIR_EPRINT
		before = mir_live_remove(before, ins.dst)
	if Cfg.mir_consumes_source(ins)
		before = mir_live_remove(before, ins.first)
	if ins.op == Mir.MIR_CALL_MOVE or ins.op == Mir.MIR_RECORD_NEW_MOVE or ins.op == Mir.MIR_ARRAY_NEW_MOVE
		for i in 0..len(ins.inputs)
			if Mir.mir_input_move_at(ins, i)
				before = mir_live_remove(before, ins.inputs[!i])
	for register in Cfg.mir_instruction_reads(ins)
		before = mir_live_add(before, register)
	return before

def mir_live_term(term: Mir.MirTerminator, after: Array[i64]) -> Array[i64]
	if term.kind == Mir.MIR_BRANCH or term.kind == Mir.MIR_RETURN
		return mir_live_add(after, term.operand)
	return after

# Short-lived list of release instructions; not a data-flow register set.
def mir_lifetime_drop_add(registers: Array[i64], register: i64) -> Array[i64]
	for value in registers
		if value == register
			return registers
	return registers.append(register)

def mir_lifetime_managed(types: Types.TypeTable, function: Mir.MirFunction, register: i64) -> bool
	if register < 0 or register >= len(function.register_types)
		return false
	return Verify.mir_managed_type(types, function.register_types[!register])

# Callers that also analyze ownership can reuse a single CFG snapshot.
export def mir_lifetime_states_cfg(function: Mir.MirFunction, cfg: Cfg.MirCfgFacts) -> Array[MirLifetimeBlock]
	let count = len(function.register_types)
	let predecessors = cfg.predecessors
	let reached = cfg.reached
	# Share the immutable zero state across blocks and worklist iterations.
	# CoW creates a private copy only when a liveness bit actually changes.
	let empty = mir_live_empty(count)
	var state = Array[MirLifetimeBlock]()
	var queued = Array[i64]()
	var queue = Array[i64]()
	for i in 0..len(function.blocks)
		state = state.append(MirLifetimeBlock(empty, empty))
		queued = queued.append(reached[!i])
	for step in 0..len(function.blocks)
		let i = len(function.blocks) - 1 - step
		if reached[!i] != 0
			queue = queue.append(i)
	var head = 0
	while head < len(queue)
		let i = queue[!head]
		head += 1
		queued[!i] = 0
		let block = function.blocks[!i]
		var outgoing = empty
		if block.terminator.kind == Mir.MIR_JUMP or block.terminator.kind == Mir.MIR_BRANCH
			# A single successor's live-in state is already the union.
			# Further unions use CoW, preserving its stored snapshot.
			outgoing = state[!block.terminator.target].live_in
		if block.terminator.kind == Mir.MIR_BRANCH and block.terminator.alternative != block.terminator.target
			outgoing = mir_live_union(outgoing, state[!block.terminator.alternative].live_in)
		var incoming = mir_live_term(block.terminator, outgoing)
		for position in 0..len(block.instructions)
			let ins = block.instructions[!len(block.instructions) - 1 - position]
			incoming = mir_live_before(ins, incoming)
		if not mir_live_equal(incoming, state[!i].live_in) or not mir_live_equal(outgoing, state[!i].live_out)
			state[!i] = MirLifetimeBlock(incoming, outgoing)
			for pred in predecessors[!i]
				if reached[!pred] != 0 and queued[!pred] == 0
					queued[!pred] = 1
					queue = queue.append(pred)
	return state

export def mir_lifetime_states(function: Mir.MirFunction) -> Array[MirLifetimeBlock]
	return mir_lifetime_states_cfg(function, Cfg.mir_cfg_facts(function))

def mir_lifetime_function(types: Types.TypeTable, function: Mir.MirFunction) -> MirLowerLifetime
	let state = mir_lifetime_states(function)
	var blocks = Array[Mir.MirBlock]()
	var count = 0
	for i in 0..len(function.blocks)
		let block = function.blocks[!i]
		var live = mir_live_term(block.terminator, state[!i].live_out)
		var releases = Array[Array[i64]]()
		for position in 0..len(block.instructions)
			let ins = block.instructions[!len(block.instructions) - 1 - position]
			var dropping = Array[i64]()
			if ins.op != Mir.MIR_RELEASE and ins.op != Mir.MIR_RELEASE_IF_INIT
				if ins.op != Mir.MIR_PRINT and ins.op != Mir.MIR_EPRINT and not mir_live_contains(live, ins.dst) and mir_lifetime_managed(types, function, ins.dst)
					dropping = mir_lifetime_drop_add(dropping, ins.dst)
				for register in Cfg.mir_instruction_reads(ins)
					if register != ins.dst and not (Cfg.mir_consumes_source(ins) and register == ins.first) and not Mir.mir_input_moves_register(ins, register) and not mir_live_contains(live, register) and mir_lifetime_managed(types, function, register)
						dropping = mir_lifetime_drop_add(dropping, register)
			releases = releases.append(dropping)
			live = mir_live_before(ins, live)
		var instructions = Array[Mir.MirInstruction]()
		for position in 0..len(block.instructions)
			instructions = instructions.append(block.instructions[!position])
			let dropping = releases[!len(block.instructions) - 1 - position]
			for register in dropping
				instructions = instructions.append(Mir.mir_op(Mir.MIR_RELEASE, register, register, -1, 0))
				count += 1
		blocks = blocks.append(Mir.MirBlock(instructions, block.terminator))
	return MirLowerLifetime(Mir.MirFunction(function.argument_count, function.return_type, function.register_types, blocks, function.entry), count)


# Internal transformation, used when the surrounding pipeline owns validation.
export def mir_insert_lifetimes_unchecked(program: Mir.MirProgram) -> MirLifetimeResult
	var functions = Array[Mir.MirFunction]()
	var count = 0
	for function in program.functions
		let lowered = mir_lifetime_function(program.types, function)
		functions = functions.append(lowered.function)
		count += lowered.releases
	return MirLifetimeResult(Mir.mir_program_with_types(functions, program.types), count, "")

export def mir_insert_lifetimes(program: Mir.MirProgram) -> MirLifetimeResult
	let error = Ownership.mir_check_ownership(program)
	if error != ""
		return MirLifetimeResult(program, 0, error)
	let lowered = mir_insert_lifetimes_unchecked(program)
	return MirLifetimeResult(lowered.program, lowered.releases, Ownership.mir_check_ownership(lowered.program))
