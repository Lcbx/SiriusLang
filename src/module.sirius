import types alias Types

# Shared, length-prefixed naming for imported and exported symbols.
export def hir_module_symbol(path: string, name: string) -> string
	var result = "M"
	var start = 0
	for i in 0..len(path)
		if (path.byte_at(i) or -1) == 46 # '.'
			let part = path.slice(start, i)
			result += "_" + str(len(part)) + "_" + part
			start = i + 1
	let final = path.slice(start, len(path))
	return result + "_" + str(len(final)) + "_" + final + "_" + str(len(name)) + "_" + name


# Translate a dotted module name to its source-root-relative file path.
export def module_scan_filename(root: string, name: string) -> string
	var result = root + "/"
	for i in 0..len(name)
		let c = name.byte_at(i) or 0
		if c == 46
			result += "/"
		else
			result += name.slice(i, i + 1)
	return result + ".sirius"

# Canonical structural signatures independent of local module TypeIds.
export def mir_type_signature(types: Types.TypeTable, id: i64) -> string
	if not Types.type_descriptor_canonical(types, id)
		return "invalid"
	let desc = types.entries[!id]
	if desc.tag == Types.TYPE_TAG_I64
		return "i64"
	if desc.tag == Types.TYPE_TAG_F64
		return "f64"
	if desc.tag == Types.TYPE_TAG_BOOL
		return "bool"
	if desc.tag == Types.TYPE_TAG_STRING
		return "string"
	if desc.tag == Types.TYPE_TAG_VOID
		return "void"
	if desc.tag == Types.TYPE_TAG_ARRAY
		let element = mir_type_signature(types, desc.first)
		if element == "invalid"
			return "invalid"
		return "Array[" + element + "]"
	if desc.tag == Types.TYPE_TAG_OPTIONAL
		let element = mir_type_signature(types, desc.first)
		if element == "invalid"
			return "invalid"
		return "Optional[" + element + "]"
	if desc.tag == Types.TYPE_TAG_DICT
		let key = mir_type_signature(types, desc.first)
		let value = mir_type_signature(types, desc.second)
		if key == "invalid" or value == "invalid"
			return "invalid"
		return "Dict[" + key + "," + value + "]"
	if desc.tag != Types.TYPE_TAG_RECORD
		return "invalid"
	var parts = ["Record{"]
	for field in desc.fields
		let value = mir_type_signature(types, field.kind)
		if value == "invalid"
			return "invalid"
		parts = parts.append(str(len(field.name)) + ":" + field.name + "=" + value + ";")
	return "".join(parts) + "}"


# Encode each concrete argument signature as an identifier-safe, unambiguous
# suffix. Reject excessively long names at the existing MIR library boundary.
export def mir_generic_symbol(name: string, types: Types.TypeTable, arguments: Array[i64]) -> string
	var result = name + "_G"
	for argument in arguments
		let signature = mir_type_signature(types, argument)
		var encoded = ""
		for i in 0..len(signature)
			let byte = signature.byte_at(i) or 0
			if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57)
				encoded += signature.slice(i, i + 1)
			else
				encoded += "_" + str(byte) + "_"
		result += "_" + str(len(encoded)) + "_" + encoded
	return result
