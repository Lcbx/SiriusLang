import types alias Types

# Shared, length-prefixed naming for imported and exported symbols.
export def hir_module_symbol(path: string, name: string) -> string
	var result = "M"
	var start = 0
	for i in 0..len(path)
		if (path.byte_at(i) or -1) == 46 # '.'
			let part = path.slice(start, i)
			result += "_" + str(len(part)) + "_" + part
			start = i + 1
	let final = path.slice(start, len(path))
	return result + "_" + str(len(final)) + "_" + final + "_" + str(len(name)) + "_" + name



# Qualified names are rewritten to length-prefixed module symbols by the
# source linker. Decode the final component for constructor-label matching:
# the label belongs to a union alternative, not to its structural payload.
# Validate every segment (including underscores inside identifiers) rather
# than matching a suffix that might belong to an unrelated local constructor.
export def hir_module_symbol_member(symbol: string) -> string
	if not symbol.starts_with("M_")
		return symbol
	var position = 1
	var count = 0
	var member = ""
	while position < len(symbol)
		if (symbol.byte_at(position) or 0) != 95
			return symbol
		position += 1
		let start = position
		var width = 0
		while position < len(symbol)
			let digit = symbol.byte_at(position) or 0
			if digit < 48 or digit > 57
				break
			width = width * 10 + digit - 48
			if width > len(symbol)
				return symbol
			position += 1
		if position == start or position >= len(symbol) or (symbol.byte_at(position) or 0) != 95
			return symbol
		position += 1
		if width == 0 or width > len(symbol) - position
			return symbol
		member = symbol.slice(position, position + width)
		position += width
		count += 1
	if count < 2
		return symbol
	return member

# Translate a dotted module name to its source-root-relative file path.
export def module_scan_filename(root: string, name: string) -> string
	var result = root + "/"
	for i in 0..len(name)
		let c = name.byte_at(i) or 0
		if c == 46
			result += "/"
		else
			result += name.slice(i, i + 1)
	return result + ".sirius"

# Canonical structural signatures independent of local module TypeIds.
export def mir_type_signature(types: Types.TypeTable, id: i64) -> string
	return Types.type_signature(types, id)

# Encode each concrete argument signature as an identifier-safe, unambiguous
# suffix. Reject excessively long names at the existing MIR library boundary.
def mir_signature_symbol(name: string, marker: string, types: Types.TypeTable, arguments: Array[i64]) -> string
	var result = name + marker
	for argument in arguments
		let signature = mir_type_signature(types, argument)
		var encoded = ""
		for i in 0..len(signature)
			let byte = signature.byte_at(i) or 0
			if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or (byte >= 48 and byte <= 57)
				encoded += signature.slice(i, i + 1)
			else
				encoded += "_" + str(byte) + "_"
		result += "_" + str(len(encoded)) + "_" + encoded
	return result

# Overload names use a distinct prefix from on-demand generic specializations.
export def mir_overload_symbol(name: string, types: Types.TypeTable, arguments: Array[i64]) -> string
	return mir_signature_symbol(name, "_O", types, arguments)

export def mir_generic_symbol(name: string, types: Types.TypeTable, arguments: Array[i64]) -> string
	return mir_signature_symbol(name, "_G", types, arguments)
