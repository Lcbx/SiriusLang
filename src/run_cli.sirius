# Standalone dynamic MIR execution and versioned MIR executable artifacts.
def run_positive_limit(value: string, maximum: i64) -> i64
	if len(value) == 0
		return -1
	var result = 0
	for i in 0..len(value)
		let digit = (value.byte_at(i) or -1) - 48
		if digit < 0 or digit > 9 or result > (maximum - digit) / 10
			return -1
		result = result * 10 + digit
	if result == 0
		return -1
	return result

# The linker merges concrete libraries and expands syntax-backed templates;
# the source runner and interpreter remain independent of native emission.
def run_link_libraries(args: Array[string]) -> i64
	if len(args) < 5
		eprint("usage: sirius-run --link-lib output.smirl input1.smirl input2.smirl ...")
		return 2
	var inputs = Array[MirLibraryLoad]()
	for i in 3..len(args)
		let contents = read_text(args[!i]) or ""
		if contents == ""
			eprint("cannot read MIR library: " + args[!i])
			return 2
		let library = mir_deserialize_library(contents)
		if library.error != ""
			eprint("invalid MIR library: " + library.error)
			return 2
		inputs = inputs.append(library)
	let linked = mir_link_libraries(inputs)
	if linked.error != ""
		eprint("cannot link MIR libraries: " + linked.error)
		return 2
	let saved = mir_serialize_library(linked.program, linked.exports)
	if saved.error != ""
		eprint("cannot serialize linked MIR library: " + saved.error)
		return 2
	if not write_text(args[!2], saved.text)
		eprint("cannot write linked MIR library")
		return 2
	return 0

# Emit native C from the same linked concrete MIR artifact accepted by the
# interpreter. This selects a whole-program backend, not mixed call dispatch.
def run_emit_library_c(args: Array[string]) -> i64
	if len(args) != 6 or args[!3] != "--entry"
		eprint("usage: sirius-run --emit-c-lib output.c --entry NAME input.smirl")
		return 2
	let contents = read_text(args[!5]) or ""
	if contents == ""
		eprint("cannot read MIR library")
		return 2
	let library = mir_deserialize_library(contents)
	if library.error != ""
		eprint("invalid MIR library: " + library.error)
		return 2
	if len(library.imports) != 0
		eprint("cannot compile MIR library with unresolved imports")
		return 2
	var entry = -1
	for symbol in library.exports
		if symbol.name == args[!4]
			entry = symbol.function_id
	if entry < 0
		eprint("unknown MIR library export: " + args[!4])
		return 2
	let emitted = mir_emit_c_verified(library.program, entry)
	if emitted.error != ""
		eprint("cannot emit native MIR: " + emitted.error)
		return 2
	if not write_text(args[!2], emitted.code)
		eprint("cannot write native C")
		return 2
	return 0

def main() -> i64
	let args = arguments()
	if len(args) > 1 and args[!1] == "--emit-c-lib"
		return run_emit_library_c(args)
	if len(args) > 1 and args[!1] == "--link-lib"
		return run_link_libraries(args)
	var index = 1
	var max_steps = 10000000
	var max_depth = 256
	var emit_path = ""
	var load_path = ""
	var emit_lib_path = ""
	var load_lib_path = ""
	var list_lib = false
	var export_names = Array[string]()
	var expose_names = Array[string]()
	var import_names = Array[string]()
	var template_names = Array[string]()
	var entry_name = ""
	while index < len(args)
		let option = args[!index]
		if option == "--"
			index += 1
			break
		if option == "--load-mir" or option == "--emit-mir" or option == "--load-lib" or option == "--emit-lib" or option == "--list-lib"
			if index + 1 >= len(args)
				eprint("missing value for " + option)
				return 2
			if emit_path != "" or load_path != "" or emit_lib_path != "" or load_lib_path != ""
				eprint("MIR input/output modes are mutually exclusive")
				return 2
			if option == "--emit-mir"
				emit_path = args[!index + 1]
			elif option == "--load-mir"
				load_path = args[!index + 1]
			elif option == "--emit-lib"
				emit_lib_path = args[!index + 1]
			else
				load_lib_path = args[!index + 1]
				list_lib = option == "--list-lib"
			index += 2
			if load_path != "" or load_lib_path != ""
				break
			continue
		if option == "--export" or option == "--expose" or option == "--import" or option == "--template" or option == "--entry"
			if index + 1 >= len(args)
				eprint("missing value for " + option)
				return 2
			if option == "--export"
				export_names = export_names.append(args[!index + 1])
			elif option == "--expose"
				expose_names = expose_names.append(args[!index + 1])
			elif option == "--import"
				import_names = import_names.append(args[!index + 1])
			elif option == "--template"
				template_names = template_names.append(args[!index + 1])
			else
				entry_name = args[!index + 1]
			index += 2
			continue
		if option != "--max-steps" and option != "--max-depth"
			if option.starts_with("--")
				eprint("unknown option: " + option)
				return 2
			break
		if index + 1 >= len(args)
			eprint("missing value for " + option)
			return 2
		let maximum = 1000000000
		let limit = run_positive_limit(args[!index + 1], maximum)
		if limit < 1
			eprint("invalid value for " + option)
			return 2
		if option == "--max-steps"
			max_steps = limit
		else
			max_depth = limit
		index += 2
	if load_path == "" and load_lib_path == "" and index >= len(args)
		eprint("usage: sirius-run [--emit-mir file | --emit-lib file --export ROOT [--expose NAME] [--import NAME]] input.sirius [args...]")
		eprint("       sirius-run [--load-mir file | --entry NAME --load-lib file | --list-lib file] [args...]")
		return 2
	if (emit_lib_path == "" and (len(export_names) != 0 or len(expose_names) != 0 or len(import_names) != 0 or len(template_names) != 0)) or (emit_lib_path != "" and len(export_names) == 0 and len(template_names) == 0) or (load_lib_path == "" and entry_name != "")
		eprint("--export, --expose, --import and --template require --emit-lib; --entry requires --load-lib")
		return 2
	var program = MirProgram(Array[MirFunction]())
	var entry_id = -1
	var runtime_args = Array[string]()
	if load_lib_path != ""
		let contents = read_text(load_lib_path) or ""
		if contents == ""
			eprint("cannot read MIR library")
			return 2
		let library = mir_deserialize_library(contents)
		if library.error != ""
			eprint("invalid MIR library: " + library.error)
			return 2
		if list_lib
			for symbol in library.exports
				print(symbol.name + " : " + mir_function_signature(library.program, symbol.function_id))
			for symbol in library.imports
				print("import " + symbol.name + " : " + mir_function_signature(library.program, symbol.function_id))
			for name in library.templates
				print("template " + name)
			return 0
		if len(library.imports) != 0
			eprint("cannot execute MIR library with unresolved imports")
			return 2
		program = library.program
		for symbol in library.exports
			if (entry_name == "" and entry_id < 0) or symbol.name == entry_name
				entry_id = symbol.function_id
		if entry_id < 0
			eprint("unknown MIR library export: " + entry_name)
			return 2
		runtime_args = [load_lib_path]
		for i in index..len(args)
			runtime_args = runtime_args.append(args[!i])
	elif load_path != ""
		let contents = read_text(load_path) or ""
		if contents == ""
			eprint("cannot read MIR artifact")
			return 2
		let loaded = mir_deserialize_program(contents)
		if loaded.error != ""
			eprint("invalid MIR artifact: " + loaded.error)
			return 2
		program = loaded.program
		entry_id = loaded.entry
		runtime_args = [load_path]
		for i in index..len(args)
			runtime_args = runtime_args.append(args[!i])
	else
		let source = read_text(args[!index]) or ""
		let parsed = parse_module(source)
		if parsed.state.error != ""
			print("ERROR " + str(parsed.state.error_line) + ": " + parsed.state.error)
			return 1
		let declarations = hir_module_declarations(parsed.state, parsed.node)
		if declarations.error != ""
			print("ERROR " + str(declarations.error_line) + ": " + declarations.error)
			return 1
		var roots = ["main"]
		if emit_lib_path != ""
			roots = export_names
		let lowered = mir_build_program_roots(parsed.state, declarations, roots, Array[i64]())
		if lowered.error != ""
			print("ERROR 1: " + lowered.error)
			return 1
		program = lowered.program
		entry_id = lowered.entry
		if emit_lib_path != "" and len(export_names) == 0
			let dummy = MirFunction(0, TYPE_TAG_I64, [TYPE_TAG_I64], [MirBlock([mir_op(MIR_CONST_I64, 0, -1, -1, 0)], mir_return(0))], 0)
			program = mir_program_with_types([dummy], declarations.types)
		if emit_lib_path == "" and len(lowered.imports) > 0
			eprint("unresolved external declarations require library linking")
			return 2
		if emit_lib_path != ""
			var exports = lowered.exports
			var imports = Array[MirNamedImport]()
			for symbol in lowered.imports
				imports = imports.append(MirNamedImport(symbol.name, symbol.function_id))
			for name in expose_names
				var count = 0
				for symbol in lowered.symbols
					if symbol.name == name
						exports = exports.append(symbol)
						count += 1
				if count != 1
					eprint("--expose requires exactly one concrete specialization: " + name)
					return 2
			for name in import_names
				var count = 0
				for symbol in lowered.symbols
					if symbol.name == name
						imports = imports.append(MirNamedImport(name, symbol.function_id))
						count += 1
				if count != 1
					eprint("--import requires exactly one concrete specialization: " + name)
					return 2
			for name in template_names
				var found = false
				for declaration in declarations.functions
					if declaration.name == name and not declaration.external and not declaration.constructor
						found = true
				if not found
					eprint("unknown generic template: " + name)
					return 2
			var snapshot = ""
			if len(template_names) > 0
				let stored = mir_serialize_template(parsed.state, parsed.node)
				if stored.error != ""
					eprint("cannot save generic syntax: " + stored.error)
					return 2
				snapshot = stored.text
			let saved = mir_serialize_library_generic(program, exports, imports, template_names, snapshot)
			if saved.error != ""
				eprint("cannot serialize MIR library: " + saved.error)
				return 2
			if not write_text(emit_lib_path, saved.text)
				eprint("cannot write MIR library")
				return 2
			return 0
		runtime_args = [args[!index]]
		for i in index + 1..len(args)
			runtime_args = runtime_args.append(args[!i])
	if entry_id < 0 or entry_id >= len(program.functions)
		eprint("invalid MIR entry")
		return 2
	let entry = program.functions[!entry_id]
	if entry.argument_count != 0 or entry.return_type != TYPE_TAG_I64
		eprint("MIR entry must be main() -> i64")
		return 2
	if emit_path != ""
		let saved = mir_serialize_program(program, entry_id)
		if saved.error != ""
			eprint("cannot serialize MIR: " + saved.error)
			return 2
		if not write_text(emit_path, saved.text)
			eprint("cannot write MIR artifact")
			return 2
		return 0
	let outcome = mir_execute_with_arguments(program, entry_id, Array[MirValue](), max_steps, max_depth, runtime_args)
	if outcome.error != ""
		eprint("Sirius panic: " + outcome.error)
		return 1
	return outcome.value.bits
