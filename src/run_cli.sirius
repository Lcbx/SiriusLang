import hir_declarations alias HirDeclarations
import mir alias Mir
import mir_bundle alias MirBundle
import mir_emit_c alias MirEmitC
import mir_generic alias MirGeneric
import mir_interpreter alias MirInterpreter
import mir_library alias MirLibrary
import mir_link alias MirLink
import mir_program alias MirProgram
import mir_wire alias MirWire
import module alias Module
import module_build alias ModuleBuild
import module_resolve alias ModuleResolve
import parser alias Parser
import types alias Types
# Standalone dynamic MIR execution and versioned MIR executable artifacts.
def run_positive_limit(value: string, maximum: i64) -> i64
	if len(value) == 0
		return -1
	var result = 0
	for i in 0..len(value)
		let digit = (value.byte_at(i) or -1) - 48
		if digit < 0 or digit > 9 or result > (maximum - digit) / 10
			return -1
		result = result * 10 + digit
	if result == 0
		return -1
	return result

# The linker operates on complete concrete libraries; the source compiler
# and interpreter paths remain independent of linking.
def run_link_libraries(args: Array[string]) -> i64
	if len(args) < 4
		eprint("usage: sirius-run --link-lib output.smirl input1.smirl input2.smirl ...")
		return 2
	var inputs = Array[MirLibrary.MirLibraryLoad]()
	for i in 3..len(args)
		let contents = read_text(args[!i]) or ""
		if contents == ""
			eprint("cannot read MIR library: " + args[!i])
			return 2
		let library = MirLibrary.mir_deserialize_library(contents)
		if library.error != ""
			eprint("invalid MIR library: " + library.error)
			return 2
		inputs = inputs.append(library)
	let linked = MirLink.mir_link_libraries(inputs)
	if linked.error != ""
		eprint("cannot link MIR libraries: " + linked.error)
		return 2
	let saved = MirLibrary.mir_serialize_library(linked.program, linked.exports, Array[Mir.MirNamedImport]())
	if saved.error != ""
		eprint("cannot serialize linked MIR library: " + saved.error)
		return 2
	if not write_text(args[!2], saved.text)
		eprint("cannot write linked MIR library")
		return 2
	return 0

# Optional self-contained bundle of transitive generic dependencies.
def run_bundle_generic(args: Array[string]) -> i64
	if len(args) != 5
		eprint("usage: sirius-run --bundle-generic input.smirg output.smirg source-root")
		return 2
	let contents = read_text(args[!2]) or ""
	if contents == ""
		eprint("cannot read generic package")
		return 2
	let bundle = MirBundle.mir_bundle_create(contents, args[!4])
	if bundle.error != ""
		eprint("cannot bundle generic package: " + bundle.error)
		return 2
	if not write_text(args[!3], bundle.text)
		eprint("cannot write generic bundle")
		return 2
	return 0

# Produce or instantiate portable generic declaration packages.
# Imported packages pin their direct dependencies' public typed interfaces.
def run_generic_package(args: Array[string]) -> i64
	if args[!1] == "--emit-generic"
		if len(args) != 5 and len(args) != 6
			eprint("usage: sirius-run --emit-generic module.name output.smirg source.sirius [source-root]")
			return 2
		let source = read_text(args[!4]) or ""
		if source == ""
			eprint("cannot read generic source")
			return 2
		let parsed = Parser.parse_module(source)
		if parsed.state.error != ""
			eprint("generic syntax: " + parsed.state.error)
			return 2
		let declarations = HirDeclarations.hir_module_declarations(parsed.state, parsed.node)
		if declarations.error != ""
			eprint("generic declarations: " + declarations.error)
			return 2
		var dependencies = Array[MirGeneric.MirGenericDependency]()
		if len(declarations.imports) > 0
			if len(args) != 6
				eprint("generic packages with imports require a source root")
				return 2
			let scanned = ModuleBuild.module_build_scan(args[!5], args[!2])
			if scanned.error != ""
				eprint("cannot resolve generic dependencies: " + scanned.error)
				return 2
			for unit in scanned.units
				if unit.name == args[!2]
					if (read_text(Module.module_scan_filename(args[!5], args[!2])) or "") != source
						eprint("generic source does not match module under source root")
						return 2
					dependencies = MirGeneric.mir_generic_dependencies(declarations, scanned.units)
		let saved = MirGeneric.mir_serialize_generic_with_dependencies(args[!2], parsed.state, parsed.node, declarations, dependencies)
		if saved.error != ""
			eprint("cannot create generic package: " + saved.error)
			return 2
		if not write_text(args[!3], saved.text)
			eprint("cannot write generic package")
			return 2
		return 0
	if len(args) < 5
		eprint("usage: sirius-run --specialize-generic input.smirg export output.smirl [argument-types ...]")
		return 2
	let contents = read_text(args[!2]) or ""
	if contents == ""
		eprint("cannot read generic package")
		return 2
	let generic = MirGeneric.mir_deserialize_generic(contents)
	if generic.error != ""
		eprint("invalid generic package: " + generic.error)
		return 2
	var types = Array[string]()
	for i in 5..len(args)
		types = types.append(args[!i])
	let compiled = MirGeneric.mir_generic_specialize(generic, args[!3], types)
	if compiled.error != ""
		eprint("cannot specialize generic: " + compiled.error)
		return 2
	let saved = MirLibrary.mir_serialize_library(compiled.library.program, compiled.library.exports, compiled.library.imports)
	if saved.error != ""
		eprint("cannot serialize specialization: " + saved.error)
		return 2
	if not write_text(args[!4], saved.text)
		eprint("cannot write specialization")
		return 2
	return 0

# Emit native C directly from a fully linked concrete MIR library.
# This bypasses dynamic interpretation when building self-hosted tools.
def run_emit_linked_c(args: Array[string]) -> i64
	if len(args) != 5
		eprint("usage: sirius-run --emit-linked-c input.smirl export-symbol output.c")
		return 2
	let contents = read_text(args[!2]) or ""
	if contents == ""
		eprint("cannot read MIR library")
		return 2
	let library = MirLibrary.mir_deserialize_library(contents)
	if library.error != ""
		eprint("invalid MIR library: " + library.error)
		return 2
	if len(library.imports) != 0
		eprint("cannot emit C from MIR library with unresolved imports")
		return 2
	var entry = -1
	for symbol in library.exports
		if symbol.name == args[!3]
			entry = symbol.function_id
	if entry < 0
		eprint("unknown MIR library export: " + args[!3])
		return 2
	let function = library.program.functions[!entry]
	if function.argument_count != 0 or function.return_type != Types.TYPE_TAG_I64
		eprint("native C entry must be () -> i64")
		return 2
	let emitted = MirEmitC.mir_emit_c_reachable(library.program, entry)
	if emitted.error != ""
		eprint("cannot emit C: " + emitted.error)
		return 2
	if not write_text(args[!4], emitted.code)
		eprint("cannot write C output: " + args[!4])
		return 2
	return 0

def main() -> i64
	let args = arguments()
	if len(args) > 1 and args[!1] == "--bundle-generic"
		return run_bundle_generic(args)
	if len(args) > 1 and args[!1] == "--emit-linked-c"
		return run_emit_linked_c(args)
	if len(args) > 1 and (args[!1] == "--emit-generic" or args[!1] == "--specialize-generic")
		return run_generic_package(args)
	if len(args) > 1 and args[!1] == "--build-modules"
		if len(args) != 5
			eprint("usage: sirius-run --build-modules source-root entry.module output.smirl")
			return 2
		let built = ModuleBuild.module_build(args[!2], args[!3], args[!4])
		if built.error != ""
			eprint("module error: " + built.error)
			return 2
		print("Linked " + args[!4] + " (entry: " + built.entry + ")")
		return 0
	if len(args) > 1 and args[!1] == "--link-lib"
		return run_link_libraries(args)
	var index = 1
	var max_steps = 10000000
	var max_depth = 256
	var emit_path = ""
	var load_path = ""
	var emit_lib_path = ""
	var module_interface = ""
	var load_lib_path = ""
	var list_lib = false
	var export_names = Array[string]()
	var export_symbols = Array[string]()
	var entry_name = ""
	while index < len(args)
		let option = args[!index]
		if option == "--"
			index += 1
			break
		if option == "--load-mir" or option == "--emit-mir" or option == "--load-lib" or option == "--emit-lib" or option == "--list-lib"
			if index + 1 >= len(args)
				eprint("missing value for " + option)
				return 2
			if emit_path != "" or load_path != "" or emit_lib_path != "" or load_lib_path != ""
				eprint("MIR input/output modes are mutually exclusive")
				return 2
			if option == "--emit-mir"
				emit_path = args[!index + 1]
			elif option == "--load-mir"
				load_path = args[!index + 1]
			elif option == "--emit-lib"
				emit_lib_path = args[!index + 1]
			else
				load_lib_path = args[!index + 1]
				list_lib = option == "--list-lib"
			index += 2
			if load_path != "" or load_lib_path != ""
				break
			continue
		if option == "--module-interface"
			if index + 1 >= len(args)
				eprint("--module-interface requires a file path")
				return 2
			module_interface = args[!index + 1]
			index += 2
			continue
		if option == "--export-as"
			if index + 2 >= len(args)
				eprint("--export-as requires a local function and symbol name")
				return 2
			export_names = export_names.append(args[!index + 1])
			export_symbols = export_symbols.append(args[!index + 2])
			index += 3
			continue
		if option == "--export" or option == "--entry"
			if index + 1 >= len(args)
				eprint("missing value for " + option)
				return 2
			if option == "--export"
				export_names = export_names.append(args[!index + 1])
				export_symbols = export_symbols.append(args[!index + 1])
			else
				entry_name = args[!index + 1]
			index += 2
			continue
		if option != "--max-steps" and option != "--max-depth"
			if option.starts_with("--")
				eprint("unknown option: " + option)
				return 2
			break
		if index + 1 >= len(args)
			eprint("missing value for " + option)
			return 2
		let maximum = 1000000000
		let limit = run_positive_limit(args[!index + 1], maximum)
		if limit < 1
			eprint("invalid value for " + option)
			return 2
		if option == "--max-steps"
			max_steps = limit
		else
			max_depth = limit
		index += 2
	if load_path == "" and load_lib_path == "" and index >= len(args)
		eprint("usage: sirius-run [--emit-mir file | --emit-lib file --export NAME ...] input.sirius [args...]")
		eprint("       sirius-run [--load-mir file | --entry NAME --load-lib file | --list-lib file] [args...]")
		return 2
	if (emit_lib_path == "" and len(export_names) != 0) or (emit_lib_path != "" and len(export_names) == 0) or (load_lib_path == "" and entry_name != "")
		eprint("--export requires --emit-lib; --entry requires --load-lib")
		return 2
	var program = Mir.new_mir_program(Array[Mir.MirFunction]())
	var entry_id = -1
	var runtime_args = Array[string]()
	if load_lib_path != ""
		let contents = read_text(load_lib_path) or ""
		if contents == ""
			eprint("cannot read MIR library")
			return 2
		let library = MirLibrary.mir_deserialize_library(contents)
		if library.error != ""
			eprint("invalid MIR library: " + library.error)
			return 2
		if list_lib
			for symbol in library.exports
				print(symbol.name + " : " + MirLibrary.mir_function_signature(library.program, symbol.function_id))
			for symbol in library.imports
				print("import " + symbol.name + " : " + MirLibrary.mir_function_signature(library.program, symbol.function_id))
			return 0
		if len(library.imports) != 0
			eprint("cannot execute MIR library with unresolved imports; link it first")
			return 2
		program = library.program
		for symbol in library.exports
			if (entry_name == "" and entry_id < 0) or symbol.name == entry_name
				entry_id = symbol.function_id
		if entry_id < 0
			eprint("unknown MIR library export: " + entry_name)
			return 2
		runtime_args = [load_lib_path]
		for i in index..len(args)
			runtime_args = runtime_args.append(args[!i])
	elif load_path != ""
		let contents = read_text(load_path) or ""
		if contents == ""
			eprint("cannot read MIR artifact")
			return 2
		let loaded = MirWire.mir_deserialize_program(contents)
		if loaded.error != ""
			eprint("invalid MIR artifact: " + loaded.error)
			return 2
		program = loaded.program
		entry_id = loaded.entry
		runtime_args = [load_path]
		for i in index..len(args)
			runtime_args = runtime_args.append(args[!i])
	else
		var source = read_text(args[!index]) or ""
		if module_interface != ""
			let interface = read_text(module_interface) or ""
			source += "\n" + interface
		let parsed = Parser.parse_module(source)
		if parsed.state.error != ""
			print("ERROR " + str(parsed.state.error_line) + ": " + parsed.state.error)
			return 1
		let declarations = HirDeclarations.hir_module_declarations(parsed.state, parsed.node)
		if declarations.error != ""
			print("ERROR " + str(declarations.error_line) + ": " + declarations.error)
			return 1
		if len(declarations.imports) != 0 and module_interface == ""
			eprint("source imports require --module-interface and library linking")
			return 2
		let resolved = ModuleResolve.hir_resolve_module_calls(parsed.state, declarations)
		if resolved.error != ""
			print("ERROR " + str(resolved.line) + ": " + resolved.error)
			return 1
		var roots = ["main"]
		if emit_lib_path != ""
			roots = export_names
		let lowered = MirProgram.mir_build_program_roots(resolved.tree, declarations, roots, Array[i64]())
		if lowered.error != ""
			print("ERROR 1: " + lowered.error)
			return 1
		program = lowered.program
		entry_id = lowered.entry
		if emit_lib_path == "" and len(lowered.imports) != 0
			eprint("unresolved imports require --emit-lib and linking")
			return 2
		if emit_lib_path != ""
			var public_exports = Array[Mir.MirNamedExport]()
			for i in 0..len(lowered.exports)
				public_exports = public_exports.append(Mir.MirNamedExport(export_symbols[!i], lowered.exports[!i].function_id))
			let saved = MirLibrary.mir_serialize_library(program, public_exports, lowered.imports)
			if saved.error != ""
				eprint("cannot serialize MIR library: " + saved.error)
				return 2
			if not write_text(emit_lib_path, saved.text)
				eprint("cannot write MIR library")
				return 2
			return 0
		runtime_args = [args[!index]]
		for i in index + 1..len(args)
			runtime_args = runtime_args.append(args[!i])
	if entry_id < 0 or entry_id >= len(program.functions)
		eprint("invalid MIR entry")
		return 2
	let entry = program.functions[!entry_id]
	if entry.argument_count != 0 or entry.return_type != Types.TYPE_TAG_I64
		eprint("MIR entry must be main() -> i64")
		return 2
	if emit_path != ""
		let saved = MirWire.mir_serialize_program(program, entry_id)
		if saved.error != ""
			eprint("cannot serialize MIR: " + saved.error)
			return 2
		if not write_text(emit_path, saved.text)
			eprint("cannot write MIR artifact")
			return 2
		return 0
	let outcome = MirInterpreter.mir_execute_with_arguments(program, entry_id, Array[Mir.MirValue](), max_steps, max_depth, runtime_args)
	if outcome.error != ""
		eprint("Sirius panic: " + outcome.error)
		return 1
	return outcome.value.bits
