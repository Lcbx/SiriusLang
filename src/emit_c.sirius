# Minimal stage-1 semantic checker and C11 emitter.
# Concatenate after tokenizer.sirius, parser.sirius and types.sirius until imports exist.
# This deliberately rejects unsupported types and operations instead of emitting unsafe C.

let TYPE_INVALID = 0
let TYPE_I64 = 1
let TYPE_F64 = 2
let TYPE_BOOL = 3
let TYPE_STRING = 4
let TYPE_VOID = 5
let TYPE_ARRAY_I64 = 7
let TYPE_ARRAY_STRING = 8
let TYPE_RECORD_START = 100
let TYPE_ARRAY_RECORD_START = 10000
let TYPE_DICT_START = 1000000
let TYPE_DICT_END = 2000000
let TYPE_OPTIONAL_I64 = 6
let TYPE_OPTIONAL_START = 2000000

def is_optional(kind: i64) -> bool
	return kind == TYPE_OPTIONAL_I64 or (kind >= TYPE_OPTIONAL_START and kind < TYPE_OPTIONAL_START + TYPE_DICT_END)

def optional_value(kind: i64) -> i64
	if kind == TYPE_OPTIONAL_I64
		return TYPE_I64
	if is_optional(kind)
		return kind - TYPE_OPTIONAL_START
	return TYPE_INVALID

def optional_of(kind: i64) -> i64
	if kind == TYPE_I64
		return TYPE_OPTIONAL_I64
	if kind == TYPE_INVALID or kind == TYPE_VOID or is_optional(kind)
		return TYPE_INVALID
	return TYPE_OPTIONAL_START + kind

def optional_helper(kind: i64) -> string
	return "s_optional_" + str(optional_value(kind))

def is_dict(kind: i64) -> bool
	return kind >= TYPE_DICT_START and kind < TYPE_DICT_END

def dict_of(key: i64, value: i64) -> i64
	if (key != TYPE_I64 and key != TYPE_STRING) or value == TYPE_INVALID or value == TYPE_VOID or value == TYPE_OPTIONAL_I64 or value >= 100000
		return TYPE_INVALID
	if key == TYPE_STRING
		return TYPE_DICT_START + 2 * value + 1
	return TYPE_DICT_START + 2 * value

def dict_value(kind: i64) -> i64
	if not is_dict(kind)
		return TYPE_INVALID
	return (kind - TYPE_DICT_START) / 2

def dict_key(kind: i64) -> i64
	if not is_dict(kind)
		return TYPE_INVALID
	if (kind - TYPE_DICT_START) % 2 == 1
		return TYPE_STRING
	return TYPE_I64

def dict_helper(kind: i64) -> string
	return "s_d_" + str(kind)


# The generic C runtime stores an element size and optional retain/drop callbacks.
def array_element(kind: i64) -> i64
	if kind == TYPE_ARRAY_I64
		return TYPE_I64
	if kind == TYPE_ARRAY_STRING
		return TYPE_STRING
	if kind >= TYPE_ARRAY_RECORD_START and kind < TYPE_DICT_START
		return kind - TYPE_ARRAY_RECORD_START
	return TYPE_INVALID

def array_of(kind: i64) -> i64
	if kind == TYPE_I64
		return TYPE_ARRAY_I64
	if kind == TYPE_STRING
		return TYPE_ARRAY_STRING
	if kind >= TYPE_RECORD_START and kind < TYPE_ARRAY_RECORD_START
		return TYPE_ARRAY_RECORD_START + kind
	if kind == TYPE_ARRAY_I64 or kind == TYPE_ARRAY_STRING or (kind >= TYPE_ARRAY_RECORD_START and kind < TYPE_DICT_START)
		return TYPE_ARRAY_RECORD_START + kind
	return TYPE_INVALID

def managed(kind: i64) -> bool
	return kind == TYPE_STRING or is_dict(kind) or array_element(kind) != TYPE_INVALID or (kind >= TYPE_RECORD_START and kind < TYPE_ARRAY_RECORD_START) or (is_optional(kind) and managed(optional_value(kind)))

def generic_array(kind: i64) -> bool
	return kind == TYPE_ARRAY_STRING or (kind >= TYPE_ARRAY_RECORD_START and kind < TYPE_DICT_START)

def array_helper(kind: i64) -> string
	return "s_ga_" + str(kind)



rec ParameterInfo(name: string, kind: i64)

rec FunctionInfo(name: string, kind: i64, params: Array[ParameterInfo], body: i64, constructor: bool, symbol: string)

rec InstanceInfo(kinds: Array[i64], kind: i64, symbol: string, code: string)

rec ConstantInfo(name: string, value: string)

rec RecordInfo(fields: Array[RecordField], canonical: i64)

rec EmitState(tree: ParseState)
	pub functions = Array[FunctionInfo]()
	pub instances = Array[InstanceInfo]()
	pub specializations = new_hir_specializations()
	pub active_params = Array[ParameterInfo]()
	pub symbols = Array[SymbolInfo]()
	pub constants = Array[ConstantInfo]()
	pub records = Array[RecordInfo]()
	pub types = new_type_table()
	pub hir = Array[HirNode]()
	pub dict_kinds = Array[i64]()
	pub lines = Array[string]()
	pub indentation = 0
	pub loop_depth = 0
	pub loop_scope = 0
	pub scope_depth = 0
	pub return_kind = TYPE_INVALID
	pub function_name = ""
	pub counter = 0
	pub error = ""
	pub error_line = 0

rec ExprCode(state: EmitState, text: string, kind: i64)


def ast_node(tree: ParseState, id: i64) -> Node
	return tree.nodes[!id]

def ast_child(tree: ParseState, id: i64, offset: i64) -> i64
	let entry = ast_node(tree, id)
	return tree.edges[!entry.first + offset]

def ast_text(tree: ParseState, id: i64) -> string
	return token_text(tree.source, tree.tokens[!ast_node(tree, id).token])

def ast_line(tree: ParseState, id: i64) -> i64
	return tree.tokens[!ast_node(tree, id).token].line

def emit_error(state: EmitState, id: i64, message: string) -> EmitState
	var result = state
	if result.error == ""
		result.error = message
		result.error_line = ast_line(result.tree, id)
	return result

def type_name(kind: i64) -> string
	if kind == TYPE_I64
		return "i64"
	if kind == TYPE_F64
		return "f64"
	if kind == TYPE_BOOL
		return "bool"
	if kind == TYPE_STRING
		return "string"
	if kind == TYPE_VOID
		return "void"
	if is_optional(kind)
		return "Optional[" + type_name(optional_value(kind)) + "]"
	if is_dict(kind)
		return "Dict[" + type_name(dict_key(kind)) + "," + type_name(dict_value(kind)) + "]"
	if kind == TYPE_ARRAY_I64
		return "Array[i64]"
	if kind == TYPE_ARRAY_STRING
		return "Array[string]"
	if kind >= TYPE_ARRAY_RECORD_START
		return "Array[record]"
	if kind >= TYPE_RECORD_START
		return "record"
	return "unknown"

def c_type(kind: i64) -> string
	if kind == TYPE_I64
		return "int64_t"
	if kind == TYPE_F64
		return "double"
	if kind == TYPE_BOOL
		return "bool"
	if kind == TYPE_STRING
		return "S_String *"
	if kind == TYPE_VOID
		return "void"
	if kind == TYPE_OPTIONAL_I64
		return "S_Optional_i64"
	if is_optional(kind) and optional_value(kind) == TYPE_STRING
		return "S_Optional_string"
	if is_optional(kind)
		return optional_helper(kind)
	if is_dict(kind)
		return "S_Dict *"
	if kind == TYPE_ARRAY_I64
		return "S_Array_i64 *"
	if generic_array(kind)
		return "S_Array *"
	if kind >= TYPE_RECORD_START
		return "s_record_" + str(kind)
	return "INVALID_TYPE"

def ast_type(tree: ParseState, id: i64) -> i64
	let entry = ast_node(tree, id)
	if entry.kind != NODE_TYPE
		return TYPE_INVALID
	let name = ast_text(tree, id)
	if name == "Dict" and entry.count == 2
		return dict_of(ast_type(tree, ast_child(tree, id, 0)), ast_type(tree, ast_child(tree, id, 1)))
	if name == "Array" and (entry.count == 1 or entry.count == 2)
		if entry.count == 2 and ast_text(tree, ast_child(tree, id, 1)) != "1"
			return TYPE_INVALID
		return array_of(ast_type(tree, ast_child(tree, id, 0)))
	if entry.count != 0
		return TYPE_INVALID
	if name == "i64"
		return TYPE_I64
	if name == "f64"
		return TYPE_F64
	if name == "bool"
		return TYPE_BOOL
	if name == "string"
		return TYPE_STRING
	return TYPE_INVALID

# Resolve constructor-produced record types in annotations after their definitions.
def resolve_type(state: EmitState, id: i64) -> i64
	let entry = ast_node(state.tree, id)
	if entry.kind != NODE_TYPE
		return TYPE_INVALID
	if ast_text(state.tree, id) == "Dict" and entry.count == 2
		return dict_of(resolve_type(state, ast_child(state.tree, id, 0)), resolve_type(state, ast_child(state.tree, id, 1)))
	if ast_text(state.tree, id) == "Array" and (entry.count == 1 or entry.count == 2)
		if entry.count == 2 and ast_text(state.tree, ast_child(state.tree, id, 1)) != "1"
			return TYPE_INVALID
		return array_of(resolve_type(state, ast_child(state.tree, id, 0)))
	let primitive = ast_type(state.tree, id)
	if primitive != TYPE_INVALID
		return primitive
	if entry.count == 0
		let index = find_function(state, ast_text(state.tree, id))
		if index >= 0 and state.functions[!index].constructor
			return state.functions[!index].kind
	return TYPE_INVALID

# Array[T]() is syntax for an empty array whose element type is T.
def array_constructor_kind(state: EmitState, id: i64) -> i64
	let index = ast_node(state.tree, id)
	if index.kind != NODE_INDEX or index.count != 2
		return TYPE_INVALID
	let root = ast_child(state.tree, id, 0)
	if ast_node(state.tree, root).kind != NODE_NAME or ast_text(state.tree, root) != "Array"
		return TYPE_INVALID
	let type_id = ast_child(state.tree, id, 1)
	if ast_node(state.tree, type_id).kind == NODE_INDEX
		return array_of(array_constructor_kind(state, type_id))
	if ast_node(state.tree, type_id).kind != NODE_NAME
		return TYPE_INVALID
	let name = ast_text(state.tree, type_id)
	if name == "string"
		return TYPE_ARRAY_STRING
	if name == "i64"
		return TYPE_ARRAY_I64
	let function = find_function(state, name)
	if function >= 0 and state.functions[!function].constructor
		return array_of(state.functions[!function].kind)
	return TYPE_INVALID

def dict_constructor_kind(state: EmitState, id: i64) -> i64
	let node = ast_node(state.tree, id)
	if node.kind != NODE_INDEX or node.count != 3
		return TYPE_INVALID
	let root = ast_child(state.tree, id, 0)
	if ast_node(state.tree, root).kind != NODE_NAME or ast_text(state.tree, root) != "Dict"
		return TYPE_INVALID
	let key = ast_text(state.tree, ast_child(state.tree, id, 1))
	let value_id = ast_child(state.tree, id, 2)
	let value = ast_text(state.tree, value_id)
	var key_kind = TYPE_INVALID
	var value_kind = TYPE_INVALID
	if key == "i64"
		key_kind = TYPE_I64
	if key == "string"
		key_kind = TYPE_STRING
	if value == "i64"
		value_kind = TYPE_I64
	if value == "string"
		value_kind = TYPE_STRING
	if ast_node(state.tree, value_id).kind == NODE_INDEX
		value_kind = array_constructor_kind(state, value_id)
	let function = find_function(state, value)
	if function >= 0 and state.functions[!function].constructor
		value_kind = state.functions[!function].kind
	return dict_of(key_kind, value_kind)

def register_dict(state: EmitState, kind: i64) -> EmitState
	var next = state
	for existing in next.dict_kinds
		if existing == kind
			return next
	next.dict_kinds = next.dict_kinds.append(kind)
	return next

def line(state: EmitState, text: string) -> EmitState
	var result = state
	var prefix = ""
	for i in 0..state.indentation
		prefix = prefix + "\t"
	result.lines = result.lines.append(prefix + text)
	return result

def find_symbol(state: EmitState, name: string) -> i64
	return resolve_hir_name(state.symbols, name).field_index

def find_function(state: EmitState, name: string) -> i64
	for i in 0..len(state.functions)
		if state.functions[!i].name == name
			return i
	return -1

def is_generic(info: FunctionInfo) -> bool
	if info.kind == TYPE_INVALID
		return true
	for param in info.params
		if param.kind == TYPE_INVALID
			return true
	return false

def find_constant(state: EmitState, name: string) -> string
	for item in state.constants
		if item.name == name
			return item.value
	return ""

# Record types are structural: intern fields by canonical name/type order.
# Retain legacy C kind IDs until the remaining emitter is migrated.
def record_field_index(state: EmitState, kind: i64, name: string) -> i64
	if kind < TYPE_RECORD_START or kind >= TYPE_ARRAY_RECORD_START or kind - TYPE_RECORD_START >= len(state.records)
		return -1
	let canonical = state.records[!kind - TYPE_RECORD_START].canonical
	let fields = state.types.entries[!canonical].fields
	for i in 0..len(fields)
		if fields[!i].name == name
			return i
	return -1


# Translate legacy C-emitter kinds into canonical TypeIds. This boundary is
# temporary: the remaining emitter will move to canonical IDs in later patches.
def canonical_kind(table: TypeTable, records: Array[RecordInfo], kind: i64) -> InternedType
	if kind >= TYPE_I64 and kind <= TYPE_VOID
		return InternedType(table, kind)
	if kind >= TYPE_RECORD_START and kind < TYPE_ARRAY_RECORD_START
		let index = kind - TYPE_RECORD_START
		if index < len(records)
			return InternedType(table, records[!index].canonical)
		return InternedType(table, TYPE_INVALID)
	if is_optional(kind)
		let payload = canonical_kind(table, records, optional_value(kind))
		return intern_optional_type(payload.table, payload.id)
	if is_dict(kind)
		let key = canonical_kind(table, records, dict_key(kind))
		let value = canonical_kind(key.table, records, dict_value(kind))
		return intern_dict_type(value.table, key.id, value.id)
	let element = array_element(kind)
	if element != TYPE_INVALID
		let inner = canonical_kind(table, records, element)
		return intern_array_type(inner.table, inner.id)
	return InternedType(table, TYPE_INVALID)

rec InternedSignature(table: TypeTable, ids: Array[i64])

# Resolve the entire signature against one table, including container/record
# types encountered for the first time at a generic call.
def canonical_signature(state: EmitState, kinds: Array[i64]) -> InternedSignature
	var table = state.types
	var ids = Array[i64]()
	for kind in kinds
		let entry = canonical_kind(table, state.records, kind)
		table = entry.table
		ids = ids.append(entry.id)
	return InternedSignature(table, ids)

def intern_record(state: EmitState, fields: Array[RecordField]) -> ExprCode
	let ordered = ordered_fields(fields)
	var next = state
	var canonical_fields = Array[RecordField]()
	for field in ordered
		let lookup = canonical_kind(next.types, next.records, field.kind)
		if lookup.id == TYPE_INVALID
			return ExprCode(next, "", TYPE_INVALID)
		next.types = lookup.table
		canonical_fields = canonical_fields.append(RecordField(field.name, lookup.id))
	let entry = intern_record_type(next.types, canonical_fields)
	next.types = entry.table
	for i in 0..len(next.records)
		if next.records[!i].canonical == entry.id
			return ExprCode(next, "", TYPE_RECORD_START + i)
	let kind = TYPE_RECORD_START + len(next.records)
	next.records = next.records.append(RecordInfo(ordered, entry.id))
	return ExprCode(next, "", kind)

# C ABI metadata is derived from an interned semantic descriptor. Legacy kinds
# only select the temporary C symbol names; they do not decide the type's shape
# or ownership operations. This bridge can disappear once every user of c_type
# accepts a TypeId directly.
rec CTypeABI(type_id: i64, c_name: string, copy: string, drop: string)

def c_abi(state: EmitState, kind: i64) -> CTypeABI
	let interned = canonical_kind(state.types, state.records, kind)
	let id = interned.id
	if id == TYPE_INVALID
		return CTypeABI(id, "INVALID_TYPE", "", "")
	let descriptor = interned.table.entries[!id]
	let name = c_type(kind)
	if descriptor.tag == TYPE_TAG_STRING
		return CTypeABI(id, name, "s_string_retain", "s_string_release")
	if descriptor.tag == TYPE_TAG_RECORD
		return CTypeABI(id, name, name + "_copy", name + "_drop")
	if descriptor.tag == TYPE_TAG_ARRAY
		if descriptor.first == TYPE_TAG_I64
			return CTypeABI(id, name, "s_array_i64_retain", "s_array_i64_release")
		return CTypeABI(id, name, "s_array_retain", "s_array_release")
	if descriptor.tag == TYPE_TAG_DICT
		return CTypeABI(id, name, "s_dict_retain", "s_dict_release")
	if descriptor.tag == TYPE_TAG_OPTIONAL
		let payload = interned.table.entries[!descriptor.first]
		if payload.tag == TYPE_TAG_STRING or payload.tag == TYPE_TAG_RECORD or payload.tag == TYPE_TAG_ARRAY or payload.tag == TYPE_TAG_DICT or payload.tag == TYPE_TAG_OPTIONAL
			let helper = optional_helper(kind)
			return CTypeABI(id, name, helper + "_copy", helper + "_drop")
	return CTypeABI(id, name, "", "")

# Legacy wrappers remain for expression lowering until typed HIR replaces kinds.
def retain_function(kind: i64) -> string
	if kind == TYPE_STRING
		return "s_string_retain"
	if kind == TYPE_ARRAY_I64
		return "s_array_i64_retain"
	if generic_array(kind)
		return "s_array_retain"
	if is_dict(kind)
		return "s_dict_retain"
	if is_optional(kind) and managed(optional_value(kind))
		return optional_helper(kind) + "_copy"
	if kind >= TYPE_RECORD_START and kind < TYPE_ARRAY_RECORD_START
		return c_type(kind) + "_copy"
	return ""

def release_function(kind: i64) -> string
	if kind == TYPE_STRING
		return "s_string_release"
	if kind == TYPE_ARRAY_I64
		return "s_array_i64_release"
	if generic_array(kind)
		return "s_array_release"
	if is_dict(kind)
		return "s_dict_release"
	if is_optional(kind) and managed(optional_value(kind))
		return optional_helper(kind) + "_drop"
	if kind >= TYPE_RECORD_START and kind < TYPE_ARRAY_RECORD_START
		return c_type(kind) + "_drop"
	return ""

# A canonical descriptor supplies field identities. Legacy field kinds are
# looked up at the same sorted positions only for their current C ABI names.
rec CFieldABI(name: string, type_id: i64, abi: CTypeABI)

def record_c_fields(state: EmitState, record_index: i64) -> Array[CFieldABI]
	let record = state.records[!record_index]
	let canonical = state.types.entries[!record.canonical].fields
	var result = Array[CFieldABI]()
	for i in 0..len(canonical)
		let field = canonical[!i]
		let legacy = record.fields[!i]
		result = result.append(CFieldABI(field.name, field.kind, c_abi(state, legacy.kind)))
	return result

def record_copy(kind: i64, expr: string) -> string
	let function = retain_function(kind)
	if function == ""
		return expr
	return function + "(" + expr + ")"

def record_drop(kind: i64, expr: string) -> string
	let function = release_function(kind)
	if function == ""
		return ""
	return function + "(" + expr + ");"

# Keep constructors of plain nested records available while managed publication
# awaits explicit ownership transfer and parameter cleanup.
def plain_record(state: EmitState, kind: i64) -> bool
	if kind < TYPE_RECORD_START or kind >= TYPE_ARRAY_RECORD_START
		return not managed(kind)
	for field in state.records[!kind - TYPE_RECORD_START].fields
		if not plain_record(state, field.kind)
			return false
	return true

def record_declarations(state: EmitState) -> string
	var result = ""
	for i in 0..len(state.records)
		let kind = TYPE_RECORD_START + i
		let type = c_abi(state, kind).c_name
		let fields = record_c_fields(state, i)
		result = result + "typedef struct {\n"
		for field in fields
			result = result + "\t" + field.abi.c_name + " " + field.name + ";\n"
		result = result + "} " + type + ";\n"
		result = result + "static inline " + type + " " + type + "_copy(" + type + " value) {\n"
		for field in fields
			if field.abi.copy != ""
				result = result + "\tvalue." + field.name + " = " + field.abi.copy + "(value." + field.name + ");\n"
		result = result + "\treturn value;\n}\n"
		result = result + "static inline void " + type + "_drop(" + type + " value) {\n"
		for field in fields
			if field.abi.drop != ""
				result = result + "\t" + field.abi.drop + "(value." + field.name + ");\n"
		result = result + "\t(void)value;\n}\n"
		for field in fields
			result = result + "static inline " + field.abi.c_name + " " + type + "_get_" + field.name + "_take(" + type + " owned) {\n"
			var copied = "owned." + field.name
			if field.abi.copy != ""
				copied = field.abi.copy + "(" + copied + ")"
			result = result + "\t" + field.abi.c_name + " field = " + copied + ";\n"
			result = result + "\t" + type + "_drop(owned);\n\treturn field;\n}\n"
	return result

# An Optional owns its payload when present. Dict.get copies the payload before
# releasing the dictionary, so the caller receives an independently owned value.
def optional_declarations(state: EmitState) -> string
	var output = ""
	var seen = Array[i64]()
	var values = Array[i64]()
	values = values.append(TYPE_STRING)
	for element in generic_array_element_types(state)
		values = values.append(element)
	for dict_kind in state.dict_kinds
		values = values.append(dict_value(dict_kind))
	for value in values
		if value == TYPE_I64
			continue
		var duplicate = false
		for previous in seen
			if previous == value
				duplicate = true
		if duplicate
			continue
		seen = seen.append(value)
		let kind = optional_of(value)
		let name = optional_helper(kind)
		if value == TYPE_STRING
			output = output + "typedef S_Optional_string " + name + ";\n"
		else
			output = output + "typedef struct { bool has_value; " + c_type(value) + " value; } " + name + ";\n"
		let abi = c_abi(state, value)
		if abi.copy != ""
			output = output + "static inline " + name + " " + name + "_copy(" + name + " owned) {\n"
			output = output + "\tif (owned.has_value) owned.value = " + record_copy(value, "owned.value") + ";\n\treturn owned;\n}\n"
			output = output + "static inline void " + name + "_drop(" + name + " owned) {\n"
			output = output + "\tif (owned.has_value) " + record_drop(value, "owned.value") + "\n}\n"
	return output

# Generic array helper functions are emitted after canonical record declarations.
# Array operations consume an owned array and, where applicable, an owned element.
def generic_array_element_types(state: EmitState) -> Array[i64]
	var elements = Array[i64]()
	elements = elements.append(TYPE_STRING)
	for i in 0..len(state.records)
		elements = elements.append(TYPE_RECORD_START + i)
	var frontier = Array[i64]()
	frontier = frontier.append(TYPE_ARRAY_I64)
	frontier = frontier.append(TYPE_ARRAY_STRING)
	for i in 0..len(state.records)
		frontier = frontier.append(array_of(TYPE_RECORD_START + i))
	for depth in 0..2
		var next_frontier = Array[i64]()
		for item in frontier
			elements = elements.append(item)
			next_frontier = next_frontier.append(array_of(item))
		frontier = next_frontier
	return elements

def generic_array_declarations(state: EmitState) -> string
	var output = ""
	let elements = generic_array_element_types(state)
	output = output + "static inline S_Optional_i64 s_array_i64_get_optional_take(S_Array_i64 *owned, int64_t index) {\n"
	output = output + "\tS_Optional_i64 result = s_array_i64_get(owned, index);\n\ts_array_i64_release(owned);\n\treturn result;\n}\n"
	for element in elements
		let kind = array_of(element)
		let abi = c_abi(state, element)
		let type = abi.c_name
		let prefix = array_helper(kind)
		var copy = "NULL"
		var drop = "NULL"
		if abi.copy != ""
			output = output + "static inline void " + prefix + "_copy(void *dst, const void *src) { *(" + type + " *)dst = " + record_copy(element, "*(" + type + " const *)src") + "; }\n"
			output = output + "static inline void " + prefix + "_drop(void *value) { " + record_drop(element, "*(" + type + " *)value") + " }\n"
			copy = prefix + "_copy"
			drop = prefix + "_drop"
		# Dictionaries also use the generated callbacks, even for plain records.
		# Only arrays can bypass trivial callbacks and clone through memcpy.
		var array_copy = copy
		var array_drop = drop
		if plain_record(state, element)
			array_copy = "NULL"
			array_drop = "NULL"
		output = output + "static inline S_Array *" + prefix + "_make_take(size_t count, " + type + " *items) {\n"
		output = output + "\tS_Array *result = s_array_make(count, items, sizeof(" + type + "), " + array_copy + ", " + array_drop + ");\n"
		if abi.copy != ""
			output = output + "\tfor (size_t i = 0; i < count; ++i) " + record_drop(element, "items[i]") + "\n"
		output = output + "\treturn result;\n}\n"
		output = output + "static inline S_Array *" + prefix + "_append_take(S_Array *owned, " + type + " item) {\n"
		output = output + "\tS_Array *result = s_array_append(owned, &item);\n"
		if abi.copy != ""
			output = output + "\t" + record_drop(element, "item") + "\n"
		output = output + "\treturn result;\n}\n"
		output = output + "static inline " + type + " " + prefix + "_get_checked_take(S_Array *owned, int64_t index) {\n"
		output = output + "\t" + type + " const *p = (" + type + " const *)s_array_at(owned, index);\n"
		output = output + "\tif (!p) s_panic(\"index out of bounds\");\n"
		output = output + "\t" + type + " value = " + record_copy(element, "*p") + ";\n"
		output = output + "\ts_array_release(owned);\n\treturn value;\n}\n"
		output = output + "static inline " + c_type(optional_of(element)) + " " + prefix + "_get_optional_take(S_Array *owned, int64_t index) {\n"
		output = output + "\t" + c_type(optional_of(element)) + " result = {0};\n"
		output = output + "\t" + type + " const *p = (" + type + " const *)s_array_at(owned, index);\n"
		output = output + "\tif (p) { result.has_value = true; result.value = " + record_copy(element, "*p") + "; }\n"
		output = output + "\ts_array_release(owned);\n\treturn result;\n}\n"
		output = output + "static inline " + type + " " + prefix + "_get_borrow(const S_Array *array, int64_t index) {\n"
		output = output + "\t" + type + " const *p = (" + type + " const *)s_array_at(array, index);\n"
		output = output + "\tif (!p) s_panic(\"index out of bounds\");\n"
		output = output + "\treturn " + record_copy(element, "*p") + ";\n}\n"
		output = output + "static inline void " + prefix + "_set_take(S_Array **owned, int64_t index, " + type + " item) {\n"
		output = output + "\ts_array_set(owned, index, &item);\n"
		if abi.copy != ""
			output = output + "\t" + record_drop(element, "item") + "\n"
		output = output + "}\n"
	output = output + "static inline int64_t s_generic_array_length_take(S_Array *owned) { int64_t n = (int64_t)s_array_length(owned); s_array_release(owned); return n; }\n"
	return output

# Dictionaries take owned keys and values, just like the array helpers.
def dict_declarations(state: EmitState) -> string
	var output = ""
	for kind in state.dict_kinds
		let key = dict_key(kind)
		let value = dict_value(kind)
		let prefix = dict_helper(kind)
		let key_abi = c_abi(state, key)
		let value_abi = c_abi(state, value)
		let key_type = key_abi.c_name
		let val_type = value_abi.c_name
		var key_copy = "NULL"
		var key_drop = "NULL"
		var val_copy = "NULL"
		var val_drop = "NULL"
		var hash = "s_hash_i64_key"
		var eq = "s_eq_i64_key"
		if key == TYPE_STRING
			key_copy = array_helper(TYPE_ARRAY_STRING) + "_copy"
			key_drop = array_helper(TYPE_ARRAY_STRING) + "_drop"
			hash = "s_hash_string_key"
			eq = "s_eq_string_key"
		if value_abi.copy != ""
			val_copy = array_helper(array_of(value)) + "_copy"
			val_drop = array_helper(array_of(value)) + "_drop"
		output = output + "static inline S_Dict *" + prefix + "_make(void) { return s_dict_new(sizeof(" + key_type + "), sizeof(" + val_type + "), " + key_copy + ", " + key_drop + ", " + val_copy + ", " + val_drop + ", " + hash + ", " + eq + "); }\n"
		output = output + "static inline S_Dict *" + prefix + "_insert_take(S_Dict *owned, " + key_type + " key, " + val_type + " value) {\n"
		output = output + "\tS_Dict *result = s_dict_insert(owned, &key, &value);\n"
		if key_abi.copy != ""
			output = output + "\t" + record_drop(key, "key") + "\n"
		if value_abi.copy != ""
			output = output + "\t" + record_drop(value, "value") + "\n"
		output = output + "\treturn result;\n}\n"
		let option_type = c_type(optional_of(value))
		output = output + "static inline " + option_type + " " + prefix + "_get_take(S_Dict *owned, " + key_type + " key) {\n"
		output = output + "\t" + val_type + " const *item = (" + val_type + " const *)s_dict_get(owned, &key);\n"
		output = output + "\t" + option_type + " result = {0};\n"
		output = output + "\tif (item) { result.has_value = true; result.value = " + record_copy(value, "*item") + "; }\n"
		output = output + "\ts_dict_release(owned);\n"
		if key_abi.copy != ""
			output = output + "\t" + record_drop(key, "key") + "\n"
		output = output + "\treturn result;\n}\n"
	output = output + "static inline int64_t s_dict_length_take(S_Dict *owned) { int64_t n = (int64_t)s_dict_length(owned); s_dict_release(owned); return n; }\n"
	return output

def append_symbol(state: EmitState, id: i64, name: string, kind: i64, mutable: bool) -> EmitState
	var result = state
	if kind == TYPE_INVALID or kind == TYPE_VOID
		return emit_error(result, id, "unsupported binding type")
	let canonical = canonical_kind(result.types, result.records, kind)
	if canonical.id == TYPE_INVALID
		return emit_error(result, id, "unsupported binding type")
	result.types = canonical.table
	result.symbols = result.symbols.append(SymbolInfo(name, kind, canonical.id, mutable, result.scope_depth))
	return result

def check_type(state: EmitState, id: i64, found: i64, expected: i64) -> EmitState
	if found == expected and found != TYPE_INVALID
		return state
	let left = canonical_kind(state.types, state.records, found)
	let right = canonical_kind(left.table, state.records, expected)
	var next = state
	next.types = right.table
	if hir_types_equal(left.id, right.id)
		return next
	return emit_error(next, id, "expected " + type_name(expected) + ", found " + type_name(found))

# C does not sequence ordinary binary operands or function arguments.
# Reject pairs of potentially effectful calls until MIR handles ordered temporaries.
def has_effect(state: EmitState, id: i64, visited: Array[string]) -> bool
	let entry = ast_node(state.tree, id)
	if entry.kind == NODE_WHILE or entry.kind == NODE_FOR or entry.kind == NODE_RECUR
		return true
	if entry.kind == NODE_BINARY and (ast_text(state.tree, id) == "/" or ast_text(state.tree, id) == "%")
		return true
	if entry.kind == NODE_CALL
		let callee = ast_child(state.tree, id, 0)
		if ast_node(state.tree, callee).kind != NODE_NAME
			return true
		let name = ast_text(state.tree, callee)
		if name == "print" or name == "eprint"
			return true
		if name == "sqrt"
			return false
		let index = find_function(state, name)
		if index < 0
			return true
		var seen = false
		for value in visited
			if value == name
				seen = true
		if not seen
			let info = state.functions[!index]
			if has_effect(state, info.body, visited.append(name))
				return true
	for i in 0..entry.count
		if has_effect(state, ast_child(state.tree, id, i), visited)
			return true
	return false

def uses_optional_fallback(state: EmitState, id: i64) -> bool
	let entry = ast_node(state.tree, id)
	if entry.kind == NODE_BINARY and ast_text(state.tree, id) == "or"
		let left = ast_child(state.tree, id, 0)
		let leaf = ast_node(state.tree, left)
		if leaf.kind == NODE_NAME
			let index = find_symbol(state, ast_text(state.tree, left))
			if index >= 0 and is_optional(state.symbols[!index].kind)
				return true
		if leaf.kind == NODE_CALL
			let call = ast_child(state.tree, left, 0)
			if ast_node(state.tree, call).kind == NODE_ATTR and ast_text(state.tree, call) == "get"
				return true
	for i in 0..entry.count
		if uses_optional_fallback(state, ast_child(state.tree, id, i))
			return true
	return false

def ambiguous_order(state: EmitState, a: i64, b: i64) -> bool
	return has_effect(state, a, Array[string]()) and has_effect(state, b, Array[string]())

# HIR owns specialization identity and lifecycle. The emitter stores only C
# representations of each HIR registry entry (at the same index for now).
def specialize_call(state: EmitState, id: i64, info: FunctionInfo, kinds: Array[i64], arguments: Array[string]) -> ExprCode
	let signature = canonical_signature(state, kinds)
	var next = state
	let declared = canonical_kind(signature.table, next.records, info.kind)
	next.types = declared.table
	let started = hir_begin_specialization(next.specializations, info.body, signature.ids, declared.id)
	next.specializations = started.registry
	if not started.created
		let instance = next.instances[!started.index]
		if instance.kind == TYPE_INVALID
			return ExprCode(emit_error(next, id, "recursive generic call requires an explicit return type"), "", TYPE_INVALID)
		return ExprCode(next, instance.symbol + "(" + ", ".join(arguments) + ")", instance.kind)
	let index = started.index
	let symbol = "s_" + info.name + "__" + str(index)
	var params = Array[ParameterInfo]()
	for i in 0..len(kinds)
		params = params.append(ParameterInfo(info.params[!i].name, kinds[!i]))
	next.instances = next.instances.append(InstanceInfo(kinds, info.kind, symbol, ""))
	let previous_lines = next.lines
	let previous_symbols = next.symbols
	let previous_indent = next.indentation
	let previous_loop = next.loop_depth
	let previous_loop_scope = next.loop_scope
	let previous_scope = next.scope_depth
	let previous_return = next.return_kind
	let previous_name = next.function_name
	let previous_params = next.active_params
	next.lines = Array[string]()
	next.indentation = 0
	next.loop_depth = 0
	next.loop_scope = 0
	next.scope_depth = 0
	next = emit_function(next, FunctionInfo(info.name, info.kind, params, info.body, false, symbol))
	var body = ""
	for row in next.lines
		body = body + row + "\n"
	let result = next.return_kind
	if next.error == ""
		let resolved = canonical_kind(next.types, next.records, result)
		next.types = resolved.table
		next.specializations = hir_complete_specialization(next.specializations, index, resolved.id)
		next.instances[!index] = InstanceInfo(kinds, result, symbol, body)
	next.lines = previous_lines
	next.symbols = previous_symbols
	next.indentation = previous_indent
	next.loop_depth = previous_loop
	next.loop_scope = previous_loop_scope
	next.return_kind = previous_return
	next.scope_depth = previous_scope
	next.function_name = previous_name
	next.active_params = previous_params
	if next.error != ""
		return ExprCode(next, "", TYPE_INVALID)
	return ExprCode(next, symbol + "(" + ", ".join(arguments) + ")", result)

# Attach a resolved call to HIR before choosing any C runtime lowering.
def check_hir_call(state: EmitState, id: i64, result: HirCallCheck) -> EmitState
	var next = state
	next.types = result.table
	if result.error != ""
		return emit_error(next, id, result.error)
	if result.type_id != TYPE_TAG_INVALID
		next.hir = next.hir.append(HirNode(id, HIR_CALL, result.type_id, -1))
	return next

def call_type_ids(state: EmitState, kinds: Array[i64]) -> InternedSignature
	return canonical_signature(state, kinds)

def emit_expr(state: EmitState, id: i64) -> ExprCode
	if state.error != ""
		return ExprCode(state, "", TYPE_INVALID)
	let entry = ast_node(state.tree, id)
	let value = ast_text(state.tree, id)
	let literal = resolve_hir_literal(entry.kind)
	if literal != TYPE_TAG_INVALID
		var next = state
		next.hir = next.hir.append(HirNode(id, HIR_LITERAL, literal, -1))
		if literal == TYPE_TAG_STRING
			return ExprCode(next, "s_string_from_bytes(" + value + ", sizeof(" + value + ") - 1)", TYPE_STRING)
		return ExprCode(next, value, literal)
	if entry.kind == NODE_ARRAY
		if entry.count == 0
			return ExprCode(state, "s_array_i64_make(0, NULL)", TYPE_ARRAY_I64)
		var next = state
		var items = Array[string]()
		var effects = 0
		var element_kind = TYPE_INVALID
		for i in 0..entry.count
			if has_effect(next, ast_child(state.tree, id, i), Array[string]())
				effects += 1
			let element = emit_expr(next, ast_child(state.tree, id, i))
			next = element.state
			if i == 0
				element_kind = element.kind
			else
				next = check_type(next, id, element.kind, element_kind)
			items = items.append(element.text)
		if effects > 1
			return ExprCode(emit_error(next, id, "array initializer requires ordered evaluation"), "", TYPE_INVALID)
		let kind = array_of(element_kind)
		if kind == TYPE_INVALID
			return ExprCode(check_type(next, id, element_kind, TYPE_I64), "", TYPE_INVALID)
		if kind == TYPE_ARRAY_I64
			return ExprCode(next, "s_array_i64_make(" + str(entry.count) + ", (int64_t[]){" + ", ".join(items) + "})", kind)
		return ExprCode(next, array_helper(kind) + "_make_take(" + str(entry.count) + ", (" + c_type(element_kind) + "[]){" + ", ".join(items) + "})", kind)
	if entry.kind == NODE_CHECKED_INDEX
		if entry.count != 2
			return ExprCode(emit_error(state, id, "only rank-1 indexing is supported"), "", TYPE_INVALID)
		let array = emit_expr(state, ast_child(state.tree, id, 0))
		let index = emit_expr(array.state, ast_child(state.tree, id, 1))
		var next = index.state
		let element = array_element(array.kind)
		if element == TYPE_INVALID
			return ExprCode(emit_error(next, id, "checked indexing requires an array"), "", TYPE_INVALID)
		next = check_type(next, id, index.kind, TYPE_I64)
		if array.kind == TYPE_ARRAY_I64
			return ExprCode(next, "s_array_i64_get_checked_take(" + array.text + ", " + index.text + ")", TYPE_I64)
		return ExprCode(next, array_helper(array.kind) + "_get_checked_take(" + array.text + ", " + index.text + ")", element)
	if entry.kind == NODE_OPTIONAL_INDEX
		if entry.count != 2
			return ExprCode(emit_error(state, id, "only rank-1 indexing is supported"), "", TYPE_INVALID)
		let array = emit_expr(state, ast_child(state.tree, id, 0))
		let index = emit_expr(array.state, ast_child(state.tree, id, 1))
		var next = index.state
		let element = array_element(array.kind)
		if element == TYPE_INVALID
			return ExprCode(emit_error(next, id, "optional indexing requires an array"), "", TYPE_INVALID)
		next = check_type(next, id, index.kind, TYPE_I64)
		if array.kind == TYPE_ARRAY_I64
			return ExprCode(next, "s_array_i64_get_optional_take(" + array.text + ", " + index.text + ")", TYPE_OPTIONAL_I64)
		return ExprCode(next, array_helper(array.kind) + "_get_optional_take(" + array.text + ", " + index.text + ")", optional_of(element))
	if entry.kind == NODE_UNWRAP
		let unboxed = emit_expr(state, ast_child(state.tree, id, 0))
		if not is_optional(unboxed.kind)
			return ExprCode(emit_error(unboxed.state, id, "unboxing requires an Optional"), "", TYPE_INVALID)
		var next = unboxed.state
		let temp = "s_unwrap_" + str(next.counter)
		next.counter += 1
		next = line(next, c_type(unboxed.kind) + " " + temp + " = " + unboxed.text + ";")
		next = line(next, "if (!" + temp + ".has_value) s_panic(\"missing optional value\");")
		return ExprCode(next, temp + ".value", optional_value(unboxed.kind))
	if entry.kind == NODE_RECORD
		var next = state
		var fields = Array[RecordField]()
		var semantic_fields = Array[RecordField]()
		var initializers = Array[string]()
		var effects = 0
		var touches = ""
		for i in 0..entry.count
			let field_id = ast_child(state.tree, id, i)
			let field = ast_node(state.tree, field_id)
			if field.kind == NODE_SPREAD
				let name = ast_text(state.tree, field_id)
				let symbol = find_symbol(next, name)
				if symbol < 0
					return ExprCode(emit_error(next, field_id, "unknown spread source '" + name + "'"), "", TYPE_INVALID)
				touches = touches + "(void)v_" + name + ", "
				let kind = next.symbols[!symbol].kind
				let owner = canonical_kind(next.types, next.records, kind)
				next.types = owner.table
				let edit = hir_record_spread(next.types, semantic_fields, owner.id)
				if edit.error != ""
					return ExprCode(emit_error(next, field_id, edit.error), "", TYPE_INVALID)
				semantic_fields = edit.fields
				for member in next.records[!kind - TYPE_RECORD_START].fields
					var found = -1
					for j in 0..len(fields)
						if fields[!j].name == member.name
							found = j
					let code = "." + member.name + " = " + record_copy(member.kind, "v_" + name + "." + member.name)
					if found >= 0
						fields[!found] = member
						initializers[!found] = code
					else
						fields = fields.append(member)
						initializers = initializers.append(code)
			elif field.kind == NODE_DELETE
				let name = ast_text(state.tree, field_id)
				let edit = hir_record_delete(semantic_fields, name)
				if edit.error != ""
					return ExprCode(emit_error(next, field_id, edit.error), "", TYPE_INVALID)
				semantic_fields = edit.fields
				var kept = Array[RecordField]()
				var values = Array[string]()
				for j in 0..len(fields)
					if j != edit.index
						kept = kept.append(fields[!j])
						values = values.append(initializers[!j])
				fields = kept
				initializers = values
			elif field.kind == NODE_FIELD
				let name = ast_text(state.tree, field_id)
				let value_id = ast_child(state.tree, field_id, 0)
				if has_effect(next, value_id, Array[string]())
					effects += 1
				let result = emit_expr(next, value_id)
				next = result.state
				let canonical = canonical_kind(next.types, next.records, result.kind)
				next.types = canonical.table
				let edit = hir_record_put(semantic_fields, name, canonical.id)
				if edit.error != ""
					return ExprCode(emit_error(next, field_id, edit.error), "", TYPE_INVALID)
				semantic_fields = edit.fields
				let member = RecordField(name, result.kind)
				let code = "." + name + " = " + result.text
				if edit.index >= 0
					fields[!edit.index] = member
					initializers[!edit.index] = code
				else
					fields = fields.append(member)
					initializers = initializers.append(code)
			else
				return ExprCode(emit_error(next, field_id, "invalid record field"), "", TYPE_INVALID)
		if effects > 0 and entry.count > 1
			return ExprCode(emit_error(next, id, "record initializer requires ordered evaluation"), "", TYPE_INVALID)
		let semantic = resolve_hir_record(next.types, semantic_fields)
		if semantic.error != ""
			return ExprCode(emit_error(next, id, semantic.error), "", TYPE_INVALID)
		next.types = semantic.table
		let record = intern_record(next, fields)
		var typed = record.state
		typed.hir = typed.hir.append(HirNode(id, HIR_RECORD, semantic.type_id, -1))
		return ExprCode(typed, "(" + touches + "((" + c_type(record.kind) + "){ " + ", ".join(initializers) + " }))", record.kind)
	if entry.kind == NODE_ATTR
		let receiver = emit_expr(state, ast_child(state.tree, id, 0))
		let owner = canonical_kind(receiver.state.types, receiver.state.records, receiver.kind)
		let resolved = resolve_hir_field(owner.table, owner.id, value)
		var next = receiver.state
		next.types = owner.table
		if resolved.error != ""
			return ExprCode(emit_error(next, id, resolved.error), "", TYPE_INVALID)
		let field = next.records[!receiver.kind - TYPE_RECORD_START].fields[!resolved.field_index]
		next.hir = next.hir.append(HirNode(id, HIR_FIELD, resolved.type_id, resolved.field_index))
		return ExprCode(next, c_type(receiver.kind) + "_get_" + field.name + "_take(" + receiver.text + ")", field.kind)
	if entry.kind == NODE_NAME
		let binding = resolve_hir_name(state.symbols, value)
		if binding.field_index >= 0
			var next = state
			next.hir = next.hir.append(HirNode(id, HIR_NAME, binding.type_id, binding.field_index))
			let kind = next.symbols[!binding.field_index].kind
			let copied = record_copy(kind, "v_" + value)
			return ExprCode(next, copied, kind)
		let constant = find_constant(state, value)
		if constant != ""
			return ExprCode(state, constant, TYPE_I64)
		return ExprCode(emit_error(state, id, "unknown name '" + value + "'"), "", TYPE_INVALID)
	if entry.kind == NODE_UNARY
		let arg = emit_expr(state, ast_child(state.tree, id, 0))
		let type_id = canonical_kind(arg.state.types, arg.state.records, arg.kind)
		let resolved = resolve_hir_unary(type_id.table, type_id.id, value)
		var next = arg.state
		next.types = type_id.table
		if resolved.error != ""
			if value == "not"
				return ExprCode(check_type(next, id, arg.kind, TYPE_BOOL), "", TYPE_INVALID)
			return ExprCode(emit_error(next, id, resolved.error), "", TYPE_INVALID)
		next.hir = next.hir.append(HirNode(id, HIR_UNARY, resolved.type_id, -1))
		if value == "not"
			return ExprCode(next, "(!" + arg.text + ")", TYPE_BOOL)
		return ExprCode(next, "(" + value + arg.text + ")", arg.kind)
	if entry.kind == NODE_BINARY
		let left_id = ast_child(state.tree, id, 0)
		let right_id = ast_child(state.tree, id, 1)
		let needs_order = value != "and" and value != "or" and ambiguous_order(state, left_id, right_id)
		var left = emit_expr(state, left_id)
		if needs_order
			var ordered = left.state
			let name = "s_left_" + str(ordered.counter)
			ordered.counter += 1
			ordered = line(ordered, c_type(left.kind) + " " + name + " = " + left.text + ";")
			left = ExprCode(ordered, name, left.kind)
		if (value == "and" or value == "or") and left.kind == TYPE_BOOL and uses_optional_fallback(state, right_id)
			var next = left.state
			let temp = "s_bool_" + str(next.counter)
			next.counter += 1
			next = line(next, "bool " + temp + " = " + left.text + ";")
			var test = temp
			if value == "or"
				test = "!" + temp
			next = line(next, "if (" + test + ") {")
			next.indentation += 1
			let right = emit_expr(next, right_id)
			next = check_type(right.state, id, right.kind, TYPE_BOOL)
			if next.error != ""
				return ExprCode(next, "", TYPE_INVALID)
			next = line(next, temp + " = " + right.text + ";")
			next.indentation -= 1
			next = line(next, "}")
			return ExprCode(next, temp, TYPE_BOOL)
		if value == "or" and is_optional(left.kind)
			let kind = optional_value(left.kind)
			var next = left.state
			let number = next.counter
			next.counter += 1
			let option = "s_option_" + str(number)
			let result = "s_fallback_" + str(number)
			next = line(next, c_type(left.kind) + " " + option + " = " + left.text + ";")
			next = line(next, c_type(kind) + " " + result + ";")
			next = line(next, "if (" + option + ".has_value) {")
			next.indentation += 1
			next = line(next, result + " = " + option + ".value;")
			next.indentation -= 1
			next = line(next, "} else {")
			next.indentation += 1
			let right = emit_expr(next, right_id)
			next = check_type(right.state, id, right.kind, kind)
			if next.error != ""
				return ExprCode(next, "", TYPE_INVALID)
			next = line(next, result + " = " + right.text + ";")
			next.indentation -= 1
			next = line(next, "}")
			return ExprCode(next, result, kind)
		var right = emit_expr(left.state, right_id)
		if needs_order
			var ordered = right.state
			let name = "s_right_" + str(ordered.counter)
			ordered.counter += 1
			ordered = line(ordered, c_type(right.kind) + " " + name + " = " + right.text + ";")
			right = ExprCode(ordered, name, right.kind)
		var next = right.state
		if next.error != ""
			return ExprCode(next, "", TYPE_INVALID)
		let left_type = canonical_kind(next.types, next.records, left.kind)
		let right_type = canonical_kind(left_type.table, next.records, right.kind)
		let resolved = resolve_hir_binary(right_type.table, left_type.id, right_type.id, value)
		next.types = right_type.table
		if resolved.error != ""
			return ExprCode(emit_error(next, id, resolved.error), "", TYPE_INVALID)
		next.hir = next.hir.append(HirNode(id, HIR_BINARY, resolved.type_id, -1))
		var op = value
		var kind = left.kind
		if resolved.type_id == TYPE_TAG_BOOL
			kind = TYPE_BOOL
		if op == "and"
			op = "&&"
		elif op == "or"
			op = "||"
		if left.kind == TYPE_STRING and op == "+"
			return ExprCode(next, "s_string_concat_take(" + left.text + ", " + right.text + ")", TYPE_STRING)
		if left.kind == TYPE_STRING and (op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=")
			return ExprCode(next, "(s_string_compare_take(" + left.text + ", " + right.text + ") " + op + " 0)", TYPE_BOOL)
		return ExprCode(next, "(" + left.text + " " + op + " " + right.text + ")", kind)
	if entry.kind == NODE_CALL
		let callee = ast_child(state.tree, id, 0)
		if ast_node(state.tree, callee).kind == NODE_INDEX
			let dict_kind = dict_constructor_kind(state, callee)
			if dict_kind != TYPE_INVALID
				if entry.count != 1
					return ExprCode(emit_error(state, id, "dictionary constructor takes no arguments"), "", TYPE_INVALID)
				return ExprCode(register_dict(state, dict_kind), dict_helper(dict_kind) + "_make()", dict_kind)
			let kind = array_constructor_kind(state, callee)
			if kind == TYPE_INVALID or entry.count != 1
				return ExprCode(emit_error(state, id, "unsupported array constructor"), "", TYPE_INVALID)
			if kind == TYPE_ARRAY_I64
				return ExprCode(state, "s_array_i64_make(0, NULL)", kind)
			return ExprCode(state, array_helper(kind) + "_make_take(0, NULL)", kind)
		if ast_node(state.tree, callee).kind == NODE_ATTR
			let method = ast_text(state.tree, callee)
			if method == "byte_at" or method == "slice" or method == "find" or method == "starts_with" or method == "ends_with" or method == "join"
				let owner_id = ast_child(state.tree, callee, 0)
				var effects = 0
				if has_effect(state, owner_id, Array[string]())
					effects += 1
				for i in 1..entry.count
					if has_effect(state, ast_child(state.tree, id, i), Array[string]())
						effects += 1
				if effects > 1
					return ExprCode(emit_error(state, id, "string method requires ordered argument evaluation"), "", TYPE_INVALID)
				let receiver = emit_expr(state, owner_id)
				var next = receiver.state
				var args = Array[string]()
				var kinds = Array[i64]()
				for i in 1..entry.count
					let item = emit_expr(next, ast_child(state.tree, id, i))
					next = item.state
					args = args.append(item.text)
					kinds = kinds.append(item.kind)
				let signature = call_type_ids(next, kinds)
				next.types = signature.table
				let owner = canonical_kind(next.types, next.records, receiver.kind)
				next = check_hir_call(next, id, resolve_hir_string_call(owner.table, owner.id, method, signature.ids))
				if next.error != ""
					return ExprCode(next, "", TYPE_INVALID)
				var result_kind = TYPE_BOOL
				if method == "byte_at" or method == "find"
					result_kind = TYPE_OPTIONAL_I64
				elif method == "slice" or method == "join"
					result_kind = TYPE_STRING
				return ExprCode(next, "s_string_" + method + "_take(" + receiver.text + ", " + ", ".join(args) + ")", result_kind)
		if ast_node(state.tree, callee).kind == NODE_ATTR and (ast_text(state.tree, callee) == "insert" or ast_text(state.tree, callee) == "get")
			let method = ast_text(state.tree, callee)
			let receiver = emit_expr(state, ast_child(state.tree, callee, 0))
			var next = receiver.state
			var arguments = Array[string]()
			var kinds = Array[i64]()
			for i in 1..entry.count
				let argument = emit_expr(next, ast_child(state.tree, id, i))
				next = argument.state
				arguments = arguments.append(argument.text)
				kinds = kinds.append(argument.kind)
			if next.error != ""
				return ExprCode(next, "", TYPE_INVALID)
			let signature = call_type_ids(next, kinds)
			let owner = canonical_kind(signature.table, next.records, receiver.kind)
			next = check_hir_call(next, id, resolve_hir_collection_call(owner.table, owner.id, method, signature.ids))
			if next.error != ""
				return ExprCode(next, "", TYPE_INVALID)
			next = register_dict(next, receiver.kind)
			if method == "get"
				return ExprCode(next, dict_helper(receiver.kind) + "_get_take(" + receiver.text + ", " + arguments[!0] + ")", optional_of(dict_value(receiver.kind)))
			return ExprCode(next, dict_helper(receiver.kind) + "_insert_take(" + receiver.text + ", " + ", ".join(arguments) + ")", receiver.kind)
		if ast_node(state.tree, callee).kind == NODE_ATTR and ast_text(state.tree, callee) == "append" and entry.count == 2
			let receiver = emit_expr(state, ast_child(state.tree, callee, 0))
			let item = emit_expr(receiver.state, ast_child(state.tree, id, 1))
			var next = item.state
			let signature = call_type_ids(next, [item.kind])
			let owner = canonical_kind(signature.table, next.records, receiver.kind)
			next = check_hir_call(next, id, resolve_hir_collection_call(owner.table, owner.id, "append", signature.ids))
			if next.error != ""
				return ExprCode(next, "", TYPE_INVALID)
			if receiver.kind == TYPE_ARRAY_I64
				return ExprCode(next, "s_array_i64_append_take(" + receiver.text + ", " + item.text + ")", receiver.kind)
			return ExprCode(next, array_helper(receiver.kind) + "_append_take(" + receiver.text + ", " + item.text + ")", receiver.kind)
		if ast_node(state.tree, callee).kind != NODE_NAME
			return ExprCode(emit_error(state, id, "only named calls are supported"), "", TYPE_INVALID)
		let name = ast_text(state.tree, callee)
		var calls = 0
		for i in 1..entry.count
			if has_effect(state, ast_child(state.tree, id, i), Array[string]())
				calls += 1
		var next = state
		var arguments = Array[string]()
		var arg_types = Array[i64]()
		for i in 1..entry.count
			let arg = emit_expr(next, ast_child(state.tree, id, i))
			next = arg.state
			var expression = arg.text
			if calls > 1 and arg.kind != TYPE_INVALID and arg.kind != TYPE_VOID
				let temporary = "s_arg_" + str(next.counter)
				next.counter += 1
				next = line(next, c_type(arg.kind) + " " + temporary + " = " + arg.text + ";")
				expression = temporary
			arguments = arguments.append(expression)
			arg_types = arg_types.append(arg.kind)
		if next.error != ""
			return ExprCode(next, "", TYPE_INVALID)
		if hir_is_builtin(name)
			let signature = call_type_ids(next, arg_types)
			next = check_hir_call(next, id, resolve_hir_builtin_call(signature.table, name, signature.ids))
			if next.error != ""
				return ExprCode(next, "", TYPE_INVALID)
		if name == "arguments"
			return ExprCode(next, "s_arguments()", TYPE_ARRAY_STRING)
		if name == "read_text"
			return ExprCode(next, "s_read_text_take(" + arguments[!0] + ")", optional_of(TYPE_STRING))
		if name == "write_text"
			return ExprCode(next, "s_write_text_take(" + ", ".join(arguments) + ")", TYPE_BOOL)
		if name == "print" or name == "eprint"
			var target = "stdout"
			if name == "eprint"
				target = "stderr"
			let printed_arg = arguments[!0]
			let kind = arg_types[!0]
			if kind == TYPE_I64
				return ExprCode(next, "fprintf(" + target + ", \"%lld\\n\", (long long)(" + printed_arg + "))", TYPE_VOID)
			if kind == TYPE_F64
				return ExprCode(next, "fprintf(" + target + ", \"%.17g\\n\", " + printed_arg + ")", TYPE_VOID)
			if kind == TYPE_BOOL
				return ExprCode(next, "fprintf(" + target + ", \"%s\\n\", " + printed_arg + " ? \"true\" : \"false\")", TYPE_VOID)
			if kind == TYPE_STRING
				if name == "eprint"
					return ExprCode(next, "s_eprint_string_take(" + printed_arg + ")", TYPE_VOID)
				return ExprCode(next, "s_print_string_take(" + printed_arg + ")", TYPE_VOID)
			return ExprCode(emit_error(next, id, "cannot print this type"), "", TYPE_INVALID)
		if name == "len"
			if arg_types[!0] == TYPE_STRING
				return ExprCode(next, "s_string_length_take(" + arguments[!0] + ")", TYPE_I64)
			if arg_types[!0] == TYPE_ARRAY_I64
				return ExprCode(next, "s_array_i64_length_take(" + arguments[!0] + ")", TYPE_I64)
			if generic_array(arg_types[!0])
				return ExprCode(next, "s_generic_array_length_take(" + arguments[!0] + ")", TYPE_I64)
			if is_dict(arg_types[!0])
				return ExprCode(next, "s_dict_length_take(" + arguments[!0] + ")", TYPE_I64)
			return ExprCode(emit_error(next, id, "len expects a string or array"), "", TYPE_INVALID)
		if name == "str"
			return ExprCode(next, "s_string_from_i64(" + arguments[!0] + ")", TYPE_STRING)
		if name == "sqrt"
			return ExprCode(next, "sqrt(" + arguments[!0] + ")", TYPE_F64)
		let index = find_function(next, name)
		if index < 0
			return ExprCode(emit_error(next, id, "unknown function '" + name + "'"), "", TYPE_INVALID)
		let function = next.functions[!index]
		let signature = call_type_ids(next, arg_types)
		next.types = signature.table
		var parameter_ids = Array[i64]()
		for parameter in function.params
			let canonical = canonical_kind(next.types, next.records, parameter.kind)
			next.types = canonical.table
			parameter_ids = parameter_ids.append(canonical.id)
		let ret = canonical_kind(next.types, next.records, function.kind)
		next = check_hir_call(next, id, resolve_hir_function_call(ret.table, name, signature.ids, parameter_ids, ret.id))
		if next.error != ""
			return ExprCode(next, "", TYPE_INVALID)
		if is_generic(function)
			let specialized = specialize_call(next, id, function, arg_types, arguments)
			var result = specialized.state
			if result.error == "" and specialized.kind != TYPE_INVALID
				let resolved = canonical_kind(result.types, result.records, specialized.kind)
				result.types = resolved.table
				result.hir = result.hir.append(HirNode(id, HIR_CALL, resolved.id, -1))
			return ExprCode(result, specialized.text, specialized.kind)
		return ExprCode(next, function.symbol + "(" + ", ".join(arguments) + ")", function.kind)
	return ExprCode(emit_error(state, id, "unsupported expression '" + node_kind_name(entry.kind) + "'"), "", TYPE_INVALID)

# Detect a direct self-tail call anywhere in the function body.
def contains_recur(tree: ParseState, id: i64) -> bool
	let entry = ast_node(tree, id)
	if entry.kind == NODE_RECUR
		return true
	for i in 0..entry.count
		if contains_recur(tree, ast_child(tree, id, i))
			return true
	return false

def emit_block(state: EmitState, id: i64) -> EmitState
	let count = len(state.symbols)
	var next = state
	let block = ast_node(state.tree, id)
	for i in 0..block.count
		next = emit_statement(next, ast_child(next.tree, id, i))
		next.error == "" else return next
	for i in count..len(next.symbols)
		let index = len(next.symbols) + count - i - 1
		let symbol = next.symbols[!index]
		if is_optional(symbol.kind) and managed(symbol.kind)
			next = line(next, record_drop(symbol.kind, "v_" + symbol.name))
		if symbol.kind == TYPE_STRING
			next = line(next, "s_string_release(v_" + symbol.name + ");")
		if symbol.kind == TYPE_ARRAY_I64
			next = line(next, "s_array_i64_release(v_" + symbol.name + ");")
		if generic_array(symbol.kind)
			next = line(next, "s_array_release(v_" + symbol.name + ");")
		if is_dict(symbol.kind)
			next = line(next, "s_dict_release(v_" + symbol.name + ");")
		if symbol.kind >= TYPE_RECORD_START and symbol.kind < TYPE_ARRAY_RECORD_START
			next = line(next, record_drop(symbol.kind, "v_" + symbol.name))
	var restored = Array[SymbolInfo]()
	for i in 0..count
		restored = restored.append(next.symbols[!i])
	next.symbols = restored
	return next

def emit_nested_block(state: EmitState, id: i64) -> EmitState
	var next = line(state, "{")
	next.indentation += 1
	next.scope_depth += 1
	next = emit_block(next, id)
	next.scope_depth -= 1
	next.indentation -= 1
	return line(next, "}")

def emit_return_value(state: EmitState, id: i64, value_id: i64) -> EmitState
	let result = emit_expr(state, value_id)
	var next = result.state
	if next.return_kind == TYPE_INVALID
		next.return_kind = result.kind
	else
		next = check_type(next, id, result.kind, next.return_kind)
	var needs_cleanup = false
	for symbol in next.symbols
		if managed(symbol.kind)
			needs_cleanup = true
	if needs_cleanup
		let serial = next.counter
		next.counter += 1
		let temp = "s_return_" + str(serial)
		next = line(next, c_type(result.kind) + " " + temp + " = " + result.text + ";")
		for i in 0..len(next.symbols)
			let index = len(next.symbols) - i - 1
			let symbol = next.symbols[!index]
			if is_optional(symbol.kind) and managed(symbol.kind)
				next = line(next, record_drop(symbol.kind, "v_" + symbol.name))
			if symbol.kind == TYPE_STRING
				next = line(next, "s_string_release(v_" + symbol.name + ");")
			if symbol.kind == TYPE_ARRAY_I64
				next = line(next, "s_array_i64_release(v_" + symbol.name + ");")
			if generic_array(symbol.kind)
				next = line(next, "s_array_release(v_" + symbol.name + ");")
			if is_dict(symbol.kind)
				next = line(next, "s_dict_release(v_" + symbol.name + ");")
			if symbol.kind >= TYPE_RECORD_START and symbol.kind < TYPE_ARRAY_RECORD_START
				next = line(next, record_drop(symbol.kind, "v_" + symbol.name))
		return line(next, "return " + temp + ";")
	return line(next, "return " + result.text + ";")

def emit_statement(state: EmitState, id: i64) -> EmitState
	state.error == "" else return state
	let item = ast_node(state.tree, id)
	if item.kind == NODE_DESTRUCTURE
		return emit_error(state, id, "record destructuring requires MIR backend")
	if item.kind == NODE_LET or item.kind == NODE_VAR
		let name = ast_text(state.tree, id)
		let previous = find_symbol(state, name)
		if previous >= 0 and state.symbols[!previous].depth == state.scope_depth
			return emit_error(state, id, "duplicate binding '" + name + "'")
		var kind = TYPE_INVALID
		var expr_id = -1
		var fallback_id = -1
		for i in 0..item.count
			let child = ast_child(state.tree, id, i)
			let child_kind = ast_node(state.tree, child).kind
			if child_kind == NODE_TYPE
				kind = resolve_type(state, child)
			elif child_kind == NODE_ELSE_RETURN
				fallback_id = ast_child(state.tree, child, 0)
			else
				expr_id = child
		if expr_id < 0
			return emit_error(state, id, "binding requires initializer")
		let value_result = emit_expr(state, expr_id)
		var next = value_result.state
		var value_text = value_result.text
		var value_kind = value_result.kind
		if fallback_id >= 0
			if not is_optional(value_result.kind)
				return emit_error(next, id, "else return requires an Optional")
			value_kind = optional_value(value_result.kind)
			let temporary = "s_guard_option_" + str(next.counter)
			next.counter += 1
			next = line(next, c_type(value_result.kind) + " " + temporary + " = " + value_result.text + ";")
			next = line(next, "if (!" + temporary + ".has_value) {")
			next.indentation += 1
			next = emit_return_value(next, id, fallback_id)
			next.indentation -= 1
			next = line(next, "}")
			value_text = temporary + ".value"
		if kind == TYPE_INVALID
			kind = value_kind
		next = check_type(next, id, value_kind, kind)
		next.error == "" else return next
		var declaration = c_type(kind) + " v_" + name + " = " + value_text + ";"
		if item.kind == NODE_LET and not managed(kind)
			declaration = "const " + declaration
		next = line(next, declaration)
		return append_symbol(next, id, name, kind, item.kind == NODE_VAR)
	if item.kind == NODE_ASSIGN
		let target = ast_child(state.tree, id, 0)
		if ast_node(state.tree, target).kind == NODE_CHECKED_INDEX
			if ast_node(state.tree, target).count != 2 or ast_text(state.tree, id) != "="
				return emit_error(state, id, "unsupported indexed assignment")
			let root = ast_child(state.tree, target, 0)
			if ast_node(state.tree, root).kind == NODE_ATTR
				let owner_id = ast_child(state.tree, root, 0)
				if ast_node(state.tree, owner_id).kind != NODE_NAME
					return emit_error(state, id, "indexed update requires a mutable local array")
				let owner = ast_text(state.tree, owner_id)
				let owner_index = find_symbol(state, owner)
				if owner_index < 0 or not state.symbols[!owner_index].mutable
					return emit_error(state, id, "indexed update requires a mutable local array")
				let field_name = ast_text(state.tree, root)
				let field_index = record_field_index(state, state.symbols[!owner_index].kind, field_name)
				if field_index < 0
					return emit_error(state, id, "indexed update requires an array field")
				let array_kind = state.records[!state.symbols[!owner_index].kind - TYPE_RECORD_START].fields[!field_index].kind
				let element_kind = array_element(array_kind)
				if element_kind == TYPE_INVALID
					return emit_error(state, id, "indexed update requires an array")
				let index = emit_expr(state, ast_child(state.tree, target, 1))
				let item_value = emit_expr(index.state, ast_child(state.tree, id, 1))
				var next = check_type(item_value.state, id, index.kind, TYPE_I64)
				next = check_type(next, id, item_value.kind, element_kind)
				let pointer = "&v_" + owner + "." + field_name
				if array_kind == TYPE_ARRAY_I64
					return line(next, "s_array_i64_set(" + pointer + ", " + index.text + ", " + item_value.text + ");")
				return line(next, array_helper(array_kind) + "_set_take(" + pointer + ", " + index.text + ", " + item_value.text + ");")
			if ast_node(state.tree, root).kind != NODE_NAME
				return emit_error(state, id, "indexed update requires a mutable local array")
			let name = ast_text(state.tree, root)
			let symbol = find_symbol(state, name)
			if symbol < 0 or not state.symbols[!symbol].mutable
				return emit_error(state, id, "indexed update requires a mutable local array")
			let array_kind = state.symbols[!symbol].kind
			let element_kind = array_element(array_kind)
			if element_kind == TYPE_INVALID
				return emit_error(state, id, "indexed update requires an array")
			let index = emit_expr(state, ast_child(state.tree, target, 1))
			let item_value = emit_expr(index.state, ast_child(state.tree, id, 1))
			var next = check_type(item_value.state, id, index.kind, TYPE_I64)
			next = check_type(next, id, item_value.kind, element_kind)
			if array_kind == TYPE_ARRAY_I64
				return line(next, "s_array_i64_set(&v_" + name + ", " + index.text + ", " + item_value.text + ");")
			return line(next, array_helper(array_kind) + "_set_take(&v_" + name + ", " + index.text + ", " + item_value.text + ");")
		if ast_node(state.tree, target).kind == NODE_ATTR
			let root = ast_child(state.tree, target, 0)
			if ast_node(state.tree, root).kind != NODE_NAME
				return emit_error(state, id, "record update requires a local root binding")
			let name = ast_text(state.tree, root)
			let index = find_symbol(state, name)
			if index < 0
				return emit_error(state, id, "unknown binding '" + name + "'")
			let symbol = state.symbols[!index]
			if not symbol.mutable
				return emit_error(state, id, "cannot assign immutable binding '" + name + "'")
			let field = ast_text(state.tree, target)
			let member = record_field_index(state, symbol.kind, field)
			if member < 0
				return emit_error(state, target, "unknown record field '" + field + "'")
			let kind = state.records[!symbol.kind - TYPE_RECORD_START].fields[!member].kind
			# Transfer an array field directly into its own append. A normal field read
			# retains the array before append, forcing a needless CoW clone.
			# Evaluate the new element first so it may safely read the old field.
			let rhs = ast_child(state.tree, id, 1)
			if ast_text(state.tree, id) == "=" and array_element(kind) != TYPE_INVALID and ast_node(state.tree, rhs).kind == NODE_CALL
				let call = ast_node(state.tree, rhs)
				if call.count == 2
					let method = ast_child(state.tree, rhs, 0)
					if ast_node(state.tree, method).kind == NODE_ATTR and ast_text(state.tree, method) == "append"
						let receiver = ast_child(state.tree, method, 0)
						if ast_node(state.tree, receiver).kind == NODE_ATTR and ast_text(state.tree, receiver) == field
							let receiver_root = ast_child(state.tree, receiver, 0)
							if ast_node(state.tree, receiver_root).kind == NODE_NAME and ast_text(state.tree, receiver_root) == name
								let element = emit_expr(state, ast_child(state.tree, rhs, 1))
								var next = check_type(element.state, id, element.kind, array_element(kind))
								next.error == "" else return next
								let temp = "s_item_" + str(next.counter)
								next.counter += 1
								next = line(next, c_type(element.kind) + " " + temp + " = " + element.text + ";")
								let destination = "v_" + name + "." + field
								if kind == TYPE_ARRAY_I64
									return line(next, destination + " = s_array_i64_append_take(" + destination + ", " + temp + ");")
								return line(next, destination + " = " + array_helper(kind) + "_append_take(" + destination + ", " + temp + ");")
			let result = emit_expr(state, rhs)
			var next = check_type(result.state, id, result.kind, kind)
			let op = ast_text(state.tree, id)
			if managed(kind)
				if op != "="
					return emit_error(next, id, "managed record field update requires =")
				let temp = "s_field_" + str(next.counter)
				next.counter += 1
				next = line(next, c_type(kind) + " " + temp + " = " + result.text + ";")
				next = line(next, record_drop(kind, "v_" + name + "." + field))
				return line(next, "v_" + name + "." + field + " = " + temp + ";")
			return line(next, "v_" + name + "." + field + " " + op + " " + result.text + ";")
		let lhs = ast_child(state.tree, id, 0)
		let rhs = ast_child(state.tree, id, 1)
		if ast_node(state.tree, lhs).kind != NODE_NAME
			return emit_error(state, id, "only local-variable assignment is supported")
		let name = ast_text(state.tree, lhs)
		let index = find_symbol(state, name)
		if index < 0
			return emit_error(state, id, "unknown binding '" + name + "'")
		let symbol = state.symbols[!index]
		if not symbol.mutable
			return emit_error(state, id, "cannot assign immutable binding '" + name + "'")
		if array_element(symbol.kind) != TYPE_INVALID and ast_node(state.tree, rhs).kind == NODE_CALL
			let call = ast_node(state.tree, rhs)
			if call.count == 2
				let method = ast_child(state.tree, rhs, 0)
				if ast_node(state.tree, method).kind == NODE_ATTR and ast_text(state.tree, method) == "append"
					let receiver = ast_child(state.tree, method, 0)
					if ast_node(state.tree, receiver).kind == NODE_NAME and ast_text(state.tree, receiver) == name
						let element = emit_expr(state, ast_child(state.tree, rhs, 1))
						var next = check_type(element.state, id, element.kind, array_element(symbol.kind))
						next.error == "" else return next
						let serial = next.counter
						next.counter += 1
						let temp = "s_item_" + str(serial)
						next = line(next, c_type(element.kind) + " " + temp + " = " + element.text + ";")
						if symbol.kind == TYPE_ARRAY_I64
							return line(next, "v_" + name + " = s_array_i64_append_take(v_" + name + ", " + temp + ");")
						return line(next, "v_" + name + " = " + array_helper(symbol.kind) + "_append_take(v_" + name + ", " + temp + ");")
		if is_dict(symbol.kind) and ast_node(state.tree, rhs).kind == NODE_CALL
			let call = ast_node(state.tree, rhs)
			if call.count == 3
				let method = ast_child(state.tree, rhs, 0)
				if ast_node(state.tree, method).kind == NODE_ATTR and ast_text(state.tree, method) == "insert"
					let receiver = ast_child(state.tree, method, 0)
					if ast_node(state.tree, receiver).kind == NODE_NAME and ast_text(state.tree, receiver) == name
						let key = emit_expr(state, ast_child(state.tree, rhs, 1))
						let value = emit_expr(key.state, ast_child(state.tree, rhs, 2))
						var next = check_type(value.state, id, key.kind, dict_key(symbol.kind))
						next = check_type(next, id, value.kind, dict_value(symbol.kind))
						next.error == "" else return next
						let serial = next.counter
						next.counter += 1
						let k = "s_key_" + str(serial)
						let v = "s_value_" + str(serial)
						next = line(next, c_type(key.kind) + " " + k + " = " + key.text + ";")
						next = line(next, c_type(value.kind) + " " + v + " = " + value.text + ";")
						return line(next, "v_" + name + " = " + dict_helper(symbol.kind) + "_insert_take(v_" + name + ", " + k + ", " + v + ");")
		let result = emit_expr(state, rhs)
		var next = check_type(result.state, id, result.kind, symbol.kind)
		if array_element(symbol.kind) != TYPE_INVALID
			if ast_text(state.tree, id) != "="
				return emit_error(next, id, "unsupported array assignment")
			let serial = next.counter
			next.counter += 1
			let temp = "s_value_" + str(serial)
			next = line(next, c_type(symbol.kind) + " " + temp + " = " + result.text + ";")
			if symbol.kind == TYPE_ARRAY_I64
				next = line(next, "s_array_i64_release(v_" + name + ");")
			else
				next = line(next, "s_array_release(v_" + name + ");")
			return line(next, "v_" + name + " = " + temp + ";")
		if is_dict(symbol.kind)
			if ast_text(state.tree, id) != "="
				return emit_error(next, id, "unsupported dictionary assignment")
			let temp = "s_value_" + str(next.counter)
			next.counter += 1
			next = line(next, c_type(symbol.kind) + " " + temp + " = " + result.text + ";")
			next = line(next, "s_dict_release(v_" + name + ");")
			return line(next, "v_" + name + " = " + temp + ";")
		if symbol.kind >= TYPE_RECORD_START and symbol.kind < TYPE_ARRAY_RECORD_START
			if ast_text(state.tree, id) != "="
				return emit_error(next, id, "unsupported record assignment")
			let temp = "s_value_" + str(next.counter)
			next.counter += 1
			next = line(next, c_type(symbol.kind) + " " + temp + " = " + result.text + ";")
			next = line(next, record_drop(symbol.kind, "v_" + name))
			return line(next, "v_" + name + " = " + temp + ";")
		if is_optional(symbol.kind)
			if ast_text(state.tree, id) != "="
				return emit_error(next, id, "unsupported optional assignment")
			let temp = "s_value_" + str(next.counter)
			next.counter += 1
			next = line(next, c_type(symbol.kind) + " " + temp + " = " + result.text + ";")
			if managed(symbol.kind)
				next = line(next, record_drop(symbol.kind, "v_" + name))
			return line(next, "v_" + name + " = " + temp + ";")
		if symbol.kind == TYPE_STRING
			let serial = next.counter
			next.counter += 1
			let temp = "s_value_" + str(serial)
			let operator = ast_text(state.tree, id)
			if operator == "+="
				next = line(next, "S_String *" + temp + " = s_string_concat_take(s_string_retain(v_" + name + "), " + result.text + ");")
			elif operator == "="
				next = line(next, "S_String *" + temp + " = " + result.text + ";")
			else
				return emit_error(next, id, "unsupported string assignment")
			next = line(next, "s_string_release(v_" + name + ");")
			return line(next, "v_" + name + " = " + temp + ";")
		return line(next, "v_" + name + " " + ast_text(state.tree, id) + " " + result.text + ";")
	if item.kind == NODE_RETURN
		if item.count == 0
			if state.return_kind != TYPE_VOID
				return emit_error(state, id, "non-void function must return a value")
			return line(state, "return;")
		return emit_return_value(state, id, ast_child(state.tree, id, 0))
	if item.kind == NODE_RECUR
		for symbol in state.symbols
			if managed(symbol.kind)
				return emit_error(state, id, "managed recur requires ownership lowering")
		if item.count != 1
			return emit_error(state, id, "recur expects a direct self-call")
		let call = ast_child(state.tree, id, 0)
		let entry = ast_node(state.tree, call)
		if entry.kind != NODE_CALL or ast_node(state.tree, ast_child(state.tree, call, 0)).kind != NODE_NAME
			return emit_error(state, id, "recur expects a direct self-call")
		let name = ast_text(state.tree, ast_child(state.tree, call, 0))
		if name != state.function_name
			return emit_error(state, id, "recur must call the enclosing function")
		let params = state.active_params
		if entry.count - 1 != len(params)
			return emit_error(state, id, "recur argument count mismatch")
		var next = state
		let serial = next.counter
		next.counter += 1
		for i in 0..len(params)
			let arg = emit_expr(next, ast_child(next.tree, call, i + 1))
			next = check_type(arg.state, id, arg.kind, params[!i].kind)
			next.error == "" else return next
			next = line(next, c_type(arg.kind) + " s_tail_" + str(serial) + "_" + str(i) + " = " + arg.text + ";")
		for i in 0..len(params)
			next = line(next, "v_" + params[!i].name + " = s_tail_" + str(serial) + "_" + str(i) + ";")
		return line(next, "goto s_recur;")
	if item.kind == NODE_GUARD
		let condition = emit_expr(state, ast_child(state.tree, id, 0))
		var next = check_type(condition.state, id, condition.kind, TYPE_BOOL)
		next.error == "" else return next
		next = line(next, "if (!(" + condition.text + ")) {")
		next.indentation += 1
		next = emit_statement(next, ast_child(next.tree, id, 1))
		next.indentation -= 1
		return line(next, "}")
	if item.kind == NODE_EXPR
		let result = emit_expr(state, ast_child(state.tree, id, 0))
		if result.kind != TYPE_VOID
			return emit_error(result.state, id, "expression statement must be effectful")
		return line(result.state, result.text + ";")
	if item.kind == NODE_IF
		var next = state
		for i in 0..item.count
			let arm = ast_child(state.tree, id, i)
			let branch = ast_node(state.tree, arm)
			if branch.kind == NODE_ELSE
				next = line(next, "else")
				next = emit_nested_block(next, ast_child(next.tree, arm, 0))
			else
				if i > 0 and uses_optional_fallback(next, ast_child(next.tree, arm, 0))
					return emit_error(next, arm, "optional fallback in elif requires CFG lowering")
				let cond = emit_expr(next, ast_child(next.tree, arm, 0))
				next = check_type(cond.state, arm, cond.kind, TYPE_BOOL)
				var header = "if (" + cond.text + ")"
				if i > 0
					header = "else " + header
				next = line(next, header)
				next = emit_nested_block(next, ast_child(next.tree, arm, 1))
		return next
	if item.kind == NODE_WHILE
		var next = line(state, "while (true) {")
		next.indentation += 1
		next.scope_depth += 1
		next.loop_depth += 1
		let previous_loop_scope = next.loop_scope
		next.loop_scope = next.scope_depth
		let cond = emit_expr(next, ast_child(next.tree, id, 0))
		next = check_type(cond.state, id, cond.kind, TYPE_BOOL)
		next = line(next, "if (!(" + cond.text + ")) break;")
		next = emit_block(next, ast_child(next.tree, id, 1))
		next.loop_depth -= 1
		next.loop_scope = previous_loop_scope
		next.scope_depth -= 1
		next.indentation -= 1
		return line(next, "}")
	if item.kind == NODE_FOR
		let iterable = ast_child(state.tree, id, item.count - 2)
		let body = ast_child(state.tree, id, item.count - 1)
		if ast_node(state.tree, iterable).kind != NODE_BINARY or ast_text(state.tree, iterable) != ".."
			let source = emit_expr(state, iterable)
			var next = source.state
			let element_kind = array_element(source.kind)
			if element_kind == TYPE_INVALID
				return emit_error(next, id, "for expects an array or range")
			let original = len(next.symbols)
			let serial = next.counter
			next.counter += 1
			let iter = "s_iter_" + str(serial)
			let index = "s_index_" + str(serial)
			let name = ast_text(next.tree, id)
			next = line(next, "{")
			next.indentation += 1
			next.scope_depth += 1
			next = line(next, c_type(source.kind) + " v_" + iter + " = " + source.text + ";")
			next = append_symbol(next, id, iter, source.kind, false)
			var length = "(int64_t)v_" + iter + "->length"
			if generic_array(source.kind)
				length = "(int64_t)s_array_length(v_" + iter + ")"
			next = line(next, "for (int64_t " + index + " = 0; " + index + " < " + length + "; ++" + index + ")")
			next = line(next, "{")
			next.indentation += 1
			next.scope_depth += 1
			next.loop_depth += 1
			let previous_loop_scope = next.loop_scope
			next.loop_scope = next.scope_depth
			var getter = "s_array_i64_get_checked(v_" + iter + ", " + index + ")"
			if generic_array(source.kind)
				getter = array_helper(source.kind) + "_get_borrow(v_" + iter + ", " + index + ")"
			next = line(next, c_type(element_kind) + " v_" + name + " = " + getter + ";")
			next = append_symbol(next, id, name, element_kind, false)
			next = emit_block(next, body)
			if managed(element_kind)
				next = line(next, record_drop(element_kind, "v_" + name))
			next.loop_depth -= 1
			next.loop_scope = previous_loop_scope
			next.scope_depth -= 1
			next.indentation -= 1
			next = line(next, "}")
			if source.kind == TYPE_ARRAY_I64
				next = line(next, "s_array_i64_release(v_" + iter + ");")
			else
				next = line(next, "s_array_release(v_" + iter + ");")
			next.scope_depth -= 1
			next.indentation -= 1
			next = line(next, "}")
			var symbols = Array[SymbolInfo]()
			for i in 0..original
				symbols = symbols.append(next.symbols[!i])
			next.symbols = symbols
			return next
		let from = emit_expr(state, ast_child(state.tree, iterable, 0))
		let to = emit_expr(from.state, ast_child(state.tree, iterable, 1))
		var next = check_type(to.state, id, from.kind, TYPE_I64)
		next = check_type(next, id, to.kind, TYPE_I64)
		let name = ast_text(next.tree, id)
		let bound = "s_bound_" + str(next.counter)
		next.counter += 1
		next = line(next, "for (int64_t v_" + name + " = " + from.text + ", " + bound + " = " + to.text + "; v_" + name + " < " + bound + "; ++v_" + name + ")")
		next.scope_depth += 1
		next = append_symbol(next, id, name, TYPE_I64, false)
		next.loop_depth += 1
		let previous_loop_scope = next.loop_scope
		next.loop_scope = next.scope_depth + 1
		next = emit_nested_block(next, body)
		next.loop_scope = previous_loop_scope
		next.loop_depth -= 1
		next.scope_depth -= 1
		var restored = Array[SymbolInfo]()
		for i in 0..len(state.symbols)
			restored = restored.append(next.symbols[!i])
		next.symbols = restored
		return next
	if item.kind == NODE_BREAK or item.kind == NODE_CONTINUE
		if state.loop_depth == 0
			return emit_error(state, id, "loop control outside loop")
		var next = state
		for i in 0..len(next.symbols)
			let symbol = next.symbols[!len(next.symbols) - 1 - i]
			if symbol.depth >= next.loop_scope and managed(symbol.kind)
				next = line(next, record_drop(symbol.kind, "v_" + symbol.name))
		if item.kind == NODE_BREAK
			return line(next, "break;")
		return line(next, "continue;")
	return emit_error(state, id, "unsupported statement '" + node_kind_name(item.kind) + "'")

def collect_function(state: EmitState, header: HirFunctionDecl) -> EmitState
	let id = header.source
	let name = header.name
	var params = Array[ParameterInfo]()
	var result = TYPE_INVALID
	for parameter in header.parameters
		var kind = TYPE_INVALID
		if parameter.type_node >= 0
			kind = resolve_type(state, parameter.type_node)
			if kind == TYPE_INVALID or kind == TYPE_VOID
				return emit_error(state, parameter.source, "unsupported parameter type")
		params = params.append(ParameterInfo(parameter.name, kind))
	if header.result_type_node >= 0
		result = resolve_type(state, header.result_type_node)
	var next = state
	let constructor = header.constructor
	if constructor
		for param in params
			if param.kind == TYPE_INVALID
				return emit_error(state, id, "generic constructors are not supported yet")
		let body_id = header.body
		let body = ast_node(state.tree, body_id)
		var probe = state
		probe.symbols = Array[SymbolInfo]()
		var fields = Array[RecordField]()
		var semantic_fields = Array[RecordField]()
		for param in params
			probe = append_symbol(probe, id, param.name, param.kind, false)
		for i in 0..body.count
			let pub_id = ast_child(state.tree, body_id, i)
			let pub = ast_node(state.tree, pub_id)
			if pub.kind != NODE_PUB
				return emit_error(state, pub_id, "constructors currently require direct pub statements")
			var field_name = ast_text(state.tree, pub_id)
			var kind = TYPE_INVALID
			if pub.count == 0
				let symbol = find_symbol(probe, field_name)
				if symbol < 0
					return emit_error(state, pub_id, "unknown published binding '" + field_name + "'")
				kind = probe.symbols[!symbol].kind
			else
				let value_id = ast_child(state.tree, pub_id, 0)
				if ast_node(state.tree, value_id).kind == NODE_ATTR
					field_name = ast_text(state.tree, value_id)
				let value = emit_expr(probe, value_id)
				probe = value.state
				probe.error == "" else return probe
				kind = value.kind
			let canonical = canonical_kind(probe.types, probe.records, kind)
			probe.types = canonical.table
			if canonical.id == TYPE_TAG_INVALID or canonical.id == TYPE_TAG_VOID
				return emit_error(state, pub_id, "constructor fields currently require unmanaged values")
			let edit = hir_constructor_publish(semantic_fields, field_name, canonical.id)
			if edit.error != ""
				return emit_error(state, pub_id, edit.error)
			semantic_fields = edit.fields
			fields = fields.append(RecordField(field_name, kind))
		if len(fields) == 0
			return emit_error(state, id, "constructor must publish at least one field")
		let resolved = resolve_hir_record(probe.types, semantic_fields)
		if resolved.error != ""
			return emit_error(state, id, resolved.error)
		probe.types = resolved.table
		let record = intern_record(probe, fields)
		next = record.state
		next.hir = next.hir.append(HirNode(id, HIR_CONSTRUCTOR, resolved.type_id, -1))
		result = record.kind
	next.functions = next.functions.append(FunctionInfo(name, result, params, header.body, constructor, "s_" + name))
	return next

def evaluate_constant(state: EmitState, id: i64) -> ExprCode
	let item = ast_node(state.tree, id)
	let value = ast_text(state.tree, id)
	if item.kind == NODE_INTEGER
		return ExprCode(state, value, TYPE_I64)
	if item.kind == NODE_NAME
		let found = find_constant(state, value)
		if found != ""
			return ExprCode(state, found, TYPE_I64)
	if item.kind == NODE_UNARY and (value == "-" or value == "+")
		let inner = evaluate_constant(state, ast_child(state.tree, id, 0))
		return ExprCode(inner.state, "(" + value + inner.text + ")", TYPE_I64)
	if item.kind == NODE_BINARY and (value == "+" or value == "-" or value == "*")
		let left = evaluate_constant(state, ast_child(state.tree, id, 0))
		let right = evaluate_constant(left.state, ast_child(state.tree, id, 1))
		return ExprCode(right.state, "(" + left.text + " " + value + " " + right.text + ")", TYPE_I64)
	return ExprCode(emit_error(state, id, "unsupported module constant initializer"), "", TYPE_INVALID)

def collect_constant(state: EmitState, id: i64) -> EmitState
	let entry = ast_node(state.tree, id)
	let name = ast_text(state.tree, id)
	if entry.kind != NODE_LET or entry.count < 1
		return emit_error(state, id, "unsupported module statement")
	if find_constant(state, name) != "" or find_function(state, name) >= 0
		return emit_error(state, id, "duplicate module name")
	if entry.count > 1 and ast_node(state.tree, ast_child(state.tree, id, 0)).kind == NODE_TYPE
		if ast_type(state.tree, ast_child(state.tree, id, 0)) != TYPE_I64
			return emit_error(state, id, "module constants must have type i64")
	let initializer = ast_child(state.tree, id, entry.count - 1)
	let result = evaluate_constant(state, initializer)
	if result.state.error != ""
		return result.state
	var next = result.state
	next.constants = next.constants.append(ConstantInfo(name, result.text))
	return next

def emit_function(state: EmitState, info: FunctionInfo) -> EmitState
	var next = state
	next.symbols = Array[SymbolInfo]()
	next.return_kind = info.kind
	next.function_name = info.name
	next.active_params = info.params
	var args = Array[string]()
	for param in info.params
		args = args.append(c_type(param.kind) + " v_" + param.name)
		next = append_symbol(next, info.body, param.name, param.kind, false)
	let header = len(next.lines)
	next = line(next, "")
	next = line(next, "{")
	next.indentation += 1
	if contains_recur(next.tree, info.body)
		next = line(next, "s_recur: ;")
	next.scope_depth += 1
	if info.constructor
		let body = ast_node(next.tree, info.body)
		let output = "s_constructor_result"
		next = line(next, c_type(info.kind) + " " + output + " = {0};")
		var transferred = Array[string]()
		for i in 0..body.count
			let pub_id = ast_child(next.tree, info.body, i)
			let pub = ast_node(next.tree, pub_id)
			var name = ast_text(next.tree, pub_id)
			var expression = "v_" + name
			if pub.count == 1
				let value_id = ast_child(next.tree, pub_id, 0)
				if ast_node(next.tree, value_id).kind == NODE_ATTR
					name = ast_text(next.tree, value_id)
				let value = emit_expr(next, value_id)
				next = value.state
				expression = value.text
			else
				transferred = transferred.append(name)
			next = line(next, output + "." + name + " = " + expression + ";")
		for param in info.params
			var kept = false
			for name in transferred
				if name == param.name
					kept = true
			if not kept and managed(param.kind)
				next = line(next, record_drop(param.kind, "v_" + param.name))
		next = line(next, "return " + output + ";")
	else
		next = emit_block(next, info.body)
	next.scope_depth -= 1
	next.indentation -= 1
	if next.return_kind == TYPE_INVALID
		return emit_error(next, info.body, "cannot infer function return type")
	next.lines[!header] = c_type(next.return_kind) + " " + info.symbol + "(" + ", ".join(args) + ")"
	return line(next, "}")

def compile_c(source: string) -> CompileResult
	let parsed = parse_module(source)
	if parsed.state.error != ""
		return CompileResult("", parsed.state.error, parsed.state.error_line)
	let module_index = hir_module_declarations(parsed.state, parsed.node)
	if module_index.error != ""
		return CompileResult("", module_index.error, module_index.error_line)
	var state = EmitState(parsed.state)
	let root = ast_node(state.tree, parsed.node)
	var function_index = 0
	for i in 0..root.count
		let id = ast_child(state.tree, parsed.node, i)
		let item = ast_node(state.tree, id)
		if item.kind == NODE_DEF or item.kind == NODE_REC
			state = collect_function(state, module_index.functions[!function_index])
			function_index += 1
		else
			state = collect_constant(state, id)
		if state.error != ""
			return CompileResult("", state.error, state.error_line)
	# Analyze each evaluator body before any C is emitted. Complex and generic
	# expressions keep unresolved types for the existing specialization pass.
	var constants = Array[string]()
	for constant in state.constants
		constants = constants.append(constant.name)
	for function in module_index.functions
		if not function.constructor
			let body = hir_analyze_module_body(state.tree, function, module_index.functions, constants)
			if body.error != ""
				return CompileResult("", body.error, body.error_line)
			for typed in body.nodes
				state.hir = state.hir.append(typed)
	let main_index = find_function(state, "main")
	if main_index < 0 or state.functions[!main_index].kind != TYPE_I64 or len(state.functions[!main_index].params) != 0
		return CompileResult("", "expected def main() -> i64", 1)
	state = line(state, "#include <stdint.h>")
	state = line(state, "#include <stdbool.h>")
	state = line(state, "#include <stdio.h>")
	state = line(state, "#include <string.h>")
	state = line(state, "#include <math.h>")
	state = line(state, "#include \"sirius_runtime.h\"")
	state = line(state, "")
	for info in state.functions
		if not is_generic(info)
			var args = Array[string]()
			for param in info.params
				args = args.append(c_type(param.kind))
			state = line(state, c_type(info.kind) + " " + info.symbol + "(" + ", ".join(args) + ");")
	state = line(state, "")
	for info in state.functions
		if not is_generic(info)
			state = emit_function(state, info)
			if state.error != ""
				return CompileResult("", state.error, state.error_line)
			state = line(state, "")
	state = line(state, "int main(int argc, char **argv) { s_set_arguments(argc, argv); return (int)s_main(); }")
	var declarations = ""
	var definitions = ""
	for instance in state.instances
		var args = Array[string]()
		for kind in instance.kinds
			args = args.append(c_type(kind))
		declarations = declarations + c_type(instance.kind) + " " + instance.symbol + "(" + ", ".join(args) + ");\n"
		definitions = definitions + instance.code + "\n"
	var output = ""
	for i in 0..len(state.lines)
		output = output + state.lines[!i] + "\n"
		if i == 5
			output = output + record_declarations(state)
			output = output + optional_declarations(state)
			output = output + generic_array_declarations(state)
			output = output + dict_declarations(state)
			output = output + declarations
	output = output + definitions
	return CompileResult(output, "", 0)
