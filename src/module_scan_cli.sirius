import module_scan alias Scan
def main() -> i64
	let args = arguments()
	if len(args) != 3
		eprint("usage: sirius-module-scan source-root entry.module")
		return 2
	let result = Scan.module_scan_cli_root(args[!1], args[!2])
	if result.error != ""
		eprint(result.error)
		return 2
	print(result.text)
	return 0
