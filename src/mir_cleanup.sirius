import mir alias Mir
import mir_cfg alias Cfg
import mir_verify alias Verify
import mir_ownership alias Ownership
import mir_lifetime alias Lifetime
# Path-sensitive cleanup for managed MIR registers.
# Exit blocks release all definitely owned registers except a returned value;
# CFG edges release values dead on that particular successor path.
# Applied after last-use lifetime insertion, before backend execution/emission.

rec MirCleanupFunction(function: Mir.MirFunction, releases: i64)
export rec MirCleanupResult(program: Mir.MirProgram, releases: i64, error: string)

# Conditional releases make it safe to compute all edge cleanups from one
# ownership snapshot, even when earlier edges have already released a value.
def mir_cleanup_releases(managed: Array[i64], possible: Array[i64], live: Array[i64], successor: Mir.MirBlock) -> Array[Mir.MirInstruction]
	var releases = Array[Mir.MirInstruction]()
	for register in managed
		if Ownership.mir_ownership_get(possible, register) != 0 and not Lifetime.mir_live_contains(live, register)
			# A second invocation must not add another release before an
			# existing cleanup-only edge block.
			var covered = false
			for instruction in successor.instructions
				if instruction.op == Mir.MIR_RELEASE or instruction.op == Mir.MIR_RELEASE_IF_INIT
					if instruction.first == register
						covered = true
				else
					break
			if not covered
				releases = releases.append(Mir.mir_op(Mir.MIR_RELEASE_IF_INIT, register, register, -1, 0))
	return releases

def mir_cleanup_function(program: Mir.MirProgram, function: Mir.MirFunction) -> MirCleanupFunction
	var blocks = function.blocks
	var count = 0
	var managed = Array[i64]()
	for register in 0..len(function.register_types)
		if Verify.mir_managed_type(program.types, function.register_types[!register])
			managed = managed.append(register)
	# One snapshot suffices: edge releases are conditional when ownership
	# differs between incoming paths, so incremental global recomputation
	# after each edge insertion is unnecessary.
	let cfg = Cfg.mir_cfg_facts(function)
	let reached = cfg.reached
	let possible = Ownership.mir_ownership_dataflow_cfg(function, true, cfg.reached, cfg.predecessors)
	let liveness = Lifetime.mir_lifetime_states_cfg(function, cfg)
	for i in 0..len(function.blocks)
		if reached[!i] != 0
			let original = blocks[!i]
			let term = original.terminator
			let may = possible[!i].outgoing
			var instructions = original.instructions
			var next = term
			if term.kind == Mir.MIR_JUMP
				let releases = mir_cleanup_releases(managed, may, liveness[!term.target].live_in, blocks[!term.target])
				for release in releases
					instructions = instructions.append(release)
					count += 1
			elif term.kind == Mir.MIR_BRANCH
				var yes = term.target
				var no = term.alternative
				let yes_releases = mir_cleanup_releases(managed, may, liveness[!yes].live_in, blocks[!yes])
				let no_releases = mir_cleanup_releases(managed, may, liveness[!no].live_in, blocks[!no])
				# Both lists are ordered by register. Drop their intersection
				# before the branch; edge-only drops remain on their edges.
				var yes_only = Array[Mir.MirInstruction]()
				var no_only = Array[Mir.MirInstruction]()
				var y = 0
				var n = 0
				while y < len(yes_releases) and n < len(no_releases)
					let a = yes_releases[!y]
					let b = no_releases[!n]
					if a.first == b.first
						instructions = instructions.append(a)
						count += 1
						y += 1
						n += 1
					elif a.first < b.first
						yes_only = yes_only.append(a)
						y += 1
					else
						no_only = no_only.append(b)
						n += 1
				while y < len(yes_releases)
					yes_only = yes_only.append(yes_releases[!y])
					y += 1
				while n < len(no_releases)
					no_only = no_only.append(no_releases[!n])
					n += 1
				if len(yes_only) > 0
					yes = len(blocks)
					blocks = blocks.append(Mir.MirBlock(yes_only, Mir.mir_jump(term.target)))
					count += len(yes_only)
				if len(no_only) > 0
					no = len(blocks)
					blocks = blocks.append(Mir.MirBlock(no_only, Mir.mir_jump(term.alternative)))
					count += len(no_only)
				next = Mir.mir_branch(term.operand, yes, no)
			blocks[!i] = Mir.MirBlock(instructions, next)
	let edged = Mir.MirFunction(function.argument_count, function.return_type, function.register_types, blocks, function.entry)
	# One post-edge may-own analysis determines whether an exit needs a
	# release. Emit conditional releases: edge drops can make a value
	# absent on some incoming paths, so a must-own analysis is unnecessary.
	let exit_cfg = Cfg.mir_cfg_facts(edged)
	let exit_reached = exit_cfg.reached
	let exit_maybe = Ownership.mir_ownership_dataflow_cfg(edged, true, exit_cfg.reached, exit_cfg.predecessors)
	for i in 0..len(blocks)
		if exit_reached[!i] != 0
			let block = blocks[!i]
			let term = block.terminator
			if term.kind == Mir.MIR_RETURN or term.kind == Mir.MIR_PANIC
				var preserved = -1
				if term.kind == Mir.MIR_RETURN
					preserved = term.operand
				var instructions = block.instructions
				for register in managed
					if register != preserved and Ownership.mir_ownership_get(exit_maybe[!i].outgoing, register) != 0
						instructions = instructions.append(Mir.mir_op(Mir.MIR_RELEASE_IF_INIT, register, register, -1, 0))
						count += 1
				blocks[!i] = Mir.MirBlock(instructions, term)
	return MirCleanupFunction(Mir.MirFunction(function.argument_count, function.return_type, function.register_types, blocks, function.entry), count)

# Internal transformation; the caller verifies ownership after all passes.
export def mir_insert_exit_cleanup_unchecked(program: Mir.MirProgram) -> MirCleanupResult
	var functions = Array[Mir.MirFunction]()
	var count = 0
	for function in program.functions
		let cleaned = mir_cleanup_function(program, function)
		functions = functions.append(cleaned.function)
		count += cleaned.releases
	return MirCleanupResult(Mir.mir_program_with_types(functions, program.types), count, "")

export def mir_insert_exit_cleanup(program: Mir.MirProgram) -> MirCleanupResult
	let error = Ownership.mir_check_ownership(program)
	if error != ""
		return MirCleanupResult(program, 0, error)
	let cleaned = mir_insert_exit_cleanup_unchecked(program)
	return MirCleanupResult(cleaned.program, cleaned.releases, Ownership.mir_check_balance(cleaned.program))
