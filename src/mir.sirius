# Executable typed CFG MIR. Registers are mutable slots within each call frame.
# Scalar values, owned strings, immutable structural records, arrays and dictionaries. Every initialized string register owns one
# reference; copy/retain duplicates, move transfers, release invalidates.

let MIR_CONST_I64 = 1
let MIR_CONST_BOOL = 2
let MIR_COPY = 3
let MIR_ADD_I64 = 4
let MIR_SUB_I64 = 5
let MIR_MUL_I64 = 6
let MIR_DIV_I64 = 7
let MIR_REM_I64 = 8
let MIR_EQ_I64 = 9
let MIR_LT_I64 = 10
let MIR_LE_I64 = 11
let MIR_NOT_BOOL = 12
let MIR_EQ_BOOL = 13
let MIR_NEG_I64 = 14
let MIR_CALL = 15
let MIR_PRINT = 16
let MIR_CONST_STRING = 17
let MIR_RETAIN = 18
let MIR_MOVE = 19
let MIR_RELEASE = 20
let MIR_STRING_LENGTH = 21
let MIR_STRING_CONCAT = 22
let MIR_RECORD_NEW = 23
let MIR_RECORD_GET = 24
let MIR_ARRAY_NEW = 25
let MIR_ARRAY_GET = 26
let MIR_ARRAY_LENGTH = 27
let MIR_ARRAY_SET = 28
let MIR_DICT_NEW = 29
let MIR_DICT_INSERT = 30
let MIR_DICT_GET_OR = 31
let MIR_DICT_LENGTH = 32
let MIR_OPTIONAL_NONE = 33
let MIR_OPTIONAL_SOME = 34
let MIR_OPTIONAL_HAS = 35
let MIR_OPTIONAL_UNWRAP = 36
let MIR_ARRAY_GET_OPTIONAL = 37
let MIR_DICT_GET_OPTIONAL = 38
let MIR_RELEASE_IF_INIT = 39
let MIR_NONZERO_I64 = 40
let MIR_DIV_NO_OVERFLOW_I64 = 41
let MIR_ARRAY_INDEX_VALID = 42
let MIR_ARGUMENTS = 43
let MIR_READ_TEXT = 44
let MIR_WRITE_TEXT = 45
let MIR_STR_I64 = 46
let MIR_ARRAY_APPEND = 47
let MIR_STRING_SLICE = 48
let MIR_STRING_FIND = 49
let MIR_STRING_BYTE_AT = 50
let MIR_STRING_STARTS_WITH = 51
let MIR_STRING_ENDS_WITH = 52
let MIR_STRING_JOIN = 53
let MIR_EQ_STRING = 54
let MIR_LT_STRING = 55
let MIR_LE_STRING = 56
let MIR_CONST_F64 = 57
let MIR_ADD_F64 = 58
let MIR_SUB_F64 = 59
let MIR_MUL_F64 = 60
let MIR_DIV_F64 = 61
let MIR_EQ_F64 = 62
let MIR_LT_F64 = 63
let MIR_LE_F64 = 64
let MIR_NEG_F64 = 65
let MIR_SQRT_F64 = 66
let MIR_RECORD_SET = 67
let MIR_RECORD_ARRAY_APPEND = 68
let MIR_CALL_MOVE = 69

let MIR_JUMP = 1
let MIR_BRANCH = 2
let MIR_RETURN = 3
let MIR_PANIC = 4

# Runtime failure contract. Some operations have a recoverable, explicit
# CFG trap (GUARDED); managed allocations may still terminate in the runtime
# without unwinding (ABORT). An instruction can have both properties.
rec MirFailureInfo(guarded: bool, abort: bool)
rec MirFailureAudit(error: string, guarded: i64, aborts: i64)

def mir_failure_info(op: i64) -> MirFailureInfo
	if op == MIR_DIV_I64 or op == MIR_REM_I64 or op == MIR_ARRAY_GET or op == MIR_OPTIONAL_UNWRAP
		return MirFailureInfo(true, false)
	if op == MIR_ARRAY_SET
		return MirFailureInfo(true, true)
	if op == MIR_ARGUMENTS or op == MIR_READ_TEXT or op == MIR_WRITE_TEXT or op == MIR_STR_I64 or op == MIR_CALL or op == MIR_CALL_MOVE or op == MIR_PRINT or op == MIR_CONST_STRING or op == MIR_STRING_CONCAT or op == MIR_STRING_SLICE or op == MIR_STRING_FIND or op == MIR_STRING_BYTE_AT or op == MIR_STRING_STARTS_WITH or op == MIR_STRING_ENDS_WITH or op == MIR_STRING_JOIN or op == MIR_RECORD_NEW or op == MIR_ARRAY_NEW or op == MIR_ARRAY_APPEND or op == MIR_DICT_NEW or op == MIR_DICT_INSERT or op == MIR_RECORD_SET or op == MIR_RECORD_ARRAY_APPEND or op == MIR_OPTIONAL_NONE or op == MIR_OPTIONAL_SOME or op == MIR_ARRAY_GET_OPTIONAL or op == MIR_DICT_GET_OPTIONAL
		return MirFailureInfo(false, true)
	return MirFailureInfo(false, false)

# immediate carries literal bits or a function index. A call uses inputs to
# identify argument registers, in evaluation order. All other operands are
# register indices. Unused operands are -1.
rec MirInstruction(op: i64, dst: i64, first: i64, second: i64, immediate: i64, inputs: Array[i64], text: string)
rec MirTerminator(kind: i64, operand: i64, target: i64, alternative: i64, message: string)
rec MirBlock(instructions: Array[MirInstruction], terminator: MirTerminator)
rec MirFunction(argument_count: i64, return_type: i64, register_types: Array[i64], blocks: Array[MirBlock], entry: i64)
rec MirProgram(functions: Array[MirFunction])
	pub types = new_type_table()

def mir_program_with_types(functions: Array[MirFunction], types: TypeTable) -> MirProgram
	var program = MirProgram(functions)
	program.types = types
	return program

# For the initial scalar subset, an i64 slot stores its integer and a bool slot
# stores 0/1 in bits. type_id 0 represents an uninitialized register.
rec MirValue(type_id: i64, bits: i64, text: string)
rec MirHeapRecord(type_id: i64, fields: Array[MirValue], refs: i64)
rec MirOutcome(value: MirValue, error: string, steps: i64)
	pub heap = Array[MirHeapRecord]()

def mir_op(op: i64, dst: i64, first: i64, second: i64, immediate: i64) -> MirInstruction
	return MirInstruction(op, dst, first, second, immediate, Array[i64](), "")

def mir_call(dst: i64, function_id: i64, inputs: Array[i64]) -> MirInstruction
	return MirInstruction(MIR_CALL, dst, -1, -1, function_id, inputs, "")

# Like MIR_CALL, but transfers first and any additional managed inputs
# selected by the bitmask in second. The mask indexes argument positions,
# not registers, and supports positions 0..61 (i64 without sign overflow).
def mir_call_move(dst: i64, function_id: i64, inputs: Array[i64], source: i64) -> MirInstruction
	return MirInstruction(MIR_CALL_MOVE, dst, source, 0, function_id, inputs, "")

def mir_call_moves(dst: i64, function_id: i64, inputs: Array[i64], sources: Array[i64]) -> MirInstruction
	var mask = 0
	var bit = 1
	for i in 0..len(inputs)
		if i < 62
			if inputs[!i] != sources[!0]
				for source in sources
					if inputs[!i] == source
						mask += bit
			bit *= 2
	return MirInstruction(MIR_CALL_MOVE, dst, sources[!0], mask, function_id, inputs, "")

def mir_call_move_at(ins: MirInstruction, position: i64) -> bool
	if ins.op != MIR_CALL_MOVE
		return false
	if ins.inputs[!position] == ins.first
		return true
	if ins.second <= 0
		return false
	var mask = ins.second
	for i in 0..position
		mask = mask / 2
	return mask % 2 == 1

def mir_call_moves_register(ins: MirInstruction, register: i64) -> bool
	if ins.op != MIR_CALL_MOVE
		return false
	if register == ins.first
		return true
	for i in 0..len(ins.inputs)
		if ins.inputs[!i] == register and mir_call_move_at(ins, i)
			return true
	return false

def mir_string(dst: i64, value: string) -> MirInstruction
	return MirInstruction(MIR_CONST_STRING, dst, -1, -1, 0, Array[i64](), value)

def mir_record_new(dst: i64, fields: Array[i64]) -> MirInstruction
	return MirInstruction(MIR_RECORD_NEW, dst, -1, -1, 0, fields, "")

def mir_record_get(dst: i64, owner: i64, field: i64) -> MirInstruction
	return mir_op(MIR_RECORD_GET, dst, owner, -1, field)

# Consumes owner and returns the updated record, cloning only when shared.
def mir_record_set(dst: i64, owner: i64, field: i64, value: i64) -> MirInstruction
	return mir_op(MIR_RECORD_SET, dst, owner, value, field)

# Consumes a record and appends into its array field without retaining
# the old array merely to replace that same field.
def mir_record_array_append(dst: i64, owner: i64, field: i64, value: i64) -> MirInstruction
	return mir_op(MIR_RECORD_ARRAY_APPEND, dst, owner, value, field)

def mir_array_new(dst: i64, elements: Array[i64]) -> MirInstruction
	return MirInstruction(MIR_ARRAY_NEW, dst, -1, -1, 0, elements, "")

def mir_array_get(dst: i64, owner: i64, index: i64) -> MirInstruction
	return mir_op(MIR_ARRAY_GET, dst, owner, index, 0)

# Consumes owner: transfers its owned reference to dst (which may equal owner).
# Shared arrays are copied before mutation; uniquely owned arrays mutate in place.
def mir_array_append(dst: i64, owner: i64, value: i64) -> MirInstruction
	return mir_op(MIR_ARRAY_APPEND, dst, owner, value, 0)

def mir_array_set(dst: i64, owner: i64, index: i64, value: i64) -> MirInstruction
	return MirInstruction(MIR_ARRAY_SET, dst, owner, index, value, Array[i64](), "")

# The C backend stores dictionary entries in S_Dict through an owned wrapper;
# the interpreter uses its own list representation. GET_OR eagerly evaluates
# its fallback; source `get(...) or fallback` lowers through Optional CFG.
def mir_dict_new(dst: i64) -> MirInstruction
	return mir_op(MIR_DICT_NEW, dst, -1, -1, 0)

def mir_dict_insert(dst: i64, owner: i64, key: i64, value: i64) -> MirInstruction
	return MirInstruction(MIR_DICT_INSERT, dst, owner, -1, 0, [key, value], "")

def mir_dict_get_or(dst: i64, owner: i64, key: i64, fallback: i64) -> MirInstruction
	return mir_op(MIR_DICT_GET_OR, dst, owner, key, fallback)

def mir_dict_length(dst: i64, owner: i64) -> MirInstruction
	return mir_op(MIR_DICT_LENGTH, dst, owner, -1, 0)

def mir_optional_none(dst: i64) -> MirInstruction
	return mir_op(MIR_OPTIONAL_NONE, dst, -1, -1, 0)

def mir_optional_some(dst: i64, value: i64) -> MirInstruction
	return mir_op(MIR_OPTIONAL_SOME, dst, value, -1, 0)

def mir_optional_has(dst: i64, owner: i64) -> MirInstruction
	return mir_op(MIR_OPTIONAL_HAS, dst, owner, -1, 0)

def mir_optional_unwrap(dst: i64, owner: i64) -> MirInstruction
	return mir_op(MIR_OPTIONAL_UNWRAP, dst, owner, -1, 0)

def mir_array_get_optional(dst: i64, owner: i64, index: i64) -> MirInstruction
	return mir_op(MIR_ARRAY_GET_OPTIONAL, dst, owner, index, 0)

def mir_dict_get_optional(dst: i64, owner: i64, key: i64) -> MirInstruction
	return mir_op(MIR_DICT_GET_OPTIONAL, dst, owner, key, 0)

def mir_jump(target: i64) -> MirTerminator
	return MirTerminator(MIR_JUMP, -1, target, -1, "")

def mir_branch(condition: i64, yes: i64, no: i64) -> MirTerminator
	return MirTerminator(MIR_BRANCH, condition, yes, no, "")

def mir_return(source: i64) -> MirTerminator
	return MirTerminator(MIR_RETURN, source, -1, -1, "")

def mir_panic(message: string) -> MirTerminator
	return MirTerminator(MIR_PANIC, -1, -1, -1, message)

# Precompute CFG incoming edges once for forward and backward data flow.
def mir_cfg_predecessors(function: MirFunction) -> Array[Array[i64]]
	var predecessors = Array[Array[i64]]()
	for block in function.blocks
		predecessors = predecessors.append(Array[i64]())
	for i in 0..len(function.blocks)
		let term = function.blocks[!i].terminator
		if term.kind == MIR_JUMP or term.kind == MIR_BRANCH
			var incoming = predecessors[!term.target]
			incoming = incoming.append(i)
			predecessors[!term.target] = incoming
		if term.kind == MIR_BRANCH and term.alternative != term.target
			var incoming = predecessors[!term.alternative]
			incoming = incoming.append(i)
			predecessors[!term.alternative] = incoming
	return predecessors

# Consuming instructions invalidate their source register. Shared by
# forward ownership and backward lifetime analyses.
def mir_consumes_source(ins: MirInstruction) -> bool
	return ins.op == MIR_MOVE or ins.op == MIR_RECORD_SET or ins.op == MIR_ARRAY_SET or ins.op == MIR_DICT_INSERT or ins.op == MIR_ARRAY_APPEND or ins.op == MIR_RECORD_ARRAY_APPEND or ins.op == MIR_CALL_MOVE or ins.op == MIR_RELEASE or ins.op == MIR_RELEASE_IF_INIT

# Register operands read by an instruction. Literal immediates are excluded.
# Shared by backward liveness and forward definite-initialization analyses.
def mir_read_add(reads: Array[i64], register: i64) -> Array[i64]
	if register < 0
		return reads
	for existing in reads
		if existing == register
			return reads
	return reads.append(register)

def mir_instruction_reads(ins: MirInstruction) -> Array[i64]
	var reads = Array[i64]()
	if ins.op == MIR_CONST_I64 or ins.op == MIR_CONST_BOOL or ins.op == MIR_CONST_STRING or ins.op == MIR_CONST_F64 or ins.op == MIR_DICT_NEW or ins.op == MIR_OPTIONAL_NONE or ins.op == MIR_ARGUMENTS or ins.op == MIR_RELEASE_IF_INIT
		return reads
	if ins.op == MIR_WRITE_TEXT
		return [ins.first, ins.second]
	if ins.op == MIR_CALL or ins.op == MIR_CALL_MOVE or ins.op == MIR_RECORD_NEW or ins.op == MIR_ARRAY_NEW
		return ins.inputs
	reads = reads.append(ins.first)
	if ins.op == MIR_DICT_INSERT
		for register in ins.inputs
			reads = mir_read_add(reads, register)
		return reads
	if ins.op == MIR_ARRAY_SET or ins.op == MIR_DICT_GET_OR or ins.op == MIR_STRING_SLICE
		reads = mir_read_add(reads, ins.immediate)
	if (ins.op >= MIR_ADD_I64 and ins.op <= MIR_LE_I64) or ins.op == MIR_EQ_BOOL or ins.op == MIR_STRING_CONCAT or ins.op == MIR_ARRAY_GET or ins.op == MIR_ARRAY_GET_OPTIONAL or ins.op == MIR_ARRAY_SET or ins.op == MIR_DICT_GET_OR or ins.op == MIR_DICT_GET_OPTIONAL or ins.op == MIR_DIV_NO_OVERFLOW_I64 or ins.op == MIR_ARRAY_INDEX_VALID or ins.op == MIR_ARRAY_APPEND or ins.op == MIR_RECORD_SET or ins.op == MIR_RECORD_ARRAY_APPEND or (ins.op >= MIR_STRING_SLICE and ins.op <= MIR_LE_STRING) or (ins.op >= MIR_ADD_F64 and ins.op <= MIR_LE_F64)
		reads = mir_read_add(reads, ins.second)
	return reads

# Verification is structural and type-directed. Definite register initialization
# is checked dynamically for now (CFG data-flow analysis comes with lowering).
def mir_register_valid(types: Array[i64], register: i64, expected: i64) -> bool
	return register >= 0 and register < len(types) and types[!register] == expected

def mir_supported_type(type_id: i64) -> bool
	return type_id == TYPE_TAG_I64 or type_id == TYPE_TAG_BOOL or type_id == TYPE_TAG_STRING or type_id == TYPE_TAG_F64

def mir_type_supported(types: TypeTable, type_id: i64) -> bool
	if type_id < 0 or type_id >= len(types.entries)
		return false
	let tag = types.entries[!type_id].tag
	return mir_supported_type(tag) or tag == TYPE_TAG_RECORD or tag == TYPE_TAG_ARRAY or tag == TYPE_TAG_DICT or tag == TYPE_TAG_OPTIONAL

def mir_managed_type(types: TypeTable, type_id: i64) -> bool
	if type_id < 0 or type_id >= len(types.entries)
		return false
	let tag = types.entries[!type_id].tag
	return tag == TYPE_TAG_STRING or tag == TYPE_TAG_RECORD or tag == TYPE_TAG_ARRAY or tag == TYPE_TAG_DICT or tag == TYPE_TAG_OPTIONAL

def mir_verify_instruction(program: MirProgram, function: MirFunction, ins: MirInstruction) -> string
	let types = function.register_types
	if ins.op == MIR_PRINT
		if ins.first < 0 or ins.first >= len(types) or not mir_supported_type(types[!ins.first])
			return "invalid print operand"
		return ""
	if ins.dst < 0 or ins.dst >= len(types)
		return "invalid destination register"
	let dst_type = types[!ins.dst]
	if ins.op == MIR_ARGUMENTS
		let desc = program.types.entries[!dst_type]
		if desc.tag != TYPE_TAG_ARRAY or desc.first != TYPE_TAG_STRING
			return "arguments requires Array[string] destination"
		return ""
	if ins.op == MIR_STR_I64
		if dst_type != TYPE_TAG_STRING or not mir_register_valid(types, ins.first, TYPE_TAG_I64)
			return "str requires i64 and string result"
		return ""
	if ins.op == MIR_READ_TEXT
		let desc = program.types.entries[!dst_type]
		if desc.tag != TYPE_TAG_OPTIONAL or desc.first != TYPE_TAG_STRING or not mir_register_valid(types, ins.first, TYPE_TAG_STRING)
			return "read_text requires string path and Optional[string] result"
		return ""
	if ins.op == MIR_WRITE_TEXT
		if dst_type != TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, TYPE_TAG_STRING) or not mir_register_valid(types, ins.second, TYPE_TAG_STRING)
			return "write_text requires two strings and bool result"
		return ""
	if ins.op == MIR_CONST_I64
		if dst_type != TYPE_TAG_I64
			return "integer constant destination must be i64"
		return ""
	if ins.op == MIR_CONST_BOOL
		if dst_type != TYPE_TAG_BOOL or (ins.immediate != 0 and ins.immediate != 1)
			return "invalid boolean constant"
		return ""
	if ins.op == MIR_CONST_STRING
		if dst_type != TYPE_TAG_STRING
			return "string constant destination must be string"
		return ""
	if ins.op == MIR_CONST_F64
		if dst_type != TYPE_TAG_F64 or ins.text == ""
			return "floating constant destination must be f64"
		return ""
	if ins.op == MIR_NONZERO_I64
		if dst_type != TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, TYPE_TAG_I64)
			return "nonzero guard type mismatch"
		return ""
	if ins.op == MIR_DIV_NO_OVERFLOW_I64
		if dst_type != TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, TYPE_TAG_I64) or not mir_register_valid(types, ins.second, TYPE_TAG_I64)
			return "division overflow guard type mismatch"
		return ""
	if ins.op == MIR_ARRAY_INDEX_VALID
		if dst_type != TYPE_TAG_BOOL or ins.first < 0 or ins.first >= len(types) or program.types.entries[!types[!ins.first]].tag != TYPE_TAG_ARRAY or not mir_register_valid(types, ins.second, TYPE_TAG_I64)
			return "array index guard type mismatch"
		return ""
	if ins.op == MIR_OPTIONAL_NONE or ins.op == MIR_OPTIONAL_SOME
		let desc = program.types.entries[!dst_type]
		if desc.tag != TYPE_TAG_OPTIONAL
			return "optional constructor requires Optional destination"
		if ins.op == MIR_OPTIONAL_SOME and not mir_register_valid(types, ins.first, desc.first)
			return "optional payload type mismatch"
		return ""
	if ins.op == MIR_OPTIONAL_HAS or ins.op == MIR_OPTIONAL_UNWRAP
		if ins.first < 0 or ins.first >= len(types)
			return "invalid optional source"
		let desc = program.types.entries[!types[!ins.first]]
		if desc.tag != TYPE_TAG_OPTIONAL
			return "optional operation requires Optional"
		if ins.op == MIR_OPTIONAL_HAS and dst_type != TYPE_TAG_BOOL
			return "optional presence destination must be bool"
		if ins.op == MIR_OPTIONAL_UNWRAP and dst_type != desc.first
			return "optional unwrap type mismatch"
		return ""
	if ins.op == MIR_DICT_NEW
		if program.types.entries[!dst_type].tag != TYPE_TAG_DICT
			return "dictionary construction requires Dict destination"
		return ""
	if ins.op == MIR_DICT_INSERT or ins.op == MIR_DICT_GET_OR or ins.op == MIR_DICT_LENGTH or ins.op == MIR_DICT_GET_OPTIONAL
		if ins.first < 0 or ins.first >= len(types)
			return "invalid dictionary source"
		let owner = types[!ins.first]
		let desc = program.types.entries[!owner]
		if desc.tag != TYPE_TAG_DICT
			return "dictionary operation requires Dict"
		if ins.op == MIR_DICT_LENGTH
			if dst_type != TYPE_TAG_I64
				return "dictionary length destination must be i64"
			return ""
		if ins.op == MIR_DICT_INSERT
			if len(ins.inputs) != 2 or dst_type != owner
				return "dictionary insert signature mismatch"
			if not mir_register_valid(types, ins.inputs[!0], desc.first) or not mir_register_valid(types, ins.inputs[!1], desc.second)
				return "dictionary insert key/value type mismatch"
			return ""
		if ins.op == MIR_DICT_GET_OPTIONAL
			let optional = program.types.entries[!dst_type]
			if optional.tag != TYPE_TAG_OPTIONAL or optional.first != desc.second or not mir_register_valid(types, ins.second, desc.first)
				return "dictionary optional lookup signature mismatch"
			return ""
		if not mir_register_valid(types, ins.second, desc.first) or not mir_register_valid(types, ins.immediate, desc.second) or dst_type != desc.second
			return "dictionary get-or signature mismatch"
		return ""
	if ins.op == MIR_RECORD_NEW
		if program.types.entries[!dst_type].tag != TYPE_TAG_RECORD
			return "record construction requires record destination"
		let fields = program.types.entries[!dst_type].fields
		if len(ins.inputs) != len(fields)
			return "record constructor field count mismatch"
		for i in 0..len(fields)
			if not mir_register_valid(types, ins.inputs[!i], fields[!i].kind)
				return "record constructor field type mismatch"
		return ""
	if ins.op == MIR_ARRAY_NEW
		let desc = program.types.entries[!dst_type]
		if desc.tag != TYPE_TAG_ARRAY
			return "array constructor requires array destination"
		for input in ins.inputs
			if not mir_register_valid(types, input, desc.first)
				return "array constructor element type mismatch"
		return ""
	if ins.op == MIR_ARRAY_APPEND
		if ins.first < 0 or ins.first >= len(types)
			return "invalid append owner"
		let owner = types[!ins.first]
		let desc = program.types.entries[!owner]
		if desc.tag != TYPE_TAG_ARRAY or dst_type != owner or not mir_register_valid(types, ins.second, desc.first)
			return "array append signature mismatch"
		return ""
	if ins.op == MIR_ARRAY_GET or ins.op == MIR_ARRAY_LENGTH or ins.op == MIR_ARRAY_SET or ins.op == MIR_ARRAY_GET_OPTIONAL
		if ins.first < 0 or ins.first >= len(types)
			return "invalid array source"
		let source_type = types[!ins.first]
		let desc = program.types.entries[!source_type]
		if desc.tag != TYPE_TAG_ARRAY
			return "array operand requires array"
		if ins.op == MIR_ARRAY_LENGTH
			if dst_type != TYPE_TAG_I64
				return "array length destination must be i64"
			return ""
		if not mir_register_valid(types, ins.second, TYPE_TAG_I64)
			return "array index must be i64"
		if ins.op == MIR_ARRAY_GET_OPTIONAL
			let optional = program.types.entries[!dst_type]
			if optional.tag != TYPE_TAG_OPTIONAL or optional.first != desc.first
				return "array optional index type mismatch"
		elif ins.op == MIR_ARRAY_GET
			if dst_type != desc.first
				return "array element destination type mismatch"
		elif dst_type != source_type or not mir_register_valid(types, ins.immediate, desc.first)
			return "array update type mismatch"
		return ""
	if ins.op == MIR_RECORD_ARRAY_APPEND
		if ins.first < 0 or ins.first >= len(types)
			return "invalid record update source"
		let owner = types[!ins.first]
		if program.types.entries[!owner].tag != TYPE_TAG_RECORD or dst_type != owner
			return "record array append requires matching record destination"
		let fields = program.types.entries[!owner].fields
		if ins.immediate < 0 or ins.immediate >= len(fields)
			return "invalid record update field"
		let field_type = fields[!ins.immediate].kind
		if program.types.entries[!field_type].tag != TYPE_TAG_ARRAY or not mir_register_valid(types, ins.second, program.types.entries[!field_type].first)
			return "record array append type mismatch"
		return ""
	if ins.op == MIR_RECORD_SET
		if ins.first < 0 or ins.first >= len(types)
			return "invalid record update source"
		let owner = types[!ins.first]
		if program.types.entries[!owner].tag != TYPE_TAG_RECORD or dst_type != owner
			return "record update requires matching record destination"
		let fields = program.types.entries[!owner].fields
		if ins.immediate < 0 or ins.immediate >= len(fields)
			return "invalid record update field"
		if not mir_register_valid(types, ins.second, fields[!ins.immediate].kind)
			return "record update field type mismatch"
		return ""
	if ins.op == MIR_RECORD_GET
		if ins.first < 0 or ins.first >= len(types)
			return "invalid record source"
		let owner = types[!ins.first]
		if program.types.entries[!owner].tag != TYPE_TAG_RECORD
			return "record field access requires record"
		let fields = program.types.entries[!owner].fields
		if ins.immediate < 0 or ins.immediate >= len(fields)
			return "invalid record field"
		if dst_type != fields[!ins.immediate].kind
			return "record field type mismatch"
		return ""
	if ins.op == MIR_COPY or ins.op == MIR_RETAIN or ins.op == MIR_MOVE
		if not mir_register_valid(types, ins.first, dst_type)
			return "copy/move register type mismatch"
		if ins.op == MIR_RETAIN and not mir_managed_type(program.types, dst_type)
			return "retain requires a managed register"
		if ins.op == MIR_MOVE and (ins.dst == ins.first or not mir_managed_type(program.types, dst_type))
			return "move requires distinct managed registers"
		return ""
	if ins.op == MIR_RELEASE or ins.op == MIR_RELEASE_IF_INIT
		if not mir_managed_type(program.types, dst_type) or ins.first != ins.dst
			return "release requires a managed register"
		return ""
	if ins.op == MIR_STRING_LENGTH
		if dst_type != TYPE_TAG_I64 or not mir_register_valid(types, ins.first, TYPE_TAG_STRING)
			return "string length operand type mismatch"
		return ""
	if ins.op == MIR_STRING_CONCAT
		if dst_type != TYPE_TAG_STRING or not mir_register_valid(types, ins.first, TYPE_TAG_STRING) or not mir_register_valid(types, ins.second, TYPE_TAG_STRING)
			return "string concat operand type mismatch"
		return ""
	if ins.op >= MIR_EQ_STRING and ins.op <= MIR_LE_STRING
		if dst_type != TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, TYPE_TAG_STRING) or not mir_register_valid(types, ins.second, TYPE_TAG_STRING)
			return "string comparison signature mismatch"
		return ""
	if ins.op >= MIR_STRING_SLICE and ins.op <= MIR_STRING_JOIN
		if not mir_register_valid(types, ins.first, TYPE_TAG_STRING)
			return "string operation requires a string receiver"
		if ins.op == MIR_STRING_SLICE
			if dst_type != TYPE_TAG_STRING or not mir_register_valid(types, ins.second, TYPE_TAG_I64) or not mir_register_valid(types, ins.immediate, TYPE_TAG_I64)
				return "string slice signature mismatch"
		elif ins.op == MIR_STRING_BYTE_AT
			if not mir_register_valid(types, ins.second, TYPE_TAG_I64)
				return "string byte_at argument mismatch"
		elif ins.op == MIR_STRING_JOIN
			if ins.second < 0 or ins.second >= len(types)
				return "invalid string join argument"
			let array = program.types.entries[!types[!ins.second]]
			if array.tag != TYPE_TAG_ARRAY or array.first != TYPE_TAG_STRING or dst_type != TYPE_TAG_STRING
				return "string join signature mismatch"
		elif not mir_register_valid(types, ins.second, TYPE_TAG_STRING)
			return "string operation argument type mismatch"
		if ins.op == MIR_STRING_BYTE_AT or ins.op == MIR_STRING_FIND
			let optional = program.types.entries[!dst_type]
			if optional.tag != TYPE_TAG_OPTIONAL or optional.first != TYPE_TAG_I64
				return "string optional result mismatch"
		elif (ins.op == MIR_STRING_STARTS_WITH or ins.op == MIR_STRING_ENDS_WITH) and dst_type != TYPE_TAG_BOOL
			return "string predicate result mismatch"
		return ""
	if ins.op == MIR_CALL or ins.op == MIR_CALL_MOVE
		if ins.immediate < 0 or ins.immediate >= len(program.functions)
			return "invalid callee"
		let callee = program.functions[!ins.immediate]
		if len(ins.inputs) != callee.argument_count or dst_type != callee.return_type
			return "call signature mismatch"
		for i in 0..len(ins.inputs)
			if not mir_register_valid(types, ins.inputs[!i], callee.register_types[!i])
				return "call argument type mismatch"
		if ins.op == MIR_CALL_MOVE
			if ins.dst == ins.first or ins.first < 0 or ins.first >= len(types) or not mir_managed_type(program.types, types[!ins.first])
				return "call move requires a distinct managed register"
			if ins.second < 0
				return "call move requires a nonnegative argument mask"
			var count = 0
			var mask = ins.second
			for i in 0..len(ins.inputs)
				let arg = ins.inputs[!i]
				if arg == ins.first
					count += 1
				if i < 62
					if mask % 2 == 1
						if arg == ins.first or arg == ins.dst or not mir_managed_type(program.types, types[!arg])
							return "call move requires distinct managed arguments"
						for j in 0..i
							if ins.inputs[!j] == arg
								return "call move cannot transfer duplicate arguments"
					mask = mask / 2
				elif mask != 0
					return "call move argument mask exceeds supported width"
			if count != 1 or mask != 0
				return "call move requires one matching argument and a valid mask"
			for i in 0..len(ins.inputs)
				if ins.inputs[!i] == ins.first
					continue
				for j in 0..len(ins.inputs)
					if i != j and ins.inputs[!j] == ins.inputs[!i] and mir_call_move_at(ins, j)
						return "call move cannot transfer duplicate arguments"
		return ""
	if ins.op == MIR_NOT_BOOL
		if dst_type != TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, TYPE_TAG_BOOL)
			return "boolean operand type mismatch"
		return ""
	if ins.op == MIR_NEG_I64
		if dst_type != TYPE_TAG_I64 or not mir_register_valid(types, ins.first, TYPE_TAG_I64)
			return "integer operand type mismatch"
		return ""
	if ins.op == MIR_NEG_F64 or ins.op == MIR_SQRT_F64
		if dst_type != TYPE_TAG_F64 or not mir_register_valid(types, ins.first, TYPE_TAG_F64)
			return "floating unary operand type mismatch"
		return ""
	if ins.op >= MIR_ADD_F64 and ins.op <= MIR_LE_F64
		let comparison = ins.op == MIR_EQ_F64 or ins.op == MIR_LT_F64 or ins.op == MIR_LE_F64
		if comparison and dst_type != TYPE_TAG_BOOL
			return "floating comparison destination must be bool"
		if not comparison and dst_type != TYPE_TAG_F64
			return "floating arithmetic destination must be f64"
		if not mir_register_valid(types, ins.first, TYPE_TAG_F64) or not mir_register_valid(types, ins.second, TYPE_TAG_F64)
			return "floating operand type mismatch"
		return ""
	if ins.op == MIR_EQ_BOOL
		if dst_type != TYPE_TAG_BOOL or not mir_register_valid(types, ins.first, TYPE_TAG_BOOL) or not mir_register_valid(types, ins.second, TYPE_TAG_BOOL)
			return "boolean operand type mismatch"
		return ""
	if ins.op >= MIR_ADD_I64 and ins.op <= MIR_LE_I64
		let comparison = ins.op == MIR_EQ_I64 or ins.op == MIR_LT_I64 or ins.op == MIR_LE_I64
		let required = TYPE_TAG_I64
		if comparison
			if dst_type != TYPE_TAG_BOOL
				return "integer comparison destination must be bool"
		elif dst_type != required
			return "integer arithmetic destination must be i64"
		if not mir_register_valid(types, ins.first, required) or not mir_register_valid(types, ins.second, required)
			return "integer operand type mismatch"
		return ""
	return "unsupported MIR opcode"

# Audit only compiler-produced MIR (after guard insertion). Handwritten MIR
# may deliberately omit guards and rely on the interpreter/C defensive checks.
# This verifies annotation completeness, not CFG dominance of the checks.
# The pipeline can reuse a preceding MIR verification; the public audit below
# still checks arbitrary programs on its own.
def mir_audit_failures_unchecked(program: MirProgram) -> MirFailureAudit
	var guarded = 0
	var aborts = 0
	for function in program.functions
		for block in function.blocks
			for ins in block.instructions
				let failure = mir_failure_info(ins.op)
				if failure.guarded
					if ins.text != "__mir_guarded"
						return MirFailureAudit("unguarded MIR runtime failure", guarded, aborts)
					guarded += 1
				elif ins.text == "__mir_guarded" and ins.op != MIR_CONST_STRING
					# A string literal may contain the marker text; it is not metadata.
					return MirFailureAudit("guard marker on non-fallible MIR instruction", guarded, aborts)
				if failure.abort
					aborts += 1
	return MirFailureAudit("", guarded, aborts)

def mir_audit_failures(program: MirProgram) -> MirFailureAudit
	let error = mir_verify(program)
	if error != ""
		return MirFailureAudit(error, 0, 0)
	return mir_audit_failures_unchecked(program)

# Dictionary keys may be scalars, strings, or acyclic records consisting
# exclusively of hashable fields. Canonical field order defines key identity.
def mir_dict_hashable_key(types: TypeTable, kind: i64) -> bool
	if kind == TYPE_TAG_I64 or kind == TYPE_TAG_BOOL or kind == TYPE_TAG_STRING or kind == TYPE_TAG_F64
		return true
	if kind < TYPE_TAG_RECORD or kind >= len(types.entries)
		return false
	let desc = types.entries[!kind]
	if desc.tag != TYPE_TAG_RECORD
		return false
	for field in desc.fields
		if not mir_dict_hashable_key(types, field.kind)
			return false
	return true

def mir_verify(program: MirProgram) -> string
	# Reject malformed/noncanonical type descriptors before accessing field tables.
	for i in 0..len(program.types.entries)
		let entry = program.types.entries[!i]
		if entry.tag == TYPE_TAG_OPTIONAL
			if entry.first < 0 or entry.first >= i or not mir_type_supported(program.types, entry.first)
				return "invalid or cyclic optional type"
		if entry.tag == TYPE_TAG_DICT
			if entry.first < 0 or entry.first >= i or entry.second < 0 or entry.second >= i
				return "invalid or cyclic dictionary type"
			if not mir_dict_hashable_key(program.types, entry.first)
				return "unsupported dictionary key type"
			if not mir_type_supported(program.types, entry.second)
				return "unsupported dictionary value type"
		if entry.tag == TYPE_TAG_ARRAY
			if entry.first < 0 or entry.first >= i or not mir_type_supported(program.types, entry.first)
				return "invalid or cyclic array element type"
		if entry.tag == TYPE_TAG_RECORD
			for j in 0..len(entry.fields)
				let field = entry.fields[!j]
				if not mir_type_supported(program.types, field.kind)
					return "unsupported record field type"
				if j > 0 and entry.fields[!j - 1].name >= field.name
					return "record field order is not canonical"
				if (program.types.entries[!field.kind].tag == TYPE_TAG_RECORD or program.types.entries[!field.kind].tag == TYPE_TAG_ARRAY or program.types.entries[!field.kind].tag == TYPE_TAG_DICT or program.types.entries[!field.kind].tag == TYPE_TAG_OPTIONAL) and field.kind >= i
					return "cyclic record type descriptor"
	# Validate signatures first: call validation may inspect any callee.
	for function in program.functions
		let count = len(function.register_types)
		if function.argument_count < 0 or function.argument_count > count or not mir_type_supported(program.types, function.return_type)
			return "invalid function signature"
		for type_id in function.register_types
			if not mir_type_supported(program.types, type_id)
				return "unsupported register type"
	for function in program.functions
		if function.entry < 0 or function.entry >= len(function.blocks)
			return "invalid entry block"
		for block in function.blocks
			for ins in block.instructions
				let error = mir_verify_instruction(program, function, ins)
				if error != ""
					return error
			let term = block.terminator
			if term.kind == MIR_JUMP or term.kind == MIR_BRANCH
				if term.target < 0 or term.target >= len(function.blocks)
					return "invalid jump target"
			if term.kind == MIR_BRANCH
				if term.alternative < 0 or term.alternative >= len(function.blocks)
					return "invalid branch target"
				if not mir_register_valid(function.register_types, term.operand, TYPE_TAG_BOOL)
					return "branch condition must be bool"
			elif term.kind == MIR_RETURN
				if not mir_register_valid(function.register_types, term.operand, function.return_type)
					return "return type mismatch"
			elif term.kind != MIR_JUMP and term.kind != MIR_PANIC
				return "invalid block terminator"
	return ""
