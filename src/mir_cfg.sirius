import mir alias Mir

# Precompute CFG incoming edges once for forward and backward data flow.
export def mir_cfg_predecessors(function: Mir.MirFunction) -> Array[Array[i64]]
	var predecessors = Array[Array[i64]]()
	for block in function.blocks
		predecessors = predecessors.append(Array[i64]())
	for i in 0..len(function.blocks)
		let term = function.blocks[!i].terminator
		if term.kind == Mir.MIR_JUMP or term.kind == Mir.MIR_BRANCH
			var incoming = predecessors[!term.target]
			incoming = incoming.append(i)
			predecessors[!term.target] = incoming
		if term.kind == Mir.MIR_BRANCH and term.alternative != term.target
			var incoming = predecessors[!term.alternative]
			incoming = incoming.append(i)
			predecessors[!term.alternative] = incoming
	return predecessors

# CFG topology belongs to MIR, not to ownership. Reuse these facts across
# liveness and ownership analyses while the CFG is unchanged.
export rec MirCfgFacts(reached: Array[i64], predecessors: Array[Array[i64]])

export def mir_cfg_reachable(function: Mir.MirFunction) -> Array[i64]
	var reached = Array[i64]()
	for block in function.blocks
		reached = reached.append(0)
	var queue = Array[i64]().append(function.entry)
	reached[!function.entry] = 1
	var head = 0
	while head < len(queue)
		let i = queue[!head]
		head += 1
		let term = function.blocks[!i].terminator
		if term.kind == Mir.MIR_JUMP or term.kind == Mir.MIR_BRANCH
			if reached[!term.target] == 0
				reached[!term.target] = 1
				queue = queue.append(term.target)
		if term.kind == Mir.MIR_BRANCH and reached[!term.alternative] == 0
			reached[!term.alternative] = 1
			queue = queue.append(term.alternative)
	return reached

# Compatibility entry point for standalone ownership tests and callers.
export def mir_ownership_reachable(function: Mir.MirFunction) -> Array[i64]
	return mir_cfg_reachable(function)

export def mir_cfg_facts(function: Mir.MirFunction) -> MirCfgFacts
	return MirCfgFacts(mir_cfg_reachable(function), mir_cfg_predecessors(function))

# Both forward ownership and backward liveness compare dense register states.
export def mir_cfg_state_equal(left: Array[i64], right: Array[i64]) -> bool
	if len(left) != len(right)
		return false
	for i in 0..len(left)
		if left[!i] != right[!i]
			return false
	return true

# Consuming instructions invalidate their source register. Shared by
# forward ownership and backward lifetime analyses.
export def mir_consumes_source(ins: Mir.MirInstruction) -> bool
	return ins.op == Mir.MIR_MOVE or ins.op == Mir.MIR_RECORD_SET or ins.op == Mir.MIR_ARRAY_SET or ins.op == Mir.MIR_DICT_INSERT or ins.op == Mir.MIR_ARRAY_APPEND or ins.op == Mir.MIR_RECORD_ARRAY_APPEND or ins.op == Mir.MIR_CALL_MOVE or ins.op == Mir.MIR_RECORD_NEW_MOVE or ins.op == Mir.MIR_ARRAY_NEW_MOVE or ins.op == Mir.MIR_RELEASE or ins.op == Mir.MIR_RELEASE_IF_INIT

# Register operands read by an instruction. Literal immediates are excluded.
# Shared by backward liveness and forward definite-initialization analyses.
export def mir_read_add(reads: Array[i64], register: i64) -> Array[i64]
	if register < 0
		return reads
	for existing in reads
		if existing == register
			return reads
	return reads.append(register)

export def mir_instruction_reads(ins: Mir.MirInstruction) -> Array[i64]
	if ins.op == Mir.MIR_CONST_I64 or ins.op == Mir.MIR_CONST_BOOL or ins.op == Mir.MIR_CONST_STRING or ins.op == Mir.MIR_CONST_F64 or ins.op == Mir.MIR_DICT_NEW or ins.op == Mir.MIR_OPTIONAL_NONE or ins.op == Mir.MIR_ARGUMENTS or ins.op == Mir.MIR_FILESYSTEM_ERROR_KIND or ins.op == Mir.MIR_FILESYSTEM_ERROR_CODE or ins.op == Mir.MIR_FUNCTION_REF or ins.op == Mir.MIR_RELEASE_IF_INIT
		# Reuse the instruction's empty input array rather than allocating a
		# new empty Array[i64] on every liveness/ownership query.
		if len(ins.inputs) == 0
			return ins.inputs
		return Array[i64]()
	if ins.op == Mir.MIR_UNION_NEW and ins.first == -1
		return ins.inputs
	if ins.op == Mir.MIR_CALL_INDIRECT
		var reads = [ins.first]
		for argument in ins.inputs
			reads = mir_read_add(reads, argument)
		return reads
	if ins.op == Mir.MIR_WRITE_TEXT
		return [ins.first, ins.second]
	if ins.op == Mir.MIR_CALL or ins.op == Mir.MIR_CALL_MOVE or ins.op == Mir.MIR_RECORD_NEW or ins.op == Mir.MIR_ARRAY_NEW or ins.op == Mir.MIR_RECORD_NEW_MOVE or ins.op == Mir.MIR_ARRAY_NEW_MOVE
		return ins.inputs
	var reads = [ins.first]
	if ins.op == Mir.MIR_DICT_INSERT
		for register in ins.inputs
			reads = mir_read_add(reads, register)
		return reads
	if ins.op == Mir.MIR_ARRAY_SET or ins.op == Mir.MIR_DICT_GET_OR or ins.op == Mir.MIR_STRING_SLICE
		reads = mir_read_add(reads, ins.immediate)
	if (ins.op >= Mir.MIR_ADD_I64 and ins.op <= Mir.MIR_LE_I64) or (ins.op >= Mir.MIR_BIT_AND_I64 and ins.op <= Mir.MIR_SHR_I64) or ins.op == Mir.MIR_EQ_BOOL or ins.op == Mir.MIR_STRING_CONCAT or ins.op == Mir.MIR_ARRAY_GET or ins.op == Mir.MIR_ARRAY_GET_OPTIONAL or ins.op == Mir.MIR_ARRAY_SET or ins.op == Mir.MIR_DICT_GET_OR or ins.op == Mir.MIR_DICT_GET_OPTIONAL or ins.op == Mir.MIR_DICT_NEXT or ins.op == Mir.MIR_DICT_KEY or ins.op == Mir.MIR_DICT_VALUE or ins.op == Mir.MIR_DIV_NO_OVERFLOW_I64 or ins.op == Mir.MIR_ARRAY_INDEX_VALID or ins.op == Mir.MIR_ARRAY_APPEND or ins.op == Mir.MIR_RECORD_SET or ins.op == Mir.MIR_RECORD_ARRAY_APPEND or (ins.op >= Mir.MIR_STRING_SLICE and ins.op <= Mir.MIR_LE_STRING) or (ins.op >= Mir.MIR_ADD_F64 and ins.op <= Mir.MIR_LE_F64)
		reads = mir_read_add(reads, ins.second)
	return reads

