# Forward CFG analysis of definitely initialized MIR registers.
# Every reachable predecessor must provide an owned value before a read.
# This analysis does not transfer ownership at calls or returns: calls borrow
# arguments (callee receives retained references), returns transfer the result.

rec MirOwnershipBlock(incoming: Array[i64], outgoing: Array[i64])
rec MirOwnershipAnalysis(must: Array[MirOwnershipBlock], maybe: Array[MirOwnershipBlock])
rec MirOwnershipEffects(registers: Array[i64], values: Array[i64])

def mir_ownership_top(count: i64) -> Array[i64]
	var values = Array[i64]()
	for i in 0..count
		values = values.append(1)
	return values

def mir_ownership_entry(function: MirFunction) -> Array[i64]
	var values = Array[i64]()
	for i in 0..len(function.register_types)
		var initialized = 0
		if i < function.argument_count
			initialized = 1
		values = values.append(initialized)
	return values

# Join directly into one CoW-owned state instead of allocating a fresh mask
# for every predecessor. The initial state and predecessor states stay intact.
def mir_ownership_join(left: Array[i64], right: Array[i64], maybe: bool) -> Array[i64]
	var joined = left
	for i in 0..len(joined)
		if maybe
			if right[!i] != 0 and joined[!i] == 0
				joined[!i] = 1
		elif right[!i] == 0 and joined[!i] != 0
			joined[!i] = 0
	return joined

# Transfer effects depend only on instruction writes, not the incoming state.
# Cache them per block so the worklist applies at most one CoW state copy.
def mir_ownership_effects(block: MirBlock) -> MirOwnershipEffects
	var registers = Array[i64]()
	var values = Array[i64]()
	for ins in block.instructions
		if mir_consumes_source(ins)
			registers = registers.append(ins.first)
			values = values.append(0)
		if ins.op == MIR_CALL_MOVE
			for i in 0..len(ins.inputs)
				if ins.inputs[!i] != ins.first and mir_call_move_at(ins, i)
					registers = registers.append(ins.inputs[!i])
					values = values.append(0)
		if ins.op != MIR_PRINT and ins.op != MIR_EPRINT and ins.op != MIR_RELEASE and ins.op != MIR_RELEASE_IF_INIT
			registers = registers.append(ins.dst)
			values = values.append(1)
	return MirOwnershipEffects(registers, values)

def mir_ownership_apply_effects(before: Array[i64], effects: MirOwnershipEffects) -> Array[i64]
	var after = before
	for i in 0..len(effects.registers)
		let register = effects.registers[!i]
		let value = effects.values[!i]
		if after[!register] != value
			after[!register] = value
	return after

def mir_ownership_equal(left: Array[i64], right: Array[i64]) -> bool
	if len(left) != len(right)
		return false
	for i in 0..len(left)
		if left[!i] != right[!i]
			return false
	return true

def mir_ownership_after(ins: MirInstruction, before: Array[i64]) -> Array[i64]
	var after = before
	if mir_consumes_source(ins) and after[!ins.first] != 0
		after[!ins.first] = 0
	if ins.op == MIR_CALL_MOVE
		for i in 0..len(ins.inputs)
			if ins.inputs[!i] != ins.first and mir_call_move_at(ins, i) and after[!ins.inputs[!i]] != 0
				after[!ins.inputs[!i]] = 0
	if ins.op != MIR_PRINT and ins.op != MIR_EPRINT and ins.op != MIR_RELEASE and ins.op != MIR_RELEASE_IF_INIT and after[!ins.dst] == 0
		after[!ins.dst] = 1
	return after

# One forward worklist can propagate both must- and may-initialization.
# Single-mode callers avoid calculating the state they do not need.
def mir_ownership_analyze_cfg(function: MirFunction, check_must: bool, check_maybe: bool, reached: Array[i64], predecessors: Array[Array[i64]]) -> MirOwnershipAnalysis
	let top = mir_ownership_top(len(function.register_types))
	var bottom = top
	for i in 0..len(bottom)
		bottom[!i] = 0
	let entry = mir_ownership_entry(function)
	var must = Array[MirOwnershipBlock]()
	var maybe = Array[MirOwnershipBlock]()
	var queued = Array[i64]()
	# Begin at entry; unvisited predecessor states are the lattice identity
	# (top for must, bottom for may). Visit each successor at least once,
	# including when its predecessor happens to retain the initial state.
	var visited = Array[i64]()
	var queue = Array[i64]()
	var effects = Array[MirOwnershipEffects]()
	for i in 0..len(function.blocks)
		effects = effects.append(mir_ownership_effects(function.blocks[!i]))
		if check_must
			must = must.append(MirOwnershipBlock(top, top))
		if check_maybe
			maybe = maybe.append(MirOwnershipBlock(bottom, bottom))
		queued = queued.append(0)
		visited = visited.append(0)
	queue = queue.append(function.entry)
	queued[!function.entry] = 1
	var head = 0
	while head < len(queue)
		let i = queue[!head]
		head += 1
		queued[!i] = 0
		let first_visit = visited[!i] == 0
		visited[!i] = 1
		var changed = false
		if check_must
			var incoming = top
			if i == function.entry
				incoming = entry
			for j in predecessors[!i]
				if reached[!j] != 0
					incoming = mir_ownership_join(incoming, must[!j].outgoing, false)
			let outgoing = mir_ownership_apply_effects(incoming, effects[!i])
			if not mir_ownership_equal(incoming, must[!i].incoming) or not mir_ownership_equal(outgoing, must[!i].outgoing)
				must[!i] = MirOwnershipBlock(incoming, outgoing)
				changed = true
		if check_maybe
			var incoming = bottom
			if i == function.entry
				incoming = entry
			for j in predecessors[!i]
				if reached[!j] != 0
					incoming = mir_ownership_join(incoming, maybe[!j].outgoing, true)
			let outgoing = mir_ownership_apply_effects(incoming, effects[!i])
			if not mir_ownership_equal(incoming, maybe[!i].incoming) or not mir_ownership_equal(outgoing, maybe[!i].outgoing)
				maybe[!i] = MirOwnershipBlock(incoming, outgoing)
				changed = true
		if changed or first_visit
			let term = function.blocks[!i].terminator
			if term.kind == MIR_JUMP or term.kind == MIR_BRANCH
				if queued[!term.target] == 0
					queued[!term.target] = 1
					queue = queue.append(term.target)
			if term.kind == MIR_BRANCH and queued[!term.alternative] == 0
				queued[!term.alternative] = 1
				queue = queue.append(term.alternative)
	return MirOwnershipAnalysis(must, maybe)

def mir_ownership_dataflow_cfg(function: MirFunction, maybe: bool, reached: Array[i64], predecessors: Array[Array[i64]]) -> Array[MirOwnershipBlock]
	if maybe
		return mir_ownership_analyze_cfg(function, false, true, reached, predecessors).maybe
	return mir_ownership_analyze_cfg(function, true, false, reached, predecessors).must

def mir_ownership_dataflow(function: MirFunction, maybe: bool) -> Array[MirOwnershipBlock]
	let cfg = mir_cfg_facts(function)
	return mir_ownership_dataflow_cfg(function, maybe, cfg.reached, cfg.predecessors)

def mir_ownership_states(function: MirFunction) -> Array[MirOwnershipBlock]
	return mir_ownership_dataflow(function, false)

# May-initialized state is the union of incoming paths. Used to establish
# whether cleanup is required even when a register is only owned on some paths.
def mir_ownership_maybe_states(function: MirFunction) -> Array[MirOwnershipBlock]
	return mir_ownership_dataflow(function, true)

# Verify that every exit has transferred or released all managed registers.
# This is a proof about explicit CFG exits, not about implicit runtime panics.
def mir_check_balance(program: MirProgram) -> string
	let error = mir_verify(program)
	if error != ""
		return error
	for function_id in 0..len(program.functions)
		let function = program.functions[!function_id]
		let cfg = mir_cfg_facts(function)
		var managed = Array[i64]()
		for register in 0..len(function.register_types)
			if mir_managed_type(program.types, function.register_types[!register])
				managed = managed.append(register)
		let states = mir_ownership_analyze_cfg(function, true, len(managed) != 0, cfg.reached, cfg.predecessors)
		let problem = mir_ownership_function_states(function, cfg.reached, states.must)
		if problem != ""
			return "MIR function " + str(function_id) + ": " + problem
		if len(managed) == 0
			continue
		let maybe = states.maybe
		for block_id in 0..len(function.blocks)
			if cfg.reached[!block_id] != 0
				let term = function.blocks[!block_id].terminator
				if term.kind == MIR_RETURN or term.kind == MIR_PANIC
					for register in managed
						if maybe[!block_id].outgoing[!register] != 0
							if term.kind != MIR_RETURN or register != term.operand
								return "MIR function " + str(function_id) + ": managed register " + str(register) + " may remain owned at exit block " + str(block_id)
	return ""

# The public ownership checker and balance checker share the same register
# read validation; only the latter requires may-ownership at exits.
def mir_ownership_function_states(function: MirFunction, reached: Array[i64], states: Array[MirOwnershipBlock]) -> string
	for i in 0..len(function.blocks)
		if reached[!i] != 0
			let block = function.blocks[!i]
			var available = states[!i].incoming
			for ins in block.instructions
				for register in mir_instruction_reads(ins)
					if register < 0 or register >= len(available) or available[!register] == 0
						return "MIR read of uninitialized or moved register " + str(register) + " in block " + str(i)
				available = mir_ownership_after(ins, available)
			let term = block.terminator
			if term.kind == MIR_BRANCH or term.kind == MIR_RETURN
				if available[!term.operand] == 0
					return "MIR terminator reads uninitialized or moved register " + str(term.operand) + " in block " + str(i)
	return ""

def mir_ownership_function(function: MirFunction) -> string
	let cfg = mir_cfg_facts(function)
	let states = mir_ownership_dataflow_cfg(function, false, cfg.reached, cfg.predecessors)
	return mir_ownership_function_states(function, cfg.reached, states)

def mir_check_ownership(program: MirProgram) -> string
	let error = mir_verify(program)
	if error != ""
		return error
	for i in 0..len(program.functions)
		let problem = mir_ownership_function(program.functions[!i])
		if problem != ""
			return "MIR function " + str(i) + ": " + problem
	return ""
