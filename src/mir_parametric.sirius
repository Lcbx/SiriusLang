# A conservative reusable HIR body subset. The embedded v5 semantic snapshot
# remains authoritative for declarations and type tables. The symbolic bodies
# are validated against their syntax at the artifact boundary.
let MIR_PARAMETRIC_MAGIC = "SIRIUS-TEMPLATE-HIR/1\n"

def mir_serialize_parametric(tree: ParseState, root: i64, declarations: HirModuleDecl) -> MirWireSave
	let semantic = mir_serialize_semantic(tree, root, declarations)
	if semantic.error != ""
		return semantic
	var parts = [MIR_PARAMETRIC_MAGIC]
	parts = mir_wire_str(parts, semantic.text)
	parts = mir_wire_num(parts, len(declarations.functions))
	for function in declarations.functions
		let plan = hir_parametric_plan(tree, function, declarations.functions)
		parts = mir_wire_num(parts, plan.definition)
		parts = mir_wire_num(parts, plan.result_type)
		parts = mir_wire_num(parts, len(plan.nodes))
		for node in plan.nodes
			parts = mir_wire_num(parts, node.source)
			parts = mir_wire_num(parts, node.operation)
			parts = mir_wire_num(parts, node.type_id)
			parts = mir_wire_num(parts, node.field_index)
	let data = "".join(parts)
	if len(data) > MIR_WIRE_MAX_SIZE
		return MirWireSave("", "parameterized HIR snapshot exceeds format size limit")
	return MirWireSave(data, "")

def mir_deserialize_parametric(data: string) -> MirSemanticLoad
	if len(data) > MIR_WIRE_MAX_SIZE or not data.starts_with(MIR_PARAMETRIC_MAGIC)
		return mir_semantic_failure("unsupported parameterized HIR snapshot")
	var reader = MirWireReader(data, len(MIR_PARAMETRIC_MAGIC), "")
	let semantic = mir_wire_string(reader)
	reader = semantic.reader
	if reader.error != ""
		return mir_semantic_failure(reader.error)
	let restored = mir_deserialize_semantic(semantic.value)
	if restored.error != ""
		return restored
	let count = mir_wire_count(reader)
	reader = count.reader
	if reader.error != "" or count.value != len(restored.declarations.functions)
		return mir_semantic_failure("invalid parameterized HIR declaration count")
	var plans = Array[HirParametricBody]()
	for function in restored.declarations.functions
		let definition = mir_wire_number(reader)
		let result_type = mir_wire_number(definition.reader)
		let size = mir_wire_count(result_type.reader)
		reader = size.reader
		if reader.error != "" or size.value > 4096
			return mir_semantic_failure("invalid parameterized HIR body")
		var nodes = Array[HirNode]()
		for i in 0..size.value
			let source = mir_wire_number(reader)
			let operation = mir_wire_number(source.reader)
			let type_id = mir_wire_number(operation.reader)
			let field_index = mir_wire_number(type_id.reader)
			reader = field_index.reader
			if reader.error != ""
				return mir_semantic_failure(reader.error)
			nodes = nodes.append(HirNode(source.value, operation.value, type_id.value, field_index.value))
		let expected = hir_parametric_plan(restored.tree, function, restored.declarations.functions)
		# A previous v6 compiler may have stored an empty fallback plan for a
		# body that newer compilers now optimize. Its semantic snapshot remains
		# authoritative; do not invalidate the already serialized library.
		if definition.value == expected.definition and result_type.value == TYPE_TAG_INVALID and len(nodes) == 0
			plans = plans.append(HirParametricBody(definition.value, nodes, result_type.value))
			continue
		if definition.value != expected.definition or result_type.value != expected.result_type or len(nodes) != len(expected.nodes)
			return mir_semantic_failure("parameterized HIR metadata mismatch")
		for i in 0..len(nodes)
			let actual = nodes[!i]
			let want = expected.nodes[!i]
			if actual.source != want.source or actual.operation != want.operation or actual.type_id != want.type_id or actual.field_index != want.field_index
				return mir_semantic_failure("parameterized HIR metadata mismatch")
		plans = plans.append(HirParametricBody(definition.value, nodes, result_type.value))
	if reader.error != "" or reader.at != len(data)
		return mir_semantic_failure("invalid parameterized HIR payload")
	var declarations = restored.declarations
	declarations.parametric = plans
	return MirSemanticLoad(restored.tree, restored.root, declarations, "")
