	parts = parts.append("default: s_panic(\"unsupported equality type\"); } }\n")
	var has_composite_keys = false
	for desc in types.entries
		if desc.tag == Types.TYPE_TAG_DICT and Verify.mir_dict_hashable_key(types, desc.first) and desc.first >= Types.TYPE_TAG_RECORD
