						for k in 0..len(types.entries[!alternative].fields)
							parts = parts.append("if (!s_mir_value_equal(" + str(types.entries[!alternative].fields[!k].kind) + ", a.record->fields[" + str(k + 1) + "], b.record->fields[" + str(k + 1) + "], key_comparison)) return false;\n")
