			else
				parts = parts.append("case " + str(i) + ": if (a.record->fields[0].bits != b.record->fields[0].bits) return false;\n")
				parts = parts.append("switch (a.record->fields[0].bits) {\n")
				for j in 0..len(desc.fields)
