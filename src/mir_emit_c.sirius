					else
						parts = parts.append("if (lhs.f" + str(j) + " != rhs.f" + str(j) + ") return false;\n")
				parts = parts.append("}\nreturn true;\n")
			elif mir_c_inline_union(types, desc.first)
				let id = str(desc.first)
				parts = parts.append("for (size_t j = 0; j < a.record->length; ++j) {\n")
				parts = parts.append("S_MirRecord *left = s_mir_array_union_read" + id + "((const void *)s_mir_array_at(a.record, j));\n")
				parts = parts.append("S_MirRecord *right = s_mir_array_union_read" + id + "((const void *)s_mir_array_at(b.record, j));\n")
				parts = parts.append("bool equal = s_mir_value_equal(" + id + ", (S_MirField){.record = left}, (S_MirField){.record = right}, key_comparison);\n")
				parts = parts.append("s_mir_record_release(left); s_mir_record_release(right); if (!equal) return false; }\nreturn true;\n")
			else
				parts = parts.append("for (size_t j = 0; j < a.record->length; ++j) if (!s_mir_value_equal(" + str(desc.first) + ", *s_mir_array_at(a.record, j), *s_mir_array_at(b.record, j), key_comparison)) return false;\nreturn true;\n")
		elif desc.tag == Types.TYPE_TAG_OPTIONAL and Types.type_supports_equality(types, i)
			parts = parts.append("case " + str(i) + ": if (a.record->length != b.record->length) return false;\n")
			parts = parts.append("return a.record->length == 0 || s_mir_value_equal(" + str(desc.first) + ", a.record->fields[0], b.record->fields[0], key_comparison);\n")
		elif desc.tag == Types.TYPE_TAG_UNION and Types.type_supports_equality(types, i)
			if Types.union_is_enum(types, i)
