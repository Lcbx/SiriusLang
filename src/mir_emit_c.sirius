# Experimental typed MIR C backend. Consumes only verified MIR produced by the
# HIR-owned specialization worklist. The legacy emitter remains the default.

def mir_c_type(type_id: i64) -> string
	if type_id == TYPE_TAG_BOOL
		return "bool"
	if type_id == TYPE_TAG_F64
		return "double"
	if type_id == TYPE_TAG_STRING
		return "S_String *"
	if type_id >= TYPE_TAG_RECORD
		return "S_MirRecord *"
	return "int64_t"

def mir_c_register(index: i64) -> string
	return "r" + str(index)

def mir_c_function(index: i64) -> string
	return "s_mir_f" + str(index)

def mir_c_signature(function: MirFunction, index: i64) -> string
	var args = Array[string]()
	for i in 0..function.argument_count
		args = args.append(mir_c_type(function.register_types[!i]) + " a" + str(i))
	if len(args) == 0
		return "static " + mir_c_type(function.return_type) + " " + mir_c_function(index) + "(void)"
	return "static " + mir_c_type(function.return_type) + " " + mir_c_function(index) + "(" + ", ".join(args) + ")"

# Encode every source byte as a three-digit octal escape, so even user-supplied
# panic text cannot inject C source or terminate the C string literal.
def mir_c_string(value: string) -> string
	var result = "\""
	for i in 0..len(value)
		let byte = value.byte_at(i) or 0
		result = result + "\\" + str(byte / 64) + str((byte / 8) % 8) + str(byte % 8)
	return result + "\""

def mir_c_check(index: i64) -> string
	return "\tif (!init" + str(index) + ") s_panic(\"uninitialized register\");\n"

# Managed records and CoW arrays share an owned, type-tagged heap representation.
def mir_c_release_value(type_id: i64, value: string) -> string
	if type_id == TYPE_TAG_STRING
		return "s_string_release(" + value + ")"
	return "s_mir_record_release(" + value + ")"

def mir_c_retain_value(type_id: i64, value: string) -> string
	if type_id == TYPE_TAG_STRING
		return "s_string_retain(" + value + ")"
	return "s_mir_record_retain(" + value + ")"

# Evaluate the incoming value before dropping dst, including self-copies.
def mir_c_store_owned(dst: i64, type_id: i64, expression: string) -> string
	let name = mir_c_register(dst)
	return "\t{ " + mir_c_type(type_id) + " owned = " + expression + "; if (init" + str(dst) + ") " + mir_c_release_value(type_id, name) + "; " + name + " = owned; init" + str(dst) + " = true; }\n"

def mir_c_release_managed(function: MirFunction, except: i64) -> string
	var result = ""
	for i in 0..len(function.register_types)
		let type_id = function.register_types[!i]
		if i != except and mir_common_managed(type_id)
			result = result + "\tif (init" + str(i) + ") " + mir_c_release_value(type_id, mir_c_register(i)) + ";\n"
	return result

def mir_c_record_runtime(types: TypeTable) -> string
	var parts = Array[string]()
	parts = parts.append("typedef struct S_MirRecord S_MirRecord;\n")
	parts = parts.append("typedef struct { int64_t bits; double real; S_String *text; S_MirRecord *record; } S_MirField;\n")
	parts = parts.append("struct S_MirRecord { int64_t type_id; size_t refs, length, capacity; S_MirField fields[]; };\n")
	parts = parts.append("static inline S_MirRecord *s_mir_record_new(int64_t id, size_t fields) {\n")
	parts = parts.append("\tS_MirRecord *r = calloc(1, sizeof(S_MirRecord) + fields * sizeof(S_MirField));\n")
	parts = parts.append("\tif (!r) s_panic(\"out of memory\");\n\tr->type_id = id; r->refs = 1; r->length = fields; r->capacity = fields; return r;\n}\n")
	parts = parts.append("static inline S_MirRecord *s_mir_record_retain(S_MirRecord *r) { if (r) ++r->refs; return r; }\n")
	parts = parts.append("static inline S_MirRecord *s_mir_record_reserve_owned(S_MirRecord *r, size_t need) {\n")
	parts = parts.append("\tif (need <= r->capacity) return r;\n")
	parts = parts.append("\tconst size_t limit = (SIZE_MAX - sizeof(S_MirRecord)) / sizeof(S_MirField);\n")
	parts = parts.append("\tif (need > limit) s_panic(\"collection too large\");\n")
	parts = parts.append("\tsize_t capacity = r->capacity ? r->capacity : 4;\n")
	parts = parts.append("\twhile (capacity < need) capacity = capacity > limit / 2 ? limit : capacity * 2;\n")
	parts = parts.append("\tS_MirRecord *grown = realloc(r, sizeof(S_MirRecord) + capacity * sizeof(S_MirField));\n")
	parts = parts.append("\tif (!grown) s_panic(\"out of memory\");\n\tgrown->capacity = capacity; return grown;\n}\n")
	parts = parts.append("static inline S_String *s_mir_string_join(const S_String *sep, const S_MirRecord *parts) {\n")
	parts = parts.append("\tsize_t total = 0;\n")
	parts = parts.append("\tfor (size_t i = 0; i < parts->length; ++i) {\n")
	parts = parts.append("\t\tconst size_t n = parts->fields[i].text->length;\n")
	parts = parts.append("\t\tif (n > SIZE_MAX - total - sizeof(S_String) - 1) s_panic(\"string too large\");\n")
	parts = parts.append("\t\ttotal += n;\n")
	parts = parts.append("\t\tif (i) { if (sep->length > SIZE_MAX - total - sizeof(S_String) - 1) s_panic(\"string too large\"); total += sep->length; }\n\t}\n")
	parts = parts.append("\tS_String *out = malloc(sizeof(S_String) + total + 1);\n")
	parts = parts.append("\tif (!out) s_panic(\"out of memory\");\n")
	parts = parts.append("\tout->refcount = 1; out->length = total;\n")
	parts = parts.append("\tsize_t at = 0;\n\tfor (size_t i = 0; i < parts->length; ++i) {\n")
	parts = parts.append("\t\tif (i) { memcpy(out->data + at, sep->data, sep->length); at += sep->length; }\n")
	parts = parts.append("\t\tconst S_String *item = parts->fields[i].text;\n")
	parts = parts.append("\t\tmemcpy(out->data + at, item->data, item->length); at += item->length;\n")
	parts = parts.append("\t}\n\tout->data[total] = '\\0';\n\treturn out;\n}\n")
	parts = parts.append("static inline S_MirRecord *s_mir_arguments(int64_t type_id) {\n")
	parts = parts.append("\tS_Array *args = s_arguments();\n\tsize_t count = s_array_length(args);\n")
	parts = parts.append("\tS_MirRecord *out = s_mir_record_new(type_id, count);\n")
	parts = parts.append("\tfor (size_t i = 0; i < count; ++i) out->fields[i].text = s_string_retain(*(S_String *const *)s_array_at(args, (int64_t)i));\n")
	parts = parts.append("\ts_array_release(args);\n\treturn out;\n}\n")
	parts = parts.append("static inline void s_mir_record_release(S_MirRecord *r) {\n\tif (!r || --r->refs) return;\n\tswitch (r->type_id) {\n")
	for i in 0..len(types.entries)
		let type_desc = types.entries[!i]
		if type_desc.tag == TYPE_TAG_RECORD
			parts = parts.append("\tcase " + str(i) + ":\n")
			for j in 0..len(type_desc.fields)
				let field_type = type_desc.fields[!j].kind
				if mir_common_managed(field_type)
					var field = "r->fields[" + str(j) + "]"
					if field_type == TYPE_TAG_STRING
						field = field + ".text"
					else
						field = field + ".record"
					parts = parts.append("\t\t" + mir_c_release_value(field_type, field) + ";\n")
			parts = parts.append("\t\tbreak;\n")
		elif type_desc.tag == TYPE_TAG_OPTIONAL
			parts = parts.append("\tcase " + str(i) + ":\n")
			if mir_common_managed(type_desc.first)
				var field = "r->fields[0]"
				if type_desc.first == TYPE_TAG_STRING
					field = field + ".text"
				else
					field = field + ".record"
				parts = parts.append("\t\tif (r->length) " + mir_c_release_value(type_desc.first, field) + ";\n")
			parts = parts.append("\t\tbreak;\n")
		elif type_desc.tag == TYPE_TAG_DICT
			parts = parts.append("\tcase " + str(i) + ":\n")
			for part in 0..2
				var kind = type_desc.first
				var offset = "0"
				if part == 1
					kind = type_desc.second
					offset = "1"
				if mir_common_managed(kind)
					var field = "r->fields[j + " + offset + "]"
					if kind == TYPE_TAG_STRING
						field = field + ".text"
					else
						field = field + ".record"
					parts = parts.append("\t\tfor (size_t j = 0; j < r->length; j += 2) " + mir_c_release_value(kind, field) + ";\n")
			parts = parts.append("\t\tbreak;\n")
		elif type_desc.tag == TYPE_TAG_ARRAY
			let element_type = type_desc.first
			parts = parts.append("\tcase " + str(i) + ":\n")
			if mir_common_managed(element_type)
				var field = "r->fields[j]"
				if element_type == TYPE_TAG_STRING
					field = field + ".text"
				else
					field = field + ".record"
				parts = parts.append("\t\tfor (size_t j = 0; j < r->length; ++j) " + mir_c_release_value(element_type, field) + ";\n")
			parts = parts.append("\t\tbreak;\n")
	parts = parts.append("\tdefault: s_panic(\"unknown managed type\");\n\t}\n\tfree(r);\n}\n\n")
	parts = parts.append("static inline S_MirRecord *s_mir_array_set_owned(S_MirRecord *array, int64_t index, S_MirField owned) {\n")
	parts = parts.append("\tif (index < 0 || (uint64_t)index >= array->length) s_panic(\"array index out of bounds\");\n")
	parts = parts.append("\tif (array->refs > 1) {\n\t\tS_MirRecord *copy = s_mir_record_new(array->type_id, array->length);\n")
	parts = parts.append("\t\tfor (size_t j = 0; j < array->length; ++j) copy->fields[j] = array->fields[j];\n")
	parts = parts.append("\t\tswitch (array->type_id) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == TYPE_TAG_ARRAY
			parts = parts.append("\t\tcase " + str(i) + ":\n")
			if mir_common_managed(desc.first)
				var field = "copy->fields[j]"
				if desc.first == TYPE_TAG_STRING
					field = field + ".text"
				else
					field = field + ".record"
				parts = parts.append("\t\t\tfor (size_t j = 0; j < copy->length; ++j) " + mir_c_retain_value(desc.first, field) + ";\n")
			parts = parts.append("\t\t\tbreak;\n")
	parts = parts.append("\t\tdefault: s_panic(\"invalid array type\");\n\t\t}\n")
	parts = parts.append("\t\ts_mir_record_release(array); array = copy;\n\t}\n")
	parts = parts.append("\tswitch (array->type_id) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == TYPE_TAG_ARRAY
			parts = parts.append("\tcase " + str(i) + ":\n")
			if mir_common_managed(desc.first)
				var field = "array->fields[index]"
				if desc.first == TYPE_TAG_STRING
					field = field + ".text"
				else
					field = field + ".record"
				parts = parts.append("\t\t" + mir_c_release_value(desc.first, field) + ";\n")
			parts = parts.append("\t\tbreak;\n")
	parts = parts.append("\tdefault: s_panic(\"invalid array type\");\n\t}\n")
	parts = parts.append("\tarray->fields[index] = owned; return array;\n}\n\n")
	parts = parts.append("static inline S_MirRecord *s_mir_array_append_owned(S_MirRecord *array, S_MirField owned) {\n")
	parts = parts.append("\tif (array->refs > 1) {\n")
	parts = parts.append("\t\tS_MirRecord *copy = s_mir_record_new(array->type_id, array->length);\n")
	parts = parts.append("\t\tfor (size_t j = 0; j < array->length; ++j) copy->fields[j] = array->fields[j];\n")
	parts = parts.append("\t\tswitch (array->type_id) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == TYPE_TAG_ARRAY
			parts = parts.append("\t\tcase " + str(i) + ":\n")
			if mir_common_managed(desc.first)
				var field = "copy->fields[j]"
				if desc.first == TYPE_TAG_STRING
					field = field + ".text"
				else
					field = field + ".record"
				parts = parts.append("\t\t\tfor (size_t j = 0; j < copy->length; ++j) " + mir_c_retain_value(desc.first, field) + ";\n")
			parts = parts.append("\t\t\tbreak;\n")
	parts = parts.append("\t\tdefault: s_panic(\"invalid array type\");\n\t\t}\n")
	parts = parts.append("\t\ts_mir_record_release(array); array = copy;\n\t}\n")
	parts = parts.append("\tarray = s_mir_record_reserve_owned(array, array->length + 1);\n")
	parts = parts.append("\tarray->fields[array->length++] = owned;\n\treturn array;\n}\n\n")
	parts = parts.append("static inline bool s_mir_key_equal(int64_t type_id, S_MirField a, S_MirField b) {\n")
	parts = parts.append("\tif (type_id == " + str(TYPE_TAG_STRING) + ") return (s_string_compare(a.text, b.text) == 0);\n")
	parts = parts.append("\tif (type_id == " + str(TYPE_TAG_F64) + ") return a.real == b.real;\n\treturn a.bits == b.bits;\n}\n")
	parts = parts.append("static inline int64_t s_mir_dict_find(const S_MirRecord *dict, int64_t key_type, S_MirField key) {\n")
	parts = parts.append("\tfor (size_t j = 0; j < dict->length; j += 2) if (s_mir_key_equal(key_type, dict->fields[j], key)) return (int64_t)j;\n")
	parts = parts.append("\treturn -1;\n}\n")
	parts = parts.append("static inline S_MirRecord *s_mir_dict_insert_owned(S_MirRecord *dict, int64_t key_type, S_MirField key, S_MirField value) {\n")
	parts = parts.append("\tif (dict->refs > 1) {\n\t\tS_MirRecord *copy = s_mir_record_new(dict->type_id, dict->length);\n")
	parts = parts.append("\t\tfor (size_t j = 0; j < dict->length; ++j) copy->fields[j] = dict->fields[j];\n")
	parts = parts.append("\t\tswitch (dict->type_id) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == TYPE_TAG_DICT
			parts = parts.append("\t\tcase " + str(i) + ":\n")
			for part in 0..2
				var kind = desc.first
				var offset = "0"
				if part == 1
					kind = desc.second
					offset = "1"
				if mir_common_managed(kind)
					var field = "copy->fields[j + " + offset + "]"
					if kind == TYPE_TAG_STRING
						field = field + ".text"
					else
						field = field + ".record"
					parts = parts.append("\t\t\tfor (size_t j = 0; j < copy->length; j += 2) " + mir_c_retain_value(kind, field) + ";\n")
			parts = parts.append("\t\t\tbreak;\n")
	parts = parts.append("\t\tdefault: s_panic(\"invalid dictionary type\");\n\t\t}\n")
	parts = parts.append("\t\ts_mir_record_release(dict); dict = copy;\n\t}\n")
	parts = parts.append("\tint64_t at = s_mir_dict_find(dict, key_type, key);\n")
	parts = parts.append("\tif (at < 0) {\n\t\tif (dict->length > (SIZE_MAX - sizeof(S_MirRecord)) / sizeof(S_MirField) - 2) s_panic(\"dictionary too large\");\n")
	parts = parts.append("\t\tdict = s_mir_record_reserve_owned(dict, dict->length + 2);\n")
	parts = parts.append("\t\tat = (int64_t)dict->length; dict->length += 2;\n\t} else {\n")
	parts = parts.append("\t\tswitch (dict->type_id) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == TYPE_TAG_DICT
			parts = parts.append("\t\tcase " + str(i) + ":\n")
			for part in 0..2
				var kind = desc.first
				var offset = "0"
				if part == 1
					kind = desc.second
					offset = "1"
				if mir_common_managed(kind)
					var field = "dict->fields[at + " + offset + "]"
					if kind == TYPE_TAG_STRING
						field = field + ".text"
					else
						field = field + ".record"
					parts = parts.append("\t\t\t" + mir_c_release_value(kind, field) + ";\n")
			parts = parts.append("\t\t\tbreak;\n")
	parts = parts.append("\t\tdefault: s_panic(\"invalid dictionary type\");\n\t\t}\n\t}\n")
	parts = parts.append("\tdict->fields[at] = key; dict->fields[at + 1] = value; return dict;\n}\n\n")
	parts = parts.append("static inline S_MirRecord *s_mir_optional_from_array(S_MirRecord *array, int64_t index, int64_t optional_type) {\n")
	parts = parts.append("\tS_MirRecord *optional = s_mir_record_new(optional_type, index < 0 || (uint64_t)index >= array->length ? 0 : 1);\n")
	parts = parts.append("\tif (optional->length) { optional->fields[0] = array->fields[index]; switch (optional_type) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == TYPE_TAG_OPTIONAL
			parts = parts.append("\tcase " + str(i) + ": ")
			if mir_common_managed(desc.first)
				var field = "optional->fields[0]"
				if desc.first == TYPE_TAG_STRING
					field = field + ".text"
				else
					field = field + ".record"
				parts = parts.append(mir_c_retain_value(desc.first, field) + "; ")
			parts = parts.append("break;\n")
	parts = parts.append("\tdefault: s_panic(\"invalid optional type\");\n\t} } return optional;\n}\n\n")
	parts = parts.append("static inline S_MirRecord *s_mir_optional_from_dict(S_MirRecord *dict, int64_t at, int64_t optional_type) {\n")
	parts = parts.append("\tS_MirRecord *optional = s_mir_record_new(optional_type, at < 0 ? 0 : 1);\n")
	parts = parts.append("\tif (at >= 0) { optional->fields[0] = dict->fields[at + 1]; switch (optional_type) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == TYPE_TAG_OPTIONAL
			parts = parts.append("\tcase " + str(i) + ": ")
			if mir_common_managed(desc.first)
				var field = "optional->fields[0]"
				if desc.first == TYPE_TAG_STRING
					field = field + ".text"
				else
					field = field + ".record"
				parts = parts.append(mir_c_retain_value(desc.first, field) + "; ")
			parts = parts.append("break;\n")
	parts = parts.append("\tdefault: s_panic(\"invalid optional type\");\n\t} } return optional;\n}\n\n")
	return "".join(parts)

def mir_c_instruction(instruction: MirInstruction, function: MirFunction) -> string
	let op = instruction.op
	var result = ""
	if op != MIR_CONST_I64 and op != MIR_CONST_BOOL and op != MIR_CONST_STRING and op != MIR_CONST_F64 and op != MIR_ARGUMENTS and op != MIR_RELEASE_IF_INIT
		if op == MIR_CALL or op == MIR_RECORD_NEW or op == MIR_ARRAY_NEW or op == MIR_DICT_NEW or op == MIR_OPTIONAL_NONE
			for arg in instruction.inputs
				result = result + mir_c_check(arg)
		else
			result = result + mir_c_check(instruction.first)
			if op == MIR_WRITE_TEXT
				result = result + mir_c_check(instruction.second)
			if op == MIR_DICT_INSERT
				for arg in instruction.inputs
					result = result + mir_c_check(arg)
			if op >= MIR_ADD_I64 and op <= MIR_LE_I64 or op == MIR_EQ_BOOL or op == MIR_ARRAY_GET or op == MIR_ARRAY_GET_OPTIONAL or op == MIR_ARRAY_SET or op == MIR_DICT_GET_OR or op == MIR_DICT_GET_OPTIONAL or op == MIR_ARRAY_APPEND or op == MIR_DIV_NO_OVERFLOW_I64 or op == MIR_ARRAY_INDEX_VALID or (op >= MIR_STRING_SLICE and op <= MIR_LE_STRING) or (op >= MIR_ADD_F64 and op <= MIR_LE_F64)
				result = result + mir_c_check(instruction.second)
			if op == MIR_ARRAY_SET or op == MIR_DICT_GET_OR or op == MIR_STRING_SLICE
				result = result + mir_c_check(instruction.immediate)
	if op == MIR_PRINT
		return result
	let dst = mir_c_register(instruction.dst)
	var expr = ""
	let first = mir_c_register(instruction.first)
	let second = mir_c_register(instruction.second)
	let dst_type = function.register_types[!instruction.dst]
	if op == MIR_ARGUMENTS
		return mir_c_store_owned(instruction.dst, dst_type, "s_mir_arguments(" + str(dst_type) + ")")
	if op == MIR_STR_I64
		return result + mir_c_store_owned(instruction.dst, dst_type, "s_string_from_i64(" + first + ")")
	if op == MIR_READ_TEXT
		var code = result + "\t{ S_Optional_string value = s_read_text(" + first + ");\n"
		code = code + "\t\tS_MirRecord *optional = s_mir_record_new(" + str(dst_type) + ", value.has_value ? 1 : 0);\n"
		code = code + "\t\tif (value.has_value) optional->fields[0].text = value.value;\n"
		return code + mir_c_store_owned(instruction.dst, dst_type, "optional") + "\t}\n"
	if op == MIR_WRITE_TEXT
		return result + "\t" + dst + " = s_write_text(" + first + ", " + second + "); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_CONST_STRING
		return mir_c_store_owned(instruction.dst, TYPE_TAG_STRING, "s_string_from_bytes(" + mir_c_string(instruction.text) + ", " + str(len(instruction.text)) + ")")
	if op == MIR_CONST_F64
		return "\t" + dst + " = " + instruction.text + "; init" + str(instruction.dst) + " = true;\n"
	if op == MIR_SQRT_F64
		return result + "\t" + dst + " = sqrt(" + first + "); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_OPTIONAL_NONE
		return mir_c_store_owned(instruction.dst, dst_type, "s_mir_record_new(" + str(dst_type) + ", 0)")
	if op == MIR_OPTIONAL_SOME
		let payload_type = function.register_types[!instruction.first]
		var field = "bits"
		var value = first
		if payload_type == TYPE_TAG_F64
			field = "real"
		elif payload_type == TYPE_TAG_STRING
			field = "text"
			value = mir_c_retain_value(payload_type, value)
		elif mir_common_managed(payload_type)
			field = "record"
			value = mir_c_retain_value(payload_type, value)
		let code = result + "\t{ S_MirRecord *optional = s_mir_record_new(" + str(dst_type) + ", 1);\n"
		return code + "\t\toptional->fields[0]." + field + " = " + value + ";\n" + mir_c_store_owned(instruction.dst, dst_type, "optional") + "\t}\n"
	if op == MIR_NONZERO_I64
		return result + "\t" + dst + " = (" + first + " != 0); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_DIV_NO_OVERFLOW_I64
		return result + "\t" + dst + " = !(" + first + " == INT64_MIN && " + second + " == -1); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_ARRAY_INDEX_VALID
		return result + "\t" + dst + " = (" + second + " >= 0 && (uint64_t)" + second + " < " + first + "->length); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_OPTIONAL_HAS
		return result + "\t" + dst + " = (" + first + "->length != 0); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_OPTIONAL_UNWRAP
		var field = "bits"
		if dst_type == TYPE_TAG_F64
			field = "real"
		elif dst_type == TYPE_TAG_STRING
			field = "text"
		elif mir_common_managed(dst_type)
			field = "record"
		let value = first + "->fields[0]." + field
		result = result + "\tif (!" + first + "->length) s_panic(\"missing optional value\");\n"
		if mir_common_managed(dst_type)
			return result + mir_c_store_owned(instruction.dst, dst_type, mir_c_retain_value(dst_type, value))
		return result + "\t" + dst + " = " + value + "; init" + str(instruction.dst) + " = true;\n"
	if op == MIR_DICT_NEW
		return mir_c_store_owned(instruction.dst, dst_type, "s_mir_record_new(" + str(dst_type) + ", 0)")
	if op == MIR_DICT_LENGTH
		return result + "\t" + dst + " = (int64_t)(" + first + "->length / 2); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_DICT_INSERT
		var fields = Array[string]()
		for input in instruction.inputs
			let kind = function.register_types[!input]
			var field = "bits"
			var value = mir_c_register(input)
			if kind == TYPE_TAG_F64
				field = "real"
			elif kind == TYPE_TAG_STRING
				field = "text"
				value = mir_c_retain_value(kind, value)
			elif mir_common_managed(kind)
				field = "record"
				value = mir_c_retain_value(kind, value)
			fields = fields.append(field + " = " + value)
		let key_type = function.register_types[!instruction.inputs[!0]]
		var code = result + "\t{ S_MirField key = {0}, value = {0}; key." + fields[!0] + "; value." + fields[!1] + ";\n"
		code = code + "\t\tS_MirRecord *updated = s_mir_dict_insert_owned(" + first + ", " + str(key_type) + ", key, value);\n"
		code = code + "\t\t" + first + " = NULL; init" + str(instruction.first) + " = false;\n"
		if instruction.dst == instruction.first
			return code + "\t\t" + dst + " = updated; init" + str(instruction.dst) + " = true; }\n"
		return code + mir_c_store_owned(instruction.dst, dst_type, "updated") + "\t}\n"
	if op == MIR_DICT_GET_OPTIONAL
		let key_type = function.register_types[!instruction.second]
		var key_field = "bits"
		if key_type == TYPE_TAG_F64
			key_field = "real"
		elif key_type == TYPE_TAG_STRING
			key_field = "text"
		# The helper retains the dictionary payload using its canonical Optional type.
		var code = result + "\t{ S_MirField key = {0}; key." + key_field + " = " + second + ";\n"
		code = code + "\t\tint64_t at = s_mir_dict_find(" + first + ", " + str(key_type) + ", key);\n"
		return code + mir_c_store_owned(instruction.dst, dst_type, "s_mir_optional_from_dict(" + first + ", at, " + str(dst_type) + ")") + "\t}\n"
	if op == MIR_DICT_GET_OR
		let key_type = function.register_types[!instruction.second]
		var key_field = "bits"
		if key_type == TYPE_TAG_F64
			key_field = "real"
		elif key_type == TYPE_TAG_STRING
			key_field = "text"
		var value_field = "bits"
		if dst_type == TYPE_TAG_F64
			value_field = "real"
		elif dst_type == TYPE_TAG_STRING
			value_field = "text"
		elif mir_common_managed(dst_type)
			value_field = "record"
		var code = result + "\t{ S_MirField key = {0}; key." + key_field + " = " + second + ";\n"
		code = code + "\t\tint64_t at = s_mir_dict_find(" + first + ", " + str(key_type) + ", key);\n"
		let fallback = mir_c_register(instruction.immediate)
		let value = "(at < 0 ? " + fallback + " : " + first + "->fields[at + 1]." + value_field + ")"
		if mir_common_managed(dst_type)
			return code + mir_c_store_owned(instruction.dst, dst_type, mir_c_retain_value(dst_type, value)) + "\t}\n"
		return code + "\t\t" + dst + " = " + value + "; init" + str(instruction.dst) + " = true; }\n"
	if op == MIR_ARRAY_NEW
		var code = result + "\t{ S_MirRecord *array = s_mir_record_new(" + str(dst_type) + ", " + str(len(instruction.inputs)) + ");\n"
		for i in 0..len(instruction.inputs)
			let arg = instruction.inputs[!i]
			let kind = function.register_types[!arg]
			var field = "bits"
			var value = mir_c_register(arg)
			if kind == TYPE_TAG_F64
				field = "real"
			elif kind == TYPE_TAG_STRING
				field = "text"
				value = mir_c_retain_value(kind, value)
			elif mir_common_managed(kind)
				field = "record"
				value = mir_c_retain_value(kind, value)
			code = code + "\t\tarray->fields[" + str(i) + "]." + field + " = " + value + ";\n"
		return code + mir_c_store_owned(instruction.dst, dst_type, "array") + "\t}\n"
	if op == MIR_ARRAY_LENGTH
		return result + "\t" + dst + " = (int64_t)" + first + "->length; init" + str(instruction.dst) + " = true;\n"
	if op == MIR_ARRAY_GET_OPTIONAL
		# The helper retains the array element using the canonical Optional type.
		return result + mir_c_store_owned(instruction.dst, dst_type, "s_mir_optional_from_array(" + first + ", " + second + ", " + str(dst_type) + ")")
	if op == MIR_ARRAY_GET
		result = result + "\tif (" + second + " < 0 || (uint64_t)" + second + " >= " + first + "->length) s_panic(\"array index out of bounds\");\n"
		var field = "bits"
		if dst_type == TYPE_TAG_F64
			field = "real"
		elif dst_type == TYPE_TAG_STRING
			field = "text"
		elif mir_common_managed(dst_type)
			field = "record"
		let value = first + "->fields[" + second + "]." + field
		if mir_common_managed(dst_type)
			return result + mir_c_store_owned(instruction.dst, dst_type, mir_c_retain_value(dst_type, value))
		return result + "\t" + dst + " = " + value + "; init" + str(instruction.dst) + " = true;\n"
	if op == MIR_ARRAY_APPEND
		let element_type = function.register_types[!instruction.second]
		var field = "bits"
		var value = mir_c_register(instruction.second)
		if element_type == TYPE_TAG_F64
			field = "real"
		elif element_type == TYPE_TAG_STRING
			field = "text"
			value = mir_c_retain_value(element_type, value)
		elif mir_common_managed(element_type)
			field = "record"
			value = mir_c_retain_value(element_type, value)
		var code = result + "\t{ S_MirField added = {0}; added." + field + " = " + value + ";\n"
		code = code + "\t\tS_MirRecord *updated = s_mir_array_append_owned(" + first + ", added);\n"
		code = code + "\t\t" + first + " = NULL; init" + str(instruction.first) + " = false;\n"
		if instruction.dst == instruction.first
			return code + "\t\t" + dst + " = updated; init" + str(instruction.dst) + " = true; }\n"
		return code + mir_c_store_owned(instruction.dst, dst_type, "updated") + "\t}\n"
	if op == MIR_ARRAY_SET
		let element_type = function.register_types[!instruction.immediate]
		var field = "bits"
		var value = mir_c_register(instruction.immediate)
		if element_type == TYPE_TAG_F64
			field = "real"
		elif element_type == TYPE_TAG_STRING
			field = "text"
			value = mir_c_retain_value(element_type, value)
		elif mir_common_managed(element_type)
			field = "record"
			value = mir_c_retain_value(element_type, value)
		var code = result + "\t{ S_MirField replacement = {0}; replacement." + field + " = " + value + ";\n"
		code = code + "\t\tS_MirRecord *updated = s_mir_array_set_owned(" + first + ", " + second + ", replacement);\n"
		code = code + "\t\t" + first + " = NULL; init" + str(instruction.first) + " = false;\n"
		if instruction.dst == instruction.first
			return code + "\t\t" + dst + " = updated; init" + str(instruction.dst) + " = true; }\n"
		return code + mir_c_store_owned(instruction.dst, dst_type, "updated") + "\t}\n"
	if op == MIR_RECORD_NEW
		var code = result + "\t{ S_MirRecord *record = s_mir_record_new(" + str(dst_type) + ", " + str(len(instruction.inputs)) + ");\n"
		for i in 0..len(instruction.inputs)
			let arg = instruction.inputs[!i]
			let kind = function.register_types[!arg]
			var field = "bits"
			var value = mir_c_register(arg)
			if kind == TYPE_TAG_F64
				field = "real"
			elif kind == TYPE_TAG_STRING
				field = "text"
				value = mir_c_retain_value(kind, value)
			elif kind >= TYPE_TAG_RECORD
				field = "record"
				value = mir_c_retain_value(kind, value)
			code = code + "\t\trecord->fields[" + str(i) + "]." + field + " = " + value + ";\n"
		return code + mir_c_store_owned(instruction.dst, dst_type, "record") + "\t}\n"
	if op == MIR_RECORD_GET
		var field = "bits"
		if dst_type == TYPE_TAG_F64
			field = "real"
		elif dst_type == TYPE_TAG_STRING
			field = "text"
		elif dst_type >= TYPE_TAG_RECORD
			field = "record"
		let value = first + "->fields[" + str(instruction.immediate) + "]." + field
		if mir_common_managed(dst_type)
			return result + mir_c_store_owned(instruction.dst, dst_type, mir_c_retain_value(dst_type, value))
		return result + "\t" + dst + " = " + value + "; init" + str(instruction.dst) + " = true;\n"
	if op == MIR_RELEASE_IF_INIT
		return "\tif (init" + str(instruction.dst) + ") { " + mir_c_release_value(dst_type, dst) + "; " + dst + " = NULL; init" + str(instruction.dst) + " = false; }\n"
	if op == MIR_RELEASE
		return result + "\t" + mir_c_release_value(dst_type, dst) + "; " + dst + " = NULL; init" + str(instruction.dst) + " = false;\n"
	if op == MIR_MOVE
		var transfer = result + "\t{ " + mir_c_type(dst_type) + " owned = " + first + "; " + first + " = NULL; init" + str(instruction.first) + " = false; "
		transfer = transfer + "if (init" + str(instruction.dst) + ") " + mir_c_release_value(dst_type, dst) + "; " + dst + " = owned; init" + str(instruction.dst) + " = true; }\n"
		return transfer
	if op == MIR_COPY or op == MIR_RETAIN
		if mir_common_managed(dst_type)
			return result + mir_c_store_owned(instruction.dst, dst_type, mir_c_retain_value(dst_type, first))
	if op == MIR_STRING_CONCAT
		result = result + mir_c_check(instruction.second)
		return result + mir_c_store_owned(instruction.dst, TYPE_TAG_STRING, "s_string_concat(" + first + ", " + second + ")")
	if op == MIR_STRING_LENGTH
		return result + "\t" + dst + " = (int64_t)s_string_length(" + first + "); init" + str(instruction.dst) + " = true;\n"
	if op >= MIR_EQ_STRING and op <= MIR_LE_STRING
		var comparison = " == 0"
		if op == MIR_LT_STRING
			comparison = " < 0"
		elif op == MIR_LE_STRING
			comparison = " <= 0"
		return result + "\t" + dst + " = (s_string_compare(" + first + ", " + second + ")" + comparison + "); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_STRING_SLICE
		return result + mir_c_store_owned(instruction.dst, dst_type, "s_string_slice(" + first + ", " + second + ", " + mir_c_register(instruction.immediate) + ")")
	if op == MIR_STRING_STARTS_WITH or op == MIR_STRING_ENDS_WITH
		var name = "s_string_starts_with"
		if op == MIR_STRING_ENDS_WITH
			name = "s_string_ends_with"
		return result + "\t" + dst + " = " + name + "(" + first + ", " + second + "); init" + str(instruction.dst) + " = true;\n"
	if op == MIR_STRING_JOIN
		return result + mir_c_store_owned(instruction.dst, dst_type, "s_mir_string_join(" + first + ", " + second + ")")
	if op == MIR_STRING_FIND or op == MIR_STRING_BYTE_AT
		var name = "s_string_find"
		if op == MIR_STRING_BYTE_AT
			name = "s_string_byte_at"
		let code = result + "\t{ S_Optional_i64 value = " + name + "(" + first + ", " + second + ");\n"
		let wrapped = code + "\t\tS_MirRecord *optional = s_mir_record_new(" + str(dst_type) + ", value.has_value ? 1 : 0);\n"
		return wrapped + "\t\tif (value.has_value) optional->fields[0].bits = value.value;\n" + mir_c_store_owned(instruction.dst, dst_type, "optional") + "\t}\n"
	if op == MIR_CONST_I64
		if instruction.immediate == (-9223372036854775807 - 1)
			expr = "INT64_MIN"
		else
			expr = "INT64_C(" + str(instruction.immediate) + ")"
	elif op == MIR_CONST_BOOL
		if instruction.immediate == 1
			expr = "true"
		else
			expr = "false"
	elif op == MIR_COPY
		expr = first
	elif op == MIR_NEG_I64 or op == MIR_NEG_F64
		expr = "(-" + first + ")"
	elif op == MIR_NOT_BOOL
		expr = "(!" + first + ")"
	elif op == MIR_CALL
		var arguments = Array[string]()
		for arg in instruction.inputs
			var value = mir_c_register(arg)
			if mir_common_managed(function.register_types[!arg])
				value = mir_c_retain_value(function.register_types[!arg], value)
			arguments = arguments.append(value)
		if len(arguments) == 0
			expr = mir_c_function(instruction.immediate) + "()"
		else
			expr = mir_c_function(instruction.immediate) + "(" + ", ".join(arguments) + ")"
	else
		var symbol = ""
		if op == MIR_ADD_I64 or op == MIR_ADD_F64
			symbol = "+"
		elif op == MIR_SUB_I64 or op == MIR_SUB_F64
			symbol = "-"
		elif op == MIR_MUL_I64 or op == MIR_MUL_F64
			symbol = "*"
		elif op == MIR_DIV_I64 or op == MIR_DIV_F64
			symbol = "/"
		elif op == MIR_REM_I64
			symbol = "%"
		elif op == MIR_EQ_I64 or op == MIR_EQ_BOOL or op == MIR_EQ_F64
			symbol = "=="
		elif op == MIR_LT_I64 or op == MIR_LT_F64
			symbol = "<"
		elif op == MIR_LE_I64 or op == MIR_LE_F64
			symbol = "<="
		if op == MIR_DIV_I64 or op == MIR_REM_I64
			result = result + "\tif (" + second + " == 0) s_panic(\"division by zero\");\n"
			result = result + "\tif (" + first + " == INT64_MIN && " + second + " == -1) s_panic(\"integer overflow\");\n"
		expr = "(" + first + " " + symbol + " " + second + ")"
	if mir_common_managed(dst_type)
		return result + mir_c_store_owned(instruction.dst, dst_type, expr)
	return result + "\t" + dst + " = " + expr + "; init" + str(instruction.dst) + " = true;\n"

def mir_c_terminator(term: MirTerminator, function: MirFunction) -> string
	if term.kind == MIR_JUMP
		return "\tgoto block" + str(term.target) + ";\n"
	if term.kind == MIR_BRANCH
		return mir_c_check(term.operand) + "\tif (" + mir_c_register(term.operand) + ") goto block" + str(term.target) + ";\n\tgoto block" + str(term.alternative) + ";\n"
	if term.kind == MIR_RETURN
		var result = mir_c_check(term.operand) + "\treturned = " + mir_c_register(term.operand) + ";\n"
		if mir_common_managed(function.return_type)
			result = result + "\tinit" + str(term.operand) + " = false;\n"
		return result + "\tgoto exit;\n"
	return "\ts_panic(" + mir_c_string(term.message) + ");\n"

def mir_c_definition(function: MirFunction, index: i64) -> string
	var parts = Array[string]()
	parts = parts.append(mir_c_signature(function, index) + "\n{\n")
	for i in 0..len(function.register_types)
		var initial = "0"
		if mir_common_managed(function.register_types[!i])
			initial = "NULL"
		parts = parts.append("\t" + mir_c_type(function.register_types[!i]) + " " + mir_c_register(i) + " = " + initial + ";\n")
		parts = parts.append("\tbool init" + str(i) + " = false;\n")
		parts = parts.append("\t(void)" + mir_c_register(i) + "; (void)init" + str(i) + ";\n")
	for i in 0..function.argument_count
		parts = parts.append("\t" + mir_c_register(i) + " = a" + str(i) + "; init" + str(i) + " = true;\n")
	var has_return = false
	for block in function.blocks
		if block.terminator.kind == MIR_RETURN
			has_return = true
	if has_return
		parts = parts.append("\t" + mir_c_type(function.return_type) + " returned = 0;\n")
	parts = parts.append("\tgoto block" + str(function.entry) + ";\n")
	for i in 0..len(function.blocks)
		let block = function.blocks[!i]
		parts = parts.append("block" + str(i) + ": ;\n")
		for instruction in block.instructions
			if instruction.op == MIR_PRINT
				parts = parts.append(mir_c_check(instruction.first))
				if function.register_types[!instruction.first] == TYPE_TAG_F64
					parts = parts.append("\ts_print_f64(" + mir_c_register(instruction.first) + ");\n")
				elif function.register_types[!instruction.first] == TYPE_TAG_BOOL
					parts = parts.append("\ts_print_bool(" + mir_c_register(instruction.first) + ");\n")
				elif function.register_types[!instruction.first] == TYPE_TAG_STRING
					parts = parts.append("\ts_print_string(" + mir_c_register(instruction.first) + ");\n")
				else
					parts = parts.append("\ts_print_i64(" + mir_c_register(instruction.first) + ");\n")
			else
				parts = parts.append(mir_c_instruction(instruction, function))
		parts = parts.append(mir_c_terminator(block.terminator, function))
	if has_return
		parts = parts.append("exit: ;\n")
		parts = parts.append(mir_c_release_managed(function, -1))
		parts = parts.append("\treturn returned;\n")
	parts = parts.append("}\n")
	return "".join(parts)

rec MirCResult(code: string, error: string)

def mir_emit_c(program: MirProgram, entry: i64) -> MirCResult
	let error = mir_common_entry_error(program, entry)
	if error != ""
		return MirCResult("", error)
	let main = program.functions[!entry]
	if main.argument_count != 0 or main.return_type != TYPE_TAG_I64
		return MirCResult("", "MIR C entry must be main() -> i64")
	var parts = Array[string]()
	parts = parts.append("#include <stdint.h>\n#include <stdbool.h>\n#include <stdio.h>\n#include <limits.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include \"sirius_runtime.h\"\n\n")
	parts = parts.append(mir_c_record_runtime(program.types))
	for i in 0..len(program.functions)
		parts = parts.append(mir_c_signature(program.functions[!i], i) + ";\n")
	parts = parts.append("\n")
	for i in 0..len(program.functions)
		parts = parts.append(mir_c_definition(program.functions[!i], i) + "\n")
	parts = parts.append("int main(int argc, char **argv) { s_set_arguments(argc, argv); return (int)" + mir_c_function(entry) + "(); }\n")
	return MirCResult("".join(parts), "")

# Opt-in pipeline: parse -> specialized HIR worklist -> linked CFG MIR -> C.
# Failure is explicit, never an implicit fallback to the old emitter.
def compile_c_mir(source: string) -> CompileResult
	let parsed = parse_module(source)
	if parsed.state.error != ""
		return CompileResult("", parsed.state.error, parsed.state.error_line)
	let declarations = hir_module_declarations(parsed.state, parsed.node)
	if declarations.error != ""
		return CompileResult("", declarations.error, declarations.error_line)
	let lowered = mir_build_program(parsed.state, declarations, "main", Array[i64]())
	if lowered.error != ""
		return CompileResult("", lowered.error, 1)
	let emitted = mir_emit_c(lowered.program, lowered.entry)
	return CompileResult(emitted.code, emitted.error, 1)
