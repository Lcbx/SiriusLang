	parts = parts.append("\tcase S_MIR_ELEMENT_POD: case S_MIR_ELEMENT_INLINE: break;\n")
	parts = parts.append("\tcase S_MIR_ELEMENT_STRING: slot->text = s_string_retain(slot->text); break;\n")
	parts = parts.append("\tcase S_MIR_ELEMENT_OBJECT: slot->record = s_mir_record_retain(slot->record); break;\n")
	parts = parts.append("\tcase S_MIR_ELEMENT_UNION: switch (layout.element_type) {\n")
	for i in 0..len(types.entries)
		if mir_c_inline_union(types, i)
			parts = parts.append("\tcase " + str(i) + ": { S_MirArrayUnion" + str(i) + " *v = (void *)slot; if (v->tag == -1) v->payload.boxed = s_mir_record_retain(v->payload.boxed); break; }\n")
	parts = parts.append("\tdefault: s_panic(\"invalid union array type\"); } break;\n")
	parts = parts.append("\tdefault: s_panic(\"invalid element ownership\");\n\t}\n}\n")
	parts = parts.append("static inline void s_mir_array_element_drop(S_MirArrayLayout layout, S_MirField *slot) {\n")
	parts = parts.append("\tswitch (layout.ownership) {\n")
	parts = parts.append("\tcase S_MIR_ELEMENT_POD: case S_MIR_ELEMENT_INLINE: break;\n")
	parts = parts.append("\tcase S_MIR_ELEMENT_STRING: s_string_release(slot->text); break;\n")
	parts = parts.append("\tcase S_MIR_ELEMENT_OBJECT: s_mir_record_release(slot->record); break;\n")
	parts = parts.append("\tcase S_MIR_ELEMENT_UNION: switch (layout.element_type) {\n")
	for i in 0..len(types.entries)
		if mir_c_inline_union(types, i)
			parts = parts.append("\tcase " + str(i) + ": { S_MirArrayUnion" + str(i) + " *v = (void *)slot; if (v->tag == -1) s_mir_record_release(v->payload.boxed); break; }\n")
	parts = parts.append("\tdefault: s_panic(\"invalid union array type\"); } break;\n")
	parts = parts.append("\tdefault: s_panic(\"invalid element ownership\");\n\t}\n}\n")
	parts = parts.append("static inline void s_mir_drop_record(void *value) { s_mir_record_release(((S_MirField *)value)->record); }\n")
	parts = parts.append("static inline uint64_t s_mir_hash_i64(const void *key) { return s_hash_i64_key(&((const S_MirField *)key)->bits); }\n")
	parts = parts.append("static inline bool s_mir_eq_i64(const void *a, const void *b) { return ((const S_MirField *)a)->bits == ((const S_MirField *)b)->bits; }\n")
	parts = parts.append("static inline uint64_t s_mir_hash_string(const void *key) { return s_hash_string_key(&((const S_MirField *)key)->text); }\n")
	parts = parts.append("static inline bool s_mir_eq_string(const void *a, const void *b) { return s_eq_string_key(&((const S_MirField *)a)->text, &((const S_MirField *)b)->text); }\n")
	parts = parts.append("static inline uint64_t s_mir_hash_f64(const void *key) { double d = ((const S_MirField *)key)->real; uint64_t bits = 0; if (isnan(d)) bits = UINT64_C(0x7ff8000000000000); else if (d != 0.0) memcpy(&bits, &d, sizeof(bits)); return s_hash_i64_key(&bits); }\n")
	parts = parts.append("static inline bool s_mir_eq_f64(const void *a, const void *b) { double x = ((const S_MirField *)a)->real, y = ((const S_MirField *)b)->real; return x == y || (isnan(x) && isnan(y)); }\n")
