import types alias Types
import parser alias Ast
import hir_declarations alias Decl
import mir alias Mir
import mir_verify alias Verify
import mir_ownership alias Ownership
import mir_cfg alias Cfg
import mir_lifetime alias Lifetime
import mir_opt alias Opt
import mir_common alias Common
import mir_program alias Program
import compile_common alias Compile
# Typed MIR C backend. Consumes verified MIR produced by the
# HIR-owned specialization worklist; MIR is the only C backend.

# Only records whose entire value is a few unmanaged scalar fields are
# currently eligible. Registers and array slots use inline values; union
# alternatives, record fields and dictionary entries retain boxed storage.
def mir_c_inline_record(types: Types.TypeTable, id: i64) -> bool
	if Types.type_tag(types, id) != Types.TYPE_TAG_RECORD
		return false
	let fields = types.entries[!id].fields
	if len(fields) == 0 or len(fields) > 4
		return false
	for field in fields
		let storage = Types.runtime_storage(types, field.kind)
		if storage != Types.TYPE_STORAGE_I64 and storage != Types.TYPE_STORAGE_F64 and storage != Types.TYPE_STORAGE_BOOL
			return false
	for desc in types.entries
		if desc.tag == Types.TYPE_TAG_UNION
			for alternative in desc.fields
				if alternative.kind == id
					return false
		if desc.tag == Types.TYPE_TAG_DICT and (desc.first == id or desc.second == id)
			return false
	return true

# Small scalar payloads inline in wrappers and array slots by default.
# The maximum is three eight-byte scalar fields (24 payload bytes); do not
# use source-level type names or approximate string/container sizes here.
def mir_c_union_small_payload(types: Types.TypeTable, record_type: i64) -> bool
	if Types.type_tag(types, record_type) != Types.TYPE_TAG_RECORD
		return false
	let fields = types.entries[!record_type].fields
	if len(fields) > 3
		return false
	for field in fields
		let storage = Types.runtime_storage(types, field.kind)
		if storage != Types.TYPE_STORAGE_I64 and storage != Types.TYPE_STORAGE_F64 and storage != Types.TYPE_STORAGE_BOOL
			return false
	return true

# Union wrappers and array slots inline up to three unmanaged scalar fields.
# Other alternatives retain boxed payloads. Registers keep their pointer ABI.
def mir_c_inline_union(types: Types.TypeTable, id: i64) -> bool
	if Types.type_tag(types, id) != Types.TYPE_TAG_UNION or Types.union_is_enum(types, id)
		return false
	for alternative in types.entries[!id].fields
		if mir_c_union_small_payload(types, alternative.kind)
			return true
	return false

def mir_c_union_inline_capacity(types: Types.TypeTable, id: i64) -> i64
	var capacity = 0
	for alternative in types.entries[!id].fields
		if mir_c_union_small_payload(types, alternative.kind)
			let count = len(types.entries[!alternative.kind].fields)
			if count > capacity
				capacity = count
	return capacity

def mir_c_inline_name(id: i64) -> string
	return "S_MirInline" + str(id)

def mir_c_zero(types: Types.TypeTable, id: i64) -> string
	if mir_c_inline_record(types, id)
		return "(" + mir_c_inline_name(id) + "){0}"
	return "NULL"

# Box a complete inline register value when entering heap containers that
# still require object slots (e.g. records/dictionaries/optionals). Arrays
# use byte-addressed inline slots instead; unboxing is a pure scalar copy.
def mir_c_box_value(types: Types.TypeTable, id: i64, value: string) -> string
	if mir_c_inline_record(types, id)
		return "s_mir_inline_box" + str(id) + "(" + value + ")"
	return value

def mir_c_type(types: Types.TypeTable, type_id: i64) -> string
	if mir_c_inline_record(types, type_id)
		return mir_c_inline_name(type_id)
	let storage = Types.runtime_storage(types, type_id)
	if storage == Types.TYPE_STORAGE_BOOL
		return "bool"
	if storage == Types.TYPE_STORAGE_F64
		return "double"
	if storage == Types.TYPE_STORAGE_STRING
		return "S_String *"
	if storage == Types.TYPE_STORAGE_OBJECT
		return "S_MirRecord *"
	return "int64_t"

# The active union member follows the canonical static TypeId.
def mir_c_field_name(types: Types.TypeTable, type_id: i64) -> string
	let storage = Types.runtime_storage(types, type_id)
	if storage == Types.TYPE_STORAGE_F64
		return "real"
	if storage == Types.TYPE_STORAGE_STRING
		return "text"
	if storage == Types.TYPE_STORAGE_OBJECT
		return "record"
	return "bits"

def mir_c_register(index: i64) -> string
	return "r" + str(index)

def mir_c_function(index: i64) -> string
	return "s_mir_f" + str(index)

def mir_c_signature(types: Types.TypeTable, function: Mir.MirFunction, index: i64) -> string
	var args = Array[string]()
	for i in 0..function.argument_count
		args = args.append(mir_c_type(types, function.register_types[!i]) + " a" + str(i))
	if len(args) == 0
		return "static " + mir_c_type(types, function.return_type) + " " + mir_c_function(index) + "(void)"
	return "static " + mir_c_type(types, function.return_type) + " " + mir_c_function(index) + "(" + ", ".join(args) + ")"

# Encode every source byte as a three-digit octal escape, so even user-supplied
# panic text cannot inject C source or terminate the C string literal.
def mir_c_string(value: string) -> string
	var result = "\""
	for i in 0..len(value)
		let byte = value.byte_at(i) or 0
		result = result + "\\" + str(byte / 64) + str((byte / 8) % 8) + str(byte % 8)
	return result + "\""

def mir_c_check(index: i64, checked: bool) -> string
	if not checked
		return ""
	return "\tif (!init" + str(index) + ") s_panic(\"uninitialized register\");\n"

# Managed records and CoW arrays share an owned, type-tagged heap representation.
# Verified MIR never reads an uninitialized register. Managed registers are
# non-null whenever owned, so NULL also serves as the cleanup state.
def mir_c_mark_init(index: i64, checked: bool) -> string
	if checked
		return "; init" + str(index) + " = true;"
	return ";"

def mir_c_mark_uninit(index: i64, checked: bool) -> string
	if checked
		return "; init" + str(index) + " = false;"
	return ";"

def mir_c_live(index: i64, checked: bool) -> string
	if checked
		return "init" + str(index)
	return mir_c_register(index)

def mir_c_release_value(types: Types.TypeTable, type_id: i64, value: string) -> string
	if mir_c_inline_record(types, type_id)
		return "((void)0)"
	if Types.runtime_ownership(types, type_id) == Types.TYPE_OWNERSHIP_STRING
		return "s_string_release(" + value + ")"
	return "s_mir_record_release(" + value + ")"

def mir_c_retain_value(types: Types.TypeTable, type_id: i64, value: string) -> string
	if mir_c_inline_record(types, type_id)
		return value
	if Types.runtime_ownership(types, type_id) == Types.TYPE_OWNERSHIP_STRING
		return "s_string_retain(" + value + ")"
	return "s_mir_record_retain(" + value + ")"

# A composite slot contains a value of a known static TypeId. Copying an
# element into a register retains its owned storage; moving it transfers that
# ownership instead. These helpers currently emit pointer ARC, but keep the
# slot-level copy/drop contract separate from the physical S_MirField layout.
def mir_c_slot_copy(types: Types.TypeTable, type_id: i64, slot: string) -> string
	if mir_c_inline_record(types, type_id)
		return "s_mir_inline_unbox" + str(type_id) + "(" + slot + ".record)"
	let value = slot + "." + mir_c_field_name(types, type_id)
	if Common.mir_common_managed(types, type_id)
		return mir_c_retain_value(types, type_id, value)
	return value

def mir_c_slot_retain(types: Types.TypeTable, type_id: i64, slot: string) -> string
	if mir_c_inline_record(types, type_id)
		return "s_mir_record_retain(" + slot + ".record);"
	if not Common.mir_common_managed(types, type_id)
		return ""
	return mir_c_retain_value(types, type_id, slot + "." + mir_c_field_name(types, type_id)) + ";"

def mir_c_slot_drop(types: Types.TypeTable, type_id: i64, slot: string) -> string
	if mir_c_inline_record(types, type_id)
		return "s_mir_record_release(" + slot + ".record);"
	if not Common.mir_common_managed(types, type_id)
		return ""
	return mir_c_release_value(types, type_id, slot + "." + mir_c_field_name(types, type_id)) + ";"

# Evaluate the incoming value before dropping dst, including self-copies.
def mir_c_store_name(types: Types.TypeTable, type_id: i64) -> string
	if Types.runtime_ownership(types, type_id) == Types.TYPE_OWNERSHIP_STRING
		return "s_mir_string_store"
	return "s_mir_record_store"

def mir_c_store_owned(types: Types.TypeTable, dst: i64, type_id: i64, expression: string, checked: bool) -> string
	let name = mir_c_register(dst)
	if mir_c_inline_record(types, type_id)
		return "\t{ " + mir_c_type(types, type_id) + " owned = " + expression + "; " + name + " = owned" + mir_c_mark_init(dst, checked) + " }\n"
	if not checked
		return "\t" + mir_c_store_name(types, type_id) + "(&" + name + ", " + expression + ");\n"
	return "\t{ " + mir_c_type(types, type_id) + " owned = " + expression + "; if (" + mir_c_live(dst, checked) + ") " + mir_c_release_value(types, type_id, name) + "; " + name + " = owned" + mir_c_mark_init(dst, checked) + " }\n"

def mir_c_release_managed(types: Types.TypeTable, function: Mir.MirFunction, except: i64, checked: bool) -> string
	var result = ""
	for i in 0..len(function.register_types)
		let type_id = function.register_types[!i]
		if i != except and Common.mir_common_managed(types, type_id)
			result = result + "\tif (" + mir_c_live(i, checked) + ") " + mir_c_release_value(types, type_id, mir_c_register(i)) + ";\n"
	return result

def mir_c_record_runtime(types: Types.TypeTable) -> string
	var parts = Array[string]()
	# C aggregates are the register ABI for eligible scalar-only records.
	# They need no standalone ARC identity until boxed in a container.
	for i in 0..len(types.entries)
		if mir_c_inline_record(types, i)
			parts = parts.append("typedef struct { ")
			for j in 0..len(types.entries[!i].fields)
				let kind = types.entries[!i].fields[!j].kind
				parts = parts.append(mir_c_type(types, kind) + " f" + str(j) + "; ")
			parts = parts.append("} " + mir_c_inline_name(i) + ";\n")
	# C11 leaves the direction of an inexact integer->double cast implementation-defined.
	# Round discarded low bits explicitly, so conversion always uses ties-to-even.
	# The final cast is exact (at most 53 significand bits) and ldexp scales
	# by an exact power of two within the binary64 exponent range.
	parts = parts.append("static inline double s_mir_i64_to_f64(int64_t value) {\n")
	parts = parts.append("\tuint64_t magnitude = value < 0 ? (uint64_t)(-(value + 1)) + UINT64_C(1) : (uint64_t)value;\n")
	parts = parts.append("\tif (magnitude <= UINT64_C(9007199254740992)) return (double)value;\n")
	parts = parts.append("\tuint64_t mantissa = magnitude; unsigned shift = 0;\n")
	parts = parts.append("\twhile (mantissa > UINT64_C(9007199254740991)) { mantissa >>= 1; ++shift; }\n")
	parts = parts.append("\tuint64_t remainder = magnitude & ((UINT64_C(1) << shift) - 1);\n")
	parts = parts.append("\tuint64_t halfway = UINT64_C(1) << (shift - 1);\n")
	parts = parts.append("\tif (remainder > halfway || (remainder == halfway && (mantissa & 1))) ++mantissa;\n")
	parts = parts.append("\tdouble rounded = ldexp((double)mantissa, (int)shift);\n")
	parts = parts.append("\treturn value < 0 ? -rounded : rounded;\n}\n")
	parts = parts.append("typedef struct S_MirRecord S_MirRecord;\n")
	# Type descriptors determine the active field; a union avoids storing four unused payloads.
	parts = parts.append("typedef union { int64_t bits; double real; S_String *text; S_MirRecord *record; S_Dict *dict; } S_MirField;\n")
	# Keep each inline slot suitably aligned and at least one field wide.
	for i in 0..len(types.entries)
		if mir_c_inline_record(types, i)
			parts = parts.append("typedef union { " + mir_c_inline_name(i) + " value; S_MirField alignment; } S_MirArrayInline" + str(i) + ";\n")
	# A negative index means an owned boxed wrapper. Other indices identify
	# inline scalar alternatives in source declaration order.
	for i in 0..len(types.entries)
		if mir_c_inline_union(types, i)
			let count = mir_c_union_inline_capacity(types, i)
			var slots = count
			if slots == 0
				slots = 1
			parts = parts.append("typedef struct { int64_t tag; union { S_MirRecord *boxed; S_MirField fields[" + str(slots) + "]; } payload; } S_MirArrayUnion" + str(i) + ";\n")
	# Only fixed-size record payloads and their union wrappers use the experimental
	# high-bit capacity marker. Growable arrays always have an ordinary capacity.
	parts = parts.append("struct S_MirRecord { int64_t type_id; size_t refs, length, capacity; S_MirField fields[]; };\n")
	# The static type and variant tag select inline fields versus a payload edge.
	parts = parts.append("static inline int64_t s_mir_union_inline_count(int64_t type, int64_t tag) { (void)tag; switch (type) {\n")
	for i in 0..len(types.entries)
		if mir_c_inline_union(types, i)
			parts = parts.append("case " + str(i) + ": switch (tag) {\n")
			for j in 0..len(types.entries[!i].fields)
				let alternative = types.entries[!i].fields[!j].kind
				if mir_c_union_small_payload(types, alternative)
					parts = parts.append("case " + str(j) + ": return " + str(len(types.entries[!alternative].fields)) + ";\n")
			parts = parts.append("default: return -1; }\n")
	parts = parts.append("default: return -1; } }\n")
	# Arrays share the S_MirRecord header, but their trailing storage is a
	# byte-addressed buffer: element widths can differ from S_MirField.
	# Scalar-only records have value slots; objects/strings keep pointer slots.
	parts = parts.append("enum { S_MIR_ELEMENT_POD, S_MIR_ELEMENT_STRING, S_MIR_ELEMENT_OBJECT, S_MIR_ELEMENT_INLINE, S_MIR_ELEMENT_UNION };\n")
	parts = parts.append("typedef struct { int64_t element_type; size_t stride; int ownership; } S_MirArrayLayout;\n")
	parts = parts.append("static inline S_MirArrayLayout s_mir_array_layout(int64_t array_type) {\n\tswitch (array_type) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == Types.TYPE_TAG_ARRAY
			var policy = "S_MIR_ELEMENT_POD"
			let ownership = Types.runtime_ownership(types, desc.first)
			if ownership == Types.TYPE_OWNERSHIP_STRING
				policy = "S_MIR_ELEMENT_STRING"
			elif ownership == Types.TYPE_OWNERSHIP_OBJECT
				policy = "S_MIR_ELEMENT_OBJECT"
			var stride = "sizeof(S_MirField)"
			if mir_c_inline_record(types, desc.first)
				stride = "sizeof(S_MirArrayInline" + str(desc.first) + ")"
				policy = "S_MIR_ELEMENT_INLINE"
			if mir_c_inline_union(types, desc.first)
				stride = "sizeof(S_MirArrayUnion" + str(desc.first) + ")"
				policy = "S_MIR_ELEMENT_UNION"
			parts = parts.append("\tcase " + str(i) + ": return (S_MirArrayLayout){" + str(desc.first) + ", " + stride + ", " + policy + "};\n")
	parts = parts.append("\tdefault: s_panic(\"invalid array type\");\n\t}\n}\n")
	parts = parts.append("static inline size_t s_mir_record_stride(int64_t type_id) {\n\tswitch (type_id) {\n")
	for i in 0..len(types.entries)
		if types.entries[!i].tag == Types.TYPE_TAG_ARRAY
			parts = parts.append("\tcase " + str(i) + ": return s_mir_array_layout(type_id).stride;\n")
	parts = parts.append("\tdefault: return sizeof(S_MirField);\n\t}\n}\n")
	parts = parts.append("static inline S_MirField *s_mir_array_at(S_MirRecord *r, size_t index) {\n")
	parts = parts.append("\tS_MirArrayLayout layout = s_mir_array_layout(r->type_id);\n")
	parts = parts.append("\treturn (S_MirField *)((unsigned char *)r->fields + index * layout.stride);\n}\n")
	# Slot decoders are defined after record release; equality and indexing
	# call them through these declarations.
	for i in 0..len(types.entries)
		if mir_c_inline_union(types, i)
			parts = parts.append("static inline S_MirRecord *s_mir_array_union_read" + str(i) + "(const S_MirArrayUnion" + str(i) + " *slot);\n")
	# memcpy avoids aliasing and alignment assumptions when reading byte slots.
	for i in 0..len(types.entries)
		if mir_c_inline_record(types, i)
			let name = mir_c_inline_name(i)
			parts = parts.append("static inline " + name + " s_mir_array_read" + str(i) + "(S_MirRecord *array, size_t index) { " + name + " value; memcpy(&value, s_mir_array_at(array, index), sizeof(value)); return value; }\n")
	parts = parts.append("#ifdef SIRIUS_ARC_AUDIT\n")
	parts = parts.append("static inline void s_mir_record_arc_scan(const void *object, S_ArcAuditVisit visit, void *context) {\n")
	parts = parts.append("\t(void)visit; (void)context;\n\tconst S_MirRecord *r = object;\n\tswitch (r->type_id) {\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == Types.TYPE_TAG_RECORD
			parts = parts.append("\tcase " + str(i) + ":\n")
			for j in 0..len(desc.fields)
				let kind = desc.fields[!j].kind
				if Common.mir_common_managed(types, kind)
					let field = mir_c_field_name(types, kind)
					parts = parts.append("\t\tvisit(r->fields[" + str(j) + "]." + field + ", context);\n")
			parts = parts.append("\t\tbreak;\n")
		elif desc.tag == Types.TYPE_TAG_OPTIONAL
			parts = parts.append("\tcase " + str(i) + ":\n")
			if Common.mir_common_managed(types, desc.first)
				let field = mir_c_field_name(types, desc.first)
				parts = parts.append("\t\tfor (size_t j = 0; j < r->length; ++j) visit(r->fields[j]." + field + ", context);\n")
			parts = parts.append("\t\tbreak;\n")
		elif desc.tag == Types.TYPE_TAG_ARRAY
			parts = parts.append("\tcase " + str(i) + ":\n")
			parts = parts.append("\t\t{ S_MirArrayLayout layout = s_mir_array_layout(r->type_id);\n")
			parts = parts.append("\t\t  for (size_t j = 0; j < r->length; ++j) {\n")
			parts = parts.append("\t\t    const S_MirField *slot = s_mir_array_at((S_MirRecord *)r, j);\n")
			parts = parts.append("\t\t    if (layout.ownership == S_MIR_ELEMENT_STRING) visit(slot->text, context);\n")
			parts = parts.append("\t\t    else if (layout.ownership == S_MIR_ELEMENT_OBJECT) visit(slot->record, context);\n")
			for u in 0..len(types.entries)
				if mir_c_inline_union(types, u)
					parts = parts.append("\t\t    else if (layout.element_type == " + str(u) + ") { const S_MirArrayUnion" + str(u) + " *v = (const void *)slot; if (v->tag == -1) visit(v->payload.boxed, context); }\n")
			parts = parts.append("\t\t  } } break;\n")
		elif desc.tag == Types.TYPE_TAG_UNION
			parts = parts.append("\tcase " + str(i) + ": if (s_mir_union_inline_count(r->type_id, r->fields[0].bits) < 0) visit(r->fields[1].record, context); break;\n")
		elif desc.tag == Types.TYPE_TAG_DICT
			parts = parts.append("\tcase " + str(i) + ": visit(r->fields[0].dict, context); break;\n")
	parts = parts.append("\tdefault: s_panic(\"unknown ARC scanned type\");\n\t}\n}\n#endif\n")
	parts = parts.append("static inline S_MirRecord *s_mir_record_new(int64_t id, size_t fields) {\n")
	parts = parts.append("\tsize_t stride = s_mir_record_stride(id);\n")
	parts = parts.append("\tif (fields > (SIZE_MAX - sizeof(S_MirRecord)) / stride) s_panic(\"collection too large\");\n")
	parts = parts.append("\tS_MirRecord *r = calloc(1, sizeof(S_MirRecord) + fields * stride);\n")
	parts = parts.append("\tif (!r) s_panic(\"out of memory\");\n\tr->type_id = id; r->refs = 1; s_arc_audit_new(r, r->refs); s_arc_audit_watch(r, s_mir_record_arc_scan); r->length = fields; r->capacity = fields; return r;\n}\n")
	# Heap boundaries still hold pointer-valued slots during this phase.
	# Scalar values are boxed only on entry and copied out on projection.
	for i in 0..len(types.entries)
		if mir_c_inline_record(types, i)
			let name = mir_c_inline_name(i)
			parts = parts.append("static inline S_MirRecord *s_mir_inline_box" + str(i) + "(" + name + " value) {\n")
			parts = parts.append("\tS_MirRecord *out = s_mir_record_new(" + str(i) + ", " + str(len(types.entries[!i].fields)) + ");\n")
			for j in 0..len(types.entries[!i].fields)
				let field = mir_c_field_name(types, types.entries[!i].fields[!j].kind)
				parts = parts.append("\tout->fields[" + str(j) + "]." + field + " = value.f" + str(j) + ";\n")
			parts = parts.append("\treturn out;\n}\n")
			parts = parts.append("static inline " + name + " s_mir_inline_unbox" + str(i) + "(const S_MirRecord *value) {\n")
			parts = parts.append("\t" + name + " out = {0};\n")
			for j in 0..len(types.entries[!i].fields)
				let field = mir_c_field_name(types, types.entries[!i].fields[!j].kind)
				parts = parts.append("\tout.f" + str(j) + " = value->fields[" + str(j) + "]." + field + ";\n")
			parts = parts.append("\treturn out;\n}\n")
	# A fixed-size record and its union wrapper share an allocation, but keep
	# separate ARC identities. When the wrapper dies first the payload retains
	# the slab; when the payload dies last it frees the slab.
	parts = parts.append("#if defined(SIRIUS_EXPERIMENTAL_UNION_COALLOC) || defined(SIRIUS_EXPERIMENTAL_UNION_HYBRID)\n")
	parts = parts.append("#define S_MIR_FUSED_BIT ((size_t)1 << (sizeof(size_t) * CHAR_BIT - 1))\n")
	parts = parts.append("static inline bool s_mir_is_fused(const S_MirRecord *r) { return (r->capacity & S_MIR_FUSED_BIT) != 0; }\n")
	parts = parts.append("#define S_MIR_FUSED_OFFSET (sizeof(S_MirRecord) + 2 * sizeof(S_MirField))\n")
	parts = parts.append("static inline S_MirRecord *s_mir_record_new_fused(int64_t record_type, size_t count, int64_t union_type) {\n")
	parts = parts.append("\tif (count > (SIZE_MAX - S_MIR_FUSED_OFFSET - sizeof(S_MirRecord)) / sizeof(S_MirField)) s_panic(\"collection too large\");\n")
	parts = parts.append("\tS_MirRecord *wrapper = calloc(1, S_MIR_FUSED_OFFSET + sizeof(S_MirRecord) + count * sizeof(S_MirField));\n")
	parts = parts.append("\tif (!wrapper) s_panic(\"out of memory\");\n")
	parts = parts.append("\tS_MirRecord *payload = (S_MirRecord *)((unsigned char *)wrapper + S_MIR_FUSED_OFFSET);\n")
	parts = parts.append("\twrapper->type_id = union_type; wrapper->refs = 1; wrapper->length = 2; wrapper->capacity = 2 | S_MIR_FUSED_BIT;\n")
	parts = parts.append("\tpayload->type_id = record_type; payload->refs = 1; payload->length = count; payload->capacity = count | S_MIR_FUSED_BIT;\n")
	parts = parts.append("\twrapper->fields[1].record = payload;\n")
	parts = parts.append("\ts_arc_audit_new(wrapper, wrapper->refs); s_arc_audit_watch(wrapper, s_mir_record_arc_scan);\n")
	parts = parts.append("\ts_arc_audit_new(payload, payload->refs); s_arc_audit_watch(payload, s_mir_record_arc_scan);\n\treturn payload;\n}\n")
	parts = parts.append("static inline S_MirRecord *s_mir_fused_wrapper(S_MirRecord *payload) { return (S_MirRecord *)((unsigned char *)payload - S_MIR_FUSED_OFFSET); }\n")
	parts = parts.append("#endif\n")
	parts = parts.append("static inline S_MirRecord *s_mir_record_retain(S_MirRecord *r) { if (r) { ++r->refs; s_arc_audit_retain(r, r->refs); } return r; }\n")
	parts = parts.append("static inline S_MirRecord *s_mir_record_reserve_owned(S_MirRecord *r, size_t need) {\n")
	parts = parts.append("#if defined(SIRIUS_EXPERIMENTAL_UNION_COALLOC) || defined(SIRIUS_EXPERIMENTAL_UNION_HYBRID)\n\tif (s_mir_is_fused(r)) s_panic(\"cannot grow coallocated fixed-size record\");\n#endif\n")
	parts = parts.append("\tif (need <= r->capacity) return r;\n")
	parts = parts.append("\tsize_t stride = s_mir_record_stride(r->type_id);\n")
	parts = parts.append("\tconst size_t limit = (SIZE_MAX - sizeof(S_MirRecord)) / stride;\n")
	parts = parts.append("\tif (need > limit) s_panic(\"collection too large\");\n")
	parts = parts.append("\tsize_t capacity = r->capacity ? r->capacity : 4;\n")
	parts = parts.append("\twhile (capacity < need) capacity = capacity > limit / 2 ? limit : capacity * 2;\n")
	parts = parts.append("\tuintptr_t previous = (uintptr_t)r;\n\tS_MirRecord *grown = realloc(r, sizeof(S_MirRecord) + capacity * stride);\n")
	parts = parts.append("\tif (!grown) s_panic(\"out of memory\");\n\ts_arc_audit_relocate(previous, grown); grown->capacity = capacity; return grown;\n}\n")
	parts = parts.append("static inline S_String *s_mir_string_join(const S_String *sep, const S_MirRecord *parts) {\n")
	parts = parts.append("\tsize_t total = 0;\n")
	parts = parts.append("\tfor (size_t i = 0; i < parts->length; ++i) {\n")
	parts = parts.append("\t\tconst size_t n = s_mir_array_at((S_MirRecord *)parts, i)->text->length;\n")
	parts = parts.append("\t\tif (n > SIZE_MAX - total - sizeof(S_String) - 1) s_panic(\"string too large\");\n")
	parts = parts.append("\t\ttotal += n;\n")
	parts = parts.append("\t\tif (i) { if (sep->length > SIZE_MAX - total - sizeof(S_String) - 1) s_panic(\"string too large\"); total += sep->length; }\n\t}\n")
	parts = parts.append("\tS_String *out = malloc(sizeof(S_String) + total + 1);\n")
	parts = parts.append("\tif (!out) s_panic(\"out of memory\");\n")
	parts = parts.append("\tout->refcount = 1; s_arc_audit_new(out, out->refcount); out->length = total;\n")
	parts = parts.append("\tsize_t at = 0;\n\tfor (size_t i = 0; i < parts->length; ++i) {\n")
	parts = parts.append("\t\tif (i) { memcpy(out->data + at, sep->data, sep->length); at += sep->length; }\n")
	parts = parts.append("\t\tconst S_String *item = s_mir_array_at((S_MirRecord *)parts, i)->text;\n")
	parts = parts.append("\t\tmemcpy(out->data + at, item->data, item->length); at += item->length;\n")
	parts = parts.append("\t}\n\tout->data[total] = '\\0';\n\treturn out;\n}\n")
	parts = parts.append("static inline S_MirRecord *s_mir_arguments(int64_t type_id) {\n")
	parts = parts.append("\tS_Array *args = s_arguments();\n\tsize_t count = s_array_length(args);\n")
	parts = parts.append("\tS_MirRecord *out = s_mir_record_new(type_id, count);\n")
	parts = parts.append("\tfor (size_t i = 0; i < count; ++i) s_mir_array_at(out, i)->text = s_string_retain(*(S_String *const *)s_array_at(args, (int64_t)i));\n")
	parts = parts.append("\ts_array_release(args);\n\treturn out;\n}\n")
	# Generic S_Dict stores one S_MirField per entry key/value. The callbacks
