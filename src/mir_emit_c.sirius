			parts = parts.append("\t\tfor (size_t j = 0; j < r->length; ++j) s_mir_array_element_drop(layout, s_mir_array_at(r, j));\n")
			parts = parts.append("\t\tbreak; }\n")
	parts = parts.append("\tdefault: s_panic(\"unknown managed type\");\n\t}\n")
	parts = parts.append("#if defined(SIRIUS_EXPERIMENTAL_UNION_COALLOC) || defined(SIRIUS_EXPERIMENTAL_UNION_HYBRID)\n\tif (s_mir_is_fused(r)) { free((unsigned char *)r - S_MIR_FUSED_OFFSET); return; }\n#endif\n")
	parts = parts.append("\tfree(r);\n}\n\n")
	# Packed array union helpers. Packing consumes one ownership credit;
	# a small scalar alternative is copied then its original wrapper is
