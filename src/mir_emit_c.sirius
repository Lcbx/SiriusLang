		parts = parts.append("static inline uint64_t s_mir_hash_field(int64_t kind, S_MirField field) { switch (kind) {\n")
		parts = parts.append("case " + str(Types.TYPE_TAG_I64) + ": case " + str(Types.TYPE_TAG_BOOL) + ": return s_hash_i64_key(&field.bits);\n")
		parts = parts.append("case " + str(Types.TYPE_TAG_F64) + ": return s_mir_hash_f64(&field);\n")
		parts = parts.append("case " + str(Types.TYPE_TAG_STRING) + ": return s_mir_hash_string(&field);\n")
		for i in 0..len(types.entries)
			let desc = types.entries[!i]
			if desc.tag == Types.TYPE_TAG_RECORD and Verify.mir_dict_hashable_key(types, i)
				parts = parts.append("case " + str(i) + ": { uint64_t result = UINT64_C(0x345678);\n")
				for j in 0..len(desc.fields)
					parts = parts.append("result = s_mir_hash_combine(result, s_mir_hash_field(" + str(desc.fields[!j].kind) + ", field.record->fields[" + str(j) + "]));\n")
				parts = parts.append("return s_mir_hash_combine(result, " + str(len(desc.fields)) + "); }\n")
		for i in 0..len(types.entries)
			let desc = types.entries[!i]
			if desc.tag == Types.TYPE_TAG_OPTIONAL and Verify.mir_dict_hashable_key(types, i)
				parts = parts.append("case " + str(i) + ": { uint64_t hash = UINT64_C(0x345678);\n")
				parts = parts.append("if (field.record->length == 0) return s_mir_hash_combine(hash, 0);\n")
				parts = parts.append("return s_mir_hash_combine(s_mir_hash_combine(hash, 1), s_mir_hash_field(" + str(desc.first) + ", field.record->fields[0])); }\n")
			elif desc.tag == Types.TYPE_TAG_UNION and Verify.mir_dict_hashable_key(types, i)
				if Types.union_is_enum(types, i)
					parts = parts.append("case " + str(i) + ": return s_hash_i64_key(&field.bits);\n")
				else
					parts = parts.append("case " + str(i) + ": { int64_t tag = field.record->fields[0].bits;\n")
					parts = parts.append("uint64_t hash = s_mir_hash_combine(UINT64_C(0x345678), s_hash_i64_key(&tag));\nswitch (tag) {\n")
					for j in 0..len(desc.fields)
						let alternative = desc.fields[!j].kind
						if mir_c_inline_union(types, i) and mir_c_union_small_payload(types, alternative)
							parts = parts.append("case " + str(j) + ": { uint64_t result = UINT64_C(0x345678);\n")
							for k in 0..len(types.entries[!alternative].fields)
								parts = parts.append("result = s_mir_hash_combine(result, s_mir_hash_field(" + str(types.entries[!alternative].fields[!k].kind) + ", field.record->fields[" + str(k + 1) + "]));\n")
							parts = parts.append("return s_mir_hash_combine(hash, s_mir_hash_combine(result, " + str(len(types.entries[!alternative].fields)) + ")); }\n")
						else
							parts = parts.append("case " + str(j) + ": return s_mir_hash_combine(hash, s_mir_hash_field(" + str(alternative) + ", field.record->fields[1]));\n")
