	# optionals and unions and key comparison for composite dictionaries.
	# Arrays participate when nested in comparable values; direct array == is
	# deliberately reserved for future elementwise semantics.
	parts = parts.append("static inline bool s_mir_value_equal(int64_t kind, S_MirField a, S_MirField b, bool key_comparison) { switch (kind) {\n")
	parts = parts.append("case " + str(Types.TYPE_TAG_I64) + ": case " + str(Types.TYPE_TAG_BOOL) + ": return a.bits == b.bits;\n")
	parts = parts.append("case " + str(Types.TYPE_TAG_F64) + ": return a.real == b.real || (key_comparison && isnan(a.real) && isnan(b.real));\n")
	parts = parts.append("case " + str(Types.TYPE_TAG_STRING) + ": return s_string_compare(a.text, b.text) == 0;\n")
	for i in 0..len(types.entries)
		let desc = types.entries[!i]
		if desc.tag == Types.TYPE_TAG_RECORD and Types.type_supports_equality(types, i)
			parts = parts.append("case " + str(i) + ":\n")
			for j in 0..len(desc.fields)
				parts = parts.append("if (!s_mir_value_equal(" + str(desc.fields[!j].kind) + ", a.record->fields[" + str(j) + "], b.record->fields[" + str(j) + "], key_comparison)) return false;\n")
			parts = parts.append("return true;\n")
		elif desc.tag == Types.TYPE_TAG_ARRAY and Types.type_supports_equality(types, i)
			parts = parts.append("case " + str(i) + ": if (a.record->length != b.record->length) return false;\n")
			if mir_c_inline_record(types, desc.first)
				let element = types.entries[!desc.first]
				parts = parts.append("for (size_t j = 0; j < a.record->length; ++j) {\n")
				parts = parts.append(mir_c_inline_name(desc.first) + " lhs = s_mir_array_read" + str(desc.first) + "(a.record, j);\n")
				parts = parts.append(mir_c_inline_name(desc.first) + " rhs = s_mir_array_read" + str(desc.first) + "(b.record, j);\n")
				for j in 0..len(element.fields)
					let storage = Types.runtime_storage(types, element.fields[!j].kind)
					if storage == Types.TYPE_STORAGE_F64
