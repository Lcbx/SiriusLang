# Sirius stage-1 syntax parser, importing the tokenizer as a separate module.
# The AST is an arena: children are node IDs, never recursively allocated records.
# Node.token indexes the original token array; identifiers/literals retain source spans.
import tokenizer alias Lex

# Named integer AST kinds; every Node stores a compact i64 kind.
export let NODE_ARM = 1
export let NODE_ARRAY = 2
export let NODE_ASSIGN = 3
export let NODE_ATTR = 4
export let NODE_BINARY = 5
export let NODE_BINDING = 6
export let NODE_BLOCK = 7
export let NODE_BOOL = 8
export let NODE_BREAK = 9
export let NODE_CALL = 10
export let NODE_CASE = 11
export let NODE_CHECKED_INDEX = 12
export let NODE_CONTINUE = 13
export let NODE_DEF = 14
export let NODE_DELETE = 15
export let NODE_ELSE = 16
export let NODE_ELSE_RETURN = 17
export let NODE_EXPR = 18
export let NODE_FIELD = 19
export let NODE_FLOAT = 20
export let NODE_FOR = 21
export let NODE_IF = 22
export let NODE_INDEX = 23
export let NODE_INTEGER = 24
export let NODE_LAMBDA = 25
export let NODE_LET = 26
export let NODE_MATCH = 27
export let NODE_MODULE = 28
export let NODE_NAME = 29
export let NODE_OPTIONAL_INDEX = 30
export let NODE_PARAM = 31
export let NODE_PUB = 32
export let NODE_RECORD = 33
export let NODE_RECUR = 34
export let NODE_RETURN = 35
export let NODE_SPREAD = 36
export let NODE_STRING = 37
export let NODE_TYPE = 38
export let NODE_UNARY = 39
export let NODE_VAR = 40
export let NODE_WHILE = 41
export let NODE_REC = 42
export let NODE_GUARD = 43
export let NODE_UNWRAP = 44
export let NODE_DESTRUCTURE = 45
export let NODE_EXTERN_DEF = 46
export let NODE_IMPORT = 47
export let NODE_EXPORT = 48
export let NODE_REEXPORT = 49
export let NODE_ENUM = 50

export def node_kind_name(kind: i64) -> string
	if kind == NODE_ARM
		return "arm"
	if kind == NODE_ARRAY
		return "array"
	if kind == NODE_ASSIGN
		return "assign"
	if kind == NODE_ATTR
		return "attr"
	if kind == NODE_BINARY
		return "binary"
	if kind == NODE_BINDING
		return "binding"
	if kind == NODE_BLOCK
		return "block"
	if kind == NODE_BOOL
		return "bool"
	if kind == NODE_BREAK
		return "break"
	if kind == NODE_CALL
		return "call"
	if kind == NODE_CASE
		return "case"
	if kind == NODE_CHECKED_INDEX
		return "checked_index"
	if kind == NODE_CONTINUE
		return "continue"
	if kind == NODE_DEF
		return "def"
	if kind == NODE_EXTERN_DEF
		return "extern_def"
	if kind == NODE_IMPORT
		return "import"
	if kind == NODE_EXPORT
		return "export"
	if kind == NODE_REEXPORT
		return "reexport"
	if kind == NODE_ENUM
		return "enum"
	if kind == NODE_DELETE
		return "delete"
	if kind == NODE_DESTRUCTURE
		return "destructure"
	if kind == NODE_ELSE
		return "else"
	if kind == NODE_ELSE_RETURN
		return "else_return"
	if kind == NODE_EXPR
		return "expr"
	if kind == NODE_FIELD
		return "field"
	if kind == NODE_FLOAT
		return "float"
	if kind == NODE_FOR
		return "for"
	if kind == NODE_IF
		return "if"
	if kind == NODE_INDEX
		return "index"
	if kind == NODE_INTEGER
		return "integer"
	if kind == NODE_LAMBDA
		return "lambda"
	if kind == NODE_LET
		return "let"
	if kind == NODE_MATCH
		return "match"
	if kind == NODE_MODULE
		return "module"
	if kind == NODE_NAME
		return "name"
	if kind == NODE_OPTIONAL_INDEX
		return "optional_index"
	if kind == NODE_PARAM
		return "param"
	if kind == NODE_PUB
		return "pub"
	if kind == NODE_RECORD
		return "record"
	if kind == NODE_REC
		return "rec"
	if kind == NODE_GUARD
		return "guard"
	if kind == NODE_UNWRAP
		return "unwrap"
	if kind == NODE_RECUR
		return "recur"
	if kind == NODE_RETURN
		return "return"
	if kind == NODE_SPREAD
		return "spread"
	if kind == NODE_STRING
		return "string"
	if kind == NODE_TYPE
		return "type"
	if kind == NODE_UNARY
		return "unary"
	if kind == NODE_VAR
		return "var"
	if kind == NODE_WHILE
		return "while"
	return "unknown"

export rec Node(kind: i64, token: i64, first: i64, count: i64)

export rec ParseState(source: string, tokens: Array[Lex.Token], nodes: Array[Node], edges: Array[i64], index: i64, error: string, error_line: i64)

export def new_parse_state(source: string, tokens: Array[Lex.Token]) -> ParseState
	return ParseState(source, tokens, Array[Node](), Array[i64](), 0, "", 0)

export rec ParseResult(state: ParseState, node: i64)

def current(p: ParseState) -> Lex.Token
	return p.tokens[!p.index]

def word(p: ParseState) -> string
	return Lex.token_text(p.source, current(p))

def is_token(p: ParseState, value: string) -> bool
	let token = current(p)
	if token.end - token.start != len(value)
		return false
	return Lex.token_text(p.source, token) == value

def kind_is(p: ParseState, kind: i64) -> bool
	return current(p).kind == kind

def fail(p: ParseState, message: string) -> ParseState
	var next = p
	if next.error == ""
		next.error = message
		next.error_line = current(p).line
	return next

def expect(p: ParseState, value: string) -> ParseState
	p.error == "" else return p
	if not is_token(p, value)
		return fail(p, "expected '" + value + "', found '" + word(p) + "'")
	var next = p
	next.index += 1
	return next

def expect_kind(p: ParseState, kind: i64, description: string) -> ParseState
	p.error == "" else return p
	if not kind_is(p, kind)
		return fail(p, "expected " + description + ", found '" + word(p) + "'")
	var next = p
	next.index += 1
	return next

def is_name(p: ParseState) -> bool
	return kind_is(p, Lex.TOKEN_NAME)

def append_node(p: ParseState, kind: i64, token: i64, children: Array[i64]) -> ParseResult
	if p.error != ""
		return ParseResult(p, -1)
	var next = p
	let first = len(next.edges)
	for child in children
		next.edges = next.edges.append(child)
	let index = len(next.nodes)
	next.nodes = next.nodes.append(Node(kind, token, first, len(children)))
	return ParseResult(next, index)

def leaf(p: ParseState, kind: i64, token: i64) -> ParseResult
	return append_node(p, kind, token, Array[i64]())

def unary_node(p: ParseState, kind: i64, token: i64, a: i64) -> ParseResult
	var children = Array[i64]()
	children = children.append(a)
	return append_node(p, kind, token, children)

def binary_node(p: ParseState, kind: i64, token: i64, a: i64, b: i64) -> ParseResult
	var children = Array[i64]()
	children = children.append(a)
	children = children.append(b)
	return append_node(p, kind, token, children)

def precedence(op: string) -> i64
	if op == "or"
		return 1
	if op == "and"
		return 2
	if op == "|"
		return 3
	if op == "&"
		return 4
	if op == "<<" or op == ">>"
		return 5
	if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
		return 4
	if op == ".."
		return 5
	if op == "+" or op == "-"
		return 6
	if op == "*" or op == "/" or op == "%"
		return 7
	return -1

def parse_type(p: ParseState) -> ParseResult
	var token = p.index
	var next = expect_kind(p, Lex.TOKEN_NAME, "type name")
	if next.error != ""
		return ParseResult(next, -1)
	var name = word(p)
	var qualified = false
	while next.error == "" and is_token(next, ".")
		next = expect(next, ".")
		name += "." + word(next)
		next = expect_kind(next, Lex.TOKEN_NAME, "qualified type name")
		qualified = true
	if qualified and next.error == ""
		let start = len(next.source)
		next.source += name
		token = len(next.tokens)
		next.tokens = next.tokens.append(Lex.Token(Lex.TOKEN_NAME, start, len(next.source), p.tokens[!p.index].line, 0))
	var args = Array[i64]()
	if is_token(next, "[")
		next = expect(next, "[")
		while next.error == "" and not is_token(next, "]")
			var item = ParseResult(next, -1)
			if kind_is(next, Lex.TOKEN_INT)
				let index = next.index
				next.index += 1
				item = leaf(next, NODE_INTEGER, index)
			else
				item = parse_type(next)
			next = item.state
			if next.error != ""
				break
			args = args.append(item.node)
			if not is_token(next, ",")
				break
			next = expect(next, ",")
		next = expect(next, "]")
	return append_node(next, NODE_TYPE, token, args)

def parse_param(p: ParseState) -> ParseResult
	let token = p.index
	var next = expect_kind(p, Lex.TOKEN_NAME, "parameter name")
	var children = Array[i64]()
	if next.error == "" and is_token(next, ":")
		next = expect(next, ":")
		let annotation = parse_type(next)
		next = annotation.state
		children = children.append(annotation.node)
	if next.error == "" and is_token(next, "=")
		next = expect(next, "=")
		let value = parse_expr(next, 0)
		next = value.state
		children = children.append(value.node)
	return append_node(next, NODE_PARAM, token, children)

def parse_expr(p: ParseState, min_bp: i64) -> ParseResult
	if p.error != ""
		return ParseResult(p, -1)
	let token = p.index
	let t = current(p)
	let text = word(p)
	var next = p
	next.index += 1
	var lhs = -1
	if text == "-" or text == "+" or text == "not" or text == "~"
		let value = parse_expr(next, 8)
		next = value.state
		let node = unary_node(next, NODE_UNARY, token, value.node)
		next = node.state
		lhs = node.node
	elif text == "("
		let inner = parse_expr(next, 0)
		next = expect(inner.state, ")")
		lhs = inner.node
	elif text == "["
		var items = Array[i64]()
		while next.error == "" and not is_token(next, "]")
			let item = parse_expr(next, 0)
			next = item.state
			if next.error != ""
				break
			items = items.append(item.node)
			if not is_token(next, ",")
				break
			next = expect(next, ",")
		next = expect(next, "]")
		let node = append_node(next, NODE_ARRAY, token, items)
		next = node.state
		lhs = node.node
	elif text == "{"
		var fields = Array[i64]()
		while next.error == "" and not is_token(next, "}")
			let name = next.index
			var item = ParseResult(next, -1)
			if is_token(next, "del")
				next = expect(next, "del")
				let deleted = next.index
				next = expect_kind(next, Lex.TOKEN_NAME, "deleted field")
				item = leaf(next, NODE_DELETE, deleted)
			else
				next = expect_kind(next, Lex.TOKEN_NAME, "field name")
				if is_token(next, ".")
					next = expect(next, ".")
					next = expect(next, "*")
					item = leaf(next, NODE_SPREAD, name)
				else
					next = expect(next, "=")
					let value = parse_expr(next, 0)
					item = unary_node(value.state, NODE_FIELD, name, value.node)
			next = item.state
			if next.error != ""
				break
			fields = fields.append(item.node)
			if is_token(next, ",")
				next = expect(next, ",")
		next = expect(next, "}")
		let node = append_node(next, NODE_RECORD, token, fields)
		next = node.state
		lhs = node.node
	elif text == "fn"
		next = expect(next, "(")
		var args = Array[i64]()
		while next.error == "" and not is_token(next, ")")
			let item = parse_param(next)
			next = item.state
			if next.error != ""
				break
			args = args.append(item.node)
			if not is_token(next, ",")
				break
			next = expect(next, ",")
		next = expect(next, ")")
		let body = parse_expr(next, 0)
		next = body.state
		args = args.append(body.node)
		let node = append_node(next, NODE_LAMBDA, token, args)
		next = node.state
		lhs = node.node
	elif text == "true" or text == "false"
		let node = leaf(next, NODE_BOOL, token)
		next = node.state
		lhs = node.node
	elif t.kind == Lex.TOKEN_NAME
		let node = leaf(next, NODE_NAME, token)
		next = node.state
		lhs = node.node
	elif t.kind == Lex.TOKEN_INT
		let node = leaf(next, NODE_INTEGER, token)
		next = node.state
		lhs = node.node
	elif t.kind == Lex.TOKEN_FLOAT
		let node = leaf(next, NODE_FLOAT, token)
		next = node.state
		lhs = node.node
	elif t.kind == Lex.TOKEN_STRING
		let node = leaf(next, NODE_STRING, token)
		next = node.state
		lhs = node.node
	else
		return ParseResult(fail(p, "unexpected expression '" + text + "'"), -1)

	while next.error == ""
		let op = word(next)
		if op == "(" and min_bp <= 10
			let position = next.index
			next = expect(next, "(")
			var args = Array[i64]()
			args = args.append(lhs)
			while next.error == "" and not is_token(next, ")")
				let arg = parse_expr(next, 0)
				next = arg.state
				if next.error != ""
					break
				args = args.append(arg.node)
				if not is_token(next, ",")
					break
				next = expect(next, ",")
			next = expect(next, ")")
			let node = append_node(next, NODE_CALL, position, args)
			next = node.state
			lhs = node.node
			continue
		if op == "." and min_bp <= 10
			next = expect(next, ".")
			let name = next.index
			next = expect_kind(next, Lex.TOKEN_NAME, "member name")
			let node = unary_node(next, NODE_ATTR, name, lhs)
			next = node.state
			lhs = node.node
			continue
		if op == "[" and min_bp <= 10
			let position = next.index
			next = expect(next, "[")
			var kind = NODE_INDEX
			if is_token(next, "?")
				next = expect(next, "?")
				kind = NODE_OPTIONAL_INDEX
			elif is_token(next, "!")
				next = expect(next, "!")
				kind = NODE_CHECKED_INDEX
			var args = Array[i64]()
			args = args.append(lhs)
			let index = parse_expr(next, 0)
			next = index.state
			args = args.append(index.node)
			while next.error == "" and is_token(next, ",")
				next = expect(next, ",")
				let item = parse_expr(next, 0)
				next = item.state
				args = args.append(item.node)
			next = expect(next, "]")
			let node = append_node(next, kind, position, args)
			next = node.state
			lhs = node.node
			continue
		if op == "!" and min_bp <= 10
			let position = next.index
			next = expect(next, "!")
			let node = unary_node(next, NODE_UNWRAP, position, lhs)
			next = node.state
			lhs = node.node
			continue
		let bp = precedence(op)
		if bp < min_bp or bp < 0
			break
		let position = next.index
		next.index += 1
		let rhs = parse_expr(next, bp + 1)
		next = rhs.state
		let node = binary_node(next, NODE_BINARY, position, lhs, rhs.node)
		next = node.state
		lhs = node.node
	return ParseResult(next, lhs)

def parse_block(p: ParseState) -> ParseResult
	let token = p.index
	var next = expect_kind(p, Lex.TOKEN_NEWLINE, "newline")
	if next.error != ""
		return ParseResult(next, -1)
	next = expect_kind(next, Lex.TOKEN_INDENT, "indented block")
	var items = Array[i64]()
	while next.error == "" and not kind_is(next, Lex.TOKEN_DEDENT) and not kind_is(next, Lex.TOKEN_EOF)
		let item = parse_statement(next)
		next = item.state
		if next.error != ""
			break
		items = items.append(item.node)
	if next.error == "" and kind_is(next, Lex.TOKEN_EOF)
		next = fail(next, "unterminated block")
	if next.error == ""
		next = expect_kind(next, Lex.TOKEN_DEDENT, "dedent")
	return append_node(next, NODE_BLOCK, token, items)

# A rec implicitly publishes its parameters. Explicit pub declarations replace
# the corresponding implicit field; other pub declarations add new fields.
def rec_body(p: ParseState, params: Array[i64]) -> ParseResult
	var body = ParseResult(p, -1)
	if kind_is(p, Lex.TOKEN_NEWLINE)
		var next = expect_kind(p, Lex.TOKEN_NEWLINE, "newline")
		if kind_is(next, Lex.TOKEN_INDENT)
			body = parse_block(p)
		else
			body = append_node(next, NODE_BLOCK, p.index, Array[i64]())
	else
		return ParseResult(fail(p, "expected newline after rec parameters"), -1)
	if body.state.error != ""
		return body
	var next = body.state
	var statements = Array[i64]()
	let block = next.nodes[!body.node]
	for param in params
		let entry = next.nodes[!param]
		let name = Lex.token_text(next.source, next.tokens[!entry.token])
		var explicit = false
		for i in 0..block.count
			let child = next.edges[!block.first + i]
			let published = next.nodes[!child]
			if published.kind == NODE_PUB and Lex.token_text(next.source, next.tokens[!published.token]) == name
				explicit = true
		if not explicit
			let node = leaf(next, NODE_PUB, entry.token)
			next = node.state
			statements = statements.append(node.node)
	for i in 0..block.count
		statements = statements.append(next.edges[!block.first + i])
	return append_node(next, NODE_BLOCK, block.token, statements)

def parse_statement(p: ParseState) -> ParseResult
	let token = p.index
	let op = word(p)
	var next = p
	if op == "import"
		next.index += 1
		var path = Array[i64]()
		let first = next.index
		next = expect_kind(next, Lex.TOKEN_NAME, "module path")
		var node = leaf(next, NODE_NAME, first)
		next = node.state
		path = path.append(node.node)
		while next.error == "" and is_token(next, ".")
			next = expect(next, ".")
			let segment = next.index
			next = expect_kind(next, Lex.TOKEN_NAME, "module path segment")
			node = leaf(next, NODE_NAME, segment)
			next = node.state
			path = path.append(node.node)
		if next.error == "" and is_token(next, "alias")
			next = expect(next, "alias")
			let alias = next.index
			next = expect_kind(next, Lex.TOKEN_NAME, "import alias")
			node = leaf(next, NODE_BINDING, alias)
			next = node.state
			path = path.append(node.node)
		next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline")
		return append_node(next, NODE_IMPORT, token, path)
	if op == "export"
		next.index += 1
		if is_name(next) and not is_token(next, "def") and not is_token(next, "let") and not is_token(next, "rec") and not is_token(next, "enum")
			let owner = next.index
			next = expect_kind(next, Lex.TOKEN_NAME, "import alias")
			next = expect(next, ".")
			let member = next.index
			next = expect_kind(next, Lex.TOKEN_NAME, "exported member")
			let receiver = leaf(next, NODE_NAME, owner)
			let attribute = append_node(receiver.state, NODE_REEXPORT, member, [receiver.node])
			next = attribute.state
			var children = [attribute.node]
			if is_token(next, "alias")
				next = expect(next, "alias")
				let public_name = next.index
				next = expect_kind(next, Lex.TOKEN_NAME, "re-export name")
				let renamed = leaf(next, NODE_BINDING, public_name)
				next = renamed.state
				children = children.append(renamed.node)
			next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline")
			return append_node(next, NODE_EXPORT, token, children)
		if not is_token(next, "def") and not is_token(next, "let") and not is_token(next, "rec") and not is_token(next, "enum")
			return ParseResult(fail(next, "export requires def, rec, let or imported member"), -1)
		let definition = parse_statement(next)
		return unary_node(definition.state, NODE_EXPORT, token, definition.node)
	# Enum is syntactic sugar for empty record constructors and their labeled
	# union. Each case is kept as a NODE_REC child so HIR reuses constructors.
	if op == "enum" and p.tokens[!p.index + 1].kind == Lex.TOKEN_NAME
		next.index += 1
		let name = next.index
		next = expect_kind(next, Lex.TOKEN_NAME, "enum name")
		next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline")
		next = expect_kind(next, Lex.TOKEN_INDENT, "enum alternatives")
		var cases = Array[i64]()
		while next.error == "" and not kind_is(next, Lex.TOKEN_DEDENT) and not kind_is(next, Lex.TOKEN_EOF)
			let label = next.index
			next = expect_kind(next, Lex.TOKEN_NAME, "enum alternative")
			next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline after enum alternative")
			let body = append_node(next, NODE_BLOCK, label, Array[i64]())
			next = body.state
			let constructor = append_node(next, NODE_REC, label, [body.node])
			next = constructor.state
			cases = cases.append(constructor.node)
		next = expect_kind(next, Lex.TOKEN_DEDENT, "dedent")
		return append_node(next, NODE_ENUM, name, cases)
	if op == "def" or op == "rec" or op == "extern"
		next.index += 1
		if op == "extern"
			next = expect(next, "def")
		let name = next.index
		next = expect_kind(next, Lex.TOKEN_NAME, "function name")
		next = expect(next, "(")
		var args = Array[i64]()
		while next.error == "" and not is_token(next, ")")
			let arg = parse_param(next)
			next = arg.state
			if next.error != ""
				break
			args = args.append(arg.node)
			if not is_token(next, ",")
				break
			next = expect(next, ",")
		next = expect(next, ")")
		if (op == "def" or op == "extern") and next.error == "" and is_token(next, "->")
			next = expect(next, "->")
			let typ = parse_type(next)
			next = typ.state
			args = args.append(typ.node)
		var body = ParseResult(next, -1)
		if op == "rec"
			body = rec_body(next, args)
		elif op == "extern"
			next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline after extern declaration")
			body = append_node(next, NODE_BLOCK, name, Array[i64]())
		else
			body = parse_block(next)
		next = body.state
		args = args.append(body.node)
		if op == "rec"
			return append_node(next, NODE_REC, name, args)
		if op == "extern"
			return append_node(next, NODE_EXTERN_DEF, name, args)
		return append_node(next, NODE_DEF, name, args)
	if op == "if"
		var arms = Array[i64]()
		var first_arm = true
		while next.error == "" and ((first_arm and is_token(next, "if")) or (not first_arm and is_token(next, "elif")))
			first_arm = false
			let position = next.index
			next.index += 1
			let cond = parse_expr(next, 0)
			let body = parse_block(cond.state)
			let arm = binary_node(body.state, NODE_ARM, position, cond.node, body.node)
			next = arm.state
			arms = arms.append(arm.node)
		if next.error == "" and is_token(next, "else")
			let position = next.index
			next = expect(next, "else")
			let body = parse_block(next)
			let arm = unary_node(body.state, NODE_ELSE, position, body.node)
			next = arm.state
			arms = arms.append(arm.node)
		return append_node(next, NODE_IF, token, arms)
	if op == "while"
		next = expect(next, "while")
		let cond = parse_expr(next, 0)
		let body = parse_block(cond.state)
		return binary_node(body.state, NODE_WHILE, token, cond.node, body.node)
	if op == "for"
		next = expect(next, "for")
		let name = next.index
		next = expect_kind(next, Lex.TOKEN_NAME, "loop variable")
		var kids = Array[i64]()
		if next.error == "" and is_token(next, ":")
			next = expect(next, ":")
			let annotation = parse_type(next)
			next = annotation.state
			kids = kids.append(annotation.node)
		next = expect(next, "in")
		let iterable = parse_expr(next, 0)
		let body = parse_block(iterable.state)
		kids = kids.append(iterable.node)
		kids = kids.append(body.node)
		return append_node(body.state, NODE_FOR, name, kids)
	if op == "match"
		next = expect(next, "match")
		let value = parse_expr(next, 0)
		next = expect_kind(value.state, Lex.TOKEN_NEWLINE, "newline")
		next = expect_kind(next, Lex.TOKEN_INDENT, "indented match arms")
		var arms = Array[i64]()
		arms = arms.append(value.node)
		while next.error == "" and not kind_is(next, Lex.TOKEN_DEDENT) and not kind_is(next, Lex.TOKEN_EOF)
			var position = next.index
			let line = next.tokens[!position].line
			var variant = word(next)
			next = expect_kind(next, Lex.TOKEN_NAME, "variant name")
			if is_token(next, ".")
				next = expect(next, ".")
				variant += "." + word(next)
				next = expect_kind(next, Lex.TOKEN_NAME, "qualified variant name")
				if next.error == ""
					let start = len(next.source)
					next.source += variant
					position = len(next.tokens)
					next.tokens = next.tokens.append(Lex.Token(Lex.TOKEN_NAME, start, len(next.source), line, 0))
			next = expect(next, "(")
			var names = Array[i64]()
			while next.error == "" and not is_token(next, ")")
				let name = next.index
				next = expect_kind(next, Lex.TOKEN_NAME, "bound name")
				let leaf_result = leaf(next, NODE_BINDING, name)
				next = leaf_result.state
				names = names.append(leaf_result.node)
				if not is_token(next, ",")
					break
				next = expect(next, ",")
			next = expect(next, ")")
			let body = parse_block(next)
			next = body.state
			names = names.append(body.node)
			let arm = append_node(next, NODE_CASE, position, names)
			next = arm.state
			arms = arms.append(arm.node)
		next = expect_kind(next, Lex.TOKEN_DEDENT, "dedent")
		return append_node(next, NODE_MATCH, token, arms)
	if op == "let" or op == "var" or op == "pub"
		next.index += 1
		if is_token(next, "{")
			if op != "let"
				return ParseResult(fail(next, "record destructuring requires let"), -1)
			next = expect(next, "{")
			var fields = Array[i64]()
			while next.error == "" and not is_token(next, "}")
				let name = next.index
				next = expect_kind(next, Lex.TOKEN_NAME, "destructured binding")
				next = expect(next, "=")
				next = expect(next, ".")
				let selector = next.index
				next = expect_kind(next, Lex.TOKEN_NAME, "record field")
				let field_name = leaf(next, NODE_NAME, selector)
				let part = unary_node(field_name.state, NODE_FIELD, name, field_name.node)
				next = part.state
				fields = fields.append(part.node)
				if not is_token(next, ",")
					break
				next = expect(next, ",")
			if len(fields) == 0
				return ParseResult(fail(next, "record destructuring requires at least one field"), -1)
			next = expect(next, "}")
			next = expect(next, "=")
			let value = parse_expr(next, 0)
			next = expect_kind(value.state, Lex.TOKEN_NEWLINE, "newline")
			var items = Array[i64]()
			items = items.append(value.node)
			for field in fields
				items = items.append(field)
			return append_node(next, NODE_DESTRUCTURE, token, items)
		let name = next.index
		next = expect_kind(next, Lex.TOKEN_NAME, "binding name")
		var kids = Array[i64]()
		if op == "pub" and next.error == "" and is_token(next, ".")
			next = expect(next, ".")
			let field = next.index
			next = expect_kind(next, Lex.TOKEN_NAME, "published field name")
			let reference = leaf(next, NODE_NAME, name)
			let attr = unary_node(reference.state, NODE_ATTR, field, reference.node)
			next = attr.state
			kids = kids.append(attr.node)
		else
			if next.error == "" and is_token(next, ":")
				next = expect(next, ":")
				let typ = parse_type(next)
				next = typ.state
				kids = kids.append(typ.node)
			if next.error == "" and is_token(next, "=")
				next = expect(next, "=")
				let value = parse_expr(next, 0)
				next = value.state
				kids = kids.append(value.node)
				if next.error == "" and is_token(next, "else")
					next = expect(next, "else")
					next = expect(next, "return")
					let fallback = parse_expr(next, 0)
					next = fallback.state
					let node = unary_node(next, NODE_ELSE_RETURN, token, fallback.node)
					next = node.state
					kids = kids.append(node.node)
		next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline")
		if op == "let"
			return append_node(next, NODE_LET, name, kids)
		if op == "var"
			return append_node(next, NODE_VAR, name, kids)
		return append_node(next, NODE_PUB, name, kids)
	if op == "return" or op == "recur"
		next.index += 1
		if kind_is(next, Lex.TOKEN_NEWLINE)
			next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline")
			if op == "return"
				return leaf(next, NODE_RETURN, token)
			return leaf(next, NODE_RECUR, token)
		let value = parse_expr(next, 0)
		next = expect_kind(value.state, Lex.TOKEN_NEWLINE, "newline")
		if op == "return"
			return unary_node(next, NODE_RETURN, token, value.node)
		return unary_node(next, NODE_RECUR, token, value.node)
	if op == "break" or op == "continue"
		next.index += 1
		next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline")
		if op == "break"
			return leaf(next, NODE_BREAK, token)
		return leaf(next, NODE_CONTINUE, token)
	let lhs = parse_expr(next, 0)
	next = lhs.state
	if next.error != ""
		return ParseResult(next, -1)
	let assign = word(next)
	if assign == "=" or assign == "+=" or assign == "-=" or assign == "*=" or assign == "/="
		let position = next.index
		next.index += 1
		let rhs = parse_expr(next, 0)
		next = expect_kind(rhs.state, Lex.TOKEN_NEWLINE, "newline")
		return binary_node(next, NODE_ASSIGN, position, lhs.node, rhs.node)
	if next.error == "" and is_token(next, "else")
		next = expect(next, "else")
		let exit_token = next.index
		var exit_node = ParseResult(next, -1)
		if is_token(next, "return")
			next = expect(next, "return")
			if kind_is(next, Lex.TOKEN_NEWLINE)
				exit_node = leaf(next, NODE_RETURN, exit_token)
			else
				let value = parse_expr(next, 0)
				exit_node = unary_node(value.state, NODE_RETURN, exit_token, value.node)
		elif is_token(next, "break") or is_token(next, "continue")
			let is_break = is_token(next, "break")
			next.index += 1
			if is_break
				exit_node = leaf(next, NODE_BREAK, exit_token)
			else
				exit_node = leaf(next, NODE_CONTINUE, exit_token)
		else
			return ParseResult(fail(next, "guard else requires return, break, or continue"), -1)
		next = expect_kind(exit_node.state, Lex.TOKEN_NEWLINE, "newline")
		return binary_node(next, NODE_GUARD, token, lhs.node, exit_node.node)
	next = expect_kind(next, Lex.TOKEN_NEWLINE, "newline")
	return unary_node(next, NODE_EXPR, token, lhs.node)

export def parse_module(source: string) -> ParseResult
	let tokens = Lex.tokenize(source)
	var p = new_parse_state(source, tokens)
	for token in tokens
		if token.kind < 0
			p.error = Lex.token_kind_name(token.kind)
			p.error_line = token.line
			return ParseResult(p, -1)
	var children = Array[i64]()
	while p.error == "" and not kind_is(p, Lex.TOKEN_EOF)
		let item = parse_statement(p)
		p = item.state
		if p.error != ""
			break
		children = children.append(item.node)
	return append_node(p, NODE_MODULE, 0, children)
