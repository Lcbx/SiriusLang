# Sirius stage-1 syntax parser. Concatenate after tokenizer.sirius until imports exist.
# The AST is an arena: children are node IDs, never recursively allocated records.
# Node.token indexes the original token array; identifiers/literals retain source spans.

# Kinds are strings for clarity while the type/enum system is still minimal.
def Node(kind: string, token: i64, first: i64, count: i64)
	pub kind
	pub token
	pub first
	pub count

def ParseState(source: string, tokens: Array[Token])
	pub source
	pub tokens
	pub nodes = Array[Node]()
	pub edges = Array[i64]()
	pub index = 0
	pub error = ""
	pub error_line = 0

def ParseResult(state: ParseState, node: i64)
	pub state
	pub node

def current(p: ParseState) -> Token
	return p.tokens[p.index?]!

def word(p: ParseState) -> string
	return token_text(p.source, current(p))

def is_token(p: ParseState, value: string) -> bool
	return word(p) == value

def kind_is(p: ParseState, kind: i64) -> bool
	return current(p).kind == kind

def fail(p: ParseState, message: string) -> ParseState
	var next = p
	if next.error == ""
		next.error = message
		next.error_line = current(p).line
	return next

def expect(p: ParseState, value: string) -> ParseState
	if p.error != ""
		return p
	if not is_token(p, value)
		return fail(p, "expected '" + value + "', found '" + word(p) + "'")
	var next = p
	next.index += 1
	return next

def expect_kind(p: ParseState, kind: i64, description: string) -> ParseState
	if p.error != ""
		return p
	if not kind_is(p, kind)
		return fail(p, "expected " + description + ", found '" + word(p) + "'")
	var next = p
	next.index += 1
	return next

def is_name(p: ParseState) -> bool
	return kind_is(p, 1)

def append_node(p: ParseState, kind: string, token: i64, children: Array[i64]) -> ParseResult
	if p.error != ""
		return ParseResult(p, -1)
	var next = p
	let first = len(next.edges)
	for child in children
		next.edges = next.edges.append(child)
	let index = len(next.nodes)
	next.nodes = next.nodes.append(Node(kind, token, first, len(children)))
	return ParseResult(next, index)

def leaf(p: ParseState, kind: string, token: i64) -> ParseResult
	return append_node(p, kind, token, Array[i64]())

def unary_node(p: ParseState, kind: string, token: i64, a: i64) -> ParseResult
	var children = Array[i64]()
	children = children.append(a)
	return append_node(p, kind, token, children)

def binary_node(p: ParseState, kind: string, token: i64, a: i64, b: i64) -> ParseResult
	var children = Array[i64]()
	children = children.append(a)
	children = children.append(b)
	return append_node(p, kind, token, children)

def precedence(op: string) -> i64
	if op == "or"
		return 1
	if op == "and"
		return 2
	if op == "|"
		return 3
	if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
		return 4
	if op == ".."
		return 5
	if op == "+" or op == "-"
		return 6
	if op == "*" or op == "/" or op == "%"
		return 7
	return -1

def parse_type(p: ParseState) -> ParseResult
	let token = p.index
	var next = expect_kind(p, 1, "type name")
	if next.error != ""
		return ParseResult(next, -1)
	var args = Array[i64]()
	if is_token(next, "[")
		next = expect(next, "[")
		while next.error == "" and not is_token(next, "]")
			var item = ParseResult(next, -1)
			if kind_is(next, 2)
				let index = next.index
				next.index += 1
				item = leaf(next, "integer", index)
			else
				item = parse_type(next)
			next = item.state
			if next.error != ""
				break
			args = args.append(item.node)
			if not is_token(next, ",")
				break
			next = expect(next, ",")
		next = expect(next, "]")
	return append_node(next, "type", token, args)

def parse_param(p: ParseState) -> ParseResult
	let token = p.index
	var next = expect_kind(p, 1, "parameter name")
	var children = Array[i64]()
	if next.error == "" and is_token(next, ":")
		next = expect(next, ":")
		let annotation = parse_type(next)
		next = annotation.state
		children = children.append(annotation.node)
	if next.error == "" and is_token(next, "=")
		next = expect(next, "=")
		let value = parse_expr(next, 0)
		next = value.state
		children = children.append(value.node)
	return append_node(next, "param", token, children)

def parse_expr(p: ParseState, min_bp: i64) -> ParseResult
	if p.error != ""
		return ParseResult(p, -1)
	let token = p.index
	let t = current(p)
	let text = word(p)
	var next = p
	next.index += 1
	var lhs = -1
	if text == "-" or text == "+" or text == "not" or text == "~"
		let value = parse_expr(next, 8)
		next = value.state
		let node = unary_node(next, "unary", token, value.node)
		next = node.state
		lhs = node.node
	elif text == "("
		let inner = parse_expr(next, 0)
		next = expect(inner.state, ")")
		lhs = inner.node
	elif text == "["
		var items = Array[i64]()
		while next.error == "" and not is_token(next, "]")
			let item = parse_expr(next, 0)
			next = item.state
			if next.error != ""
				break
			items = items.append(item.node)
			if not is_token(next, ",")
				break
			next = expect(next, ",")
		next = expect(next, "]")
		let node = append_node(next, "array", token, items)
		next = node.state
		lhs = node.node
	elif text == "{"
		var fields = Array[i64]()
		while next.error == "" and not is_token(next, "}")
			let name = next.index
			var item = ParseResult(next, -1)
			if is_token(next, "del")
				next = expect(next, "del")
				let deleted = next.index
				next = expect_kind(next, 1, "deleted field")
				item = leaf(next, "delete", deleted)
			else
				next = expect_kind(next, 1, "field name")
				if is_token(next, ".")
					next = expect(next, ".")
					next = expect(next, "*")
					item = leaf(next, "spread", name)
				else
					next = expect(next, "=")
					let value = parse_expr(next, 0)
					item = unary_node(value.state, "field", name, value.node)
			next = item.state
			if next.error != ""
				break
			fields = fields.append(item.node)
			if is_token(next, ",")
				next = expect(next, ",")
		next = expect(next, "}")
		let node = append_node(next, "record", token, fields)
		next = node.state
		lhs = node.node
	elif text == "fn"
		next = expect(next, "(")
		var args = Array[i64]()
		while next.error == "" and not is_token(next, ")")
			let item = parse_param(next)
			next = item.state
			if next.error != ""
				break
			args = args.append(item.node)
			if not is_token(next, ",")
				break
			next = expect(next, ",")
		next = expect(next, ")")
		let body = parse_expr(next, 0)
		next = body.state
		args = args.append(body.node)
		let node = append_node(next, "lambda", token, args)
		next = node.state
		lhs = node.node
	elif text == "true" or text == "false"
		let node = leaf(next, "bool", token)
		next = node.state
		lhs = node.node
	elif t.kind == 1
		let node = leaf(next, "name", token)
		next = node.state
		lhs = node.node
	elif t.kind == 2
		let node = leaf(next, "integer", token)
		next = node.state
		lhs = node.node
	elif t.kind == 3
		let node = leaf(next, "float", token)
		next = node.state
		lhs = node.node
	elif t.kind == 4
		let node = leaf(next, "string", token)
		next = node.state
		lhs = node.node
	else
		return ParseResult(fail(p, "unexpected expression '" + text + "'"), -1)

	while next.error == ""
		let op = word(next)
		if op == "(" and min_bp <= 10
			let position = next.index
			next = expect(next, "(")
			var args = Array[i64]()
			args = args.append(lhs)
			while next.error == "" and not is_token(next, ")")
				let arg = parse_expr(next, 0)
				next = arg.state
				if next.error != ""
					break
				args = args.append(arg.node)
				if not is_token(next, ",")
					break
				next = expect(next, ",")
			next = expect(next, ")")
			let node = append_node(next, "call", position, args)
			next = node.state
			lhs = node.node
			continue
		if op == "." and min_bp <= 10
			next = expect(next, ".")
			let name = next.index
			next = expect_kind(next, 1, "member name")
			let node = unary_node(next, "attr", name, lhs)
			next = node.state
			lhs = node.node
			continue
		if op == "[" and min_bp <= 10
			let position = next.index
			next = expect(next, "[")
			var args = Array[i64]()
			args = args.append(lhs)
			let index = parse_expr(next, 0)
			next = index.state
			args = args.append(index.node)
			while next.error == "" and is_token(next, ",")
				next = expect(next, ",")
				let item = parse_expr(next, 0)
				next = item.state
				args = args.append(item.node)
			var kind = "index"
			if next.error == "" and is_token(next, "?")
				next = expect(next, "?")
				kind = "optional_index"
			next = expect(next, "]")
			if next.error == "" and is_token(next, "!")
				next = expect(next, "!")
				if kind != "optional_index"
					next = fail(next, "checked indexing requires '?'")
				kind = "checked_index"
			let node = append_node(next, kind, position, args)
			next = node.state
			lhs = node.node
			continue
		let bp = precedence(op)
		if bp < min_bp or bp < 0
			break
		let position = next.index
		next.index += 1
		let rhs = parse_expr(next, bp + 1)
		next = rhs.state
		let node = binary_node(next, "binary", position, lhs, rhs.node)
		next = node.state
		lhs = node.node
	return ParseResult(next, lhs)

def parse_block(p: ParseState) -> ParseResult
	let token = p.index
	var next = expect_kind(p, 6, "newline")
	if next.error != ""
		return ParseResult(next, -1)
	next = expect_kind(next, 7, "indented block")
	var items = Array[i64]()
	while next.error == "" and not kind_is(next, 8) and not kind_is(next, 9)
		let item = parse_statement(next)
		next = item.state
		if next.error != ""
			break
		items = items.append(item.node)
	if next.error == "" and kind_is(next, 9)
		next = fail(next, "unterminated block")
	if next.error == ""
		next = expect_kind(next, 8, "dedent")
	return append_node(next, "block", token, items)

def parse_statement(p: ParseState) -> ParseResult
	let token = p.index
	let op = word(p)
	var next = p
	if op == "def"
		next = expect(next, "def")
		let name = next.index
		next = expect_kind(next, 1, "function name")
		next = expect(next, "(")
		var args = Array[i64]()
		while next.error == "" and not is_token(next, ")")
			let arg = parse_param(next)
			next = arg.state
			if next.error != ""
				break
			args = args.append(arg.node)
			if not is_token(next, ",")
				break
			next = expect(next, ",")
		next = expect(next, ")")
		if next.error == "" and is_token(next, "->")
			next = expect(next, "->")
			let typ = parse_type(next)
			next = typ.state
			args = args.append(typ.node)
		let body = parse_block(next)
		next = body.state
		args = args.append(body.node)
		return append_node(next, "def", name, args)
	if op == "if"
		var arms = Array[i64]()
		while next.error == "" and (is_token(next, "if") or is_token(next, "elif"))
			let position = next.index
			next.index += 1
			let cond = parse_expr(next, 0)
			let body = parse_block(cond.state)
			let arm = binary_node(body.state, "arm", position, cond.node, body.node)
			next = arm.state
			arms = arms.append(arm.node)
		if next.error == "" and is_token(next, "else")
			let position = next.index
			next = expect(next, "else")
			let body = parse_block(next)
			let arm = unary_node(body.state, "else", position, body.node)
			next = arm.state
			arms = arms.append(arm.node)
		return append_node(next, "if", token, arms)
	if op == "while"
		next = expect(next, "while")
		let cond = parse_expr(next, 0)
		let body = parse_block(cond.state)
		return binary_node(body.state, "while", token, cond.node, body.node)
	if op == "for"
		next = expect(next, "for")
		let name = next.index
		next = expect_kind(next, 1, "loop variable")
		var kids = Array[i64]()
		if next.error == "" and is_token(next, ":")
			next = expect(next, ":")
			let annotation = parse_type(next)
			next = annotation.state
			kids = kids.append(annotation.node)
		next = expect(next, "in")
		let iterable = parse_expr(next, 0)
		let body = parse_block(iterable.state)
		kids = kids.append(iterable.node)
		kids = kids.append(body.node)
		return append_node(body.state, "for", name, kids)
	if op == "match"
		next = expect(next, "match")
		let value = parse_expr(next, 0)
		next = expect_kind(value.state, 6, "newline")
		next = expect_kind(next, 7, "indented match arms")
		var arms = Array[i64]()
		arms = arms.append(value.node)
		while next.error == "" and not kind_is(next, 8) and not kind_is(next, 9)
			let position = next.index
			next = expect_kind(next, 1, "variant name")
			next = expect(next, "(")
			var names = Array[i64]()
			while next.error == "" and not is_token(next, ")")
				let name = next.index
				next = expect_kind(next, 1, "bound name")
				let leaf_result = leaf(next, "binding", name)
				next = leaf_result.state
				names = names.append(leaf_result.node)
				if not is_token(next, ",")
					break
				next = expect(next, ",")
			next = expect(next, ")")
			let body = parse_block(next)
			next = body.state
			names = names.append(body.node)
			let arm = append_node(next, "case", position, names)
			next = arm.state
			arms = arms.append(arm.node)
		next = expect_kind(next, 8, "dedent")
		return append_node(next, "match", token, arms)
	if op == "let" or op == "var" or op == "pub"
		next.index += 1
		let name = next.index
		next = expect_kind(next, 1, "binding name")
		var kids = Array[i64]()
		if op == "pub" and next.error == "" and is_token(next, ".")
			next = expect(next, ".")
			let field = next.index
			next = expect_kind(next, 1, "published field name")
			let reference = leaf(next, "name", name)
			let attr = unary_node(reference.state, "attr", field, reference.node)
			next = attr.state
			kids = kids.append(attr.node)
		else
			if next.error == "" and is_token(next, ":")
				next = expect(next, ":")
				let typ = parse_type(next)
				next = typ.state
				kids = kids.append(typ.node)
			if next.error == "" and is_token(next, "=")
				next = expect(next, "=")
				let value = parse_expr(next, 0)
				next = value.state
				kids = kids.append(value.node)
				if next.error == "" and is_token(next, "else")
					next = expect(next, "else")
					next = expect(next, "return")
					let fallback = parse_expr(next, 0)
					next = fallback.state
					let node = unary_node(next, "else_return", token, fallback.node)
					next = node.state
					kids = kids.append(node.node)
		next = expect_kind(next, 6, "newline")
		return append_node(next, op, name, kids)
	if op == "return" or op == "recur"
		next.index += 1
		if kind_is(next, 6)
			next = expect_kind(next, 6, "newline")
			return leaf(next, op, token)
		let value = parse_expr(next, 0)
		next = expect_kind(value.state, 6, "newline")
		return unary_node(next, op, token, value.node)
	if op == "break" or op == "continue"
		next.index += 1
		next = expect_kind(next, 6, "newline")
		return leaf(next, op, token)
	let lhs = parse_expr(next, 0)
	next = lhs.state
	if next.error != ""
		return ParseResult(next, -1)
	let assign = word(next)
	if assign == "=" or assign == "+=" or assign == "-=" or assign == "*=" or assign == "/="
		let position = next.index
		next.index += 1
		let rhs = parse_expr(next, 0)
		next = expect_kind(rhs.state, 6, "newline")
		return binary_node(next, "assign", position, lhs.node, rhs.node)
	next = expect_kind(next, 6, "newline")
	return unary_node(next, "expr", token, lhs.node)

def parse_module(source: string) -> ParseResult
	let tokens = tokenize(source)
	var p = ParseState(source, tokens)
	for token in tokens
		if token.kind < 0
			p.error = token_kind_name(token.kind)
			p.error_line = token.line
			return ParseResult(p, -1)
	var children = Array[i64]()
	while p.error == "" and not kind_is(p, 9)
		let item = parse_statement(p)
		p = item.state
		if p.error != ""
			break
		children = children.append(item.node)
	return append_node(p, "module", 0, children)
