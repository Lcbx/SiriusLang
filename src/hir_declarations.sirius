import types alias Types
import parser alias Ast
import hir alias Hir
import hir_constants alias Constants
import hir_analyze alias Analyze

# A module-local type alias is a union of constructor names, not a runtime
# constant. Resolve after collecting all constructors to allow forward names.
rec HirTypeUnionSource(name: string, source: i64)

def hir_union_members(tree: Ast.ParseState, id: i64) -> Array[i64]
	let node = tree.nodes[!id]
	if node.kind == Ast.NODE_NAME
		return [id]
	if node.kind != Ast.NODE_BINARY or Hir.hir_ast_text(tree, id) != "|"
		return Array[i64]()
	var left = hir_union_members(tree, Hir.hir_ast_child(tree, id, 0))
	let right = hir_union_members(tree, Hir.hir_ast_child(tree, id, 1))
	if len(left) == 0 or len(right) == 0
		return Array[i64]()
	for member in right
		left = left.append(member)
	return left

def hir_declaration_type_signature(tree: Ast.ParseState, id: i64) -> string
	let node = tree.nodes[!id]
	var result = Hir.hir_ast_text(tree, id) + "["
	for i in 0..node.count
		let child = hir_declaration_type_signature(tree, Hir.hir_ast_child(tree, id, i))
		result += str(len(child)) + ":" + child
	return result + "]"

# Executables retain concrete public functions as well as their entry point.
# Exported generics remain templates until concrete arguments are supplied.
export def hir_executable_roots(declarations: Hir.HirModuleDecl, entry: string) -> Array[string]
	var roots = [entry]
	for name in declarations.exports
		if name == entry
			continue
		for function in declarations.functions
			if function.name != name or function.constructor
				continue
			var concrete = true
			for parameter in function.parameters
				if parameter.type_node < 0
					concrete = false
			if concrete
				roots = roots.append(name)
				break
	return roots

export def hir_declaration_error(functions: Array[Hir.HirFunctionDecl], constants: Array[Hir.HirModuleConstant], message: string, line: i64) -> Hir.HirModuleDecl
	return Hir.new_hir_module_decl(functions, constants, Types.new_type_table(), Array[Hir.HirConstantValue](), message, line)

export def hir_module_declarations(tree: Ast.ParseState, root: i64) -> Hir.HirModuleDecl
	var functions = Array[Hir.HirFunctionDecl]()
	var names = Array[string]()
	var function_exports = Array[bool]()
	var constants = Array[Hir.HirModuleConstant]()
	var types = Types.new_type_table()
	var values = Array[Hir.HirConstantValue]()
	let module = tree.nodes[!root]
	var imports = Array[Hir.HirImport]()
	var exports = Array[string]()
	var reexports = Array[Hir.HirReexport]()
	var union_sources = Array[HirTypeUnionSource]()
	var enum_sources = Array[i64]()
	for i in 0..module.count
		var id = Hir.hir_ast_child(tree, root, i)
		var entry = tree.nodes[!id]
		var published = false
		if entry.kind == Ast.NODE_IMPORT
			var path = ""
			var alias = ""
			for j in 0..entry.count
				let child = Hir.hir_ast_child(tree, id, j)
				let item = tree.nodes[!child]
				if item.kind == Ast.NODE_BINDING
					alias = Hir.hir_ast_text(tree, child)
				else
					let segment = Hir.hir_ast_text(tree, child)
					if path != ""
						path += "."
					path += segment
					if alias == ""
						alias = segment
			for previous in imports
				if previous.alias == alias
					return hir_declaration_error(functions, constants, "duplicate import alias '" + alias + "'", Hir.hir_ast_line(tree, id))
			imports = imports.append(Hir.HirImport(path, alias))
			continue
		if entry.kind == Ast.NODE_EXPORT
			published = true
			let exported = id
			id = Hir.hir_ast_child(tree, id, 0)
			entry = tree.nodes[!id]
			if entry.kind == Ast.NODE_REEXPORT
				let owner = Hir.hir_ast_child(tree, id, 0)
				var public_name = Hir.hir_ast_text(tree, id)
				if tree.nodes[!exported].count == 2
					public_name = Hir.hir_ast_text(tree, Hir.hir_ast_child(tree, exported, 1))
				reexports = reexports.append(Hir.HirReexport(Hir.hir_ast_text(tree, owner), Hir.hir_ast_text(tree, id), public_name))
				continue
			if entry.kind != Ast.NODE_DEF and entry.kind != Ast.NODE_LET and entry.kind != Ast.NODE_REC and entry.kind != Ast.NODE_ENUM
				return hir_declaration_error(functions, constants, "export requires def, rec, let or enum", Hir.hir_ast_line(tree, id))
			var has_return = false
			for j in 0..entry.count - 1
				if tree.nodes[!Hir.hir_ast_child(tree, id, j)].kind == Ast.NODE_TYPE
					has_return = true
			if entry.kind == Ast.NODE_DEF and not has_return
				var generic = false
				for j in 0..entry.count - 1
					let child = Hir.hir_ast_child(tree, id, j)
					if tree.nodes[!child].kind == Ast.NODE_PARAM and tree.nodes[!child].count == 0
						generic = true
				if not generic
					return hir_declaration_error(functions, constants, "exported nongeneric function requires a return type", Hir.hir_ast_line(tree, id))
			var already_exported = false
			for exported_name in exports
				if exported_name == Hir.hir_ast_text(tree, id)
					already_exported = true
			if not already_exported
				exports = exports.append(Hir.hir_ast_text(tree, id))
		let name = Hir.hir_ast_text(tree, id)
		for imported in imports
			if imported.alias == name
				return hir_declaration_error(functions, constants, "declaration shadows module alias '" + name + "'", Hir.hir_ast_line(tree, id))
		if entry.kind != Ast.NODE_DEF and entry.kind != Ast.NODE_REC and entry.kind != Ast.NODE_LET and entry.kind != Ast.NODE_EXTERN_DEF and entry.kind != Ast.NODE_ENUM
			return hir_declaration_error(functions, constants, "unsupported module statement", Hir.hir_ast_line(tree, id))
		if (name == "print" or name == "eprint") and (entry.kind == Ast.NODE_DEF or entry.kind == Ast.NODE_REC or entry.kind == Ast.NODE_EXTERN_DEF)
			return hir_declaration_error(functions, constants, "duplicate function '" + name + "'", Hir.hir_ast_line(tree, id))
		for seen in names
			if seen == name
				var earlier_function = false
				for previous in functions
					if previous.name == name
						earlier_function = true
				if not earlier_function
					return hir_declaration_error(functions, constants, "duplicate module name '" + name + "'", Hir.hir_ast_line(tree, id))
				if entry.kind == Ast.NODE_LET or entry.kind == Ast.NODE_REC or entry.kind == Ast.NODE_EXTERN_DEF
					return hir_declaration_error(functions, constants, "duplicate module name '" + name + "'", Hir.hir_ast_line(tree, id))
				for j in 0..len(functions)
					let previous = functions[!j]
					if previous.name == name and function_exports[!j] != published
						return hir_declaration_error(functions, constants, "overloads must have consistent export visibility for '" + name + "'", Hir.hir_ast_line(tree, id))
					if previous.name == name and (previous.constructor or tree.nodes[!previous.source].kind != Ast.NODE_DEF)
						return hir_declaration_error(functions, constants, "cannot overload constructor or extern '" + name + "'", Hir.hir_ast_line(tree, id))
		names = names.append(name)
		if entry.kind == Ast.NODE_ENUM
			enum_sources = enum_sources.append(id)
			for j in 0..entry.count
				let item = Hir.hir_ast_child(tree, id, j)
				let label = Hir.hir_ast_text(tree, item)
				for previous in names
					if previous == label
						return hir_declaration_error(functions, constants, "duplicate enum alternative '" + label + "'", Hir.hir_ast_line(tree, item))
				names = names.append(label)
				let body = Hir.hir_ast_child(tree, item, 0)
				functions = functions.append(Hir.new_hir_function_decl(label, item, body, true, -1, Array[Hir.HirParameterDecl]()))
				function_exports = function_exports.append(published)
				if published
					exports = exports.append(label)
			continue
		if entry.kind == Ast.NODE_LET
			if entry.count == 0
				return hir_declaration_error(functions, constants, "module constant requires initializer", Hir.hir_ast_line(tree, id))
			let initializer = Hir.hir_ast_child(tree, id, entry.count - 1)
			if tree.nodes[!initializer].kind == Ast.NODE_BINARY and Hir.hir_ast_text(tree, initializer) == "|"
				if entry.count != 1
					return hir_declaration_error(functions, constants, "union type alias cannot have a value annotation", Hir.hir_ast_line(tree, id))
				union_sources = union_sources.append(HirTypeUnionSource(name, initializer))
				continue
			let evaluated = Constants.hir_eval_constant(types, values, tree, initializer, constants)
			var evaluated_index = -1
			match evaluated.outcome
				Hir.HirConstantFound(index)
					evaluated_index = index
				Hir.HirConstantUnavailable
					return hir_declaration_error(functions, constants, "unsupported module constant initializer", Hir.hir_ast_line(tree, id))
			types = evaluated.table
			values = evaluated.values
			let type_id = values[!evaluated_index].type_id
			if entry.count > 1
				let annotation = Hir.hir_ast_child(tree, id, 0)
				if tree.nodes[!annotation].kind == Ast.NODE_TYPE
					let annotated = Hir.hir_ast_text(tree, annotation)
					if (annotated != "i64" or type_id != Types.TYPE_TAG_I64) and (annotated != "bool" or type_id != Types.TYPE_TAG_BOOL) and (annotated != "string" or type_id != Types.TYPE_TAG_STRING)
						return hir_declaration_error(functions, constants, "module constant type mismatch", Hir.hir_ast_line(tree, id))
			constants = constants.append(Hir.HirModuleConstant(name, evaluated_index, type_id))
			continue
		var parameters = Array[Hir.HirParameterDecl]()
		var return_type = -1
		for j in 0..entry.count - 1
			let part = Hir.hir_ast_child(tree, id, j)
			let info = tree.nodes[!part]
			if info.kind == Ast.NODE_PARAM
				var annotation = -1
				if info.count > 0
					annotation = Hir.hir_ast_child(tree, part, 0)
					if info.count != 1 or tree.nodes[!annotation].kind != Ast.NODE_TYPE
						return hir_declaration_error(functions, constants, "parameter defaults are not supported yet", Hir.hir_ast_line(tree, part))
				let pname = Hir.hir_ast_text(tree, part)
				for previous in parameters
					if previous.name == pname
						return hir_declaration_error(functions, constants, "duplicate parameter '" + pname + "'", Hir.hir_ast_line(tree, part))
				parameters = parameters.append(Hir.HirParameterDecl(pname, part, annotation))
			elif info.kind == Ast.NODE_TYPE
				return_type = part
		let body_id = Hir.hir_ast_child(tree, id, entry.count - 1)
		for previous in functions
			if previous.name != name
				continue
			for parameter in previous.parameters
				if parameter.type_node < 0
					return hir_declaration_error(functions, constants, "overloads require annotated parameter types for '" + name + "'", Hir.hir_ast_line(tree, id))
			for parameter in parameters
				if parameter.type_node < 0
					return hir_declaration_error(functions, constants, "overloads require annotated parameter types for '" + name + "'", Hir.hir_ast_line(tree, id))
			if len(previous.parameters) != len(parameters)
				continue
			var same = true
			for j in 0..len(parameters)
				let left = previous.parameters[!j].type_node
				let right = parameters[!j].type_node
				if left < 0 or right < 0
					return hir_declaration_error(functions, constants, "overloads require annotated parameter types for '" + name + "'", Hir.hir_ast_line(tree, id))
				if hir_declaration_type_signature(tree, left) != hir_declaration_type_signature(tree, right)
					same = false
			if same
				return hir_declaration_error(functions, constants, "duplicate overload signature for '" + name + "'", Hir.hir_ast_line(tree, id))
		if entry.kind == Ast.NODE_EXTERN_DEF
			if return_type < 0
				return hir_declaration_error(functions, constants, "extern function requires a return type", Hir.hir_ast_line(tree, id))
			for parameter in parameters
				if parameter.type_node < 0
					return hir_declaration_error(functions, constants, "extern parameter requires a type", Hir.hir_ast_line(tree, id))
		if entry.kind == Ast.NODE_DEF
			let body = tree.nodes[!body_id]
			for j in 0..body.count
				if tree.nodes[!Hir.hir_ast_child(tree, body_id, j)].kind == Ast.NODE_PUB
					return hir_declaration_error(functions, constants, "def constructors are no longer supported; use rec", Hir.hir_ast_line(tree, id))
		functions = functions.append(Hir.new_hir_function_decl(name, id, body_id, entry.kind == Ast.NODE_REC, return_type, parameters))
		function_exports = function_exports.append(published)
	# Lambdas are private, noncapturing functions. Their AST node is a stable
	# specialization identity, including in serialized generic modules.
	for id in 0..len(tree.nodes)
		let entry = tree.nodes[!id]
		if entry.kind != Ast.NODE_LAMBDA
			continue
		var parameters = Array[Hir.HirParameterDecl]()
		for j in 0..entry.count - 1
			let part = Hir.hir_ast_child(tree, id, j)
			let info = tree.nodes[!part]
			var annotation = -1
			if info.count > 0
				annotation = Hir.hir_ast_child(tree, part, 0)
				if info.count != 1 or tree.nodes[!annotation].kind != Ast.NODE_TYPE
					return hir_declaration_error(functions, constants, "lambda parameter defaults are not supported", Hir.hir_ast_line(tree, part))
			let pname = Hir.hir_ast_text(tree, part)
			for previous in parameters
				if previous.name == pname
					return hir_declaration_error(functions, constants, "duplicate lambda parameter '" + pname + "'", Hir.hir_ast_line(tree, part))
			parameters = parameters.append(Hir.HirParameterDecl(pname, part, annotation))
		functions = functions.append(Hir.new_hir_function_decl("#lambda" + str(id), id, id, false, -1, parameters))
	for imported in imports
		for name in names
			if imported.alias == name
				return hir_declaration_error(functions, constants, "declaration shadows module alias '" + name + "'", 1)
	var published_reexports = Array[string]()
	for reexport in reexports
		for previous in published_reexports
			if previous == reexport.public_name
				return hir_declaration_error(functions, constants, "duplicate exported name: " + reexport.public_name, 1)
		published_reexports = published_reexports.append(reexport.public_name)
		var found = false
		for imported in imports
			if imported.alias == reexport.alias
				found = true
		if not found
			return hir_declaration_error(functions, constants, "unknown re-export module alias: " + reexport.alias, 1)
		for name in names
			if name == reexport.public_name
				return hir_declaration_error(functions, constants, "duplicate exported name: " + name, 1)
	var aliases = Array[Hir.HirTypeAlias]()
	for source in union_sources
		let members = hir_union_members(tree, source.source)
		if len(members) < 2
			return hir_declaration_error(functions, constants, "union requires at least two constructor alternatives", Hir.hir_ast_line(tree, source.source))
		var alternatives = Array[Types.RecordField]()
		for member in members
			let name = Hir.hir_ast_text(tree, member)
			var constructor = false
			for function in functions
				if function.name == name and function.constructor
					constructor = true
			if not constructor
				return hir_declaration_error(functions, constants, "unknown union constructor '" + name + "'", Hir.hir_ast_line(tree, member))
			let resolved = Analyze.hir_module_type_reference_with_constants(types, tree, member, functions, constants, aliases)
			if resolved.error != ""
				return hir_declaration_error(functions, constants, resolved.error, Hir.hir_ast_line(tree, member))
			types = resolved.table
			if Types.type_tag(types, resolved.type_id) != Types.TYPE_TAG_RECORD
				return hir_declaration_error(functions, constants, "union constructor requires annotated record fields", Hir.hir_ast_line(tree, member))
			alternatives = alternatives.append(Types.RecordField(name, resolved.type_id))
		let interned = Types.intern_labeled_union_type(types, alternatives)
		if interned.id == Types.TYPE_TAG_INVALID
			return hir_declaration_error(functions, constants, "union alternatives must have distinct constructor labels", Hir.hir_ast_line(tree, source.source))
		types = interned.table
		aliases = aliases.append(Hir.HirTypeAlias(source.name, interned.id))
	for source in enum_sources
		let declaration = tree.nodes[!source]
		var alternatives = Array[Types.RecordField]()
		for i in 0..declaration.count
			let item = Hir.hir_ast_child(tree, source, i)
			let record = Types.intern_record_type(types, Array[Types.RecordField]())
			types = record.table
			alternatives = alternatives.append(Types.RecordField(Hir.hir_ast_text(tree, item), record.id))
		let interned = Types.intern_labeled_union_type(types, alternatives)
		if interned.id == Types.TYPE_TAG_INVALID
			return hir_declaration_error(functions, constants, "enum requires at least two distinct alternatives", Hir.hir_ast_line(tree, source))
		types = interned.table
		aliases = aliases.append(Hir.HirTypeAlias(Hir.hir_ast_text(tree, source), interned.id))
	var result = Hir.new_hir_module_decl(functions, constants, types, values, "", 0)
	result.imports = imports
	result.exports = exports
	result.reexports = reexports
	result.type_aliases = aliases
	return result


# Native module imports carry canonical TypeIds and have no source AST nodes.
# Source-written extern declarations continue to use their AST annotations.
export def hir_function_external(tree: Ast.ParseState, function: Hir.HirFunctionDecl) -> bool
	return function.external or (function.source >= 0 and tree.nodes[!function.source].kind == Ast.NODE_EXTERN_DEF)
