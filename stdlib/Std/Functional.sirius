# Sequential 1D collection helpers using noncapturing Fn callbacks.
# Map, filter, generate and fold specialize on argument and result types.
# Callback purity is not enforced by the compiler.

export rec IndexedI64(index: i64, value: i64)
	pub index
	pub value

export rec IndexedF64(index: i64, value: f64)
	pub index
	pub value

export rec IndexedString(index: i64, value: string)
	pub index
	pub value

# Array constructors infer the result element type from a callback's Fn return
# type or an existing collection, including when the input is empty.
# Generic calls infer callback input types from concrete arguments where unambiguous.
export def map(values, callback)
	var result = empty_array_like(callback)
	for value in values
		result = result.append(callback(value))
	return result

# Explicit environment passing for callbacks that would otherwise need a
# lexical capture. The environment is a normal CoW value; no closure heap or
# implicit capture is involved. The callback takes (element, environment).
export def map_with_context(values, context, callback)
	var result = empty_array_like(callback)
	for value in values
		result = result.append(callback(value, context))
	return result

export def filter(values, predicate)
	var result = empty_array_like(values)
	for value in values
		if predicate(value)
			result = result.append(value)
	return result

export def generate(count: i64, callback)
	var result = empty_array_like(callback)
	var index = 0
	while index < count
		result = result.append(callback(index))
		index += 1
	return result

# Generic in both collection element and accumulator type.
export def fold(values, initial, callback)
	var result = initial
	for value in values
		result = callback(result, value)
	return result

# Prefix accumulation retains the initial state as element zero.
# Each callback result becomes the next state; with empty input, return
# a one-element array containing only the initial state.
export def scan(values, initial, callback)
	var accumulated = initial
	var result = [initial]
	for value in values
		accumulated = callback(accumulated, value)
		result = result.append(accumulated)
	return result

# Pairwise array transformations stop at the shorter input. The callback's
# result type determines the element type, including for empty output arrays.
export def zip_with(left, right, callback)
	var result = empty_array_like(callback)
	var index = 0
	while index < len(left) and index < len(right)
		result = result.append(callback(left[!index], right[!index]))
		index += 1
	return result

# Generic pairs use structural records so inputs may have unrelated types.
# Reuse zip_with for its bounds and traversal rules.
export def zip(left, right)
	return zip_with(left, right, fn(a, b) {left = a, right = b})

# Partition in one traversal, evaluating the predicate once per element.
# Both results preserve input order and retain the input element type, even
# when one or both outputs are empty. Values follow ordinary array CoW rules.
export def partition(values, predicate)
	var matched = empty_array_like(values)
	var unmatched = empty_array_like(values)
	for value in values
		if predicate(value)
			matched = matched.append(value)
		else
			unmatched = unmatched.append(value)
	return {matched = matched, unmatched = unmatched}

# Apply a binary callback to each element together with its zero-based index.
# A single traversal also works for empty arrays: the callback determines the
# result element type even when no values are present.
export def map_indexed(values, callback)
	var result = empty_array_like(callback)
	var index = 0
	for value in values
		result = result.append(callback(index, value))
		index += 1
	return result

# Index every element in one pass using generic structural records.
export def enumerate(values)
	return map_indexed(values, fn(index, value) {index = index, value = value})

# These predicates specialize on both the collection and the Fn argument.
# Explicitly type the callback value when its generic parameter types cannot
# be inferred from the call alone.
export def count_if(values, predicate) -> i64
	var count = 0
	for value in values
		if predicate(value)
			count += 1
	return count

export def any(values, predicate) -> bool
	return find_index(values, predicate) >= 0

export def all(values, predicate) -> bool
	for value in values
		if not predicate(value)
			return false
	return true

# The first matching index, or -1 if no element matches.
export def find_index(values, predicate) -> i64
	var index = 0
	for value in values
		if predicate(value)
			return index
		index += 1
	return -1
