# Sequential 1D collection helpers using noncapturing Fn callbacks.
# Map, filter, generate and fold specialize on argument and result types.
# Callback purity is not enforced by the compiler.

export rec IndexedI64(index: i64, value: i64)
	pub index
	pub value

export rec IndexedF64(index: i64, value: f64)
	pub index
	pub value

export rec IndexedString(index: i64, value: string)
	pub index
	pub value

# Array constructors infer the result element type from a callback's Fn return
# type or an existing collection, including when the input is empty.
# Generic calls infer callback input types from concrete arguments where unambiguous.
export def map(values, callback)
	var result = empty_array_like(callback)
	for value in values
		result = result.append(callback(value))
	return result

export def filter(values, predicate)
	var result = empty_array_like(values)
	for value in values
		if predicate(value)
			result = result.append(value)
	return result

export def generate(count: i64, callback)
	var result = empty_array_like(callback)
	var index = 0
	while index < count
		result = result.append(callback(index))
		index += 1
	return result

# Generic in both collection element and accumulator type.
export def fold(values, initial, callback)
	var result = initial
	for value in values
		result = callback(result, value)
	return result

# Pairwise array transformations stop at the shorter input. The callback's
# result type determines the element type, including for empty output arrays.
export def zip_with(left, right, callback)
	var result = empty_array_like(callback)
	var index = 0
	while index < len(left) and index < len(right)
		result = result.append(callback(left[!index], right[!index]))
		index += 1
	return result

# Generic pairs use structural records so inputs may have unrelated types.
# Reuse zip_with for its bounds and traversal rules.
export def zip(left, right)
	return zip_with(left, right, fn(a, b) {left = a, right = b})

# Convert elements to structural records without capturing a mutable index.
# Fill indexes in a second pass; map provides the correct result type even
# when values is empty, without requiring a named record per element type.
export def enumerate(values)
	var result = map(values, fn(value) {index = 0, value = value})
	for i in 0..len(result)
		result[!i].index = i
	return result

# These predicates specialize on both the collection and the Fn argument.
# Explicitly type the callback value when its generic parameter types cannot
# be inferred from the call alone.
export def count_if(values, predicate) -> i64
	var count = 0
	for value in values
		if predicate(value)
			count += 1
	return count

export def any(values, predicate) -> bool
	return find_index(values, predicate) >= 0

export def all(values, predicate) -> bool
	for value in values
		if not predicate(value)
			return false
	return true

# The first matching index, or -1 if no element matches.
export def find_index(values, predicate) -> i64
	var index = 0
	for value in values
		if predicate(value)
			return index
		index += 1
	return -1
